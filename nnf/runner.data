"capsule_name0","The Key-Capsule (Evil):","La cápsula de la llave (Maligna)",
"capsule_name1","The Key-Capsule (Cheap):","La cápsula de la llave (Barata)",
"capsule_name2","The Mystery Capsule:","La cápsula misteriosa",
"capsule_name3","The Golden Capsule:","La cápsula dorada",

"capsule_desc_part","[#000000]When opened...","[#000000]Cuando sea abierta…",

"capsule_desc0","[#000000]{a}*Receive a suspicious key...{a}[#800000]*Suspicious key: On the next shop turn, you will gain access to the black market.","[#000000]{a}*Recibe una llave sospechosa…{a}[#800000]*La llave sospechosa te otorgara acceso al mercado negro la siguiente vez que pases por el MercaNubby.",
"capsule_desc1","[#000000]{a}*Receive a plastic key...{a}[#00802b]*Plastic key: On the next shop turn, you will gain access to the bargain bin.","[#000000]{a}*Recibe una llave de plástico...{a}[#00802b]*Llave de plástico: La siguiente vez que estés en el MercaNubby obtendras accesos al mercado de gangas.",
"capsule_desc2","[#000000]{a}*{b}% chance to receive a random common item.{a}*{c}% chance to receive a random common perk.{a}*{d}% chance to receive a random rare item.{a}*{e}% chance to receive a random rare perk.","[#000000]{a}*{b}% de probabilidad de recibir un objeto random común.{a}*{c}% de probabilidad de recibir un perk común random.{a}*{d}% de probabilidad de recibir un objeto random raro.{a}*{e}% de probabilidad de recibir un perk random raro.",
"capsule_desc3","[#000000]{a}*Gives 1 to {b} coins.","[#000000]{a}*Otorga 1 a {b} monedas.",
"capsule_reward_part","[#000000]Whoa! You got:{a}{b}","[#000000] ¡Whoa! Tienes:{a}{b}",
"capsule_reward_Cap0","+1 Suspicious Key!","¡+1 Llave sospechosa!",
"capsule_reward_Cap1","+1 Plastic Key!","¡	+1 Llave sospechosa!",
"capsule_reward_Cap2_Option1","+1 common item: ({a})","+1 objeto común: ({a})",
"capsule_reward_Cap2_Option2","+1 common perk: ({a})","+1 perk común: ({a})",
"capsule_reward_Cap2_Option3","+1 rare item: ({a})","+1 objeto raro: ({a})",
"capsule_reward_Cap2_Option4","+1 rare perk: ({a})","+1 perk raro: ({a})",
"capsule_reward_Cap2_Option5","+1 ULTRA RARE item: ({a})","+1 objeto ULTRA RARO: ({a})",
"capsule_reward_Cap2_Option6","+1 ULTRA RARE perk: ({a})","+1 perk ULTRA RARO: ({a})",
"capsule_reward_Cap3","+{a} coins!","+{a} monedas!",

"capsule_open_directions","Click on the capsule to open it!","¡Dale click a la cápsula para abrirla!",
"capsule_item_directions","Click on the prize to drag and drop it into your inventory!","¡Dale click a tu premio y arrastralo a tu inventario!",
"capsule_itemselltip","Tip: Press [{a}] on an item in your inventory to sell it and make space.","Tip: Presiona [{a}] al objeto en tu inventario para venderlo y hacer espacio.",
