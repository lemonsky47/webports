"perk_name24","The Void Perk","Perk Prázdnoty",	
"perk_name25","The Enlightened Perk","Perk Osvietenia",
"perk_name26","The Archaic Perk","Archaický Perk",
"perk_name27","The Warlock Perk","Čarodejnícky Perk",
"perk_name28","The Gourmet Perk","Lábužnícky Perk",
"perk_name29","The Lunar Perk","Mesačný Perk",
"perk_name30","The Croissant Perk","Kroisantový Perk",
