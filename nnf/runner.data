"supervisorname_tonyjr","Tony Jr.","Antonino",
"supervisorname_goblin","Goblony","Goblintonio",
"supervisorname_mutant","Mutant Tony","Antonio Mutante",
"supervisorname_glass","Glass Tony","Antonio di Vetro",
"supervisorname_hunter","Hunter Tony","Antonio Cacciatore",
"supervisorname_balogna","Balogna Tony","Bologna Antonio",
"supervisorname_criminal","Criminal Tony","Antonio Criminale",
