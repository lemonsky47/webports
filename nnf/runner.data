"capsule_desc_part","[#000000]When opened...","[#000000]Quan s'obre...",

"capsule_desc0","[#000000]{a}*Receive a suspicious key...{a}[#800000]*Suspicious key: On the next shop turn, you will gain access to the black market.","[#000000]{a}*Reps una clau sospitosa...{a}[#800000]*Clau sospitosa: El següent cop que puguis anar al Nubbymercat, aniràs al mercat negre en el seu lloc.",
"capsule_desc1","[#000000]{a}*Receive a plastic key...{a}[#00802b]*Plastic key: On the next shop turn, you will gain access to the bargain bin.","[#000000]{a}*Reps una clau de plàstic...{a}[#00802b]*Clau de plàstic: El següent cop que puguis anar al Nubbymercat, aniràs al racó de les gangues.",
"capsule_desc2","[#000000]{a}*{b}% chance to receive a random common item.{a}*{c}% chance to receive a random common perk.{a}*{d}% chance to receive a random rare item.{a}*{e}% chance to receive a random rare perk.","[#000000]{a}*{b}% de probabilitats de rebre un objecte comú aleatori.{a}*{c}% de rebre un avantatge comú aleatori.{a}*{d}% de rebre un objecte rar aleatori.{a}*{e}% de rebre un avantatge rar aleatori.",
"capsule_desc3","[#000000]{a}*Gives 1 to {b} coins.","[#000000]{a}*Reps de 1 a {b} monedes.",

"capsule_reward_part","[#000000]Whoa! You got:{a}{b}","[#000000]Uau! Has rebut:{a}{b}",
