"NubbySkinName0","Nubby","Nubby",
"NubbySkinName1","Frog Nubby","Frø Nubby",
"NubbySkinName2","Blubby","Blubby",
"NubbySkinName3","Cheesy Nubby","Oste Nubby",
"NubbySkinName4","Clown Nubby","Klovne Nubby",
"NubbySkinName5","Cyborg Nubby","Cyborg Nubby",
"NubbySkinName6","Parasitic Nubby","Parasit Nubby",
