"altdesc_croissant","[#4dff4d][fnt_ItemName]{b}  [#ffffff][spr_Sub_Perk,0]{a}[fnt_ComicSansMed]{c}","[#4dff4d][fnt_ItemName]{b}  [#ffffff][spr_Sub_Perk,0]{a}[fnt_ComicSansMed]{c}",
"altdesc_croissant_upgraded","[#4dff4d][fnt_ItemName]{b}  [#ffffff][spr_Sub_Perk,0]{a}[fnt_ComicSansMed]{c}","[#4dff4d][fnt_ItemName]{b}  [#ffffff][spr_Sub_Perk,0]{a}[fnt_ComicSansMed]{c}",

