"ItemSkinNickName7","Bricks","¿Ladrillos?",
"ItemSkinNickName8","Doodle","Rosquilla",
"ItemSkinNickName9","Unstable","Viaje explosivo",
"ItemSkinNickName10","Macaroni","Fideitos",
"ItemSkinNickName11","Gustaf","Gustavo",
"ItemSkinNickName12","Ammonite","Fósil",
"ItemSkinNickName13","Extra Long","Pepedrote",
"ItemSkinNickName14","Stopmotion","Un hombre verdadero",
"ItemSkinNickName15","Magic Microwave","Microondas tuneado",
