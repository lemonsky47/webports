"perk_name2","The Kebab Perk","Kebabový Perk",	
"perk_name3","The Ray-Gun Perk","Laserová-Pištol Perk",	
"perk_name4","The Speedy Perk","Rýchly Perk",		
"perk_name5","The Battery Perk","Batériový Perk",		
"perk_name6","The Cheesy Perk","Syrový Perk",		
"perk_name7","The Waffle Perk","Vaflový Perk",	
"perk_name8","The Chaotic Perk","Chaotický Perk",		
"perk_name9","The Zombie Perk","Zombíkovský Perk",	
"perk_name10","The Springy Perk","Pružinový Perk",		
"perk_name11","The Ping Pong Perk","Ping Pongový Perk",		
"perk_name12","The Mystery Box Perk","Záhadný Box Perk",		
"perk_name13","The Trophy Perk","Trofejový Perk",		
