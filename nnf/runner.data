perk_desc0,[#e6ffe6]{a}*Empty perk description,[#e6ffe6]{a}*Empty perk description
"	",,
perk_desc1,[#e6ffe6]{a}*Aktiválja all items.{a}*Disables the item in [#ffb3ff]SLOT #{b}[#e6ffe6].,[#e6ffe6]{a}*Aktiválja az összes tárgyat.{a}*Kikapcsolja a tárgyat a [#ffb3ff]{b}.[#e6ffe6] helyen.
perk_desc2,[#e6ffe6]{a}*{b}% chance to force-trigger the right-most item in your inventory.,"[#e6ffe6]{a}*{b}% Esély, hogy aktiválja a legjobboldali tárgyadat."
perk_desc3,[#e6ffe6]{a}*{b}% chance to force-trigger the item in [#ffb3ff]SLOT #{c}[#e6ffe6].,"[#e6ffe6]{a}*{b}% Esély, hogy aktiválja a [#ffb3ff]{c}.[#e6ffe6] helyen lévő tárgyat."
perk_desc4,"[#e6ffe6]{a}*If the round started less than {b} seconds ago, Aktiválja the items in slots [#ffb3ff]SLOTS #1, #2, and #3[#e6ffe6].","[#e6ffe6]{a}*Ha a kör kevesebb, mint {b} másodperce kezdődött, aktiválja az [#ffb3ff]1. 2. és 3.[#e6ffe6] helyen lévő tárgyat."
perk_desc5,[#e6ffe6]{a}*Aktiválja the item in [#ffb3ff]SLOT #{b}[#e6ffe6].,[#e6ffe6]{a}*Aktiválja a  [#ffb3ff]{b}.[#e6ffe6] helyen lévő tárgyat.
perk_desc6,[#e6ffe6]{a}*Aktiválja all items.,[#e6ffe6]{a}*Aktiválja az összes tárgyat.
perk_desc7,[#e6ffe6]{a}*Aktiválja all items in odd-numbered slots.,[#e6ffe6]{a}*Aktiválja a páratlan számú helyen lévő tárgyakat.
perk_desc8,[#e6ffe6]{a}*Aktiválja one random item.,[#e6ffe6]{a}*Aktivál egy véletlen tárgyat.
perk_desc9,"[#e6ffe6]{a}*Aktiválja all {b}[#ffd500]First peg popped [spr_ITArrow,0][#e6ffe6]{b} items.","[#e6ffe6]{a}*Aktivál minden {b}[#ffd500]Első pöcök megpöckölve [spr_ITArrow,0][#e6ffe6]{b} tárgyat."
perk_desc10,[#e6ffe6]{a}*{b}% chance to force-trigger item in [#ffb3ff]SLOT #{c}[#e6ffe6].,"[#e6ffe6]{a}*{b}% Esély, hogy aktiválja a [#ffb3ff]{c}.[#e6ffe6] helyen lévő tárgyat."
perk_desc11,[#e6ffe6]{a}*Aktiválja the item in slot #5.,[#e6ffe6]{a}*Aktiválja az 5. helyen lévő tárgyat.
perk_desc12,[#e6ffe6]{a}*If [#ffb3ff]SLOT #{b}[#e6ffe6] is empty...{a}*A random item from nubby-mart will appear in [#ffb3ff]SLOT #{b}[#e6ffe6] and force-trigger {c} times.{a}*The new item will disappear at the end of the round.,[#e6ffe6]{a}*Ha a(z) [#ffb3ff]{b}.[#e6ffe6] hely üres...{a}*Megjelenik egy véletlen tárgy a Nubby-Boltból a(z) [#ffb3ff]{b}.[#e6ffe6] helyen és aktiválódik {c}-szor.{a}*Ez a tárgy a kör végén eltűnik.
perk_desc13,"[#e6ffe6]{a}*Aktiválja the item in [#ffb3ff]SLOT #{b}[#e6ffe6], 3 times.",[#e6ffe6]{a}*Aktiválja a(z) [#ffb3ff]{b}.[#e6ffe6] helyen lévő tárgyat háromszor.
perk_desc14,[#e6ffe6]{a}*Aktiválja the item in [#ffb3ff]SLOT #{b}[#e6ffe6] 1 time for every {c} coins you have.,"[#e6ffe6]{a}*Aktiválja a(z) [#ffb3ff]{b}.[#e6ffe6] helyen lévő tárgyat annyiszor, ahány érméd van."
perk_desc15,"[#e6ffe6]{a}*Aktiválja the items in slots [#ffb3ff]SLOTS #5, #6, and #7[#e6ffe6], {b} times each.","[#e6ffe6]{a}*Aktiválja az [#ffb3ff]5. 6. és 7.[#e6ffe6] helyen lévő tárgyat, {b}-szer."
perk_desc16,"[#e6ffe6]{a}*If you have 4 or less items... {a}*Aktiválja the item in [#ffb3ff]SLOT #{b}[#e6ffe6], {c} times","[#e6ffe6]{a}*Ha 4 vagy kevesebb tárgyad van... {a}*Aktiválja a(z) [#ffb3ff]{b}.[#e6ffe6] helyen lévő tárgyat, {c}-szer."
perk_desc17,"[#e6ffe6]{a}*If the round goal was passed {b} or more times, Aktiválja all items and lose {c}% of total points.","[#e6ffe6]{a}*Ha a célt elérted {b}  vagy többször, aktiválja az összes tárgyat és elveszíted a pontjaid {c}%-át."
perk_desc18,"[#e6ffe6]{a}*If you have passed the round goal this round, Aktiválja the item in [#ffb3ff]SLOT #{b}[#e6ffe6], twice.","[#e6ffe6]{a}*Ha elérted a célt, aktiválja a(z) [#ffb3ff]{b}.[#e6ffe6] helyen lévő tárgyat kétszer."
perk_desc19,[#e6ffe6]{a}*Aktiválja the leftmost item x times.{a}*Jumbling pegs increases x by +{b}.{a}*This value resets after each round.,[#e6ffe6]{a}*Aktiválja a legbaloldalibb tárgyat x-szer.{a}*A Pöckök összekeverése megemeli x-et {b}-vel.{a}*A kör elején x értéke visszaváltozik 0-ra.
perk_desc20,[#e6ffe6]{a}*Aktiválja the left-most item in your inventory.{a}*Lose {b}% of your total points.,[#e6ffe6]{a}*Aktiválja a legbaloldalibb tárgyat a tárhelyedben.{a}*Elvszted a pontjaid {b}%-át.
perk_desc21,"[#e6ffe6]{a}*Aktiválja all {b}[#ffd500]x pegs popped [spr_ITArrow,0][#e6ffe6]{b} items.","[#e6ffe6]{a}*Aktiválja az összes {b}[#ffd500]x Pöckök megpöckölve [spr_ITArrow,0][#e6ffe6]{b} tárgyat."
perk_desc22,[#e6ffe6]{a}*Aktiválja all items that summon anything.,"[#e6ffe6]{a}*Aktiválja az összes tárgyat, ami megidéz valamit."
perk_desc23,"[#e6ffe6]{a}*If the first peg popped was the highest # peg, Aktiválja the items in [#ffb3ff]SLOTS #1, and #2[#e6ffe6], {b} times each.","[#e6ffe6]{a}*Ha az első megpöckölt Pöcök a legmagasabb értékű Pöcök, aktiválja az [#ffb3ff]1. és 2.[#e6ffe6] helyen lévő tárgyat, {b}-szer."
perk_desc24,[#e6ffe6]{a}*Aktiválja the item in [#ffb3ff]SLOT #{b}[#e6ffe6] 2 times for each empty inventory slot.,"[#e6ffe6]{a}*Aktiválja a(z) [#ffb3ff]{b}.[#e6ffe6]  helyen lévő tárgyat, kétszer minden üres tárhelyért."
perk_desc25,[#e6ffe6]{a}*Aktiválja the item in slot [#ffb3ff]SLOT #{b}[#e6ffe6] 1 time for each perk you have.,[#e6ffe6]{a}*Aktiválja a(z) [#ffb3ff]{b}.[#e6ffe6] helyen lévő tárgyat minden birtokolt képességért.
perk_desc26,[#e6ffe6]{a}*Aktiválja all non-upgraded items.,[#e6ffe6]{a}*Aktiválja az összes fejlesztettlen tárgyat.
perk_desc27,"[#e6ffe6]{a}*Force triggers all {b}[#ffd500]Nubby Dies [spr_ITArrow,0][#e6ffe6]{b} items again.","[#e6ffe6]{a}*Újraaktiválja az összes {b}[#ffd500]Nubby meghal [spr_ITArrow,0][#e6ffe6]{b} tárgyat."
perk_desc28,"[#e6ffe6]{a}*Aktiválja the item in slot #{b}, 1 time for every {c} food items you've consumed.{a}(Foods eaten: {d})","[#e6ffe6]{a}*Aktiválja a(z) {b}. helyen lévő tárgyat, minden {c}. elfogyasztott ételért.{a}(Ételek megéve: {d})"
perk_desc29,"[#e6ffe6]{a}*Aktiválja the item in slot #{b}, 1 time for every {c} rounds you've passed.{a}(Current Aktiválja: {d})","[#e6ffe6]{a}*Aktiválja a(z) {b}. helyen lévő tárgyat, minden {c}. körért.{a}(Jelenlegi aktiválódáasok: {d})"
perk_desc30,"[#e6ffe6]{a}*Has an x% chance to force-trigger the item in slot #{b}.{a}*For each remaining life, gain +{c}% odds.","[#e6ffe6]{a}*x% Esély, hogy aktiválja a(z) {b}. helyen lévő tárgyat.{a}*Minden megmaradt életért, +{c}% esély."
perk_desc31,"[#e6ffe6]{a}*Has an x% chance to force-trigger the item in slot #{b}.{a}*For each remaining life, gain +{c}% odds.","[#e6ffe6]{a}*x% Esély, hogy aktiválja a(z) {b}. helyen lévő tárgyat.{a}*Minden megmaradt életért, +{c}% esély."
perk_desc32,[#e6ffe6]{a}*{b}% chance to force-trigger the right-most item in your inventory.,"[#e6ffe6]{a}*{b}% Esély, hogy aktiválja a legjobboldalibb tárgyat."
