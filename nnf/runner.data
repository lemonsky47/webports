"capsule_desc_part","[#000000]When opened...","[#000000]Kiedy otworzone...",

"capsule_desc0","[#000000]{a}*Receive a suspicious key...{a}[#800000]*Suspicious key: On the next shop turn, you will gain access to the black market.","[#000000]{a}*Zyskaj podejrzany klucz...{a}[#800000]*Podejrzany klucz: Następnym razem, gdy wejdziesz do sklepu, zyskasz dostęp do czarnego rynku.",
"capsule_desc1","[#000000]{a}*Receive a plastic key...{a}[#00802b]*Plastic key: On the next shop turn, you will gain access to the bargain bin.","[#000000]{a}*Zyskaj plastikowy klucz...{a}[#00802b]*Plastikowy klucz: Następnym razem, gdy wejdziesz do sklepu, zyskasz dostęp do śmietnika.",
"capsule_desc2","[#000000]{a}*{b}% chance to receive a random common item.{a}*{c}% chance to receive a random common perk.{a}*{d}% chance to receive a random rare item.{a}*{e}% chance to receive a random rare perk.","[#000000]{a}*{b}% szans na otrzymanie zwyczajnego przedmiotu.{a}*{c}% szans na otrzymanie zwyczajnej cechy.{a}*{d}% szans na otrzymanie rzadkiego przedmiotu.{a}*{e}% szans na otrzymanie rzadkiej cechy.",
"capsule_desc3","[#000000]{a}*Gives 1 to {b} coins.","[#000000]{a}*Daje od 1 do {b} monet.",

