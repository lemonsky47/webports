"pickone","Choose an item?{a}(Pick ONE)","¿Elegir un objeto?{a}!(Elige UNO)",

"altdesc_corrupted","[#cc99ff]CORRUPTED ITEM[#ffffff]:{a}*This item cannot be force-triggered.","[#cc99ff]OBJETO CORRUPTO[#ffffff]:{a}*Este objeto no se puede activarse forzosamente .",
"altdesc_evil","[#ff0000]EVIL ITEM[#ffffff]:{a}*This item cannot be moved, upgraded, sold, or otherwise destroyed.","[#ff0000]OBJETO MALÉVOLO[#ffffff]:{a}*Este objeto no puede ser movido, mejorado, vendido o de la misma manera destruido.",
"altdesc_glass","[#99e6e6]GLASS ITEM[#ffffff]:{a}*This item has a 5% chance to shatter when it triggers.","[#99e6e6]OBJETO DE CRISTAL[#ffffff]:{a}*Este objeto tiene un 5% de probabilidad de romperse cuando se active.",
"altdesc_disable","*DISABLED ITEMS:{a}[#ffffff]*Disabled items cannot trigger for the rest of the round.","*OBJETO DESHABILITADO:{a}[#ffffff]*Objetos deshabilitados no pueden ser activados por el resto de la ronda.",
