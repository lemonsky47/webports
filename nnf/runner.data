"clawmachine_exit","Exit","Sair",

"capsule_name0","The Key-Capsule (Evil):","A Cápsula de Chave (Maligna):",
"capsule_name1","The Key-Capsule (Cheap):","A Cápsula de Chave (Barata):",
"capsule_name2","The Mystery Capsule:","A Cápsula Mistério:",
"capsule_name3","The Golden Capsule:","A Cápsula Dourada:",

"capsule_desc_part","[#000000]When opened...","[#000000]Quando aberta...",

"capsule_desc0","[#000000]{a}*Receive a suspicious key...{a}[#800000]*Suspicious key: On the next shop turn, you will gain access to the black market.","[#000000]{a}*Recebe uma chave suspeita...{a}[#800000]*Chave suspeita: Na próxima visita à loja, ganharás acesso ao Mercado Negro.",
"capsule_desc1","[#000000]{a}*Receive a plastic key...{a}[#00802b]*Plastic key: On the next shop turn, you will gain access to the bargain bin.","[#000000]{a}*Recebe uma chave de plástico...{a}[#00802b]*Chave de plástico: Na próxima visita à loja, ganharás acesso à lista de pechinchas.",
"capsule_desc2","[#000000]{a}*{b}% chance to receive a random common item.{a}*{c}% chance to receive a random common perk.{a}*{d}% chance to receive a random rare item.{a}*{e}% chance to receive a random rare perk.","[#000000]{a}*{b}% de chance de receber um item comum aleatório.{a}*{c}% de chance de receber uma vantagem comum aleatória.{a}*{d}% de chance de receber um item raro aleatório.{a}*{e}% de chance de receber uma vantagem rara aleatória.",
"capsule_desc3","[#000000]{a}*Gives 1 to {b} coins.","[#000000]{a}*Dá 1 a {b} moedas.",

"capsule_reward_part","[#000000]Whoa! You got:{a}{b}","[#000000]Uau! Conseguiste:{a}{b}",
"capsule_reward_Cap0","+1 Suspicious Key!","+1 Chave Suspeita!",
"capsule_reward_Cap1","+1 Plastic Key!","+1 Chave de Plástico!",
"capsule_reward_Cap2_Option1","+1 common item: ({a})","+1 item comum: ({a})",
"capsule_reward_Cap2_Option2","+1 common perk: ({a})","+1 vantagem comum: ({a})",
"capsule_reward_Cap2_Option3","+1 rare item: ({a})","+1 item raro: ({a})",
"capsule_reward_Cap2_Option4","+1 rare perk: ({a})","+1 vantagem rara: ({a})",
"capsule_reward_Cap2_Option5","+1 ULTRA RARE item: ({a})","+1 item ULTRA RARO: ({a})",
"capsule_reward_Cap2_Option6","+1 ULTRA RARE perk: ({a})","+1 vantagem ULTRA RARA: ({a})",
"capsule_reward_Cap3","+{a} coins!","+{a} moedas!",

"capsule_open_directions","Click on the capsule to open it!","Clica na cápsula para abri-la!",
"capsule_item_directions","Click on the prize to drag and drop it into your inventory!","Clica no prémio para arrastá-lo e largá-lo no teu inventário!",
"capsule_itemselltip","Tip: Press [{a}] on an item in your inventory to sell it and make space.","Dica: Prime [{a}] num item no teu inventário para vendê-lo e fazer espaço.",
