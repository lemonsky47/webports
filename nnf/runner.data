"capsule_name0","The Key-Capsule (Evil):","Llave-cápsula (Malvado):",
"capsule_name1","The Key-Capsule (Cheap):","Llave-cápsula(Barata)",
"capsule_name2","The Mystery Capsule:","Cápsula misteriosa",
"capsule_name3","The Golden Capsule:","Cápsula dorada",
"capsule_desc_part","[#000000]When opened...","[#000000]Abriendo...",
"capsule_desc0","[#000000]{a}*Receive a suspicious key...{a}[#800000]*Suspicious key: On the next shop turn, you will gain access to the black market.","[#000000]{a}*Recibiste una llave misteriosa...{a}[#800000]*Llave misteriosa: En el próximo turno de tienda, gana acceso al mercado negro.",
"capsule_desc1","[#000000]{a}*Receive a plastic key...{a}[#00802b]*Plastic key: On the next shop turn, you will gain access to the bargain bin.","[#000000]{a}*Has recibido una llave de plástico...{a}[#00802b]*Llave de plástico: En el próximo turno de tienda, tendrás accseo a las ofertas tiradas en la basura.",
"capsule_desc2","[#000000]{a}*{b}% chance to receive a random common item.{a}*{c}% chance to receive a random common perk.{a}*{d}% chance to receive a random rare item.{a}*{e}% chance to receive a random rare perk.","[#000000]{a}*{b}% de posibilidades de recibir un objeto común cualquiera.{a}*{c}% de posibilidades de recibir un libro común.{a}*{d}% de posibilidades de obtener un objeto raro.{a}*{e}% de posibilidades de obtener un libro raro.",
"capsule_desc3","[#000000]{a}*Gives 1 to {b} coins.","[#000000]{a}*Da de 1 a {b} monedas.",
"capsule_reward_part","[#000000]Whoa! You got:{a}{b}","[#000000]¡Mira qué bien! Conseguiste:{a}{b}",
"capsule_reward_Cap0","+1 Suspicious Key!","¡+1 Llave Sospechosa!",
"capsule_reward_Cap1","+1 Plastic Key!","¡+1 Llave de Plástico!",
"capsule_reward_Cap2_Option1","+1 common item: ({a})","+1 objeto común: ({a})",
"capsule_reward_Cap2_Option2","+1 common perk: ({a})","+1 libro común: ({a})",
"capsule_reward_Cap2_Option3","+1 rare item: ({a})","+1 objeto raro: ({a})",
"capsule_reward_Cap2_Option4","+1 rare perk: ({a})","+1 libro raro: ({a})",
"capsule_reward_Cap2_Option5","+1 ULTRA RARE item: ({a})","+1 objeto ULTRA RARO: ({a})",
"capsule_reward_Cap2_Option6","+1 ULTRA RARE perk: ({a})","+1 libro ULTRA RARO: ({a})",
"capsule_reward_Cap3","+{a} coins!","¡+{a} monedas!",
"capsule_open_directions","Click on the capsule to open it!","¡Haz click en la cápsula para abrirla!",
"capsule_item_directions","Click on the prize to drag and drop it into your inventory!","¡Haz click en el precio para arrastrar y soltar el objeto en tu inventario!",
"capsule_itemselltip","Tip: Press [{a}] on an item in your inventory to sell it and make space.","Consejo: Presiona [{a}] en un objeto de tu inventario para venderlos y darles espacio.",
"clawmachine_play2win","PLAY{a}To Win!","¡JUEGA{a}para ganar!",
