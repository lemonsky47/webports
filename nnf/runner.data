"null","[#ffd500]Error: null","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",

"item_desc0","[#ffffff]{a}*Pops a random peg. When this peg pops, it will give points twice.","[#ffffff]{a}*Estoura um peg aleatório. Quando esse peg estoura, ele dá pontos duas vezes.",		
"item_desc1","[#ffffff]{a}*Mimics the non-upgraded effect of the most recently eaten food item{a}*Will mimic: {c}{b}{c}. {d}","[#ffffff]{a}*Imita o efeito não-melhorado da mais recente comida devorada{a}*Irá imitar: {c}{b}{c}. {d}",		
"item_desc2","[#ffffff]{a}*Summons {b} quill that falls from the sky and pops {c} peg.","[#ffffff]{a}*Invoca {b} espinho que cai do céu e estoura {c} peg.",		
"item_desc3","[#ffffff]{a}*A random peg will explode and pop {b} (maximum) nearby pegs.","[#ffffff]{a}*Um peg aleatório irá explodir e estourar (no máximo) {b} pegs próximos.",		
"item_desc4","[#ffffff]{a}*Every item in your inventory gives points equal to a random peg's number.","[#ffffff]{a}*Cada item no seu inventário dará pontos igual ao número de um peg aleatório.",		
"item_desc5","[#ffffff]{a}*If Nubby is still alive, summons a {b}meat-orb{b} that will float around and pop pegs.{a}*Meat-orbs die when Nubby dies.","[#ffffff]{a}*Se Nubby ainda está vivo, invoca uma {b}orbe de carne{b} que flutua pelo campo estoura pegs.{a}*Orbes de carne morrem quando Nubby morre.",		
"item_desc6","[#ffffff]{a}*{b} in {c} chance to double ALL pegs.","[#ffffff]{a}*Chance de {b} em {c} de dobrar TODOS os pegs.",		
"item_desc7","[#ffffff]{a}*Gain +1 coin for every strawberry eaten during this game.{a}*Maxes out at {b} coins.","[#ffffff]{a}*Ganha +1 moeda para cada morango devorado na partida.{a}*Máximo de {b} moedas.",		
"item_desc8","[#ffffff]{a}*A random peg will emit {c} {b}snot shots{b} that pop any pegs they pass through.","[#ffffff]{a}*Um peg aleatório emitirá {c} {b}tiros de ranho{b} que estouram todo peg que atravessarem.",		
"item_desc9","[#ffffff]{a}*Summons one straw that pops one peg.{a}*Pegs popped by straws give an additional +{b}% of their #.{a}*Gains +{c}% for every time you've jumbled pegs in this game.","[#ffffff]{a}*Invoca um canudo que estoura um peg.{a}*Pegs estourados por canudos dão +{b}% de seu #.{a}*Ganhe +{c}% para cada vez que você embaralhou os pegs nesta partida.",		
"item_desc10","[#ffffff]{a}*All pegs will give points equal to double the number on the lowest # peg.","[#ffffff]{a}*Todos os pegs darão pontos igual ao dobro do número no peg de menor #.",		
"item_desc11","[#ffffff]{a}*{b}% chance to cause a giant explosion that pops all pegs once.{a}*{c}% chance if you are on your last shot.","[#ffffff]{a}*{b}% de chance de provocar uma enorme explosão que estoura todos os pegs uma vez.{a}*{c}% de chance se for seu último tiro.",		
"item_desc12","[#ffffff]{a}*Every empty peg space will give points equal to the total amount of pegs that have been popped this round.","[#ffffff]{a}*Cada espaço de peg vazio dará pontos iguais à quantidade total de pegs estourados neste round.",	
"item_desc13","[#ffffff]{a}*Upgrades the right-most item in your inventory.{a}*Deletes the left-most item in your inventory.","[#ffffff]{a}*Aprimora o item mais à direita no seu inventário.{a}*Deleta o item mais à esquerda no seu inventário.",
"item_desc14","[#ffffff]{a}*Pops {b} random peg.","[#ffffff]{a}*Estoura {b} peg aleatório.",		
"item_desc15","[#ffffff]{a}*Multiply total points by {b}x.","[#ffffff]{a}*Multiplica os pontos totais por {b}x.",		
"item_desc16","[#ffffff]{a}*Nubby gives points equal to the number of times that Nubby has bounced this round.","[#ffffff]{a}*Nubby dá pontos igual ao número de vezes que Nubby quicou neste round.",		
"item_desc17","[#ffffff]{a}*Summons a sharp-shot that will pop a random peg {b} times.","[#ffffff]{a}*Invoca um tiro afiado que irá estourar um peg aleatório {b} vezes.",		
"item_desc18","[#ffffff]{a}*Gives +1 {b}Croissant Perk{b}.","[#ffffff]{a}*Concede +1 {b}Poder de Croissant{b}.",	
"item_desc19","[#ffffff]{a}*Gives a copy of the most recently obtained perk.{a}(Currently {b})","[#ffffff]{a}*Concede uma cópia do poder mais recente obtido.{a}(No momento {b})",		
"item_desc20","[#ffffff]{a}*If Nubby is still alive, summon an egg missile that falls from the sky and causes an explosion that pops a row of pegs.","[#ffffff]{a}*Se Nubby ainda está vivo, invoca um míssil de ovo que cai do céu e provoca uma explosão que estoura uma linha de pegs.",		
"item_desc21","[#ffffff]{a}*Pops the lowest # peg twice.","[#ffffff]{a}*Estoura o peg de menor # duas vezes.",	
"item_desc22","[#ffffff]{a}*{b}% chance to do nothing.{a}*{c}% chance to double one random peg.{a}*{d}% chance to halve one random peg.","[#ffffff]{a}*{b}% de chance de nada acontecer.{a}*{c}% de chance de dobrar um peg aleatório.{a}*{d}% de chance de dividir um peg pela metade.",		
"item_desc23","[#ffffff]{a}*Gives +{b} points for every time this item has triggered during this round.{a}*{c} in {d} chance to metamorphosize.","[#ffffff]{a}*Dá +{b} pontos por cada vez que este item foi ativado neste round.{a}*Chance de {c} em {d} de sofrer uma metamorfose.",		
"item_desc24","[#ffffff]{a}*{b}% chance to create a chain bolt that pops a cluster of pegs.","[#ffffff]{a}*{b}% de chance de criar uma corrente elétrica que estoura um grupo de pegs.",		
"item_desc25","[#ffffff]{a}*If Nubby is still alive, summons {c} {b}meat-orbs{b} that will float around and pop pegs.{a}*Meat-orbs die when Nubby dies.","[#ffffff]{a}*Se Nubby ainda está vivo, invoca {c} {b}orbes de carne{b} que flutuam pelo campo e estouram pegs.{a}*Orbes de carne morrem quando Nubby morre.",
		
"item_desc26","[#ffffff]{a}*Test{b}","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",
		
"item_desc27","[#ffffff]{a}*{b} random pegs will copy the # of the first peg popped.{a}*If this item is in slot #{c}, {d} pegs will be affected instead of {b}.","[#ffffff]{a}*{b} pegs aleatórios copiarão o # do primeiro peg estourado.{a}*Se este item está na posição #{c}, {d} pegs serão afetados ao invés de {b}.",
"item_desc28","[#ffffff]{a}*Gives +{b} points for every time this item has triggered during this round.","[#ffffff]{a}*Dá +{b} pontos por cada vez que este item for ativado neste round.",		
"item_desc29","[#ffffff]{a}*Every peg will give points equal to {b}% of their #.","[#ffffff]{a}*Cada peg dará pontos iguais a {b}% de seu #.",		
"item_desc30","[#ffffff]{a}*Doubles a random peg.","[#ffffff]{a}*Dobra um peg aleatório.",		
"item_desc31","[#ffffff]{a}*Mutates into the non-upgraded version of the [#ffb3ff]ITEM TO THE LEFT OF ME[#ffffff] for the rest of the round.","[#ffffff]{a}*Se transforma na versão não-aprimorada do [#ffb3ff]ITEM À MINHA ESQUERDA[#ffffff] pelo resto do round.",		
"item_desc32","[#ffffff]{a}*A random peg emits a pulse that doubles pegs within close range.","[#ffffff]{a}*Um peg aleatório emite um pulso que dobra os pegs a curta distância.",	
"item_desc33","[#ffffff]{a}*Nubby emits a burst of nuclear waste.{a}*Nuclear waste pops any pegs it touches.{a}*If Nubby isn't alive, a random peg will emit the burst.","[#ffffff]{a}*Nubby emite uma rajada de lixo tóxico.{a}*Lixo tóxico estoura qualquer peg que tocar.{a}*Se Nubby não está vivo, um peg aleatório emitirá a rajada.",
"item_desc34","[#ffffff]{a}*Marks a random peg.{a}*When a peg is marked, all pegs that have the same number will be doubled.{a}*If no pegs have the same number as the marked peg, a random peg will be doubled.","[#ffffff]{a}*Marca um peg aleatório.{a}*Quando um peg é marcado, todos os pegs com o mesmo número serão dobrados.{a}*Se nenhum outro peg tem o mesmo número que o peg marcado, um peg aleatório será dobrado.",		
"item_desc35","[#ffffff]{a}*{b} random pegs get smacked.{a}*When a peg is smacked, it counts as a {a}[#ffd500]{c}Peg halved [spr_ITArrow,0]{c} [#ffffff] trigger without actually halving it.","[#ffffff]{a}*{b} pegs aleatórios são estapeados.{a}*Quando um peg é estapeado, conta como ativação de {a}[#ffd500]{c}Peg dividido pela metade [spr_ITArrow,0]{c} [#ffffff] sem realmente dividir o valor.",		
"item_desc36","[#ffffff]{a}*Gain +1 coin for each remaining life.","[#ffffff]{a}*Ganhe +1 moeda para cada vida restante.",	
"item_desc37","[#ffffff]{a}*Doubles {c} random pegs whose # is less than {b}.","[#ffffff]{a}*Dobra {c} pegs aleatórios cujo # é menor que {b}.",	
"item_desc38","[#ffffff]{a}*50% chance to double total coins.{a}*50% chance to set total coins to 0.","[#ffffff]{a}*50% de chance de dobrar todas as moedas.{a}*50% de chance de deixar suas moedas totais em 0.",
"item_desc39","[#ffffff]{a}*Mutates into a random common item that is not currently in your inventory for the rest of the round.","[#ffffff]{a}*Se transforma em um item comum aleatório que não está no seu inventário pelo resto do round.",
"item_desc40","[#ffffff]{a}*{b}% chance to double one random peg.","[#ffffff]{a}*{b}% de chance de dobrar um peg aleatório.",
"item_desc41","[#ffffff]{a}*Halves the highest # peg.{a}*Doubles the lowest # peg {b} times","[#ffffff]{a}*Divide pela metade o peg de maior #.{a}*Dobra o peg de menor # {b} vezes.",
"item_desc42","[#ffffff]{a}*Summon {b} clay balls.{a}*If a clay ball bounces off a wall OR peg, it will count as a [#ffd500]{d}Nubby hits wall [spr_ITArrow,0]{d} [#ffffff]trigger.{a}*Clay balls die after {c} bounces.","[#ffffff]{a}*Invoca {b} bolas de massinha.{a}*Se uma bola de massinha bate em uma parede OU em um peg, vale como uma ativação de [#ffd500]{d}Nubby bate na parede [spr_ITArrow,0]{d} [#ffffff]*Bolas de massinha morrem depois de quicarem {c} vezes.",
"item_desc43","[#ffffff]{a}*Mimics the non-upgraded effect of the item in [#ffb3ff]SLOT #{b}[#ffffff], but keeps its own trigger.","[#ffffff]{a}*Imita o efeito não-aprimorado do item na [#ffb3ff]POSIÇÃO #{b}[#ffffff], mas mantém sua própria ativação.",
"item_desc44","[#ffffff]{a}*Gain +{b} points.{a}*If you are on round {d} or higher, gain +{c} points instead.","[#ffffff]{a}*Ganhe +{b} pontos. {a}*Se você estiver no round {d} ou mais alto, então ganhe +{c} pontos.",
"item_desc45","[#ffffff]{a}*Gives +1 {b}Kebab Perk{b}","[#ffffff]{a}*Concede +1 {b}Poder de Kebab{b}",
"item_desc46","[#ffffff]{a}*Stocks a random rare food item.","[#ffffff]{a}*Estoca uma comida rara aleatória.",
"item_desc47","[#ffffff]{a}*If the first peg popped is the highest # peg, multiply total score by {b}x.","[#ffffff]{a}*Se o primeiro peg estourado foi o peg de maior #, multiplica a pontuação total por {b}x.",
"item_desc48","[#ffffff]{a}*Pops {b} random pegs.","[#ffffff]{a}*Estoura {b} pegs aleatórios.",
"item_desc49","[#ffffff]{a}*The lowest # peg becomes a copy of the highest # peg.","[#ffffff]{a}*O peg de menor # se torna uma cópia do peg de maior #.",
"item_desc50","[#ffffff]{a}*Upon returning to Nubby-Mart, gain +1 reroll.","[#ffffff]{a}*Quando voltar ao Nubby-Mart, ganhe +1 renovação.",
"item_desc51","[#ffffff]{a}*Reduces round goal by -{b}%.{a}*Halves all pegs.","[#ffffff]{a}*Reduz a meta do round por -{b}%.{a}*Divide todos os pegs pela metade.",
"item_desc52","[#ffffff]{a}*Triggers an electron beam that passes through pegs.{a}*When an electron beam hits a peg, the peg will give {b}% of its #.{a}*Electron beams do NOT pop pegs.","[#ffffff]{a}*Ativa um raio de elétrons que atravessa os pegs.{a}*Quando um raio de elétrons atinge um peg, o peg dará {b}% de seu #.{a}*Raios de elétrons NÃO estouram pegs.",
"item_desc53","[#ffffff]{a}*This item emits a god ray.{a}*The god ray rapidly pops a random peg once for each time the item in [#ffb3ff]SLOT #1 [#ffffff]has triggered in this round.","[#ffffff]{a}*Este item emite um raio divino.{a}*O raio divino rapidamente estoura um peg aleatório por cada vez que o item na [#ffb3ff]POSIÇÃO #1 [#ffffff]foi ativado neste round.",
"item_desc54","[#ffffff]{a}*Triggers the most recently obtained perk.{a}(Currently {b})","[#ffffff]{a}*Ativa o poder mais recente obtido.{a}(No momento {b})",
"item_desc55","[#ffffff]{a}*The lowest # peg gives points equal to {b}x its #.{a}*If the lowest # peg is {d} or less, it will give +{c} points instead.","[#ffffff]{a}*O peg de menor # dá pontos igual a {b}x seu #.{a}*Se o peg de menor # é {d} ou menor, então dará +{c} pontos.",
"item_desc56","[#ffffff]{a}*Summons a beach ball that emits {b} streams of confetti when it pops.{a}*Pegs popped by confetti give {c}% of their #.","[#ffffff]{a}*Invoca uma bola de praia que emite {b} chuvas de confete quando estoura.{a}*Pegs estourados por confete dão {c}% de seu #.",

"item_desc57","[#ffffff]{a}*Empty description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",

"item_desc58","[#ffffff]{a}*Nubby gives birth to a copy of himself.","[#ffffff]{a}*Nubby dá à luz a uma cópia de si mesmo.",
"item_desc59","[#ffffff]{a}*{b}% chance to double the highest # peg.","[#ffffff]{a}*{b}% de chance de dobrar o peg de maior #.",
"item_desc60","[#ffffff]{a}*Emits one ichor stream for every {b} times Nubby has died in this game.{a}*When a peg is hit by ichor, [#ffd500]{c}Pass round goal [spr_ITArrow,0]{c}[#ffffff] items and perks will trigger.{a}(Currently emits {d})","[#ffffff]{a}*Emite uma torrente de icor para cada {b} vezes que Nubby morreu nesta partida.{a}*Quando um peg é atingido por icor, itens e poderes de ativação por [#ffd500]{c}Meta do round ultrapassada [spr_ITArrow,0]{c}[#ffffff] serão ativados.",
"item_desc61","[#ffffff]{a}*Randomizes all items in your inventory... Good luck!","[#ffffff]{a}*Randomiza todos os itens no seu inventário... Boa sorte!",
"item_desc62","[#ffffff]*Contains a random common item from Nubby Mart.","[#ffffff]*Contém um item comum aleatório do Nubby-Mart.",
"item_desc63","[#ffffff]*Contains a random common item from the black market.","[#ffffff]*Contém um item comum aleatório do mercado negro.",
"item_desc64","[#ffffff]*Contains a random common food item.","[#ffffff]*Contém uma comida comum aleatória.",
"item_desc65","[#ffffff]{a}*For every time the board has restocked this game, gain +{b} points.{a}(Currently +{c} points)","[#ffffff]{a}*Para cada vez que o campo foi reposto nesta partida, ganhe +{b} pontos.{a}(No momento +{c} pontos)",
"item_desc66","[#ffffff]{a}*A random peg emits a {b}Cosmo-Blast{b}.{a}*When a peg is popped by a cosmo-blast, it counts as {c} peg pops instead of 1.","[#ffffff]{a}*Um peg aleatório emite uma {b}Detonação Cósmica{b}.{a}*Quando um peg é estourado por uma detonação cósmica, vale como {c} pegs estourados ao invés de 1.",
"item_desc67","[#ffffff]{a}*When this is force-triggered, it transfers the force-trigger to the [#ffb3ff]ITEM TO THE LEFT OF ME[#ffffff].{a}*Has a {c}% chance to add on +1 additional force-trigger.","[#ffffff]{a}*Quando isto é ativado à força, transfere a ativação à força para o [#ffb3ff]ITEM À MINHA ESQUERDA[#ffffff].{a}*Tem {c}% de chance de realizar +1 ativação à força.",
"item_desc68","[#ffffff]{a}*Pops a random peg. When this peg pops, it will give points four times.","[#ffffff]{a}*Estoura um peg aleatório. Quando esse peg estoura, ele dá pontos quatro vezes.",

"item_desc69","[#ffffff]{a}*Empty description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",

"item_desc70","[#ffffff]{a}*Summons {b} quills that fall from the sky and pop {c} peg each.{a}*10% chance to summon one additional quill (3 total).","[#ffffff]{a}*Invoca {b} espinhos que caem do céu e estouram {c} peg cada.{a}*10% de chance de invocar um espinho adicional (3 ao todo).",
"item_desc71","[#ffffff]{a}*A random peg will explode and pop {b} (maximum) nearby pegs.","[#ffffff]{a}*Um peg aleatório irá explodir e estourar (no máximo) {b} pegs próximos.",
"item_desc72","[#ffffff]{a}*Every item in your inventory gives points equal to double the value of a random peg's number.","[#ffffff]{a}*Cada item no seu inventário dará pontos igual ao dobro do valor de um peg aleatório.",
"item_desc73","[#ffffff]{a}*If Nubby is still alive, summons a {b}disease-orb{b} that will aggresively float around and pop pegs.{a}*Disease-orbs die when Nubby dies.","[#ffffff]{a}*Se Nubby ainda está vivo, invoca uma {b}orbe doente{b} que flutua agressivamente pelo campo e estoura pegs.{a}*Orbes doentes morrem quando Nubby morre.",
"item_desc74","[#ffffff]{a}*{b} in {c} chance to double ALL pegs.{a}*{d} in {e} chance to double all pegs twice.","[#ffffff]{a}*Chance de {b} em {c} de dobrar TODOS os pegs.{a}*Chance de {d} em {e} de dobrar todos os pegs duas vezes.",

"item_desc75","[#ffffff]{a}*Empty description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",

"item_desc76","[#ffffff]{a}*A random peg will emit {c} {b}snot rockets{b} that pop any pegs they pass through twice.","[#ffffff]{a}*Um peg aleatório emitirá {c} {b}foguetes de ranho{b} que estouram todo peg que atravessarem duas vezes.",
"item_desc77","[#ffffff]{a}*Summons one straw that pops one peg.{a}*Pegs popped by straws give an additional +{b}% of their #.{a}*+Gains +{c}% for every time you've jumbled pegs in this game.","[#ffffff]{a}*Invoca um canudo que estoura um peg.{a}*Pegs estourados por canudos dão +{b}% de seu #.{a}*Ganhe +{c}% para cada vez que você embaralhou os pegs nesta partida.",
"item_desc78","[#ffffff]{a}*All pegs will give points equal to quadruple the number on the lowest # peg.","[#ffffff]{a}*Todos os pegs darão pontos igual ao quádruplo do número no peg de menor #.",
"item_desc79","[#ffffff]{a}*{b}% chance cause a giant explosion that pops all pegs once.{a}*{c}% chance if you are on your last shot.","[#ffffff]{a}*{b}% de chance de provocar uma enorme explosão que estoura todos os pegs uma vez.{a}*{c}% de chance se for seu último tiro.",
"item_desc80","[#ffffff]{a}*ALL peg spaces will give points equal to the total amount of pegs that have been popped this round.","[#ffffff]{a}*TODOS os espaços de peg darão pontos iguais à quantidade total de pegs estourados neste round.",
"item_desc81","[#ffffff]{a}*Randomizes triggers for all items in your inventory.{a}*This change cannot be undone.","[#ffffff]{a}*Randomiza as ativações de todos os itens no seu inventário.{a}*Essa mudança não pode ser desfeita.",
"item_desc82","[#ffffff]{a}*Pops {b} random pegs.","[#ffffff]{a}*Estoura {b} pegs aleatórios.",
"item_desc83","[#ffffff]{a}*Multiply total points by {b}x.","[#ffffff]{a}*Multiplica os pontos totais por {b}x.",
"item_desc84","[#ffffff]{a}*Nubby gives points equal to double the number of times that Nubby has bounced this round.","[#ffffff]{a}*Nubby dá pontos igual ao dobro do número de vezes que Nubby quicou neste round.",
"item_desc85","[#ffffff]{a}*Summons a sword-shot that will pop a random peg {b} times.","[#ffffff]{a}*Invoca um tiro-espada que irá estourar um peg aleatório {b} vezes.",

"item_desc86","[#ffffff]{a}*Empty description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",
