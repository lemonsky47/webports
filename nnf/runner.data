"perk_desc0","[#e6ffe6]{a}*Empty perk description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",	
	
"perk_desc1","[#e6ffe6]{a}*Force-triggers all items.{a}*Disables the item in [#ffb3ff]SLOT #{b}[#e6ffe6].","TRANSLATED TEXT GOES HERE",		
"perk_desc2","[#e6ffe6]{a}*{b}% chance to force-trigger the right-most item in your inventory.","TRANSLATED TEXT GOES HERE",		
"perk_desc3","[#e6ffe6]{a}*{b}% chance to force-trigger the item in [#ffb3ff]SLOT #{c}[#e6ffe6].","TRANSLATED TEXT GOES HERE",		
"perk_desc4","[#e6ffe6]{a}*If the round started less than {b} seconds ago, force-triggers the items in [#ffb3ff]SLOTS #1, #2, and #3[#e6ffe6].","TRANSLATED TEXT GOES HERE",
"perk_desc5","[#e6ffe6]{a}*Force-triggers the item in [#ffb3ff]SLOT #{b}[#e6ffe6].","TRANSLATED TEXT GOES HERE",	
"perk_desc6","[#e6ffe6]{a}*Force-triggers all items.","TRANSLATED TEXT GOES HERE",	
"perk_desc7","[#e6ffe6]{a}*Force-triggers all items in odd-numbered slots.","TRANSLATED TEXT GOES HERE",		
"perk_desc8","[#e6ffe6]{a}*Force-triggers one random item.","TRANSLATED TEXT GOES HERE",		
"perk_desc9","[#e6ffe6]{a}*Force-triggers all {b}[#ffd500]First peg popped [spr_ITArrow,0][#e6ffe6]{b} items.","TRANSLATED TEXT GOES HERE",	
"perk_desc10","[#e6ffe6]{a}*{b}% chance to force-trigger item in [#ffb3ff]SLOT #{c}[#e6ffe6].","TRANSLATED TEXT GOES HERE",		
"perk_desc11","[#e6ffe6]{a}*Force-triggers the item in slot #5.","TRANSLATED TEXT GOES HERE",		
"perk_desc12","[#e6ffe6]{a}If [#ffb3ff]SLOT #{b}[#e6ffe6] is empty...{a}*A random item from nubby-mart will appear in [#ffb3ff]SLOT #{b}[#e6ffe6] and force-trigger {c} times.{a}*The new item will disappear at the end of the round.","TRANSLATED TEXT GOES HERE",		
"perk_desc13","[#e6ffe6]{a}*Force-triggers the item in [#ffb3ff]SLOT #{b}[#e6ffe6], 3 times.","TRANSLATED TEXT GOES HERE",		
"perk_desc14","[#e6ffe6]{a}*Force-triggers the item in [#ffb3ff]SLOT #{b}[#e6ffe6] 1 time for every {c} coins you have.","TRANSLATED TEXT GOES HERE",		
"perk_desc15","[#e6ffe6]{a}*Force-triggers the items in slots [#ffb3ff]SLOTS #5, #6, and #7[#e6ffe6], {b} times each.","TRANSLATED TEXT GOES HERE",		
"perk_desc16","[#e6ffe6]{a}If you have 4 or less items... {a}*Force-triggers the item in [#ffb3ff]SLOT #{b}[#e6ffe6], {c} times","TRANSLATED TEXT GOES HERE",		
"perk_desc17","[#e6ffe6]{a}*If the round goal was passed {b} or more times, force-triggers all items and lose {c}% of total points.","TRANSLATED TEXT GOES HERE",	
"perk_desc18","[#e6ffe6]{a}*If you have passed the round goal this round, force-triggers the item in [#ffb3ff]SLOT #{b}[#e6ffe6], twice.","TRANSLATED TEXT GOES HERE",	
"perk_desc19","[#e6ffe6]{a}*Force-triggers the leftmost item x times.{a}*Jumbling pegs increases x by +{b}.{a}*This value resets after each round.","TRANSLATED TEXT GOES HERE",
"perk_desc20","[#e6ffe6]{a}*Force-triggers the left-most item in your inventory.{a}*Lose {b}% of your total points.","TRANSLATED TEXT GOES HERE",
"perk_desc21","[#e6ffe6]{a}*Force-triggers all {b}[#ffd500]x pegs popped [spr_ITArrow,0][#e6ffe6]{b} items.","TRANSLATED TEXT GOES HERE",
"perk_desc22","[#e6ffe6]{a}*Force-triggers all items that summon anything.","TRANSLATED TEXT GOES HERE",
"perk_desc23","[#e6ffe6]{a}*If the first peg popped was the highest # peg, force-triggers the items in [#ffb3ff]SLOTS #1, and #2[#e6ffe6], {b} times each.","TRANSLATED TEXT GOES HERE",
"perk_desc24","[#e6ffe6]{a}*Force-triggers the item in [#ffb3ff]SLOT #{b}[#e6ffe6] 2 times for each empty inventory slot.","TRANSLATED TEXT GOES HERE",
"perk_desc25","[#e6ffe6]{a}*Force-triggers the item in slot [#ffb3ff]SLOT #{b}[#e6ffe6] 1 time for each perk you have.","TRANSLATED TEXT GOES HERE",
"perk_desc26","[#e6ffe6]{a}*Force-triggers all non-upgraded items.","TRANSLATED TEXT GOES HERE",
"perk_desc27","[#e6ffe6]{a}*Force triggers all {b}[#ffd500]Nubby Dies [spr_ITArrow,0][#e6ffe6]{b} items again.","TRANSLATED TEXT GOES HERE",
"perk_desc28","[#e6ffe6]{a}*Force-triggers the item in slot #{b}, 1 time for every {c} food items you've consumed.{a}(Foods eaten: {d})","TRANSLATED TEXT GOES HERE",
"perk_desc29","[#e6ffe6]{a}*Force-triggers the item in slot #{b}, 1 time for every {c} rounds you've passed.{a}(Current force-triggers: {d})","TRANSLATED TEXT GOES HERE",
"perk_desc30","[#e6ffe6]{a}*Has an x% chance to force-trigger the item in slot #{b}.{a}*For each remaining life, gain +{c}% odds.","TRANSLATED TEXT GOES HERE",
"perk_desc31","[#e6ffe6]{a}*Has an x% chance to force-trigger the item in slot #{b}.{a}*For each remaining life, gain +{c}% odds.","TRANSLATED TEXT GOES HERE",
"perk_desc32","[#e6ffe6]{a}*{b}% chance to force-trigger the right-most item in your inventory.","TRANSLATED TEXT GOES HERE",

