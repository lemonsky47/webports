"highscore","New Highscore!{a}{b}","Ny rekord!{a}{b}",
"nohighscore_challenge","Score: {b}{a}Challenge Highscore: {c}","Score: {b}{a}Utfordringsrekord: {c}",
"supervisor_highscore","Highscore: {a}","Rekord: {a}",		
