"challenge_name_6","{a}Nubbelocke{a}","{a}Nubbelocke{a}",
"challenge_name_7","{a}Times up!{a}","{a}Koniec Czasu!{a}",
"challenge_name_8","{a}Pol's Bane{a}","{a}Zguba Pola{a}",
"challenge_name_9","{a}Pheebie-Mode{a}","{a}Tryb Pheebie{a}",
