perk_desc0,[#e6ffe6]{a}*Empty perk description,"***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",
,,,
perk_desc1,[#e6ffe6]{a}*Force-triggers all items.{a}*Disables the item in [#ffb3ff]SLOT #{b}[#e6ffe6].,[#e6ffe6]{a}*Activa á forza todos os obxectos.{a}*Inhabilita o obxecto da [#ffb3ff]CELA {b}[#e6ffe6].,
perk_desc2,[#e6ffe6]{a}*{b}% chance to force-trigger the right-most item in your inventory.,[#e6ffe6]{a}*Probabilidade do {b}% de activar á forza o obxecto máis á dereita do teu inventario.,
perk_desc3,[#e6ffe6]{a}*{b}% chance to force-trigger the item in [#ffb3ff]SLOT #{c}[#e6ffe6].,[#e6ffe6]{a}*Probabilidade do {b}% de activar á forza o obxecto da [#ffb3ff]CELA {c}[#e6ffe6].,
perk_desc4,"[#e6ffe6]{a}*If the round started less than {b} seconds ago, force-triggers the items in [#ffb3ff]SLOTS #1, #2, and #3[#e6ffe6].","[#e6ffe6]{a}*Se a rolda comezou hai menos de {b} segundos, activa á forza os obxectos das [#ffb3ff]CELAS 1, 2 e 3[#e6ffe6].",
perk_desc5,[#e6ffe6]{a}*Force-triggers the item in [#ffb3ff]SLOT #{b}[#e6ffe6].,[#e6ffe6]{a}*Activa á forza o obxecto da [#ffb3ff]CELA {b}[#e6ffe6].,
perk_desc6,[#e6ffe6]{a}*Force-triggers all items.,[#e6ffe6]{a}*Activa á forza todos os obxectos.,
perk_desc7,[#e6ffe6]{a}*Force-triggers all items in odd-numbered slots.,[#e6ffe6]{a}*Activa á forza os obxectos nas celas impares.,
perk_desc8,[#e6ffe6]{a}*Force-triggers one random item.,[#e6ffe6]{a}*Activa á forza un obxecto aleatorio.,
perk_desc9,"[#e6ffe6]{a}*Force-triggers all {b}[#ffd500]First peg popped [spr_ITArrow,0][#e6ffe6]{b} items.","[#e6ffe6]{a}*Activa á forza todos os obxectos coa activación {b}[#ffd500]Primeira ficha estoupada [spr_ITArrow,0][#e6ffe6]{b}.",
perk_desc10,[#e6ffe6]{a}*{b}% chance to force-trigger item in [#ffb3ff]SLOT #{c}[#e6ffe6].,[#e6ffe6]{a}*Probabilidade do {b}% de activar á forza o obxecto na [#ffb3ff]CELA {c}[#e6ffe6].,
perk_desc11,[#e6ffe6]{a}*Force-triggers the item in slot #5.,[#e6ffe6]{a}*Activa á forza o obxecto na cela 5.,
perk_desc12,[#e6ffe6]{a}If [#ffb3ff]SLOT #{b}[#e6ffe6] is empty...{a}*A random item from nubby-mart will appear in [#ffb3ff]SLOT #{b}[#e6ffe6] and force-trigger {c} times.{a}*The new item will disappear at the end of the round.,[#e6ffe6]{a}Se a [#ffb3ff]CELA {b}[#e6ffe6] está baleira...{a}*Un obxecto aleatorio do MercaNubby aparece na [#ffb3ff]CELA {b}[#e6ffe6] e actívase á forza {c} veces.{a}*O novo obxecto desaparece ao final da rolda.,
perk_desc13,"[#e6ffe6]{a}*Force-triggers the item in [#ffb3ff]SLOT #{b}[#e6ffe6], 3 times.","[#e6ffe6]{a}*Activa á forza o obxecto da [#ffb3ff]CELA {b}[#e6ffe6], 3 veces.",
perk_desc14,[#e6ffe6]{a}*Force-triggers the item in [#ffb3ff]SLOT #{b}[#e6ffe6] 1 time for every {c} coins you have.,[#e6ffe6]{a}*Activa á forza o obxecto da [#ffb3ff]CELA {b}[#e6ffe6] unha vez por cada {c} moedas que teñas.,
perk_desc15,"[#e6ffe6]{a}*Force-triggers the items in slots [#ffb3ff]SLOTS #5, #6, and #7[#e6ffe6], {b} times each.","[#e6ffe6]{a}*Activa á forza os obxectos das [#ffb3ff]CELAS 5, 6 e 7[#e6ffe6], {b} veces cada un.",
perk_desc16,"[#e6ffe6]{a}If you have 4 or less items... {a}*Force-triggers the item in [#ffb3ff]SLOT #{b}[#e6ffe6], {c} times","[#e6ffe6]{a}Se tes 4 ou menos obxectos... {a}*Activa á forza o obxecto na [#ffb3ff]CELA {b}[#e6ffe6], {c} veces.",
perk_desc17,"[#e6ffe6]{a}*If the round goal was passed {b} or more times, force-triggers all items and lose {c}% of total points.","[#e6ffe6]{a}*Se a meta da rolda se supera {b} ou máis veces, activa á forza todos os obxectos e perde {c}% da puntuación total.",
perk_desc18,"[#e6ffe6]{a}*If you have passed the round goal this round, force-triggers the item in [#ffb3ff]SLOT #{b}[#e6ffe6], twice.","[#e6ffe6]{a}*Se a meta da rolda foi superada, activa á forza o obxecto na [#ffb3ff]CELA {b}[#e6ffe6], dúas veces.",
perk_desc19,[#e6ffe6]{a}*Force-triggers the leftmost item x times.{a}*Jumbling pegs increases x by +{b}.{a}*This value resets after each round.,[#e6ffe6]{a}*Activa á forza o obxecto máis á esquerda x veces.{a}*Mesturar o taboleiro aumenta x por +{b}.{a}*O valor de x reiníciase en cada rolda.,
perk_desc20,[#e6ffe6]{a}*Force-triggers the left-most item in your inventory.{a}*Lose {b}% of your total points.,[#e6ffe6]{a}*Activa á forza o obxecto máis á esquerda do teu inventario.{a}*Perde {b}% da puntuación total.,
perk_desc21,"[#e6ffe6]{a}*Force-triggers all {b}[#ffd500]x pegs popped [spr_ITArrow,0][#e6ffe6]{b} items.","[#e6ffe6]{a}*Activa á forza todos os obxectos coa activación {b}[#ffd500]x fichas estoupadas [spr_ITArrow,0][#e6ffe6]{b}.",
perk_desc22,[#e6ffe6]{a}*Force-triggers all items that summon anything.,[#e6ffe6]{a}*Activa á forza todos os obxectos que invocan algo.,
perk_desc23,"[#e6ffe6]{a}*If the first peg popped was the highest # peg, force-triggers the items in [#ffb3ff]SLOTS #1, and #2[#e6ffe6], {b} times each.","[#e6ffe6]{a}*Se a primeira ficha estoupada é a máis grande, activa á forza os obxectos das [#ffb3ff]CELAS 1 e 2[#e6ffe6], {b} veces cada un.",
perk_desc24,[#e6ffe6]{a}*Force-triggers the item in [#ffb3ff]SLOT #{b}[#e6ffe6] 2 times for each empty inventory slot.,[#e6ffe6]{a}*Activa á forza o obxecto da [#ffb3ff]CELA {b}[#e6ffe6] 2 veces por cada espazo baleiro no inventario.,
perk_desc25,[#e6ffe6]{a}*Force-triggers the item in slot [#ffb3ff]SLOT #{b}[#e6ffe6] 1 time for each perk you have.,[#e6ffe6]{a}*Activa á forza o obxecto da [#ffb3ff]CELA {b}[#e6ffe6] 1 vez por cada libro que teñas.,
perk_desc26,[#e6ffe6]{a}*Force-triggers all non-upgraded items.,[#e6ffe6]{a}*Activa á forza todos os obxectos non mellorados.,
perk_desc27,"[#e6ffe6]{a}*Force triggers all {b}[#ffd500]Nubby Dies [spr_ITArrow,0][#e6ffe6]{b} items again.","[#e6ffe6]{a}*Activa á forza todos os obxectos coa activación {b}[#ffd500]Nubby morre [spr_ITArrow,0][#e6ffe6]{b} de novo.",
perk_desc28,"[#e6ffe6]{a}*Force-triggers the item in slot #{b}, 1 time for every {c} food items you've consumed.{a}(Foods eaten: {d})","[#e6ffe6]{a}*Activa á forza o obxecto da  [#ffb3ff]CELA {b}[#e6ffe6], 1 vez por cada {c} comidas consumidas.{a}(Comidas consumidas: {d})",
perk_desc29,"[#e6ffe6]{a}*Force-triggers the item in slot #{b}, 1 time for every {c} rounds you've passed.{a}(Current force-triggers: {d})","[#e6ffe6]{a}*Activa á forza o obxecto da  [#ffb3ff]CELA {b}[#e6ffe6], 1 vez por cada {c} roldas superadas.{a}(Roldas superadas: {d})",
perk_desc30,"[#e6ffe6]{a}*Has an x% chance to force-trigger the item in slot #{b}.{a}*For each remaining life, gain +{c}% odds.","[#e6ffe6]{a}*Probabilidade do x% de activar á forza o obxecto da [#ffb3ff]CELA {b}[#e6ffe6].{a}*Por cada vida restante, suma +{c}% de probabilidade.",
perk_desc31,"[#e6ffe6]{a}*Has an x% chance to force-trigger the item in slot #{b}.{a}*For each remaining life, gain +{c}% odds.","[#e6ffe6]{a}*Probabilidade do x% de activar á forza o obxecto da [#ffb3ff]CELA {b}[#e6ffe6].{a}*Por cada vida restante, suma +{c}% de probabilidade.",
perk_desc32,[#e6ffe6]{a}*{b}% chance to force-trigger the right-most item in your inventory.,[#e6ffe6]{a}*Probabilidade do {b}% de activar á forza o obxecto máis á dereita do teu inventario.,
