"null","[#ffd500]Error: null","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",

"item_desc0","[#ffffff]{a}*Pops a random peg. When this peg pops, it will give points twice.","[#ffffff]{a}*Sprekk en tilfeldig knott. Når denne knotten sprekkes, gir den poeng to ganger.",		
"item_desc1","[#ffffff]{a}*Mimics the non-upgraded effect of the most recently eaten food item{a}*Will mimic: {c}{b}{c}. {d}","[#ffffff]{a}*Etterligner den uoppgraderte effekten til matvaren som sist ble spist {a}*Skal etterligne: {c}{b}{c}. {d}",		
"item_desc2","[#ffffff]{a}*Summons {b} quill that falls from the sky and pops {c} peg.","[#ffffff]{a}*Tilkaller {b} pigg, som faller fra himmelen og sprekker {c} knott.",		
"item_desc3","[#ffffff]{a}*A random peg will explode and pop {b} (maximum) nearby pegs.","[#ffffff]{a}*En tilfeldig knott eksploderer og sprekker {b} (maks) nærliggende knotter.",		
"item_desc4","[#ffffff]{a}*Every item in your inventory gives points equal to a random peg's number.","[#ffffff]{a}*Hver gjenstand i inventariumet ditt gir poeng tilsvarende verdien til en tilfeldig knott.",		
"item_desc5","[#ffffff]{a}*If Nubby is still alive, summons a {b}meat-orb{b} that will float around and pop pegs.{a}*Meat-orbs die when Nubby dies.","[#ffffff]{a}*Hvis Nubby fortsatt lever, tilkalles en {b}kjøttball{b} som flyter rundt og sprekker knotter.{a}*Kjøttballer dør når Nubby dør.",		
"item_desc6","[#ffffff]{a}*{b} in {c} chance to double ALL pegs.","[#ffffff]{a}*{b}/{c} sjanse for å doble ALLE knotter.",		
"item_desc7","[#ffffff]{a}*Gain +1 coin for every strawberry eaten during this game.{a}*Maxes out at {b} coins.","[#ffffff]{a}*Motta +1 mynt for hvert jordbær spist dette spillet.{a}*Maks {b} mynter.",		
"item_desc8","[#ffffff]{a}*A random peg will emit {c} {b}snot shots{b} that pop any pegs they pass through.","[#ffffff]{a}*En tilfeldig knott sender ut {c} {b}snørrskudd{b} som sprekker enhver knott de passerer gjennom.",		
"item_desc9","[#ffffff]{a}*Summons one straw that pops one peg.{a}*Pegs popped by straws give an additional +{b}% of their #.{a}*Gains +{c}% for every time you've jumbled pegs in this game.","[#ffffff]{a}*Tilkaller et sugerør som sprekker én knott.{a}*Knotter som sprekkes av sugerør gir i tillegg +{b} % av sine verdier.{a}*Mottar +{c} % for hver gang du har stokka om på knottene dette spillet.",		
"item_desc10","[#ffffff]{a}*All pegs will give points equal to double the number on the lowest # peg.","[#ffffff]{a}*Alle knotter gir poeng tilsvarende det dobbelte tallet på knotten med lavest verdi.",		
"item_desc11","[#ffffff]{a}*{b}% chance to cause a giant explosion that pops all pegs once.{a}*{c}% chance if you are on your last shot.","[#ffffff]{a}*{b} % sjanse for å forårsake en stor eksplosjon som sprekker alle knotter én gang.{a}*{c} % om du er på ditt siste skudd.",		
"item_desc12","[#ffffff]{a}*Every empty peg space will give points equal to the total amount of pegs that have been popped this round.","[#ffffff]{a}*Hver tomme knotteplass gir poenger tilsvarende det totale antallet knotter som er blitt sprukne denne runda.",	
"item_desc13","[#ffffff]{a}*Upgrades the right-most item in your inventory.{a}*Deletes the left-most item in your inventory.","[#ffffff]{a}*Oppgraderer gjenstanden lengst til høyre i inventariumet ditt.{a}*Sletter gjenstanen lengst til venstre i inventariumet ditt.",
"item_desc14","[#ffffff]{a}*Pops {b} random peg.","[#ffffff]{a}*Sprekker {b} tilfeldig knott",		
"item_desc15","[#ffffff]{a}*Multiply total points by {b}x.","[#ffffff]{a}*Multipliser poengsummen med {b}.",		
"item_desc16","[#ffffff]{a}*Nubby gives points equal to the number of times that Nubby has bounced this round.","[#ffffff]{a}*Nubby gir poeng tilsvarende antallet ganger Nubby har sprettet denne runda.",		
"item_desc17","[#ffffff]{a}*Summons a sharp-shot that will pop a random peg {b} times.","[#ffffff]{a}*Tilkaller et skarpt skudd som sprekker en tilfeldig knott {b} times.",		
"item_desc18","[#ffffff]{a}*Gives +1 {b}Croissant Perk{b}.","[#ffffff]{a}*Gir +1 {b}Croissantgode{b}.",	
"item_desc19","[#ffffff]{a}*Gives a copy of the most recently obtained perk.{a}(Currently {b})","[#ffffff]{a}*Gir en kopi av goden du mottok sist.{a}({b} for øyeblikket)",		
"item_desc20","[#ffffff]{a}*If Nubby is still alive, summon an egg missile that falls from the sky and causes an explosion that pops a row of pegs.","[#ffffff]{a}*Hvis Nubby fortsatt lever, tilkall en eggrakett som faller fra himmelen og forårsaker en eksplosjon som sprekker én rad med knotter",		
"item_desc21","[#ffffff]{a}*Pops the lowest # peg twice.","[#ffffff]{a}*Sprekker knotten med lavest verdi to ganger.",	
"item_desc22","[#ffffff]{a}*{b}% chance to do nothing.{a}*{c}% chance to double one random peg.{a}*{d}% chance to halve one random peg.","[#ffffff]{a}*{b} % sjanse at ingenting skjer.{a}*{c} % sjanse å doble en tilfeldig knott.{a}*{d} % sjanse å halvere en tilfeldig knott.",		
"item_desc23","[#ffffff]{a}*Gives +{b} points for every time this item has triggered during this round.{a}*{c} in {d} chance to metamorphosize.","[#ffffff]{a}*Gir +{b} poeng for hver gang denne gjenstanden er blitt trigget denne runda.{a}*{c}/{d} sjanse for å skifte ham.",		
"item_desc24","[#ffffff]{a}*{b}% chance to create a chain bolt that pops a cluster of pegs.","[#ffffff]{a}*{b} % sjanse for å skape et kobleskudd som sprekker en knottklynge.",		
"item_desc25","[#ffffff]{a}*If Nubby is still alive, summons {c} {b}meat-orbs{b} that will float around and pop pegs.{a}*Meat-orbs die when Nubby dies.","[#ffffff]{a}*Hvis Nubby fortsatt lever, tilkalles {c} {b}kjøttballer{b} som flyter rundt og sprekker knotter.{a}*Kjøttballer dør når Nubby dør.",
		
"item_desc26","[#ffffff]{a}*Test{b}","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",
		
"item_desc27","[#ffffff]{a}*{b} random pegs will copy the # of the first peg popped.{a}*If this item is in slot #{c}, {d} pegs will be affected instead of {b}.","[#ffffff]{a}*{b} tilfeldige knotter kopierer verdien til den første knotten som sprekkes.{a}*Om denne gjenstanden er på {c}. plass, påvirkes {d} knotter istedenfor {b}.",
"item_desc28","[#ffffff]{a}*Gives +{b} points for every time this item has triggered during this round.","[#ffffff]{a}*Gir +{b} poeng for hver gang denne gjenstanden er trigget denne runda.",		
"item_desc29","[#ffffff]{a}*Every peg will give points equal to {b}% of their #.","[#ffffff]{a}*Hver knott gir poenger tilsvarende {b} % av verdien sin.",		
"item_desc30","[#ffffff]{a}*Doubles a random peg.","[#ffffff]{a}*Dobler en tilfeldig knott.",		
"item_desc31","[#ffffff]{a}*Mutates into the non-upgraded version of the [#ffb3ff]ITEM TO THE LEFT OF ME[#ffffff] for the rest of the round.","[#ffffff]{a}*Gjøres om til den uoppgraderte versjonen av [#ffb3ff]GJENSTANDEN TIL VENSTRE FOR MEG[#ffffff] for resten av runda.",		
"item_desc32","[#ffffff]{a}*A random peg emits a pulse that doubles pegs within close range.","[#ffffff]{a}*En tilfeldig knott sender ut en puls som dobler knotter i nærheten.",	
"item_desc33","[#ffffff]{a}*Nubby emits a burst of nuclear waste.{a}*Nuclear waste pops any pegs it touches.{a}*If Nubby isn't alive, a random peg will emit the burst.","[#ffffff]{a}*Nubby sender ut atomavfall.{a}*Atomavfall sprekker enhver knott det berører.{a}*Hvis Nubby ikke er i live, sendes det ut av en tilfeldig knott.",
"item_desc34","[#ffffff]{a}*Marks a random peg.{a}*When a peg is marked, all pegs that have the same number will be doubled.{a}*If no pegs have the same number as the marked peg, a random peg will be doubled.","[#ffffff]{a}*Merker en tilfeldig knott.{a}*Når en knott merkes, dobles alle knotter med samme verdi.{a}*Om det ikke er noen andre knotter med samme verdi som den merkede knotten, dobles en tilfeldig knott.",		
"item_desc35","[#ffffff]{a}*{b} random pegs get smacked.{a}*When a peg is smacked, it counts as a {a}[#ffd500]{c}Peg halved [spr_ITArrow,0]{c} [#ffffff] trigger without actually halving it.","[#ffffff]{a}*{b} tilfeldige knotter smekkes.{a}*Når en knott smekkes, telles det som en {a}[#ffd500]{c}Knott halvert [spr_ITArrow,0]{c} [#ffffff]-trigger uten å faktisk halvere den.",		
"item_desc36","[#ffffff]{a}*Gain +1 coin for each remaining life.","[#ffffff]{a}*Motta +1 mynt for hvert gjenstående liv.",	
"item_desc37","[#ffffff]{a}*Doubles {c} random pegs whose # is less than {b}.","[#ffffff]{a}*Dobler {c} tilfeldige knotter med verdier lavere enn {b}.",	
"item_desc38","[#ffffff]{a}*50% chance to double total coins.{a}*50% chance to set total coins to 0.","[#ffffff]{a}*50 % sjanse for å doble totalen av mynter.{a}*50 % for å gjøre totalen av mynter til 0.",
"item_desc39","[#ffffff]{a}*Mutates into a random common item that is not currently in your inventory for the rest of the round.","[#ffffff]{a}*Gjøres om til en tilfeldig, vanlig gjenstand som ikke allerede er i inventariumet ditt for resten av runda.",
"item_desc40","[#ffffff]{a}*{b}% chance to double one random peg.","[#ffffff]{a}*{b} % sjanse for å doble en tilfeldig knott.",
"item_desc41","[#ffffff]{a}*Halves the highest # peg.{a}*Doubles the lowest # peg {b} times","[#ffffff]{a}*Halverer knotten med høyest verdi.{a}*Dobler knotten med lavest verdi {b} ganger",
"item_desc42","[#ffffff]{a}*Summon {b} clay balls.{a}*If a clay ball bounces off a wall OR peg, it will count as a [#ffd500]{d}Nubby hits wall [spr_ITArrow,0]{d} [#ffffff]trigger.{a}*Clay balls die after {c} bounces.","[#ffffff]{a}*Tilkall {b} trolldeigkladder.{a}*Om en kladd spretter av en vegg ELLER knott, telles det som om at [#ffd500]{d}Nubby treffer veggen [spr_ITArrow,0]{d} [#ffffff].{a}*Kladdene dør etter {c} sprett.",
"item_desc43","[#ffffff]{a}*Mimics the non-upgraded effect of the item in [#ffb3ff]SLOT #{b}[#ffffff], but keeps its own trigger.","[#ffffff]{a}*Etterligner den uoppgraderte effekten til gjenstanden på [#ffb3ff]PLASS {b}[#ffffff], men beholder triggeren sin.",
"item_desc44","[#ffffff]{a}*Gain +{b} points.{a}*If you are on round {d} or higher, gain +{c} points instead.","[#ffffff]{a}*Motta +{b} poeng.{a}*Er du på runde {d} eller videre, motta heller +{c} poeng.",
"item_desc45","[#ffffff]{a}*Gives +1 {b}Kebab Perk{b}","[#ffffff]{a}*Gir +1 {b}Grillspydgode{b}",
"item_desc46","[#ffffff]{a}*Stocks a random rare food item.","[#ffffff]{a}*Fyll på en tilfeldig, sjelden matvare.",
"item_desc47","[#ffffff]{a}*If the first peg popped is the highest # peg, multiply total score by {b}x.","[#ffffff]{a}*Om den første knotten som sprekkes er den med høyest verdi, gang poengsummen med {b}.",
"item_desc48","[#ffffff]{a}*Pops {b} random pegs.","[#ffffff]{a}*Sprekker {b} tilfeldige knotter.",
"item_desc49","[#ffffff]{a}*The lowest # peg becomes a copy of the highest # peg.","[#ffffff]{a}*Knotten med lavest verdi blir en kopi av den med høyest verdi.",
"item_desc50","[#ffffff]{a}*Upon returning to Nubby-Mart, gain +1 reroll.","[#ffffff]{a}*Når du er tilbake hos Nubby-Mart, motta +1 oppfrisking.",
"item_desc51","[#ffffff]{a}*Reduces round goal by -{b}%.{a}*Halves all pegs.","[#ffffff]{a}*Reduserer rundemålet med -{b} %.{a}*Halverer alle knotter.",
"item_desc52","[#ffffff]{a}*Triggers an electron beam that passes through pegs.{a}*When an electron beam hits a peg, the peg will give {b}% of its #.{a}*Electron beams do NOT pop pegs.","[#ffffff]{a}*Trigger en partikkelstråle som passerer gjennom knotter.{a}*Når en partikkelstråle treffer en knott, gir knotten {b} % av dens verdi.{a}*Knottene sprekkes IKKE av partikkelstråling.",
"item_desc53","[#ffffff]{a}*This item emits a god ray.{a}*The god ray rapidly pops a random peg once for each time the item in [#ffb3ff]SLOT #1 [#ffffff]has triggered in this round.","[#ffffff]{a}*Denne gjenstanden sender ut en lysstråle.{a}*Lysstrålen sprekker raskt en tilfeldig knott for hver gang gjenstanden på [#ffb3ff]PLASS 1 [#ffffff]er blitt trigget denne runda.",
"item_desc54","[#ffffff]{a}*Triggers the most recently obtained perk.{a}(Currently {b})","[#ffffff]{a}*Trigger goden du mottok sist.{a}({b} for øyeblikket)",
"item_desc55","[#ffffff]{a}*The lowest # peg gives points equal to {b}x its #.{a}*If the lowest # peg is {d} or less, it will give +{c} points instead.","[#ffffff]{a}*Knotten med lavest verdi gir poenger tilsvarende {b} ganger dens verdi.{a}*Om verdien på knotten med lavest verdi er {d} eller mindre, gir den +{c} poeng istedenfor.",
"item_desc56","[#ffffff]{a}*Summons a beach ball that emits {b} streams of confetti when it pops.{a}*Pegs popped by confetti give {c}% of their #.","[#ffffff]{a}*Tilkaller en badeball som sender ut {b} serpentiner når den sprekker.{a}*Knotter som sprekkes av serpentinene gir {c} % av sine verdier.",

"item_desc57","[#ffffff]{a}*Empty description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",

"item_desc58","[#ffffff]{a}*Nubby gives birth to a copy of himself.","[#ffffff]{a}*Nubby føder en kopi av seg selv.",
"item_desc59","[#ffffff]{a}*{b}% chance to double the highest # peg.","[#ffffff]{a}*{b} % sjanse for å doble knotten med høyest verdi.",
"item_desc60","[#ffffff]{a}*Emits one ichor stream for every {b} times Nubby has died in this game.{a}*When a peg is hit by ichor, [#ffd500]{c}Pass round goal [spr_ITArrow,0]{c}[#ffffff] items and perks will trigger.{a}(Currently emits {d})","[#ffffff]{a}*Sender ut en giftstråle for hver {b}. gang Nubby har dødd dette spillet.{a}*Når en knott treffes av gift, trigges gjenstander og goder med triggeren [#ffd500]{c}Passer rundemål [spr_ITArrow,0]{c}[#ffffff].{a}(Sender ut {d} for øyeblikket)",
"item_desc61","[#ffffff]{a}*Randomizes all items in your inventory... Good luck!","[#ffffff]{a}*Bytter ut alle gjenstandene dine med tilfeldige gjenstander ... Lykke til!",
"item_desc62","[#ffffff]*Contains a random common item from Nubby Mart.","[#ffffff]*Inneholder en tilfeldig, vanlig gjenstand fra Nubby-Mart.",
"item_desc63","[#ffffff]*Contains a random common item from the black market.","[#ffffff]*Inneholder en tilfeldig, vanlig gjenstand fra svartebørsen.",
"item_desc64","[#ffffff]*Contains a random common food item.","[#ffffff]*Inneholder en tilfeldig, vanlig matvare.",
"item_desc65","[#ffffff]{a}*For every time the board has restocked this game, gain +{b} points.{a}(Currently +{c} points)","[#ffffff]{a}*For hver gang brettet er blitt påfylt dette spillet, motta +{b} poeng.{a}(+{c} poeng for øyeblikket)",
"item_desc66","[#ffffff]{a}*A random peg emits a {b}Cosmo-Blast{b}.{a}*When a peg is popped by a cosmo-blast, it counts as {c} peg pops instead of 1.","[#ffffff]{a}*En tilfeldig knott sender ut et {b}kosmosmell{b}.{a}*Når en knott sprekkes av et kosmosmell, telles det som {c} sprekkinger istedenfor 1.",
"item_desc67","[#ffffff]{a}*When this is force-triggered, it transfers the force-trigger to the [#ffb3ff]ITEM TO THE LEFT OF ME[#ffffff].{a}*Has a {c}% chance to add on +1 additional force-trigger.","[#ffffff]{a}*Når dette trigges med tvang, overføres triggingen til [#ffb3ff]GJENSTANDEN TIL VENSTRE FOR MEG[#ffffff].{a}*Har en {c} % sjanse for å legge til +1 ekstra tvangstrigger.",
"item_desc68","[#ffffff]{a}*Pops a random peg. When this peg pops, it will give points four times.","[#ffffff]{a}*Sprekker en tilfeldig knott. Når denne knotten sprekkes, gir den poeng fire ganger.",

"item_desc69","[#ffffff]{a}*Empty description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",

"item_desc70","[#ffffff]{a}*Summons {b} quills that fall from the sky and pop {c} peg each.{a}*10% chance to summon one additional quill (3 total).","[#ffffff]{a}*Tilkaller {b} pigger som faller fra himmelen og sprekker {c} knott hver.{a}*10 % sjanse for å tilkalle en ekstra pigg (maks 3).",
"item_desc71","[#ffffff]{a}*A random peg will explode and pop {b} (maximum) nearby pegs.","[#ffffff]{a}*En tilfeldig knott eksploderer og sprekker {b} (maks) knotter i nærheten.",
"item_desc72","[#ffffff]{a}*Every item in your inventory gives points equal to double the value of a random peg's number.","[#ffffff]{a}*Hver gjenstand i inventariumet ditt gir poeng tilsvarende den dobbelte verdien til en tilfeldig knott.",
"item_desc73","[#ffffff]{a}*If Nubby is still alive, summons a {b}disease-orb{b} that will aggresively float around and pop pegs.{a}*Disease-orbs die when Nubby dies.","[#ffffff]{a}*Hvis Nubby fortsatt lever, tilkalles en {b}pestball{b} som aggressivt flyter rundt og sprekker knotter.{a}*Pestballer dør når Nubby dør.",
"item_desc74","[#ffffff]{a}*{b} in {c} chance to double ALL pegs.{a}*{d} in {e} chance to double all pegs twice.","[#ffffff]{a}*{b}/{c} sjanse for å doble ALLE knotter.{a}*{d}/{e} sjanse for å doble alle knotter to ganger.",

"item_desc75","[#ffffff]{a}*Empty description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",

"item_desc76","[#ffffff]{a}*A random peg will emit {c} {b}snot rockets{b} that pop any pegs they pass through twice.","[#ffffff]{a}*En tilfeldig knott sender ut {c} {b}snørraketter{b}, som ved gjennomgang sprekker knotter to ganger.",
"item_desc77","[#ffffff]{a}*Summons one straw that pops one peg.{a}*Pegs popped by straws give an additional +{b}% of their #.{a}*+Gains +{c}% for every time you've jumbled pegs in this game.","[#ffffff]{a}*Tilkaller et sugerør som sprekker én knott.{a}*Knotter som sprekkes av sugerør gir i tillegg +{b} % av sine verdier.{a}*Mottar +{c} % for hver gang du har stokka om på knottene dette spillet.",
"item_desc78","[#ffffff]{a}*All pegs will give points equal to quadruple the number on the lowest # peg.","[#ffffff]{a}*Alle knotter gir poeng tilsvarende firdobbelt verdien på knotten med lavest verdi.",
"item_desc79","[#ffffff]{a}*{b}% chance cause a giant explosion that pops all pegs once.{a}*{c}% chance if you are on your last shot.","[#ffffff]{a}*{b} % sjanse for at det skjer en gigantisk eksplosjon som sprekker alle knottene samtidig.{a}*{c} % sjanse om du er på ditt siste skudd.",
"item_desc80","[#ffffff]{a}*ALL peg spaces will give points equal to the total amount of pegs that have been popped this round.","[#ffffff]{a}*ALLE knottplasser gir poeng tilsvarende det totale antallet knotter som er blitt sprukket denne runda.",
"item_desc81","[#ffffff]{a}*Randomizes triggers for all items in your inventory.{a}*This change cannot be undone.","[#ffffff]{a}*Gjør triggerne til alle gjenstandene i inventariumet ditt tilfeldige.{a}*Dette kan ikke omgjøres.",
"item_desc82","[#ffffff]{a}*Pops {b} random pegs.","[#ffffff]{a}*Sprekker {b} tilfeldige knotter.",
"item_desc83","[#ffffff]{a}*Multiply total points by {b}x.","[#ffffff]{a}*Multipliser poengsummen med {b}.",
"item_desc84","[#ffffff]{a}*Nubby gives points equal to double the number of times that Nubby has bounced this round.","[#ffffff]{a}*[#ffffff]{a}*Nubby gir poeng tilsvarende dobbelt antallet ganger Nubby har sprettet denne runda.",
"item_desc85","[#ffffff]{a}*Summons a sword-shot that will pop a random peg {b} times.","[#ffffff]{a}*Tilkaller et sverdskudd som sprekker en tilfeldig knott {b} ganger.",

"item_desc86","[#ffffff]{a}*Empty description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",
"item_desc87","[#ffffff]{a}*Empty description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",

"item_desc88","[#ffffff]{a}*If Nubby is still alive, summon an ostrich-egg missile that falls from the sky an causes an explosion that pops 1 row and 1 column of pegs.","[#ffffff]{a}*Dersom Nubby fortsatt lever, tilkall en strutseegg-missil som faller fra himmelen og forårsaker en eksplosjon som sprekker en rad og en kolonne med knotter.",
"item_desc89","[#ffffff]{a}*Pops the two lowest # pegs, twice each.","[#ffffff]{a}*Sprekker de to knottene med lavest verdi, to ganger hver.",
"item_desc90","[#ffffff]{a}*{b}% chance to do nothing.{a}*{c}% chance to double one random peg.{a}*{d}% chance to halve one random peg.","[#ffffff]{a}*{b} % sjanse at ingenting skjer.{a} * {d} % sjanse for at en knotts verdi halveres.",
"item_desc91","[#ffffff]{a}*Gives +{b} points for every time this item has triggered during this round.{a}*{c} in {d} chance to metamorphosize.","[#ffffff]{a}*Gir +{b} poeng for hver gang denne gjenstanden er blitt trigget denne runda.{a}*{c}/{d} sjanse for å skifte ham.",
"item_desc92","[#ffffff]{a}*{b}% chance to create a high-voltage chain bolt that pops a cluster of pegs twice.","[#ffffff]{a}*{b} % sjanse for å skape et høyspent kobleskudd som sprekker en knottklynge to ganger.",
"item_desc93","[#ffffff]{a}*If Nubby is still alive, summons {c} {b}disease-orbs{b} that will aggresively float around and pop pegs.{a}*Disease-orbs die when Nubby dies.","[#ffffff]{a}*Hvis Nubby fortsatt lever, tilkalles {c} {b}pestballer{b} som aggressivt flyter rundt og sprekker knotter.{a}*Pestballer dør når Nubby dør.",

