"null","[#ffd500]Error: null","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",

"item_desc0","[#ffffff]{a}*Pops a random peg. When this peg pops, it will give points twice.","[#ffffff]{a}*Sprænger en tilfældig pløk. Når denne pløk sprænger, så giver den point to gange.",		
"item_desc1","[#ffffff]{a}*Mimics the non-upgraded effect of the most recently eaten food item{a}*Will mimic: {c}{b}{c}. {d}","[#ffffff]{a}*Efterligner den uopgraderet effekt af den seneste spiste mad gestand{a}*Vil efterligne: {c}{b}{c}. {d}",		
"item_desc2","[#ffffff]{a}*Summons {b} quill that falls from the sky and pops {c} peg.","[#ffffff]{a}*Tilkalder {b} pig, der falder fra himlen og sprænger {c} pløk.",		
"item_desc3","[#ffffff]{a}*A random peg will explode and pop {b} (maximum) nearby pegs.","[#ffffff]{a}*En tilfældig pløk vil eksplodere og sprænge {b} (maks) pløkker i nærheden.",		
"item_desc4","[#ffffff]{a}*Every item in your inventory gives points equal to a random peg's number.","[#ffffff]{a}*Hver genstand i din inventar giver point lig med en tilfældig pløks tal.",		
"item_desc5","[#ffffff]{a}*If Nubby is still alive, summons a {b}meat-orb{b} that will float around and pop pegs.{a}*Meat-orbs die when Nubby dies.","[#ffffff]{a}*Hvis Nubby er i live, tilkalder en {b}kød-bold{b} der vil svæve rundt og sprænge pløkker.{a}*Kød-bolde dør når Nubby dør.",		
"item_desc6","[#ffffff]{a}*{b} in {c} chance to double ALL pegs.","[#ffffff]{a}*{b} ud af {c} chance for at fordoble ALLE pløkker.",		
"item_desc7","[#ffffff]{a}*Gain +1 coin for every strawberry eaten during this game.{a}*Maxes out at {b} coins.","[#ffffff]{a}*Få +1 mønt for hvert jordbær du har spist i løbet af dette spil.{a}*Kan ikke give mere end {b} mønter.",		
"item_desc8","[#ffffff]{a}*A random peg will emit {c} {b}snot shots{b} that pop any pegs they pass through.","[#ffffff]{a}*En tilfældig pløk vil udsende {c} {b}snot skud{b}, der sprænger alle pløkker de går igennem.",		
"item_desc9","[#ffffff]{a}*Summons one straw that pops one peg.{a}*Pegs popped by straws give an additional +{b}% of their #.{a}*Gains +{c}% for every time you've jumbled pegs in this game.","[#ffffff]{a}*Tilkalder et sugerør, der sprænger en pløk.{a}*Pløkker sprængt af sugerør giver en ekstra +{b}% af deres #.{a}*Får +{c}% for hver gang du har blandet pløkker i dette spil.",		
"item_desc10","[#ffffff]{a}*All pegs will give points equal to double the number on the lowest # peg.","[#ffffff]{a}*Alle pløkker vil give point lig med det dobbelte af tallet på den laveste # pløk.",		
"item_desc11","[#ffffff]{a}*{b}% chance to cause a giant explosion that pops all pegs once.{a}*{c}% chance if you are on your last shot.","[#ffffff]{a}*{b}% chance for at forårsage en gigantisk eksplosion, der sprænger alle pløkker en gang.{a}*{c}% chance hvis du er på dit sidste skud.",		
"item_desc12","[#ffffff]{a}*Every empty peg space will give points equal to the total amount of pegs that have been popped this round.","[#ffffff]{a}*Hvert tomt pløk rum vil give point lig med den samlede mængde af pløkker, der er blevet sprængt denne runde.",	
"item_desc13","[#ffffff]{a}*Upgrades the right-most item in your inventory.{a}*Deletes the left-most item in your inventory.","[#ffffff]{a}*Opgraderer genstanden længst til højre i din inventar.{a}*Sletter genstanden længst til venstre i din inventar.",
"item_desc14","[#ffffff]{a}*Pops {b} random peg.","[#ffffff]{a}*Sprænger {b} tilfældig pløk.",		
"item_desc15","[#ffffff]{a}*Multiply total points by {b}x.","[#ffffff]{a}*Gang samlede point med {b}x.",		
"item_desc16","[#ffffff]{a}*Nubby gives points equal to the number of times that Nubby has bounced this round.","[#ffffff]{a}*Nubby giver point lig med antallet af gange, som Nubby har hoppet denne runde.",		
"item_desc17","[#ffffff]{a}*Summons a sharp-shot that will pop a random peg {b} times.","[#ffffff]{a}*Tilkalder en skarp nål, der vil sprænge en tilfældig pløk {b} gange.",		
"item_desc18","[#ffffff]{a}*Gives +1 {b}Croissant Perk{b}.","[#ffffff]{a}*Giver +1 {b}Croissant Frynsegode{b}.",	
"item_desc19","[#ffffff]{a}*Gives a copy of the most recently obtained perk.{a}(Currently {b})","[#ffffff]{a}*Giver en kopi af den seneste modtaget frynsegode.{a}(Lige nu {b})",		
"item_desc20","[#ffffff]{a}*If Nubby is still alive, summon an egg missile that falls from the sky and causes an explosion that pops a row of pegs.","[#ffffff]{a}*Hvis Nubby er i live, tilkald en æg missil, der falder fra himlen og forårsager en eksplosion, der sprænger en række af pløkker.",		
"item_desc21","[#ffffff]{a}*Pops the lowest # peg twice.","[#ffffff]{a}*Sprænger den laveste # pløk to gange.",	
"item_desc22","[#ffffff]{a}*{b}% chance to do nothing.{a}*{c}% chance to double one random peg.{a}*{d}% chance to halve one random peg.","[#ffffff]{a}*{b}% sandsynlighed for at gøre ingenting.{a}*{c}% chance for at fordoble en tilfældig pløk.{a}*{d}% risiko for at halvere en tilfældig pløk.",		
"item_desc23","[#ffffff]{a}*Gives +{b} points for every time this item has triggered during this round.{a}*{c} in {d} chance to metamorphosize.","[#ffffff]{a}*Giver +{b} point for hver gang denne genstand har udløst i løbet af runden.{a}*{c} ud af {d} chance for at metamorfosere.",		
"item_desc24","[#ffffff]{a}*{b}% chance to create a chain bolt that pops a cluster of pegs.","[#ffffff]{a}*{b}% chance for at lave et kæde stød, der sprænger en gruppe pløkker.",		
"item_desc25","[#ffffff]{a}*If Nubby is still alive, summons {c} {b}meat-orbs{b} that will float around and pop pegs.{a}*Meat-orbs die when Nubby dies.","[#ffffff]{a}*Hvis Nubby er i live, tilkalder {c} {b}kød-bolde{b}, der vil svæve rundt og sprænge pløkker.{a}*Kød-bolde dør når Nubby dør.",
		
"item_desc26","[#ffffff]{a}*Test{b}","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",
		
"item_desc27","[#ffffff]{a}*{b} random pegs will copy the # of the first peg popped.{a}*If this item is in slot #{c}, {d} pegs will be affected instead of {b}.","[#ffffff]{a}*{b} tilfældige pløkker vil kopiere # af den første sprængte pløk.{a}*Hvis denne genstand er på plads #{c}, {d} pløkker vil være påvirket i stedet for {b}.",
"item_desc28","[#ffffff]{a}*Gives +{b} points for every time this item has triggered during this round.","[#ffffff]{a}*Giver +{b} point for hver gang denne genstand har udløst i løbet af denne runde.",		
"item_desc29","[#ffffff]{a}*Every peg will give points equal to {b}% of their #.","[#ffffff]{a}*Hver pløk vil give point lig med {b}% af deres #.",		
"item_desc30","[#ffffff]{a}*Doubles a random peg.","[#ffffff]{a}*Fordobler en tilfældig pløk.",		
"item_desc31","[#ffffff]{a}*Mutates into the non-upgraded version of the [#ffb3ff]ITEM TO THE LEFT OF ME[#ffffff] for the rest of the round.","[#ffffff]{a}*Forvandler sig om til den uopgraderet udgave af [#ffb3ff]GENSTANDEN TIL VENSTRE FOR MIG[#ffffff] resten af runden.",		
"item_desc32","[#ffffff]{a}*A random peg emits a pulse that doubles pegs within close range.","[#ffffff]{a}*En tilfældig pløk udsender en puls, der fordobler pløkker indenfor kort rækkevidde.",	
"item_desc33","[#ffffff]{a}*Nubby emits a burst of nuclear waste.{a}*Nuclear waste pops any pegs it touches.{a}*If Nubby isn't alive, a random peg will emit the burst.","[#ffffff]{a}*Nubby udsender et udbrud af atomaffald.{a}*Atomaffald sprænger alle pløkker det rører.{a}*Hvis Nubby ikke er i live, så vil en tilfældig pløk udsende udbrudet.",
"item_desc34","[#ffffff]{a}*Marks a random peg.{a}*When a peg is marked, all pegs that have the same number will be doubled.{a}*If no pegs have the same number as the marked peg, a random peg will be doubled.","[#ffffff]{a}*Markerer en tilfældig pløk.{a}*Når en pløk er markeret, alle pløkker, der har det samme tal, vil fordobles.{a}*Hvis ingen pløkker har det samme tal som den markeret pløk, en tilfældig pløk vil fordobles.",		
"item_desc35","[#ffffff]{a}*{b} random pegs get smacked.{a}*When a peg is smacked, it counts as a {a}[#ffd500]{c}Peg halved [spr_ITArrow,0]{c} [#ffffff] trigger without actually halving it.","[#ffffff]{a}*{b} tilfældige pløkker bliver smækket.{a}*Når en pløk er smækket, så tæller det som en {a}[#ffd500]{c}Pløk halveret [spr_ITArrow,0]{c} [#ffffff] udløsning uden faktisk at halvere den.",		
"item_desc36","[#ffffff]{a}*Gain +1 coin for each remaining life.","[#ffffff]{a}*Få +1 mønt for hvert liv tilbage.",	
"item_desc37","[#ffffff]{a}*Doubles {c} random pegs whose # is less than {b}.","[#ffffff]{a}*Fordobler {c} tilfældige pløkker hvis # er mindre end {b}.",	
"item_desc38","[#ffffff]{a}*50% chance to double total coins.{a}*50% chance to set total coins to 0.","[#ffffff]{a}*50% chance for at fordoble antallet af dine mønter.{a}*50% risiko for at nulstille antallet af dine mønter.",
"item_desc39","[#ffffff]{a}*Mutates into a random common item that is not currently in your inventory for the rest of the round.","[#ffffff]{a}*Forvandler sig om til en tilfældig almindelig genstand, der ikke er i din inventar, resten af runden.",
"item_desc40","[#ffffff]{a}*{b}% chance to double one random peg.","[#ffffff]{a}*{b}% chance for at fordoble en tilfældig pløk.",
"item_desc41","[#ffffff]{a}*Halves the highest # peg.{a}*Doubles the lowest # peg {b} times","[#ffffff]{a}*Halverer den højeste # pløk.{a}*Fordobler den laveste # pløk {b} gange",
"item_desc42","[#ffffff]{a}*Summon {b} clay balls.{a}*If a clay ball bounces off a wall OR peg, it will count as a [#ffd500]{d}Nubby hits wall [spr_ITArrow,0]{d} [#ffffff]trigger.{a}*Clay balls die after {c} bounces.","[#ffffff]{a}*Tilkald {b} ler bolde.{a}*Hvis en ler bold hopper af en væg ELLER en pløk, så vil det tælle som en [#ffd500]{d}Nubby rammer væg [spr_ITArrow,0]{d} [#ffffff]udløsning.{a}*Ler bolde dør efter {c} hop.",
"item_desc43","[#ffffff]{a}*Mimics the non-upgraded effect of the item in [#ffb3ff]SLOT #{b}[#ffffff], but keeps its own trigger.","[#ffffff]{a}*Efterligner den uopgraderet effekt af genstanden på [#ffb3ff]PLADS #{b}[#ffffff], men beholder dens egen udløsning.",
"item_desc44","[#ffffff]{a}*Gain +{b} points.{a}*If you are on round {d} or higher, gain +{c} points instead.","[#ffffff]{a}*Få +{b} point.{a}*Hvis du er på runde {d} eller højere, få +{c} point i stedet for.",s
"item_desc45","[#ffffff]{a}*Gives +1 {b}Kebab Perk{b}","[#ffffff]{a}*Giver +1 {b}Kebab Frynsegode{b}",
"item_desc46","[#ffffff]{a}*Stocks a random rare food item.","[#ffffff]{a}*Laver en tilfældig sjælden mad genstand.",
"item_desc47","[#ffffff]{a}*If the first peg popped is the highest # peg, multiply total score by {b}x.","[#ffffff]{a}*Hvis den første sprængte pløk er den højeste # pløk, gang den samlede scoring med {b}x.",
"item_desc48","[#ffffff]{a}*Pops {b} random pegs.","[#ffffff]{a}*Sprænger {b} tilfældige pløkker.",
"item_desc49","[#ffffff]{a}*The lowest # peg becomes a copy of the highest # peg.","[#ffffff]{a}*Den laveste # pløk bliver en kopi af den højeste # pløk.",
"item_desc50","[#ffffff]{a}*Upon returning to Nubby-Mart, gain +1 reroll.","[#ffffff]{a}*Når du kommer tilbage til Nubby-Mart, få +1 genrul.",
"item_desc51","[#ffffff]{a}*Reduces round goal by -{b}%.{a}*Halves all pegs.","[#ffffff]{a}*Formindsker rundens mål med -{b}%.{a}*Halverer alle pløkker.",
"item_desc52","[#ffffff]{a}*Triggers an electron beam that passes through pegs.{a}*When an electron beam hits a peg, the peg will give {b}% of its #.{a}*Electron beams do NOT pop pegs.","[#ffffff]{a}*Udløser en elektrisk lysstråle, der går igennem pløkker.{a}*Når en elektrisk lysstråle rammer en pløk, så vil den pløk give {b}% af dens #.{a}*Elektriske lysstråle sprænger IKKE pløkker.",
"item_desc53","[#ffffff]{a}*This item emits a god ray.{a}*The god ray rapidly pops a random peg once for each time the item in [#ffb3ff]SLOT #1 [#ffffff]has triggered in this round.","[#ffffff]{a}*Denne genstand udsender en guddommelig stråle.{a}*Den guddommelig stråle sprænger en tilfældig pløk en gang for hver gang genstanden på [#ffb3ff]PLADS #1 [#ffffff]har udløst denne runde.",
"item_desc54","[#ffffff]{a}*Triggers the most recently obtained perk.{a}(Currently {b})","[#ffffff]{a}*Udløser den seneste modtaget frynsegode.{a}(Lige nu {b})",
"item_desc55","[#ffffff]{a}*The lowest # peg gives points equal to {b}x its #.{a}*If the lowest # peg is {d} or less, it will give +{c} points instead.","[#ffffff]{a}*Den laveste # pløk giver point lig med {b}x dens #.{a}*Hvis den laveste # pløk er {d} eller mindre, så vil den give +{c} point i stedet for.",
"item_desc56","[#ffffff]{a}*Summons a beach ball that emits {b} streams of confetti when it pops.{a}*Pegs popped by confetti give {c}% of their #.","[#ffffff]{a}*Tilkalder en badebold, der udsender {b} strømme af konfetti når den sprænger.{a}*Pløkker sprængt af konfetti giver {c}% af deres #.",

"item_desc57","[#ffffff]{a}*Empty description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",

"item_desc58","[#ffffff]{a}*Nubby gives birth to a copy of himself.","[#ffffff]{a}*Nubby føder en kopi af hamselv.",
"item_desc59","[#ffffff]{a}*{b}% chance to double the highest # peg.","[#ffffff]{a}*{b}% chance for at fordoble den højeste # pløk.",
"item_desc60","[#ffffff]{a}*Emits one ichor stream for every {b} times Nubby has died in this game.{a}*When a peg is hit by ichor, [#ffd500]{c}Pass round goal [spr_ITArrow,0]{c}[#ffffff] items and perks will trigger.{a}(Currently emits {d})","[#ffffff]{a}*Udsender en ichor strøm for hver {b} gange Nubby døde i dette spil.{a}*Når en pløk er ramt af ichor, [#ffd500]{c}Bestå rundens mål [spr_ITArrow,0]{c}[#ffffff] genstande og frynsegoder vil udløse.{a}(Udsender {d} lige nu)",
"item_desc61","[#ffffff]{a}*Randomizes all items in your inventory... Good luck!","[#ffffff]{a}*Randomiserer alle genstande i din inventar... Held og lykke!",
"item_desc62","[#ffffff]*Contains a random common item from Nubby Mart.","[#ffffff]*Indeholder en tilfældig almindelig genstand fra Nubby Mart.",
"item_desc63","[#ffffff]*Contains a random common item from the black market.","[#ffffff]*Indeholder en tilfældig almindelig genstand fra det sorte marked.",
"item_desc64","[#ffffff]*Contains a random common food item.","[#ffffff]*Indeholder en tilfældig almindelig mad genstand.",
"item_desc65","[#ffffff]{a}*For every time the board has restocked this game, gain +{b} points.{a}(Currently +{c} points)","[#ffffff]{a}*For hver gang brættet har genopfyldt dette spil, få +{b} point.{a}(Lige nu +{c} point)",
"item_desc66","[#ffffff]{a}*A random peg emits a {b}Cosmo-Blast{b}.{a}*When a peg is popped by a cosmo-blast, it counts as {c} peg pops instead of 1.","[#ffffff]{a}*En tilfældig pløk udsender et {b}Kosmo-Brag{b}.{a}*Når en pløk er sprængt af et kosmo-brag, så tæller det som {c} pløk sprængninger i stedet for 1.",
"item_desc67","[#ffffff]{a}*When this is force-triggered, it transfers the force-trigger to the [#ffb3ff]ITEM TO THE LEFT OF ME[#ffffff].{a}*Has a {c}% chance to add on +1 additional force-trigger.","[#ffffff]{a}*Når denne genstand er tvang-udløst, så overfører den tvang-udløsningen til [#ffb3ff]GENSTANDEN TIL VENSTRE FOR MIG[#ffffff].{a}*Har en {c}% chance for at tilføje +1 ekstra tvang-udløsning.",
"item_desc68","[#ffffff]{a}*Pops a random peg. When this peg pops, it will give points four times.","[#ffffff]{a}*Sprænger en tilfældig pløk. Når denne pløk sprænger, så vil den give point fire gange.",

"item_desc69","[#ffffff]{a}*Empty description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",

"item_desc70","[#ffffff]{a}*Summons {b} quills that fall from the sky and pop {c} peg each.{a}*10% chance to summon one additional quill (3 total).","[#ffffff]{a}*Tilkalder {b} pigge, der falder fra himlen og sprænger {c} pløk hver.{a}*10% chance for at tilkalde en ekstra pig (3 i alt).",
"item_desc71","[#ffffff]{a}*A random peg will explode and pop {b} (maximum) nearby pegs.","[#ffffff]{a}*En tilfældig pløk vil eksplodere og sprænge {b} (maks) pløkker i nærheden.",
"item_desc72","[#ffffff]{a}*Every item in your inventory gives points equal to double the value of a random peg's number.","[#ffffff]{a}*Hver genstand i din inventar giver point lig med det dobbelte af værdien af en tilfældig pløks tal.",
"item_desc73","[#ffffff]{a}*If Nubby is still alive, summons a {b}disease-orb{b} that will aggresively float around and pop pegs.{a}*Disease-orbs die when Nubby dies.","[#ffffff]{a}*Hvis Nubby er i live, tilkalder en {b}sygdoms-bold{b}, der vil aggresivt svæve rundt og sprænge pløkker.{a}*Sygdoms-bolde dør når Nubby dør.",
"item_desc74","[#ffffff]{a}*{b} in {c} chance to double ALL pegs.{a}*{d} in {e} chance to double all pegs twice.","[#ffffff]{a}*{b} ud af {c} chance for at fordoble ALLE pløkker.{a}*{d} ud af {e} chance for at fordoble alle pløkker to gange.",

"item_desc75","[#ffffff]{a}*Empty description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",

"item_desc76","[#ffffff]{a}*A random peg will emit {c} {b}snot rockets{b} that pop any pegs they pass through twice.","[#ffffff]{a}*En tilfældig pløk vil udsende {c} {b}snot raketer{b}, der sprænger alle pløkker de gå igennem to gange.",
"item_desc77","[#ffffff]{a}*Summons one straw that pops one peg.{a}*Pegs popped by straws give an additional +{b}% of their #.{a}*+Gains +{c}% for every time you've jumbled pegs in this game.","[#ffffff]{a}*Tilkalder et sugerør, der sprænger en pløk.{a}*Pløkker sprængt af sugerør giver en ekstra +{b}% af deres #.{a}*+Får +{c}% for hver gang du har blandet pløkker i dette spil.",
"item_desc78","[#ffffff]{a}*All pegs will give points equal to quadruple the number on the lowest # peg.","[#ffffff]{a}*Alle pløkker vil give point lig med fire gange tallet på den laveste # pløk.",
"item_desc79","[#ffffff]{a}*{b}% chance cause a giant explosion that pops all pegs once.{a}*{c}% chance if you are on your last shot.","[#ffffff]{a}*{b}% chance for at forårsage en gigantisk eksplosion, der sprænger alle pløkker en gang.{a}*{c}% chance hvis du er på dit sidste skud.",
"item_desc80","[#ffffff]{a}*ALL peg spaces will give points equal to the total amount of pegs that have been popped this round.","[#ffffff]{a}*ALLE pløk rum vil give point lig med den samlede mængde af pløkker, der er blevet sprængt denne runde.",
"item_desc81","[#ffffff]{a}*Randomizes triggers for all items in your inventory.{a}*This change cannot be undone.","[#ffffff]{a}*Randomiserer udløsninger for alle genstande i din inventar.{a}*Denne forandring kan ikke fortrydes.",
"item_desc82","[#ffffff]{a}*Pops {b} random pegs.","[#ffffff]{a}*Sprænger {b} tilfældige pløkker.",
"item_desc83","[#ffffff]{a}*Multiply total points by {b}x.","[#ffffff]{a}*Gang samlede point med {b}x.",
"item_desc84","[#ffffff]{a}*Nubby gives points equal to double the number of times that Nubby has bounced this round.","[#ffffff]{a}*Nubby giver point lig med det dobbelte af antallet af gange, som Nubby har hoppet denne runde.",
"item_desc85","[#ffffff]{a}*Summons a sword-shot that will pop a random peg {b} times.","[#ffffff]{a}*Tilkalder et sværd, der vil sprænge en tilfældig pløk {b} gange.",

"item_desc86","[#ffffff]{a}*Empty description","***NO TRANSLATION NEEDED, LEAVE THIS TEXT HERE***",
