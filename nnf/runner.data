peg_desc0,Missing description.,Missing description.
"	",,
peg_desc1,[#ffffcc]*This peg will give +{a} coin when popped for the first time.,"[#ffffcc]*Ez a Pöcök +{a} érmét ad, amikor először megpöckölődik."
peg_desc2,[#ffe6e6]*This peg can only be popped once it's stone layer has been popped {a} times.,"[#ffe6e6]*Ez a Pöcök csak akkor pöckölődik meg, ha a külső kőzetréteg már leesett."
peg_desc3,"[#ffffcc]*When popped for the first time, this peg will trigger a mega explosion that pops all pegs once.","[#ffffcc]*Amikor ez a Pöcök először megpöckölődik, akkor az egy hatalmas robbanást idéz elő és felrobbantja az összes Pöcköt."
peg_desc4,[#ffffcc]*This peg will pop the highest # peg when popped. (will not pop itself),"[#ffffcc]*Ez a Pöcök megpöcköli a legmagasabb értékű Pöcköt, amikor megpöckölik. (nem pöcköli meg magát)"
peg_desc5,[#ffe6e6]*This peg will subtract points instead of adding points when popped.,"[#ffe6e6]*Ez a Pöcök levon pontokat ahelyett, hogy adna."
peg_desc6,[#ffffcc]*This peg will force-trigger the item in [#ffb3ff]SLOT #{a} [#ffffcc]when popped.,"[#ffffcc]*Ez a pöcök aktiálja a tárgyat a(z) [#ffb3ff]{a}. [#ffffcc]helyen, amikor megpöckölják."
peg_desc7,[#ffffcc]*This peg will multiply your total points by {a}x when popped for the first time.,"[#ffffcc]*Ez a pöcök megszorozza a pontjaidat {a}-vel, amikor először megpöckölják."
peg_desc8,[#ffe6e6]*This peg will break after it has been popped for the first time.,"[#ffe6e6]*Ez a Pöcök eltörik, amikor megpöckölják."
peg_desc9,[#ffffcc]*This peg will explode and pop {a} pegs in a cross-pattern when popped for the first time.,"[#ffffcc]*Ez a Pöcök felrobban és megpöcköl {a} Pöcköt kereszt alakban, amikor először megpöckölődik."
peg_desc10,"[#ffffcc]*When popped for the first time, all other pegs will be doubled ({a}% chance) OR halved ({b}% chance)","[#ffffcc]*Amikor először kipukakkan, minden Pöcök megduplázódik ({a}% esély) VAGY megfeleződik({b}% esély)"
peg_desc11,[#ffffcc]*This peg will multiply your total points by {a}x when fully popped.,"[#ffffcc]*Ez a Pöcök megszorozza a pontjaidat {a}-vel, amikor teljesen megpöckölődik."
peg_desc12,[#ffe6e6]*This peg will kill nubby and end the round when fully popped.,"[#ffe6e6]*Ez a Pöcök megöli Nubbyt és véget vet a körnek, amikor teljesen megpöckölődik."
peg_desc13,[#ffe6e6]*This peg will disable a random item when fully popped.{a}*Disabled items cannot trigger for the rest of the round.,"[#ffe6e6]*Ez a Pöcök kikapcsol egy tárgyat, amikor teljesen megpöckölődik.{a}*A kikapcsolt tárgyak nem aktiválódhatnak a kör hátralévő részében."
peg_desc14,[#ffffcc]*This peg gives points twice when popped.,[#ffffcc]*Ez a Pöcök kétszer ad pontot .
,,
peg_desc15,[#ffffcc]*No description,[#ffffcc]*No description
,,
peg_desc16,[#ffffcc]*All psychic pegs will give points equal to their # when any psychic peg is popped.,"[#ffffcc]*Minden Pszichikus Pöcök pontot ad az értékének megfelelően, amikor egy megpöckölődik."
peg_desc17,"[#ffffcc]*When popped, this peg will emit 2 {b}snot-shots{b} that pop any pegs they pass through.","[#ffffcc]*Amikor megpöckölődik, 2 {b}Takony Lövedéket{b} lő ki, ami megpöcköl minden Pöcköt, amin átmegy."
peg_desc18,"[#ffe6e6]*When popped, all pegs will copy this peg's #.","[#ffe6e6]*Amikor megpöckölődik, minden Pöcök lemásolja az értékét."
peg_desc19,"[#ffe6e6]*When fully popped, the item in [#ffb3ff]SLOT #2[#ffe6e6] will be sold.","[#ffe6e6]*Amikor kipukkan, eladja a tárgyat a [#ffb3ff]2.[#ffe6e6] helyen."
peg_desc20,"[#ffffcc]*When popped, it counts as a [#ffd500]{a}Nubby hits wall [spr_ITArrow,0]{a} [#ffffcc] trigger.","[#ffffcc]*Amikor kipukkan, [#ffd500]{a}Nubby falba ütközik [spr_ITArrow,0]{a} [#ffffcc] aktiválódási kritériumnak számít."
peg_desc21,"[#ffffcc]*When popped once, gain +x coins, equal to the round number.","[#ffffcc]*Amikor megpöckölődik egyszer, +X pontot ad a kör számának megfelelően."
peg_desc22,"[#ffffcc]*When popped once, increase total coins by +{a}%.","[#ffffcc]*Amikor megpöckölődik egyszer, megnöveli az érmék számát +{a}%-al."
peg_desc23,"[#ffffcc]*When popped once, if nubby is still alive, duplicates nubby.","[#ffffcc]*Amikor megpöckölődik egyszer, ha Nubby életben van, megduplázza."
peg_desc24,"[#ffffcc]*When popped once, doubles {a} random pegs.","[#ffffcc]*Amikor megpöckölődik egyszer, megdupláz {a} Pöcköt."
peg_desc25,"[#ffffcc]*When popped once, force triggers all perks once.{a}*If no perks exist, force triggers all items once.","[#ffffcc]*Amikor megpöckölődik egyszer, aktiválja az összes képességet egyszerre .{a}*Ha nincsenek képességeid, akkor aktiválja az összes tárgyat egyszer."
peg_desc26,"[#ffffcc]*When popped once, gives a non-temporary random common item from nubby mart in the first empty inventory slot.","[#ffffcc]*Amikor megpöckölődik egyszer,  egy véletlen gyakori tárgyat ad a Nubby-Boltból, ami ott is marad az első helyen."
peg_desc27,"[#ffffcc]*When popped once, two copies of every summon in the game are summoned.","[#ffffcc]*Amikor megpöckölődik egyszer, minden megidézhető dolog megidéződik kétszer."
peg_desc28,"[#ffffcc]*When popped once, doubles all pegs twice, lose {a}% of total points.","[#ffffcc]*Amikor megpöckölődik egyszer, megdupláz minden pöcköt kétszer, elveszted a pontjaid {a}%-át."
peg_desc29,"[#ffffcc]*When popped once, a random item in your inventory that summons anything force triggers {a} times.","[#ffffcc]*Amikor megpöckölődik egyszer, egy véletlen tárgy, ami megidéz valamit, aktiválódik {a}-szer."
peg_desc30,"[#ffffcc]*When popped once, force triggers item in slot {a}, {b} times.","[#ffffcc]*Amikor megpöckölődik egyszer,  aktiválja a tárgyat a(z) {a}. helyen, {b}-szer."
peg_desc31,"[#ffffcc]*When popped once, force triggers item in slot {b}, {c} times.{a}*Can force trigger corrupted items.","[#ffffcc]*Amikor megpöckölődik egyszer,  aktiválja a tárgyat a(z) {b}. helyen, {c}-szer.{a}*Korruptált tárgyakat is aktiválhat"
peg_desc32,"[#ffffcc]*When popped once, force triggers all items {a} times.","[#ffffcc]*Amikor megpöckölődik egyszer, aktiválja az összes tárgyat {a}-szer."
peg_desc33,"[#ffffcc]*When popped once, doubles the highest # peg {a} times.","[#ffffcc]*Amikor megpöckölődik egyszer, megduplázza a legmagasabb értékű Pöcköt {a}-szer."
peg_desc34,"[#ffffcc]*When popped once, doubles all pegs {a} times.","[#ffffcc]*Amikor megpöckölődik egyszer, megduplázza az összes Pöcköt {a}-szer."
peg_desc35,"[#ffffcc]*When popped once, all items temporarily turn into random upgraded ultra-rare items.","[#ffffcc]*Amikor megpöckölődik egyszer, minden tárgy ideiglenesen átváltozik véletlen felfejlesztett szuper-ritka tárgyá."
peg_desc36,"[#ffffcc]*When popped once, summons {a} crazy straw summons.","[#ffffcc]*Amikor megpöckölődik egyszer, megidéz {a} őrült szívószálat."
peg_desc37,"[#ffffcc]*When popped once, multiplies total points by {a}x.","[#ffffcc]*Amikor megpöckölődik egyszer, megszorzza a pontjaidat {a}-vel."
peg_desc38,"[#ffe6e6]*When popped once, sets total points to {a}.","[#ffe6e6]*Amikor megpöckölődik egyszer, átálítja a pontjaidat {a}-ra."
peg_desc39,"[#ffe6e6]*When popped once, temporarily disables items in slots {a},{b}, and {c}.","[#ffe6e6]*Amikor megpöckölődik egyszer, kikapcsolja a(z) {a}. {b}. és {c} helyen lévő tárgyat."
peg_desc40,"[#ffe6e6]*When popped once, lose {a} coins.","[#ffe6e6]*Amikor megpöckölődik egyszer, elveszítsz {a} pontot ."
peg_desc41,"[#ffe6e6]*When popped once, temporarily randomizes all items in your inventory.","[#ffe6e6]*Amikor megpöckölődik egyszer, ideiglenesen randomizálja a tárgyakat a tárhelyedben."
peg_desc42,"[#ffe6e6]*When popped once, {a} random pegs become 1-pegs.","[#ffe6e6]*Amikor megpöckölődik egyszer, {a} Pöcök értéke átváltozik 1-re."
peg_desc43,"[#ffe6e6]*When popped once, halves all pegs.","[#ffe6e6]*Amikor megpöckölődik egyszer, megfelezi az összes Pöcköt."
,,
