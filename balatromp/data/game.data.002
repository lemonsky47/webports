local function read_multiplier()
    local mod = SMODS.current_mod
    local path = mod.path .. "crashes.txt"
    
    local file = io.open(path, "r")
    if file then
        local content = file:read("*a")
        file:close()
        local number = tonumber(content)
        return number
	end
		
    return 1
end

