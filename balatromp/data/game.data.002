local multiple_choice = SMODS.Joker{
    key = "multiple_choice",
    loc_txt = {
        name = "Multiple Choice",
        text = {
			"{C:green}#1# in #2#{} to gain {X:mult,C:white}X1{} Mult",
            "at the end of {C:attention}round{}. {C:inactive}(Max of 20){}",
			"{C:inactive}(Currently {X:mult,C:white}X#3#{}{C:inactive} Mult){}"
        }
    },

	
	config = { extra = { odds = 5, xmult = 1} },
	loc_vars = function(self, info_queue, card)
        local numerator, denominator = SMODS.get_probability_vars(card, 1, card.ability.extra.odds, 'omega_multiple_choice')
        return { vars = { numerator, denominator, card.ability.extra.xmult } }
    end,

    atlas = "multiple_choice",
    rarity = 2,
    cost = 6,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,

    calculate = function(self, card, context)
		if context.joker_main then
			return {xmult = card.ability.extra.xmult}
		end
		
        if context.end_of_round and context.game_over == false and context.main_eval and not context.blueprint and card.ability.extra.xmult < 20 then
		if SMODS.pseudorandom_probability(card, 'omega_multiple_choice', 1, card.ability.extra.odds) then
			card.ability.extra.xmult = card.ability.extra.xmult + 1
            return {message = "Correct!"}
        end
    end
end
}

local ms_paint = SMODS.Joker{
    key = "ms_paint",
    loc_txt = {
        name = "MS Paint Joker",
        text = {
			"{C:mult}+5{} Mult for each owned {C:common}Common{} Joker",
			"{C:inactive}(Currently {C:mult}+#1#{}{C:inactive} Mult){}"
        }
    },

	config = {
		extra = {
			mult = 5
		}
	},
	
	loc_vars = function(self, info_queue, card)
	local yesmult = 0
        for _, joker in ipairs(G.jokers and G.jokers.cards or {}) do
            if joker ~= card and joker.config.center.rarity == 1 or joker.config.center.rarity == "Common" then
                yesmult = yesmult + card.ability.extra.mult
            end
        end
        return { vars = { yesmult + card.ability.extra.mult } }
    end,

    atlas = "ms_paint",
    rarity = 1,
    cost = 4,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,

    calculate = function(self, card, context)
        if context.joker_main then
            local yesmult = 0
            for _, joker in ipairs(G.jokers.cards) do
                if joker ~= card and joker.config.center.rarity == 1 or joker.config.center.rarity == "Common" then
                    yesmult = yesmult + card.ability.extra.mult
                end
            end
            return {
                mult = yesmult + card.ability.extra.mult
            }
        end
    end
}

