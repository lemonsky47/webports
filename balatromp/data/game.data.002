local epic_games = SMODS.Joker{
    key = "epic_games",
    loc_txt = {
        name = "Epic Launcher",
        text = {
            "One free {C:attention}Joker{}",
			"in the shop each {C:attention}Ante{}"
        }
    },
	
	config = { extra = { activated = false } },
	
	loc_vars = function(self, info_queue, card)
        return {
		vars= {card.ability.extra.activated}
		}
    end,

    atlas = "epic_games",
    rarity = 2,
    cost = 6,
    unlocked = true,
    discovered = true,
    blueprint_compat = false,
    eternal_compat = true,
    perishable_compat = true,

    calculate = function(self, card, context)
	if context.starting_shop then
			 if G.shop_jokers then
                    for _, carder in pairs(G.shop_jokers.cards) do
						if card.ability.extra.activated == false then
							carder.ability.couponed = true
							carder:set_cost()
							carder:juice_up(0.3, 0.5)
							play_sound('holo1')
							card.ability.extra.activated = true
						end
                    end
				end
