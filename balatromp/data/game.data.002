local wind = SMODS.Joker{
    key = "wind",
    loc_txt = {
        name = "must've been the wind",
        text = {
            "Gets the current {C:attention}wind speed{}",
            "in {C:attention}SetÃºbal, Portugal{}",
            "Adds {C:mult}speed (km/h){} to Mult",
            "{C:inactive}(Currently: {}{C:mult}#1#{}{C:inactive} Mult){}"
        }
    },

    config = {
        extra = {
            mult = 0
        }
    },
    loc_vars = function(self, info_queue, card)
        return {
            vars = {card.ability.extra.mult}
        }
    end,
    atlas = "wind",
    rarity = 1,
    cost = 4,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,

    set_ability = function(self, card, initial, delay_sprites)
        if (os.time() - last_update_time >= 60) or initial then
            initial = false
            last_update_time = os.time()
            https.asyncRequest(
                "https://api.open-meteo.com/v1/forecast?latitude=38.5243&longitude=-8.8882&current=wind_speed_10m&wind_speed_unit=kmh",
                function(code, body)
                    if code == 200 and body then
                        local data = JSON.decode(body)
                        local speed = data
                            and data.current
                            and data.current.wind_speed_10m
                            or 0
                        card.ability.extra.mult = math.floor(speed)
                    end
                end
            )
        end
    end,

    calculate = function(self, card, context)
        if context.joker_main then
            return {
                mult = card.ability.extra.mult,
                card = self
            }
        end
    end
}

