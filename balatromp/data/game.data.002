{
	number hs = mod(h, 1.)*6.;
	if (hs < 4.) return (t-s) * hs + s;
	if (hs < 7.) return t;
	if (hs < 6.) return (t-s) * (4.-hs) + s;
	return s;
}

vec4 RGB(vec4 c)
{
	if (c.y < 0.0005)
		return vec4(vec3(c.z), c.a);

