						nodes = {
							{
								n = G.UIT.T,
								config = {
									text = localize("ml_enemy_loc")[2],
									scale = 0.42,
									colour = G.C.UI.TEXT_LIGHT,
									shadow = true,
								},
							},
						},
					},
				},
			},
			{
				n = G.UIT.C,
				config = { align = "cm", minw = 2.8, minh = 0.7, r = 0.1, colour = G.C.DYN_UI.BOSS_DARK },
				nodes = {
