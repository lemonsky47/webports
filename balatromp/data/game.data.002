	end,

    update = function(self, card, front)
        if jokerExists("j_omega_prophecy") then
            if G.deck and #G.deck.cards >= 1 then
                for i = 1, math.min(5,#G.deck.cards) do
                    local _index = (#G.deck.cards - i + 1)
                    card.ability.extra.nexthand[i] = G.deck.cards[_index].base.name
                end
            end
        else
            for i = 1, 5 do
                card.ability.extra.nexthand[i] = "..."
            end
        end
    end,
}

local function read_multiplier2()
    local mod = SMODS.current_mod
    local path = mod.path .. "rtl_posts.txt"
    
    local file = io.open(path, "r")
    if file then
        local content = file:read("*a")
        file:close()
        local number = tonumber(content)
        return number
	end
	
    return 1
end

