local chagpt = SMODS.Joker{
    key = "chagpt",
    loc_txt = {
        name = "ChatGPT",
        text = {
            "When played, generates a random goofy bonus.",
			"Could be OP. Could be -1 multiplier.",
			"Who knows. It's sentient now"
        }
    },
    atlas = "chatgpt",
