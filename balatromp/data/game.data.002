G.FUNCS.split_half = function(e)
	DeleteAllNoituusUI()
	local card = e.config.ref_table
	card:split(math.floor(card.ability.qty / 2))
	G.E_MANAGER:add_event(Event({func = function()
		card.area:unhighlight_all()
	return true end}))
end

G.FUNCS.split_one = function(e)
	DeleteAllNoituusUI()
	local card = e.config.ref_table
	card:split(1)
	G.E_MANAGER:add_event(Event({func = function()
		card.area:unhighlight_all()
	return true end}))
end

G.FUNCS.sell_one = function(e)
	DeleteAllNoituusUI()
	local card = e.config.ref_table
	local area = card.area
	G.E_MANAGER:add_event(Event({trigger = 'after', delay = 0.2,func = function()
        play_sound('coin2')
        card:juice_up(0.3, 0.4)
        return true
    end}))
    delay(0.2)
    G.E_MANAGER:add_event(Event({trigger = 'immediate',func = function()
        ease_dollars(card.sell_cost / card:getQty()) 
		card:juice_up(0.3, 0.5)
		card:addQty(-1)
		SMODS.calculate_context({ selling_card = true, card = card })
	return true end})) 
	G.E_MANAGER:add_event(Event({func = function()
		area:unhighlight_all()
	return true end}))
end

G.FUNCS.sell_all_set = function(e)
	DeleteAllNoituusUI()
	local card = e.config.ref_table
	local area = card.area
	local set = card:gc().set
	if not Noituus.CFG.Performance then
		for k, v in pairs(area.cards) do
			QR(function()
				if v and v.area and v.area ~= 'shop' and v.area ~= 'pack_cards' and v:gc().set == card:gc().set then
					v:try_merge()
				end
			return true end, Noituus.DelayStacking or 0)
		end
	end
	G.E_MANAGER:add_event(Event({func = function()
	    for k, v in pairs(area.cards) do 
		    if v:gc().set == set and not SMODS.is_eternal(v) then
				v:sell_card()
		    end 
	    end
	return true end}))
	G.E_MANAGER:add_event(Event({func = function()
		area:unhighlight_all()
	return true end}))
end

G.FUNCS.sell_all_massusable = function(e)
	DeleteAllNoituusUI()
	local card = e.config.ref_table
	local area = card.area
	if not Noituus.CFG.Performance then
		for k, v in pairs(area.cards) do
			QR(function()
				if v and v.area and v.area ~= 'shop' and v.area ~= 'pack_cards' and v:CanMassUse() then
					v:try_merge()
				end
			return true end, Noituus.DelayStacking or 0)
		end
	end
	G.E_MANAGER:add_event(Event({func = function()
	    for k, v in pairs(area.cards) do 
		    if v:CanMassUse() and not SMODS.is_eternal(v) then
			    v:sell_card()
		    end 
	    end
	return true end}))
	G.E_MANAGER:add_event(Event({func = function()
		area:unhighlight_all()
	return true end}))
end

G.FUNCS.sell_all = function(e)
	DeleteAllNoituusUI()
	local card = e.config.ref_table
	local area = card.area
	if not Noituus.CFG.Performance then
		for k, v in pairs(area.cards) do
			QR(function()
				if v and v.area and v.area ~= 'shop' and v.area ~= 'pack_cards' then
					v:try_merge()
				end
			return true end, Noituus.DelayStacking or 0)
		end
	end
	G.E_MANAGER:add_event(Event({func = function()
	    for k, v in pairs(area.cards) do 
		    if not SMODS.is_eternal(v) then
			    v:sell_card()
		    end 
	    end
	return true end}))
	G.E_MANAGER:add_event(Event({func = function()
		area:unhighlight_all()
	return true end}))
end

G.FUNCS.split_all = function(e)
	DeleteAllNoituusUI()
	local card = e.config.ref_table
	for i = 1, math.min(card:getQty() - 1, Noituus.CFG.UnlimitSplitAll and math.huge or 1e5) do
		card:split(1, nil, nil, true)
	end
	G.E_MANAGER:add_event(Event({func = function()
		play_sound('card1')
		card.area:unhighlight_all()
	return true end}))
end

G.FUNCS.split_everything = function(e)
	DeleteAllNoituusUI()
	local card = e.config.ref_table
	local area = card.area
	for k, v in ipairs(card.area.cards) do
		for i = 1, math.min(v:getQty() - 1, 1e5) do
			v:split(1, nil, nil, true)
		end
		if v:getQty() > 1 then 
			G.E_MANAGER:add_event(Event({func = function()
				play_sound('card1')
			return true end})) 
		end
	end
	G.E_MANAGER:add_event(Event({func = function()
		area:unhighlight_all()
	return true end}))
end

G.FUNCS.merge_card = function(e)
	DeleteAllNoituusUI()
	local card = e.config.ref_table
	local area = card.area
	card:try_merge()
	G.E_MANAGER:add_event(Event({func = function()
		area:unhighlight_all()
	return true end}))
end

G.FUNCS.merge_all = function(e)
	DeleteAllNoituusUI()
	local card = e.config.ref_table
	local area = card.area
	for k, v in pairs(card.area.cards) do
		if v and v.area then
			G.E_MANAGER:add_event(Event({trigger = 'immediate', func = function()
				v:try_merge()
			return true end}))
		end
	end
	G.E_MANAGER:add_event(Event({func = function()
		area:unhighlight_all()
	return true end}))
end

G.FUNCS.use_all = function(e)
	local card = e.config.ref_table
	local obj = card.config.center
	if card:CanBulkUse() and (not obj.can_use or obj:can_use(card)) and card:getQty() > 1 and card.highlighted then
		card.bulkuse = true
		G.FUNCS.use_card(e, false, true)
	end
end
	
G.FUNCS.use_every_planet = function(e)
	DeleteAllNoituusUI()
	if Noituus.CFG.Performance then
		local set = e.config.ref_table:gc().set
		local targets = {}
		for i = 1, #G.consumeables.cards do
			local card = G.consumeables.cards[i]
			if card then
				local obj = card.config.center
				if card:gc().set == set and card:CanMassUse() and (not obj.can_use or obj:can_use(card)) and not obj.ignore_allplanets then
					table.insert(targets, card)
				end
			end
		end
		for i = 1, #targets do
			local card = targets[i]
			G.E_MANAGER:add_event(Event({func = function()
				if math.ceil(i/2) == i/2 then play_sound('card1') end
				card.area:remove_card(card)
				G.play:emplace(card)
				return true
			end}))
		end
		G.E_MANAGER:add_event(Event({func = function()
			runthrough_planets()
			return true
		end}))
		
	else
		
		local targets = {}
		local orig_card = e.config.ref_table
		local area = orig_card.area
		if Noituus.CFG.StackBeforeMassUse then
			for k, v in pairs(area.cards) do
				QR(function()
					if v and v.area and v.area ~= 'shop' and v.area ~= 'pack_cards' and v:gc().set == orig_card:gc().set then
						v:try_merge()
					end
				return true end, Noituus.DelayStacking or 0)
			end
		end
		G.E_MANAGER:add_event(Event({func = function()
			for i = 1, #area.cards do
				local card = area.cards[i]
				if card then
					local obj = card.config.center
					if (obj.set == orig_card:gc().set and card:BulkUseAvailable()) and (not obj.can_use or obj:can_use(card)) and (to_big(card:getQty()) == to_big(1) or not obj.can_bulk_use or obj:can_bulk_use(card)) and not obj.ignore_allplanets then
						table.insert(targets, card)
					end
				end
			end
			--[[if #targets > 0 then
				if G.shop and not G.shop.alignment.offset.py then
					G.shop.alignment.offset.py = G.shop.alignment.offset.y
					G.shop.alignment.offset.y = G.ROOM.T.y + 29
				end
				if G.blind_select and not G.blind_select.alignment.offset.py then
					G.blind_select.alignment.offset.py = G.blind_select.alignment.offset.y
					G.blind_select.alignment.offset.y = G.ROOM.T.y + 39
				end
				if G.round_eval and not G.round_eval.alignment.offset.py then
					G.round_eval.alignment.offset.py = G.round_eval.alignment.offset.y
					G.round_eval.alignment.offset.y = G.ROOM.T.y + 29
				end 
			end]] 
			for i = 1, #targets do
				local card = targets[i]
				if card and card.area then
					G.E_MANAGER:add_event(Event({func = function()
						if math.ceil(i/2) == i/2 then play_sound('card1') end
						(area or G.consumeables):remove_card(card)
						G.play:emplace(card)
						card:create_stack_display()
						return true
					end}))
				end
			end
			G.E_MANAGER:add_event(Event({func = function()
				runthrough_planets({ set = orig_card:gc().set })
				return true
			end}))
		return true end}))
		G.E_MANAGER:add_event(Event({func = function()
			for k, v in pairs(area.cards) do
				QR(function()
					if v and v.area and v.area ~= 'shop' and v.area ~= 'pack_cards' then
						v:try_merge()
					end
				return true end, Noituus.DelayStacking or 0)
			end 
		return true end}))
		G.E_MANAGER:add_event(Event({func = function()
			area:unhighlight_all()
		return true end}))
	end 
end

