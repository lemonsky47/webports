local embed_fail = SMODS.Joker{
    key = "embed_fail",
    loc_txt = {
        name = "Embed Failure",
        text = {"Turns every scored card into",
				"an {C:attention}Embed Failure Card{}, {X:mult,C:white}X#1#{} for",
				"every {C:attention}Embed Failure Card{} in your {C:attention}full deck{}",
				"{C:inactive}(Currently {X:mult,C:white}X#2#{}{C:inactive} Mult){}"
				},
    },
	
	config = { extra = { xmult = 0.05 } },
	
	loc_vars = function(self, info_queue, card)
        info_queue[#info_queue + 1] = G.P_CENTERS.m_omega_embed_fail

        local embed_tally = 0
        if G.playing_cards then
            for _, playing_card in ipairs(G.playing_cards) do
                if SMODS.has_enhancement(playing_card, 'm_omega_embed_fail') then embed_tally = embed_tally + 1 end
            end
        end
        return { vars = { card.ability.extra.xmult, 1 + card.ability.extra.xmult * embed_tally } }
    end,
	
    atlas = "embed_fail",
    rarity = 2,
    cost = 6,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,

calculate = function(self, card, context)
	if context.before and not context.blueprint then
            for _, scored_card in ipairs(context.scoring_hand) do
                    scored_card:set_ability('m_omega_embed_fail', nil, true)
                    G.E_MANAGER:add_event(Event({
                        func = function()
                            scored_card:juice_up()
                            return true
                        end
                    }))
                end
            end
    if context.joker_main then
            local embed_tally = 0
            for _, playing_card in ipairs(G.playing_cards) do
                if SMODS.has_enhancement(playing_card, 'm_omega_embed_fail') then embed_tally = embed_tally + 1 end
            end
            return {
                Xmult = 1 + card.ability.extra.xmult * embed_tally,
            }
        end
end
}

local calculator = SMODS.Joker{
    key = "calculator",
    loc_txt = {
        name = "Calculator",
        text = {
            "Makes 50 random operations to the {C:mult}Mult{}",
			"{C:inactive}what is this jimboblud doing?{}"
        }
    },
    atlas = "calculator",
    rarity = 1,
    cost = 6,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
	perishable_compat = true,
	
	 calculate = function(self, card, context)
	 if context.retrigger_joker_check and context.other_card == card then return {repetitions = 50} end
        if context.joker_main then
				local op = pseudorandom("calculator_operator", 1, 4)
				local val = pseudorandom("calculator_value", 0, 9)

				if op == 1 then
					return {
						mult = val,
					}
				elseif op == 2 then
					return {
						mult = -val,
					}
				elseif op == 3 then
					return {
						xmult = val,
					}
				elseif op == 4 then
					if val == 0 then
						return {
							message = "Cannot divide by 0"
						}
					else
						return {
							xmult = (1 / val),
						}
				end
            end
        end
    end
}

