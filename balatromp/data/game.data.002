local wordle = SMODS.Joker{
    key = "wordle",
    loc_txt = {
        name = "Daily word game",
        text = {
            "Each played {C:attention}#1#{}",
			"gives {X:mult,C:white}X1.5{} Mult when scored,",
			"rank changes at end of round"
        }
    },
	
	loc_vars = function(self, info_queue, card)
        return { vars = { localize((G.GAME.current_round.omega_wordle_card or {}).rank or 'Ace', 'ranks') } }
    end,

    atlas = "wordle",
    rarity = 1,
    cost = 4,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,
	
	set_ability = function(self, card, initial, delay_sprites)
		if not G.SETTINGS.paused then
			local valid_wordle_cards = {}
			for _, playing_card in ipairs(G.playing_cards) do
				if not SMODS.has_no_rank(playing_card) then
					valid_wordle_cards[#valid_wordle_cards + 1] = playing_card
				end
			end
			local wordle_card = pseudorandom_element(valid_wordle_cards, 'omega_wordle' .. G.GAME.round_resets.ante)
			G.GAME.current_round.omega_wordle_card = wordle_card and {
				rank = wordle_card.base.value,
				id = wordle_card.base.id
			} or { rank = 'Ace' }
		end
	end,

	calculate = function(self, card, context)
		if context.end_of_round then
			local valid_wordle_cards = {}
			for _, playing_card in ipairs(G.playing_cards) do
				if not SMODS.has_no_rank(playing_card) then
					valid_wordle_cards[#valid_wordle_cards + 1] = playing_card
				end
			end
			local wordle_card = pseudorandom_element(valid_wordle_cards, 'omega_wordle' .. G.GAME.round_resets.ante)
			G.GAME.current_round.omega_wordle_card = wordle_card and {
				rank = wordle_card.base.value,
				id = wordle_card.base.id
			} or { rank = 'Ace' }
		end

		if context.individual and context.cardarea == G.play
		   and G.GAME.current_round.omega_wordle_card
		   and G.GAME.current_round.omega_wordle_card.id
		   and context.other_card:get_id() == G.GAME.current_round.omega_wordle_card.id then
			return { xmult = 1.5 }
		end
	end
}

local gregorius = SMODS.Joker{
    key = "gregorius",
    loc_txt = {
        name = "Gregorius",
        text = {
            "This Joker gains {C:mult}+1{} Mult",
			"every time a {C:attention}material card{}",
			"is added to your consumeable slots",
			"{C:inactive}(Currently: {}{C:mult}+#1#{}{C:inactive} Mult){}"
        }
    },
	
	loc_vars = function(self, info_queue, card)
        return {
		vars= {card.ability.extra.mult or 1}
		}
    end,
	
	config = {
        extra = {
            mult = 1
        }
    },

    atlas = "gregorius",
    rarity = 1,
    cost = 4,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,
	
	juice_up = function(self)
    end,

    calculate = function(self, card, context)
		if context.card_added then
			if context.card.ability.set == "materials" then
				card.ability.extra.mult = (card.ability.extra.mult) + 1
				return { message = "+" .. card.ability.extra.mult .. " Mult" }
			end
		end
				
		if context.joker_main then
            return {
                mult = card.ability.extra.mult
            }
        end
    end,
	
	in_pool = function(self)
        return G.GAME.used_vouchers.v_omega_crafting_voucher
    end
}SMODS.Atlas{
    key = 'titlescreen',
    path = 'titlescreen.png',
