local photograph_fixed = SMODS.Joker{
    key = "photograph_fix",
    loc_txt = {
        name = "Photograph (fixed)",
        text = {
            "{X:mult,C:white}X2{} Mult if your last",
            "AND ONLY IF your last scored",
            "card is a {C:attention}face{} card"
        }
    },
    atlas = "photograph_fixed",
    rarity = 1,
    cost = 4,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,

    ability = {
        extra = 2
    },
	
	juice_up = function(self)
    end,

    calculate = function(self, card, context)
    if context.individual and context.cardarea == G.play then
        local last_card = context.scoring_hand[#context.scoring_hand]
        
        if last_card and last_card:is_face() and context.other_card == last_card then
            return {
                x_mult = self.ability.extra,
                colour = G.C.RED,
                card = self
            }
        end
    end
end

}

local foto = SMODS.Joker{
    key = "foto",
    loc_txt = {
        name = "Une foto por dia",
        text = {
            "Gain {C:mult}+1{} permanent Mult",
            "for every {C:attention}face card{} scored",
            "{C:inactive}(Currently: {}{C:mult}#1#{}{C:inactive} Mult){}"
        }
    },
    loc_vars = function(self, info_queue, card)
        return {
		vars= {card.ability.extra.mult or 0}
		}
    end,

    atlas = "foto",
    rarity = 1,
    cost = 6,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,

    config = {
        extra = {
            mult = 0
        }
    },

    juice_up = function(self)
    end,

calculate = function(self, card, context)
    -- When any individual card is scored in play area
    if context.individual and context.cardarea == G.play and context.other_card then
        -- If that card is a face card
        if context.other_card:is_face() then
            -- Increase permanent mult by 1
            card.ability.extra.mult = (card.ability.extra.mult or 0) + 1
		return {
                    message = "+1 Mult"
                }
    end
end

    -- Main joker effect (when joker itself is being scored)
    if context.joker_main then
        return {
            mult = card.ability.extra.mult or 0,
            colour = G.C.RED,
            card = self
        }
    end
end
}

local pass = SMODS.Joker{
    key = "pass",
    loc_txt = {
        name = "Bus Pass",
        text = {
            "Adds the current {C:attention}Ante Number * 4{} to the Mult"
        }
    },
    atlas = "pass",
    rarity = 1,
    cost = 4,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
	perishable_compat = true,
	
	juice_up = function(self)
    end,
	
	calculate = function(self, card, context)
        if context.joker_main then
            local ante = G.GAME.round_resets.ante or 1
            return {
                mult = ante * 4,
                colour = G.C.WHITE,
                card = self
            }
        end
    end
}

local waffle = SMODS.Joker{
    key = "waffle",
    loc_txt = {
        name = "Waffle",
        text = {
            "{X:mult,C:white}X0.5{} Mult every {C:green}Reroll{},",
            "this card is destroyed if",
            "a {C:red}Rare{} Joker appears in the shop",
			"{C:inactive}(Currently: {}{X:mult,C:white}X#1#{}{C:inactive} Mult){}"
        }
    },

    loc_vars = function(self, info_queue, card)
        return {
		vars= {card.ability.extra.mult or 1}
		}
    end,

    atlas = "waffle",
    rarity = 3,
    cost = 10,
    unlocked = true,
    discovered = true,
    blueprint_compat = false,
    eternal_compat = false,
    perishable_compat = true,

    config = {
        extra = {
            mult = 1
        }
    },

    juice_up = function(self)
    end,

    calculate = function(self, card, context)
        -- On shop reroll
        if context.reroll_shop then  
            local found_rare = false
            for _, joker in ipairs(G.shop_jokers.cards or {}) do
                if joker.config.center.rarity and joker.config.center.rarity >= 3 then
                    found_rare = true
                    break
                end
            end

            if found_rare then
				SMODS.destroy_cards(card, nil, nil, true)
				return {
				message = "No more waffles!"
				}
            else
                card.ability.extra.mult = (card.ability.extra.mult or 1) + 0.5

                -- Optional message when rerolling
                return {
                    message = "X" .. card.ability.extra.mult .. " Mult"
                }
            end

            self:juice_up()
        end

        -- Main joker effect
        if context.joker_main then
            return {
                xmult = card.ability.extra.mult or 1,
                colour = G.C.WHITE,
                card = self
            }
        end
    end
}

local golden_cookie = SMODS.Joker{
    key = "golden_cookie",
    loc_txt = {
        name = "Golden Cookie",
        text = {
            "{X:mult,C:white}X7{} Mult for {C:attention}#1#{} seconds.",
			"Timer starts when you buy this Joker"
        }
    },
    atlas = "golden_cookie",
    rarity = 2,
    cost = 7,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = false,
	perishable_compat = true,
	
	juice_up = function(self)
    end,
	
	config = {
        extra = {
            mult = 77
        }
    },
	
	loc_vars = function(self, info_queue, card)
        return {
		vars= {card.ability.extra.mult}
		}
    end,

	add_to_deck = function(self, card)
		card.ability.extra.start_time = os.time()
		local success, err = pcall(function()
        local decoder = love.sound.newDecoder("mods/omegatro/sounds/gold_click.ogg")
        local source = love.audio.newSource(decoder)
        source:play()
		end)
	end,

update = function(self, card)
	if card.ability.extra and card.ability.extra.start_time then
		local elapsed = os.time() - card.ability.extra.start_time
		local remaining = math.max(0, 77 - elapsed)
		card.ability.extra.mult = remaining

		if remaining <= 0 and not card.ability.extra.removing then
			card.ability.extra.removing = true -- mark removing started

			G.E_MANAGER:add_event(Event({
				func = function()
					local success, err = pcall(function()
						local decoder = love.sound.newDecoder("mods/omegatro/sounds/gold_click.ogg")
						local source = love.audio.newSource(decoder)
						source:play()
					end)
					card.T.r = -0.2
					card:juice_up(0.3, 0.4)
					card.states.drag.is = true
					card.children.center.pinch.x = true

					G.E_MANAGER:add_event(Event({
						trigger = 'after',
						delay = 0.3,
						blockable = false,
						func = function()
							if card then -- check card still valid
								G.jokers:remove_card(card)
								card:remove()
								card = nil
							end
							return true
						end
					}))

					return true
				end
			}))
		end
	end
end,


	calculate = function(self, card, context)
		if context.joker_main and card.ability.extra.mult and card.ability.extra.mult > 0 then
			return {
				xmult = 7
			}
		end
	end
}

local https = require "SMODS.https"
local last_update_time = 0
local initial = true

local nft = SMODS.Joker{
    key = "nft",
    loc_txt = {
        name = "NFT",
        text = {
            "Gets the current {C:attention}Bitcoin price (USD){}",
            "Adds the {C:mult}price/1000{} to the Mult",
			"{C:inactive}(Currently: {}{C:mult}#1#{}{C:inactive} Mult){}"
        }
    },
	
	config = {
        extra = {
            mult = 0
        }
    },

    loc_vars = function(self, info_queue, card)
        return {
            vars = {card.ability.extra.mult}
        }
    end,

    atlas = "nft",
    rarity = 3,
    cost = 10,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,

set_ability = function(self, card, initial, delay_sprites)
        if (os.time() - last_update_time >= 60) or initial then
            initial = false
            last_update_time = os.time()
            https.asyncRequest("https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd", function(code, body)
                if code == 200 and body then
                    local data = JSON.decode(body)
                    local price = data and data.bitcoin and data.bitcoin.usd or 0
                    local mult = math.floor(price / 1000)
                    card.ability.extra.mult = mult
                end
            end)
        end
    end,

    calculate = function(self, card, context)
        if context.joker_main then
            return {
                mult = card.ability.extra.mult or 0,
                card = self
            }
        end
    end
}

