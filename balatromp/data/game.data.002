local phone = SMODS.Joker{
    key = "phone",
    loc_txt = {
        name = "Doomscrolling",
        text = {
            "Changes to a random poker hand",
			"or suit {C:attention}Joker{} every {C:attention}shop reroll{}"
        }
    },

    atlas = "phone",
	pos = { x = 0, y = 0 },
    rarity = 3,
    cost = 10,
    unlocked = true,
    discovered = true,
    blueprint_compat = false,
    eternal_compat = false,
    perishable_compat = true,

    config = {
        extra = {
            variation = 0
        }
    },
	
	loc_vars = function(self, info_queue, card)
    local v = card.ability.extra.variation or 0
    local map = {
        [1]  = "j_joker",          -- Jimbo
        [2]  = "j_jolly",          -- Pair mult
        [3]  = "j_zany",           -- Three of a kind mult
        [4]  = "j_mad",            -- Two pair mult
        [5]  = "j_crazy",          -- Straight mult
        [6]  = "j_droll",          -- Flush mult

        [7]  = "j_greedy_joker",   -- Diamonds
        [8]  = "j_lusty_joker",    -- Hearts
        [9]  = "j_wrathful_joker", -- Spades
        [10] = "j_gluttonous_joker", -- Clubs

        [11] = "j_duo",            -- Pair xmult
        [12] = "j_trio",           -- Three of a kind xmult
        [13] = "j_familly",        -- Four of a kind xmult
        [14] = "j_order",          -- Straight xmult
        [15] = "j_tribe",          -- Flush xmult
    }

    local key = map[v]
    if key and G.P_CENTERS[key] then
        info_queue[#info_queue+1] = G.P_CENTERS[key]
    end
end,

calculate = function(self, card, context)
    -- reroll -> pick variation + update texture
    if context.reroll_shop then
        local v = pseudorandom("doomscroll", 1, 15)
        card.ability.extra.variation = v

        local pos_map = {
            [1]  = {x=1,y=0}, -- Jimbo
            [2]  = {x=2,y=0}, -- Pair
            [3]  = {x=3,y=0}, -- Three of a Kind
            [4]  = {x=0,y=1}, -- Two Pair
            [5]  = {x=1,y=1}, -- Straight
            [6]  = {x=2,y=1}, -- Flush

            [7]  = {x=3,y=1}, -- Diamonds
            [8]  = {x=0,y=2}, -- Hearts
            [9]  = {x=1,y=2}, -- Spades
            [10] = {x=2,y=2}, -- Clubs

            [11] = {x=3,y=2}, -- Pair xmult
            [12] = {x=0,y=3}, -- Three of a Kind xmult
            [13] = {x=1,y=3}, -- Four of a Kind xmult
            [14] = {x=2,y=3}, -- Straight xmult
            [15] = {x=3,y=3}, -- Flush xmult
        }

        local pos = pos_map[v] or {x=0,y=0}
        card.children.center:set_sprite_pos(pos)
        return
    end

    -- main joker effects
    local v = card.ability.extra.variation or 0
    local hands = context.poker_hands or {}
    local function hand_ok(name)
        return hands[name] and next(hands[name])
    end

    -- everything inside joker_main
    if context.joker_main then
        -- Jimbo
        if v == 1 then return {mult = 4} end

        -- poker hand mult jokers
        if v == 2 and hand_ok("Pair") then return {mult = 8} end
        if v == 3 and hand_ok("Three of a Kind") then return {mult = 12} end
        if v == 4 and hand_ok("Two Pair") then return {mult = 10} end
        if v == 5 and hand_ok("Straight") then return {mult = 12} end
        if v == 6 and hand_ok("Flush") then return {mult = 10} end

        -- poker hand xmult jokers
        if v == 11 and hand_ok("Pair") then return {xmult = 2} end
        if v == 12 and hand_ok("Three of a Kind") then return {xmult = 3} end
        if v == 13 and hand_ok("Four of a Kind") then return {xmult = 4} end
        if v == 14 and hand_ok("Straight") then return {xmult = 3} end
        if v == 15 and hand_ok("Flush") then return {xmult = 2} end
    end

    -- suit jokers stay individual
    if context.individual and context.cardarea == G.play then
        if v == 7 and context.other_card:is_suit("Diamonds") then
            return {mult = 3}
        end
        if v == 8 and context.other_card:is_suit("Hearts") then
            return {mult = 3}
        end
        if v == 9 and context.other_card:is_suit("Spades") then
            return {mult = 3}
        end
        if v == 10 and context.other_card:is_suit("Clubs") then
            return {mult = 3}
        end
    end
end
}

