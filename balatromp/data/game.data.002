	cost = 20,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,
	
	config = { extra = { chips = 0, type = 'Full House' } },
	
	loc_vars = function(self, info_queue, card)
