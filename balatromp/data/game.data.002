							blockable = false,
							func = function()
								G.jokers:remove_card(card)
								card:remove()
								card = nil
								return true
							end,
						}))
						return true
					end,
				}))
				return {
					message = "Too cold!",
					colour = G.C.FILTER,
				}
			else
				return {
					message = "Cooled!",
					colour = G.C.FILTER,
				}
			end
		end
	end,

	mp_credits = { code = { "CampfireCollective" }, art = { "dottykitty" } },
	mp_include = function(self)
