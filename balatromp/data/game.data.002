local job = SMODS.Joker{
    key = "job",
    loc_txt = {
        name = "Job Application",
        text = {"Disables the leftmost {C:attention}Joker{}",
				"At the end of {C:attention}every hand played{C:attention},",
				"gain {C:money}Money{} equal to that Jokerâ€™s",
				"{C:attention}sell value{}"},
    },
    atlas = "job",
    rarity = 2,
    cost = 5,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,

    calculate = function(self, card, context)
    local leftmost = G.jokers.cards[1]
    if leftmost and leftmost ~= card then
        if context.before then
            -- Disable leftmost Joker before hand
            leftmost:set_debuff(true)
            card.disabled_target = leftmost
        elseif context.after then
            if card.disabled_target then
                -- Recalculate debuff after hand to restore state
                SMODS.recalc_debuff(card.disabled_target)
                card.disabled_target = nil
            end
        end
    end

    if context.joker_main and card.disabled_target then
        local sell_value = card.disabled_target.sell_cost or 0
        ease_dollars(sell_value)
		return {
                message = sell_value .. "$",
                colour = G.C.MONEY
            }
    end
end
}

