	return hlref(self,is_highlighted)
end

function DeleteAllNoituusUI()
	if not Noituus.CFG.Performance then
		for k, v in ipairs(G.consumeables.highlighted) do
		    v:DeleteNoituusUI()
		end
	end
end

function Card:DeleteNoituusUI()
	if self.children.everyplanetbutton then self.children.everyplanetbutton:remove();self.children.everyplanetbutton = nil end
	if self.children.everyconsumablebutton then self.children.everyconsumablebutton:remove();self.children.everyconsumablebutton = nil end
	if self.children.splithalfbutton then self.children.splithalfbutton:remove();self.children.splithalfbutton = nil end
	if self.children.splitonebutton then self.children.splitonebutton:remove();self.children.splitonebutton = nil end
	if self.children.splitallbutton then self.children.splitallbutton:remove();self.children.splitallbutton = nil end
	if self.children.spliteverythingbutton then self.children.spliteverythingbutton:remove();self.children.spliteverythingbutton = nil end
	if self.children.mergebutton then self.children.mergebutton:remove();self.children.mergebutton = nil end
	if self.children.useallbutton then self.children.useallbutton:remove();self.children.useallbutton = nil end
	if self.children.useallnaivebutton then self.children.useallnaivebutton:remove();self.children.useallnaivebutton = nil end
	if self.children.sellonebutton then self.children.sellonebutton:remove();self.children.sellonebutton = nil end
	if self.children.sellallsetbutton then self.children.sellallsetbutton:remove();self.children.sellallsetbutton = nil end
	if self.children.sellallmassusablebutton then self.children.sellallmassusablebutton:remove();self.children.sellallmassusablebutton = nil end
	if self.children.sellallbutton then self.children.sellallbutton:remove();self.children.sellallbutton = nil end
endif not (SMODS.Mods['jen'] or {}).can_load then
	SMODS.Joker:take_ownership('perkeo', {
		loc_vars = function(self, info_queue, center)
			info_queue[#info_queue+1] = {key = 'e_negative_consumable', set = 'Edition', config = {extra = 1}}
			return {vars = {center.ability.extra}}
		end,
		calculate = function(self, card, context)
			if context.ending_shop then
				if G.consumeables.cards[1] then
					G.E_MANAGER:add_event(Event({
						func = function() 
							local total, checked, center = 0, 0, nil
							for i = 1, #G.consumeables.cards do
								total = total + (G.consumeables.cards[i]:getQty())
							end
							local poll = pseudorandom(pseudoseed('perkeo'))*total
							for i = 1, #G.consumeables.cards do
								checked = checked + (G.consumeables.cards[i]:getQty())
								if checked >= poll then
									center = G.consumeables.cards[i]
									break
								end
							end
							local card = copy_card(center, nil)
							card.ability.qty = 1
							card.ability.infinite = nil
							card:set_edition({negative = true}, true)
							card:add_to_deck()
							G.consumeables:emplace(card) 
							return true
						end}))
					card_eval_status_text(context.blueprint_card or card, 'extra', nil, nil, nil, {message = localize('k_duplicated_ex')})
					return {calculated = true}
				end
			end
		end
	}, true)
end

SMODS.Joker:take_ownership('j_constellation', {
	calculate = function(self, card, context)
        if (context.using_consumeable and context.consumeable.ability.set == 'Planet') and not context.blueprint then
            card.ability.x_mult = card.ability.x_mult + (card.ability.extra * context.consumeable:getQty())
            return {
                message = localize { type = 'variable', key = 'a_xmult', vars = { card.ability.extra * context.consumeable:getQty() } }
            }
        end
		if context.forcetrigger then
			card.ability.x_mult = card.ability.x_mult + card.ability.extra
            return {
                message = localize { type = 'variable', key = 'a_xmult', vars = { card.ability.extra } }
            }
		end
    end,
    loc_vars = function(self, info_queue, card)
        return {
            vars = {
                card.ability.extra,
                card.ability.x_mult
            }
        }
    end
}, true)

-- Observatory is a patch because take_ownership just didn't work{
    "id": "noituus",
    "name": "Noituus",
    "author": ["jenwalter666", "MathIsFun_", "alex343xd"],
    "description": "Incantation fork with extensive compatibility with alternatives and configuration.",
    "prefix": "nts",
    "main_file": "Noituus.lua",
    "badge_colour": "00feff",
    "priority": -999,
    "version": "1.1.5", 
	"dependencies": [
		"Steamodded"
	],
	"provides": [
		"incantation", 
		"Overflow"
	]
}
-- NOITUUS CORE
-- Load modules

SMODS.Atlas {
	key = 'modicon', 
	path = 'icon.png',
	px = 34, 
	py = 34,
}

for k, v in ipairs({
	'jenlib.lua', 
	'init.lua', 
	'config.lua', 
	'main.lua',
	'ui.lua',
	'api.lua',
	'vanilla_compat.lua',
	'overflow_compat.lua',
	'incantation_compat.lua',
	'base_compat.lua',
}) do
	assert(SMODS.load_file('modules/'..v))()
	print('NOITUUS: MODULE '..v..' loaded!')
