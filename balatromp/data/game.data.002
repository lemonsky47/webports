}M¼îóÛsbn¾ßW¢dSÜrÊä…¹Äxu1ëê‘ñ]‰Aíóüý©o‘Nªû‚öÁÜ°}u ê@š-§ÈÎnI¸h1"Ä\_GÄ×s%µÏã}Îï}Aû`n¾ßW¢DñOÆ($Æ‚rb®{ƒ ½qÓ•Ô>÷q_¶÷í“û¯!÷\ ªo»³Ÿ%FÙb®­%bð?þt%µÏã}Ü*x’d{¿ß>¹ÿ9ä^duC;Qýo¤b®YKPÝºíJjŸÇûá§g“P~ÏsÕGõ#;öÖøDñk␀£ô%bÖ¬!¨Ço»ƒÚçñ~xÖ3$ž&Áó\õQý·_4ŒâWŠà·ÌÕ5Ä(-%á™³HhjX‚ç8‡÷ü–×œ|¾¯Dˆg0Š'.ýzÃþ^PÙöáóûB4˜¶í–›ÞÏÇ|á%å·×œY¡ñ¨_^,$Á´wXNk¾ï/¨lûÜu:ŸÅ/†²;-?J¶'îŠß>^sæ¼t ºt¥ëo[œÉ&k7ˆ␀␀␀␀IEND®B`‚return {
    NegativesOnly = false,
    StackAnything = false,
	DisplayAlignment = 2, 
	ContinuousMassUse = false, 
	StackBeforeMassUse = true,
	AutoStack = true,
    UI = {
		SPLITONE = true, 
		SPLITHALF = true, 
		SPLITALL = false, 
		MASSUSE = true, 
		MERGE = true, 
		SPLITEVERYTHING = false,
		BULKUSE = true,
		UNSAFEBULKUSE = false,
		SELLONE = true,
		SELLALLSET = false,
		SELLALLMASSUSABLE = false, 
		SELLALL = false,
	}, 
	UnlimitStack = false, 
	UnlimitSplitAll = false,
	UnsafeBulkUseEverywhere = false, 
	Performance = false,
	VerboseCalculate = false,
	AlwaysBulkUse = true,
	StackCondition = {
		Edition = true, 
		SellValue = false,
	}
}
return {
    misc = {
        dictionary = {
            incant_negatives_only = "Stack negatives only",
            incant_stack_anything = "Allow stack & divide on any consumable",
			incant_unsafe_mode = 'Unsafe mode'
        }
    }
}[manifest]
version = "1.0.0"
dump_lua = true
priority = 0

# Acceleration in bulk use
[[patches]]
[patches.pattern]
target = "game.lua"
pattern = "if (G.STATE == G.STATES.HAND_PLAYED) or (G.STATE == G.STATES.NEW_ROUND) then"
position = "at"
payload = "if (G.STATE == G.STATES.HAND_PLAYED) or (G.STATE == G.STATES.NEW_ROUND) or Noituus and Noituus.accelerate then"
match_indent = true

# Decrease Incantation's priority for compatibility
[[patches]]
[patches.pattern]
target = '''=[SMODS incantation "Incantation.json"'''
pattern = '''"priority": ,'''
position = "at"
payload = '''"priority": -9999,'''
match_indent = true

# Slew of patches for set_consumeable_usage
[[patches]]
[patches.pattern]
target = "functions/misc_functions.lua"
pattern = '''G.PROFILES[G.SETTINGS.profile].consumeable_usage[card.config.center_key].count = G.PROFILES[G.SETTINGS.profile].consumeable_usage[card.config.center_key].count + 1'''
position = "at"
payload = '''G.PROFILES[G.SETTINGS.profile].consumeable_usage[card.config.center_key].count = G.PROFILES[G.SETTINGS.profile].consumeable_usage[card.config.center_key].count + (card.consumable_usage_override or card:getQty())'''
match_indent = true

[[patches]]
[patches.pattern]
target = "functions/misc_functions.lua"
pattern = '''G.PROFILES[G.SETTINGS.profile].consumeable_usage[card.config.center_key] = {count = 1, order = card.config.center.order}'''
position = "at"
payload = '''G.PROFILES[G.SETTINGS.profile].consumeable_usage[card.config.center_key] = {count = (card.consumable_usage_override or card:getQty()), order = card.config.center.order}'''
match_indent = true

[[patches]]
[patches.pattern]
target = "functions/misc_functions.lua"
pattern = '''G.GAME.consumeable_usage[card.config.center_key].count = G.GAME.consumeable_usage[card.config.center_key].count + 1'''
position = "at"
payload = '''G.GAME.consumeable_usage[card.config.center_key].count = G.GAME.consumeable_usage[card.config.center_key].count + (card.consumable_usage_override or card:getQty())'''
match_indent = true

[[patches]]
[patches.pattern]
target = "functions/misc_functions.lua"
pattern = '''G.GAME.consumeable_usage[card.config.center_key] = {count = 1, order = card.config.center.order, set = card.ability.set}'''
position = "at"
payload = '''G.GAME.consumeable_usage[card.config.center_key] = {count = (card.consumable_usage_override or card:getQty()), order = card.config.center.order, set = card.ability.set}'''
match_indent = true

[[patches]]
[patches.pattern]
target = "functions/misc_functions.lua"
pattern = '''G.GAME.consumeable_usage_total.tarot = G.GAME.consumeable_usage_total.tarot + 1  
        G.GAME.consumeable_usage_total.tarot_planet = G.GAME.consumeable_usage_total.tarot_planet + 1'''
position = "at"
payload = '''G.GAME.consumeable_usage_total.tarot = G.GAME.consumeable_usage_total.tarot + (card.consumable_usage_override or card:getQty())
        G.GAME.consumeable_usage_total.tarot_planet = G.GAME.consumeable_usage_total.tarot_planet + (card.consumable_usage_override or card:getQty())'''
match_indent = true

[[patches]]
[patches.pattern]
target = "functions/misc_functions.lua"
pattern = '''G.GAME.consumeable_usage_total.planet = G.GAME.consumeable_usage_total.planet + 1
        G.GAME.consumeable_usage_total.tarot_planet = G.GAME.consumeable_usage_total.tarot_planet + 1'''
position = "at"
payload = '''G.GAME.consumeable_usage_total.planet = G.GAME.consumeable_usage_total.planet + (card.consumable_usage_override or card:getQty())
        G.GAME.consumeable_usage_total.tarot_planet = G.GAME.consumeable_usage_total.tarot_planet + (card.consumable_usage_override or card:getQty())'''
match_indent = true

[[patches]]
[patches.pattern]
target = "functions/misc_functions.lua"
pattern = '''elseif card.config.center.set == 'Spectral' then  G.GAME.consumeable_usage_total.spectral = G.GAME.consumeable_usage_total.spectral + 1'''
position = "at"
payload = '''elseif card.config.center.set == 'Spectral' then  G.GAME.consumeable_usage_total.spectral = G.GAME.consumeable_usage_total.spectral + (card.consumable_usage_override or card:getQty())'''
match_indent = true

[[patches]]
[patches.pattern]
target = "functions/misc_functions.lua"
pattern = '''G.GAME.consumeable_usage_total.all = G.GAME.consumeable_usage_total.all + 1'''
position = "at"
payload = '''G.GAME.consumeable_usage_total.all = G.GAME.consumeable_usage_total.all + (card.consumable_usage_override or card:getQty())'''
match_indent = true

# Observatory
[[patches]]
[patches.pattern]
target = "card.lua"
pattern = "Xmult_mod = G.P_CENTERS.v_observatory.config.extra"
position = "at"
payload = "Xmult_mod = G.P_CENTERS.v_observatory.config.extra ^ self:getQty()"
match_indent = truelocal function tablecontains(haystack, needle)
	for k, v in pairs(haystack) do
		if v == needle then
			return true
		end
	end
	return false
end

function AllowStacking(set)
	if not tablecontains(Noituus.Stackable, set) then
		table.insert(Noituus.Stackable, set)
	end
end

function AllowStackingIndividual(key)
	if not tablecontains(Noituus.StackableIndividual, key) then
		table.insert(Noituus.StackableIndividual, key)
	end
end

function AllowDividing(set)
	AllowStacking(set)
	if not tablecontains(Noituus.Divisible, set) then
		table.insert(Noituus.Divisible, set)
	end
end

function AllowDividingIndividual(key)
	AllowStackingIndividual(key)
	if not tablecontains(Noituus.DivisibleIndividual, key) then
		table.insert(Noituus.DivisibleIndividual, key)
	end
end

function AllowBulkUse(set)
	AllowStacking(set)
	AllowDividing(set)
	if not tablecontains(Noituus.BulkUsable, set) then
		table.insert(Noituus.BulkUsable, set)
	end
end

function AllowBulkUseIndividual(key)
	AllowStackingIndividual(key)
	AllowDividingIndividual(key)
	if not tablecontains(Noituus.BulkUsableIndividual, key) then
		table.insert(Noituus.BulkUsableIndividual, key)
	end
end

function AllowMassUsing(set)
	AllowBulkUse(set)
	if not tablecontains(Noituus.MassUsable, set) then
		table.insert(Noituus.MassUsable, set)
	end
end

function AllowMassUsingIndividual(key)
	AllowBulkUseIndividual(key)
	if not tablecontains(Noituus.MassUsableIndividual, key) then
		table.insert(Noituus.MassUsableIndividual, key)
	end
end

-- Compat, NoituusAddons does NOT exist
if IncantationAddons then
	if #IncantationAddons.Stacking > 0 then
		for _, v in pairs(IncantationAddons.Stacking) do
			AllowStacking(v)
		end
	end
	if #IncantationAddons.StackingIndividual > 0 then
		for _, v in pairs(IncantationAddons.StackingIndividual) do
			AllowStackingIndividual(v)
		end
	end
	if #IncantationAddons.Dividing > 0 then
		for _, v in pairs(IncantationAddons.Dividing) do
			AllowDividing(v)
		end
	end
	if #IncantationAddons.DividingIndividual > 0 then
		for _, v in pairs(IncantationAddons.DividingIndividual) do
			AllowDividingIndividual(v)
		end
	end
	if #IncantationAddons.BulkUse > 0 then
		for _, v in pairs(IncantationAddons.BulkUse) do
			AllowBulkUse(v)
		end
	end
	if #IncantationAddons.BulkUseIndividual > 0 then
		for _, v in pairs(IncantationAddons.BulkUseIndividual) do
			AllowBulkUseIndividual(v)
		end
	end
	if #IncantationAddons.MassUse > 0 then
		for _, v in pairs(IncantationAddons.MassUse) do
			AllowMassUsing(v)
		end
	end
	if #IncantationAddons.MassUseIndividual > 0 then
		for _, v in pairs(IncantationAddons.MassUseIndividual) do
			AllowMassUsingIndividual(v)
		end
	end
end-- Compatibility with other popular mods

-- Cryptid
AllowBulkUse('Code')
AllowBulkUseIndividual('c_cry_white_hole')
AllowMassUsingIndividual('c_cry_oboe')
AllowMassUsingIndividual('c_cry_payload')

-- Entropy
AllowMassUsing('Rune')
AllowStacking('Pact')
AllowStacking('CBlind')
AllowStacking('Omen')
AllowStacking('Fraud')
AllowMassUsing('Star')
AllowStacking('Command')


SMODS.current_mod.config_tab = function()
    return {n = G.UIT.ROOT, config = {r = 0.1, align = "cm", padding = 0.1, colour = G.C.BLACK, minw = 8, minh = 4}, nodes = {
        {n = G.UIT.R, config = {align = "cl", padding = 0}, nodes = {
            {n = G.UIT.C, config = { align = "cl", padding = 0.05 }, nodes = {
                create_toggle{ col = true, label = "", scale = 0.85, w = 0, shadow = true, ref_table = Noituus.CFG, ref_value = "AutoStack" },
            }},
            {n = G.UIT.C, config = { align = "c", padding = 0 }, nodes = {
                { n = G.UIT.T, config = { text = "Stack Consumables automatically", scale = 0.35, colour = G.C.UI.TEXT_LIGHT }},
            }},
        }}, 
		{n = G.UIT.R, config = {align = "cl", padding = 0}, nodes = {
            {n = G.UIT.C, config = { align = "cl", padding = 0.05 }, nodes = {
                create_toggle{ col = true, label = "", scale = 0.85, w = 0, shadow = true, ref_table = Noituus.CFG, ref_value = "NegativesOnly" },
            }},
            {n = G.UIT.C, config = { align = "c", padding = 0 }, nodes = {
                { n = G.UIT.T, config = { text = "Only stack Negative consumables", scale = 0.35, colour = G.C.UI.TEXT_LIGHT }},
            }},
        }}, 
		{n = G.UIT.R, config = { align = "cm", padding = 0 }, nodes = {
			create_option_cycle({
				label = "Stack Indicator Position",
				scale = 0.7,
				w = 7,
				options = {"Center", "Top Center", "Bottom Center", "Top Right", "Top Left", "Bottom Right", "Bottom Left"},
				opt_callback = 'nts_upd_alignment',
				current_option = Noituus.CFG.DisplayAlignment,
			})
		}},
		{n = G.UIT.R, config = {align = "cl", padding = 0}, nodes = {
            {n = G.UIT.C, config = { align = "cl", padding = 0.05 }, nodes = {
                create_toggle{ col = true, label = "", scale = 0.85, w = 0, shadow = true, ref_table = Noituus.CFG.StackConditions, ref_value = "AlwaysBulkUse" },
            }},
            {n = G.UIT.C, config = { align = "c", padding = 0 }, nodes = {
                { n = G.UIT.T, config = { text = "Automatically Bulk Use consumables when pressing USE button, if possible", scale = 0.35, colour = G.C.UI.TEXT_LIGHT }},
            }},
        }}, 
		{n = G.UIT.R, config = {align = "cl", padding = 0}, nodes = {
            {n = G.UIT.C, config = { align = "cl", padding = 0.05 }, nodes = {
                create_toggle{ col = true, label = "", scale = 0.85, w = 0, shadow = true, ref_table = Noituus.CFG.StackConditions, ref_value = "Edition" },
            }},
            {n = G.UIT.C, config = { align = "c", padding = 0 }, nodes = {
                { n = G.UIT.T, config = { text = "Only stack consumables with identical Editions", scale = 0.35, colour = G.C.UI.TEXT_LIGHT }},
            }},
        }}, 
		{n = G.UIT.R, config = {align = "cl", padding = 0}, nodes = {
            {n = G.UIT.C, config = { align = "cl", padding = 0.05 }, nodes = {
                create_toggle{ col = true, label = "", scale = 0.85, w = 0, shadow = true, ref_table = Noituus.CFG.StackConditions, ref_value = "SellValue" },
            }},
            {n = G.UIT.C, config = { align = "c", padding = 0 }, nodes = {
                { n = G.UIT.T, config = { text = "Only stack consumables with identical sell value", scale = 0.35, colour = G.C.UI.TEXT_LIGHT }},
            }},
        }}, 
    }}
end

SMODS.current_mod.extra_tabs = function()
	return {
		{
			label = 'UI',
			tab_definition_function = function()
				return {n = G.UIT.ROOT, config = {align = 'cm',minw = 8,minh = 4,r = .1,padding = .1,colour = G.C.BLACK}, nodes = {
					{n=G.UIT.C, config={}, nodes={
						{n=G.UIT.R, config={align = "cm"}, nodes={
							{n = G.UIT.R, config = { align = "cm", padding = 0 }, nodes = {
								{n = G.UIT.C, config = { align = "c", padding = 0 }, nodes = {
									{ n = G.UIT.T, config = { text = 'BULK USE button', scale = 0.35, colour = G.C.UI.TEXT_LIGHT }},
								}},
								{n = G.UIT.C, config = { align = "cm", padding = 0.05 }, nodes = {
									create_toggle{ col = true, label = "", scale = 0.85, w = 0, shadow = true, ref_table = Noituus.CFG.UI, ref_value = "BULKUSE" },
								}},
							}},
							{n = G.UIT.R, config = { align = "cm", padding = 0 }, nodes = {
								{n = G.UIT.C, config = { align = "c", padding = 0 }, nodes = {
									{ n = G.UIT.T, config = { text = 'SPLIT ONE button', scale = 0.35, colour = G.C.UI.TEXT_LIGHT }},
								}},
								{n = G.UIT.C, config = { align = "cm", padding = 0.05 }, nodes = {
									create_toggle{ col = true, label = "", scale = 0.85, w = 0, shadow = true, ref_table = Noituus.CFG.UI, ref_value = "SPLITONE" },
								}},
