    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,

	loc_vars = function(self, info_queue, card)
    local omega_tally = 0
        if G.playing_cards then
            for _, playing_card in ipairs(G.playing_cards) do
                if playing_card:is_suit("omega_suit") then omega_tally = omega_tally + 1 end
            end
        end
        return { vars = { card.ability.extra.emult, 1 + card.ability.extra.emult * omega_tally } }
    end,
    calculate = function(self, card, context)
        if context.joker_main then
            local omega_tally = 0
            for _, playing_card in ipairs(G.playing_cards) do
                if playing_card:is_suit("omega_suit") then omega_tally = omega_tally + 1 end
            end
            return {
                emult = 1 + card.ability.extra.emult * omega_tally,
            }
        end
    end
