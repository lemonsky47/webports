local coloring_book = SMODS.Joker{
    key = "coloring_book",
    loc_txt = {
        name = "Coloring Book",
        text = {
            "{X:mult,C:white}X1{} Mult for each",
			"{C:attention}unique{} suit in {C:attention}played hand{}"
        }
    },
	
	config = { extra = { xmult = 0 } },

    atlas = "coloring_book",
    rarity = 2,
    cost = 6,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,

calculate = function(self, card, context)
    if context.joker_main then
        local suits_found = {
            Hearts = false,
            Diamonds = false,
            Spades = false,
            Clubs = false,
			Omegas = false
        }
        for i = 1, #context.scoring_hand do
            local c = context.scoring_hand[i]
            if c:is_suit('Hearts', true) then suits_found.Hearts = true end
            if c:is_suit('Diamonds', true) then suits_found.Diamonds = true end
            if c:is_suit('Spades', true) then suits_found.Spades = true end
            if c:is_suit('Clubs', true) then suits_found.Clubs = true end
			if c:is_suit('omega_suit', true) then suits_found.Omegas = true end
        end
        local unique_suits = 0
        for _, present in pairs(suits_found) do
            if present then unique_suits = unique_suits + 1 end
        end
        if unique_suits > 0 then
            return {
                xmult = card.ability.extra.xmult + unique_suits
            }
        end
    end
end
}

local goodbelisk = SMODS.Joker{
    key = "goodbelisk",
    loc_txt = {
        name = "Goodbelisk",
        text = {
            "This joker gains {X:chips,C:white}X0.2{} Chips",
			"per {C:attention}consecutive{} hand played",
			"playing your most played {C:attention}poker hand{}",
			"{C:inactive}(Currently {X:chips,C:white}X#1#{}{C:inactive} Chips){}"
        }
    },
	
	config = { extra = { Xchips = 1 } },
	
	loc_vars = function(self, info_queue, card)
        return {
		vars= {card.ability.extra.Xchips}
		}
    end,

    atlas = "goodbelisk",
    rarity = 3,
    cost = 8,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,

calculate = function(self, card, context)
if context.before and not context.blueprint then
            local reset = false
            local play_more_than = (G.GAME.hands[context.scoring_name].played or 0)
            for handname, values in pairs(G.GAME.hands) do
                if handname ~= context.scoring_name and values.played >= play_more_than and SMODS.is_poker_hand_visible(handname) then
                    reset = true
                    break
                end
            end
            if reset then
                if card.ability.extra.Xchips > 1 then
                    card.ability.extra.Xchips = 1
                    return {
                        message = localize('k_reset')
                    }
                end
            else
                -- See note about SMODS Scaling Manipulation on the wiki
                card.ability.extra.Xchips = (card.ability.extra.Xchips + 0.2)
            end
        end
        if context.joker_main then
            return {
                xchips = card.ability.extra.Xchips
            }
        end
    end
}

--code from All in Jest mod, im too dumb to make thisðŸ’€

local sell_card_ref = Card.sell_card
function Card:sell_card()
  local ref = sell_card_ref(self)
  if G.jokers and self.ability.set == 'Joker' then
    if self.ability.name == 'j_omega_reboot_card' then
        G.GAME.last_sold = nil
    else
        G.GAME.last_sold = self
    end
  end
  return ref
end

local reboot_card = SMODS.Joker{
    key = "reboot_card",
    loc_txt = {
        name = "Reboot Card",
        text = {
            "Copies ability of the",
			"last {C:attention}sold{} Joker"
        }
    },

    atlas = "reboot_card",
    rarity = 2,
    cost = 6,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,
  
    loc_vars = function(self, info_queue, card)
        if G.GAME.last_sold then  
            info_queue[#info_queue + 1] = G.P_CENTERS[G.GAME.last_sold.config.center.key] 
        end
        return { vars = {  } }
    end,
  
    calculate = function(self, card, context)
        local other_joker = G.GAME.last_sold
		return SMODS.blueprint_effect(card, other_joker, context)
    end
}

local ðŸ‘€ = SMODS.Joker{
    key = "ðŸ‘€",
    loc_txt = {
        name = "{f:omega_emoji,s:1.5}ðŸ‘€{}",
        text = {
            "{f:omega_emoji,s:1.2,E:1}ðŸ‘€ ðŸ‘€ ðŸ‘€{}",
			"{f:omega_emoji,s:1.2,E:1,C:attention}ðŸ‘€ {}{f:omega_emoji,s:1.2,E:1}ðŸ‘€ ðŸ‘€ ðŸ‘€{}"
        }
    },
	
	loc_vars = function(self, info_queue, card)
        if card.area and card.area == G.jokers then
            local other_joker
            for i = 1, #G.jokers.cards do
                if G.jokers.cards[i] == card then other_joker = G.jokers.cards[i - 1] end
            end
            local compatible = other_joker and other_joker ~= card and other_joker.config.center.blueprint_compat
            main_end = {
                {
                    n = G.UIT.C,
                    config = { align = "bm", minh = 0.4 },
                    nodes = {
                        {
                            n = G.UIT.C,
                            config = { ref_table = card, align = "m", colour = compatible and mix_colours(G.C.GREEN, G.C.JOKER_GREY, 0.8) or mix_colours(G.C.RED, G.C.JOKER_GREY, 0.8), r = 0.05, padding = 0.06 },
                            nodes = {
                                { n = G.UIT.T, config = { text = ' ' .. localize('k_' .. (compatible and 'compatible' or 'incompatible')) .. ' ', colour = G.C.UI.TEXT_LIGHT, scale = 0.32 * 0.8 } },
                            }
                        }
                    }
                }
            }
            return { main_end = main_end }
        end
    end,

    atlas = "ðŸ‘€",
    rarity = 3,
    cost = 10,
    unlocked = true,
    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,
  
    calculate = function(self, card, context)
        local other_joker = nil
        for i = 1, #G.jokers.cards do
            if G.jokers.cards[i] == card then other_joker = G.jokers.cards[i - 1] end
        end
        return SMODS.blueprint_effect(card, other_joker, context)
    end
}

