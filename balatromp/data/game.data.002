G.FUNCS.can_sell_all_massusable = function(e)
	local card = e.config.ref_table
	local other
	for k, v in pairs(G.consumeables.cards) do 
		if v:CanMassUse() and v ~= card and v:gc().set ~= card:gc().set and not SMODS.is_eternal(v) then
			other = true
			break
		end
	end 
	if other and card.highlighted and CanUseStackButtons() and Noituus.CFG.UI.SELLALLMASSUSABLE then
		e.config.colour = G.C.BLACK
		e.config.button = 'sell_all_massusable'
		e.states.visible = true
	else
		e.config.colour = G.C.UI.BACKGROUND_INACTIVE
		e.config.button = nil
		e.states.visible = false
	end
end

