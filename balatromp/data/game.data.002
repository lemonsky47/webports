				runthrough_vouchers()
				return true
			end}))
		return true end}))
		G.E_MANAGER:add_event(Event({func = function()
			for k, v in pairs(area.cards) do
				QR(function()
					if v and v.area and v.area ~= 'shop' and v.area ~= 'pack_cards' then
						v:try_merge()
					end
