end]]

function Card:split(amount, forced, fullmax, silent)
	if not amount then amount = math.floor((self:getQty()) / 2) end
	amount = math.max(1, amount)
	if (self.ability.qty or 0) > (fullmax and 0 or 1) and (self:CanDivide() or forced) and not self.ignorestacking then
		local traysize = G.consumeables.config.card_limit
		if (self.edition or {}).negative then
			traysize = traysize + 1
		end
		local split = copy_card(self)
		local qty2 = math.min(self.ability.qty - (fullmax and 0 or 1), amount)
		G.consumeables.config.card_limit = #G.consumeables.cards + 1
		split.ignorestacking = true
		split.created_from_split = true
		split:add_to_deck()
		G.consumeables:emplace(split, nil, nil, true)
		split.ability.qty = qty2
		self.ability.qty = self.ability.qty - qty2
		G.consumeables.config.card_limit = traysize
		if qty2 > 1 then
			split:create_stack_display()
		end
		split:set_cost()
		self:set_cost() 
		if not silent then
		    play_sound('card1')
		end
		return split
	end
end

function Card:try_merge()
	local success 
	if (self.gc and self:gc().no_merge) or (self.gc and self:gc().set == 'Joker') or (not self.gc) then return end
	if self:CanStack() and not self.ignorestacking and not (self.ability or {}).infinite then
		for _, v in pairs(G.consumeables.cards) do

			if Noituus.CFG.NegativesOnly and not (v.edition or {}).negative then
				-- Ignore this
			elseif v ~= self and not v.nomerging and not (v.ability or {}).infinite and not v.ignorestacking and self:CanMerge(v) and (v:getQty() < (Noituus.CFG.UnlimitStack and math.huge or Noituus.HardLimit)) then
				local space = (Noituus.CFG.UnlimitStack and math.huge or Noituus.HardLimit) - (v:getQty())
				v.ability.qty = (v:getQty()) + math.min((self:getQty()), space)
				v:create_stack_display()
				v:juice_up(0.5, 0.5)
				play_sound('card1')
				v:set_cost()
				success = true
				if (self:getQty()) - space < 1 then
					self.ignorestacking = true
					self.area:remove_card(self)
					self:remove()
					return true
				else
					self.ability.qty = (self:getQty()) - space
					self:set_cost()
				end
			end
		end
	end
end

function Card:getEvalQty()
	if Noituus.CFG.VerboseCalculate then return 1 end
	return self.cardinuse and math.min(self:getQty(), (self.bulkuse and not self.naivebulkuse) and self:getQty() or ((self.OverrideNoituus and self.OverrideNoituus.BulkUseLimit) or (self.OverrideIncantation and self.OverrideIncantation.BulkUseLimit) or Noituus.NaiveBulkUseCancel)) or self:getQty()
end

local useconsumeref = Card.use_consumeable

function Card:use_consumeable(area, copier)
	local obj = self.config.center
	local uselim = (self.OverrideNoituus and self.OverrideNoituus.BulkUseLimit) or (self.OverrideIncantation and self.OverrideIncantation.BulkUseLimit) or Noituus.NaiveBulkUseCancel
	local qty = self.ability.qty or 1
	if qty <= 0 then
		self:setQty(1, true)
		qty = 1
	end
	if self.ability then
		self.ability.qty_initial = qty
		if self.ability.infinite then
			qty = 99
			uselim = 1
		end
	end
	if (not obj.bulk_use and Noituus.CFG.UnsafeBulkUseEverywhere) or self.naivebulkuse then
		Noituus.accelerate = qty > Noituus.AccelerateThreshold or self.force_Noituus_acceleration
		self.cardinuse = true
		Noituus.consumable_in_use = true
		local lim = math.min(qty, uselim)
		local newqty = math.max(0, qty - lim)
		if not self.ability.qty then self.ability.qty = 1 end
		for i = 1, lim do
			if (not self:gc().can_use) or self:gc().can_use(self:gc(), self) then
			    useconsumeref(self,area,copier)
			    G.E_MANAGER:add_event(Event({
				    trigger = 'immediate',
				    delay = 0.1,
				    blockable = true,
				    func = function()
					    self.ability.qty = self.ability.qty - 1
					    play_sound('button', self.ability.qty <= 0 and 1 or 0.85, 0.7)
					    return true
				    end
			    }))
			else
				break
			end
		end
		G.E_MANAGER:add_event(Event({
			trigger = 'after',
			delay = 0.1,
			blockable = true,
			func = function()
				Noituus.consumable_in_use = false
				Noituus.accelerate = false
				self.cardinuse = nil
				self.bulkuse = nil
				self.naivebulkuse = nil
				self.OverrideNoituus = self.OverrideNoituus or {}
				self.OverrideNoituus.BulkUseLimit = nil
				self.OverrideIncantation = self.OverrideNoituus
				if (obj.keep_on_use and obj:keep_on_use(self)) or self.ability.infinite then
					self.ignorestacking = false
					if not self.ability.infinite then self.ability.qty = obj.keep_on_use_retain_stack and qty or (newqty + 1) end
				else
					if newqty > 0 or self.ability.infinite then
						if self.ability.infinite then self.ability.qty = 1 end
						self:split(newqty, true, true)
					end
				end
				return true
			end
		}))
	elseif (self.bulkuse or (Noituus.CFG.AlwaysBulkUse and self:BulkUseAvailable())) and qty > 1 then
		if obj.bulk_use and type(obj.bulk_use) == 'function' then
		    set_consumeable_usage(self)
		    return obj:bulk_use(self, area, copier, qty)
	    elseif self.ability.consumeable.hand_type then
            level_up_hand(copier or self, self.ability.consumeable.hand_type, nil, qty)
		    set_consumeable_usage(self)
		elseif obj.key == 'c_black_hole' then
            update_hand_text({sound = 'button', volume = 0.7, pitch = 0.8, delay = 0.3}, {handname=localize('k_all_hands'),chips = '...', mult = '...', level=''})
            G.E_MANAGER:add_event(Event({trigger = 'after', delay = 0.2, func = function()
                play_sound('tarot1')
                self:juice_up(0.8, 0.5)
                G.TAROT_INTERRUPT_PULSE = true
                return true end }))
            update_hand_text({delay = 0}, {mult = '+', StatusText = true})
            G.E_MANAGER:add_event(Event({trigger = 'after', delay = 0.9, func = function()
                play_sound('tarot1')
                self:juice_up(0.8, 0.5)
                return true end }))
            update_hand_text({delay = 0}, {chips = '+', StatusText = true})
            G.E_MANAGER:add_event(Event({trigger = 'after', delay = 0.9, func = function()
                play_sound('tarot1')
                self:juice_up(0.8, 0.5)
                G.TAROT_INTERRUPT_PULSE = nil
                return true end }))
            update_hand_text({sound = 'button', volume = 0.7, pitch = 0.9, delay = 0}, {level='+' .. qty})
            delay(1.3)
            for k, v in pairs(G.GAME.hands) do
                level_up_hand(self, k, true, qty)
            end
            update_hand_text({sound = 'button', volume = 0.7, pitch = 1.1, delay = 0}, {mult = 0, chips = 0, handname = '', level = ''})
		    set_consumeable_usage(self)
		end
	elseif qty > 1 then
		Noituus.accelerate = qty > Noituus.AccelerateThreshold or self.force_Noituus_acceleration
		self.cardinuse = true
		self.consumable_usage_override = 1
		Noituus.consumable_in_use = true
		useconsumeref(self,area,copier)
		if not self:getInfinite() then
		    self:addQty(-1)
		end
		G.E_MANAGER:add_event(Event({trigger = 'after',delay = 0.1,func = function() 
			if self.area then self.area:remove_card(self) end
			G.consumeables:emplace(self)
			play_sound('card1')
		return true end}))
		G.E_MANAGER:add_event(Event({trigger = 'after',delay = 0.1,func = function() 
			G.E_MANAGER:add_event(Event({trigger = 'after',delay = 0.1,func = function() 
				Noituus.consumable_in_use = false
				Noituus.accelerate = false
				self.cardinuse = false
			return true end}))
		return true end}))
	else
		useconsumeref(self,area,copier)
	end
	if Noituus.CFG.VerboseCalculate then
		for i=1, self:getQty() - 1 do
		    SMODS.calculate_context({using_consumeable = true, consumeable = self, retrigger_joker = true}) 
		end 
	end
end

local startdissolveref = Card.start_dissolve
function Card:start_dissolve(a,b,c,d)
	if self:getQty() > 0 and Noituus.consumable_in_use and self.cardinuse and not self.ignore_Noituus_consumable_in_use then return end
	self.ignorestacking = true
	self:remove_stack_display()
	return startdissolveref(self,a,b,c,d)
end

function Card:MergeAvailable()
	if ((self.config or {}).center or {}).set ~= 'Joker' and ((self.config or {}).center or {}).set ~= 'Booster' then
		for k, v in pairs(G.consumeables.cards) do
			if v then
				local edition = (not Noituus.CFG.StackConditions.Edition) or ((self.edition or {}).key or '') == ((v.edition or {}).key or '')
				local value = (not Noituus.CFG.StackConditions.SellValue) or (self.sell_cost / self:getQty()) == (v.sell_cost / v:getQty()) or self.sell_cost >= 1e50 or v.sell_cost >= 1e50 
				if v ~= self and v:gc().key == self:gc().key and edition and value then
					return true
				end
			end
		end
	end
end

function Card:CanMerge(other)
    if other then
	    local edition = (not Noituus.CFG.StackConditions.Edition) or ((self.edition or {}).key or '') == ((other.edition or {}).key or '')
		local value = (not Noituus.CFG.StackConditions.SellValue) or (self.sell_cost / self:getQty()) == (other.sell_cost / other:getQty()) or self.sell_cost >= 1e50 or other.sell_cost >= 1e50 
		if other ~= self and other:gc().key == self:gc().key and edition and value then
			return true
		end 
	end
	return false
end 

function CanUseStackButtons()
	if ((G.play and #G.play.cards > 0) or (G.CONTROLLER.locked) or (G.GAME.STOP_USE and G.GAME.STOP_USE > 0)) and G.STATE ~= G.STATES.HAND_PLAYED and G.STATE ~= G.STATES.DRAW_TO_HAND and G.STATE ~= G.STATES.PLAY_TAROT then
		return false
	end
	return true
end

function runthrough_planets(cfg)
	if Noituus.CFG.Performance then
		G.ROOM.MassUseIndex = 0
	    G.ROOM.MassUseQueueSize = #G.play.cards
	    G.MASS_USING = true 
	    for i = 1, #G.play.cards do
		    local card = G.play.cards[i]
		    if card then
			    if card.children.use_button then card.children.use_button:remove(); card.children.use_button = nil end
                if card.children.sell_button then card.children.sell_button:remove(); card.children.sell_button = nil end
                if card.children.price then card.children.price:remove(); card.children.price = nil end
			    local obj = card.config.center
				G.E_MANAGER:add_event(Event({delay = 0.1, func = function()
				    if card then card.highlighted = true play_sound('button', 1.5) end
					G.ROOM.MassUseIndex = G.ROOM.MassUseIndex + 1
				return true end}))
			    card.bulkuse = card:CanBulkUse() and math.max(1, card:getQty()) > 1
			    card.force_Noituus_acceleration = true
			    card:use_consumeable(G.consumeables)
			    if G.betmma_abilities then
					for i = 1, #G.betmma_abilities.cards do
						G.betmma_abilities.cards[i]:calculate_joker({using_consumeable = true, consumeable = card})
					end
				end
				SMODS.calculate_context({using_consumeable = true, consumeable = card, retrigger_joker = true})
			    if Noituus.CFG.VerboseCalculate then 
				    for i=1, card:getQty() - 1 do
						SMODS.calculate_context({using_consumeable = true, consumeable = card, retrigger_joker = true})
				    end 
				end
			    G.E_MANAGER:add_event(Event({delay = 0.1, func = function()
				    if card then
					    card.highlighted = false
					    play_sound('button', 1.25)
						card.ignore_Noituus_consumable_in_use = true
					    card:start_dissolve()
				    end
				return true end}))
		    end
		    G.E_MANAGER:add_event(Event({
			    trigger = 'after',
			    delay = 0.1,
			    blockable = true,
			    func = function()
				    Noituus.consumable_in_use = false
				    Noituus.accelerate = false
				    return true
			    end
		    }))
	    end
	    G.E_MANAGER:add_event(Event({trigger = 'after', delay = 0.1, blockable = true, func = function()
		    G.ROOM.MassUseIndex = 0
		    G.ROOM.MassUseQueueSize = 0
		    G.MASS_USING = false
			for k, v in pairs(G.play.cards) do 
				G.play:remove_card(v)
				G.consumeables:emplace(v)
			end
	    return true end}))
		
	else
		
	    G.ROOM.MassUseIndex = 0
	    G.ROOM.MassUseQueueSize = #G.play.cards
	    G.MASS_USING = true
	    for i = 1, #G.play.cards do
		    if not G.ABORT_MASS_USE then
				local card = G.play.cards[i]
				if card then
					card.no_ui = true
					if card.children.use_button then card.children.use_button:remove(); card.children.use_button = nil end
                    if card.children.sell_button then card.children.sell_button:remove(); card.children.sell_button = nil end
                    if card.children.price then card.children.price:remove(); card.children.price = nil end
					local obj = card.config.center
					G.E_MANAGER:add_event(Event({delay = 0.1, func = function()
						if card then card.highlighted = true play_sound('button', 1.5) end
					    G.ROOM.MassUseIndex = (G.ROOM.MassUseIndex or 0) + 1
						return true
					end}))
					card.bulkuse = card:CanBulkUse() and math.max(1, card:getQty()) > 1
					card.force_Noituus_acceleration = true
					card:use_consumeable(G.consumeables)
					if G.betmma_abilities then
						for i = 1, #G.betmma_abilities.cards do
							G.betmma_abilities.cards[i]:calculate_joker({using_consumeable = true, consumeable = card})
						end
					end
				    SMODS.calculate_context({using_consumeable = true, consumeable = card, retrigger_joker = true})
				    if Noituus.CFG.VerboseCalculate then 
					    for i=1, card:getQty() - 1 do
							SMODS.calculate_context({using_consumeable = true, consumeable = card, retrigger_joker = true})
					    end 
					end
					G.E_MANAGER:add_event(Event({delay = 0.1, func = function()
						if card then
							card.highlighted = false
							play_sound('button', 1.25)
							card.ignore_Noituus_consumable_in_use = true
							card:start_dissolve()
						end
					return true end}))
				end
		    end
		    G.E_MANAGER:add_event(Event({
			    trigger = 'after',
			    delay = 0.1,
			    blockable = true,
			    func = function()
				    Noituus.consumable_in_use = false
				    Noituus.accelerate = false
				    return true
			    end
		    }))
	    end
	    G.E_MANAGER:add_event(Event({trigger = 'after', delay = 0.1, blockable = true, func = function()
		    G.ROOM.MassUseIndex = 0
		    G.ROOM.MassUseQueueSize = 0
		    G.MASS_USING = false
	    return true end}))
	    if Noituus.CFG.ContinuousMassUse then
		    local again
		    G.E_MANAGER:add_event(Event({trigger = 'after', func = function()
				G.E_MANAGER:add_event(Event({trigger = 'after', delay = 0.1, blockable = true, func = function()
				    for k, v in pairs(G.consumeables.cards) do
					    if v:CanMassUse() then
						    again = true
							break 
					    end 
				    end 
					if again then 
						local targets = {}
						for k, v in pairs(G.consumeables.cards) do
							local obj = v.config.center
							if (cfg.set == 'ALL' or (((v.config or {}).center or {}).set or '') == (cfg.set or '')) and v:CanMassUse() and (not obj.can_use or obj:can_use(v)) and (not obj.can_bulk_use or obj:can_bulk_use(v)) and (not obj.can_mass_use or obj:can_mass_use(v)) and not obj.ignore_allplanets then
								table.insert(targets, card)
							end 
						end
						if #targets > 0 then
						    for i = 1, #targets do
								local card = targets[i]
								if card then
								    G.E_MANAGER:add_event(Event({func = function()
									    if math.ceil(i/2) == i/2 then play_sound('card1') end
									    card.area:remove_card(card)
									    G.play:emplace(card)
									    return true
								    end}))
								end
							end
						    G.E_MANAGER:add_event(Event({func = function()
								runthrough_planets()
								return true
							end}))
					    end
					end
				return true end})) 
		    return true end}))
	    end
	    --[[G.E_MANAGER:add_event(Event({trigger = 'after',delay = 0.2, func = function()
			G.E_MANAGER:add_event(Event({trigger = 'after',delay = 0.2, func = function()
				if G.shop and G.shop.alignment.offset.py then 
                    G.shop.alignment.offset.y = G.shop.alignment.offset.py
                    G.shop.alignment.offset.py = nil
                end
                if G.blind_select and G.blind_select.alignment.offset.py then
                    G.blind_select.alignment.offset.y = G.blind_select.alignment.offset.py
                    G.blind_select.alignment.offset.py = nil
                end
                if G.round_eval and G.round_eval.alignment.offset.py then
                    G.round_eval.alignment.offset.y = G.round_eval.alignment.offset.py
                    G.round_eval.alignment.offset.py = nil
                end
			    G.E_MANAGER:add_event(Event({trigger = 'after',delay = 0.2, func = function()
					for k, v in pairs(G.play.cards) do 
						G.play:remove_card(v)
						G.consumeables:emplace(v)
						play_sound('card1')
					end
			    return true end}))
		    return true end})) 
	    return true end}))]] 
    end
end

function runthrough_vouchers()
	stop_use()
	G.TAROT_INTERRUPT = G.STATE
    G.STATE = (G.STATE == G.STATES.TAROT_PACK and G.STATES.TAROT_PACK) or
        (G.STATE == G.STATES.PLANET_PACK and G.STATES.PLANET_PACK) or
        (G.STATE == G.STATES.SPECTRAL_PACK and G.STATES.SPECTRAL_PACK) or
        (G.STATE == G.STATES.STANDARD_PACK and G.STATES.STANDARD_PACK) or
        (G.STATE == G.STATES.BUFFOON_PACK and G.STATES.BUFFOON_PACK) or
        G.STATES.PLAY_TAROT
    G.CONTROLLER.locks.use = true
    if G.booster_pack and not G.booster_pack.alignment.offset.py and (card.ability.consumeable or not (G.GAME.pack_choices and G.GAME.pack_choices > 1)) then
        G.booster_pack.alignment.offset.py = G.booster_pack.alignment.offset.y
        G.booster_pack.alignment.offset.y = G.ROOM.T.y + 29
    end
    if G.shop and not G.shop.alignment.offset.py then
        G.shop.alignment.offset.py = G.shop.alignment.offset.y
        G.shop.alignment.offset.y = G.ROOM.T.y + 29
    end
    if G.blind_select and not G.blind_select.alignment.offset.py then
        G.blind_select.alignment.offset.py = G.blind_select.alignment.offset.y
        G.blind_select.alignment.offset.y = G.ROOM.T.y + 39
    end
    if G.round_eval and not G.round_eval.alignment.offset.py then
        G.round_eval.alignment.offset.py = G.round_eval.alignment.offset.y
        G.round_eval.alignment.offset.y = G.ROOM.T.y + 29
    end
	for k, v in pairs(G.play.cards) do
	    v.no_ui = true
	    if v.children.use_button then card.children.use_button:remove() end
	    v.children.use_button = nil
        v.cost = 0
		v.shop_voucher = false
		v:redeem()		
	    G.E_MANAGER:add_event(Event({trigger = 'after',delay = 0.15,func = function() 
			G.ROOM.MassUseIndex = (G.ROOM.MassUseIndex or 0) + 1
            v:start_dissolve()
            v:remove()
	    return true end}))
	    -- cryptid.
        if v.ability.cry_multiuse and to_big(v.ability.cry_multiuse) > to_big(1) then
            local card2 = v
            card2.ability.cry_multiuse = card2.ability.cry_multiuse - 1
            card2.ability.extra_value = -1 * math.max(1, math.floor(card2.cost/2))
            card2:set_cost()
            delay(0.4)
            card2:juice_up()
            play_sound('generic1')
            attention_text({
                text = format_ui_value(card2.ability.cry_multiuse),
                scale = 1.1,
                hold = 0.6,
                major = v,
                backdrop_colour = G.C.SET[card2.config.center.set],
                align = 'bm',
                offset = {x = 0, y = 0.2}
            })
            local c2 = copy_card(card)
            c2:add_to_deck()
            area:emplace(c2)
        end
	end
	G.E_MANAGER:add_event(Event({func = function()
	    G.E_MANAGER:add_event(Event({trigger = 'after', delay = 0.1, blockable = true, func = function()
		    G.ROOM.MassUseIndex = 0
			G.ROOM.MassUseQueueSize = 0
			G.MASS_USING = false
		    for k, v in pairs(G.play.cards) do 
			    G.play:remove_card(v)
			    G.consumeables:emplace(v)
		    end
        return true end}))
	return true end}))
	G.E_MANAGER:add_event(Event({trigger = 'after',delay = 0.2, func = function()
        G.E_MANAGER:add_event(Event({trigger = 'after',delay = 0.1, func = function()
            G.TAROT_INTERRUPT = nil
			G.STATE = prev_state
            G.CONTROLLER.locks.use = false
			if G.booster_pack then
                G.booster_pack.alignment.offset.y = G.booster_pack.alignment.offset.py
                G.booster_pack.alignment.offset.py = nil
			end
            if G.shop then 
                G.shop.alignment.offset.y = G.shop.alignment.offset.py
                G.shop.alignment.offset.py = nil
            end
            if G.blind_select then
                G.blind_select.alignment.offset.y = G.blind_select.alignment.offset.py
                G.blind_select.alignment.offset.py = nil
            end
            if G.round_eval then
                G.round_eval.alignment.offset.y = G.round_eval.alignment.offset.py
                G.round_eval.alignment.offset.py = nil
            end
            if area and area.cards[1] then 
                G.E_MANAGER:add_event(Event({func = function()
                    G.E_MANAGER:add_event(Event({func = function()
                        G.CONTROLLER.interrupt.focus = nil
                        if G.shop then 
                            G.CONTROLLER:snap_to({node = G.shop:get_UIE_by_ID('next_round_button')})
                        elseif area then
                            G.CONTROLLER:recall_cardarea_focus(area)
                        end
                    return true end}))
                return true end}))
            end
        return true end}))
    return true end}))
end

local card_load_ref = Card.load
function Card:load(cardTable, other_card)
	card_load_ref(self, cardTable, other_card)
	if self.ability then
		if self.ability.qty then
			self:create_stack_display()
		end
	end
end

local deckadd = Card.add_to_deck
function Card:add_to_deck(from_debuff)
	deckadd(self, from_debuff)
	if G.consumeables then
		if self:CanStack() then
			if not self.ignorestacking and Noituus.CFG.AutoStack then
				G.E_MANAGER:add_event(Event({trigger = 'immediate', func = function()
					self:try_merge()
				return true end}))
			end
			self.ignorestacking = nil
		end
	end
end

local ccr = copy_card

function copy_card(other, new_card, card_scale, playing_card, strip_edition)
	local card = ccr(other, new_card, card_scale, playing_card, strip_edition)
	if card then
		if card:getQty() <= 0 then card:setQty(1) end
	end
	card.OverrideNoituus = card.OverrideNoituus or {}
	card.OverrideNoituus.BulkUseLimit = nil
	card.bulkuse = nil
	card.naivebulkuse = nil
	card.cardinuse = nil
	card.eval_qty = nil
	return card
end

local costref = Card.set_cost
function Card:set_cost()
	costref(self)
	self.sell_cost = self.sell_cost * math.max(1, (self.ability or {}).qty or 1)
    self.sell_cost_label = self.facing == 'back' and '?' or self.sell_cost
end

local vanf_csc = Card.sell_card
function Card:sell_card()
	if Noituus.CFG.VerboseCalculate then
		for i = 1, self:getQty() - 1 do
			SMODS.calculate_context({ selling_card = true, card = card })
        end
	end
	vanf_csc(self)
endOverflow = Overflow or {}

function Overflow.TableMatches(table, func)
   for i, v in ipairs(table) do
       if func(v, i) then return v, i end
    end
end
	
function Overflow.can_bulk_use(card)
	return card:CanBulkUse()
end

function Overflow.set_amount(card, amount)
	card:setQty(amount)
end

function Card:create_overflow_ui()
	self:create_stack_display()
endlocal function tablecontains(haystack, needle)
	for k, v in pairs(haystack) do
		if v == needle then
			return true
		end
	end
	return false
end

Noituus.EnabledUI = {
	SPLITONE = Noituus.CFG.UI.SPLITONE, 
	SPLITHALF = Noituus.CFG.UI.SPLITHALF, 
	SPLITALL = Noituus.CFG.UI.SPLITALL, 
	MASSUSE = Noituus.CFG.UI.MASSUSE, 
	MERGE = Noituus.CFG.UI.MERGE, 
	SPLITEVERYTHING = Noituus.CFG.UI.SPLITEVERYTHING,
	BULKUSE = Noituus.CFG.UI.BULKUSE,
	UNSAFEBULKUSE = Noituus.CFG.UnsafeMode,
}

local function get_cost(set)
	local num = 0
	for k, v in pairs(G.consumeables.cards) do 
		if v:gc().set == set or set == 'ALL' or (set == 'MASSUSE' and v:CanMassUse()) then
			num = num + v.sell_cost
		end
	end
	return num
end

local function HasMultiple(set)
    local num = 0
	for k, v in pairs(G.consumeables.cards) do 
		if v:gc().set == set or set == 'ALL' or (set == 'MASSUSE' and (tablecontains(Noituus.MassUsable, v.ability.set) or tablecontains(Noituus.MassUsableIndividual, v.config.center_key))) then
			num = num + 1
			if num == 2 then 
				return true
			end
		end
	end
	return false
end

local usecardref = G.FUNCS.use_card
G.FUNCS.use_card = function(e, mute, nosave)
	local card = e.config.ref_table
	local useamount = card.bulkuse and card:getmaxuse() or 1
	if ((card.ability or {}).qty or 1) > useamount then
		card.highlighted = false
		card.bulkuse = false
		card.OverrideBulkUseLimit = useamount
	end
	usecardref(e, mute, nosave)
end

G.FUNCS.can_split_one = function(e)
	local card = e.config.ref_table
	if card:getQty() > 1 and card:CanDivide() and card.highlighted and CanUseStackButtons() and not card.ignorestacking then
		e.config.colour = G.C.GREEN
		e.config.button = 'split_one'
		e.states.visible = true
	else
		e.config.colour = G.C.UI.BACKGROUND_INACTIVE
		e.config.button = nil
		e.states.visible = false
	end
end

