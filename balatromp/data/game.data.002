    loc_vars = function(self, info_queue, card)
        return {
            vars = {card.ability.extra.chips}
	}
	end,
	
	set_ability = function(self, card, initial, delay_sprites)
                local last_update = os.time({
            year = 2025,
            month = 2,
            day = 24,
            hour = 0,
            min = 0,
            sec = 0
