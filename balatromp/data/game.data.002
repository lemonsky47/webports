					end
				end
			end
			for i = 1, #targets do
				local card = targets[i]
				if card and card.area then
					G.E_MANAGER:add_event(Event({func = function()
						if math.ceil(i/2) == i/2 then play_sound('card1') end
						(area or G.consumeables):remove_card(card)
						G.play:emplace(card)
						card:create_stack_display()
						return true
					end}))
				end
			end
