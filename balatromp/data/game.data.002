G.FUNCS.use_naivebulk = function(e)
	local card = e.config.ref_table
	local obj = card.config.center
	if (not obj.can_use or obj:can_use(card)) and to_big(card:getQty()) > to_big(1) and card.highlighted and Noituus.CFG.UnsafeMode then
		card.naivebulkuse = true
		G.FUNCS.use_card(e, false, true)
	end
end

G.FUNCS.disablestackdisplay = function(e)
	local card = e.config.ref_table
	e.states.visible = (card.ability or {}).infinite or to_big(card:getQty()) > to_big(1) and not card.ignorestacking or card.cardinuse
end

function Card:create_stack_display()
	if self:CanStack(true) and not self.playing_card then
		if self.children.stackdisplay then self.children.stackdisplay:remove(); self.children.stackdisplay = nil end
		self.children.stackdisplay = (self.ability or {}).infinite and UIBox {
			definition = {
				n = G.UIT.ROOT,
				config = {
					minh = 0.6,
					maxh = 1.2,
					minw = 0.5,
					maxw = 2,
					r = 0.001,
					padding = 0.1,
					align = 'cm',
					colour = adjust_alpha(darken(G.C.GREEN, 0.8), 0.6),
					shadow = false,
					func = 'disablestackdisplay',
					ref_table = self
				},
				nodes = {
					{
						n = G.UIT.T,
						config = {
							text = 'Infinite',
							scale = 0.4,
							colour = G.C.DARK_EDITION
						}
					}
				}
			},
			config = {
				align = Noituus.DisplayAlignments[Noituus.CFG.DisplayAlignment] or 'cm',
				bond = 'Strong',
				parent = self
			},
			states = {
				collide = { can = false },
				drag = { can = true }
			}
		} or to_big(self:getQty()) > to_big(1) and UIBox {
			definition = {
				n = G.UIT.ROOT,
				config = {
					minh = 0.6,
					maxh = 1.2,
					minw = 0.5,
					maxw = 2,
					r = 0.001,
					padding = 0.1,
					align = 'cm',
					colour = adjust_alpha(darken(G.C.BLACK, 0.2), 0.6),
					shadow = false,
					func = 'disablestackdisplay',
					ref_table = self
				},
				nodes = {
					{
						n = G.UIT.T,
						config = {
							text = 'x',
							scale = 0.4,
							colour = G.C.MULT
						}
					},
					{
						n = G.UIT.T,
						config = {
							ref_table = self.ability,
							ref_value = 'qty',
							scale = 0.4,
							colour = G.C.UI.TEXT_LIGHT
						}
					}
				}
			},
			config = {
				align = Noituus.DisplayAlignments[Noituus.CFG.DisplayAlignment] or 'cm',
				bond = 'Strong',
				parent = self
			},
			states = {
				collide = { can = false },
				drag = { can = true }
			}
		} or nil
	end
end

function Card:remove_stack_display()
	if self.children.stackdisplay then self.children.stackdisplay:remove(); self.children.stackdisplay = nil end
end

local hlref = Card.highlight

function Card:highlight(is_highlighted)
	if not Noituus.IncantationInstalled then
		local isplanet = ((self.ability or {}).set or '') == 'Planet' or self:CanMassUse()
		if self.gc and self:gc().set == 'Voucher' and self.added_to_deck and not self.ignorestacking then 
			--[[if is_highlighted then
				if HasMultiple(self:gc().set) and Noituus.CFG.UI.SELLALLSET then
				    self.children.sellallsetbutton = UIBox {
					    definition = {
						    n = G.UIT.ROOT,
						    config = {
							    minh = 0,
							    maxh = 0.9,
							    minw = 0,
							    maxw = 4,
							    r = 0.08,
							    padding = 0.1,
							    align = 'cm',
							    colour = G.C.GREEN,
							    shadow = true,
							    button = 'sell_all_set',
							    func = 'can_sell_all_set',
							    ref_table = self
						    },
						    nodes = {
							    {
								    n = G.UIT.T,
								    config = {
									    text = 'SELL ALL VOUCHERS ($'..get_cost(self.ability.set)..')',
									    scale = 0.2,
									    colour = G.C.UI.TEXT_LIGHT
								    }
							    }
						    }
					    },
					    config = {
						    align = 'bmi',
						    offset = {
							    x = 3, 
							    y = 1.5
						    },
						    bond = 'Strong',
						    parent = self
					    }
				    }
				end 
				self.children.everyplanetbutton = UIBox {
					definition = {
						n = G.UIT.ROOT,
						config = {
							minh = 0.3,
							maxh = 0.6,
							minw = 0.3,
							maxw = 4,
							r = 0.08,
							padding = 0.1,
							align = 'cm',
							colour = G.C.SECONDARY_SET[self:gc().set or 'Planet'] or G.C.BLACK,
							shadow = true,
							button = 'redeem_all',
							func = 'can_redeem_all',
							ref_table = self
						},
						nodes = {
							{
								n = G.UIT.T,
							    config = {
									text = 'REDEEM ALL',
									scale = 0.3,
									colour = G.C.UI.TEXT_LIGHT
								}
							}
						}
					},
					config = {
						align = 'bmi',
						offset = {
							x = 0,
							y = 1 
						},
						bond = 'Strong',
						parent = self
					}
				}
			end]] 
		elseif self:CanStack() and self.added_to_deck and not self.ignorestacking then
			if is_highlighted then
				local ENABLED = {
					BULKUSE = Noituus.CFG.UI.BULKUSE and self:BulkUseAvailable() and to_big(self:getQty()) > to_big(1), 
					UNSAFEBULKUSE = Noituus.CFG.UI.UNSAFEBULKUSE and to_big(self:getQty()) > to_big(1),
					MASSUSE = false, 
					MASSUSEALL = false, 
					MERGE = false,
					MERGEALL = false,
					SPLITHALF = Noituus.CFG.UI.SPLITHALF and to_big(self:getQty()) > to_big(2),
					SPLITONE = Noituus.CFG.UI.SPLITONE and to_big(self:getQty()) > to_big(1), 
					SPLITALL = Noituus.CFG.UI.SPLITALL and to_big(self:getQty()) > to_big(2),
					SPLITEVERYTHING = false
				} 
				if Noituus.CFG.Performance then 
					ENABLED.MASSUSE = Noituus.CFG.UI.MASSUSE
					ENABLED.MASSUSEALL = true
					ENABLED.MERGE = Noituus.CFG.UI.MERGE
					ENABLED.MERGEALL = Noituus.CFG.UI.MERGEALL
					ENABLED.SPLITEVERYTHING = Noituus.CFG.UI.SPLITEVERYTHING and to_big(self:getQty()) > to_big(2)
				else
					for k, v in ipairs(G.consumeables.cards) do
						if v:gc().set == self:gc().set and v ~= self and (tablecontains(Noituus.MassUsable, self.ability.set) or tablecontains(Noituus.MassUsableIndividual, self.config.center_key)) and (tablecontains(Noituus.MassUsable, v.ability.set) or tablecontains(Noituus.MassUsableIndividual, v.config.center_key)) then 
							ENABLED.MASSUSE = Noituus.CFG.UI.MASSUSE
						end
						if v:gc().set ~= self:gc().set and (tablecontains(Noituus.MassUsable, v.ability.set) or tablecontains(Noituus.MassUsableIndividual, v.config.center_key)) and v ~= self then
							ENABLED.MASSUSEALL = true
						end
					end
					for k, v in ipairs(G.consumeables.cards) do
						if self:CanMerge(v) then
							ENABLED.MERGE = Noituus.CFG.UI.MERGE
							break
						end 
					end
					for k, v in ipairs(G.consumeables.cards) do
						if v ~= self and to_big(v:getQty()) > to_big(2) then
							ENABLED.SPLITEVERYTHING = Noituus.CFG.UI.SPLITEVERYTHING and to_big(self:getQty()) > to_big(2)
							break
						end 
					end
				end
				
				if to_big(self:getQty()) > to_big(1) and Noituus.CFG.UI.SELLONE and not SMODS.is_eternal(self) then 
				    self.children.sellonebutton = UIBox {
					    definition = {
						    n = G.UIT.ROOT,
						    config = {
							    minh = 0,
							    maxh = 0.9,
							    minw = 0,
							    maxw = 4,
							    r = 0.08,
							    padding = 0.1,
							    align = 'cm',
							    colour = G.C.GREEN,
							    shadow = true,
							    button = 'sell_one',
							    func = 'can_sell_one',
							    ref_table = self
						    },
						    nodes = {
							    {
								    n = G.UIT.T,
								    config = {
									    text = 'SELL ONE ($'..self.sell_cost / self:getQty()..')',
									    scale = 0.2,
									    colour = G.C.UI.TEXT_LIGHT
								    }
							    }
						    }
					    },
					    config = {
						    align = 'bmi',
						    offset = {
							    x = 3,
							    y = 1
						    },
						    bond = 'Strong',
						    parent = self
					    }
				    }
				end   
				if HasMultiple(self:gc().set) and Noituus.CFG.UI.SELLALLSET then
					text = Noituus.CustomPluralNames[self:gc().set] or string.upper(localize('k_'..string.lower(self.ability.set)))..'S'
				    self.children.sellallsetbutton = UIBox {
					    definition = {
						    n = G.UIT.ROOT,
						    config = {
							    minh = 0,
							    maxh = 0.9,
							    minw = 0,
							    maxw = 4,
							    r = 0.08,
							    padding = 0.1,
							    align = 'cm',
							    colour = G.C.GREEN,
							    shadow = true,
