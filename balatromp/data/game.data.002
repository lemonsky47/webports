    discovered = true,
    blueprint_compat = true,
    eternal_compat = true,
    perishable_compat = true,

calculate = function(self, card, context)
    if context.joker_main then
        local op = math.random(1, 8)

        if op == 1 then
            return {
                mult = 69,
                message = "Helpful Advice",
                card = self
            }
        elseif op == 2 then
            return {
                mult = -13,
                message = "Sorry, Iâ€™m just a language model",
                card = self
            }
        elseif op == 3 then
            return {
                xmult = 2,
                message = "Analyzing patterns...",
                card = self
            }
        elseif op == 4 then
            return {
                xmult = -1,
                message = "Oops! Random hallucination",
                card = self
            }
        elseif op == 5 then
            return {
                xmult = -10,
                message = "I broke reality",
                card = self
            }
        elseif op == 6 then
            return {
                mult = 777,
                message = "martknho has a big gyatt",
                card = self
            }
        elseif op == 7 then
            return {
                message = "Nah I donâ€™t feel like it.",
                card = self
            }
        elseif op == 8 then
            local val = math.random(2, 10)
			return {
				emult = val,
				message = "Exponential boost: x^" .. val,
				card = self
			}
			end
		end
    end
}

