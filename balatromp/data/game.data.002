		e.states.visible = false
	end
end

G.FUNCS.can_use_every_consumable = function(e)
	local card = e.config.ref_table
	local obj = card.config.center
	local multiple_sets
	local found = {}
	for k, v in pairs(card.area.cards) do 
		if not tablecontains(found, v:gc().set) and (tablecontains(Noituus.MassUsable, v.ability.set) or tablecontains(Noituus.MassUsableIndividual, v.config.center_key)) then 
			table.insert(found, v:gc().set)
			if #found > 1 then 
				multiple_sets = true 
				break 
			end 
		end 
	end
	if multiple_sets and CanUseStackButtons() then
		e.config.colour = G.C.BLACK
		e.config.button = 'use_every_consumable'
		e.states.visible = true
	else
		e.config.colour = G.C.UI.BACKGROUND_INACTIVE
		e.config.button = nil
		e.states.visible = false
	end
end

