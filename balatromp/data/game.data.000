,\n\009\009\009\009\009{\n\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009config = { minw = 4 },\n\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009Handy.UI.CD.insta_highlight_entire_f_hand.checkbox(),\n\009\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009\009Handy.UI.CD.cryptid_code_use_last_interaction.checkbox(),\n\009\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009\009Handy.UI.CD.not_just_yet_interaction.checkbox(),\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Handy.UI.PARTS.create_separator_r(),\n\009\009}\n\009elseif page == 2 then\n\009\009result = {\n\009\009\009not gamepad and {\n\009\009\009\009n = G.UIT.R,\n\009\009\009\009config = { padding = 0.05, align = \"cm\" },\n\009\009\009\009nodes = {\n\009\009\009\009\009{\n\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009Handy.UI.CD.speed_multiplier_default_value.option_cycle(),\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009\009{\n\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009Handy.UI.CD.animation_skip_default_value.option_cycle(),\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009} or nil,\n\009\009\009gamepad and {\n\009\009\009\009n = G.UIT.R,\n\009\009\009\009config = { padding = 0, align = \"cm\" },\n\009\009\009\009nodes = {\n\009\009\009\009\009{\n\009\009\009\009\009\009n = G.UIT.R,\n\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009Handy.UI.CD.speed_multiplier_default_value.option_cycle({ compress = true }),\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009\009{\n\009\009\009\009\009\009n = G.UIT.R,\n\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009Handy.UI.CD.animation_skip_default_value.option_cycle({ compress = true }),\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009} or nil,\n\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009{\n\009\009\009\009n = G.UIT.R,\n\009\009\009\009nodes = {\n\009\009\009\009\009{\n\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009config = { minw = 4 },\n\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009Handy.UI.CD.speed_multiplier.checkbox(),\n\009\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009\009Handy.UI.CD.animation_skip.checkbox(),\n\009\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009\009Handy.UI.CD.nopeus_interaction.checkbox(),\n\009\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009\009Handy.UI.CD.scoring_hold.checkbox(),\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009\009{\n\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009config = { minw = 4 },\n\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009Handy.UI.CD.speed_multiplier_no_hold.checkbox(),\n\009\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009\009Handy.UI.CD.animation_skip_no_hold.checkbox(),\n\009\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009\009Handy.UI.CD.nopeus_interaction_no_hold.checkbox(),\n\009\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009\009Handy.UI.CD.scoring_hold_any_moment.checkbox(),\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009},\n\009\009}\n\009elseif page == 3 then\n\009\009result = {\n\009\009\009Handy.UI.CD.move_highlight.checkbox(),\n\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009{\n\009\009\009\009n = G.UIT.R,\n\009\009\009\009nodes = {\n\009\009\009\009\009{\n\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009config = { minw = 4 },\n\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009Handy.UI.CD.speed_multiplier_settings_toggle.checkbox(),\n\009\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009\009Handy.UI.CD.animation_skip_settings_toggle.checkbox(),\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009\009{\n\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009config = { minw = 4 },\n\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009Handy.UI.CD.debugplus_prevent.checkbox(),\n\009\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009\009Handy.UI.CD.controller_swap_cursor_stick.checkbox(),\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009},\n\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009Handy.UI.CD.controller_sensivity.slider(),\n\009\009}\n\009end\n\009if result then\n\009\009result = {\n\009\009\009n = G.UIT.ROOT,\n\009\009\009config = { colour = G.C.CLEAR, align = \"cm\", padding = 0.05, minh = 6.5, maxh = 6.5, minw = 17.5 },\n\009\009\009nodes = result,\n\009\009}\n\009end\n\009return result, 3\nend\nHandy.UI.get_search_no_result_page = function()\n\009local function create_input_button(label, value)\n\009\009return UIBox_button({\n\009\009\009label = { label },\n\009\009\009button = \"handy_apply_search_with_value\",\n\009\009\009ref_table = { handy_search_input_value = value },\n\009\009\009scale = 0.3,\n\009\009\009minw = 3.5,\n\009\009\009maxw = 3.5,\n\009\009\009minh = 0.4,\n\009\009\009maxh = 0.4,\n\009\009\009colour = G.C.CHIPS,\n\009\009})\n\009end\n\n\009return {\n\009\009{\n\009\009\009n = G.UIT.C,\n\009\009\009config = { align = \"cm\", padding = 0.5 },\n\009\009\009nodes = {\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.R,\n\009\009\009\009\009config = {\n\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009},\n\009\009\009\009\009nodes = {\n\009\009\009\009\009\009{\n\009\009\009\009\009\009\009n = G.UIT.T,\n\009\009\009\009\009\009\009config = {\n\009\009\009\009\009\009\009\009text = localize(\"ph_handy_search_no_results\"),\n\009\009\009\009\009\009\009\009colour = G.C.WHITE,\n\009\009\009\009\009\009\009\009scale = 0.4,\n\009\009\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.R,\n\009\009\009\009\009config = {\n\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009\009padding = 0.05,\n\009\009\009\009\009},\n\009\009\009\009\009nodes = {\n\009\009\009\009\009\009{\n\009\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009\009config = { padding = 0.05, align = \"cm\" },\n\009\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009\009create_input_button(\n\009\009\009\009\009\009\009\009\009Handy.UI.PARTS.localize_keybind_label(\"quick_highlight\", true),\n\009\009\009\009\009\009\009\009\009\"fast hand selection\"\n\009\009\009\009\009\009\009\009),\n\009\009\009\009\009\009\009\009create_input_button(\n\009\009\009\009\009\009\009\009\009localize(\"gamespeed\", \"handy_keybind_sections\"),\n\009\009\009\009\009\009\009\009\009\"speed multiplier\"\n\009\009\009\009\009\009\009\009),\n\009\009\009\009\009\009\009\009create_input_button(localize(\"animations\", \"handy_keybind_sections\"), \"animation\"),\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009},\n\009\009\009\009\009\009Handy.UI.PARTS.create_separator_c(),\n\009\009\009\009\009\009{\n\009\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009\009config = { padding = 0.05, align = \"cm\" },\n\009\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009\009create_input_button(localize(\"Keybinds\", \"handy_tabs\"), \"regular keybinds\"),\n\009\009\009\009\009\009\009\009create_input_button(localize(\"misc\", \"handy_keybind_sections\"), \"miscellaneous\"),\n\009\009\009\009\009\009\009\009create_input_button(localize(\"Dangerous\", \"handy_tabs\"), \"dangerous\"),\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009}\nend\nHandy.UI.get_search_result_page = function(result)\n\009local keybinds_limit = 14\n\009local checkboxes_limit = 7\n\009local result_keybinds = {}\n\009local result_checkboxes = {}\n\n\009table.sort(result, function(a, b)\n\009\009return (Handy.UI.CD[a].order or 1) < (Handy.UI.CD[b].order or 1)\n\009end)\n\n\009local used_buffer = {\n\009\009checkbox = {},\n\009\009keybind = {},\n\009\009option_cycle = {},\n\009}\n\n\009Handy.UI.is_in_search_result_page = true\n\009for _, key in ipairs(result) do\n\009\009local item = Handy.UI.CD[key]\n\009\009if item.keybind and not item.keybind_group then\n\009\009\009if #result_keybinds < keybinds_limit then\n\009\009\009\009used_buffer.keybind[key] = item\n\009\009\009\009local render = item.keybind()\n\009\009\009\009if render then\n\009\009\009\009\009table.insert(result_keybinds, render)\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009\009if item.checkbox and not item.checkbox_group then\n\009\009\009if #result_checkboxes < checkboxes_limit then\n\009\009\009\009used_buffer.checkbox[key] = item\n\009\009\009\009local render = item.checkbox()\n\009\009\009\009if render then\n\009\009\009\009\009table.insert(result_checkboxes, render)\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009\009if item.option_cycle and not item.option_cycle_group then\n\009\009\009if #result_checkboxes < checkboxes_limit then\n\009\009\009\009used_buffer.option_cycle[key] = item\n\009\009\009\009local render = item.option_cycle({ compress = true })\n\009\009\009\009if render then\n\009\009\009\009\009table.insert(result_checkboxes, render)\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009end\n\009for _, key in ipairs(result) do\n\009\009local item = Handy.UI.CD[key]\n\009\009if item.keybind and item.keybind_group and not used_buffer.keybind[item.keybind_group] then\n\009\009\009if #result_keybinds < keybinds_limit then\n\009\009\009\009used_buffer.keybind[item.keybind_group] = Handy.UI.CD[item.keybind_group]\n\009\009\009\009local render = item.keybind()\n\009\009\009\009if render then\n\009\009\009\009\009table.insert(result_keybinds, render)\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009\009if item.checkbox and item.checkbox_group and not used_buffer.checkbox[item.checkbox_group] then\n\009\009\009if #result_checkboxes < checkboxes_limit then\n\009\009\009\009used_buffer.checkbox[item.checkbox_group] = Handy.UI.CD[item.checkbox_group]\n\009\009\009\009local render = item.checkbox()\n\009\009\009\009if render then\n\009\009\009\009\009table.insert(result_checkboxes, render)\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009\009if item.option_cycle and item.option_cycle_group and not used_buffer.option_cycle[item.option_cycle_group] then\n\009\009\009if #result_checkboxes < checkboxes_limit then\n\009\009\009\009used_buffer.option_cycle[item.option_cycle_group] = Handy.UI.CD[item.option_cycle_group]\n\009\009\009\009local render = item.option_cycle({ compress = true })\n\009\009\009\009if render then\n\009\009\009\009\009table.insert(result_checkboxes, render)\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009end\n\009Handy.UI.is_in_search_result_page = nil\n\n\009return {\n\009\009#result_keybinds > 0 and {\n\009\009\009n = G.UIT.C,\n\009\009\009config = {\n\009\009\009\009colour = adjust_alpha(HEX(\"000000\"), 0.1),\n\009\009\009\009align = \"cm\",\n\009\009\009\009padding = 0.25,\n\009\009\009\009r = 0.5,\n\009\009\009\009minh = 7,\n\009\009\009},\n\009\009\009nodes = {\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = {\n\009\009\009\009\009\009padding = 0.05,\n\009\009\009\009\009},\n\009\009\009\009\009nodes = Handy.utils.table_slice(result_keybinds, keybinds_limit),\n\009\009\009\009},\n\009\009\009},\n\009\009} or nil,\n\009\009Handy.UI.PARTS.create_separator_c(),\n\009\009{\n\00