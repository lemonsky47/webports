end",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if obj.keep_on_use and type(obj.keep_on_use) == 'function' then\n    nc = obj:keep_on_use(card)\nend\n",["position"]="after",["payload"]="if not nc and card.ability.cry_multiuse and (card.ability.cry_multiuse > 1) then\n\009card.ability.cry_multiuse = card.ability.cry_multiuse - 1\n\009nc = true\n\009G.cry_muse = true\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if (prev_state == G.STATES.TAROT_PACK or prev_state == G.STATES.PLANET_PACK or",["position"]="before",["payload"]="if G.cry_muse then\n\009G.cry_muse = nil\n\009card.ability.cry_no_sell_value = true\n\009card:set_cost()\n\009delay(0.4)\n\n\009-- i make my own card eval status text :D\n\n\009card:juice_up()\n\009play_sound('generic1')\n\009attention_text({\n\009\009text = format_ui_value(card.ability.cry_multiuse),\n\009\009scale = 1.1,\n\009\009hold = 0.6,\n\009\009major = card,\n\009\009backdrop_colour = G.C.SET[card.config.center.set],\n\009\009align = 'bm',\n\009\009offset = {x = 0, y = 0.2}\n\009})\n\n\009delay(0.8)\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if self.shop then self.shop:remove(); self.shop = nil end",["position"]="at",["payload"]="if self.shop and not G.GAME.USING_CODE then self.shop:remove(); self.shop = nil end",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="ease_background_colour_blind(G.STATES.SHOP)",["position"]="at",["payload"]="if not G.GAME.USING_RUN then ease_background_colour_blind(G.STATES.SHOP) end",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if self.STATE == self.STATES.SELECTING_HAND then",["position"]="before",["payload"]="if G.GAME.USING_RUN then\n\009if not (self.STATE == self.STATES.STANDARD_PACK or self.STATE == self.STATES.BUFFOON_PACK or self.STATE == self.STATES.PLANET_PACK or self.STATE == self.STATES.TAROT_PACK or self.STATE == self.STATES.SPECTRAL_PACK or self.STATE == self.STATES.SMODS_BOOSTER_OPENED) then -- do you are have stupid\n\009\009self.STATE = self.STATES.SHOP\n\009end\n\009if G.GAME.blind then G.GAME.blind:change_colour() end\009-- aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n\009if G.load_cry_runarea then\n\009\009G.cry_runarea = CardArea(\n\009\009\009G.discard.T.x,\n\009\009\009G.discard.T.y,\n\009\009\009G.discard.T.w,\n\009\009\009G.discard.T.h,\n\009\009\009{ type = \"discard\", card_limit = 1e100 }\n\009\009)\n\009\009G.cry_runarea:load(G.load_cry_runarea)\n\009\009G.load_cry_runarea = nil\n\009end\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for i=1, hand_space do --draw cards from deckL",["position"]="before",["payload"]="if not G.GAME.USING_RUN then",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="G.FUNCS.draw_from_hand_to_deck()",["position"]="at",["payload"]="if not G.GAME.USING_RUN then\n\009G.FUNCS.draw_from_hand_to_deck()\nelse\n\009G.FUNCS.draw_from_hand_to_run()\nend",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.FUNCS.draw_from_deck_to_hand = function(e)",["position"]="before",["payload"]="G.FUNCS.draw_from_hand_to_run = function(e)\n\009local hand_count = #G.hand.cards\n\009for i=1, hand_count do --draw cards from deck\n\009\009draw_card(G.hand, G.cry_runarea, i*100/hand_count,'down', nil, nil,  0.08)\n\009end\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="G.shop.alignment.offset.y = -5.3",["position"]="at",["payload"]="if not G.shop then return true end\nG.shop.alignment.offset.y = -5.3",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="-- TARGET: effects after hand evaluation",["position"]="after",["payload"]="G.E_MANAGER:add_event(Event({\n\009func = function()\n\009\009G.GAME.cry_exploit_override = nil\n\009\009return true\n\009end\n}))\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"=[SMODS _ \"src/overrides.lua\"]"},["pattern"]="disp_text = text",["position"]="before",["payload"]="text = G.GAME.cry_exploit_override or text\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if main_end then",["position"]="before",["payload"]="if cfg and cfg.cry_multiuse and not next(SMODS.find_mod(\"Spectrallib\")) then\n\009local loc = {}\n\009localize{type = 'other', key = 'cry_multiuse', nodes = loc, vars = {cfg.cry_multiuse}}\n\009desc_nodes[#desc_nodes+1] = loc[1]\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"tag.lua"},["pattern"]="add_tag(Tag(_context.tag.key))",["position"]="at",["payload"]="\009local tag = Tag(_context.tag.key)\n\009if _context.tag.key == \"tag_cry_rework\" then\n\009\009tag.ability.rework_edition = _context.tag.ability.rework_edition\n\009\009tag.ability.rework_key = _context.tag.ability.rework_key\n\009end\n\009add_tag(tag)\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.GAME.last_hand_played = text",["position"]="after",["payload"]="G.GAME.last_hand_played_cards = {}\nfor i = 1, #G.play.cards do\n\009G.GAME.last_hand_played_cards[i] = G.play.cards[i].sort_id\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="local text,disp_text,poker_hands = G.FUNCS.get_poker_hand_info(self.highlighted)",["position"]="after",["payload"]="local text,disp_text,poker_hands\nif self == G.hand then\n\009local tbl = {}\n\009for i, v in pairs(G.jokers.cards) do\n\009\009if v.base.nominal and v.base.suit then\n\009\009\009tbl[#tbl+1] = v\n\009\009end\n\009end\n\009text,disp_text,poker_hands = G.FUNCS.get_poker_hand_info(Cryptid.table_merge(self.highlighted, tbl))\nelse\n\009text,disp_text,poker_hands = G.FUNCS.get_poker_hand_info(self.highlighted)\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="local text,disp_text,poker_hands,scoring_hand,non_loc_disp_text = G.FUNCS.get_poker_hand_info(G.play.cards)",["position"]="after",["payload"]="local tbl = {}\nfor i, v in pairs(G.jokers.cards) do\n\009if v.base.nominal and v.base.suit then\n\009\009tbl[#tbl+1] = v\n\009end\nend\nlocal text,disp_text,poker_hands,scoring_hand,non_loc_disp_text = G.FUNCS.get_poker_hand_info(Cryptid.table_merge(G.play.cards, tbl))\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="local text = {ref_table = args.ref_table, ref_value = args.ref_value, letters = {}, current_position = string.len(args.ref_table[args.ref_value])}",["position"]="at",["payload"]="local text = {ref_table = args.ref_table, ref_value = args.ref_value, letters = {}, current_position = string.len(args.ref_table[args.ref_value] or \"\")}\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="      UIBox_button({button = 'your_collection_enhancements', label = {localize('b_enhanced_cards')}, minw = 5}),\n      UIBox_button({button = 'your_collection_seals', label = {localize('b_seals')}, minw = 5, id = 'your_collection_seals'}),\n      UIBox_button({button = 'your_collection_editions', label = {localize('b_editions')}, count = G.DISCOVER_TALLIES.editions, minw = 5, id = 'your_collection_editions'}),\n",["position"]="at",["payload"]="      enhanced,\n      seals,\n      editions,\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="      local t = create_UIBox_generic_options({ back_func = G.STAGE == G.STAGES.RUN and 'options' or 'exit_overlay_menu', contents = {\n",["position"]="before",["payload"]="\009local use_pointer = G.GAME.USING_POINTER or G.GAME.POINTER_COLLECTION\n\009local enhanced = (not use_pointer and UIBox_button({button = 'your_collection_enhancements', label = {localize('b_enhanced_cards')}, minw = 5}))\n\009\009or UIBox_button({button = 'your_collection_create_card_rank', label = {localize('b_playing_cards')}, minw = 5, minh = 3.4, id = 'your_collection_create_card'})\n\009local seals = (not use_pointer and  UIBox_button({button = 'your_collection_seals', label = {localize('b_seals')}, minw = 5, id = 'your_collection_seals'})) or nil\n\009local editions = not use_pointer and UIBox_button({button = 'your_collection_editions', label = {localize('b_editions')}, count = G.DISCOVER_TALLIES.editions, minw = 5, id = 'your_collection_editions'}) or nil\n\n\009local blinds = UIBox_button({button = 'your_collection_blinds', label = {localize('b_blinds')}, count = G.DISCOVER_TALLIES.blinds, minw = 5, minh = (use_pointer and 2.8 or 2.0), id = 'your_collection_blinds', focus_args = {snap_to = true}})\n\009local other = not use_pointer and UIBox_button({button = 'your_collection_other_gameobjects', label = {localize('k_other')}, minw = 5, id = 'your_collection_other_gameobjects', focus_args = {snap_to = true}}) or nil\n\n\009local decks = not use_pointer and UIBox_button({button = 'your_collection_decks', label = {localize('b_decks')}, count = G.DISCOVER_TALLIES.backs, minw = 5}) or nil\n\009local vouchers = UIBox_button({button = 'your_collection_vouchers', label = {localize('b_vouchers')}, count = G.DISCOVER_TALLIES.vouchers, minw = 5, id = 'your_collection_vouchers', minh = use_pointer and 2.0})\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="UIBox_button({button = 'your_collection_blinds', label = {localize('b_blinds')}, count = G.DISCOVER_TALLIES.blinds, minw = 5, minh = 2.0, id = 'your_collection_blinds', focus_args = {snap_to = true}}),UIBox_button({button = 'your_collection_other_gameobjects', label = {localize('k_other')}, minw = 5, id = 'your_collection_other_gameobjects', focus_args = {snap_to = true}}),\n",["position"]="at",["payload"]="      blinds,\n\009  other\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="      UIBox_button({button = 'your_collection_decks', label = {localize('b_decks')}, count = G.DISCOVER_TALLIES.backs, minw = 5}),\n      UIBox_button({button = 'your_collection_vouchers', label = {localize('b_vouchers')}, count = G.DISCOVER_TALLIES.vouchers, minw = 5, id = 'your_collection_vouchers'}),\n",["position"]="at",["payload"]="      decks,\n\009  vouchers,\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"=[SMODS _ \"src/overrides.lua\"]"},["pattern"]="\009\009if v.discovered and not v.alerted then\n\009\009\009blinds_to_be_alerted[#blinds_to_be_alerted + 1] = card\n\009\009end\n",["position"]="at",["payload"]="    \009if v.discovered and not v.alerted then\n\009\009\009blinds_to_be_alerted[#blinds_to_be_alerted + 1] = card\n\009\009end\n\009\009card.click = function()\n\009\009\009if G.GAME.USING_POINTER then\n\009\009\009\009local self = v\n\009\009\009\009local b = self\n\009\009\009\009if not b.no_doe and not b.hidden and not b.no_pointer then\n\009\009\009\009\009local bl = \"Boss\"\n\009\009\009\009\009G.GAME.round_resets.blind_choices[bl] = b.key\n\009\009\009\009\009if G.blind_select or G.GAME.blind_on_deck ~= \"Boss\" then        \n\009\009\009\009\009\009if G.blind_select then\n\009\009\009\009\009\009\009G.blind_select:remove()\n\009\009\009\009\009\009\009G.blind_prompt_box:remove()\n\009\009\009\009\009\009\009G.STATE_COMPLETE = false\n\009\009\009\009\009\009end\n\009\009\009\009\009else\n\009\009\009\009\009\009G.GAME.blind:disable()\n\009\009\009\009\009\009G.GAME.blind:set_blind(G.P_BLINDS[b.key])\n\009\009\009\009\009end\n\009\009\009\009\009G.FUNCS.exit_overlay_menu_code()\n\009\009\009\009\009if G.GAME.CODE_DESTROY_CARD then\n\009\009\009\009\009\009G.GAME.CODE_DESTROY_CARD:start_dissolve()\n\009\009\009\009\009\009G.GAME.CODE_DESTROY_CARD = nil\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009end\n\009\009end\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"=[SMODS _ \"src/overrides.lua\"]"},["pattern"]="\009for k, _hand in pairs(SMODS.PokerHands) do\n\009\009results[k] = _hand.evaluate(parts, hand) or {}\n\009end\n",["position"]="after",["payload"]="\009local hands = {\n\009\009G.GAME.hands.cry_Declare0,\n\009\009G.GAME.hands.cry_Declare1,\n\009\009G.GAME.hands.cry_Declare2,\n\009}\n\009for i, v in pairs(hands) do\n\009\009if v.index then\n\009\009\009local is_this_hand = true\n\009\009\009local cards = {}\n\009\009\009if v.declare_cards then\n\009\009\009\009local satisfied = true\n\009\009\009\009for i, v in pairs(v.declare_cards) do\n\009\009\009\009\009local rank\n\009\009\009\009\009local suit\n\009\009\009\009\009for i2, v2 in pairs(hand) do\n\009\009\009\009\009\009if not v2.canfit then\n\009\009\009\009\009\009\009if SMODS.has_no_rank(v2) and v.rank == \"rankless\" or v2:get_id() == v.rank then \n\009\009\009\009\009\009\009\009if v2:is_suit(v.suit) or (v.suit == \"suitless\" and SMODS.has_no_suit(v2)) or not v.suit then\n\009\009\009\009\009\009\009\009\009v2.canfit = true\n\009\009\009\009\009\009\009\009end\n\009\009\009\009\009\009\009end\n\009\009\009\009\009\009end\n\009\009\009\009\009\009if not v2.marked and not (suit and rank) then\n\009\009\009\009\009\009\009if SMODS.has_no_rank(v2) and v.rank == \"rankless\" or v2:get_id() == v.rank then rank = true end\n\009\009\009\009\009\009\009if v2:is_suit(v.suit) or (v.suit == \"suitless\" and SMODS.has_no_suit(v2)) or not v.suit then suit = true end\n\009\009\009\009\009\009\009if not (suit and rank) then\n\009\009\009\009\009\009\009\009suit = false\n\009\009\009\009\009\009\009\009rank = false\n\009\009\009\009\009\009\009end\n\009\009\009\009\009\009\009if suit and rank then\n\009\009\009\009\009\009\009\009cards[#cards+1] = v2\n\009\009\009\009\009\009\009\009v2.marked = true\n\009\009\009\009\009\009\009end\n\009\009\009\009\009\009end\n\009\009\009\009\009end\n\009\009\009\009\009if not rank or not suit then satisfied = false end\n\009\009\009\009end\n\009\009\009\009for i2, v2 in pairs(hand) do\n\009\009\009\009\009v2.marked = false\n\009\009\009\009\009if v2.canfit then\n\009\009\009\009\009\009cards[#cards+1] = v2\n\009\009\009\009\009\009v2.canfit = nil\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009\009if not satisfied then is_this_hand = false end\n\009\009\009end\n\009\009\009if is_this_hand then\n\009\009\009\009key = \"cry_Declare\"..tostring(v.index)\n\009\009\009\009local tbl = {cards}\n\009\009\009\009local skey = ({\n\009\009\009\009\009[0] = \"Straight\",\n\009\009\009\009\009[1] = \"Flush\",\n\009\009\009\009\009[2] = \"Full House\"\n\009\009\009\009})[v.index]\n\009\009\009\009results[key] = tbl\n\009\009\009\009results[skey] = tbl\n\009\009\009\009if skey == \"Full House\" then\n\009\009\009\009\009results[\"Three of a Kind\"] = tbl\n\009\009\009\009\009results[\"Two Pair\"] = tbl\n\009\009\009\009\009results[\"Pair\"] = tbl\n\009\009\009\009end\n\009\009\009\009results.top = tbl\n\009\009\009else\n\009\009\009\009key = \"cry_Declare\"..tostring(v.index)\009\009\009\n\009\009\009\009results[key] = {}\n\009\009\009end\n\009\009end\n\009end\n\009if not results[\"cry_Declare0\"] then results[\"cry_Declare0\"] = {} end\n\009if not results[\"cry_Declare1\"] then results[\"cry_Declare1\"] = {} end\n\009if not results[\"cry_Declare2\"] then results[\"cry_Declare2\"] = {} end\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"=[SMODS _ \"src/overrides.lua\"]"},["pattern"]="for k, v in pairs(SMODS.PokerHands[key]) do\n",["position"]="at",["payload"]="for k, v in pairs(SMODS.PokerHands[key] or {}) do\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="                    for k, v in pairs(G.P_CENTER_POOLS.Planet) do\n                        if v.config.hand_type == G.GAME.last_hand_played then\n                            _planet = v.key\n                        end\n                    end\n",["position"]="after",["payload"]="if (G.GAME.last_hand_played == \"cry_Declare0\" or G.GAME.last_hand_played == \"cry_Declare1\" or G.GAME.last_hand_played == \"cry_Declare2\") and Cryptid.enabled(\"c_cry_voxel\") == true then\n\009_planet = \"c_cry_voxel\"\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="table.sort(self.cards, function (a, b) return a.T.x + a.T.w/2 - 100*((a.pinned and not a.ignore_pinned) and a.sort_id or 0) < b.T.x + b.T.w/2 - 100*((b.pinned and not b.ignore_pinned) and b.sort_id or 0) end)",["position"]="at",["payload"]="if not G.GAME.modifiers.cry_conveyor and not G.GAME.cry_fastened then table.sort(self.cards, function (a, b) return a.T.x + a.T.w/2 - 100*((a.pinned and not a.ignore_pinned) and a.sort_id or 0) < b.T.x + b.T.w/2 - 100*((b.pinned and not b.ignore_pinned) and b.sort_id or 0) end) end",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.GAME.blind:set_blind(G.GAME.round_resets.blind)",["position"]="after",["payload"]="if G.GAME.modifiers.cry_conveyor and #G.jokers.cards>0 then\n    local duplicated_joker = copy_card(G.jokers.cards[#G.jokers.cards])\n    duplicated_joker:add_to_deck()\n    G.jokers:emplace(duplicated_joker)\n    G.jokers.cards[1]:start_dissolve()\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="G.shop_booster.T.y, G.CARD_W*1.27, G.CARD_H*1.27, G.P_CARDS.empty, G.P_CENTERS[G.GAME.current_round.used_packs[i]], {bypass_discovery_center = true, bypass_discovery_ui = true})",["position"]="at",["payload"]="G.shop_booster.T.y, G.CARD_W*(G.P_CENTERS[G.GAME.current_round.used_packs[i]].set == 'Booster' and 1.27 or 1), G.CARD_H*(G.P_CENTERS[G.GAME.current_round.used_packs[i]].set == 'Booster' and 1.27 or 1), G.P_CARDS.empty, G.P_CENTERS[G.GAME.current_round.used_packs[i]], {bypass_discovery_center = true, bypass_discovery_ui = true})",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card_character.lua"},["pattern"]="self.children.card = Card(self.T.x, self.T.y, G.CARD_W, G.CARD_H, G.P_CARDS.empty, args.center or G.P_CENTERS.j_joker, {bypass_discovery_center = true})",["position"]="at",["payload"]="self.children.card = Card(self.T.x, self.T.y, G.CARD_W, G.CARD_H, G.P_CARDS.empty, args.center or G.P_CENTERS.j_jolly, {bypass_discovery_center = true})",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card_character.lua"},["pattern"]="colours = {G.C.RED, G.C.BLUE, G.C.ORANGE},",["position"]="at",["payload"]="colours = {G.C.CRY_EXOTIC, G.C.BLUE, G.C.CRY_JOLLY},",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="self:load_profile(G.SETTINGS.profile or 1)",["position"]="before",["payload"]="Cryptid.profile_prefix = \"M\"\nif type(G.SETTINGS.profile) ~= \"string\" or G.SETTINGS.profile:sub(1, #Cryptid.profile_prefix) ~= Cryptid.profile_prefix then\n    G.SETTINGS.profile = Cryptid.profile_prefix .. \"1\"\nend\nfor i = 1, 3 do\n    G.PROFILES[Cryptid.profile_prefix .. i] = {}\nend",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="profile_data.name = profile_data.name or (\"P\".._profile)",["position"]="at",["payload"]="profile_data.name = profile_data.name or (_profile)",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="G.PROFILES[G.SETTINGS.profile].name = \"P\"..G.SETTINGS.profile",["position"]="at",["payload"]="G.PROFILES[G.SETTINGS.profile].name = G.SETTINGS.profile",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="for i = 1, 3 do",["position"]="after",["payload"]="i = Cryptid.profile_prefix .. i",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.C, config={align = \"cl\", minw = rwidth}, nodes={{n=G.UIT.T, config={text = tostring(profile_data.career_stats.c_wins),colour = G.C.RED, shadow = true, scale = 1*scale}}}}",["position"]="after",["payload"]=",{n=G.UIT.C, config={align = \"cl\", minw = rwidth}, nodes={{n=G.UIT.O, config={object = Cryptid.gameset_sprite(1, _profile)}}}}",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.C, config={align = \"cm\", minw = 2.5}, nodes={}}",["position"]="at",["payload"]="{n=G.UIT.C, config={align = \"cm\", minw = 0.2}, nodes={}},{n=G.UIT.C, config={align = \"cl\", minw = rwidth}, nodes={{n=G.UIT.O, config={object = Cryptid.gameset_sprite()}}}}",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.R, config={align = \"cm\", minh = 0.4, minw = 0.1}, nodes={}},",["position"]="at",["payload"]="{n=G.UIT.R, config={align = \"cm\", minh = 0.1, minw = 0.1}, nodes={}},",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="not show_win_cta and {n=G.UIT.R, config={align = \"cm\", minh = 0.2, minw = 0.1}, nodes={}} or nil,",["position"]="at",["payload"]="not show_win_cta and {n=G.UIT.R, config={align = \"cm\", minh = 0.1, minw = 0.1}, nodes={}} or nil,",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="not show_win_cta and UIBox_button({button = 'go_to_menu', label = {localize('b_main_menu')}, minw = 2.5, maxw = 2.5, minh = 1, focus_args = {nav = 'wide'}}) or nil,",["position"]="after",["payload"]="{n=G.UIT.R, config={align = \"cm\", minw = rwidth}, nodes={{n=G.UIT.O, config={object = Cryptid.gameset_sprite()}}}},",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="show_lose_cta and",["position"]="before",["payload"]="{n=G.UIT.R, config={align = \"cm\"}, nodes={{n=G.UIT.C, config={align = \"cm\", minw = rwidth}, nodes={{n=G.UIT.O, config={object = Cryptid.gameset_sprite()}}}},",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.T, config={text = localize('b_main_menu'), scale = 0.5, colour = G.C.UI.TEXT_LIGHT}}",["position"]="after",["payload"]="}}",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="local info_queue = {}",["position"]="after",["payload"]="if _c.cry_disabled or (_c.force_gameset and _c.force_gameset == 'disabled') then\n    if _c.cry_disabled then\n        if _c.cry_disabled.type == \"card_dependency\" then\n            local name = Cryptid.get_center(_c.cry_disabled.key) and localize{type = 'name_text', set = Cryptid.get_center(_c.cry_disabled.key).set, key = _c.cry_disabled.key} or _c.cry_disabled.key\n            info_queue[#info_queue+1] = {key = 'disabled_card_dependency', set = 'Other', specific_vars = {name}}\n        elseif _c.cry_disabled.type == \"mod_dependency\" then\n            local name = Cryptid.cross_mod_names[_c.cry_disabled.key] or _c.cry_disabled.key\n            info_queue[#info_queue+1] = {key = 'disabled_mod_dependency', set = 'Other', specific_vars = {name}}\n        elseif _c.cry_disabled.type == \"mod_conflict\" then\n            local name = SMODS.Mods[_c.cry_disabled.key].name\n            info_queue[#info_queue+1] = {key = 'disabled_mod_conflict', set = 'Other', specific_vars = {name}}\n        else\n            if not (_c.force_gameset and _c.force_gameset ~= 'disabled') then\n                info_queue[#info_queue+1] = {key = 'disabled', set = 'Other'}\n            end\n        end\n    else\n        info_queue[#info_queue+1] = {key = 'disabled', set = 'Other'}\n    end\nend",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="card_type = (debuffed and AUT.card_type ~= 'Enhanced') and localize('k_debuffed') or card_type",["position"]="after",["payload"]="if AUT.card_type == \"Back\" then\n    card_type = localize('b_deck')\nend\nif AUT.card_type == \"Tag\" then\n    card_type = localize('b_tag')\nend\nif AUT.card_type == \"Blind\" then\n    card_type = localize('b_blind')\nend\nif AUT.card_type == \"Content Set\" then\n    card_type = localize('k_content_set')\nend\nif card.gameset_select then\n    card_type = localize('cry_gameset_'..card.config.center.force_gameset)\n    if card_type == \"ERROR\" then\n        card_type = localize('cry_gameset_custom')\n    end\nend\nif not card.gameset_select and card.config.center and card.config.center.cry_disabled then\n    card_type = localize('cry_gameset_disabled')\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif _c.set == 'Tag' then",["position"]="before",["payload"]="elseif _c.set == 'Back' or _c.set == 'Blind' then localize{type = 'descriptions', key = _c.key, set = _c.set, nodes = desc_nodes, vars = specific_vars or {}}",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if _c.specific_vars then specific_vars = _c.specific_vars end",["position"]="before",["payload"]="if _c.plua_extra then main_start = _c.plua_extra end\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="SC = Card(G.ROOM.T.w/2 - SC_scale*G.CARD_W/2, 10. + G.ROOM.T.h/2 - SC_scale*G.CARD_H/2, SC_scale*G.CARD_W, SC_scale*G.CARD_H, G.P_CARDS.empty, G.P_CENTERS['j_joker'])",["position"]="after",["payload"]="if ((Cryptid_config and Cryptid_config.menu) or false) then\n\009SC = Card(G.ROOM.T.w/2 - SC_scale*G.CARD_W/2, 10. + G.ROOM.T.h/2 - SC_scale*G.CARD_H/2, SC_scale*G.CARD_W, SC_scale*G.CARD_H, G.P_CARDS.empty, G.P_CENTERS['j_jolly'],{bypass_discovery_center = true, bypass_discovery_ui = true})\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if math.random() > 0.8 then card.sprite_facing = 'back'; card.facing = 'back' end",["position"]="before",["payload"]="--if Cryptid.random_consumable then card:set_ability(Cryptid.random_consumable('cry_splash',{\"no_grc\"},nil,nil,true), true, nil) end\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.config.center.soul_pos and (self.config.center.discovered or self.bypass_discovery_center) then",["position"]="after",["payload"]="if self.config.center.soul_pos and self.config.center.soul_pos.extra and (self.config.center.discovered or self.bypass_discovery_center) then\n    local scale_mod = 0.07-- + 0.02*math.cos(1.8*G.TIMERS.REAL) + 0.00*math.cos((G.TIMERS.REAL - math.floor(G.TIMERS.REAL))*math.pi*14)*(1 - (G.TIMERS.REAL - math.floor(G.TIMERS.REAL)))^3\n    local rotate_mod = 0--0.05*math.cos(1.219*G.TIMERS.REAL) + 0.00*math.cos((G.TIMERS.REAL)*math.pi*5)*(1 - (G.TIMERS.REAL - math.floor(G.TIMERS.REAL)))^2\n    self.children.floating_sprite2:draw_shader('dissolve',0, nil, nil, self.children.center,scale_mod, rotate_mod,nil, 0.1--[[ + 0.03*math.cos(1.8*G.TIMERS.REAL)--]],nil, 0.6)\n    self.children.floating_sprite2:draw_shader('dissolve', nil, nil, nil, self.children.center, scale_mod, rotate_mod)\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="{card_limit = 500, type = 'discard'})",["position"]="at",["payload"]="{card_limit = 1e308, type = 'discard'})",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="function CardArea:align_cards()",["position"]="after",["payload"]="    if self.config.type == 'hand' then\n        self.config.temp_limit = math.min(self.config.card_limit, #G.playing_cards)\n    end\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if not G.SAVED_GAME.VERSION or G.SAVED_GAME.VERSION < '0.9.2' then",["position"]="at",["payload"]="if not G.SAVED_GAME or not G.SAVED_GAME.VERSION or G.SAVED_GAME.VERSION < '0.9.2' then",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="text = extra.message or text",["position"]="after",["payload"]="if not text or text == '' then return end",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="else _pool[#_pool + 1] = \"j_joker\"",["position"]="before",["payload"]="elseif _type == 'Consumeables' then _pool[#_pool + 1] = \"c_ceres\"",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="function Game:update_draw_to_hand(dt)",["position"]="after",["payload"]="if G.GAME.selected_back and (G.GAME.selected_back.name == 'cry--Negative Deck' or G.GAME.selected_back.name == 'cry-Antimatter') and G.hand.config.card_limit <= 0 then\009-- 'cry--Negative Deck'... sure\n\009G.hand.config.card_limit = 1\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"main.lua"},["pattern"]="function love.load()",["position"]="before",["payload"]="Cryptid = {}\nCryptid.aliases = {}\nCryptid.pointerblist = {}\nCryptid.pointerblistrarity = {}\nCryptid.mod_gameset_whitelist = {}\nCryptid.ascension_numbers = {}\n\nCryptid.pin_debuff = {}\nCryptid.circus_rarities = {\n\009--format {base_mult = ..., loc_key = ..., rarity=..., order=...}\n}\n\nfunction cry_format(...)\n\009return ...\nend\n\n-- These ones are deprecated, they do not do anything and are just here to prevent crashes\nCryptid.memepack = {}\nCryptid.food = {}\nCryptid.M_jokers = {}\nCryptid.Megavouchers = {}\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="    check_for_unlock({type = 'have_edition'})\nend\n",["position"]="after",["payload"]="if G.deck then\n\009SMODS.calculate_context{cry_creating_card = true, card = card}\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="assembled_string = assembled_string..(type(subpart) == 'string' and subpart or format_ui_value(args.vars[tonumber(subpart[1])]) or 'ERROR')\n",["position"]="at",["payload"]="assembled_string = assembled_string..(type(subpart) == 'string' and subpart or (Cryptid.pluralize and Cryptid.pluralize(subpart[1], args.vars)) or format_ui_value(args.vars[tonumber(subpart[1])]) or 'ERROR')\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"=[SMODS _ \"src/utils.lua\"]"},["pattern"]="assembled_string = assembled_string..(type(subpart) == 'string' and subpart or format_ui_value(args.vars[tonumber(subpart[1])]) or 'ERROR')\n",["position"]="at",["payload"]="assembled_string = assembled_string..(type(subpart) == 'string' and subpart or (Cryptid.pluralize and Cryptid.pluralize(subpart[1], args.vars)) or format_ui_value(args.vars[tonumber(subpart[1])]) or 'ERROR')\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="for i = self.ability.extra.min, self.ability.extra.max do\n    r_mults[#r_mults+1] = tostring(i)\nend\n",["position"]="at",["payload"]="if self.ability.extra.max - self.ability.extra.min < 500 then\n\009for i = self.ability.extra.min, self.ability.extra.max do\n\009    r_mults[#r_mults+1] = tostring(i)\n\009end\nelse\n\009for i = 1, 50 do\n\009\009r_mults[#r_mults+1] = tostring(math.random(self.ability.extra.min, self.ability.extra.max))\n\009end\nend\n\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="if keep then",["position"]="before",["payload"]="if G.GAME and G.GAME.cry_banned_pcards and G.GAME.cry_banned_pcards[k] then\n\009keep = false\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"=[SMODS _ \"src/game_object.lua\"]"},["pattern"]="self.full_path = (self.mod and self.mod.path or SMODS.path) ..",["position"]="at",["payload"]="self.full_path = (self.mod_path or self.mod and self.mod.path or SMODS.path) ..",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="card.T.x = self.T.x",["position"]="before",["payload"]="local edi = self.edition or {}\nif edi.type then\n\009if card.ability.name ~= \"cry-meteor\"\n \009and card.ability.name ~= \"cry-exoplanet\"\n  \009and card.ability.name ~= \"cry-stardust\" then\n\009\009card:set_edition({[edi.type] = true})\n  \009end\nend\nlocal stickers = {'eternal', 'perishable', 'rental', 'banana'}\nfor _, v in ipairs(stickers) do\n\009if self.ability[v] then\n\009\009card.ability[v] = self.ability[v]\n\009end\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="G.vouchers:emplace(card_to_save)",["position"]="before",["payload"]="card_to_save.ability.extra = self and self.ability.extra or card_to_save.ability.extra\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="if v.eternal then card:set_eternal(true) end",["position"]="before",["payload"]="if v.stickers then\n\009for i, _v in ipairs(v.stickers) do\n\009\009SMODS.Stickers[_v]:apply(card, true)\n\009end\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if v.eternal then _joker:set_eternal(true) end",["position"]="before",["payload"]="if v.stickers then\n\009for i, _v in ipairs(v.stickers) do\n\009\009SMODS.Stickers[_v]:apply(_joker, true)\n\009end\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.eternal then badges[#badges + 1] = 'eternal' end",["position"]="at",["payload"]="if not self.ability.cry_absolute then\n\009if self.ability.eternal then badges[#badges + 1] = 'eternal' end\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.pinned then badges[#badges + 1] = 'pinned_left' end",["position"]="at",["payload"]="-- if self.pinned then badges[#badges + 1] = 'pinned_left' end\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.perishable then",["position"]="at",["payload"]="if self.ability.perishable and not layer then",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability and self.ability.perma_debuff then self.debuff = true end",["position"]="after",["payload"]="if self.cry_debuff_immune then\n\009self.debuff = false\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"=[SMODS _ \"src/utils.lua\"]"},["pattern"]="-- TARGET: effects after end of round evaluation",["position"]="after",["payload"]="card.cry_debuff_immune = false\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"=[SMODS _ \"src/card_draw.lua\"]"},["pattern"]="self.children.back:draw_shader('dissolve')",["position"]="at",["payload"]="local currentBack = self.params.viewed_back and G.GAME.viewed_back or G.GAME.selected_back\nif currentBack and currentBack.effect.config.cry_antimatter or currentBack.effect.config.cry_force_edition == 'negative' then\n    self.children.back:draw_shader('negative', nil, self.ARGS.send_to_shader)\n    self.children.center:draw_shader('negative_shine', nil, self.ARGS.send_to_shader)\nelse\n    self.children.back:draw_shader('dissolve')\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"=[SMODS _ \"src/card_draw.lua\"]"},["pattern"]="if self.sticker and G.shared_stickers[self.sticker] then",["position"]="before",["payload"]="if not Cryptid.shared_gamesets and G.ASSET_ATLAS[\"cry_gameset\"] then\n    Cryptid.shared_gamesets = {\n        modest = Sprite(0, 0, G.CARD_W, G.CARD_H, G.ASSET_ATLAS[\"cry_gameset\"], {x = 0,y = 0}),\n        mainline = Sprite(0, 0, G.CARD_W, G.CARD_H, G.ASSET_ATLAS[\"cry_gameset\"], {x = 1,y = 0}),\n        madness = Sprite(0, 0, G.CARD_W, G.CARD_H, G.ASSET_ATLAS[\"cry_gameset\"], {x = 2,y = 0}),\n        custom = Sprite(0, 0, G.CARD_W, G.CARD_H, G.ASSET_ATLAS[\"cry_gameset\"], {x = 3,y = 0}),\n        selected = Sprite(0, 0, G.CARD_W, G.CARD_H, G.ASSET_ATLAS[\"cry_sticker\"], {x = 0,y = 4}),\n    }\nend\nlocal gameset_key\nif self.config.center.force_gameset then\n    gameset_key = self.config.center.force_gameset\n    if gameset_key ~= \"disabled\" and gameset_key ~= \"modest\" and gameset_key ~= \"mainline\" and gameset_key ~= \"madness\" then\n        gameset_key = \"custom\"\n    end\nend\nif self.gameset_select and Cryptid.shared_gamesets[gameset_key] then\nCryptid.shared_gamesets[gameset_key].role.draw_major = self\nCryptid.shared_gamesets[gameset_key]:draw_shader('dissolve', nil, nil, nil, self.children.center)\nCryptid.shared_gamesets[gameset_key]:draw_shader('voucher', nil, self.ARGS.send_to_shader, nil, self.children.center)\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"=[SMODS _ \"src/card_draw.lua\"]"},["pattern"]="if self.debuff then",["position"]="at",["payload"]="if self.debuff or (Cryptid.gameset and Cryptid.gameset(self) == 'disabled') or (self.config.center.gameset_config and self.config.center.gameset_config[Cryptid.gameset(self)] and self.config.center.gameset_config[Cryptid.gameset(self)].disabled) or (self.config.center.cry_disabled and not self.gameset_select) then",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"=[SMODS _ \"src/card_draw.lua\"]"},["pattern"]="if (self.edition and self.edition.negative) or (self.ability.name == 'Antimatter' and (self.config.center.discovered or self.bypass_discovery_center)) then",["position"]="at",["payload"]="if (self.edition and (self.edition.negative or self.edition.cry_oversat)) or (self.ability.name == 'Antimatter' and (self.config.center.discovered or self.bypass_discovery_center)) then",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"engine/node.lua"},["pattern"]="if self.children.h_popup then",["position"]="at",["payload"]="if self.children.h_popup and not (self.force_popup and self:force_popup() and Cryptid[\"force_tooltips\"]) then\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="detailed_tooltip = part.control.T and (G.P_CENTERS[part.control.T] or G.P_TAGS[part.control.T]) or nil,",["position"]="at",["payload"]="detailed_tooltip = part.control.T and (Cryptid.get_center(part.control.T) or (G.P_CENTERS[part.control.T] or G.P_TAGS[part.control.T])) or nil,",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.highlighted and self.area and self.area.config.type ~= 'shop' then",["position"]="at",["payload"]="if self.highlighted and self.area and self.area.config.type ~= 'shop' and not self.area.config.collection then",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="new_card:set_edition(other.edition or {}, nil, true)",["position"]="before",["payload"]="new_card.from_copy = true\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if not strip_edition then",["position"]="before",["payload"]="if new_card.ability.name == \"cry-longboi\" then new_card:set_ability(new_card.config.center) end\nif new_card.ability.cry_hooked then new_card.ability.cry_hooked = nil end\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.name == 'Campfire' and G.GAME.blind.boss and self.ability.x_mult > 1 then",["position"]="at",["payload"]="if self.ability.name == 'Campfire' and G.GAME.blind.boss and not (G.GAME.blind.config and G.GAME.blind.config.bonus) and to_big(self.ability.x_mult) > to_big(1) then\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.name == 'Hit the Road' and self.ability.x_mult > 1 then",["position"]="at",["payload"]="if self.ability.name == 'Hit the Road' and to_big(self.ability.x_mult) > to_big(1) then\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.x_mult > 1 then",["position"]="at",["payload"]="if to_big(self.ability.x_mult) > to_big(1) then\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.x_mult - self.ability.extra <= 1 then",["position"]="at",["payload"]="if to_big(self.ability.x_mult) - to_big(self.ability.extra) <= to_big(1) then \n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.name ~= 'Seeing Double' and self.ability.x_mult > 1 and (self.ability.type == '' or next(context.poker_hands[self.ability.type])) then",["position"]="at",["payload"]="if self.ability.name ~= 'Seeing Double' and to_big(self.ability.x_mult) > to_big(1) and (self.abi