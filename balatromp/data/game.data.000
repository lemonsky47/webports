me_placeholder = \"Preset name\",\n\n\009\009\009b_handy_notif_quick = \"Quick actions\",\n\009\009\009b_handy_notif_dangerous = \"Dangerous actions\",\n\n\009\009\009b_handy_search_placeholder = \"Search...\",\n\009\009\009b_handy_search = \"Search\",\n\009\009\009b_handy_clear = \"Clear\",\n\009\009\009ph_handy_search_no_results = 'Use keywords like \"more speed\", \"animations\", \"sell\" etc.',\n\n\009\009\009ph_handy_notif_quick_use = \"Quick use\",\n\009\009\009ph_handy_notif_quick_buy_or_sell = \"Quick buy or sell\",\n\009\009\009ph_handy_notif_quick_buy_n_sell = \"Quick buy and immediately sell\",\n\009\009\009ph_handy_notif_unsafe_disabled = \"Unsafe actions disabled in mod settings\",\n\009\009\009ph_handy_notif_unsafe_disabled_by_other_mod = \"Unsafe actions disabled by other mod\",\n\009\009\009ph_handy_notif_unsafe = \"[Unsafe] Bugs can appear!\",\n\009\009\009ph_handy_notif_insta_remove = \"Instant REMOVE\",\n\009\009\009ph_handy_notif_insta_sell = \"Instant sell\",\n\009\009\009ph_handy_notif_remove_all = \"REMOVE ALL cards/tags in clicked area\",\n\009\009\009ph_handy_notif_sell_all = \"Sell ALL cards in clicked area\",\n\009\009\009ph_handy_notif_remove_all_same = \"REMOVE all copies of clicked card/tag\",\n\009\009\009ph_handy_notif_sell_all_same = \"Sell all copies of clicked card\",\n\009\009\009ph_handy_notif_nopeus_unsafe_disabled = \"Unsafe option disabled in mod settings\",\n\009\009\009ph_handy_notif_animation_skip_unsafe_disabled = \"Unsafe option disabled in mod settings\",\n\009\009\009ph_handy_notif_cannot_bind_non_holdable = \"Cannot bind mouse wheel here\",\n\009\009\009ph_handy_notif_cannot_bind_non_safe = \"Cannot bind this button here\",\n\n\009\009\009ph_handy_notif_misc_save_run_start = \"Starting run saving...\",\n\009\009\009ph_handy_notif_misc_save_run_saving = \"Saving a run...\",\n\009\009\009ph_handy_notif_misc_save_run_saved = \"Run saved\",\n\009\009\009ph_handy_notif_misc_save_run_interrupt = \"Cannot save run right now\",\n\n\009\009\009handy_animation_skip_levels = {\n\009\009\009\009[1] = \"None\",\n\009\009\009\009[2] = \"Messages\",\n\009\009\009\009[3] = \"Animations\",\n\009\009\009\009[4] = \"Everything\",\n\009\009\009\009[5] = \"Unsafe\",\n\009\009\009},\n\n\009\009\009b_handy_info_popups_level_select = \"Info popups level\",\n\009\009\009handy_info_popups_level_opt = {\n\009\009\009\009[1] = \"None\",\n\009\009\009\009[2] = \"Dangerous only\",\n\009\009\009\009[3] = \"Features-related\",\n\009\009\009\009[4] = \"All\",\n\009\009\009},\n\009\009\009b_handy_keybinds_trigger_mode_select = \"Keybinds trigger mode\",\n\009\009\009handy_keybinds_trigger_mode_opt = {\n\009\009\009\009[1] = \"On key press\",\n\009\009\009\009[2] = \"On key release\",\n\009\009\009},\n\009\009\009b_handy_buy_sell_use_mode_select = \"Buy/Sell/Use mode\",\n\009\009\009handy_buy_sell_use_mode_opt = {\n\009\009\009\009[1] = \"Hold key + Click card\",\n\009\009\009\009[2] = \"Hover card + Press key\",\n\009\009\009},\n\n\009\009\009b_handy_device_select = \"Input device\",\n\009\009\009handy_device_opt = {\n\009\009\009\009[1] = \"Auto\",\n\009\009\009\009[2] = \"Mouse + Keyboard\",\n\009\009\009\009[3] = \"Gamepad\",\n\009\009\009},\n\009\009},\n\009},\n}\n",["display"]="loc_txt/en-us.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/localization/ru",["source"]="return {\n\009descriptions = {\n\009\009-- For all checkboxes and popups, first var is keybind\n\009\009-- Further mentioned vars starts from #2#\n\009\009Handy_ConfigCheckbox = {\n\009\009\009-- Vars: version, author\n\009\009\009handy = {\n\009\009\009\009unlock = { \"HandyBalatro v#2#\", \"Ð¾Ñ‚ {C:white,E:2,s:1.15}#3#{}\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Ð¡Ð½Ð¸Ð¼Ð¸Ñ‚Ðµ Ð³Ð°Ð»Ð¾Ñ‡ÐºÑƒ Ñ‡Ñ‚Ð¾Ð±Ñ‹ Ð²Ñ‹ÐºÐ»ÑŽÑ‡Ð¸Ñ‚ÑŒ {C:attention}Ð’Ð¡Ð•{} Ñ„ÑƒÐ½ÐºÑ†Ð¸Ð¸ Ð¼Ð¾Ð´Ð°\",\n\009\009\009\009\009\"{C:handy_secondary}(Ð±ÐµÐ· Ð½ÐµÐ¾Ð±Ñ…Ð¾Ð´Ð¸Ð¼Ð¾ÑÑ‚Ð¸ Ð¿ÐµÑ€ÐµÐ·Ð°Ð¿ÑƒÑÐºÐ°Ñ‚ÑŒ Ð¸Ð³Ñ€Ñƒ){}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009hide_options_button = {\n\009\009\009\009unlock = { \"Ð¡Ð¿Ñ€ÑÑ‚Ð°Ñ‚ÑŒ ÐºÐ½Ð¾Ð¿ÐºÑƒ\", \"Ð² Ð¼ÐµÐ½ÑŽ Ð½Ð°ÑÑ‚Ñ€Ð¾ÐµÐº\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"{C:handy_secondary}Ð¢Ð¾Ð»ÑŒÐºÐ¾ ÐµÑÐ»Ð¸ ÑƒÑÑ‚Ð°Ð½Ð¾Ð²Ð»ÐµÐ½ Steamodded{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009debugplus_prevent = {\n\009\009\009\009unlock = { \"DebugPlus:\", \"Ð¿ÐµÑ€ÐµÑ…Ð²Ð°Ñ‚ ÑƒÐ¿Ñ€Ð°Ð²Ð»ÐµÐ½Ð¸Ñ\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"ÐÐµ Ð¸ÑÐ¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÑŒ Ð½Ð°Ð·Ð½Ñ‡ÐµÐ½Ð¸Ñ Handy\",\n\009\009\009\009\009\"Ð¿Ð¾ÐºÐ° ÑƒÐ´ÐµÑ€Ð¶. {C:chips}#2#{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009regular_keybinds = {\n\009\009\009\009unlock = { \"ÐžÑÐ½Ð¾Ð²Ð½Ñ‹Ðµ\", \"Ð½Ð°Ð·Ð½Ð°Ñ‡ÐµÐ½Ð¸Ñ\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Ð˜ÑÐ¿Ð¾Ð»ÑŒÐ·ÑƒÐ¹Ñ‚Ðµ Ð½Ð°Ð·Ð½Ð°Ñ‡ÐµÐ½Ð¸Ñ Ð´Ð»Ñ\",\n\009\009\009\009\009\"Ð¾ÑÐ½Ð¾Ð²Ð½Ñ‹Ñ… Ð¸Ð³Ñ€Ð¾Ð²Ñ‹Ñ… Ð´ÐµÐ¹ÑÑ‚Ð²Ð¸Ð¹\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Left Mouse]\n\009\009\009insta_highlight = {\n\009\009\009\009unlock = {\n\009\009\009\009\009\"{C:edition}Ð‘Ñ‹ÑÑ‚Ñ€Ð¾Ðµ Ð²Ñ‹Ð´ÐµÐ»ÐµÐ½Ð¸Ðµ Ñ€ÑƒÐºÐ¸{}\",\n\009\009\009\009\009\"{C:handy_secondary}(ÑÐ²Ð°Ð¹Ð¿, Ð½Ð°Ð²ÐµÐ´ÐµÐ½Ð¸Ðµ, Ð¿ÐµÑ€ÐµÑ‚Ð°ÑÐºÐ¸Ð²Ð°Ð½Ð¸Ðµ){}\",\n\009\009\009\009},\n\009\009\009\009text = {\n\009\009\009\009\009\"Ð£Ð´ÐµÑ€Ð¶. {C:chips}#1#{} Ð¸\",\n\009\009\009\009\009\"Ð½Ð°Ð²Ð¾Ð´Ð¸Ñ‚ÐµÑÑŒ Ð½Ð° ÐºÐ°Ñ€Ñ‚Ñ‹ Ñ‡Ñ‚Ð¾Ð±Ñ‹ Ð²Ñ‹Ð´ÐµÐ»Ð¸Ñ‚ÑŒ Ð¸Ñ…\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Left Mouse]\n\009\009\009insta_highlight_OUTSIDE = {\n\009\009\009\009unlock = {\n\009\009\009\009\009\"{C:edition}Ð‘Ñ‹ÑÑ‚Ñ€Ð¾Ðµ Ð²Ñ‹Ð´ÐµÐ»ÐµÐ½Ð¸Ðµ Ñ€ÑƒÐºÐ¸{}\",\n\009\009\009\009\009\"{C:handy_secondary}(ÑÐ²Ð°Ð¹Ð¿, Ð½Ð°Ð²ÐµÐ´ÐµÐ½Ð¸Ðµ, Ð¿ÐµÑ€ÐµÑ‚Ð°ÑÐºÐ¸Ð²Ð°Ð½Ð¸Ðµ){}\",\n\009\009\009\009},\n\009\009\009\009text = {\n\009\009\009\009\009\"ÐÐ°Ñ‡Ð½Ð¸Ñ‚Ðµ ÑƒÐ´ÐµÑ€Ð¶. {C:chips}#1#{} {C:attention}ÐÐ ÐŸÐ£Ð¡Ð¢ÐžÐœ ÐœÐ•Ð¡Ð¢Ð•{},\",\n\009\009\009\009\009\"Ð° Ð·Ð°Ñ‚ÐµÐ¼ Ð½Ð°Ð²Ð¾Ð´Ð¸Ñ‚ÐµÑÑŒ Ð½Ð° ÐºÐ°Ñ€Ñ‚Ñ‹ Ñ‡Ñ‚Ð¾Ð±Ñ‹ Ð²Ñ‹Ð´ÐµÐ»Ð¸Ñ‚ÑŒ Ð¸Ñ…\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Fast hand selection]\n\009\009\009insta_unhighlight = {\n\009\009\009\009unlock = {\n\009\009\009\009\009\"Ð‘Ñ‹ÑÑ‚Ñ€Ð¾Ðµ ÑÐ½ÑÑ‚Ð¸Ðµ\",\n\009\009\009\009\009\"Ð²Ñ‹Ð´ÐµÐ»ÐµÐ½Ð¸Ñ\",\n\009\009\009\009},\n\009\009\009\009text = {\n\009\009\009\009\009\"{C:edition}#2#{} Ñ‚Ð°ÐºÐ¶Ðµ\",\n\009\009\009\009\009\"Ð±ÑƒÐ´ÐµÑ‚ Ð¸ ÑÐ½Ð¸Ð¼Ð°Ñ‚ÑŒ Ð²Ñ‹Ð´ÐµÐ»ÐµÐ½Ð¸Ðµ Ñ ÐºÐ°Ñ€Ñ‚\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009show_deck_preview = {\n\009\009\009\009unlock = { \"ÐŸÑ€ÐµÐ´Ð¿Ñ€Ð¾ÑÐ¼Ð¾Ñ‚Ñ€ ÐºÐ¾Ð»Ð¾Ð´Ñ‹\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Ð£Ð´ÐµÑ€Ð¶. {C:chips}#1#{} Ñ‡Ñ‚Ð¾Ð±Ñ‹\",\n\009\009\009\009\009\"Ð¿Ð¾ÐºÐ°Ð·Ð°Ñ‚ÑŒ Ð¿Ñ€ÐµÐ´Ð¿Ñ€Ð¾ÑÐ¼Ð¾Ñ‚Ñ€ ÐºÐ¾Ð»Ð¾Ð´Ñ‹\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Right Mouse]\n\009\009\009deselect_hand = {\n\009\009\009\009unlock = { \"Ð¡Ð½ÑÑ‚ÑŒ Ð²Ñ‹Ð´ÐµÐ»ÐµÐ½Ð¸Ðµ Ñ€ÑƒÐºÐ¸\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"ÐÐ°Ð¶Ð¼Ð¸Ñ‚Ðµ {C:chips}#1#{} Ñ‡Ñ‚Ð¾Ð±Ñ‹\",\n\009\009\009\009\009\"ÑÐ½ÑÑ‚ÑŒ Ð²Ñ‹Ð´ÐµÐ»ÐµÐ½Ð¸Ðµ ÑÐ¾ Ð²ÑÐµÑ… ÐºÐ°Ñ€Ñ‚ Ð² Ñ€ÑƒÐºÐµ\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009insta_cash_out = {\n\009\009\009\009unlock = { \"Ð‘Ñ‹ÑÑ‚Ñ€Ñ‹Ð¹ ÐºÑÑˆÐ°ÑƒÑ‚\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"ÐÐ°Ð¶Ð¼Ð¸Ñ‚Ðµ/ÑƒÐ´ÐµÑ€Ð¶. {C:chips}#1#{} Ñ‡Ñ‚Ð¾Ð±Ñ‹\",\n\009\009\009\009\009\"ÑƒÑÐºÐ¾Ñ€Ð¸Ñ‚ÑŒ ÐºÑÑˆÐ°ÑƒÑ‚ (Ð¿ÐµÑ€ÐµÑ…Ð¾Ð´ Ð² Ð¼Ð°Ð³Ð°Ð·Ð¸Ð½)\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009insta_booster_skip = {\n\009\009\009\009unlock = { \"Ð‘Ñ‹ÑÑ‚Ñ€Ñ‹Ð¹ Ð¿Ñ€Ð¾Ð¿ÑƒÑÐº\", \"Ð±ÑƒÑÑ‚ÐµÑ€Ð½Ñ‹Ñ… Ð½Ð°Ð±Ð¾Ñ€Ð¾Ð²\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"ÐÐ°Ð¶Ð¼Ð¸Ñ‚Ðµ/ÑƒÐ´ÐµÑ€Ð¶. {C:chips}#1#{} Ñ‡Ñ‚Ð¾Ð±Ñ‹\",\n\009\009\009\009\009\"Ð¿Ñ€Ð¾Ð¿ÑƒÑÑ‚Ð¸Ñ‚ÑŒ Ð±ÑƒÑÑ‚ÐµÑ€Ð½Ñ‹Ð¹ Ð½Ð°Ð±Ð¾Ñ€\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009move_highlight = {\n\009\009\009\009unlock = { \"ÐŸÐµÑ€ÐµÐ´Ð²Ð¸Ð¶ÐµÐ½Ð¸Ðµ\", \"Ð²Ñ‹Ð´ÐµÐ»ÐµÐ½Ð¸Ñ\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"ÐÐ°Ð¶Ð¼Ð¸Ñ‚Ðµ {C:chips}#2#{} Ð¸Ð»Ð¸ {C:chips}#3#{}\",\n\009\009\009\009\009\"Ñ‡Ñ‚Ð¾Ð± Ð¿ÐµÑ€ÐµÐ´Ð²Ð¸Ð³Ð°Ñ‚ÑŒ Ð²Ñ‹Ð´ÐµÐ»ÐµÐ½Ð¸Ðµ Ð² Ð¾Ð±Ð»Ð°ÑÑ‚Ð¸.\",\n\009\009\009\009\009\"Ð£Ð´ÐµÑ€Ð¶. {C:chips}#4#{} Ñ‡Ñ‚Ð¾Ð±Ñ‹ Ð´Ð²Ð¸Ð³Ð°Ñ‚ÑŒ ÐºÐ°Ñ€Ñ‚Ñƒ.\",\n\009\009\009\009\009\"Ð£Ð´ÐµÑ€Ð¶. {C:chips}#5#{} Ñ‡Ñ‚Ð¾Ð±Ñ‹ Ð¿ÐµÑ€ÐµÐ´Ð²Ð¸Ð½ÑƒÑ‚ÑŒ Ðº Ð¿ÐµÑ€Ð²Ð¾Ð¹/Ð¿Ð¾ÑÐ»ÐµÐ´Ð½ÐµÐ¹ ÐºÐ°Ñ€Ñ‚Ðµ\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_buy_or_sell = {\n\009\009\009\009unlock = { \"Ð‘Ñ‹ÑÑ‚Ñ€Ð°Ñ Ð¿Ð¾ÐºÑƒÐ¿ÐºÐ°\", \"Ð¸Ð»Ð¸ Ð¿Ñ€Ð¾Ð´Ð°Ð¶Ð°\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Ð˜ÑÐ¿Ð¾Ð»ÑŒÐ·ÑƒÐ¹Ñ‚Ðµ {C:chips}#1#{} Ñ‡Ñ‚Ð¾Ð±Ñ‹\",\n\009\009\009\009\009\"ÐºÑƒÐ¿Ð¸Ñ‚ÑŒ Ð¸Ð»Ð¸ Ð¿Ñ€Ð¾Ð´Ð°Ñ‚ÑŒ ÐºÐ°Ñ€Ñ‚Ñƒ\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_buy_n_sell = {\n\009\009\009\009unlock = { \"Ð‘Ñ‹ÑÑ‚Ñ€Ð°Ñ\", \"Ð¿Ð¾ÐºÑƒÐ¿ÐºÐ°-Ð¸-Ð¿Ñ€Ð¾Ð´Ð°Ð¶Ð°\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Ð˜ÑÐ¿Ð¾Ð»ÑŒÐ·ÑƒÐ¹Ñ‚Ðµ {C:chips}#1#{} Ñ‡Ñ‚Ð¾Ð±Ñ‹\",\n\009\009\009\009\009\"ÐºÑƒÐ¿Ð¸Ñ‚ÑŒ ÐºÐ°Ñ€Ñ‚Ñƒ Ð¸ ÑÑ€Ð°Ð·Ñƒ Ð¶Ðµ\",\n\009\009\009\009\009\"ÐµÑ‘ Ð¿Ñ€Ð¾Ð´Ð°Ñ‚ÑŒ\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_use = {\n\009\009\009\009unlock = { \"Ð‘Ñ‹ÑÑ‚Ñ€Ð¾Ðµ\", \"Ð¸ÑÐ¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ð½Ð¸Ðµ\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Ð˜ÑÐ¿Ð¾Ð»ÑŒÐ·ÑƒÐ¹Ñ‚Ðµ {C:chips}#1#{} Ñ‡Ñ‚Ð¾Ð±Ñ‹\",\n\009\009\009\009\009\"Ð¸ÑÐ¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÑŒ ÐºÐ°Ñ€Ñ‚Ñƒ, ÐµÑÐ»Ð¸ Ð²Ð¾Ð·Ð¼Ð¾Ð¶Ð½Ð¾\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009cryptid_code_use_last_interaction = {\n\009\009\009\009unlock = { \"Cryptid: Ð¸ÑÐ¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÑŒ\", \"Ð¿Ñ€ÐµÐ´Ñ‹Ð´ÑƒÑ‰ÐµÐµ Ð·Ð½Ð°Ñ‡ÐµÐ½Ð¸Ðµ\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Ð˜ÑÐ¿Ð¾Ð»ÑŒÐ·ÑƒÐ¹Ñ‚Ðµ {C:chips}#1#{} Ñ‡Ñ‚Ð¾Ð±Ñ‹\",\n\009\009\009\009\009\"Ð¸ÑÐ¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÑŒ ÐšÐ¾Ð´-ÐºÐ°Ñ€Ñ‚Ñ