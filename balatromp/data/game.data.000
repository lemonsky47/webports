ern"]="func = (function() if eval_func(card) then if not first or first then card:juice_up(0.1, 0.1) end;juice_card_until(card, eval_func, nil, 0.8) end return true end)",["position"]="at",["payload"]="func = (function() if eval_func(card) then if card and card.juice_up then card:juice_up(0.1, 0.1) end;juice_card_until(card, eval_func, nil, 0.8) end return true end)",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="add_round_eval_row({name = 'bottom', dollars = dollars})",["position"]="after",["payload"]="Talisman.dollars = dollars",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="create_option_cycle({label = localize('b_set_gamespeed'),scale = 0.8, options = {0.5, 1, 2, 4}, opt_callback = 'change_gamespeed', current_option = (G.SETTINGS.GAMESPEED == 0.5 and 1 or G.SETTINGS.GAMESPEED == 4 and 4 or G.SETTINGS.GAMESPEED + 1)}),",["position"]="after",["payload"]="Talisman.config_sections.disable_anim(),",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="if v.is and v:is(Object) then ret_t[k] = [[\"]]..\"MANUAL_REPLACE\"..[[\"]]",["position"]="at",["payload"]="if Big and Big.is(v) then ret_t[k] = v:as_table()\nelseif v.is and v:is(Object) then ret_t[k] = [[\"]]..\"MANUAL_REPLACE\"..[[\"]]\n",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"engine/string_packer.lua"},["pattern"]="function STR_PACK(data, recursive)",["position"]="before",["payload"]="local function STR_BIG(v)\n\009local arr, sign, num\n\009if Big and Big.is(v) then\n\009\009arr, sign, num = v:get_array(), v.sign, math.min(v.number, 1e308)\n\009elseif type(v) == \"table\" and v.__talisman then\n\009\009arr, sign, num = v.array, v.sign, v.val\n\009else\n\009\009return\n\009end\n\n\009local arrstr = {}\n\009for i, val in pairs(arr) do\n\009\009table.insert(arrstr, string.format(\"[%s]=%s,\", i, val or 0))\n\009end\n\009return string.format(\"(Big and to_big({%s}, %s) or %s)\", table.concat(arrstr), sign, num)\nend\n",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"engine/string_packer.lua"},["pattern"]="assert((type_i ~= \"table\"), \"Data table cannot have an table as a key reference\")\nif type_i == \"string\" then\n\009i = '['..string.format(\"%q\",i)..']'\nelse\n\009i = \"[\"..i..\"]\"\nend\n",["position"]="at",["payload"]="local bigi = STR_BIG(i)\nif bigi then\n\009i = \"[\"..bigi..\"]\"\nelse\n\009assert((type_i ~= \"table\"), \"Data table cannot have an table as a key reference\")\n\009if type_i == \"string\" then\n\009\009i = '['..string.format(\"%q\",i)..']'\n\009else\n\009\009i = \"[\"..i..\"]\"\n\009end\nend\n",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"engine/string_packer.lua"},["pattern"]="if type_v == \"table\" then",["position"]="at",["payload"]="local bigv = STR_BIG(v)\nif bigv then\n\009v = bigv\nelseif type_v == \"table\" then\n",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if G.FILE_HANDLER.progress then",["position"]="after",["payload"]="G.ARGS.save_progress.PROFILE = Talisman.sanitizer.copy_table(G.ARGS.save_progress.PROFILE, Talisman.sanitizer.copy_for_thread)\n",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if G.FILE_HANDLER.run then",["position"]="after",["payload"]="Talisman.sanitizer.sanitize(G.ARGS.save_run)",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"game.lua"},["pattern"]="save_profile = G.PROFILES[G.SETTINGS.profile]",["position"]="at",["payload"]="save_profile = Talisman.sanitizer.copy_table(G.PROFILES[G.SETTINGS.profile], Talisman.sanitizer.copy_for_thread)",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.FUNCS.evaluate_play = function(e)",["position"]="at",["payload"]="local lim = 7\nG.FUNCS.evaluate_play = function(e)\n\009mult = 0\n\009hand_chips = 0\n\009if SMODS and SMODS.Scoring_Parameters then\n\009\009SMODS.Scoring_Parameters.mult.current = 0\n\009\009SMODS.Scoring_Parameters.chips.current = 0\n\009end\n\n\009local state\n\009local co = Talisman.scoring_coroutine\n\n\009if co then co.state = \"intro\" end\n\009state = {evaluate_play_intro()}\n\009if co then co.astate = state end\n\n\009if not G.GAME.blind:debuff_hand(G.play.cards, state[3], state[1]) then\n\009\009if co then co.state = \"main\" end\n\009\009state = {evaluate_play_main(unpack(state, 1, lim))}\n\009\009if co then co.astate = state end\n\009else\n\009\009if co then co.state = \"debuff\" end\n\009\009state = {evaluate_play_debuff(unpack(state, 1, lim))}\n\009\009if co then co.astate = state end\n\009end\n\n\009if co then co.state = \"final_scoring\" end\n\009state = {evaluate_play_final_scoring(unpack(state, 1, lim))}\n\009if co then co.astate = state end\n\n\009if co then co.state = \"after\" end\n\009evaluate_play_after(unpack(state, 1, lim))\n\n\009if co then co.state = nil end\nend\n\nfunction evaluate_play_intro()\n",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if not G.GAME.blind:debuff_hand(G.play.cards, poker_hands, text) then",["position"]="at",["payload"]="return text, disp_text, poker_hands, scoring_hand, non_loc_disp_text, percent, percent_delta\nend\nfunction evaluate_play_main(text, disp_text, poker_hands, scoring_hand, non_loc_disp_text, percent, percent_delta)\n",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="else\n    mult = mod_mult(0)\n",["position"]="at",["payload"]="return text, disp_text, poker_hands, scoring_hand, non_loc_disp_text, percent, percent_delta\nend\nfunction evaluate_play_debuff(text, disp_text, poker_hands, scoring_hand, non_loc_disp_text, percent, percent_del