pattern",["t"]={"cardarea.lua"},["pattern"]="function CardArea:emplace(card, location, stay_flipped)",["position"]="after",["payload"]="for k, v in pairs(self.cards) do\n\009if v == card then return end\nend\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]=" if area:is(CardArea) then",["position"]="after",["payload"]="local prevent = false\ndo\n\009local _cards = discarded_only and {} or area.cards\n\009local card = nil\n\009if discarded_only then \n\009\009for k, v in ipairs(area.cards) do\n\009\009\009if v.ability and v.ability.discarded then \n\009\009\009\009_cards[#_cards+1] = v\n\009\009\009end\n\009\009end\n\009end\n\009if area.config.type == 'discard' or area.config.type == 'deck' then\n\009\009card = _cards[#_cards]\n\009else\n\009\009card = _cards[1]\n\009end\n\009for k, v in pairs(self.cards) do\n\009\009if v == card then prevent = true; break end\n\009end\nend\nif prevent then return end\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="function draw_card(from, to, percent, dir, sort, card, delay, mute, stay_flipped, vol, discarded_only)",["position"]="after",["payload"]="for k, v in pairs(to.cards) do\n\009if v == card then return end\nend\n",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="regex",["t"]={"tag.lua"},["pattern"]="G\\.GAME\\.orbital_choices\\[G\\.GAME\\.round_resets\\.ante\\]",["position"]="at",["payload"]="G.GAME.orbital_choices[to_number(G.GAME.round_resets.ante)]"},{["mod"]="Amulet",["id"]="Amulet",["k"]="regex",["t"]={"functions/UI_definitions.lua"},["pattern"]="G\\.GAME\\.orbital_choices\\[G\\.GAME\\.round_resets\\.ante\\]",["position"]="at",["payload"]="G.GAME.orbital_choices[to_number(G.GAME.round_resets.ante)]"},{["mod"]="Amulet",["id"]="Amulet",["k"]="regex",["t"]={"functions/UI_definitions.lua"},["pattern"]="\\{\\{ref_table = G.GAME.round_resets, ref_value = '(ante_disp)'\\}\\}",["position"]="after",["payload"]=", maxw = 1.2"},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self.base_cost = center.cost or 1",["position"]="before",["payload"]="self.ability.cry_prob = 1\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="function save_run()",["position"]="before",["payload"]="function cry_prob(owned, den, rigged)\n\009prob = G.GAME and G.GAME.probabilities.normal or 1\n\009if rigged then\n\009\009return to_number(math.min(den, 1e300))\n\009else\n\009\009if owned then return to_number(math.min(prob*owned, 1e300)) else return to_number(math.min(prob, 1e300)) end\n\009end\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="ease_background_colour_blind(G.STATES.ROUND_EVAL)",["position"]="after",["payload"]="if G.GAME.events.ev_cry_choco6 and G.round_eval then return true end",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if G.load_shop_booster then",["position"]="before",["payload"]="if G.GAME.events.ev_cry_choco10 then\n    local add = true\n    for k, v in pairs(G.shop_vouchers.cards) do\009\009-- G.load_shop_vouchers is already set to nil here, just do a normal check\n        if v.ability.cry_antique then add = false end\n    end\n    if add then\n        local card = create_card('Joker', G.jokers, true, nil, nil, nil, nil, 'cry_antique')\n        Cryptid.manipulate(card)\n        card.misprint_cost_fac = 50/card.cost\n        card:set_cost()\n        create_shop_card_ui(card, 'Voucher', G.shop_vouchers)\n        card:start_materialize()\n        card.ability.cry_antique = true\n        G.shop_vouchers.config.card_limit = G.shop_vouchers.config.card_limit + 1\n        G.shop_vouchers:emplace(card)\n    end\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if not card then",["position"]="at",["payload"]="if cfg and not card then\n",["indent"]=true},{["mod"]="Galdur",["id"]="galdur",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self.children.back:draw(overlay)",["position"]="at",["payload"]="if self.params.stake_chip then\n    if self.params.stake_chip_locked then \n        self.children.back:draw(G.C.L_BLACK)\n    elseif self.params.chip_tower then\n        self.children.back:draw(G.C.WHITE)\n    elseif not self.children.back.won then\n        self.children.back:draw(Galdur.config.stake_colour == 1 and G.C.L_BLACK or G.C.WHITE)\n    else\n        self.children.back:draw(Galdur.config.stake_colour == 1 and G.C.WHITE or G.C.L_BLACK)\n    end\nelse\n    self.children.back:draw(overlay)\nend",["indent"]=true},{["mod"]="Galdur",["id"]="galdur",["k"]="pattern",["t"]={"engine/controller.lua"},["pattern"]="if self.hovering.target and self.hovering.target == self.dragging.target and not self.HID.touch then",["position"]="before",["payload"]="if self.hovering.prev_target and self.hovering.prev_target.role and self.hovering.prev_target.role.major and self.hovering.prev_target.role.major.params and self.hovering.prev_target.role.major.params.stake_chip and self.hovering.target ~= self.hovering.prev_target then self.hovering.prev_target.role.major:stop_hover() end\nif self.hovering.target and self.hovering.target.role and self.hovering.target.role.major and self.hovering.target.role.major.params and self.hovering.target.role.major.params.stake_chip and self.hovering.target ~= self.hovering.prev_target then self.hovering.target.role.major:hover() end\n",["indent"]=true},{["mod"]="Galdur",["id"]="galdur",["k"]="pattern",["t"]={"game.lua"},["pattern"]="local selected_back = saveTable and saveTable.BACK.name or (args.challenge and args.challenge.deck and args.challenge.deck.type) or (self.GAME.viewed_back and self.GAME.viewed_back.name) or self.GAME.selected_back and self.GAME.selected_back.name or 'Red Deck'",["position"]="