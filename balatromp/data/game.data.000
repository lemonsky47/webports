09\009loc_key = { \"animation_skip\", \"animation_skip_unsafe\" },\n\009\009keywords = { keyw.unsafe_control, keyw.animation_skip },\n\009\009checkbox = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_new_module_checkbox(\n\009\009\009\009Handy.cc.dangerous_actions.animation_skip_unsafe,\n\009\009\009\009\"animation_skip_unsafe\",\n\009\009\009\009{\n\009\009\009\009\009localize(\"handy_animation_skip_levels\")[5],\n\009\009\009\009},\n\009\009\009\009{\n\009\009\009\009\009dangerous = true,\n\009\009\009\009},\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009},\n\009dangerous_speed_multiplier_uncap = {\n\009\009loc_key = { \"speed_multiplier\", \"speed_multiplier_uncap\" },\n\009\009keywords = { keyw.unsafe_control, keyw.speed_multiplier, \"uncap max speed infinite\" },\n\009\009checkbox = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_new_module_checkbox(\n\009\009\009\009Handy.cc.dangerous_actions.speed_multiplier_uncap,\n\009\009\009\009\"speed_multiplier_uncap\",\n\009\009\009\009nil,\n\009\009\009\009{\n\009\009\009\009\009dangerous = true,\n\009\009\009\009},\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009},\n\009immediate_buy_and_sell = {\n\009\009loc_key = \"immediate_buy_and_sell\",\n\009\009keywords = { keyw.unsafe_control, keyw.sell },\n\009\009checkbox = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_new_module_checkbox(\n\009\009\009\009Handy.cc.dangerous_actions.immediate_buy_and_sell,\n\009\009\009\009\"immediate_buy_and_sell\",\n\009\009\009\009{\n\009\009\009\009\009Handy.UI.PARTS.format_new_module_keys(Handy.cc.insta_buy_or_sell, true),\n\009\009\009\009\009Handy.UI.PARTS.localize_keybind_label(\"dangerous_modifier\"),\n\009\009\009\009\009Handy.UI.PARTS.localize_keybind_label(\"quick_buy_or_sell\"),\n\009\009\009\009},\n\009\009\009\009{\n\009\009\009\009\009dangerous = true,\n\009\009\009\009},\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009\009keybind = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_module_keybind(\n\009\009\009\009Handy.cc.dangerous_actions.immediate_buy_and_sell,\n\009\009\009\009\"dangerous_modifier\",\n\009\009\009\009{ dangerous = true, only_holdable = true },\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009},\n\009immediate_buy_and_sell_queue = {\n\009\009loc_key = \"immediate_buy_and_sell_queue\",\n\009\009keywords = { keyw.unsafe_control, keyw.sell, \"queue\" },\n\009\009checkbox = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_new_module_checkbox(\n\009\009\009\009Handy.cc.dangerous_actions.immediate_buy_and_sell.queue,\n\009\009\009\009\"immediate_buy_and_sell_queue\",\n\009\009\009\009nil,\n\009\009\009\009{\n\009\009\009\009\009dangerous = true,\n\009\009\009\009},\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009},\n\009sell_all_same_modifier = {\n\009\009loc_key = { \"sell_all_same\", \"dangerous_all_same_modifier\" },\n\009\009keywords = { keyw.unsafe_control, keyw.sell, \"all same copies dublicates duplicates card modifier\" },\n\009\009checkbox = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_new_module_checkbox(\n\009\009\009\009Handy.cc.dangerous_actions.sell_all_same,\n\009\009\009\009\"sell_all_same\",\n\009\009\009\009{\n\009\009\009\009\009Handy.UI.PARTS.format_new_module_keys(Handy.cc.dangerous_actions.immediate_buy_and_sell, true),\n\009\009\009\009\009Handy.UI.PARTS.localize_keybind_label(\"dangerous_modifier\"),\n\009\009\009\009\009Handy.UI.PARTS.localize_keybind_label(\"dangerous_all_same_modifier\"),\n\009\009\009\009},\n\009\009\009\009{\n\009\009\009\009\009only_first = true,\n\009\009\009\009\009dangerous = true,\n\009\009\009\009},\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009\009keybind = function(options)\n\009\009\009return Handy.UI.PARTS.create_module_keybind(\n\009\009\009\009Handy.cc.dangerous_actions.sell_all_same,\n\009\009\009\009\"dangerous_all_same_modifier\",\n\009\009\009\009{ dangerous = true, only_holdable = true },\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009},\n\009sell_all_modifier = {\n\009\009loc_key = { \"sell_all\", \"dangerous_all_modifier\" },\n\009\009keywords = { keyw.unsafe_control, keyw.sell, \"everything all everyone modifier cards\" },\n\009\009checkbox = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_new_module_checkbox(Handy.cc.dangerous_actions.sell_all, \"sell_all\", {\n\009\009\009\009Handy.UI.PARTS.localize_keybind_label(\"dangerous_modifier\"),\n\009\009\009\009Handy.UI.PARTS.localize_keybind_label(\"dangerous_all_modifier\"),\n\009\009\009}, {\n\009\009\009\009only_first = true,\n\009\009\009\009dangerous = true,\n\009\009\009}, options)\n\009\009end,\n\009\009keybind = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_module_keybind(\n\009\009\009\009Handy.cc.dangerous_actions.sell_all,\n\009\009\009\009\"dangerous_all_modifier\",\n\009\009\009\009{ dangerous = true, only_holdable = true },\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009},\n\009remove_modifier = {\n\009\009loc_key = { \"card_remove\", \"dangerous_remove_modifier\" },\n\009\009keywords = { keyw.unsafe_control, \"remove modifier skip tags cards\" },\n\009\009checkbox = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_new_module_checkbox(Handy.cc.dangerous_actions.card_remove, \"card_remove\", {\n\009\009\009\009Handy.UI.PARTS.localize_keybind_label(\"dangerous_modifier\"),\n\009\009\009\009Handy.UI.PARTS.localize_keybind_label(\"dangerous_remove_modifier\"),\n\009\009\009\009Handy.UI.PARTS.localize_keybind_label(\"quick_buy_or_sell\"),\n\009\009\009\009Handy.UI.PARTS.localize_keybind_label(\"dangerous_all_same_modifier\"),\n\009\009\009\009Handy.UI.PARTS.localize_keybind_label(\"dangerous_all_modifier\"),\n\009\009\009}, {\n\009\009\009\009dangerous = true,\n\009\009\009\009only_first = true,\n\009\009\009}, options)\n\009\009end,\n\009\009keybind = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_module_keybind(\n\009\009\009\009Handy.cc.dangerous_actions.card_remove,\n\009\009\009\009\"dangerous_remove_modifier\",\n\009\009\009\009{ dangerous = true, only_holdable = true },\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009},\n\n\009misc_crash = {\n\009\009loc_key = \"misc_crash\",\n\009\009keywords = { \"miscellaneous\", \"crash kill a game\" },\n\009\009keybind = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_module_keybind(\n\009\009\009\009Handy.cc.misc.crash,\n\009\009\009\009\"misc_crash\",\n\009\009\009\009{ dangerous = true, only_safe = true },\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009},\n\009misc_open_mod_settings = {\n\009\009loc_key = \"misc_open_mod_settings\",\n\009\009keywords = { \"miscellaneous\", \"open mod handy settings configs options menu shortcut\" },\n\009\009keybind = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_module_keybind(\n\009\009\009\009Handy.cc.misc.open_mod_settings,\n\009\009\009\009\"misc_open_mod_settings\",\n\009\009\009\009nil,\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009},\n\009misc_save_run = {\n\009\009loc_key = \"misc_save_run\",\n\009\009keywords = { \"miscellaneous\", \"save run state\" },\n\009\009keybind = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_module_keybind(Handy.cc.misc.save_run, \"misc_save_run\", nil, options)\n\009\009end,\n\009},\n\009misc_quick_restart = {\n\009\009loc_key = \"misc_quick_restart\",\n\009\009keywords = { \"miscellaneous\", \"quick restart run\" },\n\009\009keybind = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_module_keybind(Handy.cc.misc.quick_restart, \"misc_quick_restart\", nil, options)\n\009\009end,\n\009},\n\009misc_start_fantoms_preview = {\n\009\009loc_key = \"misc_start_fantoms_preview\",\n\009\009keywords = { \"miscellaneous\", \"fantoms score preview calculation calculating\" },\n\009\009keybind = function(options)\n\009\009\009options = options or {}\n\009\009\009return Handy.UI.PARTS.create_module_keybind(\n\009\009\009\009Handy.cc.misc.start_fantoms_preview,\n\009\009\009\009\"misc_start_fantoms_preview\",\n\009\009\009\009nil,\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009},\n\n\009debugplus_prevent = {\n\009\009loc_key = \"debugplus_prevent\",\n\009\009keywords = { \"debugplus debug plus\", \"prevent keybinds\" },\n\009\009checkbox = function(options)\n\009\009\009return Handy.UI.PARTS.create_new_module_checkbox(\n\009\009\009\009Handy.cc.prevent_if_debugplus,\n\009\009\009\009\"debugplus_prevent\",\n\009\009\009\009{ Handy.UI.PARTS.localize_keybind(\"Ctrl\", true) },\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009},\n\n\009controller_swap_cursor_stick = {\n\009\009loc_key = \"controller_swap_cursor_stick\",\n\009\009keywords = { \"controller\", \"swap cursor stick sticks\" },\n\009\009checkbox = function(options)\n\009\009\009return Handy.UI.PARTS.create_new_module_checkbox(\n\009\009\009\009Handy.cc.swap_controller_cursor_stick,\n\009\009\009\009\"controller_swap_cursor_stick\",\n\009\009\009\009nil,\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009},\n\009controller_sensivity = {\n\009\009loc_key = \"controller_sensivity\",\n\009\009keywords = { \"controller\", \"cursor sensivity sensitivity\" },\n\009\009checkbox = function(options)\n\009\009\009return Handy.UI.PARTS.create_new_module_checkbox(\n\009\009\009\009Handy.cc.controller_sensivity,\n\009\009\009\009\"controller_sensivity\",\n\009\009\009\009nil,\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009\009slider = function(options)\n\009\009\009return Handy.UI.PARTS.create_module_slider(\n\009\009\009\009Handy.cc.controller_sensivity,\n\009\009\009\009\"mult\",\n\009\009\009\009\"controller_sensivity\",\n\009\009\009\009nil,\n\009\009\009\009{\n\009\009\009\009\009min = 0.5,\n\009\009\009\009\009max = 2,\n\009\009\009\009\009decimal_places = 2,\n\009\009\009\009\009callback = \"handy_change_controller_sensivity\",\n\009\009\009\009},\n\009\009\009\009options\n\009\009\009)\n\009\009end,\n\009},\n}\n\nlocal dictionary_order = {\n\009-- general\n\009\"handy\",\n\009\"hide_options_button\",\n\009\"info_popups_level\",\n\009\"keybinds_trigger_mode\",\n\009\"device_select\",\n\n\009-- hand\n\009\"insta_highlight\",\n\009\"insta_unhighlight\",\n\009\"insta_highlight_entire_f_hand\",\n\009\"deselect_hand\",\n\n\009-- regular\n\009\"regular_keybinds\",\n\009-- hand\n\009\"regular_keybinds_play_hand\",\n\009\"regular_keybinds_discard\",\n\009\"regular_keybinds_sort_by_rank\",\n\009\"regular_keybinds_sort_by_suit\",\n\009\"regular_keybinds_toggle_sort\",\n\009-- menus\n\009\"regular_keybinds_run_info_hands\",\n\009\"regular_keybinds_run_info_blinds\",\n\009\"regular_keybinds_view_deck\",\n\009\"show_deck_preview\",\n\009-- round\n\009\"insta_cash_out\",\n\009\"not_just_yet_interaction\",\n\009-- shop\n\009\"insta_booster_skip\",\n\009\"regular_keybinds_reroll_shop\",\n\009\"regular_keybinds_leave_shop\",\n\009\"regular_keybinds_reroll_boss\",\n\009-- blinds\n\009\"regular_keybinds_skip_blind\",\n\009\"regular_keybinds_select_blind\",\n\n\009-- quick actions\n\009\"buy_sell_use_mode\",\n\009\"insta_buy_or_sell\",\n\009\"insta_buy_n_sell\",\n\009\"insta_use\",\n\009\"cryptid_code_use_last_interaction\",\n\n\009-- speed multiplier\n\009\"speed_multiplier\",\n\009\"speed_multiplier_multiply\",\n\009\"speed_multiplier_divide\",\n\009\"speed_multiplier_no_hold\",\n\n\009-- animation skip\n\009\"animation_skip\",\n\009\"animation_skip_increase\",\n\009\"animation_skip_decrease\",\n\009\"animation_skip_no_hold\",\n\n\009-- nopeus\n\009\"nopeus_interaction\",\n\009\"nopeus_interaction_increase\",\n\009\"nopeus_interaction_decrease\",\n\009\"nopeus_interaction_no_hold\",\n\n\009-- scoring hold\n\009\"scoring_hold\",\n\009\"scoring_hold_any_moment\",\n\n\009-- controller\n\009\"controller_swap_cursor_stick\",\n\009\"controller_sensivity\",\n\n\009-- presets\n\009\"presets_load_1\",\n\009\"presets_load_2\",\n\009\"presets_load_3\",\n\009\"presets_load_next\",\n\n\009-- move highlight\n\009\"move_highlight\",\n\009\"move_highlight_one_left\",\n\009\"move_highlight_one_right\",\n\009\"move_highlight_move_card\",\n\009\"move_highlight_to_end\",\n\n\009--dangerous\n\009\"dangerous_actions\",\n\009\"dangerous_speed_multiplier_uncap\",\n\009\"dangerous_nopeus_unsafe\",\n\009\"dangerous_animation_skip_unsafe\",\n\009\"immediate_buy_and_sell\",\n\009\"immediate_buy_and_sell_queue\",\n\009\"sell_all_same_modifier\",\n\009\"sell_all_modifier\",\n\009\"remove_modifier\",\n\n\009--misc\n\009\"misc_open_mod_settings\",\n\009\"misc_save_run\",\n\009\"misc_quick_restart\",\n\009\"misc_start_fantoms_preview\",\n\009\"misc_crash\",\n\n\009--other\n\009\"debugplus_prevent\",\n}\n\nfor k, v in pairs(dictionary) do\n\009v.order = 1\n\009v.order_not_set = true\n\009if not v.keywords then\n\009\009v.keywords = {}\n\009end\n\009-- local cleaned_string = string.gsub(k, \"_\", \" \")\n\009-- table.insert(v.keywords, cleaned_string)\n\009v.keywords_list = Handy.utils.string_words_split(Handy.utils.table_concat_string(v.keywords))\nend\n\nfor index, key in ipairs(dictionary_order) do\n\009dictionary[key].order = index\n\009dictionary[key].order_not_set = nil\nend\n\nfor k, v in pairs(dictionary) do\n\009if v.order_not_set then\n\009\009print(\"Order not set for config dictionary: \" .. k)\n\009end\nend\n\n-- Config dictionary\nHandy.UI.CD = dictionary\n\nfunction Handy.UI.cache_config_dictionary_search(only_update)\n\009for k, v in pairs(dictionary) do\n\009\009local temp_keywords = {}\n\n\009\009local function insert_keywords(t)\n\009\009\009for _, word in ipairs(t or {}) do\n\009\009\009\009temp_keywords[string.lower(word)] = true\n\009\009\009end\n\009\009end\n\009\009if not only_update then\n\009\009\009insert_keywords(v.keywords_list or {})\n\009\009end\n\n\009\009if v.loc_key then\n\009\009\009local result_keys = Handy.utils.as_array(v.loc_key)\n\009\009\009for _, loc_key in ipairs(result_keys) do\n\009\009\009\009for _, loc_key_platform in ipairs({ loc_key, loc_key .. \"_gamepad\", loc_key .. \"_desktop\" }) do\n\009\009\009\009\009pcall(function()\n\009\009\009\009\009\009local checkbox_object = G.localization.descriptions.Handy_ConfigCheckbox[loc_key_platform] or {}\n\009\009\009\009\009\009insert_keywords(Handy.utils.split_loc_table_into_words(checkbox_object.unlock or {}))\n\009\009\009\009\009\009insert_keywords(Handy.utils.split_loc_table_into_words(checkbox_object.text or {}))\n\009\009\009\009\009end)\n\009\009\009\009\009-- pcall(function()\n\009\009\009\009\009-- \009local popup_object = G.localization.descriptions.Handy_ConfigPopup[loc_key_platform] or {}\n\009\009\009\009\009-- \009insert_keywords(Handy.utils.split_loc_table_into_words(popup_object.text or {}))\n\009\009\009\009\009-- end)\n\009\009\009\009end\n\009\009\009\009pcall(function()\n\009\009\009\009\009local loc_label_line = G.localization.misc.handy_keybind_labels[loc_key] or \"\"\n\009\009\009\009\009insert_keywords(Handy.utils.string_words_split(loc_label_line))\n\009\009\009\009end)\n\009\009\009end\n\009\009end\n\n\009\009v.result_keywords = only_update and v.result_keywords or \"\"\n\009\009for tk, _ in pairs(temp_keywords) do\n\009\009\009v.result_keywords = v.result_keywords .. \" \" .. tk\n\009\009end\n\009end\nend\n\nfunction Handy.UI.is_config_dictionary_item_contain_words(dictionary_item, words)\n\009if not dictionary_item then\n\009\009return false\n\009end\n\009local keywords = dictionary_item.result_keywords\n\009for _, word in ipairs(words) do\n\009\009if string.find(keywords, word, 1, true) == nil then\n\009\009\009return false\n\009\009end\n\009end\n\009return true\nend\nfunction Handy.UI.is_config_dictionary_key_contain_words(dictionary_key, words)\n\009return Handy.UI.is_config_dictionary_item_contain_words(Handy.UI.CD[dictionary_key or \"\"], words)\nend\n\nfunction Handy.UI.search(input)\n\009local matches = {}\n\009local input_words = Handy.utils.string_words_split(string.lower(input))\n\009if #input_words == 0 then\n\009\009return matches\n\009end\n\009for dictionary_key, dictionary_item in pairs(Handy.UI.CD) do\n\009\009if Handy.UI.is_config_dictionary_item_contain_words(dictionary_item, input_words) then\n\009\009\009table.insert(matches, dictionary_key)\n\009\009end\n\009end\n\009return matches\nend\n",["display"]="modules/ui/config_dictionary.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/ui/state_panel",["source"]="Handy.UI.state_panel = {\n\009element = nil,\n\n\009previous_state = {\n\009\009dangerous = false,\n\009\009title = {},\n\009\009items = {},\n\009\009sub_items = {},\n\009\009hold = false,\n\009},\n\009current_state = {\n\009\009dangerous = false,\n\009\009title = {},\n\009\009items = {},\n\009\009sub_items = {},\n\009\009hold = false,\n\009},\n\n\009get_definition = function()\n\009\009local state_panel = Handy.UI.state_panel\n\n\009\009local items_raw = {}\n\009\009for _, item in pairs(state_panel.current_state.items) do\n\009\009\009table.insert(items_raw, item)\n\009\009end\n\n\009\009table.sort(items_raw, function(a, b)\n\009\009\009return a.order < b.order\n\009\009end)\n\n\009\009local items = {}\n\009\009for _, item in ipairs(items_raw) do\n\009\009\009table.insert(items, {\n\009\009\009\009n = G.UIT.R,\n\009\009\009\009config = {\n\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009padding = 0.035,\n\009\009\009\009},\n\009\009\009\009nodes = {\n\009\009\009\009\009{\n\009\009\009\009\009\009n = G.UIT.T,\n\009\009\009\009\009\009config = {\n\009\009\009\009\009\009\009text = item.text,\n\009\009\009\009\009\009\009scale = 0.225,\n\009\009\009\009\009\009\009colour = item.dangerous and Handy.UI.C.DYN.TEXT_DANGEROUS or Handy.UI.C.DYN.TEXT,\n\009\009\009\009\009\009\009shadow = true,\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009})\n\009\009end\n\n\009\009return {\n\009\009\009n = G.UIT.ROOT,\n\009\009\009config = { align = \"cm\", padding = 0.1, r = 0.1, colour = G.C.CLEAR, id = \"handy_state_panel\" },\n\009\009\009nodes = {\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = {\n\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009\009padding = 0.125,\n\009\009\009\009\009\009r = 0.1,\n\009\009\009\009\009\009colour = Handy.UI.C.DYN.CONTAINER,\n\009\009\009\009\009},\n\009\009\009\009\009nodes = {\n\009\009\009\009\009\009{\n\009\009\009\009\009\009\009n = G.UIT.R,\n\009\009\009\009\009\009\009config = {\n\009\009\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009\009{\n\009\009\009\009\009\009\009\009\009n = G.UIT.T,\n\009\009\009\009\009\009\009\009\009config = {\n\009\009\009\009\009\009\009\009\009\009text = state_panel.current_state.title.text,\n\009\009\009\009\009\009\009\009\009\009scale = 0.3,\n\009\009\009\009\009\009\009\009\009\009colour = Handy.UI.C.DYN.TEXT,\n\009\009\009\009\009\009\009\009\009\009shadow = true,\n\009\009\009\009\009\009\009\009\009\009id = \"handy_state_title\",\n\009\009\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009},\n\009\009\009\009\009\009{\n\009\009\009\009\009\009\009n = G.UIT.R,\n\009\009\009\009\009\009\009config = {\n\009\009\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009\009{\n\009\009\009\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009\009\009\009config = {\n\009\009\009\009\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009\009\009\009\009\009id = \"handy_state_items\",\n\009\009\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009\009\009nodes = items,\n\009\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009},\n\009\009}\n\009end,\n\009emplace = function()\n\009\009-- Need to remake it at some point\n\009\009-- Like come on, create new panel every keypress change?\n\009\009-- Well, if it was every frame that would be a problem, but every press is manageable.... right?\n\009\009if Handy.UI.state_panel.element then\n\009\009\009Handy.UI.state_panel.element:remove()\n\009\009end\n\009\009local element = UIBox({\n\009\009\009definition = Handy.UI.state_panel.get_definition(),\n\009\009\009config = {\n\009\009\009\009instance_type = \"ALERT\",\n\009\009\009\009align = \"cm\",\n\009\009\009\009major = G.ROOM_ATTACH,\n\009\009\009\009can_collide = false,\n\009\009\009\009offset = {\n\009\009\009\009\009x = 0,\n\009\009\009\009\009y = 3.5,\n\009\009\009\009},\n\009\009\009},\n\009\009})\n\009\009Handy.UI.state_panel.element = element\n\009end,\n\n\009render = function()\n\009\009local state_panel = Handy.UI.state_panel\n\009\009local state = state_panel.current_state\n\n\009\009state.hold = false\n\009\009state.dangerous = false\n\009\009for _, item in pairs(state.items) do\n\009\009\009if item.hold then\n\009\009\009\009state.hold = true\n\009\009\009end\n\009\009\009if item.dangerous then\n\009\009\009\009state.dangerous = true\n\009\009\009end\n\009\009end\n\n\009\009if not state.title.text then\n\009\009\009if state.dangerous then\n\009\009\009\009state.title.text = localize(\"b_handy_notif_dangerous\")\n\009\009\009else\n\009\009\009\009state.title.text = localize(\"b_handy_notif_quick\")\n\009\009\009end\n\009\009end\n\n\009\009local color = Handy.UI.C.DYN.CONTAINER\n\009\009local target_color = state.dangerous and Handy.UI.C.RED or Handy.UI.C.BLACK\n\009\009color[1] = target_color[1]\n\009\009color[2] = target_color[2]\n\009\009color[3] = target_color[3]\n\n\009\009Handy.UI.counter = 0\n\009\009Handy.UI.update(0, true)\n\009\009state_panel.emplace()\n\009end,\n\n\009update = function(key, released)\n\009\009local state_panel = Handy.UI.state_panel\n\n\009\009local state = {\n\009\009\009dangerous = false,\n\009\009\009title = {},\n\009\009\009items = {},\n\009\009\009sub_items = {},\n\009\009}\n\n\009\009local is_changed = false\n\n\009\009for _, mod_module in pairs(Handy.modules) do\n\009\009\009if mod_module.update_state_panel then\n\009\009\009\009local temp_result = mod_module.update_state_panel(state, key, released)\n\009\009\009\009is_changed = is_changed or temp_result or false\n\009\009\009end\n\009\009end\n\n\009\009if is_changed then\n\009\009\009state_panel.previous_state = state_panel.current_state\n\009\009\009state_panel.current_state = state\n\n\009\009\009state_panel.render()\n\009\009else\n\009\009\009state_panel.current_state.hold = false\n\009\009end\n\009end,\n\n\009display = function(state_func, mode)\n\009\009local state_panel = Handy.UI.state_panel\n\n\009\009local should_replace_state = not state_panel.current_state.hold\n\009\009if mode == \"update\" then\n\009\009\009should_replace_state = should_replace_state and Handy.UI.counter >= 1\n\009\009elseif mode == \"override\" then\n\009\009\009should_replace_state = true\n\009\009end\n\009\009local state_skeleton = {\n\009\009\009dangerous = false,\n\009\009\009title = {},\n\009\009\009items = {},\n\009\009\009sub_items = {},\n\009\009}\n\009\009local state_to_apply = (should_replace_state and state_skeleton)\n\009\009\009or (state_panel.current_state or state_skeleton)\n\009\009local is_changed = state_func(state_to_apply)\n\009\009if is_changed then\n\009\009\009if should_replace_state then\n\009\009\009\009state_panel.previous_state = state_panel.current_state\n\009\009\009\009state_panel.current_state = state_to_apply\n\009\009\009end\n\009\009\009state_panel.render()\n\009\009end\n\009end,\n}\n",["display"]="modules/ui/state_panel.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/ui/functions",["source"]="-- Utilities\n\nfunction G.FUNCS.handy_empty()\n\009-- noop\nend\nfunction G.FUNCS.handy_rerender_after_input()\n\009G.E_MANAGER:add_event(Event({\n\009\009blocking = false,\n\009\009blockable = false,\n\009\009no_delete = true,\n\009\009func = function()\n\009\009\009Handy.UI.rerender(true)\n\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009blocking = false,\n\009\009\009\009blockable = false,\n\009\009\009\009no_delete = true,\n\009\009\009\009func = function()\n\009\009\009\009\009Handy.UI.rerender(true)\n\009\009\009\009\009return true\n\009\009\009\009end,\n\009\009\009}))\n\009\009\009return true\n\009\009end,\n\009}))\nend\n\n-- Opening-closing options\n\nfunction G.FUNCS.handy_open_options(e)\n\009G.SETTINGS.paused = true\n\009Handy.UI.reset_config_variables()\n\009Handy.UI.config_opened = true\n\009G.FUNCS.overlay_menu({\n\009\009definition = G.UIDEF.handy_options(),\n\009})\n\009Handy.utils.cleanup_dead_elements(G, \"MOVEABLES\")\nend\nfunction G.FUNCS.handy_exit_options(e)\n\009Handy.UI.reset_config_variables()\n\009if e then\n\009\009return G.FUNCS.options(e)\n\009end\n\009Handy.utils.cleanup_dead_elements(G, \"MOVEABLES\")\nend\nlocal exit_overlay_ref = G.FUNCS.exit_overlay_menu\nfunction G.FUNCS.exit_overlay_menu(...)\n\009Handy.UI.reset_config_variables()\n\009local result = exit_overlay_ref(...)\n\009Handy.utils.cleanup_dead_elements(G, \"MOVEABLES\")\n\009return result\nend\n\n-- Setup popups\n\nfunction G.FUNCS.handy_setup_config_popup(e)\n\009if e.handy_popup_processed then\n\009\009return\n\009end\n\n\009local loc_key = e.config.handy_loc_key\n\009local loc_vars = e.config.handy_loc_vars or {}\n\009local popup_hover = function(self)\n\009\009local is_gamepad = Handy.controller.is_gamepad()\n\009\009local loc_suffix = \"\"\n\009\009local is_popup_present = G.localization.descriptions.Handy_ConfigPopup[loc_key]\n\009\009if is_gamepad then\n\009\009\009if G.localization.descriptions.Handy_ConfigPopup[loc_key .. \"_gamepad\"] then\n\009\009\009\009is_popup_present = true\n\009\009\009\009loc_suffix = \"_gamepad\"\n\009\009\009end\n\009\009else\n\009\009\009if G.localization.descriptions.Handy_ConfigPopup[loc_key .. \"_desktop\"] then\n\009\009\009\009is_popup_present = true\n\009\009\009\009loc_suffix = \"_desktop\"\n\009\009\009end\n\009\009end\n\009\009if is_popup_present then\n\009\009\009local popup_content = {}\n\009\009\009localize({\n\009\009\009\009type = \"descriptions\",\n\009\009\009\009set = \"Handy_ConfigPopup\",\n\009\009\009\009key = loc_key .. loc_suffix,\n\009\009\009\009nodes = popup_content,\n\009\009\009\009vars = loc_vars,\n\009\009\009})\n\009\009\009local desc_lines = {}\n\009\009\009for _, line in ipairs(popup_content) do\n\009\009\009\009table.insert(desc_lines, {\n\009\009\009\009\009n = G.UIT.R,\n\009\009\009\009\009config = {\n\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009\009padding = 0.01,\n\009\009\009\009\009},\n\009\009\009\009\009nodes = line,\n\009\009\009\009})\n\009\009\009end\n\n\009\009\009self.config.h_popup_config = { align = \"mt\", offset = { x = 0, y = -0.1 }, major = e }\n\009\009\009self.config.h_popup = {\n\009\009\009\009n = G.UIT.ROOT,\n\009\009\009\009config = { align = \"cm\", colour = G.C.CLEAR },\n\009\009\009\009nodes = {\n\009\009\009\009\009{\n\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009config = {\n\009\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009\009},\n\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009{\n\009\009\009\009\009\009\009\009n = G.UIT.R,\n\009\009\009\009\009\009\009\009config = {\n\009\009\009\009\009\009\009\009\009padding = 0.05,\n\009\009\009\009\009\009\009\009\009r = 0.12,\n\009\009\009\009\009\009\009\009\009colour = lighten(G.C.JOKER_GREY, 0.5),\n\009\009\009\009\009\009\009\009\009emboss = 0.07,\n\009\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009\009\009{\n\009\009\009\009\009\009\009\009\009\009n = G.UIT.R,\n\009\009\009\009\009\009\009\009\009\009config = {\n\009\009\009\009\009\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009\009\009\009\009\009\009padding = 0.07,\n\009\009\009\009\009\009\009\009\009\009\009r = 0.1,\n\009\009\009\009\009\009\009\009\009\009\009colour = adjust_alpha(darken(G.C.BLACK, 0.1), 0.8),\n\009\009\009\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009\009\009\009nodes = { desc_from_rows({ desc_lines }) },\n\009\009\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009}\n\009\009else\n\009\009\009self.config.h_popup_config = nil\n\009\009\009self.config.h_popup = nil\n\009\009end\n\009\009Node.hover(self)\n\009end\n\n\009e.hover = popup_hover\n\009-- Well... it works xd\n\009pcall(function()\n\009\009e.children[2].children[1].children[2].children[1].children[1].hover = popup_hover\n\009end)\n\009e.handy_popup_processed = true\nend\n\n-- Presets\n\nfunction G.FUNCS.handy_toggle_preset_enabled(b, index)\n\009Handy.presets.save_index(index, { enabled = b })\n\009G.FUNCS.handy_rerender_after_input()\nend\nfunction G.FUNCS.handy_save_preset_index_with_name(e)\n\009local index = e.config.ref_table.index\n\009local new_name = e.config.ref_table.name_object.name\n\009Handy.presets.save_index(index, { name = new_name, apply = true })\n\009G.FUNCS.handy_rerender_after_input()\nend\nfunction G.FUNCS.handy_load_preset_index(e)\n\009local index = e.config.ref_table.index\n\009Handy.presets.apply_index(index)\n\009G.FUNCS.handy_rerender_after_input()\nend\nfunction G.FUNCS.handy_apply_preset_key(e)\n\009local key = e.config.ref_table.key\n\009Handy.presets.apply_example(key)\n\009G.FUNCS.handy_rerender_after_input()\nend\nfunction G.FUNCS.handy_clear_preset_index(e)\n\009local index = e.config.ref_table.index\n\009Handy.presets.clear_index(index)\n\009G.FUNCS.handy_rerender_after_input()\nend\n\n-- Paginations\n\nfunction G.FUNCS.handy_change_keybinds_page(arg)\n\009if not G.OVERLAY_MENU then\n\009\009return\n\009end\n\009Handy.UI.keybinds_page = arg.to_key\n\009local page_definition = Handy.UI.get_keybinds_page(arg.to_key)\n\009local object_container = G.OVERLAY_MENU:get_UIE_by_ID(\"handy_keybinds_page_content\")\n\009if object_container then\n\009\009object_container.config.object:remove()\n\009\009object_container.config.object = UIBox({\n\009\009\009definition = page_definition,\n\009\009\009config = {\n\009\009\009\009colour = G.C.CLEAR,\n\009\009\009\009parent = object_container,\n\009\009\009\009align = \"cm\",\n\009\009\009},\n\009\009})\n\009\009object_container.config.object:recalculate()\n\009end\nend\nfunction G.FUNCS.handy_change_quick_page(arg)\n\009if not G.OVERLAY_MENU then\n\009\009return\n\009end\n\009Handy.UI.quick_page = arg.to_key\n\009local page_definition = Handy.UI.get_quick_page(arg.to_key)\n\009local object_container = G.OVERLAY_MENU:get_UIE_by_ID(\"handy_quick_page_content\")\n\009if object_container then\n\009\009object_container.config.object:remove()\n\009\009object_container.config.object = UIBox({\n\009\009\009definition = page_definition,\n\009\009\009config = {\n\009\009\009\009colour = G.C.CLEAR,\n\009\009\009\009parent = object_container,\n\009\009\009\009align = \"cm\",\n\009\009\009},\n\009\009})\n\009\009object_container.config.object:recalculate()\n\009end\nend\n\n-- Search\n\nfunction G.FUNCS.handy_clear_search()\n\009Handy.UI.search_input_value = \"\"\n\009Handy.UI.rerender(true)\nend\n\nfunction G.FUNCS.handy_apply_search_with_value(e)\n\009Handy.UI.search_input_value = (e.config.ref_table or {}).handy_search_input_value or \"\"\n\009Handy.UI.rerender(true)\nend\n\nfunction G.FUNCS.handy_apply_search()\n\009Handy.UI.render_search_results(true)\nend\n\n-- Configs\n\nfunction G.FUNCS.handy_toggle_module_enabled(arg, module)\n\009if not module then\n\009\009return\n\009end\n\009module.enabled = arg\n\009Handy.config.save()\nend\n\nfunction G.FUNCS.handy_change_notifications_level(arg)\n\009Handy.cc.notifications_level = arg.to_key\n\009Handy.config.save()\nend\nfunction G.FUNCS.handy_change_keybinds_trigger_mode(arg)\n\009Handy.cc.keybinds_trigger_mode = arg.to_key\n\009Handy.config.save()\nend\nfunction G.FUNCS.handy_change_insta_actions_trigger_mode(arg)\n\009Handy.cc.insta_actions_trigger_mode = arg.to_key\n\009Handy.config.save()\nend\nfunction G.FUNCS.handy_change_current_device(arg)\n\009Handy.cc.current_device = arg.to_key\n\009Handy.config.save()\n\009Handy.controller.update_device_type({ check = true })\nend\nfunction G.FUNCS.handy_change_default_speed_multiplier(arg)\n\009Handy.cc.speed_multiplier.default_value = arg.to_key\n\009Handy.config.save()\nend\nfunction G.FUNCS.handy_change_default_animation_skip(arg)\n\009Handy.cc.animation_skip.default_value = arg.to_key\n\009Handy.config.save()\nend\n\nfunction G.FUNCS.handy_init_keybind_change(e)\n\009Handy.controller.init_bind(e)\nend\n\nfunction G.FUNCS.handy_change_controller_sensivity()\n\009G.CONTROLLER.axis_cursor_speed = G.CONTROLLER.saved_axis_cursor_speed * Handy.cc.controller_sensivity.mult\n\009Handy.config.request_save()\nend\n\nfunction G.FUNCS.handy_option_cycle_simple(e)\n\009local callback = e.config.ref_table[e.config.ref_value]\n\009if callback then\n\009\009callback()\n\009end\nend\n",["display"]="modules/ui/functions.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/ui/parts",["source"]="Handy.UI.PARTS = {\n\009localize_keybind = function(key, with_brackets)\n\009\009if not key then\n\009\009\009key = \"None\"\n\009\009end\n\009\009-- Backwards compatibility\n\009\009if key == \"[\" then\n\009\009\009key = \"Left Bracket\"\n\009\009elseif key == \"]\" then\n\009\009\009key = \"Right Bracket\"\n\009\009end\n\009\009local result = G.localization.misc.handy_keybinds[key] or key\n\009\009if with_brackets then\n\009\009\009result = \"[\" .. result .. \"]\"\n\009\009end\n\009\009return result\n\009end,\n\009localize_keybind_label = function(key, without_brackets)\n\009\009local result = localize(key, \"handy_keybind_labels\")\n\009\009if without_brackets then\n\009\009\009return result\n\009\009end\n\009\009return \"[\" .. result .. \"]\"\n\009end,\n\n\009format_new_module_keys = function(module, only_first)\n\009\009local key_1, key_2 = \"key_1\", \"key_2\"\n\009\009if Handy.controller.is_gamepad() then\n\009\009\009key_1, key_2 = \"key_1_gamepad\", \"key_2_gamepad\"\n\009\009end\n\n\009\009local keys_table = {\n\009\009\009[key_1] = module[key_1] ~= \"None\" and module[key_1] or nil,\n\009\009\009[key_2] = module[key_2] ~= \"None\" and module[key_2] or nil,\n\009\009}\n\n\009\009local keys_count = 0\n\009\009if keys_table[key_1] then\n\009\009\009keys_count = keys_count + 1\n\009\009end\n\009\009if keys_table[key_2] then\n\009\009\009keys_count = keys_count + 1\n\009\009end\n\n\009\009if only_first or keys_count < 2 then\n\009\009\009return localize({\n\009\009\009\009type = \"variable\",\n\009\009\009\009key = \"Handy_module_keys_single\",\n\009\009\009\009vars = { Handy.UI.PARTS.localize_keybind(keys_table[key_1] or keys_table[key_2] or \"None\") },\n\009\009\009})\n\009\009else\n\009\009\009return localize({\n\009\009\009\009type = \"variable\",\n\009\009\009\009key = \"Handy_module_keys_or\",\n\009\009\009\009vars = {\n\009\009\009\009\009Handy.UI.PARTS.localize_keybind(keys_table[key_1]),\n\009\009\009\009\009Handy.UI.PARTS.localize_keybind(keys_table[key_2]),\n\009\009\009\009},\n\009\009\009})\n\009\009end\n\009end,\n\009create_new_module_checkbox = function(module, loc_key, loc_vars, options, additional_options)\n\009\009options = Handy.utils.table_merge({}, additional_options or {}, options or {})\n\009\009local formatted_keys = Handy.UI.PARTS.format_new_module_keys(module, options.only_first)\n\009\009local result_loc_vars = { formatted_keys }\n\009\009for _, v in ipairs(loc_vars or {}) do\n\009\009\009table.insert(result_loc_vars, v)\n\009\009end\n\009\009local checkbox_name = {}\n\009\009localize({\n\009\009\009type = \"unlocks\",\n\009\009\009set = \"Handy_ConfigCheckbox\",\n\009\009\009key = loc_key,\n\009\009\009vars = result_loc_vars,\n\009\009\009nodes = checkbox_name,\n\009\009\009default_col = G.C.WHITE,\n\009\009})\n\009\009local checkbox_text = {}\n\009\009localize({\n\009\009\009type = \"descriptions\",\n\009\009\009set = \"Handy_ConfigCheckbox\",\n\009\009\009key = loc_key,\n\009\009\009vars = result_loc_vars,\n\009\009\009nodes = checkbox_text,\n\009\009\009default_col = G.C.UI.TEXT_LIGHT,\n\009\009})\n\n\009\009local name_lines = {}\n\009\009for _, line in ipairs(checkbox_name) do\n\009\009\009for _, line_part in ipairs(line) do\n\009\009\009\009line_part.config.scale = 0.4\n\009\009\009end\n\009\009\009table.insert(name_lines, {\n\009\009\009\009n = G.UIT.R,\n\009\009\009\009config = {\n\009\009\009\009\009minw = 2.75,\n\009\009\009\009\009maxw = (Handy.UI.is_in_search_result_page or not options.full_width) and 2.75 or nil,\n\009\009\009\009},\n\009\009\009\009nodes = line,\n\009\009\009})\n\009\009end\n\009\009local desc_lines = {\n\009\009\009{ n = G.UIT.R, config = { minw = 5 } },\n\009\009}\n\009\009for _, line in ipairs(checkbox_text) do\n\009\009\009table.insert(desc_lines, {\n\009\009\009\009n = G.UIT.R,\n\009\009\009\009config = {\n\009\009\009\009\009padding = 0.025,\n\009\009\009\009\009maxw = (Handy.UI.is_in_search_result_page or not options.full_width) and 4.5 or nil,\n\009\009\009\009},\n\009\009\009\009nodes = line,\n\009\009\009})\n\009\009end\n\n\009\009local result_toggle = create_toggle({\n\009\009\009callback = function(b)\n\009\009\009\009return G.FUNCS.handy_toggle_module_enabled(b, module)\n\009\009\009end,\n\009\009\009label_scale = 0.4,\n\009\009\009label = \"\",\n\009\009\009ref_table = module,\n\009\009\009ref_value = \"enabled\",\n\009\009\009w = 0,\n\009\009})\n\009\009result_toggle.config.focus_args.nav = \"wide\"\n\n\009\009return {\n\009\009\009n = G.UIT.R,\n\009\009\009config = {\n\009\009\009\009align = \"cm\",\n\009\009\009\009func = \"handy_setup_config_popup\",\n\009\009\009\009handy_loc_key = loc_key,\n\009\009\009\009handy_loc_vars = result_loc_vars,\n\009\009\009\009colour = (Handy.UI.is_in_search_result_page and options.dangerous) and adjust_alpha(G.C.MULT, 0.15)\n\009\009\009\009\009or G.C.CLEAR,\n\009\009\009\009padding = Handy.UI.is_in_search_result_page and 0.1 or 0,\n\009\009\009\009r = 0.1,\n\009\009\009\009hover = true,\n\009\009\009\009can_collide = true,\n\009\009\009\009focus_args = {\n\009\009\009\009\009funnel_from = true,\n\009\009\009\009},\n\009\009\009},\n\009\009\009nodes = {\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = { align = \"cm\" },\n\009\009\009\009\009nodes = name_lines,\n\009\009\009\009},\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = { align = \"cm\" },\n\009\009\009\009\009nodes = {\n\009\009\009\009\009\009result_toggle,\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = { minw = 0.1 },\n\009\009\009\009},\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = { align = \"cm\" },\n\009\009\009\009\009nodes = desc_lines,\n\009\009\009\009},\n\009\009\009},\n\009\009}\n\009end,\n\n\009create_module_slider = function(module, ref_value, loc_key, loc_vars, options, additional_options)\n\009\009options = Handy.utils.table_merge({}, additional_options or {}, options or {})\n\009\009local result_loc_vars = { formatted_keys }\n\009\009for _, v in ipairs(loc_vars or {}) do\n\009\009\009table.insert(result_loc_vars, v)\n\009\009end\n\n\009\009local checkbox_name = {}\n\009\009localize({\n\009\009\009type = \"unlocks\",\n\009\009\009set = \"Handy_ConfigCheckbox\",\n\009\009\009key = loc_key,\n\009\009\009vars = result_loc_vars,\n\009\009\009nodes = checkbox_name,\n\009\009\009default_col = G.C.WHITE,\n\009\009})\n\n\009\009local name_lines = {}\n\009\009for _, line in ipairs(checkbox_name) do\n\009\009\009for _, line_part in ipairs(line) do\n\009\009\009\009line_part.config.scale = 0.4\n\009\009\009end\n\009\009\009table.insert(name_lines, {\n\009\009\009\009n = G.UIT.R,\n\009\009\009\009config = {\n\009\009\009\009\009minw = 2.75,\n\009\009\009\009\009maxw = (Handy.UI.is_in_search_result_page or not options.full_width) and 2.75 or nil,\n\009\009\009\009},\n\009\009\009\009nodes = line,\n\009\009\009})\n\009\009end\n\n\009\009G.handy_name_lines = name_lines\n\n\009\009local result_slider = create_slider({\n\009\009\009label_scale = 0.4,\n\009\009\009ref_table = module,\n\009\009\009ref_value = ref_value,\n\009\009\009w = 4.77,\n\009\009\009min = options.min or 1,\n\009\009\009max = options.max or 1,\n\009\009\009decimal_places = options.decimal_places,\n\009\009\009callback = options.callback,\n\009\009})\n\n\009\009return {\n\009\009\009n = G.UIT.R,\n\009\009\009config = {\n\009\009\009\009align = \"cm\",\n\009\009\009\009colour = (Handy.UI.is_in_search_result_page and options.dangerous) and adjust_alpha(G.C.MULT, 0.15)\n\009\009\009\009\009or G.C.CLEAR,\n\009\009\009\009padding = Handy.UI.is_in_search_result_page and 0.1 or 0,\n\009\009\009\009r = 0.1,\n\009\009\009\009focus_args = {\n\009\009\009\009\009funnel_from = true,\n\009\009\009\009},\n\009\009\009},\n\009\009\009nodes = {\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = { align = \"cm\" },\n\009\009\009\009\009nodes = name_lines,\n\009\009\009\009},\n\009\009\009\009{\n\009\009\009\009\0