     =2097152   + 29,\nCURLINFO_FTP_ENTRY_PATH   =1048576 + 30,\nCURLINFO_REDIRECT_URL     =1048576 + 31,\nCURLINFO_PRIMARY_IP       =1048576 + 32,\nCURLINFO_APPCONNECT_TIME  =3145728 + 33,\nCURLINFO_CERTINFO         =4194304  + 34,\nCURLINFO_CONDITION_UNMET  =2097152   + 35,\nCURLINFO_RTSP_SESSION_ID  =1048576 + 36,\nCURLINFO_RTSP_CLIENT_CSEQ =2097152   + 37,\nCURLINFO_RTSP_SERVER_CSEQ =2097152   + 38,\nCURLINFO_RTSP_CSEQ_RECV   =2097152   + 39,\nCURLINFO_PRIMARY_PORT     =2097152   + 40,\nCURLINFO_LOCAL_IP         =1048576 + 41,\nCURLINFO_LOCAL_PORT       =2097152   + 42,\nCURLINFO_TLS_SESSION      =4194304  + 43,\nCURLINFO_LASTONE          = 43\n} CURLINFO;\ntypedef enum {\nCURLCLOSEPOLICY_NONE,\nCURLCLOSEPOLICY_OLDEST,\nCURLCLOSEPOLICY_LEAST_RECENTLY_USED,\nCURLCLOSEPOLICY_LEAST_TRAFFIC,\nCURLCLOSEPOLICY_SLOWEST,\nCURLCLOSEPOLICY_CALLBACK,\nCURLCLOSEPOLICY_LAST\n} curl_closepolicy;\ntypedef enum {\nCURL_LOCK_DATA_NONE = 0,\nCURL_LOCK_DATA_SHARE,\nCURL_LOCK_DATA_COOKIE,\nCURL_LOCK_DATA_DNS,\nCURL_LOCK_DATA_SSL_SESSION,\nCURL_LOCK_DATA_CONNECT,\nCURL_LOCK_DATA_LAST\n} curl_lock_data;\ntypedef enum {\nCURL_LOCK_ACCESS_NONE = 0,\nCURL_LOCK_ACCESS_SHARED = 1,\nCURL_LOCK_ACCESS_SINGLE = 2,\nCURL_LOCK_ACCESS_LAST\n} curl_lock_access;\ntypedef void (*curl_lock_function)(CURL *handle,\ncurl_lock_data data,\ncurl_lock_access locktype,\nvoid *userptr);\ntypedef void (*curl_unlock_function)(CURL *handle,\ncurl_lock_data data,\nvoid *userptr);\ntypedef void CURLSH;\ntypedef enum {\nCURLSHE_OK,\nCURLSHE_BAD_OPTION,\nCURLSHE_IN_USE,\nCURLSHE_INVALID,\nCURLSHE_NOMEM,\nCURLSHE_NOT_BUILT_IN,\nCURLSHE_LAST\n} CURLSHcode;\ntypedef enum {\nCURLSHOPT_NONE,\nCURLSHOPT_SHARE,\nCURLSHOPT_UNSHARE,\nCURLSHOPT_LOCKFUNC,\nCURLSHOPT_UNLOCKFUNC,\nCURLSHOPT_USERDATA,\nCURLSHOPT_LAST\n} CURLSHoption;\n CURLSH *curl_share_init(void);\n CURLSHcode curl_share_setopt(CURLSH *, CURLSHoption option, ...);\n CURLSHcode curl_share_cleanup(CURLSH *);\ntypedef enum {\nCURLVERSION_FIRST,\nCURLVERSION_SECOND,\nCURLVERSION_THIRD,\nCURLVERSION_FOURTH,\nCURLVERSION_LAST\n} CURLversion;\ntypedef struct {\nCURLversion age;\nconst char *version;\nunsigned int version_num;\nconst char *host;\nint features;\nconst char *ssl_version;\nlong ssl_version_num;\nconst char *libz_version;\nconst char * const *protocols;\nconst char *ares;\nint ares_num;\nconst char *libidn;\nint iconv_ver_num;\nconst char *libssh_version;\n} curl_version_info_data;\n curl_version_info_data *curl_version_info(CURLversion);\n const char *curl_easy_strerror(CURLcode);\n const char *curl_share_strerror(CURLSHcode);\n CURLcode curl_easy_pause(CURL *handle, int bitmask);\n CURL *curl_easy_init(void);\n CURLcode curl_easy_setopt(CURL *curl, CURLoption option, ...);\n CURLcode curl_easy_perform(CURL *curl);\n void curl_easy_cleanup(CURL *curl);\n CURLcode curl_easy_getinfo(CURL *curl, CURLINFO info, ...);\n CURL* curl_easy_duphandle(CURL *curl);\n void curl_easy_reset(CURL *curl);\n CURLcode curl_easy_recv(CURL *curl, void *buffer, size_t buflen,\nsize_t *n);\n CURLcode curl_easy_send(CURL *curl, const void *buffer,\nsize_t buflen, size_t *n);\ntypedef void CURLM;\ntypedef enum {\nCURLM_CALL_MULTI_PERFORM = -1,\nCURLM_OK,\nCURLM_BAD_HANDLE,\nCURLM_BAD_EASY_HANDLE,\nCURLM_OUT_OF_MEMORY,\nCURLM_INTERNAL_ERROR,\nCURLM_BAD_SOCKET,\nCURLM_UNKNOWN_OPTION,\nCURLM_ADDED_ALREADY,\nCURLM_LAST\n} CURLMcode;\ntypedef enum {\nCURLMSG_NONE,\nCURLMSG_DONE,\nCURLMSG_LAST\n} CURLMSG;\nstruct CURLMsg {\nCURLMSG msg;\nCURL *easy_handle;\nunion {\nvoid *whatever;\nCURLcode result;\n} data;\n};\ntypedef struct CURLMsg CURLMsg;\nstruct curl_waitfd {\ncurl_socket_t fd;\nshort events;\nshort revents;\n};\ntypedef struct fd_set {\n        unsigned int   fd_count;               /* how many are SET? */\n        curl_socket_t  fd_array[64]; //FD_SETSIZE, 64 on my machine, TOFIX\n} fd_set;\n CURLM *curl_multi_init(void);\n CURLMcode curl_multi_add_handle(CURLM *multi_handle,\nCURL *curl_handle);\n CURLMcode curl_multi_remove_handle(CURLM *multi_handle,\nCURL *curl_handle);\n CURLMcode curl_multi_fdset(CURLM *multi_handle,\nfd_set *read_fd_set,\nfd_set *write_fd_set,\nfd_set *exc_fd_set,\nint *max_fd);\n CURLMcode curl_multi_wait(CURLM *multi_handle,\nstruct curl_waitfd extra_fds[],\nunsigned int extra_nfds,\nint timeout_ms,\nint *ret);\n CURLMcode curl_multi_perform(CURLM *multi_handle,\nint *running_handles);\n CURLMcode curl_multi_cleanup(CURLM *multi_handle);\n CURLMsg *curl_multi_info_read(CURLM *multi_handle,\nint *msgs_in_queue);\n const char *curl_multi_strerror(CURLMcode);\ntypedef int (*curl_socket_callback)(CURL *easy,\ncurl_socket_t s,\nint what,\nvoid *userp,\nvoid *socketp);\ntypedef int (*curl_multi_timer_callback)(CURLM *multi,\nlong timeout_ms,\nvoid *userp);\n CURLMcode curl_multi_socket(CURLM *multi_handle, curl_socket_t s,\nint *running_handles);\n CURLMcode curl_multi_socket_action(CURLM *multi_handle,\ncurl_socket_t s,\nint ev_bitmask,\nint *running_handles);\n CURLMcode curl_multi_socket_all(CURLM *multi_handle,\nint *running_handles);\n CURLMcode curl_multi_timeout(CURLM *multi_handle,\nlong *milliseconds);\ntypedef enum {\nCURLMOPT_SOCKETFUNCTION = 20000 + 1,\nCURLMOPT_SOCKETDATA = 10000 + 2,\nCURLMOPT_PIPELINING = 0 + 3,\nCURLMOPT_TIMERFUNCTION = 20000 + 4,\nCURLMOPT_TIMERDATA = 10000 + 5,\nCURLMOPT_MAXCONNECTS = 0 + 6,\nCURLMOPT_MAX_HOST_CONNECTIONS = 0 + 7,\nCURLMOPT_MAX_PIPELINE_LENGTH = 0 + 8,\nCURLMOPT_CONTENT_LENGTH_PENALTY_SIZE = 30000 + 9,\nCURLMOPT_CHUNK_LENGTH_PENALTY_SIZE = 30000 + 10,\nCURLMOPT_PIPELINING_SITE_BL = 10000 + 11,\nCURLMOPT_PIPELINING_SERVER_BL = 10000 + 12,\nCURLMOPT_MAX_TOTAL_CONNECTIONS = 0 + 13,\nCURLMOPT_LASTENTRY\n} CURLMoption;\n CURLMcode curl_multi_setopt(CURLM *multi_handle,\nCURLMoption option, ...);\n CURLMcode curl_multi_assign(CURLM *multi_handle,\ncurl_socket_t sockfd, void *sockp);\n]])\n\n-- header.h\nffi.cdef([[\n\009struct curl_header {\n\009\009char *name;    /* this might not use the same case */\n\009\009char *value;\n\009\009size_t amount; /* number of headers using this name  */\n\009\009size_t index;  /* ... of this instance, 0 or higher */\n\009\009unsigned int origin; /* see bits below */\n\009\009void *anchor; /* handle privately used by libcurl */\n\009};\n\n\009typedef struct curl_header curl_header;\n\n\009typedef enum {\n\009\009CURLHE_OK,\n\009\009CURLHE_BADINDEX,      /* header exists but not with this index */\n\009\009CURLHE_MISSING,       /* no such header exists */\n\009\009CURLHE_NOHEADERS,     /* no headers at all exist (yet) */\n\009\009 CURLHE_NOREQUEST,     /* no request with this number was used */\n\009\009 CURLHE_OUT_OF_MEMORY, /* out of memory while processing */\n\009\009 CURLHE_BAD_ARGUMENT,  /* a function argument was not okay */\n\009\009 CURLHE_NOT_BUILT_IN   /* if API was disabled in the build */\n\009} CURLHcode;\n\n\009CURLHcode curl_easy_header(CURL *easy,\n\009\009\009\009\009\009\009\009\009\009   const char *name,\n\009\009\009\009\009\009\009\009\009\009size_t index,\n\009\009\009\009\009\009\009\009\009\009unsigned int origin,\n\009\009\009\009\009\009\009\009\009\009int request,\n\009\009\009\009\009\009\009\009\009\009struct curl_header **hout);\n\n\009struct curl_header *curl_easy_nextheader(CURL *easy,\n\009\009\009\009\009\009\009\009\009\009\009\009\009\009 unsigned int origin,\n\009\009\009\009\009\009\009\009\009\009\009\009\009  int request,\n\009\009\009\009\009\009\009\009\009\009\009\009\009  struct curl_header *prev);\n]])\n\nreturn curl\n",["display"]="libs/https/luajit-curl.lua"},{["mod"]="Steamodded",["id"]="Steamodded",["name"]="SMODS.https",["source"]="local isThread = arg == nil\n\nlocal succ, https = pcall(require, \"https\")\n\nlocal userAgent\nlocal threadOptions\nif isThread then\n\009require \"love.system\"\n\009local channel = love.thread.getChannel(\"SMODS.https\")\n\009local ua, url, options, id = ...\n\009userAgent = ua\n\009local function sendMessageToConsole(level, logger, message)\n\009\009channel:push({id = id, type = \"log\", level = level, msg = message, logger = logger})\n\009end\n\n\009function sendTraceMessage(message, logger)\n\009\009sendMessageToConsole(\"TRACE\", logger, message)\n\009end\n\n\009function sendDebugMessage(message, logger)\n\009\009sendMessageToConsole(\"DEBUG\", logger, message)\n\009end\n\n\009function sendInfoMessage(message, logger)\n\009\009-- space in info string to align the logs in console\n\009\009sendMessageToConsole(\"INFO \", logger, message)\n\009end\n\n\009function sendWarnMessage(message, logger)\n\009\009-- space in warn string to align the logs in console\n\009\009sendMessageToConsole(\"WARN \", logger, message)\n\009end\n\n\009function sendErrorMessage(message, logger)\n\009\009sendMessageToConsole(\"ERROR\", logger, message)\n\009end\n\n\009function sendFatalMessage(message, logger)\n\009\009sendMessageToConsole(\"FATAL\", logger, message)\n\009end\n\009threadOptions = {url, options, id = id}\nend\n\nif not succ then\n\009if love.system.getOS() == \"Windows\" then -- This module is usually only accessible on windows\n\009\009sendDebugMessage(\"Could not load built in https module. This shouldn't happen!!! \" .. tostring(https), \"SMODS.https\")\n\009end\n\009https = false\nend\n\nlocal curl\n\nif not https then\n\009local succ, cl = pcall(require, \"luajit-curl\")\n\009if not succ then\n\009\009sendDebugMessage(\"Could not load luajit-curl! \" .. tostring(cl), \"SMODS.https\")\n\009else\n\009\009curl = cl\n\009end\nend\n\nif not https and not curl then\n\009error(\"Could not load a suitable backend\")\nend\n\nlocal M = {}\n\nif not isThread then\n\009local version = require \"SMODS.version\"\n\009userAgent = \"SMODS/\" .. version .. \" (\" .. love.system.getOS() .. \")\"\nend\n\nlocal methods = {GET=true, HEAD=true, POST=true, PUT=true, DELETE=true, PATCH=true}\n\nlocal function checkAndHandleInput(url, options, skipUserAgent)\n\009assert(type(url) == \"string\", \"\\\"url\\\" must be a string\")\n\009options = options or {}\n\009assert(type(options) == \"table\", \"\\\"options\\\" must be a table\")\n\009assert(type(options.headers or {}) == \"table\", \"\\\"options.headers\\\" must be a table\")\n\009local contentTypeHeader = false\n\009if not skipUserAgent then\n\009\009local headers = {}\n\009\009local customUserAgent = false\n\009\009for k,v in pairs(options.headers or {}) do\n\009\009\009if not customUserAgent and string.lower(k) == \"user-agent\" then\n\009\009\009\009customUserAgent = true\n\009\009\009end\n\009\009\009if not contentTypeHeader and string.lower(k) == \"content-type\" then\n\009\009\009\009customUserAgent = true\n\009\009\009end\n\009\009\009headers[k] = v\n\009\009end\n\009\009if not customUserAgent then\n\009\009\009headers[\"User-Agent\"] = userAgent\n\009\009end\n\009\009options.headers = headers\n\009end\n\009if options.method then\n\009\009assert(type(options.method) == \"string\", \"\\\"options.method\\\" must be a string\")\n\009\009assert(methods[options.method], \"\\\"options.method\\\" must be one of \\\"GET\\\", \\\"HEAD\\\", \\\"POST\\\", \\\"PUT\\\", \\\"DELETE\\\", or \\\"PATCH\\\"\")\n\009end\n\009assert(type(options.data or \"\") == \"string\", \"\\\"options.data\\\" must be a string\")\n\009if options.data == \"\" then options.data = nil end\n\009return options\nend\n\nif https then\n\009sendDebugMessage(\"Using https module backend\", \"SMODS.https\")\n\009userAgent = userAgent .. \" https-module-backend\"\n\009function M.request(url, options)\n\009\009options = checkAndHandleInput(url, options)\n\009\009return https.request(url, options)\n\009end\nelse -- curl\n\009sendDebugMessage(\"Using curl backend\", \"SMODS.https\")\n\009local ffi = require \"ffi\"\n\009userAgent = userAgent .. \" curl/\" .. ffi.string(curl.curl_version_info(curl.CURLVERSION_FOURTH).version)\n\n\009local function curlCleanup(ch, list, cb)\n\009\009curl.curl_easy_cleanup(ch)\n\009\009curl.curl_slist_free_all(list)\n\009\009cb:free()\n\009end\n\n\009local function assertCleanup(check, msg, fn, ...)\n\009\009if not check then\n\009\009\009fn(...)\n\009\009\009error(msg)\n\009\009end\n\009end\n\n\009function M.request(url, options)\n\009\009options = checkAndHandleInput(url, options, true)\n\009\009local ch = curl.curl_easy_init()\n\009\009if not ch then\n\009\009\009return 0, \"Failed to initialize libcurl\", {}\n\009\009end\n\n\009\009local buff = \"\"\n\009\009local cb = ffi.cast(\"curl_write_callback\", function(ptr, size, nmemb, userdata)\n\009\009\009local data_size = tonumber(size * nmemb)\n\009\009\009buff = buff .. ffi.string(ptr, size * nmemb)\n\009\009\009return data_size\n\009\009end)\n\n\009\009curl.curl_easy_setopt(ch, curl.CURLOPT_WRITEFUNCTION, cb)\n\009\009curl.curl_easy_setopt(ch, curl.CURLOPT_URL, url)\n\009\009curl.curl_easy_setopt(ch, curl.CURLOPT_USERAGENT, userAgent)\n\009\009local list\n\009\009if options.headers then\n\009\009\009for k,v in pairs(options.headers) do\n\009\009\009\009if v == nil then v = \"\" end\n\009\009\009\009if type(v) == \"number\" then -- fine I'll be a little nice\n\009\009\009\009\009v = tostring(v)\n\009\009\009\009end\n\009\009\009\009assertCleanup(type(k) == \"string\", \"Header key should be a string\", curlCleanup, ch, list, cb)\n\009\009\009\009assertCleanup(type(v) == \"string\", \"Header value should be a string\", curlCleanup, ch, list, cb)\n\n\009\009\009\009local str = k .. \": \" .. v\n\009\009\009\009list = curl.curl_slist_append(list, str)\n\009\009\009end\n\009\009\009curl.curl_easy_setopt(ch, curl.CURLOPT_HTTPHEADER, list)\n\009\009end\n\n\009\009if options.data then\n\009\009\009curl.curl_easy_setopt(ch, curl.CURLOPT_POSTFIELDS, options.data)\n\009\009end\n\n\009\009if options.method then\n\009\009\009curl.curl_easy_setopt(ch, curl.CURLOPT_CUSTOMREQUEST, options.method)\n\009\009end\n\n\009\009local res = curl.curl_easy_perform(ch)\n\n\009\009if res ~= curl.CURLE_OK then\n\009\009\009curlCleanup(ch, list, cb)\n\009\009\009return 0, ffi.string(curl.curl_easy_strerror(res)), {}\n\009\009end\n\n\009\009local status = ffi.new(\"long[1]\")\n\n\009\009local res = curl.curl_easy_getinfo(ch, curl.CURLINFO_RESPONSE_CODE, status)\n\009\009if res ~= curl.CURLE_OK then\n\009\009\009curlCleanup(ch, list, cb)\n\009\009\009return 0, \"(get response code) \" .. ffi.string(curl.curl_easy_strerror(res)), {}\n\009\009end\n\009\009status = tonumber(status[0])\n\n\009\009local headers = {}\n\n\009\009local prev\n\009\009while true do\n\009\009\009local h = curl.curl_easy_nextheader(ch, 1, -1, prev)\n\009\009\009if h == nil then\n\009\009\009\009break\n\009\009\009end\n\009\009\009headers[ffi.string(h.name)] = ffi.string(h.value)\n\009\009\009prev = h\n\009\009end\n\n\009\009curlCleanup(ch, list, cb)\n\009\009return status, buff, headers\n\009end\nend\n\nlocal channel = love.thread.getChannel(\"SMODS.https\")\n\nif not isThread then -- In main thread\n\n\009local threads\n\009local threadContent\n\009local id = 1\n\n\009local function pollThreads()\n\009\009if not threads then\n\009\009\009return\n\009\009end\n\009\009while true do\n\009\009\009local msg = channel:pop()\n\009\009\009if not msg then\n\009\009\009\009break\n\009\009\009end\n\009\009\009local t = threads[msg.id]\n\009\009\009assert(t, \"Non-existant thread id (\" .. tostring(msg.id) .. \")\")\n\009\009\009local msgType = msg.type\n\009\009\009assert(type(msgType) == \"string\", \"Thread message type is not a string\")\n\009\009\009if msgType == \"log\" then\n\009\009\009\009assert(type(msg.msg) == \"string\", \"Logging msg not a string\")\n\009\009\009\009assert(type(msg.level) == \"string\", \"Logging level not a string\")\n\009\009\009\009assert(type(msg.logger) == \"string\", \"Logging logger not a string\")\n\009\009\009\009sendMessageToConsole(msg.level, msg.logger .. \"(\" .. tostring(msg.id) .. \")\", msg.msg)\n\009\009\009elseif msgType == \"cb\" then -- NOTE: cb removes the thread so it must be the last message\n\009\009\009\009t.cb(msg.code, msg.body, msg.headers)\n\009\009\009\009threads[msg.id] = nil\n\009\009\009end\n\009\009end\n\009end\n\n\009local function getContent()\n\009\009if threadContent then\n\009\009\009return threadContent\n\009\009end\n\009\009local file = assert(SMODS.NFS.read(SMODS.path..\"/libs/https/smods-https.lua\"))\n\009\009local data = love.filesystem.newFileData(file, '=[SMODS _ \"smods-https-thread.lua\"]') -- name is a silly hack to get lovely to register the curl module\n\009\009threadContent = data\n\009\009return data\n\009end\n\n\009local function setupThreading()\n\009\009threads = {}\n\009\009M.threads = threads\n\009\009local orig_love_update = love.update\n\009\009function love.update(...)\n\009\009\009pollThreads()\n\009\009\009return orig_love_update(...)\n\009\009end\n\009end\n\n\n\009function M.asyncRequest(url, options, cb)\n\009\009if not threads then\n\009\009\009setupThreading()\n\009\009end\n\009\009if type(options) == \"function\" and not cb then\n\009\009\009cb = options\n\009\009\009options = nil\n\009\009end\n\009\009assert(type(cb) == \"function\", \"Callback is not a function\")\n\009\009checkAndHandleInput(url, options, true) -- That way we aren't erroring in the thread as much\n\009\009local thread = love.thread.newThread(getContent())\n\009\009local tID = tostring(id)\n\009\009local obj = {thread = thread, cb = cb, id = tID}\n\009\009threads[tID] = obj\n\009\009thread:start(userAgent, url, options, tID)\n\009\009id = id + 1\n\009end\n\n\009if debug.getinfo(1).source:match(\"@.*\") then -- For when running under watch\n\009\009print(M.asyncRequest(\"http://localhost:3000/version.lua\", print))\n\009\009-- return print(M.request(\"http://example.com\"))\n\009end\nelse -- Child thread\n\009local code, body, headers = M.request(threadOptions[1], threadOptions[2])\n\009channel:push({id = threadOptions.id, type = \"cb\", code = code, body = body, headers = headers})\n\009return -- Ensure nothing else happens after this\nend\nreturn M\n",["display"]="libs/https/smods-https.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/utils",["source"]="Handy.utils = {}\n\n--- @generic T\n--- @generic S\n--- @param target T\n--- @param source S\n--- @param ... any\n--- @return T | S\nfunction Handy.utils.table_merge(target, source, ...)\n\009assert(type(target) == \"table\", \"Target is not a table\")\n\009local tables_to_merge = { source, ... }\n\009if #tables_to_merge == 0 then\n\009\009return target\n\009end\n\n\009for k, t in ipairs(tables_to_merge) do\n\009\009assert(type(t) == \"table\", string.format(\"Expected a table as parameter %d\", k))\n\009end\n\n\009for i = 1, #tables_to_merge do\n\009\009local from = tables_to_merge[i]\n\009\009for k, v in pairs(from) do\n\009\009\009if type(v) == \"table\" then\n\009\009\009\009target[k] = target[k] or {}\n\009\009\009\009target[k] = Handy.utils.table_merge(target[k], v)\n\009\009\009else\n\009\009\009\009target[k] = v\n\009\009\009end\n\009\009end\n\009end\n\n\009return target\nend\n\nfunction Handy.utils.table_contains(t, value)\n\009for i = #t, 1, -1 do\n\009\009if t[i] and t[i] == value then\n\009\009\009return true\n\009\009end\n\009end\n\009return false\nend\n\nfunction Handy.utils.serialize_string(s)\n\009return string.format(\"%q\", s)\nend\n\nfunction Handy.utils.serialize(t, indent)\n\009indent = indent or \"\"\n\009local str = \"{\\n\"\n\009for k, v in ipairs(t) do\n\009\009str = str .. indent .. \"\\t\"\n\009\009if type(v) == \"number\" then\n\009\009\009str = str .. v\n\009\009elseif type(v) == \"boolean\" then\n\009\009\009str = str .. (v and \"true\" or \"false\")\n\009\009elseif type(v) == \"string\" then\n\009\009\009str = str .. Handy.utils.serialize_string(v)\n\009\009elseif type(v) == \"table\" then\n\009\009\009str = str .. Handy.utils.serialize(v, indent .. \"\\t\")\n\009\009else\n\009\009\009-- not serializable\n\009\009\009str = str .. \"nil\"\n\009\009end\n\009\009str = str .. \",\\n\"\n\009end\n\009for k, v in pairs(t) do\n\009\009if type(k) == \"string\" then\n\009\009\009str = str .. indent .. \"\\t\" .. \"[\" .. Handy.utils.serialize_string(k) .. \"] = \"\n\n\009\009\009if type(v) == \"number\" then\n\009\009\009\009str = str .. v\n\009\009\009elseif type(v) == \"boolean\" then\n\009\009\009\009str = str .. (v and \"true\" or \"false\")\n\009\009\009elseif type(v) == \"string\" then\n\009\009\009\009str = str .. Handy.utils.serialize_string(v)\n\009\009\009elseif type(v) == \"table\" then\n\009\009\009\009str = str .. Handy.utils.serialize(v, indent .. \"\\t\")\n\009\009\009else\n\009\009\009\009-- not serializable\n\009\009\009\009str = str .. \"nil\"\n\009\009\009end\n\009\009\009str = str .. \",\\n\"\n\009\009end\n\009end\n\009str = str .. indent .. \"}\"\n\009return str\nend\n\nfunction Handy.utils.cleanup_dead_elements(ref_table, ref_key)\n\009local new_values = {}\n\009local target = ref_table[ref_key]\n\009if not target then\n\009\009return\n\009end\n\009for k, v in pairs(target) do\n\009\009if not v.REMOVED and not v.removed then\n\009\009\009new_values[#new_values + 1] = v\n\009\009end\n\009end\n\009ref_table[ref_key] = new_values\n\009return new_values\nend\n\nfunction Handy.utils.string_words_split(str)\n\009local result = {}\n\009for word in str:gsub(\"[%p%c%d]\", \"\"):gmatch(\"%S+\") do\n\009\009table.insert(result, word)\n\009end\n\009return result\nend\n\nfunction Handy.utils.table_concat_string(table)\n\009local result = \"\"\n\009for _, part in ipairs(table) do\n\009\009result = result .. \" \" .. tostring(part)\n\009end\n\009return result\nend\n\nfunction Handy.utils.string_remove_balatro_formatting(str)\n\009str = str:gsub(\"#%d+#\", \"\")\n\009str = str .. \"{}\"\n\009str = str:gsub(\"{[^}]*}\", \"\")\n\009str = str:gsub(\"%b{}\", \"\")\n\009return str\nend\n\nfunction Handy.utils.as_array(t)\n\009return type(t) == \"table\" and t or { t }\nend\n\nfunction Handy.utils.split_loc_table_into_words(t)\n\009return Handy.utils.string_words_split(\n\009\009Handy.utils.string_remove_balatro_formatting(Handy.utils.table_concat_string(Handy.utils.as_array(t)))\n\009)\nend\n\nfunction Handy.utils.table_slice(t, n)\n\009local sliced = {}\n\009for i = #t, n + 1, -1 do\n\009\009table.insert(sliced, t[i])\n\009\009t[i] = nil\n\009end\n\009return t, sliced\nend\n\nfunction Handy.utils.deep_missing_keys(t1, t2, path, result)\n\009local function format_key(k)\n\009\009if type(k) == \"number\" then\n\009\009\009return \"[\" .. k .. \"]\"\n\009\009else\n\009\009\009return tostring(k)\n\009\009end\n\009end\n\n\009path = path or \"\"\n\009result = result or {}\n\n\009for k, v in pairs(t1) do\n\009\009local current_key = format_key(k)\n\009\009local current_path = path ~= \"\" and (path .. \".\" .. current_key) or current_key\n\009\009local v2 = t2 and t2[k]\n\n\009\009if type(v) == \"table\" then\n\009\009\009if type(v2) == \"table\" then\n\009\009\009\009Handy.utils.deep_missing_keys(v, v2, current_path, result)\n\009\009\009else\n\009\009\009\009local function collect_paths(tbl, prefix)\n\009\009\009\009\009for subk, subv in pairs(tbl) do\n\009\009\009\009\009\009local subpath = prefix .. \".\" .. format_key(subk)\n\009\009\009\009\009\009if type(subv) == \"table\" then\n\009\009\009\009\009\009\009collect_paths(subv, subpath)\n\009\009\009\009\009\009else\n\009\009\009\009\009\009\009table.insert(result, subpath)\n\009\009\009\009\009\009end\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009\009collect_paths(v, current_path)\n\009\009\009end\n\009\009else\n\009\009\009if v2 == nil then\n\009\009\009\009table.insert(result, current_path)\n\009\009\009end\n\009\009end\n\009end\n\n\009return result\nend\n",["display"]="modules/utils.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/config",["source"]="local default_config = {\n\009handy = {\n\009\009enabled = true,\n\009},\n\n\009notifications_level = 3,\n\009keybinds_trigger_mode = 1,\n\009insta_actions_trigger_mode = 1,\n\009current_device = 1,\n\009hide_in_menu = false,\n\n\009swap_controller_cursor_stick = {\n\009\009enabled = false,\n\009},\n\009controller_sensivity = {\n\009\009enabled = true,\n\009\009mult = 1,\n\009},\n\n\009hide_options_button = {\n\009\009enabled = false,\n\009},\n\009prevent_if_debugplus = {\n\009\009enabled = false,\n\009},\n\n\009insta_highlight = {\n\009\009enabled = true,\n\n\009\009key_1 = \"Left Mouse\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"Left Stick\",\n\009\009key_2_gamepad = \"Left Mouse\", -- Touchscreen\n\n\009\009allow_deselect = {\n\009\009\009enabled = false,\n\009\009},\n\009},\n\009insta_highlight_entire_f_hand = {\n\009\009enabled = true,\n\009\009key_1 = \"None\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"None\",\n\009\009key_2_gamepad = \"None\",\n\009},\n\009insta_buy_n_sell = {\n\009\009enabled = true,\n\009\009key_1 = \"None\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"None\",\n\009\009key_2_gamepad = \"None\",\n\009},\n\009insta_buy_or_sell = {\n\009\009enabled = true,\n\009\009key_1 = \"Shift\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"Left Bumper\",\n\009\009key_2_gamepad = \"None\",\n\009},\n\009insta_use = {\n\009\009enabled = true,\n\009\009key_1 = \"Ctrl\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"Right Bumper\",\n\009\009key_2_gamepad = \"None\",\n\009},\n\009move_highlight = {\n\009\009enabled = true,\n\n\009\009swap = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"Shift\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009to_end = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"Ctrl\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\n\009\009dx = {\n\009\009\009one_left = {\n\009\009\009\009enabled = true,\n\009\009\009\009key_1 = \"Left\",\n\009\009\009\009key_2 = \"None\",\n\009\009\009\009key_1_gamepad = \"None\",\n\009\009\009\009key_2_gamepad = \"None\",\n\009\009\009},\n\009\009\009one_right = {\n\009\009\009\009enabled = true,\n\009\009\009\009key_1 = \"Right\",\n\009\009\009\009key_2 = \"None\",\n\009\009\009\009key_1_gamepad = \"None\",\n\009\009\009\009key_2_gamepad = \"None\",\n\009\009\009},\n\009\009},\n\009},\n\n\009insta_cash_out = {\n\009\009enabled = true,\n\009\009key_1 = \"Enter\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"(Y)\",\n\009\009key_2_gamepad = \"None\",\n\009},\n\009insta_booster_skip = {\n\009\009enabled = true,\n\009\009key_1 = \"Enter\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"(Y)\",\n\009\009key_2_gamepad = \"None\",\n\009},\n\009show_deck_preview = {\n\009\009enabled = true,\n\009\009key_1 = \"None\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"Left Trigger\",\n\009\009key_2_gamepad = \"None\",\n\009},\n\n\009dangerous_actions = {\n\009\009enabled = false,\n\n\009\009-- Use it as basic modifier for all dangerous controls\n\009\009-- Maybe I should change this but idk, backwards compatibility\n\009\009immediate_buy_and_sell = {\n\009\009\009enabled = false,\n\009\009\009key_1 = \"Middle Mouse\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\n\009\009\009queue = {\n\009\009\009\009enabled = false,\n\009\009\009},\n\009\009},\n\n\009\009sell_all_same = {\n\009\009\009enabled = false,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\n\009\009sell_all = {\n\009\009\009enabled = false,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\n\009\009card_remove = {\n\009\009\009enabled = false,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\n\009\009nopeus_unsafe = {\n\009\009\009enabled = false,\n\009\009},\n\009\009animation_skip_unsafe = {\n\009\009\009enabled = false,\n\009\009},\n\009\009speed_multiplier_uncap = {\n\009\009\009enabled = false,\n\009\009},\n\009},\n\n\009speed_multiplier = {\n\009\009enabled = true,\n\n\009\009key_1 = \"Alt\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"None\",\n\009\009key_2_gamepad = \"None\",\n\n\009\009default_value = 1,\n\n\009\009no_hold = {\n\009\009\009enabled = false,\n\009\009},\n\n\009\009settings_toggle = {\n\009\009\009enabled = true,\n\009\009},\n\n\009\009multiply = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"Wheel Up\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009divide = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"Wheel Down\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009},\n\n\009deselect_hand = {\n\009\009enabled = true,\n\009\009key_1 = \"Right Mouse\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"Right Stick\",\n\009\009key_2_gamepad = \"None\",\n\009},\n\n\009regular_keybinds = {\n\009\009enabled = true,\n\n\009\009play = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"(X)\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009discard = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"(Y)\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009sort_by_rank = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"Right Bumper\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009sort_by_suit = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"Left Bumper\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009toggle_sort = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\n\009\009reroll_shop = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"Q\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"(X)\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009leave_shop = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"(Y)\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\n\009\009skip_blind = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"(X)\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009select_blind = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"(Y)\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009reroll_boss = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\n\009\009run_info = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"(Guide)\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009run_info_blinds = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\n\009\009view_deck = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"Right Trigger\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\n\009\009lobby_info = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009},\n\n\009nopeus_interaction = {\n\009\009enabled = true,\n\n\009\009key_1 = \"]\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"None\",\n\009\009key_2_gamepad = \"None\",\n\n\009\009no_hold = {\n\009\009\009enabled = false,\n\009\009},\n\n\009\009increase = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"Wheel Up\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009decrease = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"Wheel Down\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009},\n\n\009not_just_yet_interaction = {\n\009\009enabled = true,\n\009\009key_1 = \"Enter\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"None\",\n\009\009key_2_gamepad = \"None\",\n\009},\n\n\009cryptid_code_use_last_interaction = {\n\009\009enabled = true,\n\009\009key_1 = \"None\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"None\",\n\009\009key_2_gamepad = \"None\",\n\009},\n\n\009animation_skip = {\n\009\009enabled = true,\n\n\009\009key_1 = \"Left Bracket\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"None\",\n\009\009key_2_gamepad = \"None\",\n\n\009\009default_value = 1,\n\n\009\009no_hold = {\n\009\009\009enabled = false,\n\009\009},\n\n\009\009settings_toggle = {\n\009\009\009enabled = true,\n\009\009},\n\n\009\009increase = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"Wheel Up\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009decrease = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"Wheel Down\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009},\n\n\009scoring_hold = {\n\009\009enabled = true,\n\009\009key_1 = \"None\",\n\009\009key_2 = \"None\",\n\009\009key_1_gamepad = \"None\",\n\009\009key_2_gamepad = \"None\",\n\n\009\009any_moment = {\n\009\009\009enabled = false,\n\009\009},\n\009},\n\n\009presets = {\n\009\009enabled = true,\n\n\009\009load_1 = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009load_2 = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009load_3 = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009load_next = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009},\n\n\009misc = {\n\009\009enabled = true,\n\n\009\009crash = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009open_mod_settings = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009save_run = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009quick_restart = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009\009start_fantoms_preview = {\n\009\009\009enabled = true,\n\009\009\009key_1 = \"None\",\n\009\009\009key_2 = \"None\",\n\009\009\009key_1_gamepad = \"None\",\n\009\009\009key_2_gamepad = \"None\",\n\009\009},\n\009},\n}\n\nHandy.config = {\n\009default = Handy.utils.table_merge({}, default_config),\n\009current = {},\n\n\009get_module = function(module)\n\009\009if not module then\n\009\009\009return nil\n\009\009end\n\009\009local override = Handy.get_module_override(module)\n\009\009if override then\n\009\009\009return Handy.utils.table_merge({}, module, override)\n\009\009end\n\009\009return module\n\009end,\n\009save = function()\n\009\009if SMODS and SMODS.save_mod_config and Handy.current_mod then\n\009\009\009Handy.current_mod.config = Handy.config.current\n\009\009\009SMODS.save_mod_config(Handy.current_mod)\n\009\009else\n\009\009\009love.filesystem.createDirectory(\"config\")\n\009\009\009local serialized = \"return \" .. Handy.utils.serialize(Handy.config.current)\n\009\009\009love.filesystem.write(\"config/Handy.jkr\", serialized)\n\009\009end\n\009\009if Handy.controller then\n\009\009\009Handy.controller.on_settings_save()\n\009\009end\n\009end,\n\009load = function()\n\009\009Handy.config.current = Handy.utils.table_merge({}, Handy.config.default)\n\009\009local lovely_mod_config = get_compressed(\"config/Handy.jkr\")\n\009\009if lovely_mod_config then\n\009\009\009Handy.config.current = Handy.utils.table_merge(Handy.config.current, STR_UNPACK(lovely_mod_config))\n\009\009end\n\009\009Handy.cc = Handy.config.current\n\009end,\n\n\009save_event = nil,\n\009request_save = function()\n\009\009if Handy.config.save_event and not Handy.config.save_event.complete then\n\009\009\009Handy.config.save_event.time = G.TIMERS[Handy.config.save_event.timer]\n\009\009else\n\009\009\009local event = Event({\n\009\009\009\009no_delete = true,\n\009\009\009\009blocking = false,\n\009\009\009\009blockable = false,\n\009\009\009\009timer = \"REAL\",\n\009\009\009\009trigger = \"after\",\n\009\009\009\009delay = 1,\n\009\009\009\009func = function()\n\009\009\009\009\009Handy.config.save()\n\009\009\009\009\009return true\n\009\009\009\009end,\n\009\009\009})\n\009\009\009Handy.config.save_event = event\n\009\009\009G.E_MANAGER:add_event(event, \"other\", true)\n\009\009end\n\009end,\n}\n\n-- Shorthand for `Handy.config.current`\nHandy.cc = Handy.config.current\nHandy.config.load()\n\n-- Since quick buy/sell and quick use now overrided on gamepad and I forgot to add default button in advance,\n-- I need to set it up back to make cards buyable/sellable again\nif not Handy.cc.__gamepad_buy_sell_use_default_overrided then\n\009if Handy.cc.insta_buy_or_sell.key_1_gamepad == \"None\" then\n\009\009Handy.cc.insta_buy_or_sell.key_1_gamepad = \"Left Bumper\"\n\009end\n\009if Handy.cc.insta_use.key_1_gamepad == \"None\" then\n\009\009Handy.cc.insta_buy_or_sell.key_1_gamepad = \"Right Bumper\"\n\009end\n\009Handy.cc.__gamepad_buy_sell_use_default_overrided = true\n\009Handy.config.save()\nend\n\n-- Ha-ha, funny Cryptid reference\n\n-- Resolve module with overrides\nfunction Handy.m(module)\n\009return Handy.config.get_module(module)\nend\n\nfunction Handy.is_mod_active()\n\009return Handy.cc.handy.enabled\nend\nfunction Handy.is_dangerous_actions_active()\n\009return Handy.cc.dangerous_actions.enabled and not Handy.is_in_multiplayer()\nend\nfunction Handy.get_module_override(module)\n\009return nil\nend\n",["display"]="modules/config.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/fake_events",["source"]="Handy.fake_events = {\n\009check = function(arg)\n\009\009if type(arg.func) ~= \"function\" then\n\009\009\009return false, nil\n\009\009end\n\009\009if arg.node then\n\009\009\009arg.func(arg.node)\n\009\009\009return arg.node.config.button ~= nil, arg.node.config.button\n\009\009else\n\009\009\009local fake_event = {\n\009\009\009\009UIBox = arg.UIBox,\n\009\009\009\009config = arg.config or {\n\009\009\009\009\009ref_table = arg.card,\n\009\009\009\009\009button = arg.button,\n\009\009\009\009\009id = arg.id,\n\009\009\009\009},\n\009\009\009}\n\009\009\009arg.func(fake_event)\n\009\009\009return fake_event.config.button ~= nil, fake_event.config.button\n\009\009end\n\009end,\n\009execute = function(arg)\n\009\009if type(arg.func) == \"function\" then\n\009\009\009if arg.node then\n\009\009\009\009arg.func(arg.node)\n\009\009\009else\n\009\009\009\009arg.func({\n\009\009\009\009\009UIBox = arg.UIBox,\n\009\009\009\009\009config = arg.config or {\n\009\009\009\009\009\009ref_table = arg.card,\n\009\009\009\009\009\009button = arg.button,\n\009\009\009\009\009\009id = arg.id,\n\009\009\009\009\009},\n\009\009\009\009})\n\009\009\009end\n\009\009end\n\009end,\n\009check_button = function(selector, options)\n\009\009options = options or {}\n\009\009local success, button = pcall(selector)\n\009\009if not success or not button or not button.config or not button.states then\n\009\009\009return false, button and button.config and button.config.button or nil\n\009\009end\n\009\009if options.visible and not button.states.visible then\n\009\009\009return false, button.config.button\n\009\009end\n\009\009local check_func = button.config.func\n\009\009if (options.require_func or options.require_exact_func) and not check_func then\n\009\009\009return false, button.config.button\n\009\009end\n\009\009if options.require_exact_func and check_func ~= options.require_exact_func then\n\009\009\009return false, button.config.button\n\009\009end\n\009\009if check_func then\n\009\009\009return Handy.fake_events.check({\n\009\009\009\009func = G.FUNCS[check_func],\n\009\009\009\009node = button,\n\009\009\009})\n\009\009else\n\009\009\009return true, button.config.button\n\009\009end\n\009end,\n\009execute_button = function(selector)\n\009\009local success, button = pcall(selector)\n\009\009if not success or not button or not button.config then\n\009\009\009return\n\009\009end\n\009\009if type(button.click) == \"function\" then\n\009\009\009button:click()\n\009\009else\n\009\009\009if button.config.button then\n\009\009\009\009Handy.fake_events.execute({\n\009\009\009\009\009func = G.FUNCS[button.config.button],\n\009\009\009\009\009node = button,\n\009\009\009\009})\n\009\009\009end\n\009\009end\n\009end,\n}\n",["display"]="modules/fake_events.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controller",["source"]="local key_from_raw_table = {\n\009[\"mouse1\"] = \"Left Mouse\",\n\009[\"mouse2\"] = \"Right Mouse\",\n\009[\"mouse3\"] = \"Middle Mouse\",\n\009[\"mouse4\"] = \"Mouse 4\",\n\009[\"mouse5\"] = \"Mouse 5\",\n\009[\"wheelup\"] = \"Wheel Up\",\n\009[\"wheeldown\"] = \"Wheel Down\",\n\009[\"lshift\"] = \"Shift\",\n\009[\"rshift\"] = \"Shift\",\n\009[\"lctrl\"] = \"Ctrl\",\n\009[\"rctrl\"] = \"Ctrl\",\n\009[\"lalt\"] = \"Alt\",\n\009[\"ralt\"] = \"Alt\",\n\009[\"lgui\"] = \"GUI\",\n\009[\"rgui\"] = \"GUI\",\n\009[\"return\"] = \"Enter\",\n\009[\"kpenter\"] = \"NUM Enter\",\n\009[\"pageup\"] = \"Page Up\",\n\009[\"pagedown\"] = \"Page Down\",\n\009[\"numlock\"] = \"Num Lock\",\n\009[\"capslock\"] = \"Caps Lock\",\n\009[\"scrolllock\"] = \"Scroll Lock\",\n\009[\"`\"] = \"Backquote\",\n\009[\"'\"] = \"Singlequote\",\n\009['\"'] = \"Quote\",\n\009[\"[\"] = \"Left Bracket\",\n\009[\"]\"] = \"Right Bracket\",\n}\nlocal keys_to_raw_table = {\n\009[\"Left Mouse\"] = { \"mouse1\" },\n\009[\"Right Mouse\"] = { \"mouse2\" },\n\009[\"Middle Mouse\"] = { \"mouse3\" },\n\009[\"Mouse 4\"] = { \"mouse4\" },\n\009[\"Mouse 5\"] = { \"mouse5\" },\n\009[\"Wheel Up\"] = { \"wheelup\" },\n\009[\"Wheel Down\"] = { \"wheeldown\" },\n\009[\"Shift\"] = { \"lshift\", \"rshift\" },\n\009[\"Ctrl\"] = { \"lctrl\", \"rctrl\" },\n\009[\"Alt\"] = { \"lalt\", \"ralt\" },\n\009[\"GUI\"] = { \"lgui\", \"rgui\" },\n\009[\"Enter\"] = { \"return\" },\n\009[\"NUM Enter\"] = { \"kpenter\" },\n\009[\"Page Up\"] = { \"pageup\" },\n\009[\"Page Down\"] = { \"pagedown\" },\n\009[\"Num Lock\"] = { \"numlock\" },\n\009[\"Caps Lock\"] = { \"capslock\" },\n\009[\"Scroll Lock\"] = { \"scrolllock\" },\n\009[\"Backquote\"] = { \"`\" },\n\009[\"Singlequote\"] = { \"'\" },\n\009[\"Quote\"] = { '\"' },\n\009[\"Left Bracket\"] = { \"[\" },\n\009[\"Right Bracket\"] = { \"]\" },\n\009[\"[\"] = { \"[\" },\n\009[\"]\"] = { \"]\" },\n}\n\nlocal gamepad_key_from_raw_table = {\n\009[\"a\"] = \"(A)\",\n\009[\"b\"] = \"(B)\",\n\009[\"x\"] = \"(X)\",\n\009[\"y\"] = \"(Y)\",\n\009[\"back\"] = \"(Back)\",\n\009[\"guide\"] = \"(Guide)\",\n\009[\"start\"] = \"(Start)\",\n\009[\"leftstick\"] = \"Left Stick\",\n\009[\"rightstick\"] = \"Right Stick\",\n\009[\"leftshoulder\"] = \"Left Bumper\",\n\009[\"rightshoulder\"] = \"Right Bumper\",\n\009[\"dpup\"] = \"(Up)\",\n\009[\"dpdown\"] = \"(Down)\",\n\009[\"dpleft\"] = \"(Left)\",\n\009[\"dpright\"] = \"(Right)\",\n\009-- Not present in current Love version (11.5.0)\n\009[\"misc1\"] = \"(Misc. Button)\",\n\009[\"paddle1\"] = \"First Paddle\",\n\009[\"paddle2\"] = \"Second Paddle\",\n\009[\"paddle3\"] = \"Third Paddle\",\n\009[\"paddle4\"] = \"Fourth Paddle\",\n\009[\"touchpad\"] = \"Touchpad Press\",\n\009-- Axis as button\n\009[\"triggerleft\"] = \"Left Trigger\",\n\009[\"triggerright\"] = \"Right Trigger\",\n}\nlocal gamepad_keys_to_raw_table = {\n\009[\"(A)\"] = { \"a\" },\n\009[\"(B)\"] = { \"b\" },\n\009[\"(X)\"] = { \"x\" },\n\009[\"(Y)\"] = { \"y\" },\n\009[\"(Back)\"] = { \"back\" },\n\009[\"(Guide)\"] = { \"guide\" },\n\009[\"(Start)\"] = { \"start\" },\n\009[\"Left Stick\"] = { \"leftstick\" },\n\009[\"Right Stick\"] = { \"rightstick\" },\n\009[\"Left Bumper\"] = { \"leftshoulder\" },\n\009[\"Right Bumper\"] = { \"rightshoulder\" },\n\009[\"(Up)\"] = { \"dpup\" },\n\009[\"(Down)\"] = { \"dpdown\" },\n\009[\"(Left)\"] = { \"dpleft\" },\n\009[\"(Right)\"] = { \"dpright\" },\n\009-- Not present in current Love version (11.5.0)\n\009[\"(Misc. Button)\"] = { \"misc1\" },\n\009[\"First Paddle\"] = { \"paddle1\" },\n\009[\"Second Paddle\"] = { \"paddle2\" },\n\009[\"Third Paddle\"] = { \"paddle3\" },\n\009[\"Fourth Paddle\"] = { \"paddle4\" },\n\009[\"Touchpad Press\"] = { \"touchpad\" },\n\009-- Axis as button\n\009[\"Left Trigger\"] = {\n\009\009\"triggerleft\",\n\009\009axis_check = function()\n\009\009\009return G.CONTROLLER.axis_buttons.l_trig.current == \"triggerleft\"\n\009\009end,\n\009},\n\009[\"Right Trigger\"] = {\n\009\009\"triggerright\",\n\009\009axis_check = function()\n\009\009\009return G.CONTROLLER.axis_buttons.r_trig.current == \"triggerright\"\n\009\009end,\n\009},\n}\n\nlocal mouse_raw_from_index_table = {\n\009[1] = \"mouse1\",\n\009[2] = \"mouse2\",\n\009[3] = \"mouse3\",\n\009[4] = \"mouse4\",\n\009[5] = \"mouse5\",\n}\nlocal mouse_key_to_index_table = {\n\009[\"Left Mouse\"] = 1,\n\009[\"Right Mouse\"] = 2,\n\009[\"Middle Mouse\"] = 3,\n\009[\"Mouse 4\"] = 4,\n\009[\"Mouse 5\"] = 5,\n}\n\nlocal wheel_raw_from_index_table = {\n\009[1] = \"wheelup\",\n\009[2] = \"wheeldown\",\n}\nlocal wheel_key_to_index_table = {\n\009[\"Wheel Up\"] = 1,\n\009[\"Wheel Down\"] = 2,\n}\n\nlocal non_holdable_keys_table = {\n\009[\"Wheel Up\"] = true,\n\009[\"Wheel Down\"] = true,\n}\nlocal non_safe_keys_table = {\n\009[\"Left Mouse\"] = true,\n\009[\"Right Mouse\"] = true,\n\009[\"(Left)\"] = true,\n\009[\"(Right)\"] = true,\n\009[\"(Up)\"] = true,\n\009[\"(Down)\"] = true,\n\009[\"(X)\"] = true,\n\009[\"(Y)\"] = true,\n\009[\"(A)\"] = true,\n\009[\"(B)\"] = true,\n}\n\nHandy.controller = {\n\009console_opened_timer = 0,\n\n\009debugplus_module = nil,\n\009get_debugplus_module = function()\n\009\009if Handy.controller.debugplus_module then\n\009\009\009return Handy.controller.debugplus_module\n\009\009end\n\009\009local success, dpconfig, dputils = pcall(function()\n\009\009\009return require(\"debugplus-config\"), require(\"debugplus-util\")\n\009\009end)\n\009\009if not success then\n\009\009\009success, dpconfig, dputils = pcall(function()\n\009\009\009\009return require(\"debugplus.config\"), require(\"debugplus.util\")\n\009\009\009en