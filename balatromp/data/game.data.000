        local m = UIBox_button({
            minw = 5,
            button = "talismanMenu",
            label = {
                "Amulet"
            },
            colour = G.C.GOLD
        })
        table.insert(contents.nodes[1].nodes[1].nodes[1].nodes, m)
        return contents
    end
end

