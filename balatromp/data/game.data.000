ed by current LOVE engine version\n\009\009\009[\"First Paddle\"] = nil, -- P1\n\009\009\009[\"Second Paddle\"] = nil, -- P2\n\009\009\009[\"Third Paddle\"] = nil, -- P3\n\009\009\009[\"Fourth Paddle\"] = nil, -- P4\n\009\009\009[\"(Misc. Button)\"] = nil,\n\009\009\009-- Gamepad: touchpad\n\009\009\009[\"Touchpad Press\"] = nil,\n\n\009\009\009-- Not listed here, but can be added if you ever need:\n\009\009\009-- All english letters uppercase, (Q, W, E, R, T, Y...)\n\009\009\009-- All numbers (1, 2, 3...0)\n\009\009\009-- All F keys (F1, F2, F3...)\n\009\009\009-- All NUM keys (NUM 0 ... NUM 9, NUM Enter, NUM +, NUM -, NUM *, NUM /, NUM .)\n\009\009\009-- Other symbols (. ; / \\ - + etc)\n\009\009},\n\009\009handy_keybind_labels = {\n\009\009\009play_hand = \"Jugar mano\",\n\009\009\009discard = \"Descartar\",\n\009\009\009toggle_sort = \"Alternar forma de ordenar\",\n\009\009\009sort_by_rank = \"Ordenar por nÃºmero\",\n\009\009\009sort_by_suit = \"Ordenar por palo\",\n\009\009\009deselect_hand = \"Deseleccionar mano\",\n\009\009\009cash_out = \"Cobrar\",\n\009\009\009not_just_yet_end_round = \"NotJustYet: Terminar ronda\",\n\009\009\009skip_booster = \"Omitir paquete potenciador\",\n\009\009\009reroll_shop = \"Renovar tienda\",\n\009\009\009leave_shop = \"Salir de la tienda\",\n\009\009\009skip_blind = \"Saltar ciega\",\n\009\009\009select_blind = \"Seleccionar ciega\",\n\009\009\009reroll_boss = \"Renovar jefe\",\n\009\009\009run_info_hands = \"Partida Info: manos de poker\",\n\009\009\009run_info_blinds = \"Partida Info: ciegas\",\n\009\009\009lobby_info = \"Multijugador: informaciÃ³n de la sala\",\n\009\009\009view_deck = \"Ver mazo\",\n\009\009\009deck_preview = \"Previsualizar mazo\",\n\009\009\009quick_highlight = \"SelecciÃ³n de mano rÃ¡pida\",\n\009\009\009quick_buy_or_sell = \"Comprar/Vender rÃ¡pido\",\n\009\009\009quick_buy_n_sell = \"Comprar y vender rÃ¡pido\",\n\009\009\009quick_use = \"Usar rÃ¡pido\",\n\009\009\009highlight_entire_f_hand = \"Destacar 