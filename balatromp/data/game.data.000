local balatro_ver
local M = {}

function M.getBalatroVersion()
    if balatro_ver then return balatro_ver end
    local versionFile = love.filesystem.read("version.jkr")
    if versionFile then
        balatro_ver = versionFile:match("[^\n]*")
        return balatro_ver
