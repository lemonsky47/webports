                nodes = {
                    create_column_tabs({
                        tab_alignment = 'tl',
                        tab_w = 11.5,
                        tab_h = 4.3,-- this seems to not do shit?
                        text_scale = 0.4,
                        snap_to_nav = true,
                        colour =  G.C.CLEAR,-- G.C.RED,
                        tabs = vertical_tabs
                    })
                }
            },
        }
