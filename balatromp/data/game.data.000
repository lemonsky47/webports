009\009\009\009{\n\009\009\009\009\009n = G.UIT.R,\n\009\009\009\009\009config = {\n\009\009\009\009\009\009colour = adjust_alpha(HEX(\"000000\"), 0.1),\n\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009\009padding = 0.25,\n\009\009\009\009\009\009r = 0.5,\n\009\009\009\009\009},\n\009\009\009\009\009nodes = {\n\009\009\009\009\009\009{\n\009\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009\009config = {\n\009\009\009\009\009\009\009\009padding = 0.05,\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009\009Handy.UI.CD.presets_load_1.keybind(),\n\009\009\009\009\009\009\009\009Handy.UI.CD.presets_load_2.keybind(),\n\009\009\009\009\009\009\009\009Handy.UI.CD.presets_load_3.keybind(),\n\009\009\009\009\009\009\009\009Handy.UI.CD.presets_load_next.keybind(),\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009\009Handy.UI.PARTS.create_separator_r(0.25),\n\009\009{\n\009\009\009n = G.UIT.R,\n\009\009\009config = { padding = 0.1, align = \"cm\" },\n\009\009\009nodes = {\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.T,\n\009\009\009\009\009config = {\n\009\009\009\009\009\009text = localize({\n\009\009\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009\009\009key = \"Handy_presets_guide\",\n\009\009\009\009\009\009\009vars = {},\n\009\009\009\009\009\009}),\n\009\009\009\009\009\009scale = 0.3,\n\009\009\009\009\009\009colour = { 1, 1, 1, 0.6 },\n\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009}\nend\nHandy.UI.get_config_tab_dangerous = function()\n\009local gamepad = Handy.controller.is_gamepad()\n\009return {\n\009\009{\n\009\009\009n = G.UIT.R,\n\009\009\009config = {\n\009\009\009\009align = \"cm\",\n\009\009\009},\n\009\009\009nodes = {\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.R,\n\009\009\009\009\009config = {\n\009\009\009\009\009\009padding = 0.25,\n\009\009\009\009\009\009r = 0.5,\n\009\009\009\009\009\009colour = adjust_alpha(HEX(\"000000\"), 0.1),\n\009\009\009\009\009},\n\009\009\009\009\009nodes = {\n\009\009\009\009\009\009Handy.UI.CD.dangerous_actions.checkbox({ full_width = true }),\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009{\n\009\009\009n = G.UIT.R,\n\009\009\009nodes = {\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = { minw = 4 },\n\009\009\009\009\009nodes = {\n\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009Handy.UI.CD.dangerous_speed_multiplier_uncap.checkbox(),\n\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009Handy.UI.CD.dangerous_nopeus_unsafe.checkbox(),\n\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009Handy.UI.CD.dangerous_animation_skip_unsafe.checkbox(),\n\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009Handy.UI.CD.immediate_buy_and_sell_queue.checkbox(),\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = { minw = 4 },\n\009\009\009\009\009nodes = {\n\009\009\009\009\009\009Handy.UI.CD.immediate_buy_and_sell.checkbox(),\n\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009Handy.UI.CD.sell_all_same_modifier.checkbox(),\n\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009Handy.UI.CD.sell_all_modifier.checkbox(),\n\009\009\009\009\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009\009\009\009\009Handy.UI.CD.remove_modifier.checkbox(),\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\n\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009{\n\009\009\009n = G.UIT.R,\n\009\009\009config = { align = \"cm\" },\n\009\009\009nodes = {\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.R,\n\009\009\009\009\009config = {\n\009\009\009\009\009\009colour = adjust_alpha(HEX(\"000000\"), 0.1),\n\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009\009padding = 0.25,\n\009\009\009\009\009\009r = 0.5,\n\009\009\009\009\009},\n\009\009\009\009\009nodes = {\n\009\009\009\009\009\009{\n\009\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009\009config = {\n\009\009\009\009\009\009\009\009padding = 0.05,\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009\009Handy.UI.CD.insta_buy_or_sell.keybind({ rerender = true }),\n\009\009\009\009\009\009\009\009Handy.UI.CD.immediate_buy_and_sell.keybind({ rerender = true }),\n\009\009\009\009\009\009\009\009Handy.UI.CD.sell_all_same_modifier.keybind({ rerender = true }),\n\009\009\009\009\009\009\009\009Handy.UI.CD.sell_all_modifier.keybind({ rerender = true }),\n\009\009\009\009\009\009\009\009Handy.UI.CD.remove_modifier.keybind({ rerender = true }),\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009\009Handy.UI.PARTS.create_separator_r(),\n\009\009{\n\009\009\009n = G.UIT.R,\n\009\009\009config = { padding = 0.05, align = \"cm\" },\n\009\009\009nodes = {\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.T,\n\009\009\009\009\009config = {\n\009\009\009\009\009\009text = localize({\n\009\009\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009\009\009key = \"Handy_danger_zone_guide\",\n\009\009\009\009\009\009\009vars = {},\n\009\009\009\009\009\009}),\n\009\009\009\009\009\009scale = 0.3,\n\009\009\009\009\009\009colour = { 1, 1, 1, 0.6 },\n\009\009\009\009\009\009align = \"cm\",\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009}\nend\nHandy.UI.get_config_tab_search = function()\n\009local gamepad = Handy.controller.is_gamepad()\n\009local result = Handy.UI.search(Handy.UI.search_input_value or \"\")\n\009local result_content = {}\n\009if #result > 0 then\n\009\009result_content = Handy.UI.get_search_result_page(result)\n\009else\n\009\009result_content = Handy.UI.get_search_no_result_page()\n\009end\n\n\009result_content = {\n\009\009n = G.UIT.R,\n\009\009config = {\n\009\009\009align = \"cm\",\n\009\009},\n\009\009nodes = result_content,\n\009}\n\n\009local result_ui = {\n\009\009{\n\009\009\009n = G.UIT.R,\n\009\009\009config = {\n\009\009\009\009padding = 0.25,\n\009\009\009\009r = 0.5,\n\009\009\009\009colour = adjust_alpha(HEX(\"000000\"), 0.1),\n\009\009\009\009align = \"cm\",\n\009\009\009\009minw = 14,\n\009\009\009},\n\009\009\009nodes = {\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.R,\n\009\009\009\009\009config = { align = \"cm\" },\n\009\009\009\009\009nodes = {\n\009\009\009\009\009\009{\n\009\009\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009\009\009config = {},\n\009\009\009\009\009\009\009nodes = {\n\009\009\009\009\009\009\009\009create_text_input({\n\009\009\009\009\009\009\009\009\009w = 4,\n\009\009\009\009\009\009\009\009\009max_length = 32,\n\009\009\009\009\009\009\009\009\009ref_table = Handy.UI,\n\009\009\009\009\009\009\009\009\009ref_value = \"search_input_value\",\n\009\009\009\009\009\009\009\009\009extended_corpus = true,\n\009\009\009\009\009\009\009\009\009id = \"handy_search\",\n\009\009\009\009\009\009\009\009\009prompt_text = localize(\"b_handy_search_placeholder\"),\n\009\009\009\009\009\009\009\009\009callback = function()\n\009\009\009\009\009\009\009\009\009\009if not Handy.controller.is_gamepad() then\n\009\009\009\009\009\009\009\009\009\009\009Handy.UI.render_search_results(true)\n\009\009\009\009\009\009\009\009\009\009end\n\009\009\009\009\009\009\009\009\009end,\n\009\009\009\009\009\009\009\009}),\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009},\n\009\009\009\009\009\009Handy.UI.PARTS.create_separator_c(),\n\009\009\009\009\009\009UIBox_button({\n\009\009\009\009\009\009\009label = { localize(\"b_handy_clear\") },\n\009\009\009\009\009\009\009col = true,\n\009\009\009\009\009\009\009colour = G.C.MULT,\n\009\009\009\009\009\009\009scale = 0.4,\n\009\009\009\009\009\009\009minh = 0.6,\n\009\009\009\009\009\009\009maxh = 0.6,\n\009\009\009\009\009\009\009minw = 2,\n\009\009\009\009\009\009\009maxw = 2,\n\009\009\009\009\009\009\009button = \"handy_clear_search\",\n\009\009\009\009\009\009}),\n\009\009\009\009\009\009Handy.UI.PARTS.create_separator_c(0.05),\n\009\009\009\009\009\009UIBox_button({\n\009\009\009\009\009\009\009label = { localize(\"b_handy_search\") },\n\009\009\009\009\009\009\009col = true,\n\009\009\009\009\009\009\009colour = G.C.CHIPS,\n\009\009\009\009\009\009\009scale = 0.4,\n\009\009\009\009\009\009\009minh = 0.6,\n\009\009\009\009\009\009\009maxh = 0.6,\n\009\009\009\009\009\009\009minw = 2,\n\009\009\009\009\009\009\009maxw = 2,\n\009\009\009\009\009\009\009button = \"handy_apply_search\",\n\009\009\009\009\009\009}),\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009}\n\009if gamepad then\n\009\009table.insert(result_ui, 1, Handy.UI.PARTS.create_separator_r())\n\009\009table.insert(result_ui, 1, result_content)\n\009else\n\009\009table.insert(result_ui, Handy.UI.PARTS.create_separator_r())\n\009\009table.insert(result_ui, result_content)\n\009end\n\009return {\n\009\009{\n\009\009\009n = G.UIT.R,\n\009\009\009config = {\n\009\009\009\009align = \"cm\",\n\009\009\009},\n\009\009\009nodes = result_ui,\n\009\009},\n\009}\nend\n\nfunction Handy.UI.render_search_results(rerender)\n\009G.E_MANAGER:add_event(Event({\n\009\009blocking = false,\n\009\009blockable = false,\n\009\009no_pause = true,\n\009\009no_delete = true,\n\009\009func = function()\n\009\009\009Handy.UI.rerender(true)\n\009\009\009return true\n\009\009end,\n\009}))\nend\n\n-- Tabs order\n\nHandy.UI.PARTS.tabs_list = {\n\009[\"Overall\"] = {\n\009\009definition = function()\n\009\009\009return Handy.UI.get_config_tab_overall()\n\009\009end,\n\009},\n\009[\"Quick\"] = {\n\009\009definition = function()\n\009\009\009return Handy.UI.get_config_tab_quick_paginated()\n\009\009end,\n\009},\n\009[\"Keybinds\"] = {\n\009\009definition = function()\n\009\009\009return Handy.UI.get_config_tab_regular_keybinds()\n\009\009end,\n\009},\n\009[\"Keybinds 2\"] = {\n\009\009definition = function()\n\009\009\009return Handy.UI.get_config_tab_keybinds_2()\n\009\009end,\n\009},\n\009[\"Keybinds Paginated\"] = {\n\009\009definition = function()\n\009\009\009return Handy.UI.get_config_tab_keybinds_paginated()\n\009\009end,\n\009},\n\009[\"Dangerous\"] = {\n\009\009definition = function()\n\009\009\009return Handy.UI.get_config_tab_dangerous()\n\009\009end,\n\009},\n\009[\"Presets\"] = {\n\009\009definition = function()\n\009\009\009return Handy.UI.get_config_tab_presets()\n\009\009end,\n\009},\n\009[\"Search\"] = {\n\009\009definition = function()\n\009\009\009return Handy.UI.get_config_tab_search()\n\009\009end,\n\009},\n}\nHandy.UI.PARTS.tabs_order = {\n\009\"Overall\",\n\009\"Quick\",\n\009-- \"Keybinds\",\n\009-- \"Keybinds 2\",\n\009\"Keybinds Paginated\",\n\009\"Presets\",\n\009\"Dangerous\",\n\009\"Search\",\n}\n\n-- Getters\n\nfunction Handy.UI.get_config_tab(_tab, _index)\n\009local result = {\n\009\009n = G.UIT.ROOT,\n\009\009config = { align = \"cm\", padding = 0.05, colour = G.C.CLEAR, minh = 5, minw = 5 },\n\009\009nodes = {},\n\009}\n\009Handy.UI.config_tab_index = _index\n\009result.nodes = Handy.UI.PARTS.tabs_list[_tab].definition()\n\009return result\nend\nfunction Handy.UI.get_options_tabs()\n\009local result = {}\n\009for index, k in ipairs(Handy.UI.PARTS.tabs_order) do\n\009\009table.insert(result, {\n\009\009\009label = localize(k, \"handy_tabs\"),\n\009\009\009tab_definition_function = function()\n\009\009\009\009return Handy.UI.get_config_tab(k, index)\n\009\009\009end,\n\009\009})\n\009end\n\009return result\nend\n",["display"]="modules/ui/config_tabs.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/ui/config",["source"]="-- Inserting options button\n\nfunction Handy.UI.reset_config_variables()\n\009Handy.UI.config_opened = nil\n\009Handy.UI.config_tab_index = 1\n\009Handy.UI.keybinds_page = 1\n\009Handy.UI.quick_page = 1\n\009Handy.UI.search_input_value = \"\"\nend\nHandy.UI.reset_config_variables()\n\nfunction Handy.UI.get_options_button()\n\009return UIBox_button({ label = { \"Handy\" }, button = \"handy_open_options\", minw = 5, colour = G.C.CHIPS })\nend\n-- Code taken from Anhk by MathIsFun\nlocal create_uibox_options_ref = create_UIBox_options\nfunction create_UIBox_options()\n\009local contents = create_uibox_options_ref()\n\009if Handy.UI.show_options_button then\n\009\009table.insert(contents.nodes[1].nodes[1].nodes[1].nodes, Handy.UI.get_options_button())\n\009end\n\009return contents\nend\n\n-- Options render\n\nfunction G.UIDEF.handy_options(from_smods)\n\009local tabs = Handy.UI.get_options_tabs()\n\009tabs[Handy.UI.config_tab_index or 1].chosen = true\n\009local t = create_UIBox_generic_options({\n\009\009back_func = from_smods and \"mods_button\" or \"handy_exit_options\",\n\009\009contents = {\n\009\009\009{\n\009\009\009\009n = G.UIT.R,\n\009\009\009\009config = { align = \"cm\", padding = 0 },\n\009\009\009\009nodes = {\n\009\009\009\009\009create_tabs({\n\009\009\009\009\009\009tabs = tabs,\n\009\009\009\009\009\009snap_to_nav = true,\n\009\009\009\009\009\009no_shoulders = true,\n\009\009\009\009\009\009colour = G.C.BOOSTER,\n\009\009\009\009\009}),\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009})\n\009return t\nend\n\n-- Rerender\n\n-- TODO: fix optimization here at some point\nfunction Handy.UI.rerender(silent)\n\009local result\n\009if SMODS and G.ACTIVE_MOD_UI and G.ACTIVE_MOD_UI == Handy.current_mod then\n\009\009result = {\n\009\009\009definition = G.UIDEF.handy_options(true),\n\009\009}\n\009elseif Handy.UI.config_opened then\n\009\009result = {\n\009\009\009definition = G.UIDEF.handy_options(),\n\009\009}\n\009end\n\009if result then\n\009\009if silent then\n\009\009\009G.ROOM.jiggle = G.ROOM.jiggle - 1\n\009\009\009result.config = {\n\009\009\009\009offset = {\n\009\009\009\009\009x = 0,\n\009\009\009\009\009y = 0,\n\009\009\009\009},\n\009\009\009}\n\009\009end\n\009\009G.FUNCS.overlay_menu(result)\n\009\009G.OVERLAY_MENU:recalculate()\n\009\009Handy.utils.cleanup_dead_elements(G, \"MOVEABLES\")\n\009end\nend\n\n-- For some reason, rendering checkbox on search page make same checkboxes spawn without sprite in it (at least for a first frame)\n-- No idea why tbh, but looks like they're working fine, so I'll just prevent this crash\nlocal toggle_ref = G.FUNCS.toggle\nfunction G.FUNCS.toggle(e, ...)\n\009if e.children and e.children[1] then\n\009\009return toggle_ref(e, ...)\n\009end\nend\n\nif SMODS then\n\009local create_UIBox_mods_ref = create_UIBox_mods\n\009function create_UIBox_mods(...)\n\009\009if G.ACTIVE_MOD_UI and G.ACTIVE_MOD_UI == Handy.current_mod then\n\009\009\009Handy.UI.reset_config_variables()\n\009\009\009Handy.UI.config_opened = true\n\009\009\009return G.UIDEF.handy_options(true)\n\009\009end\n\009\009return create_UIBox_mods_ref(...)\n\009end\n\n\009local mods_button_ref = G.FUNCS.mods_button\n\009function G.FUNCS.mods_button(...)\n\009\009Handy.UI.reset_config_variables()\n\009\009return mods_button_ref(...)\n\009end\nend\n",["display"]="modules/ui/config.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/presets_switch",["source"]="Handy.presets_switch = {\n\009get_action = function(key)\n\009\009if Handy.controller.is_module_key(Handy.cc.presets.load_1, key) then\n\009\009\009return true, 1\n\009\009elseif Handy.controller.is_module_key(Handy.cc.presets.load_2, key) then\n\009\009\009return true, 2\n\009\009elseif Handy.controller.is_module_key(Handy.cc.presets.load_3, key) then\n\009\009\009return true, 3\n\009\009elseif Handy.controller.is_module_key(Handy.cc.presets.load_next, key) then\n\009\009\009return true, \"next\"\n\009\009else\n\009\009\009return false, nil\n\009\009end\n\009end,\n\009get_next_preset_index = function(key)\n\009\009local action, load_index = Handy.presets_switch.get_action(key)\n\009\009if not action or not load_index then\n\009\009\009return false, nil, false\n\009\009end\n\009\009if type(load_index) == \"number\" then\n\009\009\009local preset = Handy.presets.current.user[load_index]\n\009\009\009return true, load_index, preset.config and preset.enabled or false\n\009\009end\n\009\009if load_index == \"next\" then\n\009\009\009local available = {}\n\009\009\009for i = 1, 3 do\n\009\009\009\009local preset = Handy.presets.current.user[i]\n\009\009\009\009if preset.enabled and preset.config then\n\009\009\009\009\009table.insert(available, i)\n\009\009\009\009end\n\009\009\009end\n\009\009\009if #available == 0 then\n\009\009\009\009return false, nil, false\n\009\009\009elseif #available == 1 then\n\009\009\009\009return true, available[1], true\n\009\009\009else\n\009\009\009\009local current_index = Handy.presets.current.selected\n\009\009\009\009-- search for first index which is bigger than current\n\009\009\009\009for _, next_index in ipairs(available) do\n\009\009\009\009\009if next_index > current_index then\n\009\009\009\009\009\009return true, next_index, true\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009\009-- If not, use lowest one\n\009\009\009\009return true, available[1], true\n\009\009\009end\n\009\009end\n\009\009return false, nil, false\n\009end,\n\n\009can_execute = function(key)\n\009\009return not G.SETTINGS.paused and not G.OVERLAY_MENU and Handy.controller.is_module_enabled(Handy.cc.presets)\n\009end,\n\009execute = function(key)\n\009\009local is_found, preset_index, available = Handy.presets_switch.get_next_preset_index(key)\n\009\009if not is_found or not available then\n\009\009\009return false\n\009\009end\n\009\009Handy.presets.apply_index(preset_index)\n\009\009return true\n\009end,\n\n\009use = function(key)\n\009\009return Handy.presets_switch.can_execute(key) and Handy.presets_switch.execute(key) or false\n\009end,\n\n\009update_state_panel = function(state, key, released)\n\009\009if released or Handy.cc.notifications_level < 3 then\n\009\009\009return false\n\009\009end\n\009\009local action, load_index = Handy.presets_switch.get_action(key)\n\009\009if not action or not load_index then\n\009\009\009return false\n\009\009end\n\009\009if type(load_index) == \"number\" then\n\009\009\009local preset = Handy.presets.current.user[load_index]\n\009\009\009local is_applied = preset.config and preset.enabled\n\009\009\009local result_string = \"\"\n\009\009\009if is_applied then\n\009\009\009\009result_string = localize({\n\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009key = \"Handy_preset_loaded\",\n\009\009\009\009\009vars = { load_index, preset.name or \"\" },\n\009\009\009\009})\n\009\009\009elseif not preset.enabled then\n\009\009\009\009result_string = localize({\n\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009key = \"Handy_preset_disabled\",\n\009\009\009\009\009vars = { load_index, preset.name or \"\" },\n\009\009\009\009})\n\009\009\009elseif not preset.config then\n\009\009\009\009result_string = localize({\n\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009key = \"Handy_preset_empty\",\n\009\009\009\009\009vars = { load_index, preset.name or \"\" },\n\009\009\009\009})\n\009\009\009end\n\009\009\009state.items.presets_change = {\n\009\009\009\009text = result_string,\n\009\009\009\009hold = false,\n\009\009\009\009order = 15,\n\009\009\009}\n\009\009\009return true\n\009\009elseif load_index == \"next\" then\n\009\009\009local is_applied = false\n\009\009\009for i = 1, 3 do\n\009\009\009\009local preset = Handy.presets.current.user[i]\n\009\009\009\009if preset.enabled and preset.config then\n\009\009\009\009\009is_applied = true\n\009\009\009\009\009break\n\009\009\009\009end\n\009\009\009end\n\009\009\009local result_string\n\009\009\009if is_applied then\n\009\009\009\009local current_index = Handy.presets.current.selected\n\009\009\009\009local preset = Handy.presets.current.user[current_index]\n\009\009\009\009result_string = localize({\n\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009key = \"Handy_preset_loaded\",\n\009\009\009\009\009vars = { current_index, preset.name or \"\" },\n\009\009\009\009})\n\009\009\009else\n\009\009\009\009result_string = localize({\n\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009key = \"Handy_preset_nothing_to_load\",\n\009\009\009\009\009vars = {},\n\009\009\009\009})\n\009\009\009end\n\009\009\009state.items.presets_change = {\n\009\009\009\009text = result_string,\n\009\009\009\009hold = false,\n\009\009\009\009order = 15,\n\009\009\009}\n\009\009\009return true\n\009\009end\n\009\009return false\n\009end,\n}\n\nHandy.register_module(\"presets_switch\", Handy.presets_switch)\n",["display"]="modules/controls/presets_switch.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/insta_cash_out",["source"]="Handy.insta_cash_out = {\n\009is_hold = false,\n\n\009can_skip = false,\n\009is_skipped = false,\n\n\009can_execute = function()\n\009\009return not not (\n\009\009\009Handy.insta_cash_out.is_hold\n\009\009\009and G.STATE == G.STATES.ROUND_EVAL\n\009\009\009and not G.SETTINGS.paused\n\009\009\009and not G.OVERLAY_MENU\n\009\009\009and Handy.insta_cash_out.can_skip\n\009\009\009and not Handy.insta_cash_out.is_skipped\n\009\009\009and G.round_eval\n\009\009)\n\009end,\n\009execute = function()\n\009\009Handy.insta_cash_out.is_skipped = true\n\n\009\009G.E_MANAGER:add_event(Event({\n\009\009\009trigger = \"immediate\",\n\009\009\009func = function()\n\009\009\009\009Handy.fake_events.execute({\n\009\009\009\009\009func = G.FUNCS.cash_out,\n\009\009\009\009\009id = \"cash_out_button\",\n\009\009\009\009})\n\009\009\009\009return true\n\009\009\009end,\n\009\009}))\n\009\009return true\n\009end,\n\n\009update = function(dt)\n\009\009Handy.insta_cash_out.is_hold = (\n\009\009\009G.STAGE == G.STAGES.RUN\n\009\009\009and Handy.is_mod_active()\n\009\009\009and not Handy.controller.is_debugplus_console_opened()\n\009\009\009and Handy.controller.is_module_key_down(Handy.cc.insta_cash_out)\n\009\009)\n\009\009return Handy.insta_cash_out.can_execute() and Handy.insta_cash_out.execute() or false\n\009end,\n}\n\nHandy.register_module(\"insta_cash_out\", Handy.insta_cash_out)\n",["display"]="modules/controls/insta_cash_out.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/insta_booster_skip",["source"]="Handy.insta_booster_skip = {\n\009is_hold = false,\n\009is_skipped = false,\n\009previou_pack_cards = nil,\n\009throttle_thing = 0,\n\n\009can_execute = function()\n\009\009return not not (\n\009\009\009Handy.insta_booster_skip.is_hold\n\009\009\009and not Handy.insta_booster_skip.is_skipped\n\009\009\009and not G.SETTINGS.paused\n\009\009\009and not G.OVERLAY_MENU\n\009\009\009and G.booster_pack\n\009\009\009and G.pack_cards\n\009\009\009and G.pack_cards.cards[1]\n\009\009\009and not Handy.is_stop_use()\n\009\009\009and Handy.fake_events.check({\n\009\009\009\009func = G.FUNCS.can_skip_booster,\n\009\009\009})\n\009\009)\n\009end,\n\009execute = function()\n\009\009Handy.insta_booster_skip.is_skipped = true\n\009\009G.E_MANAGER:add_event(Event({\n\009\009\009func = function()\n\009\009\009\009Handy.fake_events.execute({\n\009\009\009\009\009func = G.FUNCS.skip_booster,\n\009\009\009\009})\n\009\009\009\009return true\n\009\009\009end,\n\009\009}))\n\009\009if Handy.cc.notifications_level >= 4 then\n\009\009\009Handy.UI.state_panel.display(function(state)\n\009\009\009\009state.items.insta_booster_skip = {\n\009\009\009\009\009text = localize({\n\009\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009\009key = \"Handy_skip_booster_pack\",\n\009\009\009\009\009\009vars = {},\n\009\009\009\009\009}),\n\009\009\009\009\009hold = false,\n\009\009\009\009\009order = 10,\n\009\009\009\009}\n\009\009\009\009return true\n\009\009\009end)\n\009\009end\n\009\009return true\n\009end,\n\n\009update = function(dt)\n\009\009Handy.insta_booster_skip.is_hold = (\n\009\009\009G.STAGE == G.STAGES.RUN\n\009\009\009and Handy.is_mod_active()\n\009\009\009and not Handy.controller.is_debugplus_console_opened()\n\009\009\009and Handy.controller.is_module_key_down(Handy.cc.insta_booster_skip)\n\009\009)\n\009\009return Handy.insta_booster_skip.can_execute() and Handy.insta_booster_skip.execute() or false\n\009end,\n}\n\nHandy.register_module(\"insta_booster_skip\", Handy.insta_booster_skip)\n",["display"]="modules/controls/insta_booster_skip.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/deselect_hand",["source"]="Handy.deselect_hand = {\n\009should_prevent = function()\n\009\009return Handy.is_mod_active() and Handy.controller.is_module_enabled(Handy.cc.deselect_hand)\n\009end,\n\n\009can_execute = function(key)\n\009\009return not not (\n\009\009\009G.STATE ~= G.STATES.HAND_PLAYED\n\009\009\009and G.hand\n\009\009\009and G.hand.states.visible\n\009\009\009and G.hand.highlighted[1]\n\009\009\009-- Vanilla check\n\009\009\009and not ((G.play and #G.play.cards > 0) or Handy.is_stop_use())\n\009\009\009and Handy.is_mod_active()\n\009\009\009and Handy.controller.is_module_key(Handy.cc.deselect_hand, key)\n\009\009\009-- Selecting cards over hand deselection\n\009\009\009and not Handy.insta_highlight.can_execute(Handy.last_hovered_card)\n\009\009)\n\009end,\n\009execute = function()\n\009\009G.hand:unhighlight_all()\n\009\009return true\n\009end,\n\n\009use = function(key)\n\009\009return Handy.deselect_hand.can_execute(key) and Handy.deselect_hand.execute() or false\n\009end,\n}\n\nHandy.register_module(\"deselect_hand\", Handy.deselect_hand)\n",["display"]="modules/controls/deselect_hand.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/show_deck_preview",["source"]="Handy.show_deck_preview = {\n\009is_hold = false,\n\n\009get_is_hold = function()\n\009\009if Handy.is_mod_active() and Handy.controller.is_module_enabled(Handy.cc.show_deck_preview) then\n\009\009\009return G.STAGE == G.STAGES.RUN and Handy.controller.is_module_key_down(Handy.cc.show_deck_preview)\n\009\009else\n\009\009\009return not not G.CONTROLLER.held_buttons.triggerleft\n\009\009end\n\009end,\n\n\009update = function(dt)\n\009\009Handy.show_deck_preview.is_hold = Handy.show_deck_preview.get_is_hold()\n\009end,\n}\n\nHandy.register_module(\"show_deck_preview\", Handy.show_deck_preview)\n",["display"]="modules/controls/show_deck_preview.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/regular_keybinds",["source"]="Handy.regular_keybinds = {\n\009shop_reroll_blocker = false,\n\009play_blocker = false,\n\009discard_blocker = false,\n\n\009shop_loaded = false,\n\n\009swappable_overlay = false,\n\n\009toggle_swappable_overlay = function(b)\n\009\009if b then\n\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009blockable = false,\n\009\009\009\009blocking = false,\n\009\009\009\009no_delete = true,\n\009\009\009\009pause_force = true,\n\009\009\009\009timer = \"REAL\",\n\009\009\009\009func = function()\n\009\009\009\009\009Handy.regular_keybinds.swappable_overlay = true\n\009\009\009\009\009return true\n\009\009\009\009end,\n\009\009\009}))\n\009\009else\n\009\009\009Handy.regular_keybinds.swappable_overlay = false\n\009\009end\n\009end,\n\n\009can_play = function(key)\n\009\009return not Handy.regular_keybinds.play_blocker\n\009\009\009and Handy.controller.is_module_key(Handy.cc.regular_keybinds.play, key)\n\009\009\009and not Handy.is_stop_use()\n\009\009\009and Handy.fake_events.check_button(function()\n\009\009\009\009return G.buttons.states.visible and G.buttons:get_UIE_by_ID(\"play_button\")\n\009\009\009end, { visible = true })\n\009end,\n\009play = function()\n\009\009Handy.regular_keybinds.play_blocker = true\n\009\009Handy.fake_events.execute_button(function()\n\009\009\009return G.buttons:get_UIE_by_ID(\"play_button\")\n\009\009end)\n\009\009G.E_MANAGER:add_event(Event({\n\009\009\009no_delete = true,\n\009\009\009blocking = false,\n\009\009\009func = function()\n\009\009\009\009Handy.regular_keybinds.play_blocker = false\n\009\009\009\009return true\n\009\009\009end,\n\009\009}))\n\009\009return true\n\009end,\n\n\009can_discard = function(key)\n\009\009return not Handy.regular_keybinds.discard_blocker\n\009\009\009and Handy.controller.is_module_key(Handy.cc.regular_keybinds.discard, key)\n\009\009\009and not Handy.is_stop_use()\n\009\009\009and Handy.fake_events.check_button(function()\n\009\009\009\009return G.buttons.states.visible and G.buttons:get_UIE_by_ID(\"discard_button\")\n\009\009\009end, { visible = true })\n\009end,\n\009discard = function()\n\009\009Handy.regular_keybinds.discard_blocker = true\n\009\009Handy.fake_events.execute_button(function()\n\009\009\009return G.buttons:get_UIE_by_ID(\"discard_button\")\n\009\009end)\n\009\009G.E_MANAGER:add_event(Event({\n\009\009\009no_delete = true,\n\009\009\009blocking = false,\n\009\009\009func = function()\n\009\009\009\009Handy.regular_keybinds.discard_blocker = false\n\009\009\009\009return true\n\009\009\009end,\n\009\009}))\n\009\009return true\n\009end,\n\n\009get_current_sorting = function(opposite)\n\009\009local hand_sorting = G.hand and G.hand.config.sort or \"suit desc\"\n\009\009local sortings = { \"rank\", \"suit\" }\n\009\009local sort_index = 0\n\009\009if hand_sorting == \"suit desc\" then\n\009\009\009sort_index = 1\n\009\009elseif hand_sorting == \"desc\" then\n\009\009\009sort_index = 0\n\009\009end\n\009\009if opposite then\n\009\009\009sort_index = (sort_index + 1) % 2\n\009\009end\n\009\009return sortings[sort_index + 1]\n\009end,\n\009can_change_sort = function(key)\n\009\009if Handy.is_stop_use() then\n\009\009\009return false, nil\n\009\009end\n\009\009if Handy.controller.is_module_key(Handy.cc.regular_keybinds.sort_by_rank, key) then\n\009\009\009return true, \"rank\"\n\009\009elseif Handy.controller.is_module_key(Handy.cc.regular_keybinds.sort_by_suit, key) then\n\009\009\009return true, \"suit\"\n\009\009elseif Handy.controller.is_module_key(Handy.cc.regular_keybinds.toggle_sort, key) then\n\009\009\009return true, Handy.regular_keybinds.get_current_sorting(true)\n\009\009else\n\009\009\009return false, nil\n\009\009end\n\009end,\n\009change_sort = function(sorter)\n\009\009if sorter == \"rank\" then\n\009\009\009Handy.fake_events.execute({\n\009\009\009\009func = G.FUNCS.sort_hand_value,\n\009\009\009})\n\009\009\009return true\n\009\009elseif sorter == \"suit\" then\n\009\009\009Handy.fake_events.execute({\n\009\009\009\009func = G.FUNCS.sort_hand_suit,\n\009\009\009})\n\009\009\009return true\n\009\009end\n\009end,\n\n\009on_shop_loaded = function()\n\009\009if not G.shop then\n\009\009\009return\n\009\009end\n\009\009Handy.regular_keybinds.shop_loaded = true\n\009\009local remove_func_ref = G.shop.remove\n\009\009function G.shop:remove(...)\n\009\009\009Handy.regular_keybinds.shop_loaded = false\n\009\009\009return remove_func_ref(self, ...)\n\009\009end\n\009end,\n\009can_reroll_shop = function(key)\n\009\009return not not (\n\009\009\009not Handy.regular_keybinds.shop_reroll_blocker\n\009\009\009and Handy.regular_keybinds.shop_loaded\n\009\009\009and Handy.controller.is_module_key(Handy.cc.regular_keybinds.reroll_shop, key)\n\009\009\009and not Handy.is_stop_use()\n\009\009\009and Handy.fake_events.check_button(function()\n\009\009\009\009return G.shop:get_UIE_by_ID(\"next_round_button\").parent.children[2]\n\009\009\009end, { visible = true, require_exact_func = \"can_reroll\" })\n\009\009)\n\009end,\n\009reroll_shop = function()\n\009\009Handy.regular_keybinds.shop_reroll_blocker = true\n\009\009Handy.fake_events.execute_button(function()\n\009\009\009return G.shop:get_UIE_by_ID(\"next_round_button\").parent.children[2]\n\009\009end)\n\009\009G.E_MANAGER:add_event(Event({\n\009\009\009no_delete = true,\n\009\009\009blocking = false,\n\009\009\009func = function()\n\009\009\009\009Handy.regular_keybinds.shop_reroll_blocker = false\n\009\009\009\009return true\n\009\009\009end,\n\009\009}))\n\009\009return true\n\009end,\n\n\009can_leave_shop = function(key)\n\009\009return Handy.controller.is_module_key(Handy.cc.regular_keybinds.leave_shop, key)\n\009\009\009and Handy.regular_keybinds.shop_loaded\n\009\009\009and not Handy.is_stop_use()\n\009\009\009and Handy.fake_events.check_button(function()\n\009\009\009\009return G.shop:get_UIE_by_ID(\"next_round_button\")\n\009\009\009end, { visible = true })\n\009end,\n\009leave_shop = function()\n\009\009Handy.regular_keybinds.shop_loaded = false\n\009\009Handy.fake_events.execute_button(function()\n\009\009\009return G.shop:get_UIE_by_ID(\"next_round_button\")\n\009\009end)\n\009\009return true\n\009end,\n\n\009can_select_blind = function(key)\n\009\009return Handy.controller.is_module_key(Handy.cc.regular_keybinds.select_blind, key)\n\009\009\009and G.GAME\n\009\009\009and G.GAME.blind_on_deck\n\009\009\009and G.blind_select\n\009\009\009and G.GAME.round_resets.blind_choices[G.GAME.blind_on_deck]\n\009\009\009and not Handy.is_stop_use()\n\009\009\009and Handy.fake_events.check_button(function()\n\009\009\009\009return G.blind_select_opts[string.lower(G.GAME.blind_on_deck)]:get_UIE_by_ID(\"select_blind_button\")\n\009\009\009end)\n\009end,\n\009select_blind = function()\n\009\009Handy.fake_events.execute_button(function()\n\009\009\009return G.blind_select_opts[string.lower(G.GAME.blind_on_deck)]:get_UIE_by_ID(\"select_blind_button\")\n\009\009end)\n\009\009return true\n\009end,\n\n\009can_skip_blind = function(key)\n\009\009return not not (\n\009\009\009Handy.controller.is_module_key(Handy.cc.regular_keybinds.skip_blind, key)\n\009\009\009and not Handy.is_stop_use()\n\009\009\009and Handy.fake_events.check_button(function()\n\009\009\009\009local container = G.blind_select_opts[string.lower(G.GAME.blind_on_deck)]:get_UIE_by_ID(\n\009\009\009\009\009\"tag_\" .. G.GAME.blind_on_deck\n\009\009\009\009)\n\009\009\009\009return container.states.visible and container.children[2]\n\009\009\009end, { visible = true })\n\009\009)\n\009end,\n\009skip_blind = function()\n\009\009Handy.fake_events.execute_button(function()\n\009\009\009return G.blind_select_opts[string.lower(G.GAME.blind_on_deck)]:get_UIE_by_ID(\"tag_\" .. G.GAME.blind_on_deck).children[2]\n\009\009end)\n\009\009return true\n\009end,\n\n\009can_reroll_boss = function(key)\n\009\009return Handy.controller.is_module_key(Handy.cc.regular_keybinds.reroll_boss, key)\n\009\009\009and not Handy.is_stop_use()\n\009\009\009and Handy.fake_events.check_button(function()\n\009\009\009\009return G.blind_prompt_box.UIRoot.children[3].children[1]\n\009\009\009end, {\n\009\009\009\009visible = true,\n\009\009\009\009require_exact_func = \"reroll_boss_button\",\n\009\009\009})\n\009end,\n\009reroll_boss = function()\n\009\009Handy.fake_events.execute_button(function()\n\009\009\009return G.blind_prompt_box.UIRoot.children[3].children[1]\n\009\009end)\n\009\009return true\n\009end,\n\n\009can_open_run_info = function(key)\n\009\009if Handy.controller.is_module_key(Handy.cc.regular_keybinds.run_info, key) then\n\009\009\009return true, 1\n\009\009elseif Handy.controller.is_module_key(Handy.cc.regular_keybinds.run_info_blinds, key) then\n\009\009\009return true, 2\n\009\009end\n\009\009return false, nil\n\009end,\n\009open_run_info = function(tab_index)\n\009\009if tab_index == 2 then\n\009\009\009Handy.override_create_tabs_chosen_by_label = localize(\"b_blinds\")\n\009\009end\n\009\009Handy.fake_events.execute({\n\009\009\009func = G.FUNCS.run_info,\n\009\009})\n\009\009Handy.override_create_tabs_chosen_by_label = nil\n\009\009return true\n\009end,\n\n\009can_view_deck = function(key)\n\009\009return not not (Handy.controller.is_module_key(Handy.cc.regular_keybinds.view_deck, key))\n\009end,\n\009view_deck = function()\n\009\009Handy.fake_events.execute({\n\009\009\009func = G.FUNCS.deck_info,\n\009\009})\n\009\009return true\n\009end,\n\n\009can_view_lobby_info = function(key)\n\009\009return MP\n\009\009\009and G.FUNCS.lobby_info\n\009\009\009and Handy.is_in_multiplayer()\n\009\009\009and Handy.controller.is_module_key(Handy.cc.regular_keybinds.lobby_info, key)\n\009end,\n\009view_lobby_info = function()\n\009\009Handy.fake_events.execute({\n\009\009\009func = G.FUNCS.lobby_info,\n\009\009})\n\009\009return true\n\009end,\n\n\009use = function(key)\n\009\009if not Handy.controller.is_module_enabled(Handy.cc.regular_keybinds) then\n\009\009\009return false\n\009\009end\n\009\009if G.STAGE ~= G.STAGES.RUN then\n\009\009\009return\n\009\009end\n\009\009local is_not_paused = G.STAGE == G.STAGES.RUN and not G.SETTINGS.paused and not G.OVERLAY_MENU\n\009\009if Handy.regular_keybinds.swappable_overlay or is_not_paused then\n\009\009\009local can_open_info, info_tab_index = Handy.regular_keybinds.can_open_run_info(key)\n\009\009\009if can_open_info then\n\009\009\009\009return Handy.regular_keybinds.open_run_info(info_tab_index)\n\009\009\009elseif Handy.regular_keybinds.can_view_deck(key) then\n\009\009\009\009return Handy.regular_keybinds.view_deck()\n\009\009\009elseif Handy.regular_keybinds.can_view_lobby_info(key) then\n\009\009\009\009return Handy.regular_keybinds.view_lobby_info()\n\009\009\009end\n\009\009end\n\009\009if is_not_paused then\n\009\009\009if G.STATE == G.STATES.SELECTING_HAND then\n\009\009\009\009local need_sort, sorter = Handy.regular_keybinds.can_change_sort(key)\n\009\009\009\009if need_sort then\n\009\009\009\009\009local sort_result = Handy.regular_keybinds.change_sort(sorter)\n\009\009\009\009\009if Handy.cc.notifications_level >= 3 then\n\009\009\009\009\009\009Handy.UI.state_panel.display(function(state)\n\009\009\009\009\009\009\009state.items.change_sort = {\n\009\009\009\009\009\009\009\009text = localize({\n\009\009\009\009\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009\009\009\009\009key = \"Handy_hand_sorting\",\n\009\009\009\009\009\009\009\009\009vars = {\n\009\009\009\009\009\009\009\009\009\009localize(\"k_\" .. Handy.regular_keybinds.get_current_sorting(false)),\n\009\009\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009\009}),\n\009\009\009\009\009\009\009\009order = 30,\n\009\009\009\009\009\009\009\009hold = false,\n\009\009\009\009\009\009\009}\n\009\009\009\009\009\009\009return true\n\009\009\009\009\009\009end)\n\009\009\009\009\009end\n\009\009\009\009\009return sort_result\n\009\009\009\009elseif Handy.regular_keybinds.can_discard(key) then\n\009\009\009\009\009return Handy.regular_keybinds.discard()\n\009\009\009\009elseif Handy.regular_keybinds.can_play(key) then\n\009\009\009\009\009return Handy.regular_keybinds.play()\n\009\009\009\009end\n\009\009\009\009return false\n\009\009\009elseif G.STATE == G.STATES.SHOP then\n\009\009\009\009if Handy.regular_keybinds.can_reroll_shop(key) then\n\009\009\009\009\009return Handy.regular_keybinds.reroll_shop()\n\009\009\009\009elseif Handy.regular_keybinds.can_leave_shop(key) then\n\009\009\009\009\009return Handy.regular_keybinds.leave_shop()\n\009\009\009\009end\n\009\009\009\009return false\n\009\009\009elseif G.STATE == G.STATES.BLIND_SELECT then\n\009\009\009\009if Handy.regular_keybinds.can_skip_blind(key) then\n\009\009\009\009\009return Handy.regular_keybinds.skip_blind()\n\009\009\009\009elseif Handy.regular_keybinds.can_select_blind(key) then\n\009\009\009\009\009return Handy.regular_keybinds.select_blind()\n\009\009\009\009elseif Handy.regular_keybinds.can_reroll_boss(key) then\n\009\009\009\009\009return Handy.regular_keybinds.reroll_boss()\n\009\009\009\009end\n\009\009\009\009return false\n\009\009\009end\n\009\009end\n\009\009return false\n\009end,\n}\n\nlocal exit_overlay_menu_ref = G.FUNCS.exit_overlay_menu\nfunction G.FUNCS.exit_overlay_menu(...)\n\009Handy.regular_keybinds.toggle_swappable_overlay(false)\n\009return exit_overlay_menu_ref(...)\nend\n\nlocal deck_info_ref = G.FUNCS.deck_info\nfunction G.FUNCS.deck_info(...)\n\009Handy.regular_keybinds.toggle_swappable_overlay(true)\n\009return deck_info_ref(...)\nend\n\nlocal run_info_ref = G.FUNCS.run_info\nfunction G.FUNCS.run_info(...)\n\009Handy.regular_keybinds.toggle_swappable_overlay(true)\n\009return run_info_ref(...)\nend\n\nHandy.register_module(\"regular_keybinds\", Handy.regular_keybinds)\n",["display"]="modules/controls/regular_keybinds.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/insta_highlight",["source"]="Handy.insta_highlight = {\n\009first_card_highlighted = nil,\n\n\009can_execute = function(card)\n\009\009return G.STATE ~= G.STATES.HAND_PLAYED\n\009\009\009and card\n\009\009\009and G.hand\n\009\009\009and G.hand.states.visible\n\009\009\009and card.area == G.hand\n\009\009\009and not G.CONTROLLER.dragging.target\n\009\009\009and not Handy.is_stop_use()\n\009\009\009and Handy.controller.is_module_key_down(Handy.cc.insta_highlight)\n\009end,\n\009execute = function(card)\n\009\009if Handy.insta_highlight.first_card_highlighted == nil then\n\009\009\009Handy.insta_highlight.first_card_highlighted = card.highlighted\n\009\009\009\009and Handy.controller.is_module_enabled(Handy.cc.insta_highlight.allow_deselect)\n\009\009end\n\009\009G.E_MANAGER:add_event(Event({\n\009\009\009trigger = \"immediate\",\n\009\009\009blocking = false,\n\009\009\009blockable = false,\n\009\009\009no_delete = true,\n\009\009\009func = function()\n\009\009\009\009if\n\009\009\009\009\009not G.CONTROLLER.dragging.target\n\009\009\009\009\009and (not not card.highlighted == not not Handy.insta_highlight.first_card_highlighted)\n\009\009\009\009then\n\009\009\009\009\009card:click()\n\009\009\009\009end\n\009\009\009\009return true\n\009\009\009end,\n\009\009}))\n\009\009return false\n\009end,\n\n\009use = function(card)\n\009\009return Handy.insta_highlight.can_execute(card) and Handy.insta_highlight.execute(card) or false\n\009end,\n\n\009use_on_hovered = function(key)\n\009\009if key == \"mouse1\" then\n\009\009\009return false\n\009\009end\n\009\009Handy.insta_highlight.use(G.CONTROLLER.hovering.target)\n\009\009return false\n\009end,\n\n\009update = function(dt)\n\009\009if Handy.insta_highlight.first_card_highlighted ~= nil then\n\009\009\009if not Handy.controller.is_module_key_down(Handy.cc.insta_highlight, true) then\n\009\009\009\009Handy.insta_highlight.first_card_highlighted = nil\n\009\009\009end\n\009\009end\n\009end,\n}\n\nHandy.register_module(\"insta_highlight\", Handy.insta_highlight)\n",["display"]="modules/controls/insta_highlight.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/insta_highlight_entire_f_hand",["source"]="Handy.insta_highlight_entire_f_hand = {\n\009can_execute = function(key)\n\009\009return G.STATE ~= G.STATES.HAND_PLAYED\n\009\009\009and G.hand\n\009\009\009and G.hand.states.visible\n\009\009\009and not Handy.is_stop_use()\n\009\009\009and Handy.controller.is_module_key(Handy.cc.insta_highlight_entire_f_hand, key)\n\009end,\n\009execute = function(key)\n\009\009G.hand:unhighlight_all()\n\009\009local cards_count = math.min(G.hand.config.highlighted_limit, #G.hand.cards)\n\009\009for i = 1, cards_count do\n\009\009\009local card = G.hand.cards[i]\n\009\009\009if i ~= cards_count then\n\009\009\009\009G.hand.cards[i]:highlight(true)\n\009\009\009\009G.hand.highlighted[#G.hand.highlighted + 1] = card\n\009\009\009else\n\009\009\009\009G.hand:add_to_highlighted(card)\n\009\009\009end\n\009\009end\n\009\009return false\n\009end,\n\n\009use = function(key)\n\009\009return Handy.insta_highlight_entire_f_hand.can_execute(key) and Handy.insta_highlight_entire_f_hand.execute(key)\n\009\009\009or false\n\009end,\n}\n\nHandy.register_module(\"insta_highlight_entire_f_hand\", Handy.insta_highlight_entire_f_hand)\n",["display"]="modules/controls/insta_highlight_entire_f_hand.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/insta_actions",["source"]="Handy.insta_actions = {\n\009action_blocker = false,\n\n\009crawl_for_buttons = function(ui_buttons, result)\n\009\009result = result or {}\n\009\009if not ui_buttons then\n\009\009\009return result\n\009\009end\n\009\009local lua_wtf = {}\n\009\009lua_wtf.iterator = function(node)\n\009\009\009if node and node.states and node.states.visible then\n\009\009\009\009if node.config and node.config.func then\n\009\009\009\009\009result[node.config.func] = {\n\009\009\009\009\009\009node = node,\n\009\009\009\009\009\009action = node.config.handy_insta_action or nil,\n\009\009\009\009\009}\n\009\009\009\009end\n\009\009\009\009if node.children then\n\009\009\009\009\009for _, child_node in ipairs(node.children) do\n\009\009\009\009\009\009lua_wtf.iterator(child_node)\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009\009lua_wtf.iterator(ui_buttons.UIRoot)\n\009\009return result\n\009end,\n\n\009get_actions = function()\n\009\009return {\n\009\009\009buy_n_sell = Handy.controller.is_module_key_down(Handy.cc.insta_buy_n_sell),\n\009\009\009buy_or_sell = Handy.controller.is_module_key_down(Handy.cc.insta_buy_or_sell),\n\009\009\009use = Handy.controller.is_module_key_down(Handy.cc.insta_use),\n\009\009\009cryptid_code_use_last_interaction = Handy.controller.is_module_key_down(\n\009\009\009\009Handy.cc.cryptid_code_use_last_interaction\n\009\009\009),\n\009\009}\n\009end,\n\009get_alt_actions = function(key)\n\009\009return {\n\009\009\009buy_n_sell = Handy.controller.is_module_key(Handy.cc.insta_buy_n_sell, key),\n\009\009\009buy_or_sell = Handy.controller.is_module_key(Handy.cc.insta_buy_or_sell, key),\n\009\009\009use = Handy.controller.is_module_key(Handy.cc.insta_use, key),\n\009\009\009cryptid_code_use_last_interaction = Handy.controller.is_module_key(\n\009\009\009\009Handy.cc.cryptid_code_use_last_interaction,\n\009\009\009\009key\n\009\009\009),\n\009\009}\n\009end,\n\n\009can_execute = function(card, buy_or_sell, use)\n\009\009return not not (\n\009\009\009not Handy.insta_actions.action_blocker\n\009\009\009and (buy_or_sell or use)\n\009\009\009and card\n\009\009\009and card.area\n\009\009\009and card.is\n\009\009\009and card:is(Card)\n\009\009\009and not Handy.is_stop_use()\n\009\009)\n\009end,\n\009execute = function(card, buy_or_sell, use, only_sell)\n\009\009if card.REMOVED then\n\009\009\009return false\n\009\009end\n\n\009\009local target_button = nil\n\009\009local is_shop_button = false\n\009\009local is_custom_button = false\n\009\009local is_playable_consumeable = false\n\n\009\009local current_card_state = card.highlighted\n\009\009if not current_card_state then\n\009\009\009card:highlight(true)\n\009\009end\n\009\009local base_background = G.UIDEF.card_focus_ui(card)\n\009\009local base_attach = base_background:get_UIE_by_ID(\"ATTACH_TO_ME\").children\n\009\009local card_buttons = G.UIDEF.use_and_sell_buttons(card)\n\009\009local card_buttons_ui = UIBox({\n\009\009\009definition = card_buttons,\n\009\009\009config = {},\n\009\009})\n\n\009\009local result_funcs = {}\n\009\009Handy.insta_actions.crawl_for_buttons(card_buttons_ui, result_funcs)\n\009\009Handy.insta_actions.crawl_for_buttons(card.children.use_button, result_funcs)\n\009\009local is_booster_pack_card = (G.pack_cards and card.area == G.pack_cards) and not card.ability.consumeable\n\n\009\009local get_node = function(a)\n\009\009\009return a and a.node\n\009\009end\n\n\009\009if use then\n\009\009\009if card.area == G.hand and card.ability.consumeable then\n\009\009\009\009local success, playale_consumeable_button = pcall(function()\n\009\009\009\009\009-- G.UIDEF.use_and_sell_buttons(G.hand.highlighted[1]).nodes[1].nodes[2].nodes[1].nodes[1]\n\009\009\009\009\009return card_buttons_ui.UIRoot.children[1].children[2].children[1].children[1]\n\009\009\009\009end)\n\009\009\009\009if success and playale_consumeable_button then\n\009\009\009\009\009target_button = playale_consumeable_button\n\009\009\009\009\009is_custom_button = true\n\009\009\009\009\009is_playable_consumeable = true\n\009\009\009\009end\n\009\009\009elseif result_funcs.can_select_alchemical or result_funcs.can_select_crazy_card then\n\009\009\009\009-- Prevent cards to be selected when usage is required:\n\009\009\009\009-- Alchemical cards, Cines\n\009\009\009else\n\009\009\009\009for _, node_info in pairs(result_funcs) do\n\009\009\009\009\009if node_info.action == \"use\" then\n\009\009\009\009\009\009target_button = node_info.node\n\009\009\009\009\009\009is_custom_button = true\n\009\009\009\009\009\009break\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009\009target_button = target_button\n\009\009\009\009\009or base_attach.buy_and_use\n\009\009\009\009\009or get_node(result_funcs.can_use_consumeable)\n\009\009\009\009\009or (not is_booster_pack_card and base_attach.use)\n\009\009\009\009\009or card.children.buy_and_use_button\n\009\009\009\009is_shop_button = target_button == card.children.buy_and_use_button\n\009\009\009end\n\009\009elseif buy_or_sell then\n\009\009\009if only_sell then\n\009\009\009\009for _, node_info in pairs(result_funcs) do\n\009\009\009\009\009if node_info.action == \"sell\" then\n\009\009\009\009\009\009target_button = node_info.node\n\009\009\009\009\009\009is_custom_button = true\n\009\009\009\009\009\009break\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009\009target_button = target_button or base_attach.sell or nil\n\009\009\009else\n\009\009\009\009for _, node_info in pairs(result_funcs) do\n\009\009\009\009\009if node_info.action == \"buy\" or node_info.action == \"sell\" or node_info.action == \"buy_or_sell\" then\n\009\009\009\009\009\009target_button = node_info.node\n\009\009\009\009\009\009is_custom_button = true\n\009\009\009\009\009\009break\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009\009target_button = target_button\n\009\009\009\009\009or get_node(result_funcs.can_select_crazy_card) -- Cines\n\009\009\009\009\009or get_node(result_funcs.can_select_alchemical) -- Alchemical cards\n\009\009\009\009\009or get_node(result_funcs.can_use_mupack) -- Multipacks\n\009\009\009\009\009or get_node(result_funcs.can_reserve_card) -- Code cards, for example\n\009\009\009\009\009or card.children.buy_button\n\009\009\009\009\009or base_attach.buy\n\009\009\009\009\009or base_attach.redeem\n\009\009\009\009\009or base_attach.sell\n\009\009\009\009\009or (is_booster_pack_card and base_attach.use)\n\009\009\009end\n\009\009\009is_shop_button = target_button ~= nil and target_button == card.children.buy_button\n\009\009end\n\n\009\009if target_button and not is_shop_button and not is_custom_button then\n\009\009\009for _, node_info in pairs(result_funcs) do\n\009\009\009\009if node_info.node == target_button then\n\009\009\009\009\009is_custom_button = true\n\009\009\009\009\009break\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\n\009\009local target_button_UIBox\n\009\009local target_button_definition\n\n\009\009local cleanup = function(leave_highlight)\n\009\009\009base_background:remove()\n\009\009\009card_buttons_ui:remove()\n\009\009\009if not leave_highlight and not current_card_state then\n\009\009\009\009card:highlight(false)\n\009\009\009end\n\009\009end\n\n\009\009if target_button then\n\009\009\009if is_playable_consumeable then\n\009\009\009\009card.area:add_to_highlighted(card)\n\009\009\009\009if not card.highlighted then\n\009\009\009\009\009cleanup()\n\009\009\009\009\009return false\n\009\009\009\009end\n\009\009\009end\n\n\009\009\009target_button_UIBox = target_button\n\009\009\009target_button_definition = (is_custom_button and target_button)\n\009\009\009\009or (is_shop_button and target_button.definition)\n\009\009\009\009or target_button.definition.nodes[1]\n\n\009\009\009local check, button = Handy.fake_events.check({\n\009\009\009\009func = G.FUNCS[target_button_definition.config.func],\n\009\009\009\009node = is_custom_button and target_button or nil,\n\009\009\009\009UIBox = target_button_UIBox,\n\009\009\009\009config = target_button_definition.config,\n\009\009\009})\n\009\009\009if check then\n\009\009\009\009Handy.insta_actions.action_blocker = true\n\009\009\009\009Handy.fake_events.execute({\n\009\009\009\009\009func = G.FUNCS[button or target_button_definition.config.button],\n\009\009\009\009\009node = is_custom_button and target_button or nil,\n\009\009\009\009\009UIBox = target_button_UIBox,\n\009\009\009\009\009config = target_button_definition.config,\n\009\009\009\009})\n\009\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009\009no_delete = true,\n\009\009\009\009\009blocking = false,\n\009\009\009\009\009func = function()\n\009\009\009\009\009\009Handy.insta_actions.action_blocker = false\n\009\009\009\009\009\009return true\n\009\009\009\009\009end,\n\009\009\009\009}))\n\009\009\009\009cleanup(is_playable_consumeable)\n\009\009\009\009return true\n\009\009\009end\n\009\009end\n\n\009\009cleanup()\n\009\009return false\n\009end,\n\n\009process_card = function(card, actions)\n\009\009if not card or card.REMOVED or not card.is or not card:is(Card) then\n\009\009\009return false\n\009\009end\n\009\009if card.ability and card.ability.handy_dangerous_actions_used then\n\009\009\009return true\n\009\009end\n\n\009\009if actions.cryptid_code_use_last_interaction then\n\009\009\009local cards_events_list = {\n\009\009\009\009c_cry_variable = \"variable_apply_previous\",\n\009\009\009\009-- c_cry_pointer = \"pointer_apply_previous\",\n\009\009\009\009c_cry_class = \"class_apply_previous\",\n\009\009\009\009c_cry_exploit = \"exploit_apply_previous\",\n\009\009\009}\n\009\009\009local success, card_center = pcall(function()\n\009\009\009\009return card.config.center.key\n\009\009\009end)\n\009\009\009if success and card_center and cards_events_list[card_center] then\n\009\009\009\009local is_code_card_used = Handy.insta_actions.can_execute(card, false, true)\n\009\009\009\009\009\009and Handy.insta_actions.execute(card, false, true)\n\009\009\009\009\009or false\n\009\009\009\009if is_code_card_used then\n\009\009\009\009\009Handy.fake_events.execute({\n\009\009\009\009\009\009func = G.FUNCS[cards_events_list[card_center]],\n\009\009\009\009\009})\n\009\009\009\009\009return true\n\009\009\009\009end\n\009\009\009end\n\009\009\009return false\n\009\009elseif actions.buy_n_sell then\n\009\009\009if\n\009\009\009\009Handy.utils.table_contains({\n\009\009\009\009\009G.pack_cards,\n\009\009\009\009\009G.shop_jokers,\n\009\009\009\009\009G.shop_booster,\n\009\009\009\009\009G.shop_vouchers,\n\009\009\009\009}, card.area)\n\009\009\009\009and card.ability\n\009\009\009\009and (card.ability.set == \"Joker\" or card.ability.consumeable)\n\009\009\009then\n\009\009\009\009local is_buyed = Handy.insta_actions.can_execute(card, true, false)\n\009\009\009\009\009\009and Handy.insta_actions.execute(card, true, false)\n\009\009\009\009\009or false\n\009\009\009\009if is_buyed then\n\009\009\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009\009\009func = function()\n\009\009\009\009\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009\009\009\009\009func = function()\n\009\009\009\009\009\009\009\009\009return (\n\009\009\009\009\009\009\009\009\009\009Handy.insta_actions.can_execute(card, true, false)\n\009\009\009\009\009\009\009\009\009\009and Handy.insta_actions.execute(card, true, false)\n\009\009\009\009\009\009\009\009\009) or true\n\009\009\009\009\009\009\009\009end,\n\009\009\009\009\009\009\009}))\n\009\009\009\009\009\009\009return true\n\009\009\009\009\009\009end,\n\009\009\009\009\009}))\n\009\009\009\009end\n\009\009\009\009return is_buyed\n\009\009\009end\n\009\009\009return false\n\009\009else\n\009\009\009return Handy.insta_actions.can_execute(card, actions.buy_or_sell, actions.use)\n\009\009\009\009\009and Handy.insta_actions.execute(card, actions.buy_or_sell, actions.use)\n\009\009\009\009or false\n\009\009end\n\009end,\n\n\009use = function(card)\n\009\009return (not Handy.controller.is_gamepad() and Handy.cc.insta_actions_trigger_mode == 1)\n\009\009\009and Handy.insta_actions.process_card(card, Handy.insta_actions.get_actions())\n\009end,\n\009use_alt = function(key)\n\009\009if Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.immediate_buy_and_sell) then\n\009\009\009return false\n\009\009end\n\009\009return (Handy.controller.is_gamepad() or Handy.cc.insta_actions_trigger_mode == 2)\n\009\009\009and Handy.insta_actions.process_card(\n\009\009\009\009G.CONTROLLER.dragging.target or Handy.last_hovered_card,\n\009\009\009\009Handy.insta_actions.get_alt_actions(key)\n\009\009\009)\n\009end,\n\n\009update_state_panel = function(state, key, released)\n\009\009if G.STAGE ~= G.STAGES.RUN or G.SETTINGS.paused or G.OVERLAY_MENU then\n\009\009\009return false\n\009\009end\n\009\009if Handy.cc.notifications_level < 4 then\n\009\009\009return false\n\009\009end\n\009\009local result = false\n\009\009local is_alt_action = Handy.cc.insta_actions_trigger_mode == 2\n\009\009if is_alt_action and not Handy.controller.is_triggered(released) then\n\009\009\009return false\n\009\009end\n\009\009local actions = is_alt_action and Handy.insta_actions.get_alt_actions(key) or Handy.insta_actions.get_actions()\n\009\009if actions.use then\n\009\009\009state.items.insta_use = {\n\009\009\009\009text = localize(\"ph_handy_notif_quick_use\"),\n\009\009\009\009hold = not is_alt_action,\n\009\009\009\009order = 10,\n\009\009\009}\n\009\009\009result = true\n\009\009end\n\009\009if actions.buy_or_sell then\n\009\009\009state.items.quick_buy_and_sell = {\n\009\009\009\009text = localize(\"ph_handy_notif_quick_buy_or_sell\"),\n\009\009\009\009hold = not is_alt_action,\n\009\009\009\009order = 11,\n\009\009\009}\n\009\009\009result = true\n\009\009end\n\009\009if actions.buy_n_sell then\n\009\009\009state.items.quick_buy_n_sell = {\n\009\009\009\009text = localize(\"ph_handy_notif_quick_buy_n_sell\"),\n\009\009\009\009hold = not is_alt_action,\n\009\009\009\009order = 12,\n\009\009\009}\n\009\009\009result = true\n\009\009end\n\009\009return result\n\009end,\n}\n\nHandy.register_module(\"insta_actions\", Handy.insta_actions)\n",["display"]="modules/controls/insta_actions.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/move_highlight",["source"]="Handy.move_highlight = {\n\009dx = {\n\009\009one_left = -1,\n\009\009one_right = 1,\n\009},\n\n\009get_dx = function(key, area)\n\009\009for module_key, module in pairs(Handy.cc.move_highlight.dx) do\n\009\009\009if Handy.controller.is_module_key(module, key) then\n\009\009\009\009return Handy.move_highlight.dx[module_key]\n\009\009\009end\n\009\009end\n\009\009return nil\n\009end,\n\009get_actions = function(key, area)\n\009\009return {\n\009\009\009swap = Handy.controller.is_module_key_down(Handy.cc.move_highlight.swap),\n\009\009\009to_end = Handy.controller.is_module_key_down(Handy.cc.move_highlight.to_end),\n\009\009}\n\009end,\n\n\009can_swap = function(key, area)\n\009\009if not area then\n\009\009\009return false\n\009\009end\n\009\009return not Handy.utils.table_contains({\n\009\009\009G.pack_cards,\n\009\009\009G.shop_jokers,\n\009\009\009G.shop_booster,\n\009\009\009G.shop_vouchers,\n\009\009}, area)\n\009end,\n\009cen_execute = function(key, area)\n\009\009return not not (\n\009\009\009Handy.controller.is_module_enabled(Handy.cc.move_highlight)\n\009\009\009and not Handy.controller.is_gamepad()\n\009\009\009and area\n\009\009\009and area.highlighted\n\009\009\009and area.highlighted[1]\n\009\009\009and Handy.utils.table_contains({\n\009\009\009\009G.consumeables,\n\009\009\009\009G.jokers,\n\009\009\009\009G.cine_quests,\n\009\009\009\009G.pack_cards,\n\009\009\009\009G.shop_jokers,\n\009\009\009\009G.shop_booster,\n\009\009\009\009G.shop_vouchers,\n\009\009\009}, area)\n\009\009)\n\009end,\n\009execute = function(key, area)\n\009\009local dx = Handy.move_highlight.get_dx(key, area)\n\009\009if not dx then\n\009\009\009return false\n\009\009end\n\n\009\009local current_card = area.highlighted[1]\n\009\009for current_index = #area.cards, 1, -1 do\n\009\009\009if area.cards[current_index] == current_card then\n\009\009\009\009local actions = Handy.move_highlight.get_actions(key, area)\n\009\009\009\009local next_index = actions.to_end and (dx > 0 and #area.cards or 1)\n\009\009\009\009\009or ((#area.cards + current_index + dx - 1) % #area.cards) + 1\n\009\009\009\009if current_index == next_index then\n\009\009\009\009\009return\n\009\009\009\009end\n\009\009\009\009local next_card = area.cards[next_index]\n\009\009\009\009if not next_card then\n\009\009\009\009\009return\n\009\009\009\009end\n\009\009\009\009if actions.swap and Handy.move_highlight.can_swap(key, area) then\n\009\009\009\009\009if actions.to_end or next_index == 1 or next_index == #area.cards then\n\009\009\009\009\009\009table.remove(area.cards, current_index)\n\009\009\009\009\009\009table.insert(area.cards, next_index, current_card)\n\009\009\009\009\009else\n\009\009\009\009\009\009area.cards[next_index] = current_card\n\009\009\009\009\009\009area.cards[current_index] = next_card\n\009\009\009\009\009end\n\009\009\009\009else\n\009\009\009\009\009area:remove_from_highlighted(current_card)\n\009\009\009\009\009area:add_to_highlighted(next_card)\n\009\009\009\009end\n\009\009\009\009return\n\009\009\009end\n\009\009end\n\009end,\n\n\009use = function(key, area)\n\009\009area = area or Handy.last_clicked_area\n\009\009return Handy.move_highlight.cen_execute(key, area) and Handy.move_highlight.execute(key, area) or false\n\009end,\n}\n\nHandy.register_module(\"move_highlight\", Handy.move_highlight)\n",["display"]="modules/controls/move_highlight.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/speed_multiplier",["source"]="Handy.speed_multiplier = {\n\009value = 1,\n\009value_text = \"1x\",\n\009queue_retriggers_count = 0,\n\n\009throttle = false,\n\n\009get_queue_retriggers_count = function()\n\009\009if\n\009\009\009Handy.is_in_multiplayer()\n\009\009\009or not Handy.is_mod_active()\n\009\009\009or not Handy.controller.is_module_enabled(Handy.cc.speed_multiplier)\n\009\009then\n\009\009\009return 0\n\009\009end\n\009\009return Handy.speed_multiplier.queue_retriggers_count\n\009end,\n\n\009is_uncapped = function()\n\009\009return Handy.is_dangerous_actions_active()\n\009\009\009and Handy.controller.is_module_enabled(Handy.cc.dangerous_actions.speed_multiplier_uncap)\n\009end,\n\n\009accelerate_queue = function(queue)\n\009\009queue = queue or G.E_MANAGER\n\009\009local retriggers_count = Handy.speed_multiplier.get_queue_retriggers_count()\n\009\009if retriggers_count > 0 then\n\009\009\009local v = G.VIBRATION\n\009\009\009local j = G.ROOM.jiggle\n\009\009\009for i = 1, retriggers_count do\n\009\009\009\009local events_count = 0\n\009\009\009\009for k, v in pairs(queue.queues or {}) do\n\009\009\009\009\009events_count = events_count + #v\n\009\009\009\009end\n\009\009\009\009if events_count > 1 then\n\009\009\009\009\009queue:update(0, true)\n\009\009\009\009else\n\009\009\009\009\009break\n\009\009\009\009end\n\009\009\009end\n\009\009\009G.VIBRATION = v\n\009\009\009G.ROOM.jiggle = j\n\009\009end\n\009end,\n\n\009get_value = function()\n\009\009if\n\009\009\009Handy.is_in_multiplayer()\n\009\009\009or not Handy.is_mod_active()\n\009\009\009or not Handy.controller.is_module_enabled(Handy.cc.speed_multiplier)\n\009\009then\n\009\009\009return 1\n\009\009end\n\009\009return math.min(Handy.speed_multiplier.value, Handy.speed_multiplier.throttle and 4 or math.huge)\n\009end,\n\009localize_value = function()\n\009\009if Handy.speed_multiplier.value >= 1 then\n\009\009\009Handy.speed_multiplier.value_text = tostring(Handy.speed_multiplier.value)\n\009\009else\n\009\009\009Handy.speed_multiplier.value_text = \"1/\" .. tostring(1 / Handy.speed_multiplier.value)\n\009\009end\n\009\009Handy.speed_multiplier.value_text = Handy.speed_multiplier.value_text .. \"x\"\n\009\009return Handy.speed_multiplier.value_text\n\009end,\n\009load_default_value = function()\n\009\009if Handy.controller.is_module_enabled(Handy.cc.speed_multiplier) then\n\009\009\009local value = math.max(1, math.min(10, math.floor(Handy.cc.speed_multiplier.default_value) or 1))\n\009\009\009Handy.speed_multiplier.value = 2 ^ (value - 1)\n\009\009end\n\009\009Handy.speed_multiplier.change(0)\n\009end,\n\n\009get_actions = function(key)\n\009\009return {\n\009\009\009multiply = Handy.controller.is_module_key(Handy.cc.speed_multiplier.multiply, key),\n\009\009\009divide = Handy.controller.is_module_key(Handy.cc.speed_multiplier.divide, key),\n\009\009}\n\009end,\n\009can_execute = function(key)\n\009\009return Handy.controller.is_module_enabled(Handy.cc.speed_multiplier)\n\009\009\009and not Handy.is_in_multiplayer()\n\009\009\009and (\n\009\009\009\009Handy.controller.is_module_enabled(Handy.cc.speed_multiplier.no_hold)\n\009\009\009\009or Handy.controller.is_module_key_down(Handy.cc.speed_multiplier)\n\009\009\009)\n\009end,\n\n\009execute = function(key)\n\009\009local actions = Handy.speed_multiplier.get_actions(key)\n\009\009if actions.multiply then\n\009\009\009Handy.speed_multiplier.multiply()\n\009\009\009return not Handy.controller.is_module_enabled(Handy.cc.speed_multiplier.no_hold)\n\009\009end\n\009\009if actions.divide then\n\009\009\009Handy.speed_multiplier.divide()\n\009\009\009return not Handy.controller.is_module_enabled(Handy.cc.speed_multiplier.no_hold)\n\009\009end\n\009\009return false\n\009end,\n\n\009show_notif = function()\n\009\009if Handy.cc.notifications_level < 3 then\n\009\009\009return\n\009\009end\n\009\009Handy.UI.state_panel.display(function(state)\n\009\009\009state.items.change_speed_multiplier = {\n\009\009\009\009text = localize({\n\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009key = \"Handy_gamespeed_multiplier\",\n\009\009\009\009\009vars = {\n\009\009\009\009\009\009Handy.speed_multiplier.value_text,\n\009\009\009\009\009},\n\009\009\009\009}),\n\009\009\009\009hold = false,\n\009\009\009\009order = 5,\n\009\009\009\009dangerous = Handy.speed_multiplier.value > 512,\n\009\009\009}\n\009\009\009local retriggers_amount = Handy.speed_multiplier.get_queue_retriggers_count()\n\009\009\009if retriggers_amount > 0 then\n\009\009\009\009state.items.change_queue_retriggers_count = {\n\009\009\009\009\009text = localize({\n\009\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009\009key = \"Handy_event_queue_retriggers_amount\",\n\009\009\009\009\009\009vars = {\n\009\009\009\009\009\009\009retriggers_amount + 1,\n\009\009\009\009\009\009},\n\009\009\009\009\009}),\n\009\009\009\009\009hold = false,\n\009\009\009\009\009order = 5.1,\n\009\009\009\009\009dangerous = retriggers_amount > 8,\n\009\009\009\009}\n\009\009\009end\n\009\009\009return true\n\009\009end)\n\009end,\n\n\009multiply = function()\n\009\009return Handy.speed_multiplier.change(1)\n\009end,\n\009divide = function()\n\009\009return Handy.speed_multiplier.change(-1)\n\009end,\n\009change = function(dx)\n\009\009local multiplier = 2 ^ (dx or 0)\n\009\009Handy.speed_multiplier.value = math.min(\n\009\009\009math.max(0.001953125, Handy.speed_multiplier.value * multiplier),\n\009\009\009Handy.speed_multiplier.is_uncapped() and 2 ^ 24 or 512\n\009\009)\n\009\009Handy.speed_multiplier.queue_retriggers_count = math.max(0, math.floor(Handy.speed_multiplier.value / 64) - 1)\n\009\009Handy.speed_multiplier.localize_value()\n\009\009if dx ~= 0 then\n\009\009\009Handy.speed_multiplier.show_notif()\n\009\009end\n\009end,\n\n\009use = function(key)\n\009\009return Handy.speed_multiplier.can_execute(key) and Handy.speed_multiplier.execute(key) or false\n\009end,\n}\n\nHandy.register_module(\"speed_multiplier\", Handy.speed_multiplier)\n",["display"]="modules/controls/speed_multiplier.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/nopeus_interaction",["source"]="Handy.nopeus_interaction = {\n\009is_present = function()\n\009\009return type(Nopeus) == \"table\"\n\009end,\n\n\009get_actions = function(key)\n\009\009return {\n\009\009\009increase = Handy.controller.is_module_key(Handy.cc.nopeus_interaction.increase, key),\n\009\009\009decrease = Handy.controller.is_module_key(Handy.cc.nopeus_interaction.decrease, key),\n\009\009}\n\009end,\n\n\009can_dangerous = function()\n\009\009return not not (\n\009\009\009Handy.is_dangerous_actions_active()\n\009\009\009and Handy.controller.is_module_enabled(Handy.cc.dangerous_actions.nopeus_unsafe)\n\009\009)\n\009end,\n\009can_execute = function(key)\n\009\009return not not (\n\009\009\009Handy.nopeus_interaction.is_present()\n\009\009\009and Handy.controller.is_module_enabled(Handy.cc.nopeus_interaction)\n\009\009\009and not Handy.is_in_multiplayer()\n\009\009\009and (\n\009\009\009\009Handy.controller.is_module_enabled(Handy.cc.nopeus_interaction.no_hold)\n\009\009\009\009or Handy.controller.is_module_key_down(Handy.cc.nopeus_interaction)\n\009\009\009)\n\009\009)\n\009end,\n\009execute = function(key)\n\009\009local actions = Handy.nopeus_interaction.get_actions(key)\n\009\009if actions.increase then\n\009\009\009Handy.nopeus_interaction.increase()\n\009\009\009Handy.nopeus_interaction.show_notif(key)\n\009\009\009return not Handy.controller.is_module_enabled(Handy.cc.nopeus_interaction.no_hold)\n\009\009end\n\009\009if actions.decrease then\n\009\009\009Handy.nopeus_interaction.decrease()\n\009\009\009Handy.nopeus_interaction.show_notif(key)\n\009\009\009return not Handy.controller.is_module_enabled(Handy.cc.nopeus_interaction.no_hold)\n\009\009end\n\009\009return false\n\009end,\n\n\009show_notif = function(key)\n\009\009if not Handy.nopeus_interaction.is_present() then\n\009\009\009return\n\009\009end\n\009\009Handy.UI.state_panel.display(function(state)\n\009\009\009local actions = Handy.nopeus_interaction.get_actions(key)\n\n\009\009\009if actions.increase or actions.decrease then\n\009\009\009\009local states = {\n\009\009\009\009\009Nopeus.Off,\n\009\009\009\009\009Nopeus.Planets,\n\009\009\009\009\009Nopeus.On,\n\009\009\009\009\009Nopeus.Unsafe,\n\009\009\009\009}\n\009\009\009\009if Nopeus.Optimised then\n\009\009\009\009\009states = {\n\009\009\009\009\009\009Nopeus.Off,\n\009\009\009\009\009\009Nopeus.Planets,\n\009\009\009\009\009\009Nopeus.On,\n\009\009\009\009\009\009Nopeus.Optimised,\n\009\009\009\009\009\009Nopeus.Unsafe,\n\009\009\009\009\009}\n\009\009\009\009end\n\n\009\009\009\009local is_dangerous = G.SETTINGS.FASTFORWARD == (#states - 1)\n\n\009\009\009\009if is_dangerous then\n\009\009\009\009\009if Handy.cc.notifications_level < 2 then\n\009\009\009\009\009\009return false\n\009\009\009\009\009end\n\009\009\009\009else\n\009\009\009\009\009if Handy.cc.notifications_level < 3 then\n\009\009\009\009\009\009return false\n\009\009\009\009\009end\n\009\009\009\009end\n\n\009\009\009\009state.items.change_nopeus_fastforward = {\n\009\009\009\009\009text = localize({\n\009\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009\009key = \"Handy_nopeus_fastforward\",\n\009\009\009\009\009\009vars = { states[(G.SETTINGS.FASTFORWARD or 0) + 1] },\n\009\009\009\009\009}),\n\009\009\009\009\009hold = false,\n\009\009\009\009\009order = 4,\n\009\009\009\009\009dangerous = is_dangerous,\n\009\009\009\009}\n\009\009\009\009if\n\009\009\009\009\009not Handy.nopeus_interaction.can_dangerous()\n\009\009\009\009\009and actions.increase\n\009\009\009\009\009and G.SETTINGS.FASTFORWARD == (#states - 2)\n\009\009\009\009then\n\009\009\009\009\009state.items.prevent_nopeus_unsafe = {\n\009\009\009\009\009\009text = localize(\"ph_handy_notif_nopeus_unsafe_disabled\"),\n\009\009\009\009\009\009hold = false,\n\009\009\009\009\009\009order = 4.05,\n\009\009\009\009\009}\n\009\009\009\009end\n\009\009\009\009return true\n\009\009\009end\n\009\009\009return false\n\009\009end)\n\009end,\n\n\009change = function(dx)\n\009\009if not Handy.nopeus_interaction.is_present() then\n\009\009\009G.SETTINGS.FASTFORWARD = 0\n\009\009else\n\009\009\009local increment = Nopeus.Optimised and 1 or 0\n\009\009\009if G.SETTINGS.FASTFORWARD == (3 + increment) and dx > 0 then\n\009\009\009\009-- It's already unsafe, so leave it as it is\n\009\009\009else\n\009\009\009\009G.SETTINGS.FASTFORWARD = math.min(\n\009\009\009\009\009(Handy.nopeus_interaction.can_dangerous() and 3 or 2) + increment,\n\009\009\009\009\009math.max(0, (G.SETTINGS.FASTFORWARD or 0) + dx)\n\009\009\009\009)\n\009\009\009end\n\009\009end\n\009end,\n\009increase = function()\n\009\009Handy.nopeus_interaction.change(1)\n\009end,\n\009decrease = function()\n\009\009Handy.nopeus_interaction.change(-1)\n\009end,\n\n\009use = function(key)\n\009\009return Handy.nopeus_interaction.can_execute(key) and Handy.nopeus_interaction.execute(key) or false\n\009end,\n}\n\nHandy.register_module(\"nopeus_interaction\", Handy.nopeus_interaction)\n",["display"]="modules/controls/nopeus_interaction.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/not_just_yet_interaction",["source"]="Handy.not_just_yet_interaction = {\n\009is_present = function()\n\009\009return G and G.FUNCS and G.FUNCS.njy_endround ~= nil\n\009end,\n\n\009can_execute = function(check)\n\009\009return not not (\n\009\009\009Handy.not_just_yet_interaction.is_present()\n\009\009\009and GLOBAL_njy_vanilla_override\n\009\009\009and G.STATE_COMPLETE\n\009\009\009and G.buttons\n\009\009\009and G.buttons.states\n\009\009\009and G.buttons.states.visible\n\009\009\009and G.GAME\n\009\009\009and G.GAME.chips\n\009\009\009and G.GAME.blind\n\009\009\009and G.GAME.blind.chips\n\009\009\009and to_big(G.GAME.chips) >= to_big(G.GAME.blind.chips)\n\009\009)\n\009end,\n\009execute = function()\n\009\009stop_use()\n\009\009G.STATE = G.STATES.NEW_ROUND\n\009\009end_round()\n\009end,\n\n\009update = function(dt)\n\009\009GLOBAL_njy_vanilla_override = (\n\009\009\009G.STAGE == G.STAGES.RUN\n\009\009\009and Handy.is_mod_active()\n\009\009\009and not Handy.controller.is_debugplus_console_opened()\n\009\009\009and Handy.controller.is_module_key_down(Handy.cc.not_just_yet_interaction)\n\009\009)\n\009\009return Handy.not_just_yet_interaction.can_execute() and Handy.not_just_yet_interaction.execute() or false\n\009end,\n}\n\nHandy.register_module(\"not_just_yet_interaction\", Handy.not_just_yet_interaction)\n",["display"]="modules/controls/not_just_yet_interaction.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/animation_skip",["source"]="-- None, Messages, Animation, Everything, Unsafe\n\nHandy.animation_skip = {\n\009queues_to_skip = {\n\009\009\"base\",\n\009\009\"handy_config\",\n\009},\n\n\009value = 1,\n\009value_text = \"\",\n\009buffered_value = nil,\n\009immediate_event_queue = 0,\n\009ease_dollars_buffer = 0,\n\009dollars_buffer_cleared = false,\n\n\009force_non_blocking = false,\n\009force_non_blockable = false,\n\n\009allow_juice_up = false,\n\009mute_ease_dollars = 0,\n\n\009extract_func_from_event = 0,\n\n\009get_buffered_value = function()\n\009\009if Handy.animation_skip.buffered_value == nil then\n\009\009\009Handy.animation_skip.buffered_value = Handy.animation_skip.get_value()\n\009\009end\n\009\009return Handy.animation_skip.buffered_value\n\009end,\n\n\009should_skip_messages = function()\n\009\009return Handy.animation_skip.get_buffered_value() >= 2\n\009end,\n\009should_skip_animation = function()\n\009\009return Handy.animation_skip.get_buffered_value() >= 3\n\009end,\n\009should_skip_everything = function()\n\009\009return Handy.animation_skip.get_buffered_value() >= 4\n\009end,\n\009should_skip_unsafe = function()\n\009\009return Handy.animation_skip.get_buffered_value() >= 5\n\009end,\n\n\009request_dollars_buffer_reset = function()\n\009\009if not Handy.animation_skip.dollars_buffer_cleared then\n\009\009\009Handy.animation_skip.dollars_buffer_cleared = true\n\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009func = function()\n\009\009\009\009\009G.GAME.dollar_buffer = 0\n\009\009\009\009\009return true\n\009\009\009\009end,\n\009\009\009}))\n\009\009end\n\009end,\n\n\009get_value = function()\n\009\009if\n\009\009\009Handy.is_in_multiplayer()\n\009\009\009or not Handy.is_mod_active()\n\009\009\009or not Handy.controller.is_module_enabled(Handy.cc.animation_skip)\n\009\009then\n\009\009\009return 1\n\009\009end\n\009\009if Handy.animation_skip.can_dangerous() then\n\009\009\009return Handy.animation_skip.value\n\009\009end\n\009\009return math.min(4, Handy.animation_skip.value)\n\009end,\n\009localize_value = function()\n\009\009Handy.animation_skip.value_text = localize(\"handy_animation_skip_levels\")[Handy.animation_skip.value] or \"ERROR\"\n\009end,\n\009get_actions = function(key)\n\009\009return {\n\009\009\009increase = Handy.controller.is_module_key(Handy.cc.animation_skip.increase, key),\n\009\009\009decrease = Handy.controller.is_module_key(Handy.cc.animation_skip.decrease, key),\n\009\009}\n\009end,\n\009load_default_value = function()\n\009\009if Handy.controller.is_module_enabled(Handy.cc.animation_skip) then\n\009\009\009Handy.animation_skip.value =\n\009\009\009\009math.max(1, math.min(4, math.floor(Handy.cc.animation_skip.default_value) or 1))\n\009\009end\n\009\009Handy.animation_skip.change(0)\n\009end,\n\n\009can_dangerous = function()\n\009\009return not not (\n\009\009\009Handy.is_dangerous_actions_active()\n\009\009\009and Handy.controller.is_module_enabled(Handy.cc.dangerous_actions.animation_skip_unsafe)\n\009\009)\n\009end,\n\009can_execute = function(key)\n\009\009return not not (\n\009\009\009Handy.controller.is_module_enabled(Handy.cc.animation_skip)\n\009\009\009and not Handy.is_in_multiplayer()\n\009\009\009and (\n\009\009\009\009Handy.controller.is_module_enabled(Handy.cc.animation_skip.no_hold)\n\009\009\009\009or Handy.controller.is_module_key_down(Handy.cc.animation_skip)\n\009\009\009)\n\009\009)\n\009end,\n\009execute = function(key)\n\009\009local actions = Handy.animation_skip.get_actions(key)\n\009\009if actions.increase then\n\009\009\009Handy.animation_skip.increase()\n\009\009\009return not Handy.controller.is_module_enabled(Handy.cc.animation_skip.no_hold)\n\009\009end\n\009\009if actions.decrease then\n\009\009\009Handy.animation_skip.decrease()\n\009\009\009return not Handy.controller.is_module_enabled(Handy.cc.animation_skip.no_hold)\n\009\009end\n\009\009return false\n\009end,\n\n\009show_notif = function(dx)\n\009\009if dx == 0 then\n\009\009\009return\n\009\009end\n\009\009Handy.UI.state_panel.display(function(state)\n\009\009\009local value = Handy.animation_skip.get_value()\n\009\009\009local is_dangerous = value == 5\n\n\009\009\009if is_dangerous then\n\009\009\009\009if Handy.cc.notifications_level < 2 then\n\009\009\009\009\009return false\n\009\009\009\009end\n\009\009\009else\n\009\009\009\009if Handy.cc.notifications_level < 3 then\n\009\009\009\009\009return false\n\009\009\009\009end\n\009\009\009end\n\n\009\009\009state.items.change_animation_skip = {\n\009\009\009\009text = localize({\n\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009key = \"Handy_animation_skip\",\n\009\009\009\009\009vars = { Handy.animation_skip.value_text },\n\009\009\009\009}),\n\009\009\009\009hold = false,\n\009\009\009\009order = 4,\n\009\009\009\009dangerous = is_dangerous,\n\009\009\009}\n\009\009\009if not Handy.animation_skip.can_dangerous() and dx > 0 and value == (5 - 1) then\n\009\009\009\009state.items.prevent_animation_skip_unsafe = {\n\009\009\009\009\009text = localize(\"ph_handy_notif_animation_skip_unsafe_disabled\"),\n\009\009\009\009\009hold = false,\n\009\009\009\009\009order = 4.05,\n\009\009\009\009}\n\009\009\009end\n\009\009\009return true\n\009\009end)\n\009end,\n\n\009change = function(dx)\n\009\009Handy.animation_skip.value =\n\009\009\009math.max(1, math.min(Handy.animation_skip.can_dangerous() and 5 or 4, Handy.animation_skip.value + dx))\n\009\009Handy.animation_skip.localize_value()\n\009\009Handy.animation_skip.show_notif(dx)\n\009end,\n\009increase = function()\n\009\009Handy.animation_skip.change(1)\n\009end,\n\009decrease = function()\n\009\009Handy.animation_skip.change(-1)\n\009end,\n\n\009use = function(key)\n\009\009return Handy.animation_skip.can_execute(key) and Handy.animation_skip.execute(key) or false\n\009end,\n\n\009update = function(dt)\n\009\009-- Defined in bottom, because have override dependencies\n\009end,\n}\n\nlocal attention_text_ref = attention_text\nfunction attention_text(...)\n\009if G.STATE == G.STATES.HAND_PLAYED and Handy.animation_skip.should_skip_animation() then\n\009\009return\n\009end\n\009return attention_text_ref(...)\nend\nlocal card_eval_status_text_ref = card_eval_status_text\nfunction card_eval_status_text(...)\n\009local args = { ... }\n\009local extra = args[6] or {}\n\009if Handy.animation_skip.should_skip_animation() then\n\009\009if extra and extra.playing_cards_created then\n\009\009\009playing_card_joker_effects(extra.playing_cards_created)\n\009\009end\n\009\009return\n\009elseif Handy.animation_skip.should_skip_messages() then\n\009\009if not extra.no_juice then\n\009\009\009if extra.instant then\n\009\009\009\009args[1]:juice_up(0.6, 0.1)\n\009\009\009\009G.ROOM.jiggle = G.ROOM.jiggle + 0.7\n\009\009\009else\n\009\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009\009func = function()\n\009\009\009\009\009\009args[1]:juice_up(0.6, 0.1)\n\009\009\009\009\009\009G.ROOM.jiggle = G.ROOM.jiggle + 0.7\n\009\009\009\009\009\009return true\n\009\009\009\009\009end,\n\009\009\009\009}))\n\009\009\009end\n\009\009end\n\009\009if extra and extra.playing_cards_created then\n\009\009\009playing_card_joker_effects(extra.playing_cards_created)\n\009\009end\n\009\009return\n\009end\n\009return card_eval_status_text_ref(...)\nend\nlocal moveable_juice_up_ref = Moveable.juice_up\nfunction Moveable:juice_up(...)\n\009if Handy.animation_skip.should_skip_animation() and not Handy.animation_skip.allow_juice_up then\n\009\009return\n\009end\n\009return moveable_juice_up_ref(self, ...)\nend\nlocal delay_ref = delay\nfunction delay(...)\n\009if Handy.animation_skip.should_skip_everything() then\n\009\009return\n\009end\n\009return delay_ref(...)\nend\nlocal update_hand_text_ref = update_hand_text\nfunction update_hand_text(config, vals, ...)\n\009if\n\009\009Handy.animation_skip.should_skip_everything()\n\009\009or (G.STATE == G.STATES.HAND_PLAYED and Handy.animation_skip.should_skip_animation())\n\009then\n\009\009Handy.animation_skip.extract_func_from_event = 1\n\009\009config = config or {}\n\009\009config.immediate = true\n\009\009config.delay = 0\n\009\009config.blocking = false\n\009\009vals.StatusText = nil\n\009end\n\009return update_hand_text_ref(config, vals, ...)\nend\nlocal juice_card_ref = juice_card\nfunction juice_card(...)\n\009if Handy.animation_skip.should_skip_animation() then\n\009\009return\n\009end\n\009return juice_card_ref(...)\nend\nlocal draw_card_ref = draw_card\nfunction draw_card(...)\n\009if Handy.animation_skip.should_skip_everything() then\n\009\009Handy.animation_skip.force_non_blocking = true\n\009\009draw_card_ref(...)\n\009\009Handy.animation_skip.force_non_blocking = false\n\009\009return\n\009end\n\009return draw_card_ref(...)\nend\nlocal ease_discard_ref = ease_discard\nfunction ease_discard(...)\n\009if Handy.animation_skip.should_skip_everything() then\n\009\009local args = { ... }\n\009\009args[2] = true\n\009\009return ease_discard_ref(unpack(args))\n\009end\n\009return ease_discard_ref(...)\nend\nlocal ease_hands_played_ref = ease_hands_played\nfunction ease_hands_played(...)\n\009if Handy.animation_skip.should_skip_everything() then\n\009\009local args = { ... }\n\009\009args[2] = true\n\009\009return ease_hands_played_ref(unpack(args))\n\009end\n\009return ease_hands_played_ref(...)\nend\nlocal ease_dollars_ref = ease_dollars\nfunction ease_dollars(amount, instant, ...)\n\009if Handy.animation_skip.should_skip_animation() then\n\009\009Handy.animation_skip.ease_dollars_buffer = Handy.animation_skip.ease_dollars_buffer + amount\n\009\009return\n\009elseif Handy.animation_skip.should_skip_messages() then\n\009\009local result = ease_dollars_ref(amount, instant, ...)\n\009\009if Handy.animation_skip.mute_ease_dollars > 0 then\n\009\009\009Handy.animation_skip.mute_ease_dollars = Handy.animation_skip.mute_ease_dollars - 1\n\009\009else\n\009\009\009Handy.animation_skip.mute_ease_dollars = 2\n\009\009end\n\009\009return result\n\009else\n\009\009return ease_dollars_ref(amount, instant, ...)\n\009end\nend\nlocal level_up_hand_ref = level_up_hand\nfunction level_up_hand(...)\n\009if Handy.animation_skip.should_skip_everything() then\n\009\009local args = { ... }\n\009\009args[3] = true\n\009\009return level_up_hand_ref(unpack(args))\n\009elseif Handy.animation_skip.should_skip_animation() then\n\009\009Handy.animation_skip.force_non_blocking = true\n\009\009level_up_hand_ref(...)\n\009\009Handy.animation_skip.force_non_blocking = false\n\009\009return\n\009end\n\009return level_up_hand_ref(...)\nend\nlocal event_manager_add_event_ref = EventManager.add_event\nfunction EventManager:add_event(event, queue, ...)\n\009if not queue or Handy.animation_skip.queues_to_skip[queue] then\n\009\009if Handy.animation_skip.mute_ease_dollars > 0 then\n\009\009\009Handy.animation_skip.mute_ease_dollars = Handy.animation_skip.mute_ease_dollars - 1\n\009\009end\n\009\009if not event.handy_never_modify then\n\009\009\009if Handy.animation_skip.extract_func_from_event > 0 then\n\009\009\009\009Handy.animation_skip.extract_func_from_event = Handy.animation_skip.extract_func_from_event - 1\n\009\009\009\009event.func()\n\009\009\009\009return\n\009\009\009end\n\009\009\009if Handy.animation_skip.should_skip_unsafe() then\n\009\009\009\009event.blocking = false\n\009\009\009\009event.blockable = false\n\009\009\009\009-- This line basically taken from Nopeus by jenwalter666\n\009\009\009\009event.delay = (event.timer == \"REAL\") and event.delay or (event.trigger == \"ease\" and 0.0001 or 0)\n\009\009\009else\n\009\009\009\009if Handy.animation_skip.force_non_blocking then\n\009\009\009\009\009event.blocking = false\n\009\009\009\009end\n\009\009\009\009if Handy.animation_skip.force_non_blockable then\n\009\009\009\009\009event.blockable = false\n\009\009\009\009end\n\009\009\009\009if Handy.animation_skip.should_skip_everything() then\n\009\009\009\009\009event.delay = (event.timer == \"REAL\") and event.delay or ((event.delay or 0) * 0.01)\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009end\n\009-- printCallerInfo()\n\009return event_manager_add_event_ref(self, event, queue, ...)\nend\n\nfunction Handy.animation_skip.update(dt)\n\009Handy.animation_skip.mute_ease_dollars = 0\n\009if G.STATE ~= G.STATES.HAND_PLAYED then\n\009\009Handy.animation_skip.buffered_value = nil\n\009\009Handy.animation_skip.dollars_buffer_cleared = false\n\009end\n\009if Handy.animation_skip.ease_dollars_buffer ~= 0 then\n\009\009ease_dollars_ref(Handy.animation_skip.ease_dollars_buffer, true)\n\009\009Handy.animation_skip.ease_dollars_buffer = 0\n\009end\nend\n\nlocal start_run_ref = G.FUNCS.start_run\nG.FUNCS.start_run = function(...)\n\009local result\n\009if Handy.animation_skip.should_skip_everything() then\n\009\009Handy.animation_skip.skip_wipe_screen = true\n\009\009Handy.animation_skip.force_non_blocking = true\n\009\009result = start_run_ref(...)\n\009\009Handy.animation_skip.skip_wipe_screen = false\n\009\009Handy.animation_skip.force_non_blocking = false\n\009else\n\009\009result = start_run_ref(...)\n\009end\n\009return result\nend\n\nlocal wipe_on_ref = G.FUNCS.wipe_on\nfunction G.FUNCS.wipe_on(...)\n\009if Handy.animation_skip.skip_wipe_screen then\n\009\009return\n\009end\n\009return wipe_on_ref(...)\nend\nlocal wipe_off_ref = G.FUNCS.wipe_off\nfunction G.FUNCS.wipe_off(...)\n\009if Handy.animation_skip.skip_wipe_screen then\n\009\009return\n\009end\n\009return wipe_off_ref(...)\nend\nlocal play_sound_ref = play_sound\nfunction play_sound(...)\n\009if G.STATE == G.STATES.HAND_PLAYED and Handy.animation_skip.should_skip_everything() then\n\009\009return\n\009end\n\009return play_sound_ref(...)\nend\n\nHandy.register_module(\"animation_skip\", Handy.animation_skip)\n\n-- Code to debug event queue\n\n-- local callstep = 0\n-- function printCallerInfo()\n-- \009-- Get debug info for the caller of the function that called printCallerInfo\n-- \009local info = debug.getinfo(3, \"Sl\")\n-- \009callstep = callstep + 1\n-- \009if info then\n-- \009\009print(\"[\" .. callstep .. \"] \" .. (info.short_src or \"???\") .. \":\" .. (info.currentline or \"unknown\"))\n-- \009else\n-- \009\009print(\"Caller information not available\")\n-- \009end\n-- end\n-- local emae = EventManager.add_event\n-- function EventManager:add_event(x, y, z)\n-- \009return emae(self, x, y, z)\n-- end\n",["display"]="modules/controls/animation_skip.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/scoring_hold",["source"]="Handy.scoring_hold = {\n\009is_hold = false,\n\009is_hand_played = false,\n\n\009create_hold_event = function(prepend)\n\009\009local event = Event({\n\009\009\009func = function()\n\009\009\009\009return not Handy.scoring_hold.is_hold\n\009\009\009end,\n\009\009})\n\009\009event.handy_never_modify = true\n\009\009G.E_MANAGER:add_event(event, nil, prepend)\n\009end,\n\n\009get_is_hold = function()\n\009\009if Handy.is_mod_active() and Handy.controller.is_module_enabled(Handy.cc.scoring_hold) then\n\009\009\009return G.STAGE == G.STAGES.RUN\n\009\009\009\009and (G.STATE == G.STATES.HAND_PLAYED or G.STATE == G.STATES.SELECTING_HAND)\n\009\009\009\009and Handy.controller.is_module_key_down(Handy.cc.scoring_hold)\n\009\009else\n\009\009\009return false\n\009\009end\n\009end,\n\n\009update = function(dt)\n\009\009local old_value = Handy.scoring_hold.is_hold\n\009\009local new_value = Handy.scoring_hold.get_is_hold()\n\009\009local old_hand_played_value = Handy.scoring_hold.is_hand_played\n\009\009local new_hand_played_value = G.STATE == G.STATES.HAND_PLAYED\n\009\009Handy.scoring_hold.is_hold = new_value\n\009\009Handy.scoring_hold.is_hand_played = new_hand_played_value\n\009\009if new_value and new_hand_played_value then\n\009\009\009if (old_hand_played_value ~= new_hand_played_value) or (old_value ~= new_value) then\n\009\009\009\009if Handy.controller.is_module_enabled(Handy.cc.scoring_hold.any_moment) then\n\009\009\009\009\009Handy.scoring_hold.create_hold_event(true)\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009\009Handy.UI.state_panel.display(function(state)\n\009\009\009if state.items.scoring_hold and state.items.scoring_hold.hold ~= new_value then\n\009\009\009\009state.items.scoring_hold.hold = new_value and not G.SETTINGS.paused and not G.OVERLAY_MENU\n\009\009\009\009return true\n\009\009\009elseif new_value then\n\009\009\009\009if Handy.cc.notifications_level < 3 or G.SETTINGS.paused or G.OVERLAY_MENU then\n\009\009\009\009\009return false\n\009\009\009\009end\n\009\009\009\009state.items.scoring_hold = {\n\009\009\009\009\009text = localize({\n\009\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009\009key = \"Handy_scoring_hold\",\n\009\009\009\009\009\009vars = {},\n\009\009\009\009\009}),\n\009\009\009\009\009order = 7,\n\009\009\009\009\009hold = Handy.scoring_hold.is_hold,\n\009\009\009\009}\n\009\009\009\009return true\n\009\009\009end\n\009\009end, \"update\")\n\009end,\n}\n\nHandy.register_module(\"scoring_hold\", Handy.scoring_hold)\n",["display"]="modules/controls/scoring_hold.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/dangerous_actions",["source"]="Handy.dangerous_actions = {\n\009sell_queue = {},\n\n\009sell_next_card = function()\n\009\009local target = table.remove(Handy.dangerous_actions.sell_queue, 1)\n\009\009if not target then\n\009\009\009stop_use()\n\009\009\009return\n\009\009end\n\n\009\009local card = target.card\n\009\009if target.remove then\n\009\009\009card:stop_hover()\n\009\009\009card:remove()\n\009\009else\n\009\009\009G.GAME.STOP_USE = 0\n\009\009\009Handy.insta_actions.execute(card, true, false, true)\n\n\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009blocking = false,\n\009\009\009\009func = function()\n\009\009\009\009\009if card.ability then\n\009\009\009\009\009\009card.ability.handy_dangerous_actions_used = nil\n\009\009\009\009\009end\n\009\009\009\009\009return true\n\009\009\009\009end,\n\009\009\009}))\n\009\009end\n\009\009Handy.dangerous_actions.sell_next_card()\n\009end,\n\n\009get_options = function(card)\n\009\009return {\n\009\009\009use_queue = Handy.controller.is_gamepad()\n\009\009\009\009or Handy.controller.is_module_enabled(Handy.cc.dangerous_actions.immediate_buy_and_sell.queue),\n\009\009\009remove = Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.card_remove)\n\009\009\009\009and (card.area == G.jokers or card.area == G.consumeables),\n\009\009}\n\009end,\n\n\009process_card = function(card, use_queue, remove)\n\009\009if use_queue then\n\009\009\009if not card.ability then\n\009\009\009\009card.ability = {}\n\009\009\009end\n\009\009\009card.ability.handy_dangerous_actions_used = true\n\n\009\009\009table.insert(Handy.dangerous_actions.sell_queue, { card = card, remove = remove })\n\009\009\009Handy.UI.state_panel.update(nil, nil)\n\009\009\009return false\n\009\009elseif remove then\n\009\009\009card:stop_hover()\n\009\009\009card:remove()\n\009\009\009return true\n\009\009else\n\009\009\009local result = Handy.insta_actions.execute(card, true, false)\n\009\009\009if result then\n\009\009\009\009if not card.ability then\n\009\009\009\009\009card.ability = {}\n\009\009\009\009end\n\009\009\009\009card.ability.handy_dangerous_actions_used = true\n\n\009\009\009\009G.CONTROLLER.locks.selling_card = nil\n\009\009\009\009G.CONTROLLER.locks.use = nil\n\009\009\009\009G.GAME.STOP_USE = 0\n\n\009\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009\009no_delete = true,\n\009\009\009\009\009blocking = false,\n\009\009\009\009\009func = function()\n\009\009\009\009\009\009if card.ability then\n\009\009\009\009\009\009\009card.ability.handy_dangerous_actions_used = nil\n\009\009\009\009\009\009end\n\009\009\009\009\009\009return true\n\009\009\009\009\009end,\n\009\009\009\009}))\n\009\009\009end\n\009\009\009return result\n\009\009end\n\009end,\n\n\009can_execute = function(card)\n\009\009return Handy.is_dangerous_actions_active()\n\009\009\009and card\n\009\009\009and not (card.ability and card.ability.handy_dangerous_actions_used)\n\009end,\n\009execute_click = function(card)\n\009\009if Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.immediate_buy_and_sell, true) then\n\009\009\009if Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.sell_all) then\n\009\009\009\009local options = Handy.dangerous_actions.get_options(card)\n\009\009\009\009for _, target_card in ipairs(card.area.cards) do\n\009\009\009\009\009Handy.dangerous_actions.process_card(target_card, true, options.remove)\n\009\009\009\009end\n\009\009\009\009Handy.dangerous_actions.sell_next_card()\n\009\009\009\009return true\n\009\009\009elseif Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.sell_all_same) then\n\009\009\009\009local target_cards = {}\n\009\009\009\009local success, card_center_key = pcall(function()\n\009\009\009\009\009return card.config.center.key\n\009\009\009\009end)\n\009\009\009\009if success and card_center_key then\n\009\009\009\009\009for _, area_card in ipairs(card.area.cards) do\n\009\009\009\009\009\009local _success, area_card_center_key = pcall(function()\n\009\009\009\009\009\009\009return area_card.config.center.key\n\009\009\009\009\009\009end)\n\009\009\009\009\009\009if _success and area_card_center_key == card_center_key then\n\009\009\009\009\009\009\009table.insert(target_cards, area_card)\n\009\009\009\009\009\009end\n\009\009\009\009\009end\n\009\009\009\009end\n\n\009\009\009\009local options = Handy.dangerous_actions.get_options(card)\n\009\009\009\009for _, target_card in ipairs(target_cards) do\n\009\009\009\009\009Handy.dangerous_actions.process_card(target_card, true, options.remove)\n\009\009\009\009end\n\009\009\009\009Handy.dangerous_actions.sell_next_card()\n\009\009\009\009return true\n\009\009\009end\n\009\009end\n\009\009return false\n\009end,\n\009execute_hover = function(card)\n\009\009if not Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.immediate_buy_and_sell) then\n\009\009\009return false\n\009\009end\n\009\009if not Handy.insta_actions.get_actions().buy_or_sell then\n\009\009\009return false\n\009\009end\n\009\009local options = Handy.dangerous_actions.get_options(card)\n\009\009return Handy.dangerous_actions.process_card(card, options.use_queue, options.remove)\n\009end,\n\009execute = function(key, card)\n\009\009if Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.immediate_buy_and_sell, true) then\n\009\009\009if Handy.controller.is_module_key(Handy.cc.dangerous_actions.sell_all, key) then\n\009\009\009\009local options = Handy.dangerous_actions.get_options(card)\n\009\009\009\009for _, target_card in ipairs(card.area.cards) do\n\009\009\009\009\009Handy.dangerous_actions.process_card(target_card, true, options.remove)\n\009\009\009\009end\n\009\009\009\009Handy.dangerous_actions.sell_next_card()\n\009\009\009\009return true\n\009\009\009elseif Handy.controller.is_module_key(Handy.cc.dangerous_actions.sell_all_same, key) then\n\009\009\009\009local target_cards = {}\n\009\009\009\009local success, card_center_key = pcall(function()\n\009\009\009\009\009return card.config.center.key\n\009\009\009\009end)\n\009\009\009\009if success and card_center_key then\n\009\009\009\009\009for _, area_card in ipairs(card.area.cards) do\n\009\009\009\009\009\009local _success, area_card_center_key = pcall(function()\n\009\009\009\009\009\009\009return area_card.config.center.key\n\009\009\009\009\009\009end)\n\009\009\009\009\009\009if _success and area_card_center_key == card_center_key then\n\009\009\009\009\009\009\009table.insert(target_cards, area_card)\n\009\009\009\009\009\009end\n\009\009\009\009\009end\n\009\009\009\009end\n\n\009\009\009\009local options = Handy.dangerous_actions.get_options(card)\n\009\009\009\009for _, target_card in ipairs(target_cards) do\n\009\009\009\009\009Handy.dangerous_actions.process_card(target_card, true, options.remove)\n\009\009\009\009end\n\009\009\009\009Handy.dangerous_actions.sell_next_card()\n\009\009\009\009return true\n\009\009\009end\n\009\009end\n\009\009return false\n\009end,\n\n\009use_click = function(card)\n\009\009return Handy.dangerous_actions.can_execute(card) and Handy.dangerous_actions.execute_click(card) or false\n\009end,\n\009use_hover = function(card)\n\009\009return Handy.dangerous_actions.can_execute(card) and Handy.dangerous_actions.execute_hover(card) or false\n\009end,\n\009use = function(key, released)\n\009\009if released or not Handy.controller.is_gamepad() then\n\009\009\009return false\n\009\009end\n\009\009return Handy.dangerous_actions.can_execute(Handy.last_hovered_card)\n\009\009\009and Handy.dangerous_actions.execute(key, Handy.last_hovered_card)\n\009end,\n\n\009can_execute_tag = function(tag)\n\009\009return Handy.is_dangerous_actions_active() and tag\n\009end,\n\009execute_tag_click = function(tag)\n\009\009if Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.card_remove) then\n\009\009\009local target_tags = {}\n\009\009\009for _, target_tag in ipairs(G.GAME.tags) do\n\009\009\009\009table.insert(target_tags, target_tag)\n\009\009\009end\n\009\009\009if Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.sell_all) then\n\009\009\009\009for _, target_tag in ipairs(target_tags) do\n\009\009\009\009\009target_tag:remove()\n\009\009\009\009end\n\009\009\009\009return true\n\009\009\009elseif Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.sell_all_same) then\n\009\009\009\009local tag_key = tag.key\n\009\009\009\009for _, target_tag in ipairs(target_tags) do\n\009\009\009\009\009if target_tag.key == tag_key then\n\009\009\009\009\009\009target_tag:remove()\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009\009return true\n\009\009\009end\n\009\009end\n\009\009return false\n\009end,\n\009use_tag_click = function(tag)\n\009\009return Handy.dangerous_actions.can_execute_tag(tag) and Handy.dangerous_actions.execute_tag_click(tag) or false\n\009end,\n\n\009toggle_queue = function(key, released)\n\009\009if Handy.controller.is_module_key(Handy.cc.dangerous_actions.immediate_buy_and_sell, key) then\n\009\009\009if released then\n\009\009\009\009Handy.dangerous_actions.sell_next_card()\n\009\009\009else\n\009\009\009\009Handy.dangerous_actions.sell_queue = {}\n\009\009\009end\n\009\009end\n\009end,\n\n\009update_state_panel = function(state, key, released)\n\009\009if G.STAGE ~= G.STAGES.RUN or G.SETTINGS.paused or G.OVERLAY_MENU then\n\009\009\009return false\n\009\009end\n\009\009if Handy.cc.notifications_level < 2 then\n\009\009\009return false\n\009\009end\n\n\009\009local is_sell = Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.immediate_buy_and_sell, true)\n\009\009if not is_sell then\n\009\009\009return false\n\009\009end\n\n\009\009if not Handy.controller.is_module_enabled(Handy.cc.dangerous_actions) then\n\009\009\009state.items.prevented_dangerous_actions = {\n\009\009\009\009text = localize(\"ph_handy_notif_unsafe_disabled\"),\n\009\009\009\009hold = true,\n\009\009\009\009order = 99999999,\n\009\009\009}\n\009\009\009return true\n\009\009elseif not Handy.is_dangerous_actions_active() then\n\009\009\009state.items.prevented_dangerous_actions = {\n\009\009\009\009text = localize(\"ph_handy_notif_unsafe_disabled_by_other_mod\"),\n\009\009\009\009hold = true,\n\009\009\009\009order = 99999999,\n\009\009\009}\n\009\009\009return true\n\009\009end\n\n\009\009local is_insta_sell = Handy.insta_actions.get_actions().buy_or_sell\n\009\009\009and Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.immediate_buy_and_sell)\n\009\009local is_all = Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.sell_all)\n\009\009local is_all_same = Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.sell_all_same)\n\009\009local is_remove = Handy.controller.is_module_key_down(Handy.cc.dangerous_actions.card_remove)\n\n\009\009state.items.dangerous_hint = {\n\009\009\009text = localize(\"ph_handy_notif_unsafe\"),\n\009\009\009dangerous = true,\n\009\009\009hold = true,\n\009\009\009order = 99999999,\n\009\009}\n\n\009\009if is_insta_sell then\n\009\009\009local text = localize(is_remove and \"ph_handy_notif_insta_remove\" or \"ph_handy_notif_insta_sell\")\n\009\009\009if Handy.controller.is_module_enabled(Handy.cc.dangerous_actions.immediate_buy_and_sell.queue) then\n\009\009\009\009text = text\n\009\009\009\009\009.. \" \"\n\009\009\009\009\009.. localize({\n\009\009\009\009\009\009type = \"variable\",\n\009\009\009\009\009\009key = \"Handy_items_in_queue\",\n\009\009\009\009\009\009vars = { #Handy.dangerous_actions.sell_queue },\n\009\009\009\009\009})\n\009\009\009end\n\009\009\009state.items.quick_buy_and_sell = {\n\009\009\009\009text = text,\n\009\009\009\009hold = true,\n\009\009\009\009order = 11,\n\009\009\009\009dangerous = true,\n\009\009\009}\n\009\009elseif is_all then\n\009\009\009local text = localize(is_remove and \"ph_handy_notif_remove_all\" or \"ph_handy_notif_sell_all\")\n\009\009\009state.items.sell_all = {\n\009\009\009\009text = text,\n\009\009\009\009hold = true,\n\009\009\009\009order = 12,\n\009\009\009\009dangerous = true,\n\009\009\009}\n\009\009elseif is_all_same then\n\009\009\009local text = localize(is_remove and \"ph_handy_notif_remove_all_same\" or \"ph_handy_notif_sell_all_same\")\n\009\009\009state.items.sell_all_same = {\n\009\009\009\009text = text,\n\009\009\009\009hold = true,\n\009\009\009\009order = 12,\n\009\009\009\009dangerous = true,\n\009\009\009}\n\009\009end\n\009\009return true\n\009end,\n}\n\nHandy.register_module(\"dangerous_actions\", Handy.dangerous_actions)\n",["display"]="modules/controls/dangerous_actions.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/controls/misc",["source"]="Handy.misc_controls = {\n\009can_crash = function(key, released)\n\009\009return Handy.is_dangerous_actions_active()\n\009\009\009and not Handy.is_in_multiplayer()\n\009\009\009and Handy.controller.is_module_key(Handy.cc.misc.crash, key)\n\009end,\n\009crash = function(key, released)\n\009\009error(\n\009\009\009'Crashed by \"Crash a game\" keybind in Handy mod '\n\009\009\009\009.. Handy.UI.PARTS.format_new_module_keys(Handy.cc.misc.crash)\n\009\009)\n\009\009return true\n\009end,\n\n\009can_open_mod_settings = function(key, released)\n\009\009return not G.OVERLAY_MENU and Handy.controller.is_module_key(Handy.cc.misc.open_mod_settings, key)\n\009end,\n\009open_mod_settings = function(key, released)\n\009\009G.FUNCS.handy_open_options()\n\009\009return true\n\009end,\n\n\009save_run_blocker = false,\n\009can_save_run = function(key, released, check)\n\009\009if check then\n\009\009\009return not not (\n\009\009\009\009not Handy.is_in_multiplayer()\n\009\009\009\009and G.GAME\n\009\009\009\009and G.STAGE == G.STAGES.RUN\n\009\009\009\009and (G.STATE == G.STATES.SHOP or G.STATE == G.STATES.SELECTING_HAND or G.STATE == G.STATES.BLIND_SELECT or G.STATE == G.STATES.ROUND_EVAL)\n\009\009\009\009and not Handy.is_stop_use()\n\009\009\009\009and not (G.SETTINGS.paused or G.OVERLAY_MENU)\n\009\009\009\009and #G.E_MANAGER.queues.base < 3 -- One more because event callback called before it removed from queue\n\009\009\009)\n\009\009end\n\009\009return not not (\n\009\009\009not Handy.misc_controls.save_run_blocker\n\009\009\009and not Handy.is_in_multiplayer()\n\009\009\009and G.GAME\n\009\009\009and G.STAGE == G.STAGES.RUN\n\009\009\009and (G.STATE == G.STATES.SHOP or G.STATE == G.STATES.SELECTING_HAND or G.STATE == G.STATES.BLIND_SELECT or G.STATE == G.STATES.ROUND_EVAL)\n\009\009\009and not Handy.is_stop_use()\n\009\009\009and not (G.SETTINGS.paused or G.OVERLAY_MENU)\n\009\009\009and #G.E_MANAGER.queues.base < 2\n\009\009\009and Handy.controller.is_module_key(Handy.cc.misc.save_run, key)\n\009\009)\n\009end,\n\009save_run = function(key, released)\n\009\009Handy.misc_controls.save_run_blocker = true\n\009\009Handy.UI.state_panel.display(function(state)\n\009\009\009state.items.misc_save_run = {\n\009\009\009\009text = localize(\"ph_handy_notif_misc_save_run_start\"),\n\009\009\009\009order = 20,\n\009\009\009}\n\009\009\009return true\n\009\009end)\n\009\009G.E_MANAGER:add_event(Event({\n\009\009\009timer = \"REAL\",\n\009\009\009func = function()\n\009\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009\009timer = \"REAL\",\n\009\009\009\009\009func = function()\n\009\009\009\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009\009\009\009trigger = \"after\",\n\009\009\009\009\009\009\009delay = 0.3,\n\009\009\009\009\009\009\009timer = \"REAL\",\n\009\009\009\009\009\009\009func = function()\n\009\009\009\009\009\009\009\009if Handy.misc_controls.can_save_run(key, released, true) then\n\009\009\009\009\009\009\009\009\009save_run()\n\009\009\009\009\009\009\009\009\009Handy.UI.state_panel.display(function(state)\n\009\009\009\009\009\009\009\009\009\009state.items.misc_save_run = {\n\009\009\009\009\009\009\009\009\009\009\009text = localize(\"ph_handy_notif_misc_save_run_saving\"),\n\009\009\009\009\009\009\009\009\009\009\009order = 20,\n\009\009\009\009\009\009\009\009\009\009}\n\009\009\009\009\009\009\009\009\009\009return true\n\009\009\009\009\009\009\009\009\009end)\n\009\009\009\009\009\009\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009\009\009\009\009\009\009trigger = \"after\",\n\009\009\009\009\009\009\009\009\009\009delay = 0.5,\n\009\009\009\009\009\009\009\009\009\009timer = \"REAL\",\n\009\009\009\009\009\009\009\009\009\009blocking = false,\n\009\009\009\009\009\009\009\009\009\009blockable = false,\n\009\009\009\009\009\009\009\009\009\009force_pause = true,\n\009\009\009\009\009\009\009\009\009\009func = function()\n\009\009\009\009\009\009\009\009\009\009\009Handy.UI.state_panel.display(function(state)\n\009\009\009\009\009\009\009\009\009\009\009\009state.items.misc_save_run = {\n\009\009\009\009\009\009\009\009\009\009\009\009\009text = localize(\"ph_handy_notif_misc_save_run_saved\"),\n\009\009\009\009\009\009\009\009\009\009\009\009\009order = 20,\n\009\009\009\009\009\009\009\009\009\009\009\009}\n\009\009\009\009\009\009\009\009\009\009\009\009return true\n\009\009\009\009\009\009\009\009\009\009\009end)\n\009\009\009\009\009\009\009\009\009\009\009Handy.misc_controls.save_run_blocker = false\n\009\009\009\009\009\009\009\009\009\009\009return true\n\009\009\009\009\009\009\009\009\009\009end,\n\009\009\009\009\009\009\009\009\009}))\n\009\009\009\009\009\009\009\009else\n\009\009\009\009\009\009\009\009\009Handy.UI.state_panel.display(function(state)\n\009\009\009\009\009\009\009\009\009\009state.items.misc_save_run = {\n\009\009\009\009\009\009\009\009\009\009\009text = localize(\"ph_handy_notif_misc_save_run_interrupt\"),\n\009\009\009\009\009\009\009\009\009\009\009order = 20,\n\009\009\009\009\009\009\009\009\009\009}\n\009\009\009\009\009\009\009\009\009\009return true\n\009\009\009\009\009\009\009\009\009end)\n\009\009\009\009\009\009\009\009\009Handy.misc_controls.save_run_blocker = false\n\009\009\009\009\009\009\009\009end\n\009\009\009\009\009\009\009\009return true\n\009\009\009\009\009\009\009end,\n\009\009\009\009\009\009}))\n\009\009\009\009\009\009return true\n\009\009\009\009\009end,\n\009\009\009\009}))\n\009\009\009\009return true\n\009\009\009end,\n\009\009}))\n\009\009return true\n\009end,\n\n\009can_restart_run = function(key, released)\n\009\009return G.STAGE == G.STAGES.RUN\n\009\009\009and (not G.SETTINGS.paused or G.STATE == G.STATES.GAME_OVER)\n\009\009\009and not Handy.is_in_multiplayer()\n\009\009\009and Handy.controller.is_module_key(Handy.cc.misc.quick_restart, key)\n\009end,\n\009restart_fun = function(key, released)\n\009\009local old_hold_value = G.CONTROLLER.held_key_times.r\n\009\009G.CONTROLLER.held_key_times.r = 999\n\009\009Handy.animation_skip.skip_wipe_screen = true\n\009\009Handy.animation_skip.force_non_blocking = true\n\009\009Handy.__restart_from_game_over = G.STATE == G.STATES.GAME_OVER\n\009\009G.CONTROLLER:key_hold_update(\"r\", 0)\n\009\009Handy.__restart_from_game_over = nil\n\009\009G.CONTROLLER.held_key_times.r = old_hold_value\n\009\009Handy.animation_skip.skip_wipe_screen = false\n\009\009Handy.animation_skip.force_non_blocking = false\n\009\009return true\n\009end,\n\n\009can_start_fantoms_preview = function(key, released)\n\009\009return G.STAGE == G.STAGES.RUN\n\009\009\009and FN\n\009\009\009and FN.SIM\n\009\009\009and FN.SIM.run\n\009\009\009and not G.SETTINGS.paused\n\009\009\009and not Handy.is_stop_use()\n\009\009\009and Handy.controller.is_module_key(Handy.cc.misc.start_fantoms_preview, key)\n\009\009\009and Handy.fake_events.check_button(function()\n\009\009\009\009return G.HUD:get_UIE_by_ID(\"calculate_score_button\")\n\009\009\009end)\n\009end,\n\009start_fantoms_preview = function(key, released)\n\009\009Handy.fake_events.execute_button(function()\n\009\009\009return G.HUD:get_UIE_by_ID(\"calculate_score_button\")\n\009\009end)\n\009end,\n\n\009controls_list = {},\n\n\009use = function(key, released)\n\009\009if released then\n\009\009\009return false\n\009\009end\n\009\009for _, control in ipairs(Handy.misc_controls.controls_list) do\n\009\009\009if control.func(key, released) then\n\009\009\009\009return control.button(key, released)\n\009\009\009end\n\009\009end\n\009\009return false\n\009end,\n}\n\nHandy.misc_controls.controls_list = {\n\009{\n\009\009func = Handy.misc_controls.can_crash,\n\009\009button = Handy.misc_controls.crash,\n\009},\n\009{\n\009\009func = Handy.misc_controls.can_restart_run,\n\009\009button = Handy.misc_controls.restart_fun,\n\009},\n\009{\n\009\009func = Handy.misc_controls.can_open_mod_settings,\n\009\009button = Handy.misc_controls.open_mod_settings,\n\009},\n\009{\n\009\009func = Handy.misc_controls.can_save_run,\n\009\009button = Handy.misc_controls.save_run,\n\009},\n\009{\n\009\009func = Handy.misc_controls.can_start_fantoms_preview,\n\009\009button = Handy.misc_controls.start_fantoms_preview,\n\009},\n}\n\nHandy.register_module(\"misc_controls\", Handy.misc_controls)\n",["display"]="modules/controls/misc.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/localization/en-us",["source"]="return {\n\009descriptions = {\n\009\009-- For all checkboxes and popups, first var is keybind\n\009\009-- Further mentioned vars starts from #2#\n\009\009Handy_ConfigCheckbox = {\n\009\009\009-- Vars: version, author\n\009\009\009handy = {\n\009\009\009\009unlock = { \"HandyBalatro v#2#\", \"by {C:white,E:2,s:1.15}#3#{}\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Uncheck to disable {C:attention}ALL{} mod features\",\n\009\009\009\009\009\"{C:handy_secondary}(no restart required){}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009hide_options_button = {\n\009\009\009\009unlock = { \"Hide mod button\", \"in options menu\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"{C:handy_secondary}Only when Steamodded installed{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009debugplus_prevent = {\n\009\009\009\009unlock = { \"DebugPlus:\", \"prevent actions\" },\n\009\009\009\009text = { \"Prevent any Handy keybinds\", \"when {C:chips}#2#{} is hold\" },\n\009\009\009},\n\009\009\009regular_keybinds = {\n\009\009\009\009unlock = { \"Regular keybinds\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Use keybinds for\",\n\009\009\009\009\009\"common game actions\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Left Mouse]\n\009\009\009insta_highlight = {\n\009\009\009\009unlock = {\n\009\009\009\009\009\"{C:edition}Fast hand selection{}\",\n\009\009\009\009\009\"{C:handy_secondary,s:0.75}(drag, hover, swipe, slide){}\",\n\009\009\009\009},\n\009\009\009\009text = {\n\009\009\009\009\009\"Hold {C:chips}#1#{} and\",\n\009\009\009\009\009\"hover cards in hand to select them\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Left Mouse]\n\009\009\009insta_highlight_OUTSIDE = {\n\009\009\009\009unlock = {\n\009\009\009\009\009\"{C:edition}Fast hand selection{}\",\n\009\009\009\009\009\"{C:handy_secondary,s:0.75}(drag, hover, swipe, slide){}\",\n\009\009\009\009},\n\009\009\009\009text = {\n\009\009\009\009\009\"Start hold {C:chips}#1#{} {C:attention}OUTSIDE{} of cards,\",\n\009\009\009\009\009\"and then hover them in hand to select\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Fast hand selection]\n\009\009\009insta_unhighlight = {\n\009\009\009\009unlock = {\n\009\009\009\009\009\"Fast hand\",\n\009\009\009\009\009\"deselection\",\n\009\009\009\009},\n\009\009\009\009text = {\n\009\009\009\009\009\"Allow {C:edition}#2#{}\",\n\009\009\009\009\009\"to deselect cards aswell\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009show_deck_preview = {\n\009\009\009\009unlock = { \"Deck preview\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Hold {C:chips}#1#{} to\",\n\009\009\009\009\009\"show deck preview\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Right Mouse]\n\009\009\009deselect_hand = {\n\009\009\009\009unlock = { \"Deselect hand\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Press {C:chips}#1#{} to\",\n\009\009\009\009\009\"deselect cards in hand\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009insta_cash_out = {\n\009\009\009\009unlock = { \"Quick cash out\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Press/hold {C:chips}#1#{} to\",\n\009\009\009\009\009\"speed up Cash Out stage\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009insta_booster_skip = {\n\009\009\009\009unlock = { \"Quick skip\", \"booster pack\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Press/hold {C:chips}#1#{} to\",\n\009\009\009\009\009\"skip booster pack\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009move_highlight = {\n\009\009\009\009unlock = { \"Move highlight\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Press {C:chips}#2#{} or {C:chips}#3#{}\",\n\009\009\009\009\009\"to move highlight in card area.\",\n\009\009\009\009\009\"Hold {C:chips}#4#{} to move card instead.\",\n\009\009\009\009\009\"Hold {C:chips}#5#{} to move to first/last card\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_buy_or_sell = {\n\009\009\009\009unlock = { \"Quick buy/sell\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Use {C:chips}#1#{} to\",\n\009\009\009\009\009\"buy or sell card\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_buy_n_sell = {\n\009\009\009\009unlock = { \"Quick buy'n'sell\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Use {C:chips}#1#{} to\",\n\009\009\009\009\009\"buy card and sell\",\n\009\009\009\009\009\"immediately after\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_use = {\n\009\009\009\009unlock = { \"Quick use\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Use {C:chips}#1#{} to\",\n\009\009\009\009\009\"use card if possible\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009cryptid_code_use_last_interaction = {\n\009\009\009\009unlock = { \"Cryptid: use\", \"previous input\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Use {C:chips}#1#{} to\",\n\009\009\009\009\009\"use Code card if possible with\",\n\009\009\009\009\009\"previously inputted value\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009not_just_yet_interaction = {\n\009\009\009\009unlock = { \"NotJustYet:\", \"end round\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Press {C:chips}#1#{} to\",\n\009\009\009\009\009\"end round\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [keybind for Multiply], [keybind for Divide], min value, max value\n\009\009\009speed_multiplier = {\n\009\009\009\009unlock = { \"Speed multiplier\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Hold {C:chips}#1#{} and\",\n\009\009\009\009\009\"{C:chips}#2#{}/{C:chips}#3#{} to\",\n\009\009\009\009\009\"multiply/divide game speed\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Speed Multiplier]\n\009\009\009speed_multiplier_no_hold = {\n\009\009\009\009unlock = { \"Speed multiplier:\", \"No hold\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Decrease amount of\",\n\009\009\009\009\009\"keybinds needed to use\",\n\009\009\009\009\009\"#2#\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009speed_multiplier_settings_toggle = {\n\009\009\009\009unlock = { \"Speed multiplier:\", \"toggle in settings\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Add toggle in game settings\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009insta_highlight_entire_f_hand = {\n\009\009\009\009unlock = { \"Highlight\", \"entire hand\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Press {C:chips}#1#{} to\",\n\009\009\009\009\009\"highlight entire hand\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [keybind for Increase], [keybind for Decrease], [Danger zone tab]\n\009\009\009nopeus_interaction = {\n\009\009\009\009unlock = { \"Nopeus:\", \"fast-forward\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Hold {C:chips}#1#{} and\",\n\009\009\009\009\009\"{C:chips}#2#{}/{C:chips}#3#{} to\",\n\009\009\009\009\009\"increase/decrease fast-forward setting\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Nopeus: fast-forward]\n\009\009\009nopeus_interaction_no_hold = {\n\009\009\009\009unlock = { \"Nopeus:\", \"No hold\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Decrease amount of\",\n\009\009\009\009\009\"keybinds needed to use\",\n\009\009\009\009\009\"#2#\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [keybind for Increase], [keybind for Decrease], [Danger zone tab], None, Messages, Animations, Everything, Unsafe, [Danger zone tab]\n\009\009\009animation_skip = {\n\009\009\009\009unlock = { \"Animation skip\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Hold {C:chips}#1#{} and\",\n\009\009\009\009\009\"{C:chips}#2#{}/{C:chips}#3#{} to\",\n\009\009\009\009\009\"increase/decrease animation skip\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Animation skip]\n\009\009\009animation_skip_no_hold = {\n\009\009\009\009unlock = { \"Animation skip:\", \"No hold\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Decrease amount of\",\n\009\009\009\009\009\"keybinds needed to use\",\n\009\009\009\009\009\"#2#\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009animation_skip_settings_toggle = {\n\009\009\009\009unlock = { \"Animation skip:\", \"toggle in settings\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Add toggle in game settings\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009scoring_hold = {\n\009\009\009\009unlock = { \"Pause scoring\", \"animation\" },\n\009\009\009\009text = {\n\009\009\009\009\009\"Hold {C:chips}#1#{} to\",\n\009\009\009\009\009\"pause scoring animation after\",\n\009\009\009\009\009\"counting total hand score\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009scoring_h