			G.GAME.round_resets.temp_handsize = (G.GAME.round_resets.temp_handsize or 0) + tag.config.h_size
			tag.triggered = true
			return true
		end
	end,
	unlocked = true,
	discovered = true,
	no_collection = MP.sandbox_no_collection,
})
