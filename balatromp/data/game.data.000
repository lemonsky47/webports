ina animaciones inecesarias, sacar cartas de forma instantanea y reiniciar\",\n\009\009\009\009\009\"{C:mult}#8#{} - LÃ­mite absoluto del juego: todo es instantaneo\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"La opciÃ³n {C:mult}#8#{} ha de estar activada en la pÃ¡gina {C:attention}#9#{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009scoring_hold = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Ãštil para mover comodines o\",\n\009\009\009\009\009\"comprobar una puntuaciÃ³n al final de la ronda\",\n\009\009\009\009\009\"cuando la velocidad del juego es muy alta\",\n\009\009\009\009\009\"o se omiten animaciones\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009not_just_yet_interaction = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Necesita el mod {C:attention}NotJustYet{} para funcionar\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_buy_or_sell_desktop = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Uso determinado por el modo\",\n\009\009\009\009\009\"{C:attention}#2#{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_buy_n_sell_desktop = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Uso determinado por el modo\",\n\009\009\009\009\009\"{C:attention}#2#{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_buy_or_sell_gamepad = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Reemplaza el {C:chips}#3#{}\",\n\009\009\009\009\009\"pero funciona igual y puede\",\n\009\009\009\009\009\"ser reasignado a otra tecla\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Desmarca para usar los controles vanilla\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_use_desktop = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Uso determinado por el modo\",\n\009\009\009\009\009\"{C:attention}#2#{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_use_gamepad = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Reemplaza el {C:chips}#3#{}\",\n\009\009\009\009\009\"pero funciona igual y puede\",\n\009\009\009\009\009\"ser reasignado a otra tecla\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Desmarca para usar los controles vanilla\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009cryptid_code_use_last_interaction = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Necesita el mod {C:attention}Cryptid{} para funcionar\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Atajo de teclado para usar cartas de cÃ³digo y seleccionar\",\n\009\009\009\009\009\"la opcciÃ³n {C:green}[Introducir valor anterior]{} para:\",\n\009\009\009\009\009\"{C:green}://VARIABLE{}, {C:green}://CLASS{}, {C:green}://EXPLOIT{}\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Uso determinado por el modo\",\n\009\009\009\009\009\"{C:attention}#2#{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009cryptid_code_use_last_interaction_gamepad = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Necesita el mod {C:attention}Cryptid{} para funcionar\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Atajo de teclado para usar cartas de cÃ³digo y seleccionar\",\n\009\009\009\009\009\"la opcciÃ³n {C:green}[Introducir valor anterior]{} para:\",\n\009\009\009\009\009\"{C:green}://VARIABLE{}, {C:green}://CLASS{}, {C:green}://EXPLOIT{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009insta_highlight_entire_f_hand = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Seleccionar la cantidad mÃ¡xima de cartas\",\n\009\009\009\009\009\"en mano, de izquieda a derecha\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [keybind for Quick buy/sell], [Quick buy/sell], [\"Dangerous\" modifier]\n\009\009\009immediate_buy_and_sell = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Mantener {C:mult}#3#{}, {C:chips}#4#{},\",\n\009\009\009\009\009\"y coloca el cursor sobre ellas para venderlas inmediatamente\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009immediate_buy_and_sell_queue = {\n\009\009\009\009text = {\n\009\009\009\009\009\"En vÃ©z de venderlas inediatamente, {C:mult}[Vender inmediatamente]{}\",\n\009\009\009\009\009\"pondrÃ¡s las cartas a las que se les haya pasado el cursor\",\n\009\009\009\009\009\"en una lista y todas se venderÃ¡n cuando\",\n\009\009\009\009\009\"se suelte el atajo de teclado\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Permite seleccionar cartas con mÃ¡s precisiÃ³n, pero es mÃ¡s lento\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009immediate_buy_and_sell_queue_gamepad = {\n\009\009\009\009text = {\n\009\009\009\009\009\"En vÃ©z de venderlas inediatamente, {C:mult}[Vender inmediatamente]{}\",\n\009\009\009\009\009\"pondrÃ¡s las cartas a las que se les haya pasado el cursor\",\n\009\009\009\009\009\"en una lista y todas se venderÃ¡n cuando\",\n\009\009\009\009\009\"se suelte el atajo de teclado\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Permite seleccionar cartas con mÃ¡s precisiÃ³n, pero es mÃ¡s lento\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"{C:attention}Siempre activo para mandos{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009speed_multiplier_uncap = {\n\009\009\009\009text = {\n\009\009\009\009\009\"{C:mult}Impacta muy negativamente al rendimiento{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009nopeus_unsafe = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Necesita el mod mod {C:attention}Nopeus{} para funcionar\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Aunque esta {C:mult}OpciÃ³n peligrosa{} no estÃ© marcada,\",\n\009\009\009\009\009\"se puede poner de forma manual a travÃ©s\",\n\009\009\009\009\009\"de las opciones del juego\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [keybind for Quick buy/sell], [\"Dangerous\" modifier], [\"All copies\" modifier]\n\009\009\009sell_all_same = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Mantener {C:mult}#3#{}, {C:mult}#4#{},\",\n\009\009\009\009\009\"y had click en una carta para vender todas sus copias Ãºnicas\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [\"Dangerous\" modifier], [\"Sell ALL\" modifier]\n\009\009\009sell_all = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Mantener {C:mult}#2#{}, {C:mult}#3#{},\",\n\009\009\009\009\009\"y haz click en una carta para vender {C:attention}TODAS{} las cartas en el Ã¡rea\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [\"Dangerous\" modifier], [\"REMOVE\" modifier], [Quick buy/sell], [\"All copies\" modifier], [\"ALL\" modifier]\n\009\009\009card_remove = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Cuando se mantenga pulsado, en vez de vender cartas {C:attention}o etiquetas{}, estas serÃ¡n {C:attention,E:1}ELIMINADAS{}\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Mantener {C:mult}#2#{}, {C:mult}#3#{}, {C:chips}#4#{}\",\n\009\009\009\009\009\"y coloca el cursor sobre las cartas para {C:attention,E:1}ELIMINARLAS{} (tambiÃ©n se aplica la cola)\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Mantener {C:mult}#2#{}, {C:mult}#3#{}, {C:mult}#5#{}\",\n\009\009\009\009\009\"y haz click en la carta {C:attention}o etiqueta{} para {C:attention,E:1}ELIMINAR{} todas sus copias\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Mantener {C:mult}#2#{}, {C:mult}#3#{}, {C:mult}#6#{},\",\n\009\009\009\009\009\"y haz click en la carta {C:attention}o etiqueta{} para {C:attention,E:1}ELIMINARLA{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009\009Handy_Preset = {\n\009\009\009[\"default\"] = {\n\009\009\009\009name = \"Por defecto\",\n\009\009\009\009text = {\n\009\009\009\009\009\"Los controles por defecto del mod\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009[\"better_mouse_and_gamepad\"] = {\n\009\009\009\009name = \"'Better Mouse and Gamepad'\",\n\009\009\009\009text = {\n\009\009\009\009\009\"Controles similares a el mod 'Better Mouse and Gamepad'\",\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009},\n\009misc = {\n\009\009-- You don't need to translate all of them, only necessary ones\n\009\009-- I don't care, I'll do ALL of them anyways! -Jogla\n\009\009handy_keybinds = {\n\009\009\009-- No button assigned\n\009\009\009[\"None\"] = \"Ninguno\",\n\009\009\009-- Button which cannot be recognized\n\009\009\009[\"Unknown\"] = \"Desconocido\",\n\n\009\009\009-- Mouse\n\009\009\009[\"Left Mouse\"] = \"Click izquierdo\",\n\009\009\009[\"Right Mouse\"] = \"Click derecho\",\n\009\009\009[\"Middle Mouse\"] = \"Rueda del ratÃ³n\",\n\009\009\009[\"Mouse 4\"] = \"botÃ³n 4 del ratÃ³n\",\n\009\009\009[\"Mouse 5\"] = \"BotÃ³n 5 del ratÃ³n\",\n\009\009\009[\"Wheel Up\"] = \"Rueda hacia arriba\",\n\009\009\009[\"Wheel Down\"] = \"Rueda hacia abajo\",\n\009\009\009-- Controls\n\009\009\009[\"Escape\"] = \"Escape\",\n\009\009\009[\"Shift\"] = \"Shift\",\n\009\009\009[\"Ctrl\"] = \"Ctrl\",\n\009\009\009[\"Alt\"] = \"Alt\",\n\009\009\009[\"GUI\"] = \"Windows/CMD\", -- Windows button, or CMD for Mac\n\009\009\009[\"Enter\"] = \"Enter/Entrar\",\n\009\009\009[\"Tab\"] = \"Tabulador\",\n\009\009\009[\"Backspace\"] = \"Borrar\",\n\009\009\009[\"Num Lock\"] = \"Bloqueo NumÃ©rico\",\n\009\009\009[\"Caps Lock\"] = \"Bloqueo de MayÃºsculas\",\n\009\009\009[\"Scroll Lock\"] = \"Scroll Lock\",\n\009\009\009-- Arrow keys\n\009\009\009[\"Left\"] = \"Izquierda\",\n\009\009\009[\"Right\"] = \"Derecha\",\n\009\009\009[\"Up\"] = \"Arriba\",\n\009\009\009[\"Down\"] = \"abajo\",\n\009\009\009-- Symbols\n\009\009\009[\"Backquote\"] = '\"`\"', -- `\n\009\009\009[\"Singlequote\"] = \"'\", -- '\n\009\009\009[\"Quote\"] = '\"', -- \"\n\009\009\009[\"Left Bracket\"] = \"Abrir llave\", -- [\n\009\009\009[\"Right Bracket\"] = \"Cerrar llave\", -- ]\n\009\009\009-- Weird buttons\n\009\009\009[\"Printscreen\"] = \"Inprimir pantalla\",\n\009\009\009[\"Delete\"] = \"Eliminar\",\n\009\009\009[\"Home\"] = nil,\n