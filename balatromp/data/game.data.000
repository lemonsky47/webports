ity.extra.odds, 'cavendish')}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="elseif self.ability.name == 'Reserved Parking' then loc_vars = {self.ability.extra.dollars, ''..(G.GAME and G.GAME.probabilities.normal or 1), self.ability.extra.odds}",["position"]="at",["payload"]="elseif self.ability.name == 'Reserved Parking' then loc_vars = {self.ability.extra.dollars, SMODS.get_probability_vars(self, 1, self.ability.extra.odds, 'parking')}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="elseif self.ability.name == 'Hallucination' then loc_vars = {G.GAME.probabilities.normal, self.ability.extra}",["position"]="at",["payload"]="elseif self.ability.name == 'Hallucination' then loc_vars = {SMODS.get_probability_vars(self, 1, self.ability.extra, 'halu'..G.GAME.round_resets.ante)}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif _c.effect == 'Glass Card' then loc_vars = {cfg.Xmult, G.GAME.probabilities.normal, cfg.extra}",["position"]="at",["payload"]="elseif _c.effect == 'Glass Card' then loc_vars = {cfg.Xmult, SMODS.get_probability_vars(card, 1, cfg.extra, 'glass')}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif _c.name == \"The Wheel of Fortune\" then loc_vars = {G.GAME.probabilities.normal, cfg.extra};  info_queue[#info_queue+1] = G.P_CENTERS.e_foil; info_queue[#info_queue+1] = G.P_CENTERS.e_holo; info_queue[#info_queue+1] = G.P_CENTERS.e_polychrome;",["position"]="at",["payload"]="elseif _c.name == \"The Wheel of Fortune\" then \n    loc_vars = {SMODS.get_probability_vars(card, 1, cfg.extra, 'wheel_of_fortune')}\n    info_queue[#info_queue+1] = G.P_CENTERS.e_foil\n    info_queue[#info_queue+1] = G.P_CENTERS.e_holo\n    info_queue[#info_queue+1] = G.P_CENTERS.e_polychrome",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="elseif context.buying_card then\n",["position"]="after",["payload"]="elseif context.mod_probability and not context.blueprint and self.config.center_key == 'j_oops' then\n    return {\n        numerator = context.numerator * 2\n    }\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="meta.alerted = meta.alerted or {}",["position"]="after",["payload"]="for _, t in ipairs{\n    G.P_CENTERS,\n    G.P_BLINDS,\n    G.P_TAGS,\n    G.P_SEALS,\n} do\n    for k, v in pairs(t) do\n        SMODS._save_d_u(v)\n        v._discovered_unlocked_overwritten = true\n    end\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="local main_menu = nil",["position"]="after",["payload"]="local mods = nil",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="main_menu = UIBox_button{ label = {localize('b_main_menu')}, button = \"go_to_menu\", minw = 5}",["position"]="after",["payload"]="mods = UIBox_button{ id = \"mods_button\", label = {localize('b_mods')}, button = \"mods_button\", minw = 5}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="G.ARGS.set_alerts_alertables[11].should_alert = alert_booster",["position"]="after",["payload"]="table.insert(G.ARGS.set_alerts_alertables, {id = 'mods_button', alert_uibox_name = 'mods_button_alert', should_alert = SMODS.mod_button_alert})",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="main_menu,",["position"]="after",["payload"]="mods,",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="self.ASSET_ATLAS[self.asset_atli[i].name].image = love.graphics.newImage(self.asset_atli[i].path, {mipmaps = true, dpiscale = self.SETTINGS.GRAPHICS.texture_scaling})",["position"]="after",["payload"]="local mipmap_level = SMODS.config.graphics_mipmap_level_options[SMODS.config.graphics_mipmap_level]\nif mipmap_level and mipmap_level > 0 then\n    self.ASSET_ATLAS[self.asset_atli[i].name].image:setMipmapFilter('linear', mipmap_level)\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="create_option_cycle({w = 4,scale = 0.8, label = localize(\"b_set_CRT_bloom\"),options = localize('ml_bloom_opt'), opt_callback = 'change_crt_bloom', current_option = G.SETTINGS.GRAPHICS.bloom}),",["position"]="after",["payload"]="create_option_cycle({label = localize('b_graphics_mipmap_level'),scale = 0.8, options = SMODS.config.graphics_mipmap_level_options, opt_callback = 'SMODS_change_mipmap', current_option = SMODS.config.graphics_mipmap_level}),",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:set_debuff(should_debuff)",["position"]="after",["payload"]="\009for _, mod in ipairs(SMODS.mod_list) do\n\009\009if mod.set_debuff and type(mod.set_debuff) == 'function' then\n            local res = mod.set_debuff(self)\n            if res == 'prevent_debuff' then\n                if self.debuff then\n                    self.debuff = false\n                    if self.area == G.jokers then self:add_to_deck(true) end\n\009\009\009\009\009self.debuffed_by_blind = false\n                end\n                return\n            end\n\009\009\009should_debuff = should_debuff or res\n\009\009end\n\009end\n\009for k, v in pairs(self.ability.debuff_sources or {}) do\n\009\009if v == 'prevent_debuff' then\n\009\009\009if self.debuff then\n\009\009\009\009self.debuff = false\n\009\009\009\009if self.area == G.jokers then self:add_to_deck(true) end\n\009\009\009end\n\009\009\009self.debuffed_by_blind = false\n\009\009\009return\n\009\009end\n\009\009should_debuff = should_debuff or v\n\009end\n\009\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:draw(layer)",["position"]="before",["payload"]="-- Function overridden by SMODS in src/card_draw.lua",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="G.FUNCS.HUD_blind_debuff = function(e)",["position"]="before",["payload"]="-- Function overridden by SMODS in src/overrides.lua",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="function create_UIBox_your_collection_blinds(exit)",["position"]="before",["payload"]="-- Function overridden by SMODS in src/overrides.lua",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="function create_UIBox_your_collection_tags()",["position"]="before",["payload"]="-- Function overridden by SMODS in src/overrides.lua",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="function G.UIDEF.deck_stake_column(_deck_key)",["position"]="before",["payload"]="-- Function overridden by SMODS in src/overrides.lua",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="function G.UIDEF.stake_option(_type)",["position"]="before",["payload"]="-- Function overridden by SMODS in src/overrides.lua",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="G.FUNCS.change_stake = function(args)",["position"]="before",["payload"]="-- Function overridden by SMODS in src/overrides.lua",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions