uncionar\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009regular_keybinds = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Jugar mano, Descartar, ordenar mano,\",\n\009\009\009\009\009\"Renovar tienda, Irse de tienda, Seleccionar ciega,\",\n\009\009\009\009\009\"Saltarse ciega, Seleccionar ciega, Ver mazo, Partida Info\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Left Mouse]\n\009\009\009insta_highlight = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Si la tecla seleccionada es {C:chips}#2#{},\",\n\009\009\009\009\009\"empieza a mantener la tecla {C:attention}FUERA{} de las\",\n\009\009\009\009\009\"cartas, y luego arrastrar para seleccionarlas\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Left Mouse]\n\009\009\009insta_highlight_gamepad = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Funciona tanto para el cursos y movimiento\",\n\009\009\009\009\009\"via los botones direccionales\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Left Mouse]\n\009\009\009insta_highlight_OUTSIDE = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Para las teclas distintas a {C:chips}#2#{},\",\n\009\009\009\009\009\"empieza a mantener la tecla mientras deslizas.\",\n\009\009\009\009\009\"Una carta tambiÃ©n funcionarÃ¡\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Left Mouse]\n\009\009\009insta_highlight_OUTSIDE_gamepad = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Funciona tanto para el cursor como para el movimiento\",\n\009\009\009\009\009\"vÃ­a los botones direccionales\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Fast hand selection]\n\009\009\009insta_unhighlight = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Seleccionar cartas si la primera carta no fue seleccionada.\",\n\009\009\009\009\009\"Deseleccionar cartas si la primera carta fue seleccionada.\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [Right Mouse]\n\009\009\009deselect_hand_desktop = {\n\009\0