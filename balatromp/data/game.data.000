ard left for back compat, buying_self recommended to use\n    SMODS.trigger_effects({eval, post}, c1)\n    return true\n    end}))\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="          for i = 1, #G.jokers.cards do\n            G.jokers.cards[i]:calculate_joker({buying_card = true, card = c1})\n          end\n",["position"]="at",["payload"]="SMODS.calculate_context({buying_card = true, card = c1})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="G.CONTROLLER:snap_to({node = G.shop:get_UIE_by_ID('next_round_button')})\n",["position"]="before",["payload"]="if not nosave_shop then SMODS.calculate_context({starting_shop = true}) end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="      for i = 1, #G.jokers.cards do\n        G.jokers.cards[i]:calculate_joker({ending_shop = true})\n      end\n",["position"]="at",["payload"]="SMODS.calculate_context({ending_shop = true})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="    for i = 1, #G.jokers.cards do\n      G.jokers.cards[i]:calculate_joker({skipping_booster = true})\n    end\n",["position"]="at",["payload"]="SMODS.calculate_context({skipping_booster = true, booster = booster_obj})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="          for i = 1, #G.jokers.cards do\n            G.jokers.cards[i]:calculate_joker({skip_blind = true})\n          end\n",["position"]="at",["payload"]="SMODS.calculate_context({skip_blind = true})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="            for i = 1, #G.jokers.cards do\n              G.jokers.cards[i]:calculate_joker({reroll_shop = true})\n            end\n",["position"]="at",["payload"]="SMODS.calculate_context({reroll_shop = true, cost = reroll_cost})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if G.GAME.current_round.reroll_cost > 0 then\n",["position"]="before",["payload"]="local reroll_cost = G.GAME.current_round.reroll_cost\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if context.discard then\n    if self.seal == 'Purple' and #G.consumeables.cards + G.GAME.consumeable_buffer < G.consumeables.config.card_limit then",["position"]="at",["payload"]="if context.discard and context.other_card == self then\n    if self.seal == 'Purple' and #G.consumeables.cards + G.GAME.consumeable_buffer < G.consumeables.config.card_limit then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="text = localize{type='variable',key='a_chips',vars={amt}}\n",["position"]="at",["payload"]="text = localize{type='variable',key='a_chips'..(amt<0 and '_minus' or ''),vars={math.abs(amt)}}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="text = localize{type='variable',key='a_mult',vars={amt}}\n",["position"]="at",["payload"]="text = localize{type='variable',key='a_mult'..(amt<0 and '_minus' or ''),vars={math.abs(amt)}}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="text = localize{type='variable',key='a_xmult',vars={amt}}\n",["position"]="at",["payload"]="text = localize{type='variable',key='a_xmult'..(amt<0 and '_minus' or ''),vars={math.abs(amt)}}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="local percent = 0.3\nlocal percent_delta = 0.08\n",["position"]="at",["payload"]="percent = 0.3\npercent_delta = 0.08\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="local percent = (i-0.999)/(#G.hand.cards-0.998) + (j-1)*0.1",["position"]="at",["payload"]="percent = (i-0.999)/(#G.hand.cards-0.998) + (j-1)*0.1",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="local volume = 1",["position"]="after",["payload"]="local trigger = 'before'\nlocal blocking = nil\nlocal blockable = nil\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="volume = extra.edition and 0.3 or sound == 'multhit2' and 0.7 or 1\n",["position"]="after",["payload"]="sound = extra.sound or sound\npercent = extra.pitch or percent\nvolume = extra.volume or volume\ntrigger = extra.trigger or 'before'\nblocking = extra.blocking\nblockable = extra.blockable\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="self.deck = CardArea(",["position"]="before",["payload"]="self.vouchers = CardArea(\n    G.discard.T.x, G.discard.T.y,\n    G.discard.T.w, G.discard.T.h,\n    { type = \"discard\", card_limit = 1e308 }\n)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:apply_to_run(center)",["position"]="after",["payload"]="    local card_to_save = self and copy_card(self) or Card(0, 0, G.CARD_W, G.CARD_H, G.P_CARDS.empty, center)\n    card_to_save.VT.x, card_to_save.VT.y = G.vouchers.T.x, G.vouchers.T.y\n    G.vouchers:emplace(card_to_save)\n    SMODS.enh_cache:clear()\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.set == \"Planet\" and not self.debuff then\n    if context.joker_main then\n        if G.GAME.used_vouchers.v_observatory and self.ability.consumeable.hand_type == context.scoring_name then\n            return {\n                message = localize{type = 'variable', key = 'a_xmult', vars = {G.P_CENTERS.v_observatory.config.extra}},\n                Xmult_mod = G.P_CENTERS.v_observatory.config.extra\n            }\n        end\n    end\nend",["position"]="at",["payload"]="",["indent"]=false},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self.discard_pos = {\n    r = 3.6*(math.random()-0.5),\n    x = math.random(),\n    y = math.random()\n}",["position"]="at",["payload"]="self.discard_pos = {\n    r = 0,\n    x = 0,\n    y = 0,\n}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif (eval_type == 'x_mult') or (eval_type == 'h_x_mult') then\n",["position"]="before",["payload"]="elseif eval_type == 'x_chips' then\n        sound = 'xchips'\n        volume = 0.7\n        amt = amt\n        text = localize{type='variable',key='a_xchips'..(amt<0 and '_minus' or ''),vars={math.abs(amt)}}\n        colour = G.C.BLUE\n        config.type = 'fade'\n        config.scale = 0.7\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if extra.chip_mod then\n",["position"]="at",["payload"]="if extra.chip_mod or extra.Xchip_mod then\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="--Add all the pure bonus cards to the scoring hand\nlocal pures = {}\nfor i=1, #G.play.cards do\n    if next(find_joker('Splash')) then\n        scoring_hand[i] = G.play.cards[i]\n    else\n        if G.play.cards[i].ability.effect == 'Stone Card' then\n            local inside = false\n            for j=1, #scoring_hand do\n                if scoring_hand[j] == G.play.cards[i] then\n                    inside = true\n                end\n            end\n            if not inside then table.insert(pures, G.play.cards[i]) end\n        end\n    end\nend\nfor i=1, #pures do\n    table.insert(scoring_hand, pures[i])\nend\ntable.sort(scoring_hand, function (a, b) return a.T.x < b.T.x end )\n",["position"]="at",["payload"]="local final_scoring_hand = {}\nfor i=1, #G.play.cards do\n    local splashed = SMODS.always_scores(G.play.cards[i]) or next(find_joker('Splash'))\n    local unsplashed = SMODS.never_scores(G.play.cards[i])\n    if not splashed then\n        for _, card in pairs(scoring_hand) do\n            if card == G.play.cards[i] then splashed = true end\n        end\n    end\n    local effects = {}\n    SMODS.calculate_context({modify_scoring_hand = true, other_card =  G.play.cards[i], full_hand = G.play.cards, scoring_hand = scoring_hand, in_scoring = true, ignore_other_debuff = true}, effects)\n    local flags = SMODS.trigger_effects(effects, G.play.cards[i])\n    if flags.add_to_hand then splashed = true end\n\009if flags.remove_from_hand then unsplashed = true end\n    if splashed and not unsplashed then table.insert(final_scoring_hand, G.play.cards[i]) end\nend\n-- TARGET: adding to hand effects\nscoring_hand = final_scoring_hand\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="for i = 1, #G.GAME.tags do\n    if G.GAME.tags[i]:apply_to_run({type = 'new_blind_choice'}) then break end\nend\n\nG.E_MANAGER:add_event(Event({trigger = 'after',delay = 0.2*delayfac,\n          func = function()\n            save_run()\n            return true\n      end}))\n",["position"]="before",["payload"]="SMODS.calculate_context({ending_booster = true, booster = booster_obj})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="G.E_MANAGER:add_event(Event({\n    func = function()\n        local _card = create_playing_card({\n            front = pseudorandom_element(G.P_CARDS, pseudoseed('cert_fr')),\n            center = G.P_CENTERS.c_base}, G.hand, nil, nil, {G.C.SECONDARY_SET.Enhanced})\n        local seal_type = pseudorandom(pseudoseed('certsl'))\n        if seal_type > 0.75 then _card:set_seal('Red', true)\n        elseif seal_type > 0.5 then _card:set_seal('Blue', true)\n        elseif seal_type > 0.25 then _card:set_seal('Gold', true)\n        else _card:set_seal('Purple', true)\n        end\n        G.GAME.blind:debuff_card(_card)\n        G.hand:sort()\n        if context.blueprint_card then context.blueprint_card:juice_up() else self:juice_up() end\n        return true\n    end}))\n\nplaying_card_joker_effects({true})\n",["position"]="at",["payload"]="G.E_MANAGER:add_event(Event({\n    func = function()\n        local _card = create_playing_card({\n            front = pseudorandom_element(G.P_CARDS, pseudoseed('cert_fr')),\n            center = G.P_CENTERS.c_base}, G.hand, nil, nil, {G.C.SECONDARY_SET.Enhanced})\n        _card:set_seal(SMODS.poll_seal({type_key = 'certsl', guaranteed = true}), nil, true)\n        G.GAME.blind:debuff_card(_card)\n        G.hand:sort()\n        if context.blueprint_card then context.blueprint_card:juice_up() else self:juice_up() end\n        playing_card_joker_effects({_card})\n        save_run()\n        return true\n    end}))\n\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="function create_playing_card(card_init, area, skip_materialize, silent, colours)\n",["position"]="at",["payload"]="function create_playing_card(card_init, area, skip_materialize, silent, colours, skip_emplace)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if area then area:emplace(card) end\n",["position"]="at",["payload"]="if area and not skip_emplace then area:emplace(card) end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="G.E_MANAGER:add_event(Event({\n    func = function()\n        local front = pseudorandom_element(G.P_CARDS, pseudoseed('marb_fr'))\n        G.playing_card = (G.playing_card and G.playing_card + 1) or 1\n        local card = Card(G.play.T.x + G.play.T.w/2, G.play.T.y, G.CARD_W, G.CARD_H, front, G.P_CENTERS.m_stone, {playing_card = G.playing_card})\n        card:start_materialize({G.C.SECONDARY_SET.Enhanced})\n        G.play:emplace(card)\n        table.insert(G.playing_cards, card)\n        return true\n    end}))\ncard_eval_status_text(context.blueprint_card or self, 'extra', nil, nil, nil, {message = localize('k_plus_stone'), colour = G.C.SECONDARY_SET.Enhanced})\n\nG.E_MANAGER:add_event(Event({\n    func = function()\n        G.deck.config.card_limit = G.deck.config.card_limit + 1\n        return true\n    end}))\n    draw_card(G.play,G.deck, 90,'up', nil)\n\nplaying_card_joker_effects({true})\n",["position"]="at",["payload"]="G.E_MANAGER:add_event(Event({\n    func = function()\n        local card = create_playing_card({\n            front = pseudorandom_element(G.P_CARDS, pseudoseed('marb_fr')),\n            center = G.P_CENTERS.m_stone}, G.play, nil, nil, {G.C.SECONDARY_SET.Enhanced})\n        SMODS.calculate_effect({message = localize('k_plus_stone'), colour = G.C.SECONDARY_SET.Enhanced}, context.blueprint_card or self)\n        playing_card_joker_effects({card})\n        return true\n    end}))\ndraw_card(G.play,G.deck, 90,'up', nil)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="playing_cards_created = {true}",["position"]="at",["payload"]="playing_cards_created = {_card}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if context.cardarea == G.jokers then",["position"]="at",["payload"]="do",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="{n=G.UIT.O, config={object = DynaText({scale = 0.6, string = G.GAME.blind:get_loc_debuff_text(), maxw = 9, colours = {G.C.WHITE},float = true, shadow = true, silent = true, pop_in = 0, pop_in_rate = 6})}},",["position"]="at",["payload"]="{n=G.UIT.O, config={func = \"update_blind_debuff_text\", object = DynaText({scale = 0.6, string = SMODS.debuff_text or G.GAME.blind:get_loc_debuff_text(), maxw = 9, colours = {G.C.WHITE},float = true, shadow = true, silent = true, pop_in = 0, pop_in_rate = 6})}},",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="{n=G.UIT.O, config={object = DynaText({string = {' '..localize('ph_mr_bones')..' '}, colours = {G.C.FILTER}, shadow = true, pop_in = 0, scale = 0.5*scale, silent = true})}}\n",["position"]="at",["payload"]="{n=G.UIT.O, config={object = DynaText({string = {' '..(type(G.GAME.saved_text) == 'string' and (G.localization.misc.dictionary[G.GAME.saved_text] and localize(G.GAME.saved_text) or G.GAME.saved_text) or localize('ph_mr_bones'))..' '}, colours = {G.C.FILTER}, shadow = true, pop_in = 0, scale = 0.5*scale, silent = true})}}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="local dissolve_time = 0.7*(dissolve_time_fac or 1)\n",["position"]="before",["payload"]="dissolve_colours = dissolve_colours or (type(self.destroyed) == 'table' and self.destroyed.colours) or nil\ndissolve_time_fac = dissolve_time_fac or (type(self.destroyed) == 'table' and self.destroyed.time) or nil\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="delay = G.GAME.current_round.current_hand.handname ~= disp_text and 0.4 or 0}, {handname=disp_text, level=G.GAME.hands[text].level, mult = G.GAME.hands[text].mult, chips = G.GAME.hands[text].chips})",["position"]="after",["payload"]="    \nfor name, parameter in pairs(SMODS.Scoring_Parameters) do\n    if name ~= 'chips' and name ~= 'mult' then update_hand_text({immediate = true}, {[name] = parameter.current}) end\nend\nSMODS.displayed_hand = text\nSMODS.displaying_scoring = true",["indent"]=false},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="hand_chips = mod_chips(0)",["position"]="after",["payload"]="SMODS.displayed_hand = nil",["indent"]=true,["times"]=1},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="  func = (function() G.GAME.current_round.current_hand.handname = '';return true end)\n}))\ndelay(0.3)",["position"]="after",["payload"]="    SMODS.displaying_scoring = nil",["indent"]=false},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="G.E_MANAGER:add_event(Event({\n    func = function()\n        play_sound('tarot1')\n        self.T.r = -0.2\n        self:juice_up(0.3, 0.4)\n        self.states.drag.is = true\n        self.children.center.pinch.x = true\n        G.E_MANAGER:add_event(Event({trigger = 'after', delay = 0.3, blockable = false,\n            func = function()\n                    G.jokers:remove_card(self)\n                    self:remove()\n                    self = nil\n                return true; end})) \n        return true\n    end\n})) \n",["position"]="at",["payload"]="SMODS.destroy_cards(self, nil, nil, true)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:start_dissolve(dissolve_colours, silent, dissolve_time_fac, no_juice)\n",["position"]="after",["payload"]="    if self.getting_sliced and not (self.ability.set == 'Default' or self.ability.set == 'Enhanced') then\n        local flags = SMODS.calculate_context({joker_type_destroyed = true, card = self})\n        if flags.no_destroy then self.getting_sliced = nil; return end\n    end\n    if self.skip_destroy_animation then\n        G.E_MANAGER:add_event(Event({\n            func = function()\n                play_sound('tarot1')\n                self.T.r = -0.2\n                self:juice_up(0.3, 0.4)\n                self.states.drag.is = true\n                self.children.center.pinch.x = true\n                G.E_MANAGER:add_event(Event({trigger = 'after', delay = 0.3, blockable = false,\n                    func = function()\n                            G.jokers:remove_card(self)\n                            self:remove()\n                            self = nil\n                        return true; end})) \n                return true\n            end\n        })) \n        return\n    end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:shatter()\n",["position"]="after",["payload"]="    if self.getting_sliced and not (self.ability.set == 'Default' or self.ability.set == 'Enhanced') then\n        local flags = SMODS.calculate_context({joker_type_destroyed = true, card = self, shatters = true})\n        if flags.no_destroy then self.getting_sliced = nil; return end\n    end\n    if self.skip_destroy_animation then\n        G.E_MANAGER:add_event(Event({\n            func = function()\n                play_sound('tarot1')\n                self.T.r = -0.2\n                self:juice_up(0.3, 0.4)\n                self.states.drag.is = true\n                self.children.center.pinch.x = true\n                G.E_MANAGER:add_event(Event({trigger = 'after', delay = 0.3, blockable = false,\n                    func = function()\n                            G.jokers:remove_card(self)\n                            self:remove()\n                            self = nil\n                        return true; end})) \n                return true\n            end\n        })) \n        return\n    end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if my_pos and G.jokers.cards[my_pos+1] and not self.getting_sliced and not G.jokers.cards[my_pos+1].ability.eternal and not G.jokers.cards[my_pos+1].getting_sliced then \n",["position"]="at",["payload"]="if my_pos and G.jokers.cards[my_pos+1] and not self.getting_sliced and not SMODS.is_eternal(G.jokers.cards[my_pos+1], self) and not G.jokers.cards[my_pos+1].getting_sliced then\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if G.jokers.cards[i] ~= self and not G.jokers.cards[i].ability.eternal and not G.jokers.cards[i].getting_sliced then destructable_jokers[#destructable_jokers+1] = G.jokers.cards[i] end\n",["position"]="at",["payload"]="if G.jokers.cards[i] ~= self and not SMODS.is_eternal(G.jokers.cards[i], self) and not G.jokers.cards[i].getting_sliced then destructable_jokers[#destructable_jokers+1] = G.jokers.cards[i] end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if not v.ability.eternal then deletable_jokers[#deletable_jokers + 1] = v end\n",["position"]="at",["payload"]="if not SMODS.is_eternal(v, self) then deletable_jokers[#deletable_jokers + 1] = v end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if v ~= eligible_card and (not v.ability.eternal) then v:start_dissolve(nil, _first_dissolve);_first_dissolve = true end\n",["position"]="at",["payload"]="if v ~= eligible_card and (not SMODS.is_eternal(v, self)) then v.getting_sliced = true; v:start_dissolve(nil, _first_dissolve);_first_dissolve = true end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="not self.ability.eternal then\n",["position"]="at",["payload"]="not SMODS.is_eternal(self, {from_sell = true}) then\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="G.GAME.tags[#G.GAME.tags+1] = _tag\n",["position"]="after",["payload"]="if not _tag.from_load then SMODS.calculate_context({tag_added = _tag}) end\n_tag.from_load = nil\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"tag.lua"},["pattern"]="G.GAME.tag_tally = math.max(self.tally, G.GAME.tag_tally) + 1\n",["position"]="after",["payload"]="self.from_load = true\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.name == 'Campfire' and not context.blueprint then\n",["position"]="at",["payload"]="if self.ability.name == 'Campfire' and not context.blueprint and self ~= context.card then\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="delay(0.4); ease_ante(1); delay(0.4); check_for_unlock({type = 'ante_up', ante = G.GAME.round_resets.ante + 1})\n",["position"]="at",["payload"]="delay(0.4); SMODS.ante_end = true; ease_ante(1); SMODS.ante_end = nil; delay(0.4); check_for_unlock({type = 'ante_up', ante = G.GAME.round_resets.ante + 1})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.name == 'Sixth Sense' and #context.full_hand == 1 and context.full_hand[1]:get_id() == 6 and G.GAME.current_round.hands_played == 0 then\n",["position"]="at",["payload"]="if self.ability.name == 'Sixth Sense' and #context.full_hand == 1 and context.full_hand[1]:get_id() == 6 and not context.full_hand[1].sixth_sense and G.GAME.current_round.hands_played == 0 then\n    context.full_hand[1].sixth_sense = true\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if other_joker and other_joker ~= self then\n    context.blueprint = (context.blueprint and (context.blueprint + 1)) or 1\n    context.blueprint_card = context.blueprint_card or self\n    if context.blueprint > #G.jokers.cards + 1 then return end\n    local other_joker_ret = other_joker:calculate_joker(context)\n    if other_joker_ret then \n        other_joker_ret.card = context.blueprint_card or self\n        other_joker_ret.colour = G.C.BLUE\n        return other_joker_ret\n    end\nend\n",["position"]="at",["payload"]="local ret = SMODS.blueprint_effect(self, other_joker, context)\nif ret then\n    ret.colour = G.C.BLUE\n    return ret\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if other_joker and other_joker ~= self then\n    context.blueprint = (context.blueprint and (context.blueprint + 1)) or 1\n    context.blueprint_card = context.blueprint_card or self\n    if context.blueprint > #G.jokers.cards + 1 then return end\n    local other_joker_ret = other_joker:calculate_joker(context)\n    if other_joker_ret then \n        other_joker_ret.card = context.blueprint_card or self\n        other_joker_ret.colour = G.C.RED\n        return other_joker_ret\n    end\nend\n",["position"]="at",["payload"]="local ret = SMODS.blueprint_effect(self, other_joker, context)\nif ret then\n    ret.colour = G.C.RED\n    return ret\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="table.sort(G.playing_cards, function (a, b) return a.playing_card > b.playing_card end )\n",["position"]="before",["payload"]="if saveTable then\n    if saveTable.SMODS then\n        SMODS.last_hand = {scoring_hand = {}, full_hand = {}, scoring_name = saveTable.SMODS.last_hand.scoring_name}\n        for _, v in ipairs({'scoring_hand','full_hand'}) do\n            for _, card in ipairs(G.playing_cards) do\n                if card.ability['SMODS_'..v] then\n                    SMODS.last_hand[v][card.ability['SMODS_'..v]] = card\n                end\n            end\n        end\n\009end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:calculate_joker(context)\n    if self.debuff then return nil end\n",["position"]="after",["payload"]="    local context_blueprint_card = context.blueprint_card",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if context.blueprint_card then context.blueprint_card:juice_up() else self:juice_up() end",["position"]="at",["payload"]="if context_blueprint_card then context_blueprint_card:juice_up() else self:juice_up() end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="card:set_debuff(true)",["position"]="after",["payload"]="if card.debuff then card.debuffed_by_blind = true end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="G.GAME.last_blind = G.GAME.last_blind or {}",["position"]="before",["payload"]="local obj = self.config.blind\nself.children.animatedSprite = SMODS.create_sprite(self.T.x, self.T.y, self.T.w, self.T.h, obj.atlas or 'blind_chips', obj.pos or G.P_BLINDS.bl_small.pos)\nself.children.animatedSprite.states = self.states\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="if self.name == 'The Eye' and not reset then",["position"]="at",["payload"]="if blind then\n    self.in_blind = true\nend\nlocal obj = self.config.blind\nif not reset and obj.set_blind and type(obj.set_blind) == 'function' then\n    obj:set_blind()\nelseif self.name == 'The Eye' and not reset then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="if self.name == 'The Water' then",["position"]="before",["payload"]="local obj = self.config.blind\nif obj.disable and type(obj.disable) == 'function' then\n    obj:disable()\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="if self.name == 'The Manacle' and not self.disabled then",["position"]="before",["payload"]="local obj = self.config.blind\nif obj.defeat and type(obj.defeat) == 'function' then\n    obj:defeat()\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="if self.debuff and not self.disabled and card.area ~= G.jokers then",["position"]="before",["payload"]="local obj = self.config.blind\nif not self.disabled and obj.recalc_debuff and type(obj.recalc_debuff) == 'function' then\n    if obj:recalc_debuff(card, from_blind) then\n        card:set_debuff(true)\n        if card.debuff then card.debuffed_by_blind = true end\n    else\n        card:set_debuff(false)\n    end\n    return\nelseif not self.disabled and obj.debuff_card and type(obj.debuff_card) == 'function' then\n    sendWarnMessage((\"Blind object %s has debuff_card function, recalc_debuff is preferred\"):format(obj.key), obj.set)\n    if obj:debuff_card(card, from_blind) then\n        card:set_debuff(true)\n        if card.debuff then card.debuffed_by_blind = true end\n    else\n        card:set_debuff(false)\n    end\n    return\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="function Blind:stay_flipped(area, card)",["position"]="at",["payload"]="function Blind:stay_flipped(area, card, from_area)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="if area == G.hand then",["position"]="before",["payload"]="local obj = self.config.blind\nif obj.stay_flipped and type(obj.stay_flipped) == 'function' then\n    return obj:stay_flipped(area, card, from_area)\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="local stay_flipped = G.GAME and G.GAME.blind and G.GAME.blind:stay_flipped(self, card)",["position"]="at",["payload"]="local stay_flipped = G.GAME and G.GAME.blind and G.GAME.blind:stay_flipped(self, card, area)\nif SMODS.to_area then to = SMODS.to_area; SMODS.to_area = nil end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="local stay_flipped = G.GAME and G.GAME.blind and G.GAME.blind:stay_flipped(to, card)",["position"]="at",["payload"]="local stay_flipped = G.GAME and G.GAME.blind and G.GAME.blind:stay_flipped(to, card, from)\nif SMODS.to_area then to = SMODS.to_area; SMODS.to_area = nil end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="if self.debuff then",["position"]="before",["payload"]="local obj = self.config.blind\nif obj.debuff_hand and type(obj.debuff_hand) == 'function' then\n    return obj:debuff_hand(cards, hand, handname, check)\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="if self.disabled then return mult, hand_chips, false end",["position"]="after",["payload"]="local obj = self.config.blind\nif obj.modify_hand and type(obj.modify_hand) == 'function' then\n    return obj:modify_hand(cards, poker_hands, text, mult, hand_chips)\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="function Blind:modify_hand(cards, poker_hands, text, mult, hand_chips)",["position"]="at",["payload"]="function Blind:modify_hand(cards, poker_hands, text, mult, hand_chips, scoring_hand)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="mult, hand_chips, modded = G.GAME.blind:modify_hand(G.play.cards, poker_hands, text, mult, hand_chips)",["position"]="at",["payload"]="mult, hand_chips, modded = G.GAME.blind:modify_hand(G.play.cards, poker_hands, text, mult, hand_chips, scoring_hand)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="if self.name == \"The Hook\" then",["position"]="before",["payload"]="local obj = self.config.blind\nif obj.press_play and type(obj.press_play) == 'function' then\n    return obj:press_play()\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="function Blind:get_loc_debuff_text()",["position"]="after",["payload"]="    local obj = self.config.blind\n    if obj.get_loc_debuff_text and type(obj.get_loc_debuff_text) == 'function' then\n        return obj:get_loc_debuff_text()\n    end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="local loc_target = localize{type = 'raw_descriptions', key = self.config.blind.key, set = 'Blind', vars = loc_vars or self.config.blind.vars}",["position"]="at",["payload"]="local target = {type = 'raw_descriptions', key = self.config.blind.key, set = 'Blind', vars = loc_vars or self.config.blind.vars}\nlocal obj = self.config.blind\nif obj.loc_vars and type(obj.loc_vars) == 'function' then\n    local res = obj:loc_vars() or {}\n    target.vars = res.vars or target.vars\n    target.key = res.key or target.key\n    target.set = res.set or target.set\n    target.scale = res.scale\n    target.text_colour = res.text_colour\nend\nlocal loc_target = localize(target)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="if G.P_BLINDS[blindTable.config_blind] then",["position"]="after",["payload"]="if self.config.blind.atlas then\n    self.children.animatedSprite.atlas = SMODS.get_atlas(self.config.blind.atlas)\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="blind_matrix[math.ceil((k-1)/5+0.001)][1+((k-1)%5)] = {n=G.UIT.C, config={align = \"cm\", padding = 0.1}, nodes={",["position"]="at",["payload"]="local blinds_per_row = math.ceil(#blind_tab / 6)\nlocal row = math.ceil((k - 1) / blinds_per_row + 0.001)\ntable.insert(blind_matrix[row], {\n    n = G.UIT.C,\n    config = { align = \"cm\", padding = 0.1 },\n    nodes = {\n        ((k - blinds_per_row) % (2 * blinds_per_row) == 1) and { n = G.UIT.B, config = { h = 0.2, w = 0.5 } } or nil,\n        { n = G.UIT.O, config = { object = temp_blind, focus_with_object = true } },\n        ((k - blinds_per_row) % (2 * blinds_per_row) == 0) and { n = G.UIT.B, config = { h = 0.2, w = 0.5 } } or nil,\n    }\n})",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="table.sort(blind_tab, function (a, b) return a.order < b.order end)",["position"]="at",["payload"]="table.sort(blind_tab, function(a, b) return a.order + (a.boss and a.boss.showdown and 1000 or 0) < b.order + (b.boss and b.boss.showdown and 1000 or 0) end)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="local blind_sprite = AnimatedSprite(0, 0, 1.2,1.2, G.ANIMATION_ATLAS['blind_chips'], copy_table(G.GAME.blind.pos))",["position"]="at",["payload"]="local obj = G.GAME.blind.config.blind\nlocal blind_sprite = AnimatedSprite(0, 0, 1.2, 1.2, G.ANIMATION_ATLAS[obj.atlas] or G.ANIMATION_ATLAS['blind_chips'], copy_table(G.GAME.blind.pos))",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif _c.set == 'Tarot' then",["position"]="before",["payload"]="elseif _c.set == 'Blind' then\n    local coll_loc_vars = (_c.collection_loc_vars and type(_c.collection_loc_vars) == 'function' and _c:collection_loc_vars()) or {}\n    loc_vars = coll_loc_vars.vars or _c.vars\n    localize{type = 'descriptions', key = coll_loc_vars.key or _c.key, set = _c.set, nodes = desc_nodes, vars = loc_vars}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="local loc_target = localize{type = 'raw_descriptions', key = blind_choice.config.key, set = 'Blind', vars = {localize(G.GAME.current_round.most_played_poker_hand, 'poker_hands')}}",["position"]="at",["payload"]="local target = {type = 'raw_descriptions', key = blind_choice.config.key, set = 'Blind', vars = {}}\nif blind_choice.config.name == 'The Ox' then\n       target.vars = {localize(G.GAME.current_round.most_played_poker_hand, 'poker_hands')}\nend\nlocal obj = blind_choice.config\nif obj.loc_vars and _G['type'](obj.loc_vars) == 'function' then\n    local res = obj:loc_vars() or {}\n    target.vars = res.vars or target.vars\n    target.key = res.key or target.key\n    target.set = res.set or target.set\n    target.scale = res.scale\n    target.text_colour = res.text_colour\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="local loc_name = localize{type = 'name_text', key = blind_choice.config.key, set = 'Blind'}\nlocal text_table = loc_target\n",["position"]="at",["payload"]="local loc_name = localize{type = 'name_text', key = target.key or blind_choice.config.key, set = target.set or 'Blind'}\nlocal text_table = G.localization.descriptions[target.set][target.key].text_parsed\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="local loc_target = localize{type = 'raw_descriptions', key = blind.key, set = 'Blind', vars = vars or blind.vars}\nlocal loc_name = localize{type = 'name_text', key = blind.key, set = 'Blind'}\n",["position"]="at",["payload"]="local target = {type = 'raw_descriptions', key = blind.key, set = 'Blind', vars = vars or blind.vars}\nif blind.collection_loc_vars and type(blind.collection_loc_vars) == 'function' then\n    local res = blind:collection_loc_vars() or {}\n    target.vars = res.vars or target.vars\n    target.key = res.key or target.key\n    target.set = res.set or target.set\n    target.scale = res.scale\n    target.text_colour = res.text_colour\nend\nlocal loc_target = G.localization.descriptions[target.set][target.key].text_parsed\nlocal loc_name = localize{type = 'name_text', key = target.key or blind.key, set = target.set or 'Blind'}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="ability_text[#ability_text + 1] = {n=G.UIT.R, config={align = \"cm\"}, nodes={{n=G.UIT.T, config={text = (k ==1 and blind.name == 'The Wheel' and '1' or '')..v, scale = 0.35, shadow = true, colour = G.C.WHITE}}}}\n",["position"]="at",["payload"]="ability_text[#ability_text + 1] = {n=G.UIT.R, config={align = \"cm\"}, nodes=SMODS.localize_box(v, {default_col = target.text_colour or G.C.WHITE, shadow = true, vars = target.vars, scale = target.scale})}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="local blind_choice = {config = G.GAME.blind.config.blind or G.P_BLINDS.bl_small}\n",["position"]="after",["payload"]="local target = {type = 'name_text', key = blind_choice.config.key, set = 'Blind'}\nif blind_choice.config.loc_vars and type(blind_choice.config.loc_vars) == 'function' then\n    local res = blind_choice.config:loc_vars() or {}\n    target.key = res.key or target.key\n    target.set = res.set or target.set\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.O, config={object = DynaText({string = localize{type ='name_text', key = blind_choice.config.key, set = 'Blind'}, colours = {G.C.WHITE},shadow = true, float = true,maxw = 2.2, scale = 0.45})}}\n",["position"]="at",["payload"]="{n=G.UIT.O, config={object = DynaText({string = localize(target), colours = {G.C.WHITE},shadow = true, float = true,maxw = 2.2, scale = 0.45})}}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if not v.boss then\n\nelseif not v.boss.showdown and (v.boss.min <= math.max(1, G.GAME.round_resets.ante) and ((math.max(1, G.GAME.round_resets.ante))%G.GAME.win_ante ~= 0 or G.GAME.round_resets.ante < 2)) then\n    eligible_bosses[k] = true\nelseif v.boss.showdown and (G.GAME.round_resets.ante)%G.GAME.win_ante == 0 and G.GAME.round_resets.ante >= 2 then\n    eligible_bosses[k] = true\nend\n",["position"]="at",["payload"]="local res, options = SMODS.add_to_pool(v)\noptions = options or {}\nif not v.boss then\n\nelseif options.ignore_showdown_check then\n    eligible_bosses[k] = res and true or nil\nelseif v.in_pool and type(v.in_pool) == 'function' then\n    if\n        (\n            ((G.GAME.round_resets.ante)%G.GAME.win_ante == 0 and G.GAME.round_resets.ante >= 2) ==\n            (v.boss.showdown or false)\n        )\n    then\n        eligible_bosses[k] = res and true or nil\n    end\nelseif not v.boss.showdown and (v.boss.min <= math.max(1, G.GAME.round_resets.ante) and ((math.max(1, G.GAME.round_resets.ante))%G.GAME.win_ante ~= 0 or G.GAME.round_resets.ante < 2)) then\n    eligible_bosses[k] = res and true or nil\nelseif v.boss.showdown and (G.GAME.round_resets.ante)%G.GAME.win_ante == 0 and G.GAME.round_resets.ante >= 2 then\n    eligible_bosses[k] = res and true or nil\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="local temp_blind = AnimatedSprite(0,0,1,1, G.ANIMATION_ATLAS['blind_chips'], v.pos)",["position"]="at",["payload"]="local temp_blind = AnimatedSprite(0,0,1,1, G.ANIMATION_ATLAS[v.atlas or ''] or G.ANIMATION_ATLAS['blind_chips'], v.pos)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="self.config.blind = blind or {}",["position"]="after",["payload"]="self.effect = type(self.config.blind.config) == \"table\" and copy_table(self.config.blind.config) or {}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="function Blind:load(blindTable)",["position"]="after",["payload"]="self.effect = blindTable.effect\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="local blindTable = {",["position"]="after",["payload"]="effect = self.effect,\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="        if extra.edition then ",["position"]="before",["payload"]="if extra.sound_override then\n    sound = extra.sound_override\nend\nif extra.update_blind_size then\n    G.CARD_EVAL_TRIGGERED = nil\n    update_blind_size = true\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="    local trigger = 'before'",["position"]="before",["payload"]="local update_blind_size = nil\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="play_sound(sound, 0.8+percent*0.2, volume)",["position"]="before",["payload"]="if update_blind_size then\n    G.BLIND_SIZE_DISPLAY_QUEUE = G.BLIND_SIZE_DISPLAY_QUEUE or {}\n    table.remove(G.BLIND_SIZE_DISPLAY_QUEUE, 1)\n    G.HUD_blind:get_UIE_by_ID('HUD_blind_count'):juice_up(0.3, 0.3)\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"globals.lua"},["pattern"]="RENTAL = HEX('b18f43'),",["position"]="after",["payload"]="BLIND_SIZE = HEX('ad5353'),\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="white = G.C.WHITE,",["position"]="after",["payload"]="blind = G.C.DYN_UI.DARK,\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="if blind_state == 'Select' then blind_state = 'Current' end",["position"]="after",["payload"]="local blind_desc_nodes = {}\nfor k, v in ipairs(text_table) do\n  blind_desc_nodes[#blind_desc_nodes+1] = {n=G.UIT.R, config={align = \"cm\", maxw = 2.8}, nodes=SMODS.localize_box(v, {default_col = disabled and G.C.UI.TEXT_INACTIVE or target.text_colour or G.C.WHITE, shadow = not disabled, vars = target.vars, scale = target.scale})}\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="for k, v in ipairs(loc_target) do",["position"]="before",["payload"]="EMPTY(self.loc_debuff_lines)\nif G.localization.descriptions[target.set][target.key] then\n    self.update_loc_debuff_lines = true\n    self.loc_name = self.name == '' and self.name or localize{type ='name_text', key = target.key, set = target.set}\n    for k, v in ipairs(G.localization.descriptions[target.set][target.key].text_parsed) do\n        self.loc_debuff_lines[k] = v\n    end\n    self.loc_debuff_lines.vars = target.vars\n    self.loc_debuff_lines.scale = target.scale\n    self.loc_debuff_lines.text_colour = target.text_colour\nelse\n    for k, v in ipairs(loc_target) do\n        self.loc_debuff_lines[k] = v\n    end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.R, config={align = \"cm\", id = 'row_blind', minw = 1, minh = 3.75}, nodes={}},",["position"]="at",["payload"]="{n=G.UIT.R, config={align = \"cm\", id = 'row_blind', minw = 1, minh = 3.75}, nodes={\n    {n=G.UIT.B, config={w=0, h=3.64, id = 'row_blind_bottom'}, nodes={}}\n}},",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="config = {major = G.HUD:get_UIE_by_ID('row_blind'), align = 'cm', offset = {x=0,y=-10}, bond = 'Weak'}",["position"]="at",["payload"]="config = {major = G.HUD:get_UIE_by_ID('row_blind_bottom'), align = 'bmi', offset = {x=0,y=-10}, bond = 'Weak'}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="G.GAME.blind.children.animatedSprite:juice_up(0.05, 0.02)",["position"]="at",["payload"]="if SMODS.hand_debuff_source then\n    SMODS.hand_debuff_source:juice_up(0.05, 0.1)\nelse\n    G.GAME.blind.children.animatedSprite:juice_up(0.05, 0.02)\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.name:find('Arcana') then\n            G.STATE = G.STATES.TAROT_PACK\n            G.GAME.pack_size = self.ability.extra\n        elseif self.ability.name:find('Celestial') then\n            G.STATE = G.STATES.PLANET_PACK\n            G.GAME.pack_size = self.ability.extra\n        elseif self.ability.name:find('Spectral') then\n            G.STATE = G.STATES.SPECTRAL_PACK\n            G.GAME.pack_size = self.ability.extra\n        elseif self.ability.name:find('Standard') then\n            G.STATE = G.STATES.STANDARD_PACK\n            G.GAME.pack_size = self.ability.extra\n        elseif self.ability.name:find('Buffoon') then\n            G.STATE = G.STATES.BUFFOON_PACK\n            G.GAME.pack_size = self.ability.extra\n        end\n\n        G.GAME.pack_choices = self.config.center.config.choose or 1",["position"]="at",["payload"]="booster_obj = self.config.center\nif booster_obj and SMODS.Centers[booster_obj.key] then\n    G.STATE = G.STATES.SMODS_BOOSTER_OPENED\n    SMODS.OPENED_BOOSTER = self\nend\nG.GAME.pack_choices = math.min((self.ability.choose or self.config.center.config.choose or 1) + (G.GAME.modifiers.booster_choice_mod or 0), self.ability.extra and math.max(1, self.ability.extra + (G.GAME.modifiers.booster_size_mod or 0)) or self.config.center.extra and math.max(1, self.config.center.extra + (G.GAME.modifiers.booster_size_mod or 0)) or 1)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="local _size = self.ability.extra\n",["position"]="at",["payload"]="local _size = math.max(1, self.ability.extra + (G.GAME.modifiers.booster_size_mod or 0))\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="card.T.x = self.T.x\n",["position"]="before",["payload"]="SMODS.calculate_context({modify_booster_card = true, booster = self, card = card, index = i})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="(self.config.type == 'deck' and self ~= G.deck) or",["position"]="before",["payload"]="(self.config.type == 'hand' and state == G.STATES.SMODS_BOOSTER_OPENED) or",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="prev_state == G.STATES.SPECTRAL_PACK or prev_state == G.STATES.STANDARD_PACK or",["position"]="after",["payload"]="prev_state == G.STATES.SMODS_BOOSTER_OPENED or",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="if self.config.type == 'hand' and (G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.SPECTRAL_PACK  or G.STATE == G.STATES.PLANET_PACK) then",["position"]="at",["payload"]="if self.config.type == 'hand' and (G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.SPECTRAL_PACK or G.STATE == G.STATES.PLANET_PACK or G.STATE == G.STATES.SMODS_BOOSTER_OPENED) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="if self.config.type == 'hand' and not (G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.SPECTRAL_PACK or G.STATE == G.STATES.PLANET_PACK) then",["position"]="at",["payload"]="if self.config.type == 'hand' and not (G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.SPECTRAL_PACK or G.STATE == G.STATES.PLANET_PACK or G.STATE == G.STATES.SMODS_BOOSTER_OPENED) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if G.STATE == G.STATES.SELECTING_HAND or G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.SPECTRAL_PACK or G.STATE == G.STATES.PLANET_PACK then",["position"]="at",["payload"]="if G.STATE == G.STATES.SELECTING_HAND or G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.SPECTRAL_PACK or G.STATE == G.STATES.PLANET_PACK or G.STATE == G.STATES.SMODS_BOOSTER_OPENED then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.PLANET_PACK or G.STATE == G.STATES.SPECTRAL_PACK then",["position"]="at",["payload"]="if nc then\n    if area then area:remove_from_highlighted(card) end\n    play_sound('cardSlide2', nil, 0.3)\n    dont_dissolve = true\nend\nif (G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.PLANET_PACK or G.STATE == G.STATES.SPECTRAL_PACK or G.STATE == G.STATES.SMODS_BOOSTER_OPENED) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if area == G.consumeables then",["position"]="before",["payload"]="if nc and area == G.pack_cards and not select_to then G.pack_cards:remove_card(card); G.consumeables:emplace(card) end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if prev_state == G.STATES.TAROT_PACK then inc_career_stat('c_tarot_reading_used', 1) end",["position"]="at",["payload"]="if prev_state == G.STATES.SMODS_BOOSTER_OPENED and booster_obj.name:find('Arcana') then inc_career_stat('c_tarot_reading_used', 1) end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if prev_state == G.STATES.PLANET_PACK then inc_career_stat('c_planetarium_used', 1) end",["position"]="at",["payload"]="if prev_state == G.STATES.SMODS_BOOSTER_OPENED and booster_obj.name:find('Celestial') then inc_career_stat('c_planetarium_used', 1) end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="(G.STATE == G.STATES.BUFFOON_PACK and G.STATES.BUFFOON_PACK) or",["position"]="before",["payload"]="(G.STATE == G.STATES.SMODS_BOOSTER_OPENED and G.STATES.SMODS_BOOSTER_OPENED) or",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if not (G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.SPECTRAL_PACK) and",["position"]="at",["payload"]="if not (G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.SPECTRAL_PACK or G.STATE == G.STATES.SMODS_BOOSTER_OPENED) and",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="e.config.ref_table:redeem()",["position"]="before",["payload"]="if area == G.pack_cards then e.config.ref_table.cost = 0 end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="if card.ability.consumeable then\n    if (card.area == G.pack_cards and G.pack_cards) then\n",["position"]="before",["payload"]="if card.ability.consumeable and card.area == G.pack_cards and G.pack_cards and booster_obj and SMODS.card_select_area(card, booster_obj) and card:selectable_from_pack(booster_obj) then\n    if (card.area == G.pack_cards and G.pack_cards) then\n        local select_button_text = SMODS.get_select_text(card, booster_obj) or localize('b_select')\n        return {n=G.UIT.ROOT, config = {padding = 0, colour = G.C.CLEAR}, nodes={\n                {n=G.UIT.R, config={ref_table = card, r = 0.08, padding = 0.1, align = \"bm\", minw = 0.5*card.T.w - 0.15, maxw = 0.9*card.T.w - 0.15, minh = 0.3*card.T.h, hover = true, shadow = true, colour = G.C.UI.BACKGROUND_INACTIVE, one_press = true, button = 'use_card', func = 'can_select_from_booster'}, nodes={\n                {n=G.UIT.T, config={text = select_button_text, colour = G.C.UI.TEXT_LIGHT, scale = 0.45, shadow = true}}\n                }},\n            }}\n    end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if card.ability.consumeable then\n      if nc then\n",["position"]="at",["payload"]="if select_to then\n    card:add_to_deck()\n    G[select_to]:emplace(card)\n    if card.config.center.on_select and type(card.config.center.on_select) == 'function' then\n        card.config.center:on_select(card)\n    end\n    play_sound('card1', 0.8, 0.6)\n    play_sound('generic1')\n    dont_dissolve = true\n    delay_fac = 0.2\nelseif card.ability.consumeable then\n      if nc then\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="for i = 1, #G.GAME.tags do\n    if G.GAME.tags[i]:apply_to_run({type = 'new_blind_choice'}) then break end\nend\n\nG.E_MANAGER:add_event(Event({trigger = 'after',delay = 0.2*delayfac,\n          func = function()\n            save_run()\n            return true\n      end}))\n",["position"]="before",["payload"]="booster_obj = nil\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="G.FUNCS.end_consumeable(e)\n",["position"]="before",["payload"]="booster_obj = nil\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if e.config.ref_table.ability.set ~= 'Joker' or (e.config.ref_table.edition and e.config.ref_table.edition.negative) or #G.jokers.cards < G.jokers.config.card_limit then",["position"]="at",["payload"]="local card = e.config.ref_table\nlocal card_limit = card.ability.card_limit - card.ability.extra_slots_used\nif card.ability.set ~= 'Joker' or #G.jokers.cards < G.jokers.config.card_limit + card_limit then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.shop_voucher then G.GAME.current_round.voucher = nil end",["position"]="after",["payload"]="G.STATE = G.STATES.SMODS_REDEEM_VOUCHER",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if area == G.consumeables then\n",["position"]="at",["payload"]="if area ~= G.pack_cards then\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.O, config={draw_layer = 1, object = DynaText({scale = args.scale, string = args.text, maxw = args.maxw, colours = {args.colour},float = true, shadow = true, silent = not args.noisy, args.scale, pop_in = 0, pop_in_rate = 6, rotate = args.rotate or nil})}},\n",["position"]="before",["payload"]="type(args.text) == \"table\" and args.text.n and args.text or\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="args.text = args.AT.UIRoot.children[1].config.object\nargs.text:pulse(0.5)\n",["position"]="at",["payload"]="if type(args.text) == 'string' then\n    args.text = args.AT.UIRoot.children[1].config.object\n    args.text:pulse(0.5)\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="args.text:pop_out(3)\n",["position"]="at",["payload"]="if Object.is(args.text, DynaText) then\n    args.text:pop_out(3)\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="local saveTable = args.savetext or nil\n",["position"]="after",["payload"]="SMODS.cards_to_draw = nil\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="self.config = config or {}\n",["position"]="at",["payload"]="self.config = setmetatable({card_limits = {card_limit}}, {\n    __index = function(t, key)\n        if key == \"card_limit\" then\n            return (t.card_limits.total_slots or 0) - (t.card_limits.extra_slots_used or 0)\n        end\n    end,\n    __newindex = function(t, key, value)\n        if key == 'card_limit' then\n            if not t.card_limits.base then rawset(t.card_limits, 'base', value) end\n            if not t.card_limits.total_slots then rawset(t.card_limits, 'total_slots', value) end\n            rawset(t.card_limits, 'mod', value - t.card_limits.base - (t.card_limits.extra_slots or 0) + (t.card_limits.extra_slots_used or 0))\n        else\n            rawset(t, key, value)\n        end\n    end\n})\n\nSMODS.merge_defaults(self.config, config)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="self.config = cardAreaTable.config\n",["position"]="at",["payload"]="self.config = setmetatable(cardAreaTable.config, {\n    __index = function(t, key)\n        if key == \"card_limit\" then\n            return (t.card_limits.total_slots or 0) - (t.card_limits.extra_slots_used or 0)\n        end\n    end,\n    __newindex = function(t, key, value)\n        if key == 'card_limit' then\n            if not t.card_limits.base then rawset(t.card_limits, 'base', value) end\n            rawset(t.card_limits, 'mod', value - t.card_limits.base - (t.card_limits.extra_slots or 0) + (t.card_limits.extra_slots_used or 0))\n        else\n            rawset(t, key, value)\n        end\n    end\n})\n\n-- CRIMSON BEAN EXPLOIT REIMPLEMNTATION\nif self.config.type == 'hand' and cardAreaTable.config.card_limits.total_slots ~= cardAreaTable.config.card_limits.base + cardAreaTable.config.card_limits.mod + cardAreaTable.config.card_limits.extra_slots then\n    self.config.card_limits.base = cardAreaTable.config.card_limits.total_slots - cardAreaTable.config.card_limits.extra_slots\nend\n-- CRIMSON BEAN EXPLOIT REIMPLEMNTATION\n\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="function CardArea:change_size(delta)\n",["position"]="after",["payload"]="    -- SMODS BYPASS ORIGINAL FUNCTION\n    if true then\n        self.config.card_limits.mod = (self.config.card_limits.mod or 0) + delta\n        return\n    end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="if self == G.deck and self.config.card_limit > #G.playing_cards then self.config.card_limit = #G.playing_cards end\n",["position"]="at",["payload"]="if self == G.deck and self.config.card_limit ~= #G.playing_cards then\n    self.config.card_limit = #G.playing_cards\n    self.config.card_limits.total_slots = #G.playing_cards\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.edition and self.edition.negative then \n            if from_debuff then \n                self.ability.queue_negative_removal = nil\n            else\n                if self.ability.consumeable then\n                    G.consumeables.config.card_limit = G.consumeables.config.card_limit + 1\n                else\n                    G.jokers.config.card_limit = G.jokers.config.card_limit + 1\n                end\n            end\n        end\n",["position"]="at",["payload"]="-- removed by SMODS\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.edition and self.edition.negative and G.jokers then\n            if from_debuff then\n                self.ability.queue_negative_removal = true \n            else\n                if self.ability.consumeable then\n                    G.consumeables.config.card_limit = G.consumeables.config.card_limit - 1\n                else\n                    G.jokers.config.card_limit = G.jokers.config.card_limit - 1\n                end \n            end\n        end\n",["position"]="at",["payload"]="-- removed by SMODS\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="self.config.temp_limit = math.max(#self.cards, self.config.card_limit)\nself.config.card_count = #self.cards\n",["position"]="at",["payload"]="self:handle_card_limit()\nself.config.temp_limit = math.max(#self.cards, self.config.card_limit or 0)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="{n=G.UIT.T, config={ref_table = self.config, ref_value = 'card_limit', scale = 0.3, colour = G.C.WHITE}},\n",["position"]="at",["payload"]="{n=G.UIT.T, config={ref_table = self.config.card_limits, ref_value = 'total_slots', scale = 0.3, colour = G.C.WHITE}},\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="{card_limit = self.GAME.starting_params.consumable_slots, type = 'joker', highlight_limit = 1})\n",["position"]="at",["payload"]="{card_limit = self.GAME.starting_params.consumable_slots, type = 'joker', highlight_limit = 1, negative_info = 'consumable'})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="{card_limit = self.GAME.starting_params.joker_slots, type = 'joker', highlight_limit = 1})\n",["position"]="at",["payload"]="{card_limit = self.GAME.starting_params.joker_slots, type = 'joker', highlight_limit = 1, negative_info = 'joker'})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="{card_limit = self.GAME.starting_params.hand_size, type = 'hand'})\n",["position"]="at",["payload"]="{card_limit = self.GAME.starting_params.hand_size, type = 'hand', negative_info = 'playing_card'})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{card_limit = G.GAME.shop.joker_max, type = 'shop', highlight_limit = 1})\n",["position"]="at",["payload"]="{card_limit = G.GAME.shop.joker_max, type = 'shop', highlight_limit = 1, negative_info = true})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="{card_limit = 5, type = 'play'})\n",["position"]="at",["payload"]="{card_limit = 5, type = 'play', negative_info = 'playing_card'})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="for _, v in ipairs(info_queue) do\n",["position"]="before",["payload"]="if not hide_desc and card and card.ability and (card.ability.extra_slots_used or 0) ~= 0 then\n    local str = 'generic_extra_slots'\n    if card.ability.set == 'Default' or card.ability.set == 'Enhanced' then str = str .. '_pc' end\n    info_queue[#info_queue + 1] = {set = 'Other', key = str, vars = {card.ability.extra_slots_used + 1}}\nend\nif not hide_desc and card and card.ability and (card.ability.card_limit or 0) ~= 0 then\n    if not (card.edition and card.edition.card_limit == card.ability.card_limit) then\n        local amount = card.ability.card_limit - (card.edition and card.edition.card_limit or 0)\n        local str = 'generic_card_limit'\n        if card.ability.set == 'Default' or card.ability.set == 'Enhanced' then str = str .. '_pc' end\n        info_queue[#info_queue + 1] = {set = 'Other', key = amount == 1 and str or str..'_plural', vars = {localize({type='variable', key= amount > 0 and 'a_chips' or 'a_chips_minus', vars ={math.abs(amount)}})}}\n    end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="local hand_space = e or*",["position"]="at",["payload"]="local hand_space = e\nlocal cards_to_draw = {}\nlocal space_taken = 0\nlocal limit = (G.hand.config.card_limit - #G.hand.cards - (SMODS.cards_to_draw or 0))\nlocal flags = SMODS.calculate_context({drawing_cards = true, amount = limit})\nlimit = flags.cards_to_draw or flags.modify or limit\nlocal unfixed = not G.hand.config.fixed_limit\nlocal n = 0\nwhile n < #G.deck.cards and limit > 0 do\n    local card = G.deck.cards[#G.deck.cards-n]\n    local mod = unfixed and (card.ability.card_limit - card.ability.extra_slots_used) or 0\n    if limit - 1 + mod < 0 then\n    else    \n        limit = limit - 1 + mod\n        table.insert(cards_to_draw, card)\n        space_taken = space_taken + (1 - mod)\n    end\n    n = n + 1\nend\nhand_space = #cards_to_draw\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="hand_space = math.min(#G.deck.cards, 3)\n",["position"]="before",["payload"]="G.hand.config.card_limits.blind_restriction = hand_space - math.min(#G.deck.cards, 3)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if G.GAME.blind.name == 'The Serpent' and\n",["position"]="after",["payload"]="    G.STATE == G.STATES.DRAW_TO_HAND and\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if args.type == 'min_hand_size' and G.hand and G.hand.config.card_limit <= card.unlock_condition.extra then",["position"]="at",["payload"]="if args.type == 'min_hand_size' and G.hand and G.hand.config.card_limits.total_slots <= card.unlock_condition.extra then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="card_w = joker_size*G.CARD_W, type = 'title_2', highlight_limit = 0})\n",["position"]="before",["payload"]="negative_info = 'joker',\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="card_w = joker_size*G.CARD_W, type = 'title_2', spread = true, highlight_limit = 0})\n",["position"]="before",["payload"]="negative_info = 'consumable',\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{card_limit = #SUITS[suit_map[j]], type = 'title_2', view_deck = true, highlight_limit = 0, card_w = G.CARD_W*0.5, draw_layers = {'card'}})",["position"]="at",["payload"]="{card_limit = #SUITS[suit_map[j]], type = 'title_2', view_deck = true, highlight_limit = 0, card_w = G.CARD_W*0.5, draw_layers = {'card'}, negative_info = 'playing_card'})",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="if #self.cards > self.config.card_limit then\n    if self == G.deck then\n        self.config.card_limit = #self.cards\n    end\nend\n",["position"]="at",["payload"]="if #self.cards > self.config.card_limit then\n    if self == G.deck and G.GAME.blind then\n        self.config.card_limit = #self.cards\n    end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="{n=G.UIT.R, config={minw = self.T.w,minh = self.T.h,align = \"cm\", padding = 0.1, mid = true, r = 0.1, colour = self ~= G.shop_vouchers and {0,0,0,0.1} or nil, ref_table = self}, nodes={",["position"]="at",["payload"]="{n=G.UIT.R, config={minw = self.T.w,minh = self.T.h,align = \"cm\", padding = 0.1, mid = true, r = 0.1, colour = self.config.bg_colour or self ~= G.shop_vouchers and {0,0,0,0.1} or nil, ref_table = self}, nodes={\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="local card_count = self ~= G.shop_vouchers and {n=G.UIT.R, config={align = self == G.jokers and 'cl' or self == G.hand and 'cm' or 'cr', padding = 0.03, no_fill = true}, nodes={\n",["position"]="at",["payload"]="local card_count = not self.config.no_card_count and self ~= G.shop_vouchers and {n=G.UIT.R, config={align = self == G.jokers and 'cl' or self == G.hand and 'cm' or 'cr', padding = 0.03, no_fill = true}, nodes={\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="G.playing_cards = {}\n\nset_screen_positions()\n",["position"]="after",["payload"]="-- Add align config to existing areas that should use it\nself.jokers.config.align_buttons = true\nself.consumeables.config.align_buttons = true\n\nfor _, mod in ipairs(SMODS.mod_list) do\n    if mod.can_load and mod.custom_card_areas and type(mod.custom_card_areas) == \"function\" then\n        mod.custom_card_areas(self)\n    end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="((self.area == G.jokers) or (self.area == G.consumeables)) and \"cr\" or\n",["position"]="at",["payload"]="self.area.config.align_buttons and \"cr\" or\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="((self.area == G.jokers) or (self.area == G.consumeables)) and {x=x_off - 0.4,y=0} or\n",["position"]="at",["payload"]="self.area.config.align_buttons and {x=x_off - 0.4,y=0} or\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self.ability.bonus = (self.ability.bonus or 0) + (center.config.bonus or 0)",["position"]="after",["payload"]="for k, v in pairs(center.config) do\n    if k ~= 'bonus' then\n        if type(v) == 'table' then\n            self.ability[k] = copy_table(v)\n        else\n            self.ability[k] = v\n        end\n    end\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self:set_sprites(center)\n",["position"]="at",["payload"]="    SMODS.clean_up_children(self.children)\n    if self.canvas_text then SMODS.clean_up_canvas_text(self) end\n    if self.ability and (center.set == 'Enhanced' or center.set == 'Default') and not self:should_hide_front() then self:set_sprites(nil, self.config.card) end\n    self:set_sprites(center)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:calculate_joker(context)\n    if self.debuff then return nil end\n",["position"]="after",["payload"]="    local obj = self.config.center\n    if self.ability.set ~= \"Enhanced\" and obj.calculate and type(obj.calculate) == 'function' then\n        local o, t = obj:calculate(self, context)\n        if o or t then return o, t end\n    end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if G.STAGE == G.STAGES.RUN then",["position"]="before",["payload"]="local obj = self.config.center\nif obj.update and type(obj.update) == 'function' then\n    obj:update(self, dt)\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="return generate_card_ui(self.config.center, nil, loc_vars, card_type, badges, hide_desc, main_start, main_end)",["position"]="at",["payload"]="return generate_card_ui(self.config.center, nil, loc_vars, card_type, badges, hide_desc, main_start, main_end, self)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="full_UI_table.name = localize{type = 'name', set = _c.set, key = _c.key, nodes = full_UI_table.name}",["position"]="at",["payload"]="if not _c.generate_ui or type(_c.generate_ui) ~= 'function' then\n    full_UI_table.name = localize{type = 'name', set = _c.set, key = _c.key, nodes = full_UI_table.name}\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif specific_vars and specific_vars.debuffed then",["position"]="before",["payload"]="elseif _c.generate_ui and type(_c.generate_ui) == 'function' then\n    local specific_vars = specific_vars or {}\n    -- TODO: refactor the multiple generate_ui cases to work off a base implementation\n    _c:generate_ui(info_queue, card, desc_nodes, specific_vars, full_UI_table)\n    if specific_vars and specific_vars.pinned then info_queue[#info_queue+1] = {key = 'pinned_left', set = 'Other'} end\n    if specific_vars and specific_vars.sticker then info_queue[#info_queue+1] = {key = string.lower(specific_vars.sticker)..'_sticker', set = 'Other'} end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="localize{type = 'unlocks', key = 'joker_locked_legendary', set = 'Other', nodes = desc_nodes, vars = loc_vars}",["position"]="at",["payload"]="localize{type = 'unlocks', key = res.key or 'joker_locked_legendary', set = res.set or 'Other', nodes = desc_nodes, vars = loc_vars, text_colour = res.text_colour, scale = res.scale}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="localize{type = 'unlocks', key = _c.key, set = _c.set, nodes = desc_nodes, vars = loc_vars}",["position"]="at",["payload"]="localize{type = 'unlocks', key = res.key or _c.key, set = res.set or _c.set, nodes = desc_nodes, vars = loc_vars, text_colour = res.text_colour, scale = res.scale}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif desc_nodes ~= full_UI_table.main then",["position"]="at",["payload"]="elseif desc_nodes ~= full_UI_table.main and not desc_nodes.name then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="if AUT.info then\n",["position"]="before",["payload"]="if AUT.card_type ~= 'Locked' and AUT.card_type ~= 'Undiscovered' then\n    SMODS.create_mod_badges(card.config.center, badges)\n    if card.base then\n        SMODS.create_mod_badges(SMODS.Ranks[card.base.value], badges)\n        SMODS.create_mod_badges(SMODS.Suits[card.base.suit], badges)\n    end\n    if card.config and card.config.tag then\n        SMODS.create_mod_badges(SMODS.Tags[card.config.tag.key], badges)\n    end\n    badges.mod_set = nil\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="local total_rate = G.GAME.joker_rate + G.GAME.tarot_rate + G.GAME.planet_rate + G.GAME.playing_card_rate + G.GAME.spectral_rate",["position"]="at",["payload"]="local total_rate = G.GAME.joker_rate + G.GAME.playing_card_rate\nfor _,v in ipairs(SMODS.ConsumableType.obj_buffer) do\n    total_rate = total_rate + G.GAME[v:lower()..'_rate']\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if not forced_key and soulable and (not G.GAME.banned_keys['c_soul']) then",["position"]="after",["payload"]="    local soul_total_rate = 0\n    local non_soul_rate = 1\n    local modded_souls = {}\n    for _, v in ipairs(SMODS.Consumable.legendaries) do\n        if (_type == v.type.key or _type == v.soul_set) and not (G.GAME.used_jokers[v.key] and not SMODS.showman(v.key) and not v.can_repeat_soul) and SMODS.add_to_pool(v) then\n            soul_total_rate = soul_total_rate + v.soul_rate\n            non_soul_rate = non_soul_rate * (1 - v.soul_rate)\n            non_soul_rate = math.max(non_soul_rate, 0)\n            table.insert(modded_souls, v)\n        end\n    end\n    local roll = pseudorandom('soul_smods_'.._type..G.GAME.round_resets.ante)\n    local threshold = 1\n    for _, v in ipairs(modded_souls) do\n        threshold = threshold - v.soul_rate/soul_total_rate * (1-non_soul_rate)\n        if roll > threshold then\n            forced_key = v.key\n            break\n        end\n    end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="{bypass_discovery_center = area==G.shop_jokers or area == G.pack_cards or area == G.shop_vouchers or (G.shop_demo and area==G.shop_demo) or area==G.jokers or area==G.consumeables,",["position"]="at",["payload"]="{bypass_discovery_center = SMODS.bypass_create_card_discovery_center or area==G.shop_jokers or area == G.pack_cards or area == G.shop_vouchers or (G.shop_demo and area==G.shop_demo) or area==G.jokers or area==G.consumeables,",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="bypass_discovery_ui = area==G.shop_jokers or area == G.pack_cards or area==G.shop_vouchers or (G.shop_demo and area==G.shop_demo),",["position"]="at",["payload"]="bypass_discovery_ui = SMODS.bypass_create_card_discovery_center or area==G.shop_jokers or area == G.pack_cards or area==G.shop_vouchers or (G.shop_demo and area==G.shop_demo),",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="discover = area==G.jokers or area==G.consumeables, ",["position"]="at",["payload"]="discover = SMODS.bypass_create_card_discover or area==G.jokers or area==G.consumeables, ",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="not (G.GAME.used_jokers['c_soul'] and not next(find_joker(\"Showman\")))  then",["position"]="at",["payload"]="not (G.GAME.used_jokers['c_soul'] and not SMODS.showman('c_soul')) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="not (G.GAME.used_jokers['c_black_hole'] and not next(find_joker(\"Showman\")))  then",["position"]="at",["payload"]="not (G.GAME.used_jokers['c_black_hole'] and not SMODS.showman('c_black_hole')) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="local new_card = new_card or Card(other.T.x, other.T.y, G.CARD_W*(card_scale or 1), G.CARD_H*(card_scale or 1), G.P_CARDS.empty, G.P_CENTERS.c_base, {playing_card = playing_card})\n",["position"]="at",["payload"]="local new_card = new_card or Card(other.T.x, other.T.y, G.CARD_W*(card_scale or 1), G.CARD_H*(card_scale or 1), G.P_CARDS.empty, G.P_CENTERS.c_base, {playing_card = playing_card, bypass_back = G.GAME.selected_back.pos})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if G.booster_pack and not G.booster_pack.alignment.offset.py and (card.ability.consumeable or not (G.GAME.pack_choices and G.GAME.pack_choices > 1)) then\n",["position"]="at",["payload"]="local nc\nlocal select_to = card.area == G.pack_cards and G.pack_cards and booster_obj and SMODS.card_select_area(card, booster_obj) and card:selectable_from_pack(booster_obj)\nif card.ability.consumeable and not select_to then\n    local obj = card.config.center\n    if obj.keep_on_use and type(obj.keep_on_use) == 'function' then\n        nc = obj:keep_on_use(card)\n    end\nend\nif G.booster_pack and not G.booster_pack.alignment.offset.py and ((not select_to and card.ability.consumeable) or not (G.GAME.pack_choices and G.GAME.pack_choices > 1)) then\n\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if card.area then card.area:remove_card(card) end",["position"]="at",["payload"]="if not card.from_area then card.from_area = card.area end\nif card.area and (not nc or card.area == G.pack_cards) then card.area:remove_card(card) end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if area and area.cards[1] then\n",["position"]="before",["payload"]="if nc and not area then G.consumeables:emplace(card) end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="else draw_card(G.hand, G.play, 1, 'up', true, card, nil, mute) end",["position"]="at",["payload"]="elseif not nc then draw_card(G.hand, G.play, 1, 'up', true, card, nil, mute) end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:check_use()",["position"]="after",["payload"]="    if self.area == G.pack_cards and G.pack_cards and booster_obj and SMODS.card_select_area(self, booster_obj) and self:selectable_from_pack(booster_obj) then return end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.config.center.name == \"Half Joker\" then",["position"]="at",["payload"]="local obj = self.config.center\nif obj.load and type(obj.load) == 'function' then\n    obj:load(self, cardTable, other_card)\nelseif self.config.center.name == \"Half Joker\" then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:calculate_dollar_bonus()\n    if self.debuff then return end",["position"]="after",["payload"]="    local obj = self.config.center\n    if obj.calc_dollar_bonus and type(obj.calc_dollar_bonus) == 'function' then\n        return obj:calc_dollar_bonus(self)\n    end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:generate_UIBox_ability_table()",["position"]="at",["payload"]="function Card:generate_UIBox_ability_table(vars_only)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="local badges = {}",["position"]="before",["payload"]="if vars_only then return loc_vars, main_start, main_end end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif _c.set == 'Joker' then",["position"]="after",["payload"]="    if not card then\n        local ability = copy_table(_c.config)\n        ability.set = 'Joker'\n        ability.name = _c.name\n        -- temporary stopgap. fake cards should be implemented better\n        ability.x_mult = _c['config'].Xmult or _c['config'].x_mult\n        if ability.name == 'To Do List' then\n            ability.to_do_poker_hand = \"High Card\" -- fallback\n        end\n        local ret = {Card.generate_UIBox_ability_table({ ability = ability, config = { center = _c }, bypass_lock = true}, true)}\n        specific_vars = ret[1]\n        if ret[2] then desc_nodes[#desc_nodes+1] = ret[2] end\n        main_end = ret[3]\n    end\n    ",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="elseif card.config.center.set == 'Spectral' then  G.GAME.consumeable_usage_total.spectral = G.GAME.consumeable_usage_total.spectral + 1\n",["position"]="after",["payload"]="else \n    G.GAME.consumeable_usage_total[card.config.center.set:lower()] = G.GAME.consumeable_usage_total[card.config.center.set:lower()] or 0\n    G.GAME.consumeable_usage_total[card.config.center.set:lower()] = G.GAME.consumeable_usage_total[card.config.center.set:lower()] + 1\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="remove_all(self.children)\n",["position"]="before",["payload"]="if self.canvas_text then SMODS.clean_up_canvas_text(self) end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="    if self.area and self.ability.couponed and (self.area == G.shop_jokers or self.area == G.shop_booster) then self.cost = 0 end\n    self.sell_cost_label = self.facing == 'back' and '?' or self.sell_cost\nend\n",["position"]="at",["payload"]="end\n",["indent"]=false},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:set_cost()\n    self.extra_cost = 0 + G.GAME.inflation\n",["position"]="after",["payload"]="\n    self:set_cost_value()\n    self:set_sell_value()\n\n    if self.area and self.ability.couponed and (self.area == G.shop_jokers or self.area == G.shop_booster) then self.cost = 0 end\n    self.sell_cost_label = self.facing == 'back' and '?' or self.sell_cost\nend\n\nfunction Card:set_cost_value()\n",["indent"]=false},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="    if self.ability.rental then self.cost = 1 end\n",["position"]="after",["payload"]="end\n\nfunction Card:set_sell_value()\n",["indent"]=false},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if specific_vars.nominal_chips then\n    localize{type = 'other', key = 'card_chips', nodes = desc_nodes, vars = {specific_vars.nominal_chips}}\nend\nif specific_vars.bonus_chips then\n    localize{type = 'other', key = 'card_extra_chips', nodes = desc_nodes, vars = {specific_vars.bonus_chips}}\nend\n",["position"]="at",["payload"]="if card.area == G.cdds_cards and card.generate_ds_card_ui and type(card.generate_ds_card_ui) == 'function' and card.deckskin and card.palette then\n    card.generate_ds_card_ui(card, card.deckskin, card.palette, info_queue, desc_nodes, specific_vars, full_UI_table)\nelse\n    if specific_vars.nominal_chips then\n        localize{type = 'other', key = 'card_chips', nodes = desc_nodes, vars = {specific_vars.nominal_chips}}\n    end\n    if specific_vars.bonus_chips then\n        localize{type = 'other', key = 'card_extra_chips', nodes = desc_nodes, vars = {specific_vars.bonus_chips}}\n    end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="label = \"Production\",\nchosen = true,\n",["position"]="at",["payload"]="label = \"Production\",\nchosen = not SMODS.init_collab_credits,\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="label = \"Collabs\",",["position"]="after",["payload"]="chosen = SMODS.init_collab_credits,",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if num_dollars > 60 then",["position"]="at",["payload"]="if num_dollars > 60 or num_dollars < -60 then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="local dollar_string = localize('$')..num_dollars",["position"]="at",["payload"]="if num_dollars < 0 then --if negative\n    G.E_MANAGER:add_event(Event({\n        trigger = 'before',delay = 0.38,\n        func = function()\n            G.round_eval:add_child(\n                {n=G.UIT.R, config={align = \"cm\", id = 'dollar_row_'..(dollar_row+1)..'_'..config.name}, nodes={\n                    {n=G.UIT.O, config={object = DynaText({string = {localize('$')..format_ui_value(num_dollars)}, colours = {G.C.RED}, shadow = true, pop_in = 0, scale = 0.65, float = true})}}\n                }},\n                G.round_eval:get_UIE_by_ID('dollar_'..config.name))\n            play_sound('coin3', 0.9+0.2*math.random(), 0.7)\n            play_sound('coin6', 1.3, 0.8)\n            return true\n        end\n    }))\nelse --if positive\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="for i = 1, num_dollars or 1 do",["position"]="at",["payload"]="local dollars_to_loop\nif num_dollars < 0 then dollars_to_loop = (num_dollars*-1)+1 else dollars_to_loop = num_dollars end\nfor i = 1, dollars_to_loop do",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="local r = {n=G.UIT.T, config={text = localize('$'), colour = G.C.MONEY, scale = ((num_dollars > 20 and 0.28) or (num_dollars > 9 and 0.43) or 0.58), shadow = true, hover = true, can_collide = false, juice = true}}",["position"]="at",["payload"]="local r\nif i == 1 and num_dollars < 0 then\n    r = {n=G.UIT.T, config={text = '-', colour = G.C.RED, scale = ((num_dollars < -20 and 0.28) or (num_dollars < -9 and 0.43) or 0.58), shadow = true, hover = true, can_collide = false, juice = true}}\n    play_sound('coin3', 0.9+0.2*math.random(), 0.7 - (num_dollars < -20 and 0.2 or 0))\nelse\n    if num_dollars < 0 then r = {n=G.UIT.T, config={text = localize('$'), colour = G.C.RED, scale = ((num_dollars > 20 and 0.28) or (num_dollars > 9 and 0.43) or 0.58), shadow = true, hover = true, can_collide = false, juice = true}}\n    else r = {n=G.UIT.T, config={text = localize('$'), colour = G.C.MONEY, scale = ((num_dollars > 20 and 0.28) or (num_dollars > 9 and 0.43) or 0.58), shadow = true, hover = true, can_collide = false, juice = true}} end\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"engine/text.lua"},["pattern"]="        if self.strings[k].H > self.config.H then self.config.H = self.strings[k].H; self.strings[k].H_offset = 0 end",["position"]="after",["payload"]="if first_pass and type(mem_v) == \"table\" and mem_v.condition then\n\009self.strings[k].condition = mem_v.condition\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"engine/text.lua"},["pattern"]="    for k, v in ipairs(self.config.string) do",["position"]="after",["payload"]="local mem_v = v\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"engine/text.lua"},["pattern"]="self.focused_string = (self.config.random_element and math.random(1, #self.strings)) or self.focused_string ==  #self.strings and 1 or self.focused_string+1",["position"]="at",["payload"]="while true do\n\009self.focused_string = (self.config.random_element and math.random(1, #self.strings)) or self.focused_string ==  #self.strings and 1 or self.focused_string+1\n\009if type(self.strings[self.focused_string]) ~= 'table' or not self.strings[self.focused_string].condition then break\n\009elseif self.strings[self.focused_string].condition() then break end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"engine/text.lua"},["pattern"]="for k, v in ipairs(self.strings) do",["position"]="before",["payload"]="if first_pass and type(self.strings[self.focused_string]) == 'table' and \ntype(self.strings[self.focused_string].condition) == 'function' and not self.strings[self.focused_string].condition() then\n\009while true do\n\009\009self.focused_string = (self.config.random_element and math.random(1, #self.strings)) or self.focused_string ==  #self.strings and 1 or self.focused_string+1\n\009\009if type(self.strings[self.focused_string]) ~= 'table' or not self.strings[self.focused_string].condition then break\n\009\009elseif self.strings[self.focused_string].condition() then break end\n\009end\nend\n\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="table.sort(self.P_CENTER_POOLS[\"Enhanced\"], function (a, b) return a.order < b.order end)",["position"]="after",["payload"]="table.sort(self.P_CENTER_POOLS[\"Edition\"], function (a, b) return a.order < b.order end)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="localize{type = 'descriptions', key = _c.key, set = _c.set, nodes = desc_nodes, vars = loc_vars}",["position"]="at",["payload"]="localize{type = 'descriptions', key = _c.key, set = _c.set, nodes = desc_nodes, vars = _c.vars or loc_vars}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="return G.BADGE_COL[key] or {1, 0, 0, 1}",["position"]="before",["payload"]="if G.BADGE_COL[key] then return G.BADGE_COL[key] end\nfor _, v in ipairs(G.P_CENTER_POOLS.Edition) do\n\009G.BADGE_COL[v.key:sub(3)] = v.badge_colour\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"engine/sprite.lua"},["pattern"]="if _send then G.SHADERS[_shader or 'dissolve']:send(_shader,_send) end",["position"]="at",["payload"]="if _send then\n    G.SHADERS[_shader or 'dissolve']:send((SMODS.Shaders[_shader or 'dissolve'] and SMODS.Shaders[_shader or 'dissolve'].original_key) or _shader,_send)\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="added_to_deck = self.added_to_deck,",["position"]="after",["payload"]="joker_added_to_deck_but_debuffed = self.joker_added_to_deck_but_debuffed,",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="    not (card.ability.consumeable and #G.consumeables.cards < G.consumeables.config.card_limit + ((card.edition and card.edition.negative) and 1 or 0)) then",["position"]="at",["payload"]="    not (card.ability.consumeable and #G.consumeables.cards + (1 + card.ability.extra_slots_used) <= G.consumeables.config.card_limit + card.ability.card_limit) then\n",["indent"]=true,["times"]=1},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="not (card.ability.set == 'Joker' and #G.jokers.cards < G.jokers.config.card_limit + ((card.edition and card.edition.negative) and 1 or 0)) and",["position"]="at",["payload"]="    not (card.ability.set == 'Joker' and #G.jokers.cards + (1 + card.ability.extra_slots_used) <= G.jokers.config.card_limit + card.ability.card_limit) and\n",["indent"]=true,["times"]=1},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.edition.type == 'negative' and self.ability.consumeable then\n    badges[#badges + 1] = 'negative_consumable'\n",["position"]="at",["payload"]="if self.edition.card_limit then\n    badges[#badges + 1] = SMODS.Edition.get_card_limit_key(self)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"engine/sprite.lua"},["pattern"]="love.graphics.setShader( G.SHADERS[_shader or 'dissolve'],  G.SHADERS[_shader or 'dissolve'])",["position"]="before",["payload"]="local p_shader = SMODS.Shader.obj_table[_shader or 'dissolve']\nif p_shader and type(p_shader.send_vars) == \"function\" then\n    local sh = G.SHADERS[_shader or 'dissolve']\n    local parent_card = self.role.major and self.role.major:is(Card) and self.role.major\n    local send_vars = p_shader.send_vars(self, parent_card)\n\n    if type(send_vars) == \"table\" then\n        for key, value in pairs(send_vars) do\n            sh:send(key, value)\n        end\n    end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="if v == 'negative_consumable' then v = 'negative' end",["position"]="at",["payload"]="if v:sub(v:len()-14) == '_SMODS_INTERNAL' then\n    if v:sub(1, 9) == 'negative_' then v = 'negative' else v = v:sub(1, v:find('_', v:find('_')+1)-1) end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.effect == 'Stone Card' and not self.vampired then",["position"]="at",["payload"]="if SMODS.has_no_rank(self) and not self.vampired then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if temp_ID >= G.hand.cards[i].base.id and G.hand.cards[i].ability.effect ~= 'Stone Card' then temp_Mult = G.hand.cards[i].base.nominal; temp_ID = G.hand.cards[i].base.id; raised_card = G.hand.cards[i] end",["position"]="at",["payload"]="if temp_ID >= G.hand.cards[i].base.id and not SMODS.has_no_rank(G.hand.cards[i]) then \n    temp_Mult = G.hand.cards[i].base.nominal\n    temp_ID = G.hand.cards[i].base.id\n    raised_card = G.hand.cards[i]\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if context.scoring_hand[i].ability.name ~= 'Wild Card' then",["position"]="at",["payload"]="if not SMODS.has_any_suit(context.scoring_hand[i]) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if context.scoring_hand[i].ability.name == 'Wild Card' then",["position"]="at",["payload"]="if SMODS.has_any_suit(context.scoring_hand[i]) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.name == \"Wild Card\" then",["position"]="at",["payload"]="if SMODS.has_any_suit(self) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.name == \"Wild Card\" and not self.debuff then",["position"]="at",["payload"]="if SMODS.has_any_suit(self) and self:can_calculate() then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if v.ability.name ~= 'Stone Card' and v.base.suit == 'Hearts' then",["position"]="at",["payload"]="if not SMODS.has_no_suit(v) and v.base.suit == 'Hearts' then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="valid_idol_cards[#valid_idol_cards+1] = v",["position"]="at",["payload"]="if not SMODS.has_no_suit(v) and not SMODS.has_no_rank(v) then\n    valid_idol_cards[#valid_idol_cards+1] = v\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="valid_mail_cards[#valid_mail_cards+1] = v",["position"]="at",["payload"]="if not SMODS.has_no_rank(v) then\n    valid_mail_cards[#valid_mail_cards+1] = v\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="valid_castle_cards[#valid_castle_cards+1] = v",["position"]="at",["payload"]="if not SMODS.has_no_suit(v) then\n    valid_castle_cards[#valid_castle_cards+1] = v\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if scoring_hand[i].ability.effect ~= 'Stone Card' then",["position"]="at",["payload"]="if not SMODS.has_no_rank(scoring_hand[i]) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.GAME.cards_played[scoring_hand[i].base.value].suits[scoring_hand[i].base.suit] = true",["position"]="at",["payload"]="if not SMODS.has_no_suit(scoring_hand[i]) then\n    G.GAME.cards_played[scoring_hand[i].base.value].suits[scoring_hand[i].base.suit] = true\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if (_c.name == 'Stone Card') then full_UI_table.name = true end",["position"]="at",["payload"]="if _c.name == 'Stone Card' or _c.replace_base_card then full_UI_table.name = true",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if (specific_vars.playing_card and (_c.name ~= 'Stone Card')) then",["position"]="at",["payload"]="elseif specific_vars.playing_card then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="local effects = {G.hand.cards[i]:get_end_of_round_effect()}",["position"]="at",["payload"]="local effects = {[1] = {playing_card = G.hand.cards[i]:get_end_of_round_effect()}}\nlocal extra_enhancements = SMODS.get_enhancements(G.hand.cards[i], true)\nlocal old_ability = copy_table(G.hand.cards[i].ability)\nlocal old_center = G.hand.cards[i].config.center\nlocal old_center_key = G.hand.cards[i].config.center_key\nfor k, _ in pairs(extra_enhancements) do\n    if G.P_CENTERS[k] then\n        G.hand.cards[i]:set_ability(G.P_CENTERS[k])\n        G.hand.cards[i].ability.extra_enhancement = k\n        effects[#effects+1] = {[1] = {playing_card = G.hand.cards[i]:get_end_of_round_effect()}}\n    end\nend\nG.hand.cards[i].ability = old_ability\nG.hand.cards[i].config.center = old_center\nG.hand.cards[i].config.center_key = old_center_key\nG.hand.cards[i]:set_sprites(old_center)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.seal == 'Blue' and #G.consumeables.cards + G.GAME.consumeable_buffer < G.consumeables.config.card_limit then",["position"]="before",["payload"]="if self.extra_enhancement then return ret end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if vv.config.center.key == v.enhancement_gate then",["position"]="at",["payload"]="if SMODS.has_enhancement(vv, v.enhancement_gate) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if card.ability.name == 'Glass Card' then",["position"]="at",["payload"]="if SMODS.shatters(card) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if G.hand.highlighted[i].ability.name == 'Glass Card' then",["position"]="at",["payload"]="if SMODS.shatters(G.hand.highlighted[i]) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if scoring_hand[i].ability.name == 'Glass Card' then",["position"]="at",["payload"]="if SMODS.shatters(scoring_hand[i]) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if cards_destroyed[i].ability.name == 'Glass Card' then",["position"]="at",["payload"]="if cards_destroyed[i].shattered then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.seal == 'Blue' and #G.consumeables.cards + G.GAME.consumeable_buffer < G.consumeables.config.card_limit then",["position"]="at",["payload"]="if self.seal == 'Blue' and #G.consumeables.cards + G.GAME.consumeable_buffer < G.consumeables.config.card_limit and not self.ability.extra_enhancement then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="modulate_sound(dt)",["position"]="after",["payload"]="SMODS.enh_cache:clear()",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:set_ability(center, initial, delay_sprites)",["position"]="after",["payload"]="    SMODS.enh_cache:write(self, nil)\n\n    if self.ability and not initial then\n        self.ability.card_limit = self.ability.card_limit - (self.config.center.config.card_limit or 0)\n        self.ability.extra_slots_used = self.ability.extra_slots_used - (self.config.center.config.extra_slots_used or 0)\n    end\n  \n    if self.ability and not initial then\n        self.front_hidden = self:should_hide_front()\n    end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self:set_sprites(center)",["position"]="after",["payload"]="if self.ability and not initial then\n  self.front_hidden = self:should_hide_front()\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if not G.OVERLAY_MENU then ",["position"]="before",["payload"]="if self.ability and not initial and not delay_sprites then\n  self.front_hidden = self:should_hide_front()\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:set_base(card, initial)",["position"]="after",["payload"]="SMODS.enh_cache:write(self, nil)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:set_seal(_seal, silent, immediate)",["position"]="after",["payload"]="    SMODS.enh_cache:write(self, nil)\n    if self.seal then\n        self.ability.card_limit = self.ability.card_limit - (self.ability.seal.card_limit or 0)\n        self.ability.extra_slots_used = self.ability.extra_slots_used - (self.ability.seal.extra_slots_used or 0)\n    end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if not initial then G.GAME.blind:debuff_card(self) end",["position"]="at",["payload"]="if not initial and G.GAME.blind then G.GAME.blind:debuff_card(self) end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"event.lua"},["pattern"]="self.queue_last_processed = G.TIMERS.REAL\n",["position"]="after",["payload"]="self.append_count = 0\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"engine/event.lua"},["pattern"]="if (not blocked or not v[i].blockable) then v[i]:handle(results) end\n",["position"]="before",["payload"]="self.append_count = 0\nself.append_queue = k\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"engine/event.lua"},["pattern"]="if (not blocked or not v[i].blockable) then v[i]:handle(results) end\n",["position"]="after",["payload"]="i = i + self.append_count\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"engine/event.lua"},["pattern"]="if front then\n",["position"]="after",["payload"]="if self.append_queue == queue then\n    self.append_count = self.append_count + 1\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="G.FUNCS.start_run = function(e, args)",["position"]="after",["payload"]="args = args or {}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if G.SAVED_GAME ~= nil then G.SAVED_GAME = STR_UNPACK(G.SAVED_GAME) end",["position"]="after",["payload"]="if G.SAVED_GAME == nil then\n    e.config.colour = G.C.UI.BACKGROUND_INACTIVE\n    e.config.button = nil\n    return _can_continue\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="function save_run()",["position"]="after",["payload"]="    if G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.PLANET_PACK or G.STATE == G.STATES.SPECTRAL_PACK\n        or G.STATE == G.STATES.BUFFOON_PACK or G.STATE == G.STATES.STANDARD_PACK or G.STATE == G.STATES.SMODS_BOOSTER_OPENED then return end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="bypass_lock = self.bypass_lock,",["position"]="after",["payload"]="unique_val = self.unique_val,\nunique_val__saved_ID = self.unique_val__saved_ID or self.ID,\nignore_base_shader = self.ignore_base_shader,\nignore_shadow = self.ignore_shadow,",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self.bypass_lock = cardTable.bypass_lock",["position"]="after",["payload"]="self.unique_val = cardTable.unique_val or self.unique_val\nself.unique_val__saved_ID = cardTable.unique_val__saved_ID or self.unique_val__saved_ID\nif cardTable.unique_val__saved_ID and G.ID <= cardTable.unique_val__saved_ID then\n    G.ID = cardTable.unique_val__saved_ID + 1\nend\n\nself.ignore_base_shader = cardTable.ignore_base_shader or {}\nself.ignore_shadow = cardTable.ignore_shadow or {}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="function generate_card_ui(_c, full_UI_table, specific_vars, card_type, badges, hide_desc, main_start, main_end)",["position"]="at",["payload"]="function generate_card_ui(_c, full_UI_table, specific_vars, card_type, badges, hide_desc, main_start, main_end, card)\n    if _c.specific_vars then specific_vars = _c.specific_vars end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if _c.set == 'Other' then",["position"]="before",["payload"]="local cfg = (card and card.ability) or _c['config']",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if _c.name ~= 'Stone Card' and ((specific_vars and specific_vars.bonus_chips) or _c.config.bonus) then",["position"]="at",["payload"]="if _c.name ~= 'Stone Card' and ((specific_vars and specific_vars.bonus_chips) or (cfg.bonus ~= 0 and cfg.bonus)) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self.config.center = center",["position"]="at",["payload"]="local was_added_to_deck = false\nif self.added_to_deck and old_center and not self.debuff then\n    self:remove_from_deck()\n    was_added_to_deck = true\nend\nif type(center) == 'string' then\n    assert(G.P_CENTERS[center], (\"Could not find center \\\"%s\\\"\"):format(center))\n    center = G.P_CENTERS[center]\nend\nself.config.center = center\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if G.consumeables and self.area == G.consumeables then",["position"]="before",["payload"]="if was_added_to_deck and not self.debuff then\n    self:add_to_deck()\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.hand.highlighted[i].ability.played_this_ante = true",["position"]="at",["payload"]="-- removed by SMODS",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self.label = center.label or self.config.card.label or self.ability.set",["position"]="at",["payload"]="self.label = center.label or self.config.card and self.config.card.label or self.ability.set",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="_card:set_debuff(true)",["position"]="at",["payload"]="_card.ability.crimson_heart_chosen = true\nSMODS.recalc_debuff(_card)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"engine/text.lua"},["pattern"]="self.config.H = 0",["position"]="after",["payload"]="self.scale = self.config.scale_function and self.config.scale_function() or self.scale",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="if win_ante and (win_ante >= 8) then",["position"]="at",["payload"]="if win_ante and (win_ante >= 8) or not SMODS.add_to_pool(v) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="local game_over = true",["position"]="before",["payload"]="G.GAME.blind.in_blind = false",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if G.GAME.round_resets.ante == G.GAME.win_ante and G.GAME.blind:get_type() == 'Boss' then",["position"]="at",["payload"]="if not G.GAME.won and G.GAME.round_resets.ante >= G.GAME.win_ante and G.GAME.blind_on_deck == 'Boss' then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="function Blind:load(blindTable)",["position"]="after",["payload"]="    self.in_blind = blindTable.in_blind",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="local blindTable = {",["position"]="after",["payload"]="    in_blind = self.in_blind,",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if card.unlock_condition.tarot_count <= args.tarot_count then",["position"]="at",["payload"]="if #G.P_CENTER_POOLS.Tarot <= args.tarot_count then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if card.unlock_condition.planet_count <= args.planet_count then",["position"]="at",["payload"]="if #G.P_CENTER_POOLS.Planet <= args.planet_count then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"engine/animatedsprite.lua"},["pattern"]="for _, v in pairs(G.ANIMATIONS) do",["position"]="at",["payload"]="for k, v in pairs(G.ANIMATIONS) do",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"engine/animatedsprite.lua"},["pattern"]="for _, v in pairs(G.I.SPRITE) do",["position"]="at",["payload"]="for k, v in pairs(G.I.SPRITE) do",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if v.config.center == G.P_CENTERS.m_steel then self.ability.steel_tally = self.ability.steel_tally+1 end",["position"]="at",["payload"]="if SMODS.has_enhancement(v, 'm_steel') then self.ability.steel_tally = self.ability.steel_tally+1 end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if v.config.center == G.P_CENTERS.m_stone then self.ability.stone_tally = self.ability.stone_tally+1 end",["position"]="at",["payload"]="if SMODS.has_enhancement(v, 'm_stone') then self.ability.stone_tally = self.ability.stone_tally+1 end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="context.other_card.ability.name == 'Gold Card' then",["position"]="at",["payload"]="SMODS.has_enhancement(context.other_card, 'm_gold') then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if args.cards[j].ability.name == 'Gold Card' then",["position"]="at",["payload"]="if SMODS.has_enhancement(args.cards[j], 'm_gold') then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if val.ability.name == 'Glass Card' then shattered_glass = shattered_glass + 1 end",["position"]="at",["payload"]="if SMODS.has_enhancement(val, 'm_glass') then shattered_glass = shattered_glass + 1 end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if v.config.center ~= G.P_CENTERS.c_base then self.ability.driver_tally = self.ability.driver_tally+1 end",["position"]="at",["payload"]="if next(SMODS.get_enhancements(v)) then self.ability.driver_tally = self.ability.driver_tally+1 end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="G.GAME.round_resets.reroll_cost = G.GAME.round_resets.reroll_cost - self.ability.extra",["position"]="at",["payload"]="G.GAME.round_resets.reroll_cost = G.GAME.round_resets.reroll_cost - center_table.extra",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="G.GAME.current_round.reroll_cost = math.max(0, G.GAME.current_round.reroll_cost - self.ability.extra)",["position"]="at",["payload"]="G.GAME.current_round.reroll_cost = math.max(0, G.GAME.current_round.reroll_cost - center_table.extra)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if G.pack_cards and (G.pack_cards.cards[1]) and",["position"]="at",["payload"]="if G.pack_cards and (not (G.GAME.STOP_USE and G.GAME.STOP_USE > 0)) and\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="if key == 'seed' then return math.random() end",["position"]="after",["payload"]="if G.SETTINGS.paused and key ~= 'to_do' then return math.random() end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"main.lua"},["pattern"]="--To control when steam communication happens, make sure to send updates to steam as little as possible",["position"]="after",["payload"]="local cwd = SMODS.NFS.getWorkingDirectory()\nSMODS.NFS.setWorkingDirectory(love.filesystem.getSourceBaseDirectory())\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"main.lua"},["pattern"]="--Set up the render window and the stage for the splash screen, then enter the gameloop with :update",["position"]="before",["payload"]="SMODS.NFS.setWorkingDirectory(cwd)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"main.lua"},["pattern"]="if os == 'OS X' or os == 'Windows' then",["position"]="at",["payload"]="if os == 'OS X' or os == 'Windows' or os == 'Linux' then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"main.lua"},["pattern"]="if os == 'OS X' then",["position"]="at",["payload"]="if os == 'OS X' or os == 'Linux' then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"main.lua"},["pattern"]="st = require 'luasteam'",["position"]="at",["payload"]="local success, _st = pcall(require, 'luasteam')\nif success then st = _st else sendWarnMessage(_st, \"LuaSteam\"); st = {} end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="for k, v in pairs(other.ability) do\n    if type(v) == 'table' then \n        new_card.ability[k] = copy_table(v)\n    else\n        new_card.ability[k] = v\n    end\nend\n",["position"]="at",["payload"]="",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="return new_card\n",["position"]="before",["payload"]="for k, v in pairs(other.ability) do\n    if type(v) == 'table' then \n        new_card.ability[k] = copy_table(v)\n    else\n        new_card.ability[k] = v\n    end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="return new_card",["position"]="before",["payload"]="if other.edition and strip_edition then\n    new_card.ability.card_limit = new_card.ability.card_limit - (other.edition.card_limit or 0)\n    new_card.ability.extra_slots_used = new_card.ability.extra_slots_used - (other.edition.extra_slots_used or 0)\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="new_card:set_edition(other.edition or {}, nil, true)",["position"]="after",["payload"]="for k,v in pairs(other.edition or {}) do\n    if type(v) == 'table' then\n        new_card.edition[k] = copy_table(v)\n    else\n        new_card.edition[k] = v\n    end\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if next(find_joker('Smeared Joker')) and (self.base.suit == 'Hearts' or self.base.suit == 'Diamonds') == (suit == 'Hearts' or suit == 'Diamonds') then",["position"]="at",["payload"]="if SMODS.smeared_check(self, suit) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="local suits = {\n    ['Hearts'] = 0,\n    ['Diamonds'] = 0,\n    ['Spades'] = 0,\n    ['Clubs'] = 0\n}\nfor i = 1, #context.scoring_hand do\n    if not SMODS.has_any_suit(context.scoring_hand[i]) then\n        if context.scoring_hand[i]:is_suit('Hearts') then suits[\"Hearts\"] = suits[\"Hearts\"] + 1 end\n        if context.scoring_hand[i]:is_suit('Diamonds') then suits[\"Diamonds\"] = suits[\"Diamonds\"] + 1 end\n        if context.scoring_hand[i]:is_suit('Spades') then suits[\"Spades\"] = suits[\"Spades\"] + 1 end\n        if context.scoring_hand[i]:is_suit('Clubs') then suits[\"Clubs\"] = suits[\"Clubs\"] + 1 end\n    end\nend\nfor i = 1, #context.scoring_hand do\n    if SMODS.has_any_suit(context.scoring_hand[i]) then\n        if context.scoring_hand[i]:is_suit('Clubs') and suits[\"Clubs\"] == 0 then suits[\"Clubs\"] = suits[\"Clubs\"] + 1\n        elseif context.scoring_hand[i]:is_suit('Diamonds') and suits[\"Diamonds\"] == 0  then suits[\"Diamonds\"] = suits[\"Diamonds\"] + 1\n        elseif context.scoring_hand[i]:is_suit('Spades') and suits[\"Spades\"] == 0  then suits[\"Spades\"] = suits[\"Spades\"] + 1\n        elseif context.scoring_hand[i]:is_suit('Hearts') and suits[\"Hearts\"] == 0  then suits[\"Hearts\"] = suits[\"Hearts\"] + 1 end\n    end\nend\nif (suits[\"Hearts\"] > 0 or\nsuits[\"Diamonds\"] > 0 or\nsuits[\"Spades\"] > 0) and\nsuits[\"Clubs\"] > 0 then\n    return {\n        message = localize{type='variable',key='a_xmult',vars={self.ability.extra}},\n        Xmult_mod = self.ability.extra\n    }\nend",["position"]="at",["payload"]="if SMODS.seeing_double_check(context.scoring_hand, 'Clubs') then\n    return {\n        message = localize{type='variable',key='a_xmult',vars={self.ability.extra}},\n        Xmult_mod = self.ability.extra\n    }\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="local card = create_card(card_type,G.consumeables, nil, nil, nil, nil, _planet, 'blusl')",["position"]="before",["payload"]="if _planet == 0 then _planet = nil end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="function Game:delete_run()",["position"]="after",["payload"]="    G.in_delete_run = true\n    booster_obj = nil",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="G.STATE = -1",["position"]="after",["payload"]="G.in_delete_run = false",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.area then self.area:remove_card(self) end",["position"]="after",["payload"]="if G.in_delete_run then goto skip_game_actions_during_remove end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if G.playing_cards then",["position"]="before",["payload"]="::skip_game_actions_during_remove::",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="self:set_ranks()\nif self == G.deck then check_for_unlock({type = 'modify_deck', deck = self}) end",["position"]="at",["payload"]="self:set_ranks()\nif not G.in_delete_run and self == G.deck then check_for_unlock({type = 'modify_deck', deck = self}) end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if v ~= chosen_joker then \n",["position"]="after",["payload"]="v.getting_sliced = true\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="function pseudoshuffle(list, seed)\n",["position"]="after",["payload"]="    if seed and type(seed) == \"string\" then seed = pseudoseed(seed) end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="local _card = Card(G.deck.T.x, G.deck.T.y, G.CARD_W, G.CARD_H, G.P_CARDS[control.s..'_'..control.r], G.P_CENTERS[control.e or 'c_base'], {playing_card = G.playing_card})\nif control.d then _card:set_edition({[control.d] = true}, true, true) end\nif control.g then _card:set_seal(control.g, true, true) end\n",["position"]="after",["payload"]="_card:add_to_deck()\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="local card = Card(_area.T.x, _area.T.y, G.CARD_W, G.CARD_H, card_init.front, card_init.center, {playing_card = G.playing_card})\n",["position"]="after",["payload"]="card:add_to_deck()\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="nominal_chips = self.base.nominal > 0 and self.base.nominal or nil,",["position"]="at",["payload"]="nominal_chips = self.base.nominal ~= 0 and self.base.nominal or nil,",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="localize{type = 'other', key = 'card_chips', nodes = desc_nodes, vars = {specific_vars.nominal_chips}}\n",["position"]="at",["payload"]="localize{type = 'other', key = 'card_chips'..(specific_vars.nominal_chips < 0 and '_minus' or ''), nodes = desc_nodes, vars = {specific_vars.nominal_chips}}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.O, config={object = DynaText({string = {card_center.set == 'Voucher' and localize('k_voucher') or localize('k_joker')}, colours = {G.C.BLUE},shadow = true, rotate = true, bump = true, pop_in = 0.3, pop_in_rate = 2, scale = 1.2})}}",["position"]="at",["payload"]="{n=G.UIT.O, config={object = DynaText({string = { SMODS.create_unlock_text(card_center) }, colours = { G.C.BLUE }, shadow = true, rotate = true, bump = true, pop_in = 0.3, pop_in_rate = 2, scale = 1.2})}}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="self.C.EDITION[2] = 0.7+0.2*(1+math.sin(self.TIMERS.REAL*1.5 + 6))",["position"]="after",["payload"]="for _,v in pairs(SMODS.Gradients) do\n   v:update(dt)\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="args.colour = copy_table(args.colour or G.C.WHITE)",["position"]="at",["payload"]="args.colour = SMODS.shallow_copy(args.colour or G.C.WHITE)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="args.cover_colour = copy_table(args.cover_colour or G.C.RED)\nargs.cover_colour_l = copy_table(lighten(args.cover_colour, 0.2))\nargs.cover_colour_d = copy_table(darken(args.cover_colour, 0.2))\n",["position"]="at",["payload"]="args.cover_colour = SMODS.shallow_copy(args.cover_colour or G.C.RED)\nargs.cover_colour_l = SMODS.shallow_copy(lighten(args.cover_colour, 0.2))\nargs.cover_colour_d = SMODS.shallow_copy(darken(args.cover_colour, 0.2))\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="args.backdrop_colour = copy_table(args.backdrop_colour)",["position"]="at",["payload"]="args.backdrop_colour = SMODS.shallow_copy(args.backdrop_colour)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="consumable_slots = 2,\n",["position"]="before",["payload"]="play_limit = 5,\ndiscard_limit = 5,\nno_limit = '',\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="self.GAME = saveTable and saveTable.GAME or self:init_game_object()\n",["position"]="after",["payload"]="SMODS.update_hand_limit_text(true, true)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if #G.hand.highlighted <= 0 or G.GAME.blind.block_play or #G.hand.highlighted > 5 then \n",["position"]="at",["payload"]="if #G.hand.highlighted <= 0 or G.GAME.blind.block_play or #G.hand.highlighted > math.max(G.GAME.starting_params.play_limit, 1) then \n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if G.GAME.current_round.discards_left <= 0 or #G.hand.highlighted <= 0 then \n",["position"]="at",["payload"]="if G.GAME.current_round.discards_left <= 0 or #G.hand.highlighted <= 0 or #G.hand.highlighted > math.max(G.GAME.starting_params.discard_limit, 0) then \n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.R, config={align = \"bcm\", padding = 0}, nodes={\n    {n=G.UIT.T, config={text = localize('b_play_hand'), scale = text_scale, colour = G.C.UI.TEXT_LIGHT, focus_args = {button = 'x', orientation = 'bm'}, func = 'set_button_pip'}}\n}},\n",["position"]="after",["payload"]="{n=G.UIT.R, config={align = \"bcm\", padding = 0}, nodes = {\n    {n=G.UIT.T, config={ref_table = SMODS.hand_limit_strings, ref_value = 'play', scale = text_scale * 0.65, colour = G.C.UI.TEXT_LIGHT}}\n}},\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.R, config={align = \"cm\", padding = 0}, nodes={\n    {n=G.UIT.T, config={text = localize('b_discard'), scale = text_scale, colour = G.C.UI.TEXT_LIGHT, focus_args = {button = 'y', orientation = 'bm'}, func = 'set_button_pip'}}\n}}",["position"]="at",["payload"]="{n=G.UIT.R, config={align = \"cm\", padding = 0}, nodes={\n    {n=G.UIT.T, config={text = localize('b_discard'), scale = text_scale, colour = G.C.UI.TEXT_LIGHT, focus_args = {button = 'y', orientation = 'bm'}, func = 'set_button_pip'}}\n}},\n{n=G.UIT.R, config={align = \"cm\", padding = 0}, nodes={\n    {n=G.UIT.T, config={ref_table = SMODS.hand_limit_strings, ref_value = 'discard', scale = text_scale * 0.65, colour = G.C.UI.TEXT_LIGHT}}\n}},\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="Jimbo = Card_Character({x = 0, y = 5})\nlocal spot = G.OVERLAY_MENU:get_UIE_by_ID('jimbo_spot')\nspot.config.object:remove()\nspot.config.object = Jimbo\nJimbo.ui_object_updated = true\nJimbo:add_speech_bubble('wq_'..math.random(1,7), nil, {quip = true})\nJimbo:say_stuff(5)\n",["position"]="at",["payload"]="local quip, extra = SMODS.quip(\"win\")\nextra.x = 0\nextra.y = 5\nJimbo = Card_Character(extra)\nlocal spot = G.OVERLAY_MENU:get_UIE_by_ID('jimbo_spot')\nspot.config.object:remove()\nspot.config.object = Jimbo\nJimbo.ui_object_updated = true\nJimbo:add_speech_bubble(quip, nil, {quip = true}, extra)\nJimbo:say_stuff((extra and extra.times) or 5, false, quip)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="Jimbo = Card_Character({x = 0, y = 5})\nlocal spot = G.OVERLAY_MENU:get_UIE_by_ID('jimbo_spot')\nspot.config.object:remove()\nspot.config.object = Jimbo\nJimbo.ui_object_updated = true\nJimbo:add_speech_bubble('lq_'..math.random(1,10), nil, {quip = true})\nJimbo:say_stuff(5)\n",["position"]="at",["payload"]="local quip, extra = SMODS.quip(\"loss\")\nextra.x = 0\nextra.y = 5\nJimbo = Card_Character(extra)\nlocal spot = G.OVERLAY_MENU:get_UIE_by_ID('jimbo_spot')\nspot.config.object:remove()\nspot.config.object = Jimbo\nJimbo.ui_object_updated = true\nJimbo:add_speech_bubble(quip, nil, {quip = true}, extra)\nJimbo:say_stuff((extra and extra.times) or 5, false, quip)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card_character.lua"},["pattern"]="self.children.card:start_materialize({G.C.BLUE, G.C.WHITE, G.C.RED})",["position"]="at",["payload"]="self.children.card:start_materialize({args.materialize_colours and args.materialize_colours[1] or G.C.BLUE, args.materialize_colours and args.materialize_colours[2] or G.C.WHITE, args.materialize_colours and args.materialize_colours[3] or G.C.RED})",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card_character.lua"},["pattern"]="colours = {G.C.RED, G.C.BLUE, G.C.ORANGE},",["position"]="at",["payload"]="colours = {args.particle_colours and args.particle_colours[1] or G.C.RED, args.particle_colours and args.particle_colours[2] or G.C.BLUE, args.particle_colours and args.particle_colours[3] or G.C.ORANGE},",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card_character.lua"},["pattern"]="self.children.card = Card(self.T.x, self.T.y, G.CARD_W, G.CARD_H, G.P_CARDS.empty, args.center or G.P_CENTERS.j_joker, {bypass_discovery_center = true})\n",["position"]="at",["payload"]="self.children.card = Card(self.T.x, self.T.y, G.CARD_W, G.CARD_H, G.P_CARDS.empty, args.center and G.P_CENTERS[args.center] or G.P_CENTERS.j_joker, {bypass_discovery_center = true})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card_character.lua"},["pattern"]="function Card_Character:add_speech_bubble(text_key, align, loc_vars)\n",["position"]="at",["payload"]="function Card_Character:add_speech_bubble(text_key, align, loc_vars, quip_args)\n    if quip_args and quip_args.text_key then text_key = quip_args.text_key end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card_character.lua"},["pattern"]="function Card_Character:say_stuff(n, not_first)\n",["position"]="at",["payload"]="function Card_Character:say_stuff(n, not_first, quip_key)\n    local quip = SMODS.JimboQuips[quip_key] or {}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card_character.lua"},["pattern"]="self:say_stuff(n, true)\n",["position"]="at",["payload"]="self:say_stuff(n, true, quip_key)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card_character.lua"},["pattern"]="self:say_stuff(n-1, true)\n",["position"]="at",["payload"]="self:say_stuff(n-1, true, quip_key)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card_character.lua"},["pattern"]="play_sound('voice'..math.random(1, 11), G.SPEEDFACTOR*(math.random()*0.2+1), 0.5)\n",["position"]="at",["payload"]="if quip.play_sounds and type(quip.play_sounds) == 'function' then\n    quip:play_sounds(n)\nelseif quip.extra and quip.extra.sound then\n    local custom_pitch = quip.extra.pitch\n    if type(quip.extra.sound) == 'table' then\n        for k, v in pairs(quip.extra.sound) do\n            play_sound(v, custom_pitch or G.SPEEDFACTOR*(math.random()*0.2+1), 0.5)\n        end\n    elseif type(quip.extra.sound) == 'string' then\n        play_sound(quip.extra.sound, custom_pitch or G.SPEEDFACTOR*(math.random()*0.2+1), 0.5)\n    else\n        play_sound('voice'..math.random(1, 11), custom_pitch or G.SPEEDFACTOR*(math.random()*0.2+1), 0.5)\n    end\nelse\n    play_sound('voice'..math.random(1, 11), quip.extra and quip.extra.pitch or G.SPEEDFACTOR*(math.random()*0.2+1), 0.5)\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card_character.lua"},["pattern"]="delay = 0.13,\n",["position"]="at",["payload"]="delay = quip.extra and quip.extra.delay or 0.13,\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card_character.lua"},["pattern"]="self.children.card:juice_up()\n",["position"]="at",["payload"]="local juice_params = quip.extra and quip.extra.juice or {nil, nil}\nself.children.card:juice_up(juice_params[1], juice_params[2])\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self.ability.yorick_discards = self.ability.yorick_discards - 1",["position"]="after",["payload"]="return nil, true",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="card_eval_status_text(self, 'extra', nil, nil, nil, {message = localize('k_plus_tarot'), colour = G.C.PURPLE})",["position"]="after",["payload"]="return nil, true",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="message = localize('k_eaten_ex'),\ncolour = G.C.FILTER",["position"]="before",["payload"]="card = self,",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="message = localize{type='variable',key='a_xmult_minus',vars={self.ability.extra}},",["position"]="before",["payload"]="card = self,",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="delay = 0.2,\nmessage = localize{type='variable',key='a_xmult',vars={self.ability.x_mult}},",["position"]="before",["payload"]="card = self,",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="message = localize('$')..self.ability.extra.dollars,\n    dollars = self.ability.extra.dollars,",["position"]="at",["payload"]="message = localize('$')..self.ability.extra.dollars,",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="message = localize('$')..self.ability.extra,\n    dollars = self.ability.extra,",["position"]="at",["payload"]="message = localize('$')..self.ability.extra,",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if not (love.filesystem.read('localization/'..G.SETTINGS.language..'.lua')) or G.F_ENGLISH_ONLY then",["position"]="at",["payload"]="if false then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="local localization = love.filesystem.getInfo('localization/'..G.SETTINGS.language..'.lua')",["position"]="at",["payload"]="local localization = love.filesystem.getInfo('localization/'..G.SETTINGS.language..'.lua') or love.filesystem.getInfo('localization/en-us.lua')",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="self.localization = assert(loadstring(love.filesystem.read('localization/'..G.SETTINGS.language..'.lua')))()",["position"]="at",["payload"]="self.localization = assert(loadstring(love.filesystem.read('localization/'..G.SETTINGS.language..'.lua') or love.filesystem.read('localization/en-us.lua'), '=[localization \"'..G.SETTINGS.language..'.lua\"]'))()",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="self.LANG = self.LANGUAGES[self.SETTINGS.language] or self.LANGUAGES['en-us']",["position"]="at",["payload"]="self.LANG = self.LANGUAGES[self.SETTINGS.real_language or self.SETTINGS.language] or self.LANGUAGES['en-us']",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="G.SETTINGS.language = lang.key",["position"]="at",["payload"]="G.SETTINGS.language = lang.loc_key or lang.key\nG.SETTINGS.real_language = lang.key",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if (_infotip_object.config.set ~= e.config.ref_table.label) and (not G.F_NO_ACHIEVEMENTS) then",["position"]="at",["payload"]="if (_infotip_object.config.set ~= e.config.ref_table.label) then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"globals.lua"},["pattern"]="if love.system.getOS() == 'OS X' then",["position"]="before",["payload"]="if love.system.getOS() == 'Android' or love.system.getOS() == 'iOS' then\n\009self.F_SAVE_TIMER = 5\n\009self.F_DISCORD = true\n\009self.F_NO_ACHIEVEMENTS = true\n\009self.F_CRASH_REPORTS = false\n\009self.F_SOUND_THREAD = true\n\009self.F_VIDEO_SETTINGS = false\n\009self.F_ENGLISH_ONLY = false\n\009self.F_QUIT_BUTTON = false\n    self.F_MOBILE_UI = true\nend\n",["indent"]=true,["times"]=1},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="highdpi = (love.system.getOS() == 'OS X')",["position"]="at",["payload"]="highdpi = (love.system.getOS() == 'OS X' or love.system.getOS() == 'Android' or love.system.getOS() == 'iOS')",["indent"]=true,["times"]=1},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="resizable = true,",["position"]="at",["payload"]="resizable = not (love.system.getOS() == 'Android' or love.system.getOS() == 'iOS'),",["indent"]=true,["times"]=1},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"main.lua"},["pattern"]="local os = love.system.getOS()",["position"]="after",["payload"]="if os == 'Android' or os == 'iOS' then love.window.updateMode(2, 1) end",["indent"]=true,["times"]=1},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if G.CONTROLLER.text_input_hook == e and G.CONTROLLER.HID.controller then",["position"]="at",["payload"]="if G.CONTROLLER.text_input_hook == e and (G.CONTROLLER.HID.controller or G.CONTROLLER.HID.touch) then",["indent"]=true,["times"]=1},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"flame.fs"},["pattern"]="#endif",["position"]="after",["payload"]="#ifdef GL_ES\n    precision MY_HIGHP_OR_MEDIUMP float;\n#endif\n",["indent"]=true,["times"]=1},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"flame.fs"},["pattern"]="vec4 effect*",["position"]="at",["payload"]="mediump vec4 effect( mediump vec4 colour, Image texture, mediump vec2 texture_coords, mediump vec2 screen_coords )",["indent"]=true,["times"]=1},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"CRT.fs"},["pattern"]="*noise_fac*",["position"]="at",["payload"]="",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="for _, lines in ipairs(args.type == 'unlocks' and loc_target.unlock_parsed or args.type == 'name' and loc_target.name_parsed or (args.type == 'text' or args.type == 'tutorial' or args.type == 'quips') and loc_target or loc_target.text_parsed) do\n",["position"]="before",["payload"]="args.AUT = args.AUT or {}\nargs.AUT.box_colours = {}\nif (args.type == 'descriptions' or args.type == 'other') and type(loc_target.text) == 'table' and type(loc_target.text[1]) == 'table' then\n    args.AUT.multi_box = args.AUT.multi_box or {} \n    for i, box in ipairs(loc_target.text_parsed) do\n        for j, line in ipairs(box) do\n            local final_line = SMODS.localize_box(line, args)\n            if i == 1 or next(args.AUT.info) then\n                args.nodes[#args.nodes+1] = final_line -- Sends main box to AUT.main\n                if not next(args.AUT.info) then args.nodes.main_box_flag = true end\n            elseif not next(args.AUT.info) then \n                args.AUT.multi_box[i-1] = args.AUT.multi_box[i-1] or {}\n                args.AUT.multi_box[i-1][#args.AUT.multi_box[i-1]+1] = final_line\n            end\n            if not next(args.AUT.info) then args.AUT.box_colours[i] = args.vars.box_colours and args.vars.box_colours[i] or G.C.UI.BACKGROUND_WHITE end\n        end\n    end\n    return\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="for _, line in ipairs(center.text) do\n    center.text_parsed[#center.text_parsed+1] = loc_parse_string(line)\nend\n",["position"]="at",["payload"]="for _, line in ipairs(center.text) do\n    if type(line) == 'table' then\n        center.text_parsed[#center.text_parsed+1] = {}\n        for _, new_line in ipairs(line) do\n             center.text_parsed[#center.text_parsed][#center.text_parsed[#center.text_parsed]+1] = loc_parse_string(new_line)\n        end\n    else\n        center.text_parsed[#center.text_parsed+1] = loc_parse_string(line)\n    end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="if AUT.info then\n",["position"]="before",["payload"]="AUT.main.background_colour = AUT.main.background_colour or AUT.box_colours and AUT.box_colours[1] or nil\nlocal multi_boxes = {}\nif AUT.multi_box then\n    for i, box in ipairs(AUT.multi_box) do\n        box.background_colour = box.background_colour or AUT.box_colours and AUT.box_colours[i+1] or nil\n        if AUT.box_starts and AUT.box_starts[i] then table.insert(box, 1, AUT.box_starts[i]) end\n        if AUT.box_ends and AUT.box_ends[i] then table.insert(box, AUT.box_ends[i]) end\n        multi_boxes[#multi_boxes+1] = desc_from_rows(box)\n    end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="return {n=G.UIT.ROOT, config = {align = 'cm', colour = G.C.CLEAR}, nodes={\n    {n=G.UIT.C, config={align = \"cm\", func = 'show_infotip',object = Moveable(),ref_table = next(info_boxes) and info_boxes or nil}, nodes={\n",["position"]="at",["payload"]="local cols\nif #info_boxes <= 3 then\n    cols = 1\nelseif #info_boxes <= 10 then\n    cols = 2\nelseif #info_boxes <= 24 then\n    cols = 3\nelse\n    cols = 4\nend\nlocal nodes_per_col = math.ceil(#info_boxes/cols)\nlocal info_cols = {}\nfor i = 0, cols-1 do\n    local col = {}\n    for j = 1, nodes_per_col do\n        local info_box = info_boxes[i*nodes_per_col+j]\n        if info_box then\n            table.insert(col, info_box)\n        else break end\n    end\n    table.insert(info_cols, {n=G.UIT.C, config = {align=\"cm\"}, nodes = col})\nend\ninfo_boxes = {{n=G.UIT.R, config = {align=\"cm\", padding = 0.05, card_pos = card.T.x }, nodes = info_cols}}\nlocal ret_val = {n=G.UIT.ROOT, config = {align = 'cm', colour = G.C.CLEAR}, nodes={\n    {n=G.UIT.C, config={align = \"cm\", func = 'show_infotip',object = Moveable(),ref_table = next(info_boxes) and info_boxes or nil}, nodes={\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="            badges[1] and {n=G.UIT.R, config={align = \"cm\", padding = 0.03}, nodes=badges} or nil,\n            }}\n        }}\n    }},\n}}\n",["position"]="after",["payload"]="if multi_boxes[1] then\n    for i=1, #ret_val.nodes[1].nodes[1].nodes[1].nodes do -- find the main box\n        if ret_val.nodes[1].nodes[1].nodes[1].nodes[i] and ret_val.nodes[1].nodes[1].nodes[1].nodes[i].config and ret_val.nodes[1].nodes[1].nodes[1].nodes[i].config.main_box_flag then\n            for j=#multi_boxes, 1, -1 do -- add the extra boxes\n                table.insert(ret_val.nodes[1].nodes[1].nodes[1].nodes, i+1, multi_boxes[j])\n            end\n            break\n        end\n    end\n    \nend\n\nreturn ret_val\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="return {n=G.UIT.R, config={align = \"cm\", colour = empty and G.C.CLEAR or G.C.UI.BACKGROUND_WHITE, r = 0.1, padding = 0.04, minw = 2, minh = 0.8, emboss = not empty and 0.05 or nil, filler = true}, nodes={",["position"]="at",["payload"]="return {n=G.UIT.R, config={align = \"cm\", colour = empty and G.C.CLEAR or G.C.UI.BACKGROUND_WHITE, r = 0.1, padding = 0.04, minw = 2, minh = 0.8, emboss = not empty and 0.05 or nil, filler = true, main_box_flag = desc_nodes.main_box_flag and true or nil}, nodes={",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.T, config={text = G.GAME.hands[handname].chips, scale = 0.45, colour = G.C.UI.TEXT_LIGHT}},",["position"]="at",["payload"]="{n=G.UIT.T, config={text = number_format(G.GAME.hands[handname].chips, 1000000), scale = 0.45, colour = G.C.UI.TEXT_LIGHT}},",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.T, config={text = G.GAME.hands[handname].mult, scale = 0.45, colour = G.C.UI.TEXT_LIGHT}}",["position"]="at",["payload"]="{n=G.UIT.T, config={text = number_format(G.GAME.hands[handname].mult, 1000000), scale = 0.45, colour = G.C.UI.TEXT_LIGHT}}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="function number_format(num)",["position"]="at",["payload"]="function number_format(num, e_switch_point)\n    if type(num) ~= 'number' then return num end\n\n    local sign = (num >= 0 and \"\") or \"-\"\n    num = math.abs(num)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="return string.format(\"%.3f\",x/(10^fac))..'e'..fac",["position"]="at",["payload"]="if num == math.huge then\n    return sign..\"naneinf\"\nend\n\nlocal mantissa = round_number(x/(10^fac), 3)\nif mantissa >= 10 then\n    mantissa = mantissa / 10\n    fac = fac + 1\nend\nreturn sign..(string.format(fac >= 100 and \"%.1fe%i\" or fac >= 10 and \"%.2fe%i\" or \"%.3fe%i\", mantissa, fac))",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="return string.format(num ~= math.floor(num) and (num >= 100 and \"%.0f\" or num >= 10 and \"%.1f\" or \"%.2f\") or \"%.0f\", num):reverse():gsub(\"(%d%d%d)\", \"%1,\"):gsub(\",$\", \"\"):reverse()",["position"]="at",["payload"]="local formatted\nif num ~= math.floor(num) and num < 100 then\n    formatted = string.format(num >= 10 and \"%.1f\" or \"%.2f\", num)\n    if formatted:sub(-1) == \"0\" then\n        formatted = formatted:gsub(\"%.?0+$\", \"\")\n    end\n    -- Return already to avoid comas being added\n    if num < 0.01 then return tostring(num) end\nelse \n    formatted = string.format(\"%.0f\", num)\nend\nreturn sign..(formatted:reverse():gsub(\"(%d%d%d)\", \"%1,\"):gsub(\",$\", \"\"):reverse())",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="function scale_number(number, scale, max)",["position"]="at",["payload"]="function scale_number(number, scale, max, e_switch_point)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="function Game:init_game_object()",["position"]="after",["payload"]="    local cards_played = {}\n    for _,v in ipairs(SMODS.Rank.obj_buffer) do\n        cards_played[v] = { suits = {}, total = 0 }\n    end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="local _ = nil",["position"]="before",["payload"]="if not SMODS.add_to_pool(SMODS.Ranks[v.value], {initial_deck = true, suit = v.suit})\nor not SMODS.add_to_pool(SMODS.Suits[v.suit], {initial_deck = true, rank = v.value}) then\n    goto continue\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="local _ = nil",["position"]="before",["payload"]="if self.GAME.selected_back_key.initial_deck then\n    local _id = self.GAME.selected_back_key.initial_deck\n    local _exclude = _id.exclude\n    for i,_tab in ipairs({_id.Ranks or _id.exclude and {} or SMODS.Rank.obj_buffer, _id.Suits}) do\n        if _tab ~= nil then\n            local _create = not not _exclude\n            for _,_v in ipairs(_tab) do\n                if (i==1 and v.value or v.suit) == _v then _create = not _exclude; break end\n            end\n            if not _create then\n                goto continue\n            end\n        end\n    end\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if self.GAME.starting_params.erratic_suits_and_ranks then _, k = pseudorandom_element(G.P_CARDS, pseudoseed('erratic')) end",["position"]="at",["payload"]="if self.GAME.starting_params.erratic_suits_and_ranks then\n    v, k = pseudorandom_element(G.P_CARDS, pseudoseed('erratic'), {starting_deck = true})\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="local _r, _s = string.sub(k, 3, 3), string.sub(k, 1, 1)",["position"]="at",["payload"]="local _r, _s = SMODS.Ranks[v.value].card_key, SMODS.Suits[v.suit].card_key",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if self.GAME.starting_params.no_faces and (_r == 'K' or _r == 'Q' or _r == 'J') then keep = false end",["position"]="at",["payload"]="if self.GAME.starting_params.no_faces and SMODS.Ranks[v.value].face then keep = false end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if keep then card_protos[#card_protos+1] = {s=_s,r=_r,e=_e,d=_d,g=_g} end",["position"]="after",["payload"]="::continue::",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="return G.ARGS.LOC_COLOURS[_c] or _default or G.C.UI.TEXT_DARK",["position"]="before",["payload"]="    for _, v in ipairs(SMODS.Rarity.obj_buffer) do\n        G.ARGS.LOC_COLOURS[v:lower()] = G.C.RARITY[v]\n    end\n    for _, v in ipairs(SMODS.Gradient.obj_buffer) do\n        G.ARGS.LOC_COLOURS[v:lower()] = SMODS.Gradients[v]\n    end\n