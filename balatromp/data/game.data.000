Box:recalculate()\n\009end,\n\009init_bind = function(button)\n\009\009button.config.button = nil\n\009\009Handy.controller.bind_button = button\n\009\009Handy.controller.bind_module = button.config.ref_table.module\n\009\009Handy.controller.bind_key = button.config.ref_table.key\n\009\009Handy.controller.only_holdable = button.config.ref_table.only_holdable or false\n\009\009Handy.controller.only_safe = button.config.ref_table.only_safe or false\n\009\009Handy.controller.rerender_after_bind = button.config.ref_table.rerender or nil\n\n\009\009Handy.controller.update_bind_button_text(\n\009\009\009\"[\"\n\009\009\009\009.. Handy.UI.PARTS.localize_keybind(Handy.controller.bind_module[Handy.controller.bind_key] or \"None\")\n\009\009\009\009.. \"]\"\n\009\009)\n\009end,\n\009complete_bind = function(key)\n\009\009if Handy.controller.only_safe and Handy.controller.non_safe[key] then\n\009\009\009Handy.UI.state_panel.display(function(state)\n\009\009\009\009state.items.non_holdable = {\n\009\009\009\009\009text = localize(\"ph_handy_notif_cannot_bind_non_safe\"),\n\009\009\009\009\009hold = false,\n\009\009\009\009\009order = 0,\n\009\009\009\009}\n\009\009\009\009return true\n\009\009\009end)\n\009\009\009return Handy.controller.cancel_bind()\n\009\009end\n\009\009if Handy.controller.only_holdable and Handy.controller.non_holdable[key] then\n\009\009\009Handy.UI.state_panel.display(function(state)\n\009\009\009\009state.items.non_holdable = {\n\009\009\009\009\009text = localize(\"ph_handy_notif_cannot_bind_non_holdable\"),\n\009\009\009\009\009hold = false,\n\009\009\009\009\009order = 0,\n\009\009\009\009}\n\009\009\009\009return true\n\009\009\009end)\n\009\009\009return Handy.controller.cancel_bind()\n\009\009end\n\009\009Handy.controller.bind_module[Handy.controller.bind_key] = key or \"None\"\n\009\009Handy.controller.update_bind_button_text(Handy.UI.PARTS.localize_keybind(key or \"None\"))\n\n\009\009if Handy.controller.bind_button then\n\009\009\009Handy.controller.bind_button.config.button = \"handy_init_keybind_change\"\n\009\009end\n\009\009Handy.controller.bind_button = nil\n\009\009Handy.controller.bind_module = nil\n\009\009Handy.controller.bind_key = nil\n\009\009Handy.controller.only_holdable = nil\n\009\009Handy.controller.only_safe = nil\n\n\009\009if Handy.controller.rerender_after_bind then\n\009\009\009Handy.controller.rerender_after_bind = nil\n\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009blocking = false,\n\009\009\009\009blockable = false,\n\009\009\009\009no_delete = true,\n\009\009\009\009func = function()\n\009\009\009\009\009Handy.UI.rerender(true)\n\009\009\009\009\009return true\n\009\009\009\009end,\n\009\009\009}))\n\009\009end\n\009end,\n\009cancel_bind = function()\n\009\009if not Handy.controller.bind_module or not Handy.controller.bind_key or not Handy.controller.bind_button then\n\009\009\009return\n\009\009end\n\009\009Handy.controller.update_bind_button_text(\n\009\009\009Handy.UI.PARTS.localize_keybind(Handy.controller.bind_module[Handy.controller.bind_key] or \"None\")\n\009\009)\n\n\009\009Handy.controller.bind_button.config.button = \"handy_init_keybind_change\"\n\009\009Handy.controller.bind_button = nil\n\009\009Handy.controller.bind_module = nil\n\009\009Handy.controller.bind_key = nil\n\009\009Handy.controller.only_holdable = nil\n\009\009Handy.controller.only_safe = nil\n\009\009Handy.controller.rerender_after_bind = nil\n\009end,\n\n\009process_bind = function(key, options)\n\009\009if not Handy.controller.bind_button then\n\009\009\009return false\n\009\009end\n\009\009local parsed_key, is_discard_key = Handy.controller.parse(key, options)\n\009\009if is_discard_key then\n\009\009\009parsed_key = \"None\"\n\009\009end\n\009\009Handy.controller.complete_bind(parsed_key)\n\009\009Handy.config.save()\n\009\009return true\n\009end,\n\n\009parse_table = key_from_raw_table,\n\009resolve_table = keys_to_raw_table,\n\n\009parse_gamepad_table = gamepad_key_from_raw_table,\n\009resolve_gamepad_table = gamepad_keys_to_raw_table,\n\n\009mouse_to_key_table = mouse_raw_from_index_table,\n\009wheel_to_key_table = wheel_raw_from_index_table,\n\n\009mouse_buttons = mouse_key_to_index_table,\n\009wheel_buttons = wheel_key_to_index_table,\n\n\009non_holdable = non_holdable_keys_table,\n\009non_safe = non_safe_keys_table,\n\n\009parse = function(raw_key, options)\n\009\009if not raw_key then\n\009\009\009return nil, false\n\009\009end\n\009\009options = options or {}\n\n\009\009if options.gamepad or options.any then\n\009\009\009local gamepad_result = Handy.controller.parse_gamepad_table[raw_key]\n\009\009\009if gamepad_result or options.gamepad then\n\009\009\009\009return gamepad_result, gamepad_result == \"(Back)\"\n\009\009\009end\n\009\009end\n\n\009\009local result\n\009\009if Handy.controller.parse_table[raw_key] then\n\009\009\009result = Handy.controller.parse_table[raw_key]\n\009\009elseif string.sub(raw_key, 1, 2) == \"kp\" then\n\009\009\009result = \"NUM \" .. string.sub(raw_key, 3)\n\009\009else\n\009\009\009result = string.upper(string.sub(raw_key, 1, 1)) .. string.sub(raw_key, 2)\n\009\009end\n\009\009return result, result == \"Escape\"\n\009end,\n\009resolve = function(parsed_key, options)\n\009\009if not parsed_key or parsed_key == \"None\" then\n\009\009\009return nil\n\009\009end\n\009\009options = options or {}\n\n\009\009if options.gamepad or options.any then\n\009\009\009local result = Handy.controller.resolve_gamepad_table[parsed_key]\n\009\009\009if result or options.gamepad then\n\009\009\009\009return unpack(result or { nil })\n\009\009\009end\n\009\009end\n\009\009if Handy.controller.resolve_table[parsed_key] then\n\009\009\009return unpack(Handy.controller.resolve_table[parsed_key])\n\009\009elseif string.sub(parsed_key, 1, 4) == \"NUM \" then\n\009\009\009return \"kp\" .. string.sub(parsed_key, 5)\n\009\009else\n\009\009\009return string.gsub(string.lower(parsed_key), \"%s+\", \"\")\n\009\009end\n\009end,\n\009resolve_first_module_key = function(module, allow_disabled)\n\009\009module = Handy.m(module)\n\009\009if module and (allow_disabled or module.enabled) then\n\009\009\009if force_gamepad or Handy.controller.is_gamepad() then\n\009\009\009\009return Handy.controller.resolve(module.key_1_gamepad, { gamepad = true })\n\009\009\009\009\009or Handy.controller.resolve(module.key_2_gamepad, { gamepad = true })\n\009\009\009end\n\009\009\009return Handy.controller.resolve(module.key_1) or Handy.controller.resolve(module.key_2)\n\009\009end\n\009\009return nil\n\009end,\n\009is_down = function(...)\n\009\009local parsed_keys = { ... }\n\009\009for i = 1, #parsed_keys do\n\009\009\009local parsed_key = parsed_keys[i]\n\009\009\009if parsed_key and parsed_key ~= \"Unknown\" and parsed_key ~= \"None\" then\n\009\009\009\009if Handy.controller.wheel_buttons[parsed_key] then\n\009\009\009\009\009-- Well, skip\n\009\009\009\009elseif Handy.controller.mouse_buttons[parsed_key] then\n\009\009\009\009\009if\n\009\009\009\009\009\009love.mouse.isDown(Handy.controller.mouse_buttons[parsed_key])\n\009\009\009\009\009\009or (parsed_key == \"Left Mouse\" and (next(love.touch.getTouches())))\n\009\009\009\009\009then\n\009\009\009\009\009\009return true\n\009\009\009\009\009end\n\009\009\009\009elseif Handy.controller.resolve(parsed_key, { gamepad = true }) then\n\009\009\009\009\009local resolved_raw_value = Handy.controller.resolve_gamepad_table[parsed_key]\n\009\009\009\009\009if resolved_raw_value and resolved_raw_value.axis_check then\n\009\009\009\009\009\009local success, is_active = pcall(resolved_raw_value.axis_check)\n\009\009\009\009\009\009if success and is_active then\n\009\009\009\009\009\009\009return true\n\009\009\009\009\009\009end\n\009\009\009\009\009else\n\009\009\009\009\009\009local success, is_down = pcall(function()\n\009\009\009\009\009\009\009return G.CONTROLLER.GAMEPAD.object:isGamepadDown(\n\009\009\009\009\009\009\009\009Handy.controller.resolve(parsed_key, { gamepad = true })\n\009\009\009\009\009\009\009)\n\009\009\009\009\009\009end)\n\009\009\009\009\009\009if success and is_down then\n\009\009\009\009\009\009\009return true\n\009\009\009\009\009\009end\n\009\009\009\009\009end\n\009\009\009\009else\n\009\009\009\009\009local success, is_down = pcall(function()\n\009\009\009\009\009\009return love.keyboard.isDown(Handy.controller.resolve(parsed_key))\n\009\009\009\009\009end)\n\009\009\009\009\009if success and is_down then\n\009\009\009\009\009\009return true\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009\009return false\n\009end,\n\009is = function(raw_key, ...)\n\009\009if not raw_key or raw_key == \"Unknown\" or raw_key == \"None\" then\n\009\009\009return false\n\009\009end\n\009\009local parsed_keys = { ... }\n\009\009for i = 1, #parsed_keys do\n\009\009\009local parsed_key = parsed_keys[i]\n\009\009\009if parsed_key then\n\009\009\009\009local resolved_key_1, resolved_key_2 = Handy.controller.resolve(parsed_key, { any = true })\n\009\009\009\009if raw_key == resolved_key_1 or raw_key == resolved_key_2 then\n\009\009\009\009\009return true\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009\009return false\n\009end,\n\n\009is_module_key_down = function(module, allow_disabled, force_gamepad)\n\009\009module = Handy.m(module)\n\009\009if module and (allow_disabled or module.enabled) then\n\009\009\009if force_gamepad or Handy.controller.is_gamepad() then\n\009\009\009\009return Handy.controller.is_down(module.key_1_gamepad, module.key_2_gamepad)\n\009\009\009end\n\009\009\009return Handy.controller.is_down(module.key_1, module.key_2)\n\009\009end\n\009\009return false\n\009end,\n\009is_module_key = function(module, raw_key, allow_disabled, force_gamepad)\n\009\009module = Handy.m(module)\n\009\009if module and (allow_disabled or module.enabled) then\n\009\009\009if force_gamepad or Handy.controller.is_gamepad() then\n\009\009\009\009return Handy.controller.is(raw_key, module.key_1_gamepad, module.key_2_gamepad)\n\009\009\009else\n\009\009\009\009return Handy.controller.is(raw_key, module.key_1, module.key_2)\n\009\009\009end\n\009\009end\n\009\009return false\n\009end,\n\009is_module_enabled = function(module)\n\009\009module = Handy.m(module)\n\009\009return module and module.enabled\n\009end,\n\n\009is_trigger_on_release = function()\n\009\009return Handy.cc.keybinds_trigger_mode == 2\n\009end,\n\009is_triggered = function(released)\n\009\009if Handy.controller.is_trigger_on_release() then\n\009\009\009return released\n\009\009end\n\009\009return not released\n\009end,\n\009is_debugplus_console_opened = function()\n\009\009return Handy.controller.console_opened_timer > G.TIMERS.UPTIME\n\009end,\n\009is_debugplus_triggered = function()\n\009\009local dp = Handy.controller.get_debugplus_module()\n\009\009if not (dp.installed and Handy.cc.prevent_if_debugplus.enabled) then\n\009\009\009return false\n\009\009end\n\009\009local success, is_triggered = pcall(function()\n\009\009\009return dp.config.getValue(\"ctrlKeybinds\") and dp.utils.isCtrlDown()\n\009\009end)\n\009\009return success and is_triggered\n\009end,\n\009update_is_console_opened = function() end,\n\009prevent_if_debugplus = function(key, released)\n\009\009if Handy.controller.is_debugplus_triggered() then\n\009\009\009if Handy.cc.notifications_level > 2 and not Handy.controller.is(key, \"Ctrl\") then\n\009\009\009\009Handy.UI.state_panel.display(function(state)\n\009\009\009\009\009state.items.prevented_by_debugplus = {\n\009\009\009\009\009\009text = \"Keybinds prevented by DebugPlus \" .. Handy.UI.PARTS.localize_keybind(\"Ctrl\", true),\n\009\009\009\009\009\009hold = false,\n\009\009\009\009\009\009order = 0,\n\009\009\009\009\009}\n\009\009\009\009\009return true\n\009\009\009\009end)\n\009\009\009end\n\009\009\009return true\n\009\009end\n\009\009return false\n\009end,\n\n\009process_key = function(key, released)\n\009\009Handy.controller.update_device_type({ keyboard = true })\n\009\009G.njy_keybind = nil\n\n\009\009-----\n\n\009\009if not Handy.is_mod_active() then\n\009\009\009return false\n\009\009end\n\009\009if Handy.controller.is_debugplus_console_opened() then\n\009\009\009return false\n\009\009end\n\009\009if not released and Handy.controller.process_bind(key) then\n\009\009\009return true\n\009\009end\n\009\009if key == \"escape\" or G.CONTROLLER.text_input_hook or not Handy.is_mod_active() then\n\009\009\009return false\n\009\009end\n\009\009if Handy.controller.prevent_if_debugplus(key, released) then\n\009\009\009return false\n\009\009end\n\009\009local finish = function(result)\n\009\009\009Handy.UI.state_panel.update(key, released)\n\009\009\009return result\n\009\009end\n\n\009\009-----\n\n\009\009if not released and Handy.presets_switch.use(key) then\n\009\009\009return finish(true)\n\009\009end\n\n\009\009if Handy.misc_controls.use(key, released) then\n\009\009\009return finish(true)\n\009\009end\n\n\009\009if not released then\n\009\009\009if\n\009\009\009\009Handy.speed_multiplier.use(key)\n\009\009\009\009or Handy.nopeus_interaction.use(key)\n\009\009\009\009or Handy.animation_skip.use(key)\n\009\009\009then\n\009\009\009\009return finish(true)\n\009\009\009end\n\009\009end\n\n\009\009local in_run = G.STAGE == G.STAGES.RUN and not G.SETTINGS.paused and not G.OVERLAY_MENU\n\009\009if in_run then\n\009\009\009if not released then\n\009\009\009\009Handy.insta_highlight.use_on_hovered(key)\n\009\009\009end\n\009\009\009if Handy.controller.is_triggered(released) then\n\009\009\009\009Handy.insta_actions.use_alt(key)\n\009\009\009\009Handy.move_highlight.use(key)\n\009\009\009end\n\009\009end\n\009\009if Handy.controller.is_triggered(released) then\n\009\009\009Handy.regular_keybinds.use(key)\n\009\009end\n\009\009if in_run then\n\009\009\009if Handy.controller.is_triggered(released) then\n\009\009\009\009Handy.insta_highlight_entire_f_hand.use(key)\n\009\009\009\009Handy.deselect_hand.use(key)\n\009\009\009end\n\n\009\009\009Handy.dangerous_actions.toggle_queue(key, released)\n\009\009\009Handy.dangerous_actions.use(key, released)\n\009\009end\n\n\009\009return finish(false)\n\009end,\n\009process_mouse = function(mouse, released, touch)\n\009\009Handy.controller.update_device_type({ mouse = not touch, touch = touch })\n\009\009G.njy_keybind = nil\n\009\009local key = Handy.controller.mouse_to_key_table[mouse]\n\n\009\009-----\n\n\009\009if not Handy.is_mod_active() then\n\009\009\009return false\n\009\009end\n\009\009if Handy.controller.is_debugplus_console_opened() then\n\009\009\009return false\n\009\009end\n\009\009if not released and Handy.controller.process_bind(key) then\n\009\009\009return true\n\009\009end\n\009\009if G.CONTROLLER.text_input_hook or not Handy.is_mod_active() then\n\009\009\009return false\n\009\009end\n\009\009if Handy.controller.prevent_if_debugplus(key, released) then\n\009\009\009return false\n\009\009end\n\n\009\009local finish = function(result)\n\009\009\009Handy.UI.state_panel.update(key, released)\n\009\009\009return result\n\009\009end\n\n\009\009-----\n\n\009\009if touch then\n\009\009\009return finish(false)\n\009\009end\n\n\009\009if not released and Handy.presets_switch.use(key) then\n\009\009\009return finish(true)\n\009\009end\n\n\009\009if Handy.misc_controls.use(key, released) then\n\009\009\009return finish(true)\n\009\009end\n\n\009\009if not released then\n\009\009\009if\n\009\009\009\009Handy.speed_multiplier.use(key)\n\009\009\009\009or Handy.nopeus_interaction.use(key)\n\009\009\009\009or Handy.animation_skip.use(key)\n\009\009\009then\n\009\009\009\009return finish(true)\n\009\009\009end\n\009\009end\n\n\009\009local in_run = G.STAGE == G.STAGES.RUN and not G.SETTINGS.paused and not G.OVERLAY_MENU\n\009\009if in_run then\n\009\009\009if not released then\n\009\009\009\009Handy.insta_highlight.use_on_hovered(key)\n\009\009\009end\n\009\009\009if Handy.controller.is_triggered(released) then\n\009\009\009\009Handy.insta_actions.use_alt(key)\n\009\009\009\009Handy.move_highlight.use(key)\n\009\009\009end\n\009\009end\n\009\009if Handy.controller.is_triggered(released) then\n\009\009\009Handy.regular_keybinds.use(key)\n\009\009end\n\009\009if in_run then\n\009\009\009if Handy.controller.is_triggered(released) then\n\009\009\009\009Handy.insta_highlight_entire_f_hand.use(key)\n\009\009\009\009Handy.deselect_hand.use(key)\n\009\009\009end\n\n\009\009\009Handy.dangerous_actions.toggle_queue(key, released)\n\009\009\009Handy.dangerous_actions.use(key, released)\n\009\009end\n\n\009\009return finish(false)\n\009end,\n\009process_wheel = function(wheel)\n\009\009Handy.controller.update_device_type({ mouse = true })\n\009\009local key = Handy.controller.wheel_to_key_table[wheel]\n\n\009\009-----\n\n\009\009if not Handy.is_mod_active() then\n\009\009\009return false\n\009\009end\n\009\009if Handy.controller.is_debugplus_console_opened() then\n\009\009\009return false\n\009\009end\n\009\009if Handy.controller.process_bind(key) then\n\009\009\009return true\n\009\009end\n\009\009if G.CONTROLLER.text_input_hook or not Handy.is_mod_active() then\n\009\009\009return false\n\009\009end\n\009\009if Handy.controller.prevent_if_debugplus(key, false) then\n\009\009\009return false\n\009\009end\n\n\009\009local finish = function(result)\n\009\009\009Handy.UI.state_panel.update(key, false)\n\009\009\009return result\n\009\009end\n\n\009\009-----\n\n\009\009if Handy.presets_switch.use(key) then\n\009\009\009return finish(true)\n\009\009end\n\n\009\009if Handy.misc_controls.use(key, false) then\n\009\009\009return finish(true)\n\009\009end\n\n\009\009if Handy.speed_multiplier.use(key) or Handy.nopeus_interaction.use(key) or Handy.animation_skip.use(key) then\n\009\009\009return finish(true)\n\009\009end\n\n\009\009if G.STAGE == G.STAGES.RUN and not G.SETTINGS.paused and not G.OVERLAY_MENU then\n\009\009\009Handy.insta_actions.use_alt(key)\n\009\009\009Handy.move_highlight.use(key)\n\009\009\009Handy.regular_keybinds.use(key)\n\009\009\009Handy.insta_highlight_entire_f_hand.use(key)\n\009\009\009Handy.deselect_hand.use(key)\n\009\009\009Handy.dangerous_actions.use(key, false)\n\009\009else\n\009\009\009Handy.regular_keybinds.use(key)\n\009\009end\n\n\009\009return finish(false)\n\009end,\n\009process_gamepad_button = function(joystick, button, released)\n\009\009Handy.controller.update_device_type({ gamepad = true })\n\n\009\009-----\n\n\009\009if not Handy.is_mod_active() then\n\009\009\009return false\n\009\009end\n\009\009if Handy.controller.is_debugplus_console_opened() then\n\009\009\009return false\n\009\009end\n\009\009if not released and Handy.controller.process_bind(button, { gamepad = true }) then\n\009\009\009return true\n\009\009end\n\009\009if button == \"back\" or G.CONTROLLER.text_input_hook or not Handy.is_mod_active() then\n\009\009\009return false\n\009\009end\n\009\009if Handy.controller.prevent_if_debugplus(button, released) then\n\009\009\009return false\n\009\009end\n\n\009\009local finish = function(result)\n\009\009\009Handy.UI.state_panel.update(button, released)\n\009\009\009return result\n\009\009end\n\n\009\009-----\n\n\009\009if not released and Handy.presets_switch.use(button) then\n\009\009\009return finish(true)\n\009\009end\n\n\009\009if Handy.misc_controls.use(button, released) then\n\009\009\009return finish(true)\n\009\009end\n\n\009\009if not released then\n\009\009\009if\n\009\009\009\009Handy.speed_multiplier.use(key)\n\009\009\009\009or Handy.nopeus_interaction.use(key)\n\009\009\009\009or Handy.animation_skip.use(key)\n\009\009\009then\n\009\009\009\009return finish(true)\n\009\009\009end\n\009\009end\n\n\009\009if G.STAGE == G.STAGES.RUN and not G.SETTINGS.paused and not G.OVERLAY_MENU then\n\009\009\009if not released then\n\009\009\009\009-- (A) corresponds to vanilla card selection and dragging\n\009\009\009\009if button ~= \"a\" then\n\009\009\009\009\009Handy.insta_highlight.use_on_hovered(key)\n\009\009\009\009end\n\009\009\009end\n\009\009\009if Handy.controller.is_triggered(released) then\n\009\009\009\009local _ = false\n\009\009\009\009\009or Handy.insta_actions.use_alt(button)\n\009\009\009\009\009-- or Handy.move_highlight.use(key)\n\009\009\009\009\009or Handy.regular_keybinds.use(button)\n\009\009\009\009\009or Handy.insta_highlight_entire_f_hand.use(button)\n\009\009\009\009\009or Handy.deselect_hand.use(button)\n\009\009\009end\n\n\009\009\009Handy.dangerous_actions.toggle_queue(button, released)\n\009\009\009Handy.dangerous_actions.use(button, released)\n\009\009else\n\009\009\009if Handy.controller.is_triggered(released) then\n\009\009\009\009Handy.regular_keybinds.use(button)\n\009\009\009end\n\009\009end\n\n\009\009Handy.UI.state_panel.update(button, released)\n\n\009\009return false\n\009end,\n\009process_gamepad_axis = function(joystick, axis, value)\n\009\009Handy.controller.update_device_type({ gamepad = true })\n\009\009return false\n\009end,\n\009process_card_click = function(card)\n\009\009if not Handy.is_mod_active() then\n\009\009\009return false\n\009\009end\n\009\009if Handy.controller.is_debugplus_console_opened() then\n\009\009\009return false\n\009\009end\n\009\009if G.STAGE == G.STAGES.RUN and not G.SETTINGS.paused and not G.OVERLAY_MENU then\n\009\009\009Handy.last_clicked_card = card\n\009\009\009Handy.last_clicked_area = card.area\n\009\009\009if Handy.insta_actions.use(card) or Handy.dangerous_actions.use_click(card) then\n\009\009\009\009return true\n\009\009\009end\n\009\009end\n\009\009return false\n\009end,\n\009process_card_hover = function(card)\n\009\009if not Handy.is_mod_active() then\n\009\009\009return false\n\009\009end\n\009\009if Handy.controller.is_debugplus_console_opened() then\n\009\009\009return false\n\009\009end\n\009\009if G.STAGE == G.STAGES.RUN and not G.SETTINGS.paused and not G.OVERLAY_MENU then\n\009\009\009Handy.last_hovered_card = card\n\009\009\009Handy.last_hovered_area = card.area\n\009\009\009if Handy.insta_highlight.use(card) or Handy.dangerous_actions.use_hover(card) then\n\009\009\009\009return true\n\009\009\009end\n\009\009end\n\009\009return false\n\009end,\n\n\009process_tag_click = function(tag)\n\009\009if not Handy.is_mod_active() then\n\009\009\009return false\n\009\009end\n\009\009if Handy.controller.is_debugplus_console_opened() then\n\009\009\009return false\n\009\009end\n\009\009if G.STAGE == G.STAGES.RUN and not G.SETTINGS.paused and not G.OVERLAY_MENU then\n\009\009\009if Handy.dangerous_actions.use_tag_click(tag) then\n\009\009\009\009return true\n\009\009\009end\n\009\009end\n\009\009return false\n\009end,\n\n\009process_update = function(dt)\n\009\009Handy.controller.update_device_type()\n\009\009Handy.controller.update_is_console_opened()\n\n\009\009for mod_module_key, mod_module in pairs(Handy.modules) do\n\009\009\009if mod_module.update then\n\009\009\009\009mod_module.update(dt)\n\009\009\009end\n\009\009end\n\n\009\009if Handy.last_clicked_card and Handy.last_clicked_card.REMOVED then\n\009\009\009Handy.last_clicked_card = nil\n\009\009\009Handy.last_clicked_area = nil\n\009\009end\n\n\009\009if Handy.last_hovered_card and Handy.last_hovered_card.REMOVED then\n\009\009\009Handy.last_hovered_card = nil\n\009\009\009Handy.last_hovered_area = nil\n\009\009end\n\n\009\009for key, button in pairs(Handy.controller.gamepad_patched_buttons) do\n\009\009\009if button.node.REMOVED then\n\009\009\009\009Handy.controller.gamepad_patched_buttons[key] = nil\n\009\009\009end\n\009\009end\n\n\009\009Handy.UI.update(dt)\n\009end,\n\n\009on_settings_save = function()\n\009\009Handy.UI.show_options_button = not SMODS or not Handy.cc.hide_options_button.enabled\n\009\009Handy.nopeus_interaction.change(0)\n\009\009Handy.animation_skip.change(0)\n\009\009Handy.speed_multiplier.change(0)\n\009end,\n}\n\nlocal love_update_ref = love.update\nfunction love.update(dt, ...)\n\009love_update_ref(dt, ...)\n\009Handy.controller.process_update(dt)\nend\n\nlocal wheel_moved_ref = love.wheelmoved or function() end\nfunction love.wheelmoved(x, y)\n\009wheel_moved_ref(x, y)\n\009Handy.controller.process_wheel(y > 0 and 1 or 2)\nend\n\nlocal controller_button_press_ref = Controller.button_press\nfunction Controller:button_press(button, ...)\n\009if Handy.controller.process_gamepad_button(self.GAMEPAD.object, button, false) then\n\009\009return\n\009end\n\009return controller_button_press_ref(self, button, ...)\nend\n\nlocal controller_button_release_ref = Controller.button_release\nfunction Controller:button_release(button, ...)\n\009if Handy.controller.process_gamepad_button(self.GAMEPAD.object, button, true) then\n\009\009return\n\009end\n\009return controller_button_release_ref(self, button, ...)\nend\n\nlocal controller_update_axis_ref = Controller.update_axis\nfunction Controller:update_axis(...)\n\009local axis_interpretation = controller_update_axis_ref(self, ...)\n\009if axis_interpretation == \"axis_cursor\" then\n\009\009Handy.controller.cancel_bind()\n\009end\n\009return axis_interpretation\nend\n\nlocal create_button_binding_pip_ref = create_button_binding_pip\nfunction create_button_binding_pip(args, ...)\n\009if not args or not args.button then\n\009\009return {\n\009\009\009n = G.UIT.ROOT,\n\009\009\009config = { align = \"cm\", colour = G.C.CLEAR },\n\009\009\009nodes = {\n\009\009\009\009{ n = G.UIT.O, config = { object = Moveable() } },\n\009\009\009},\n\009\009}\n\009end\n\009return create_button_binding_pip_ref(args, ...)\nend\n",["display"]="modules/controller.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/presets",["source"]="Handy.presets = {\n\009examples = {\n\009\009default = {\n\009\009\009config = Handy.utils.table_merge({}, Handy.config.default),\n\009\009\009key = \"default\",\n\009\009},\n\009\009better_mouse_and_gamepad = {\n\009\009\009config = {\n\009\009\009\009insta_highlight = {\n\009\009\009\009\009key_1 = \"Right Mouse\",\n\009\009\009\009\009key_2 = \"None\",\n\009\009\009\009\009key_1_gamepad = \"(B)\",\n\009\009\009\009\009key_2_gamepad = \"None\",\n\n\009\009\009\009\009allow_deselect = {\n\009\009\009\009\009\009enabled = false,\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009\009regular_keybinds = {\n\009\009\009\009\009enabled = true,\n\009\009\009\009\009play = {\n\009\009\009\009\009\009key_1 = \"Wheel Up\",\n\009\009\009\009\009\009key_2 = \"None\",\n\009\009\009\009\009},\n\009\009\009\009\009discard = {\n\009\009\009\009\009\009key_1 = \"Wheel Down\",\n\009\009\009\009\009\009key_2 = \"None\",\n\009\009\009\009\009},\n\009\009\009\009\009sort_by_rank = {\n\009\009\009\009\009\009key_1 = \"Mouse 5\",\n\009\009\009\009\009\009key_2 = \"None\",\n\009\009\009\009\009\009key_1_gamepad = \"Right Bumper\",\n\009\009\009\009\009\009key_2_gamepad = \"None\",\n\009\009\009\009\009},\n\009\009\009\009\009sort_by_suit = {\n\009\009\009\009\009\009key_1 = \"Mouse 4\",\n\009\009\009\009\009\009key_2 = \"None\",\n\009\009\009\009\009\009key_1_gamepad = \"Left Bumper\",\n\009\009\009\009\009\009key_2_gamepad = \"None\",\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009\009deselect_hand = {\n\009\009\009\009\009enabled = true,\n\009\009\009\009\009key_1 = \"Right Mouse\",\n\009\009\009\009\009key_2 = \"None\",\n\009\009\009\009\009key_1_gamepad = \"(B)\",\n\009\009\009\009\009key_2_gamepad = \"None\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009key = \"better_mouse_and_gamepad\",\n\009\009},\n\009},\n\n\009default = {\n\009\009user = {\n\009\009\009[1] = {\n\009\009\009\009config = nil,\n\009\009\009\009key = 1,\n\009\009\009\009name = \"Preset 1\",\n\009\009\009\009enabled = true,\n\009\009\009},\n\009\009\009[2] = {\n\009\009\009\009config = nil,\n\009\009\009\009key = 2,\n\009\009\009\009name = \"Preset 2\",\n\009\009\009\009enabled = true,\n\009\009\009},\n\009\009\009[3] = {\n\009\009\009\009config = nil,\n\009\009\009\009key = 3,\n\009\009\009\009name = \"Preset 3\",\n\009\009\009\009enabled = true,\n\009\009\009},\n\009\009},\n\009\009selected = -1,\n\009},\n\009current = {},\n\n\009save = function()\n\009\009love.filesystem.createDirectory(\"config\")\n\009\009local serialized = \"return \" .. Handy.utils.serialize(Handy.presets.current)\n\009\009love.filesystem.write(\"config/Handy_Presets.jkr\", serialized)\n\009end,\n\009load = function()\n\009\009Handy.presets.current = Handy.utils.table_merge({}, Handy.presets.default)\n\009\009local lovely_mod_presets = get_compressed(\"config/Handy_Presets.jkr\")\n\009\009if lovely_mod_presets then\n\009\009\009Handy.presets.current = Handy.utils.table_merge(Handy.presets.current, STR_UNPACK(lovely_mod_presets))\n\009\009end\n\009end,\n\n\009save_index = function(index, options)\n\009\009local preset_to_save = Handy.presets.current.user[index]\n\009\009if not preset_to_save then\n\009\009\009return\n\009\009end\n\n\009\009options = options or {}\n\009\009if options.enabled ~= nil then\n\009\009\009preset_to_save.enabled = not not options.enabled\n\009\009end\n\009\009if options.name ~= nil then\n\009\009\009preset_to_save.name = options.name or \"\"\n\009\009end\n\009\009if options.apply then\n\009\009\009preset_to_save.config = Handy.utils.table_merge({}, Handy.config.current)\n\009\009\009Handy.presets.apply(preset_to_save, true)\n\009\009end\n\009end,\n\009clear_index = function(index)\n\009\009local preset_to_save = Handy.presets.current.user[index]\n\009\009if not preset_to_save then\n\009\009\009return\n\009\009end\n\009\009preset_to_save.config = nil\n\009\009if Handy.presets.current.selected == index then\n\009\009\009Handy.presets.current.selected = -1\n\009\009end\n\009\009Handy.presets.save()\n\009end,\n\009apply_index = function(index, no_save_config)\n\009\009return Handy.presets.apply(Handy.presets.current.user[index], no_save_config)\n\009end,\n\009apply_example = function(key, no_save_config)\n\009\009return Handy.presets.apply(Handy.presets.examples[key], no_save_config, true)\n\009end,\n\009apply = function(preset, no_save_config, no_change_selected)\n\009\009local config_to_apply = Handy.utils.table_merge({}, preset.config or {})\n\n\009\009-- Keep mod enabled state\n\009\009config_to_apply.handy = nil\n\009\009-- Keep presets state and keybinds\n\009\009config_to_apply.presets = nil\n\009\009-- Keep hide in menu button value\n\009\009config_to_apply.hide_in_menu = nil\n\009\009config_to_apply.hide_options_button = nil\n\009\009-- Keep notifications level\n\009\009config_to_apply.notifications_level = nil\n\009\009-- Keep current device setting\n\009\009config_to_apply.current_device = nil\n\009\009-- Keep controller sensivity (sensitivity, you stupid idiot)\n\009\009config_to_apply.controller_sensivity = nil\n\009\009-- Displaying option cycle in settings for:\n\009\009--- Speed multiplier\n\009\009if config_to_apply.speed_multiplier then\n\009\009\009config_to_apply.speed_multiplier.settings_toggle = nil\n\009\009end\n\009\009--- Animation skip\n\009\009if config_to_apply.animation_skip then\n\009\009\009config_to_apply.animation_skip.settings_toggle = nil\n\009\009end\n\009\009-- Bad idea\n\009\009config_to_apply.__empty = nil\n\n\009\009if not no_save_config then\n\009\009\009Handy.config.current =\n\009\009\009\009Handy.utils.table_merge({}, Handy.config.default, Handy.config.current, config_to_apply)\n\009\009\009Handy.cc = Handy.config.current\n\009\009\009Handy.config.save()\n\009\009end\n\n\009\009if not no_change_selected then\n\009\009\009Handy.presets.current.selected = preset.key or -1\n\009\009end\n\009\009Handy.presets.save()\n\009end,\n}\n\nHandy.presets.load()\n",["display"]="modules/presets.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/ui",["source"]="local colours = {\n\009TEXT = HEX(\"FFFFFF\"),\n\009BLACK = HEX(\"000000\"),\n\009RED = HEX(\"FF0000\"),\n\n\009DYN_BASE_APLHA = {\n\009\009CONTAINER = 0.7,\n\n\009\009TEXT = 1,\n\009\009TEXT_DANGEROUS = 1,\n\009},\n\n\009DYN = {\n\009\009CONTAINER = HEX(\"000000\"),\n\n\009\009TEXT = HEX(\"FFFFFF\"),\n\009\009TEXT_DANGEROUS = HEX(\"FFEEEE\"),\n\009},\n}\nlocal localization_colours = {\n\009handy_secondary = HEX(\"BBBBBB\"),\n}\n\nHandy.UI = {\n\009show_options_button = true,\n\009counter = 2,\n\009max_counter = 1.4,\n\009fade_part = 0.5,\n\n\009C = colours,\n\009LOC_COLOURS = localization_colours,\n\n\009search_input_value = \"\",\n\009config_tab_index = 1,\n\009keybinds_page = 1,\n\009quick_page = 1,\n\n\009update = function(dt, force)\n\009\009local old_counter = Handy.UI.counter\n\009\009if Handy.UI.state_panel.current_state.hold then\n\009\009\009Handy.UI.counter = 0\n\009\009elseif Handy.UI.counter < Handy.UI.max_counter then\n\009\009\009Handy.UI.counter = Handy.UI.counter + dt\n\009\009end\n\009\009if force or old_counter ~= Handy.UI.counter then\n\009\009\009local multiplier = math.min(1, math.max(0, (Handy.UI.max_counter - Handy.UI.counter) / Handy.UI.fade_part))\n\009\009\009for key, color in pairs(Handy.UI.C.DYN) do\n\009\009\009\009color[4] = (Handy.UI.C.DYN_BASE_APLHA[key] or 1) * multiplier\n\009\009\009end\n\009\009end\n\009end,\n\009init = function()\n\009\009Handy.UI.counter = Handy.UI.max_counter\n\009\009Handy.UI.state_panel.emplace()\n\009\009Handy.UI.update(0, true)\n\009end,\n}\n\nlocal loc_colour_ref = loc_colour\nfunction loc_colour(_c, _default, ...)\n\009return Handy.UI.LOC_COLOURS[_c] or loc_colour_ref(_c, _default, ...)\nend\n\nrequire(\"handy/ui/parts\")\nrequire(\"handy/ui/config_dictionary\")\nrequire(\"handy/ui/state_panel\")\nrequire(\"handy/ui/functions\")\nrequire(\"handy/ui/config_tabs\")\nrequire(\"handy/ui/config\")\n",["display"]="modules/ui/index.lua",["before"]="main.lua"},{["mod"]="HandyBalatro",["id"]="Handy",["name"]="handy/ui/config_dictionary",["source"]="local keyw = {\n\009toggle = \"enable disable toggle\",\n\009configs = \"features configs settings\",\n\009fast_hand_select = \"fast quick swipe drag mobile like hover hand cards selection selecting highlightning\",\n\009fast_hand_deselect = \"fast quick swipe drag mobile like hover hand cards deselection deselecting unhighlightning\",\n\009regular_keybinds = \"regular vanilla game common keybinds buttons actions\",\n\009play_hand = \"play hand\",\n\009discard_hand = \"discard hand\",\n\009sort_hand = \"sorting sorted hand cards by\",\n\009reroll_shop = \"reroll shop one more\",\n\009leave_shop = \"leave shop go next\",\n\009skip_blind = \"skip blind select skip tag\",\n\009select_blind = \"select blind new round\",\n\009reroll_boss = \"reroll boss\",\n\009run_info = \"run info menus screen\",\n\009view_deck = \"view deck menus screen\",\n\009deck_preview = \"view show display deck preview menus screen panel popup\",\n\009cash_out = \"cash out cashout get me out round shop\",\n\009skip_booster = \"booster pack boosterpack skip\",\n\009move_highlight = \"move shuffle reorder highlights selected selection cards consumables jokers\",\n\009buy = \"buy cards vouchers consumables consumeables tarots planets spectrals boosters packs shop\",\n\009sell = \"sell cards vouchers consumables consumeables tarots planets spectrals boosters packs\",\n\009use = \"use open redeem cards vouchers consumables consumeables tarots planets spectrals boosters packs\",\n\009speed_multiplier = \"game speed multiplier increase decrease change adjust acceleration accelerate more faster speed up\",\n\009animation_skip = \"game animations skip instant scoring max speed no again faster accelerate\",\n\009nopeus_interaction = \"interaction nopeus fast forward fast-forward\",\n\009scoring_hold = \"scoring hold game speed animations pause hold after scoring wait before end of round\",\n\009presets = \"presets settings configs profiles load set apply\",\n\009unsafe_control = \"dangerous unsafe\",\n}\n\nlocal dictionary = {\n\009handy = {\n\009\009loc_key = \"handy\",\n\009\009keywords = {\n\009\009\009keyw.toggle,\n\009\009\009\"all mod everything handy\",\n\009\009\009keyw.configs,\n\009\009},\n\009\009order = 1,\n\009\009checkbox = function(optio