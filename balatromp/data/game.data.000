ode_use_last_interaction.keybind(),\n\009\009}\n\009elseif page == 3 then\n\009\009result = {\n\009\009\009Handy.UI.PARTS.create_module_section(\"gamespeed\"),\n\009\009\009Handy.UI.CD.speed_multiplier.keybind(),\n\009\009\009Handy.UI.CD.speed_multiplier_multiply.keybind(),\n\009\009\009Handy.UI.CD.speed_multiplier_divide.keybind(),\n\009\009\009Handy.UI.PARTS.create_module_section(\"animations\"),\n\009\009\009Handy.UI.CD.animation_skip.keybind(),\n\009\009\009Handy.UI.CD.animation_skip_increase.keybind(),\n\009\009\009Handy.UI.CD.animation_skip_decrease.keybind(),\n\009\009\009Handy.UI.CD.nopeus_interaction.keybind(),\n\009\009\009Handy.UI.CD.nopeus_interaction_increase.keybind(),\n\009\009\009Handy.UI.CD.nopeus_interaction_decrease.keybind(),\n\009\009\009Handy.UI.CD.scoring_hold.keybind(),\n\009\009}\n\009elseif page == 4 then\n\009\009result = {\n\009\009\009Handy.UI.PARTS.create_module_section(\"highlight_movement\"),\n\009\009\009Handy.UI.CD.move_highlight_one_left.keybind(),\n\009\009\009Handy.UI.CD.move_highlight_one_right.keybind(),\n\009\009\009Handy.UI.CD.move_highlight_move_card.keybind(),\n\009\009\009Handy.UI.CD.move_highlight_to_end.keybind(),\n\009\009\009Handy.UI.PARTS.create_module_section(\"presets\"),\n\009\009\009Handy.UI.CD.presets_load_1.keybind(),\n\009\009\009Handy.UI.CD.presets_load_2.keybind(),\n\009\009\009Handy.UI.CD.presets_load_3.keybind(),\n\009\009\009Handy.UI.CD.presets_load_next.keybind(),\n\009\009\009Handy.UI.PARTS.create_module_section(\"dangerous_actions\"),\n\009\009\009Handy.UI.CD.immediate_buy_and_sell.keybind(),\n\009\009\009Handy.UI.CD.sell_all_same_modifier.keybind(),\n\009\009\009Handy.UI.CD.sell_all_modifier.keybind(),\n\009\009\009Handy.UI.CD.remove_modifier.keybind(),\n\009\009}\n\009elseif page == 5 then\n\009\009result = {\n\009\009\009Handy.UI.PARTS.create_module_section(\"misc\"),\n\009\009\009Handy.UI.CD.misc_open_mod_settings.keybind(),\n\009\009\009Handy.UI.CD.misc_save_run.keybind(),\n\009\009\009Handy.UI.CD.