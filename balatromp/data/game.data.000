nsert(but_UI_label, {n=G.UIT.R, config={align = \"cm\", padding = 0, minw = args.minw, maxw = args.maxw}, nodes={\n    {n=G.UIT.T, config={ref_table = args.dynamic_label, ref_value = 'text', scale = args.scale, colour = args.text_colour, shadow = args.shadow, focus_args = button_pip and args.focus_args or nil, func = button_pip,}}\n  }})\nend\n",["indent"]=true},{["mod"]="Cartomancer",["id"]="Cartomancer",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="if self.config.type == 'joker' or self.config.type == 'title_2' then",["position"]="at",["payload"]="if self == G.jokers and G.jokers.cart_jokers_expanded then\n    local align_cards = Cartomancer.expand_G_jokers()\n\n    -- This should work fine without cryptid. But because cryptid's patch is priority=0, it has to be this way\n    if not G.GAME.modifiers.cry_conveyor then \n        table.sort(self.cards, function (a, b) return a.T.x + a.T.w/2 - 100*(a.pinned and a.sort_id or 0) < b.T.x + b.T.w/2 - 100*(b.pinned and b.sort_id or 0) end)\n    end\n    \n    if align_cards then\n        G.jokers:hard_set_cards()\n    end\nelseif self.config.type == 'joker' or self.config.type == 'title_2' then",["indent"]=true},{["mod"]="Cartomancer",["id"]="Cartomancer",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if not self.states.visible then return end",["position"]="after",["payload"]="if self.VT.x < -3 or self.VT.x > G.TILE_W + 2.5 then return end",["indent"]=true},{["mod"]="Cartomancer",["id"]="Cartomancer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.B, config={w=startval,h=args.h, r = 0.1, colour = args.colour, ref_table = args, refresh_movement = true}},",["position"]="at",["payload"]="{n=G.UIT.B, config={id = args.id, w=startval,h=args.h, r = 0.1, colour = args.colour, ref_table = args, refresh_movement = true}},\n",["indent"]=true},{["mod"]="Cartomancer",["id"]="Cartomancer",["k"]="regex",["t"]={"functions/UI_definitions.lua"},["pattern"]="func = button_pip,",["position"]="after",["payload"]="vert = args.vert,"},{["mod"]="Cartomancer",["id"]="Cartomancer",["k"]="regex",["t"]={"cardarea.lua"},["pattern"]="if self\\.config\\.type == \\'hand\\' and [^\\n]*then",["position"]="after",["payload"]="\n        local max_cards_override = (Cartomancer.SETTINGS.dynamic_hand_align and self.config.temp_limit - #self.cards > 5) and math.max(#self.cards, math.min(10, self.config.temp_limit))\n"},{["mod"]="Cartomancer",["id"]="Cartomancer",["k"]="regex",["t"]={"functions/button_callbacks.lua"},["pattern"]="(?<value>math\\.max\\(0\\., math\\.log\\(G\\.ARGS\\.score_intensity\\.earned_score, 5\\)-2\\))",["position"]="at",["payload"]="Cartomancer.get_flames_intensity()"},{["mod"]="Cartomancer",["id"]="Cartomancer",["k"]="regex",["t"]={"functions/misc_functions.lua"},["pattern"]="(?<value>\\(not G\\.video_organ and G\\.STATE == G\\.STATES\\.SPLASH\\) and 0 or AC\\[k\\]\\.vol and v\\.volfunc\\(AC\\[k\\]\\.vol\\) or 0)",["position"]="at",["payload"]="Cartomancer.handle_flames_volume($value)"},{["mod"]="Cartomancer",["id"]="Cartomancer",["k"]="regex",["t"]={"=[SMODS _ \"src/overrides.lua\"]"},["pattern"]="\009\009\009for i = 1\\, \\#SUITS\\[suit_map\\[j\\]\\] do\n\009\009\009\009if SUITS\\[suit_map\\[j\\]\\]\\[i\\] then\n\009\009\009\009\009local greyed\\, _scale = nil\\, 0\\.7\n\009\009\009\009\009if unplayed_only and not \\(\\(SUITS\\[suit_map\\[j\\]\\]\\[i\\]\\.area and SUITS\\[suit_map\\[j\\]\\]\\[i\\]\\.area == G\\.deck\\) or SUITS\\[suit_map\\[j\\]\\]\\[i\\]\\.ability\\.wheel_flipped\\) then\n\009\009\009\009\009\009greyed = true\n\009\009\009\009\009end\n\009\009\009\009\009local copy = copy_card\\(SUITS\\[suit_map\\[j\\]\\]\\[i\\]\\, nil\\, _scale[^\\)\\n]*\\)\n\009\009\009\009\009copy\\.greyed = greyed\n\009\009\009\009\009copy\\.T\\.x = view_deck\\.T\\.x \\+ view_deck\\.T\\.w \\/ 2\n\009\009\009\009\009copy\\.T\\.y = view_deck\\.T\\.y\n\n\009\009\009\009\009copy:hard_set_T\\(\\)\n\009\009\009\009\009view_deck:emplace\\(copy\\)\n\009\009\009\009end\n\009\009\009end",["position"]="at",["payload"]="for i = 1, #SUITS_SORTED[suit_map[j]] do\n  local card_string = SUITS_SORTED[suit_map[j]][i]\n  local card = SUITS[suit_map[j]][card_string]\n\n  card.T.x = view_deck.T.x + view_deck.T.w/2\n  card.T.y = view_deck.T.y\n  card:create_quantity_display()\n\n  card:hard_set_T()\n  view_deck:emplace(card)\nend\n"},{["mod"]="Cartomancer",["id"]="Cartomancer",["k"]="regex",["t"]={"=[SMODS _ \"src/overrides.lua\"]"},["pattern"]="\009\009\009\009for i = 1\\, \\#SUITS\\[visible_suit\\[j\\]\\] do\n\009\009\009\009\009if SUITS\\[visible_suit\\[j\\]\\]\\[i\\] then\n\009\009\009\009\009\009local greyed\\, _scale = nil\\, 0\\.7[\\s\\S]*\n\009\009\009\009\009\009copy:hard_set_T\\(\\)\n\009\009\009\009\009\009view_deck:emplace\\(copy\\)\n\009\009\009\009\009end\n\009\009\009\009end",["position"]="at",["payload"]="-- -- -- -- -- -- -- -- -- --\nfor i = 1, #SUITS_SORTED[visible_suit[j]] do\n  local card_string = SUITS_SORTED[visible_suit[j]][i]\n  local card = SUITS[visible_suit[j]][card_string]\n\n  card.T.x = view_deck.T.x + view_deck.T.w/2\n  card.T.y = view_deck.T.y\n  card:create_quantity_display()\n\n  card:hard_set_T()\n  view_deck:emplace(card)\nend\n-- -- -- -- -- -- -- -- -- --"},{["mod"]="Cartomancer",["id"]="Cartomancer",["k"]="regex",["t"]={"=[SMODS _ \"src/overrides.lua\"]"},["pattern"]="\009\009\009for i = 1\\, \\#SUITS\\[visible_suit\\[j\\]\\] do\n\009\009\009\009if SUITS\\[visible_suit\\[j\\]\\]\\[i\\] then\n\009\009\009\009\009local greyed\\, _scale = nil\\, 0\\.7[\\s\\S]*\n\009\009\009\009\009copy:hard_set_T\\(\\)\n\009\009\009\009\009view_deck:emplace\\(copy\\)\n\009\009\009\009end\n\009\009\009end",["position"]="at",["payload"]="-- -- -- -- -- -- -- -- -- --\nfor i = 1, #SUITS_SORTED[visible_suit[j]] do\n  local card_string = SUITS_SORTED[visible_suit[j]][i]\n  local card = SUITS[visible_suit[j]][card_string]\n\n  card.T.x = view_deck.T.x + view_deck.T.w/2\n  card.T.y = view_deck.T.y\n  card:create_quantity_display()\n\n  card:hard_set_T()\n  view_deck:emplace(card)\nend\n-- -- -- -- -- -- -- -- -- --"},{["mod"]="Cartomancer",["id"]="Cartomancer",["k"]="regex",["t"]={"functions/UI_definitions.lua"},["pattern"]="(?<content>\\{n=G\\.UIT\\.C\\, config=\\{align = \"cm\"\\, minh = args\\.h\\,r = 0\\.1\\, minw = 0\\.8\\, colour = args\\.colour\\,shadow = true\\}\\, nodes=\\{\n[\\t ]*\\{n=G\\.UIT\\.T\\, config=\\{ref_table = args\\, ref_value = 'text'\\, scale = args\\.text_scale\\, colour = G\\.C\\.UI\\.TEXT_LIGHT\\, decimal_places = args\\.decimal_places\\}\\}\n[\\t ]*\\}\\})\\,",["position"]="at",["payload"]="not args.hide_val and $content or nil"},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"card.lua"},["pattern"]="obj:add_to_deck(self, from_debuff)",["position"]="at",["payload"]="if obj:add_to_deck(self, from_debuff) then\n    return\nend\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"card.lua"},["pattern"]="obj:remove_from_deck(self, from_debuff)",["position"]="at",["payload"]="if obj:remove_from_deck(self, from_debuff) then\n    return\nend\n",["indent"]=true},{["mod"]="Nopeus",["id"]="Nopeus",["k"]="pattern",["t"]={"globals.lua"},["pattern"]="GAMESPEED = 1,",["position"]="after",["payload"]="FASTFORWARD = 0,\nSTATUSTEXT = 0,",["indent"]=true},{["mod"]="Nopeus",["id"]="Nopeus",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="func = (function() check_for_unlock{type = 'upgrade_hand', hand = hand, level = G.GAME.hands[hand].level} return true end)",["position"]="before",["payload"]="blockable = false,\nblocking = false,",["indent"]=true},{["mod"]="Nopeus",["id"]="Nopeus",["k"]="pattern",["t"]={"game.lua"},["pattern"]="for k, v in pairs(settings_file) do",["position"]="after",["payload"]="if k == 'FASTFORWARD' then v = math.min(3, v) end",["indent"]=true},{["mod"]="Nopeus",["id"]="Nopeus",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="if location == 'front' or self.config.type == 'deck' then",["position"]="before",["payload"]="self.cards = self.cards or {}",["indent"]=true},{["mod"]="Nopeus",["id"]="Nopeus",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="if (self == G.hand or self == G.deck or self == G.discard or self == G.play) and G.view_deck and G.view_deck[1] and G.view_deck[1].cards then return end",["position"]="after",["payload"]="self.children = self.children or {}",["indent"]=true},{["mod"]="Nopeus",["id"]="Nopeus",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="create_option_cycle({label = localize('b_set_gamespeed'),scale = 0.8, options = {0.5, 1, 2, 4}, opt_callback = 'change_gamespeed', current_option = (G.SETTINGS.GAMESPEED == 0.5 and 1 or G.SETTINGS.GAMESPEED == 4 and 4 or G.SETTINGS.GAMESPEED + 1)}),",["position"]="at",["payload"]="G.UIDEF.nopeus_options(),\nG.UIDEF.nopeus_fastforward_options(),\nG.UIDEF.nopeus_statustext_options(),",["indent"]=true},{["mod"]="Nopeus",["id"]="Nopeus",["k"]="regex",["t"]={"functions/common_events.lua"},["pattern"]="(?<indent>[\\t ]*)func = function\\(\\)\\n            if card then",["position"]="before",["payload"]="blocking = not (G.SETTINGS.GAMESPEED >= 999 and ((to == G.hand and from == G.deck) or (to == G.deck and from == G.hand))), -- Has to be these specific draws only, otherwise it's buggy\n\n",["line_prepend"]="$indent"},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if G.jokers.cards[i] ~= self then",["position"]="at",["payload"]="if G.jokers.cards[i] ~= self and (not G.jokers.cards[i].edition or G.jokers.cards[i].edition.type ~= \"mp_phantom\") then",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"card.lua"},["pattern"]="local chosen_joker = pseudorandom_element(G.jokers.cards, pseudoseed('ankh_choice'))",["position"]="at",["payload"]="local copyable_jokers = {}\n    for i, v in ipairs(G.jokers.cards) do\n      if not G.jokers.cards[i].edition or G.jokers.cards[i].edition.type ~= \"mp_phantom\" then copyable_jokers[#copyable_jokers + 1] = v end\n    end\n    local chosen_joker = pseudorandom_element(copyable_jokers, pseudoseed('ankh_choice'))",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if center.consumeable then",["position"]="before",["payload"]="if old_center ~= center or initial then\n\009self.ability.mp_sticker_balanced = false\n\009if center.config.mp_balanced then\n\009\009self.ability.mp_sticker_balanced = true\n\009end\nend",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if self.ability.name == 'Baseball Card' and self ~= context.other_joker and context.other_joker:is_rarity(\"Uncommon\") then",["position"]="after",["payload"]="if context.other_joker.edition and context.other_joker.edition.type == 'mp_phantom' then return end",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="G.GAME.dollars = G.GAME.dollars + mod",["position"]="after",["payload"]="    if MP and MP.LOBBY and MP.LOBBY.code then\n        if MP.GAME.ce_cache == false then\n            MP.GAME.real_money = tonumber(MP.GAME.real_money) + mod\n            if MP.GAME.real_money ~= G.GAME.dollars then \n                MP.GAME.ce_cache = true\n                Client.send(\"ce_cache\")\n            end\n            MP.GAME.real_money = tostring(MP.GAME.real_money)\n        end\n    end\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"game.lua"},["pattern"]="self.GAME.dollars = self.GAME.starting_params.dollars",["position"]="after",["payload"]="    if MP and MP.LOBBY and MP.LOBBY.code then\n        MP.GAME.real_money = tostring(self.GAME.starting_params.dollars)\n    end\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="if v.pinned then card.pinned = true end",["position"]="after",["payload"]="if v.rental then card:set_rental(true) end",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if v.pinned then _joker.pinned = true end",["position"]="after",["payload"]="if v.rental then _joker:set_rental(true) end",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"game.lua"},["pattern"]="elseif v.value then",["position"]="before",["payload"]="elseif v.id == 'mp_ante_scaling' then\n\009self.GAME.starting_params.ante_scaling = v.value",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="local t =   create_UIBox_generic_options({no_back = from_game_over, no_esc = from_game_over, contents ={",["position"]="at",["payload"]="local t = MP.LOBBY.code and create_UIBox_generic_options({contents ={\n      {n=G.UIT.R, config={align = \"cm\", padding = 0, draw_layer = 1}, nodes={\n        create_tabs(\n        {tabs = {\n            {\n                label = localize('b_new_run'),\n                chosen = true,\n                tab_definition_function = (Galdur and Galdur.config.use) and G.UIDEF.run_setup_option_new_model or G.UIDEF.run_setup_option,\n                tab_definition_function_args = 'New Run'\n            },\n            {\n              label = localize('b_challenges'),\n              tab_definition_function = G.UIDEF.challenges,\n              tab_definition_function_args = from_game_over,\n              chosen = false\n            },\n        },\n        snap_to_nav = true}),\n      }},\n  }}) or create_UIBox_generic_options({no_back = from_game_over, no_esc = from_game_over, contents ={",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="if type == 'New Run' then",["position"]="at",["payload"]="if type == 'New Run' and not MP.LOBBY.code then",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="G.FUNCS.change_stake({to_key = G.viewed_stake})\n  else",["position"]="after",["payload"]="if MP.LOBBY.code then\n    G.viewed_stake = MP.LOBBY.deck.stake\n    G.FUNCS.change_stake({to_key = G.viewed_stake})\n  end",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="if G.SETTINGS.current_setup == 'New Run' then",["position"]="at",["payload"]="if G.SETTINGS.current_setup == 'New Run' or G.SETTINGS.current_setup == 'Multiplayer' then",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="G.GAME.viewed_back = Back(get_deck_from_name(G.PROFILES[G.SETTINGS.profile].MEMORY.deck))",["position"]="at",["payload"]="G.GAME.viewed_back = MP.LOBBY.code and Back(get_deck_from_name(MP.LOBBY.deck.back)) or Back(get_deck_from_name(G.PROFILES[G.SETTINGS.profile].MEMORY.deck))",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="G.GAME.dollars = G.GAME.dollars + mod",["position"]="before",["payload"]="if G.GAME.modifiers.oracle_max then\n\009mod = oracle_apply_dollar_cap(mod, G.GAME.dollars, G.GAME.modifiers.oracle_max + G.GAME.interest_cap)\n\009if oracle_should_show_max(mod, G.GAME.dollars, G.GAME.modifiers.oracle_max + G.GAME.interest_cap) then\n\009\009text = \"MAX\"\n\009\009col = G.C.RED\n\009end\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="        attention_text({\n          text = text..tostring(math.abs(mod)),",["position"]="before",["payload"]="if text == \"MAX\" then\n\009oracle_show_max_alert(dollar_UI)\n\009return\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="-- context.end_of_round calculations",["position"]="before",["payload"]="if MP.is_mp_or_ghost() then\n\009game_over = false\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if game_over then",["position"]="before",["payload"]="if MP.is_mp_or_ghost() then\n\009game_won = nil\n\009G.GAME.won = nil\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.FUNCS.draw_from_discard_to_deck()",["position"]="after",["payload"]="MP.handle_deck_out()\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.STATE = G.STATES.ROUND_EVAL\nG.STATE_COMPLETE = false\n",["position"]="after",["payload"]="local temp_furthest_blind = 0\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.GAME.round_resets.blind_states.Small = 'Defeated'\n",["position"]="after",["payload"]="temp_furthest_blind = G.GAME.round_resets.ante * 10 + 1\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.GAME.round_resets.blind_states.Big = 'Defeated'\n",["position"]="after",["payload"]="temp_furthest_blind = G.GAME.round_resets.ante * 10 + 2\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.GAME.round_resets.blind_states.Boss = 'Defeated'\n",["position"]="after",["payload"]="temp_furthest_blind = (G.GAME.round_resets.ante - 1) * 10 + 3\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if G.GAME.round_resets.temp_handsize then G.hand:change_size(-G.GAME.round_resets.temp_handsize); G.GAME.round_resets.temp_handsize = nil end\n",["position"]="before",["payload"]="if MP.LOBBY.code then\n\009MP.GAME.furthest_blind = (temp_furthest_blind > MP.GAME.furthest_blind) and temp_furthest_blind or MP.GAME.furthest_blind\n\009MP.ACTIONS.set_furthest_blind(MP.GAME.furthest_blind)\n\n\009MP.GAME.pincher_index = MP.GAME.pincher_index + 1\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="function ease_ante(mod)\n",["position"]="after",["payload"]="if MP.is_mp_or_ghost() and not MP.LOBBY.config.disable_live_and_timer_hud then\n\009MP.suppress_next_event = true\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.STATE = G.STATES.ROUND_EVAL\nG.STATE_COMPLETE = false\n",["position"]="after",["payload"]="local mp_nemesis_spoof = false\nif G.GAME.round_resets.blind == G.P_BLINDS.bl_mp_nemesis then\n\009mp_nemesis_spoof = true\n\009if G.GAME.blind_on_deck == \"Small\" then\n\009\009G.GAME.round_resets.blind = G.P_BLINDS.bl_small\n\009elseif G.GAME.blind_on_deck == \"Big\" then\n\009\009G.GAME.round_resets.blind = G.P_BLINDS.bl_big\n\009else\n\009\009mp_nemesis_spoof = false\n\009end\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if G.GAME.round_resets.temp_handsize then G.hand:change_size(-G.GAME.round_resets.temp_handsize); G.GAME.round_resets.temp_handsize = nil end\n",["position"]="before",["payload"]="if mp_nemesis_spoof then\n\009G.GAME.round_resets.blind = G.P_BLINDS.bl_mp_nemesis\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.GAME.round_bonus.discards = 0\n",["position"]="after",["payload"]="local mp_nemesis_spoof = false\nif G.GAME.round_resets.blind == G.P_BLINDS.bl_mp_nemesis then\n\009mp_nemesis_spoof = true\n\009if G.GAME.blind_on_deck == \"Small\" then\n\009\009G.GAME.round_resets.blind = G.P_BLINDS.bl_small\n\009elseif G.GAME.blind_on_deck == \"Big\" then\n\009\009G.GAME.round_resets.blind = G.P_BLINDS.bl_big\n\009else\n\009\009mp_nemesis_spoof = false\n\009end\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.GAME.blind:set_blind(G.GAME.round_resets.blind)\n",["position"]="before",["payload"]="if mp_nemesis_spoof then\n\009G.GAME.round_resets.blind = G.P_BLINDS.bl_mp_nemesis\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="dollars = dollars + G.GAME.interest_amount*math.min(math.floor(G.GAME.dollars/5), G.GAME.interest_cap/5)\n    end",["position"]="after",["payload"]="  if not MP.GAME.comeback_bonus_given then\n\009\009MP.GAME.comeback_bonus_given = true\n\009\009local comeback_bonus\n\n\009\009if MP.LOBBY.config.ruleset == \"ruleset_mp_sandbox\" then\n\009\009    comeback_bonus = 3 * (G.GAME.round_resets.ante - 1)\n\009\009else\n\009\009\009if MP.is_major_league_ruleset() then \n\009\009\009\009comeback_bonus = 4 * MP.GAME.comeback_bonus\n\009\009\009else\n\009\009\009\009if G.GAME.stake >= 6 then\n\009\009\009\009\009comeback_bonus = 2\n\009\009\009\009else\n\009\009\009    \009comeback_bonus = 4\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\n\009\009add_round_eval_row({\n\009\009\009bonus = true,\n\009\009\009name = \"comeback\",\n\009\009\009pitch = pitch,\n\009\009\009dollars = comeback_bonus,\n\009\009})\n\009\009dollars = dollars + comeback_bonus\n\009end",["indent"]=false,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif config.name == 'hands' then",["position"]="before",["payload"]="elseif config.name == \"comeback\" then\n  local bonus\n  if MP.LOBBY.config.ruleset == \"ruleset_mp_sandbox\" then\n\009bonus = G.GAME.round_resets.ante - 1\n  else\n\009bonus = MP.GAME.comeback_bonus\n  end\n  table.insert(left_text, {\n    n = G.UIT.T,\n    config = {\n      text = bonus,\n      scale = 0.8 * scale,\n      colour = G.C.PURPLE,\n      shadow = true,\n      juice = true,\n    },\n  })\n\n  local comeback_money_key = MP.LOBBY.config.ruleset == \"ruleset_mp_sandbox\" and \"k_comeback_money_sandbox\" or \"k_total_lives_lost\"\n  table.insert(left_text, {\n    n = G.UIT.O,\n    config = {\n      object = DynaText({\n        string = {\n          localize(comeback_money_key),\n        },\n        colours = { G.C.UI.TEXT_LIGHT },\n        shadow = true,\n        pop_in = 0,\n        scale = 0.4 * scale,\n        silent = true,\n      }),\n    },\n  })",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if G.GAME.current_round.hands_left > 0 and not G.GAME.modifiers.no_extra_hand_money then",["position"]="at",["payload"]="if G.GAME.current_round.hands_left > 0 and (not G.GAME.modifiers.no_extra_hand_money) and (not MP.is_pvp_boss()) then",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="G.GAME.current_round.hands_left = G.GAME.current_round.hands_left + mod",["position"]="after",["payload"]="if MP.LOBBY.code and MP.is_pvp_boss() and mod > 0 then\n\009\009MP.ACTIONS.play_hand(G.GAME.chips, G.GAME.current_round.hands_left)\n\009end",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"card.lua"},["pattern"]="function Card:sell_card()",["position"]="after",["payload"]="if MP.LOBBY.code then\n  MP.ACTIONS.sold_joker()\nend",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="G.FUNCS.toggle_shop = function(e)",["position"]="after",["payload"]="if MP.LOBBY.code then\n  MP.ACTIONS.spent_last_shop(to_big(MP.GAME.spent_total) - to_big(MP.GAME.spent_before_shop))\nend",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="G.GAME.dollars = G.GAME.dollars + mod",["position"]="after",["payload"]="if MP.LOBBY.code and to_big(mod) < to_big(0) then\n  MP.GAME.spent_total = to_big(MP.GAME.spent_total) + (to_big(mod) * to_big(-1))\nend",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if G.GAME.chips - G.GAME.blind.chips >= 0 then\nadd_round_eval_row({dollars = G.GAME.blind.dollars, name='blind1', pitch = pitch})",["position"]="at",["payload"]="if G.GAME.chips - G.GAME.blind.chips >= 0 or MP.is_pvp_boss() then\nadd_round_eval_row({dollars = G.GAME.blind.dollars, name='blind1', pitch = pitch})",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"game.lua"},["pattern"]="G:save_settings()",["position"]="before",["payload"]="if not saveTable then -- i am 99% sure this is unnecessary but i'm checking it anyway\n\009MP.ApplyBans()\n\009MP.RunLayerHooks(\"on_apply_bans\")\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"=[SMODS _ \"src/game_object.lua\"]"},["pattern"]="for k, v in pairs(G.P_CENTER_POOLS[\"Enhanced\"]) do",["position"]="at",["payload"]="for i, v in ipairs(MP.UTILS.get_spectral_enhancement_pool()) do\n",["indent"]=true,["times"]=3},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="_top_button.config.button = 'select_blind'",["position"]="at",["payload"]="if _top_button.config.button ~= \"mp_toggle_ready\" then\n\009_top_button.config.button = \"select_blind\"\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.T, config={text = localize('b_options'), scale = scale, colour = G.C.UI.TEXT_LIGHT, shadow = true}}\n            }},\n          }}",["position"]="after",["payload"]=",\nMP.LOBBY.code and {n=G.UIT.R, config={id = 'lobby_info_button', align = \"cm\", minh = 1.2, minw = 1.5,padding = 0.05, r = 0.1, hover = true, colour = G.C.BLUE, button = \"lobby_info\", shadow = true}, nodes={\n    {n=G.UIT.R, config={align = \"cm\", padding = 0, maxw = 1.4}, nodes={\n        {n=G.UIT.T, config={text = localize(\"ml_lobby_info\")[1], scale = 1.2*scale, colour = G.C.UI.TEXT_LIGHT, shadow = true}}\n    }},\n    {n=G.UIT.R, config={align = \"cm\", padding = 0, maxw = 1.4}, nodes={\n        {n=G.UIT.T, config={text = localize(\"ml_lobby_info\")[2], scale = 1*scale, colour = G.C.UI.TEXT_LIGHT, shadow = true, focus_args = {button = G.F_GUIDE and 'guide' or 'back', orientation = 'bm'}, func = 'set_button_pip'}}\n    }}\n}} or nil",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.T, config={text = localize('b_options'), scale = scale, colour = G.C.UI.TEXT_LIGHT, shadow = true}}\n            }},\n          }}",["position"]="after",["payload"]=",\n(MP and MP.is_practice_mode and MP.is_practice_mode()) and {n=G.UIT.R, config={id = 'practice_collection_button', align = \"cm\", minh = 1.2, minw = 1.5, padding = 0.05, r = 0.1, hover = true, colour = G.C.SECONDARY_SET.Planet, button = \"your_collection\", shadow = true}, nodes={\n    {n=G.UIT.R, config={align = \"cm\", padding = 0, maxw = 1.4}, nodes={\n        {n=G.UIT.T, config={text = localize(\"k_collection\"), scale = 0.9*scale, colour = G.C.UI.TEXT_LIGHT, shadow = true}}\n    }}\n}} or nil",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="G.HUD_blind:get_UIE_by_ID(\"HUD_blind_name\").states.visible = false",["position"]="before",["payload"]="if MP.is_mp_or_ghost() and MP.is_pvp_boss() then\n    MP.UI.update_blind_HUD(blind, reset, silent)\n    return true\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"=[SMODS _ \"src/utils.lua\"]"},["pattern"]="function SMODS.in_scoring(card, scoring_hand)",["position"]="after",["payload"]="   if not scoring_hand then return false end",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"=[SMODS _ \"src/utils.lua\"]"},["pattern"]="for _, area in ipairs(SMODS.get_card_areas('playing_cards')) do",["position"]="after",["payload"]="if not area.cards then goto continue end",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="function localize(args, misc_cat)",["position"]="after",["payload"]="   if not args then return \"ERROR\" end",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"engine/moveable.lua"},["pattern"]="function Moveable:align_to_major()",["position"]="after",["payload"]="if not self or not self.alignment or not self.role then return end\nif not self.alignment.type or not self.alignment.prev_type then return end\nif not self.alignment.offset or not self.alignment.prev_offset then return end\nif not self.alignment.offset.x or not self.alignment.offset.y then return end\nif not self.alignment.prev_offset.x or not self.alignment.prev_offset.y then return end\nif not self.T then return end\nif not self.Mid or not self.Mid.T or not self.Mid.T.w or not self.Mid.T.h or not self.Mid.T.x or not self.Mid.T.y then return end\nif not self.role.major or not self.role.major.T then return end\nif not self.role.major.T.w or not self.role.major.T.h or not self.role.major.T.x or not self.role.major.T.y then return end\nif not self.T.w or not self.T.h or not self.T.x or not self.T.y then return end\nif not self.role.offset then self.role.offset = {} end",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"card.lua"},["pattern"]="for i = self.ability.extra.min, self.ability.extra.max do",["position"]="before",["payload"]="local mp_collection = self.area.config.type == \"title\" and MP.LOBBY.code\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"card.lua"},["pattern"]="{string = 'rand()', colour = G.C.JOKER_GREY},{string = \"#@\"..(G.deck and G.deck.cards[1] and G.deck.cards[#G.deck.cards].base.id or 11)..(G.deck and G.deck.cards[1] and G.deck.cards[#G.deck.cards].base.suit:sub(1,1) or 'D'), colour = G.C.RED},",["position"]="at",["payload"]="{string = 'rand()', colour = G.C.JOKER_GREY},{string = \"#@\"..(mp_collection and 'NOPE' or G.deck and G.deck.cards[1] and G.deck.cards[#G.deck.cards].base.id or 11)..(mp_collection and '' or G.deck and G.deck.cards[1] and G.deck.cards[#G.deck.cards].base.suit:sub(1,1) or 'D'), colour = G.C.RED},",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"game.lua"},["pattern"]="self.GAME.selected_back_key = selected_back",["position"]="after",["payload"]="G._MP_SET_SEED = args.seed\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"back.lua"},["pattern"]="local card = create_card('Tarot', G.consumeables, nil, nil, nil, nil, v, 'deck')",["position"]="at",["payload"]="local card = create_card(MP.legacy_smallworld() and 'Tarot' or G.P_CENTERS[v].set, G.consumeables, nil, nil, nil, nil, v, 'deck')",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="if G.SETTINGS.paused and key ~= 'to_do' then return math.random() end",["position"]="at",["payload"]="-- disabled by Multiplayer because of voucher rng calls while paused\n-- if G.SETTINGS.paused and key ~= 'to_do' then return math.random() end\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="\009_pool[#_pool + 1] = 'UNAVAILABLE'\nend\n",["position"]="after",["payload"]="if MP.should_exclude_from_pool(v) then\n\009table.remove(_pool) -- remove whatever was just done\n\009if add and not G.GAME.banned_keys[v.key] then\n\009\009_pool_size = _pool_size - 1\n\009end\nend\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="val:set_ability(val.config.center, true)",["position"]="at",["payload"]="local temp_x, temp_y = val.T.x, val.T.y\nval:set_ability(val.config.center, true)\nval.children.back.VT.x, val.children.back.VT.y = temp_x, temp_y\nval.children.center.VT.x, val.children.center.VT.y = temp_x, temp_y\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if (G.GAME.selected_back and G.GAME.selected_back.name == 'b_aij_patchwork') or (G.GAME.selected_sleeve and G.GAME.selected_sleeve == 'sleeve_aij_patchwork') then",["position"]="at",["payload"]="if (G.GAME.selected_back and G.GAME.selected_back.name == 'b_aij_patchwork') or (G.GAME.selected_sleeve and G.GAME.selected_sleeve == 'sleeve_aij_patchwork') or G.GAME.modifiers.b_aij_patchwork then\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="local flags = SMODS.calculate_context({create_shop_card = true, set = v.type})",["position"]="before",["payload"]="args.front = false\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="collectgarbage(\"collect\")",["position"]="before",["payload"]="MP._DEBUG_PANIC_COLLECTS = (MP._DEBUG_PANIC_COLLECTS or 0) + 1\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="local customize = nil",["position"]="after",["payload"]="local unstuck_button = nil\nlocal return_to_lobby = nil\nlocal leave_lobby = nil\n\nif MP.LOBBY.code and G.STATE == G.STATES.MENU then\n    your_collection = UIBox_button({\n        label = { localize(\"b_collection\") },\n        button = \"your_collection\",\n        minw = 5,\n        id = \"your_collection\",\n    })\n    mods = UIBox_button{ id = \"mods_button\", label = {localize('b_mods')}, button = \"mods_button\", minw = 5}\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="main_menu = UIBox_button{ label = {localize('b_main_menu')}, button = \"go_to_menu\", minw = 5}",["position"]="after",["payload"]="unstuck_button = UIBox_button{ label = {localize('b_unstuck')}, button = \"mp_unstuck\", minw = 5}\nreturn_to_lobby = UIBox_button{ label = {localize('b_return_lobby')}, button = \"mp_return_to_lobby\", minw = 5}\nleave_lobby = UIBox_button{ label = {localize('b_leave_lobby')}, button = \"lobby_leave\", minw = 5}",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="G.GAME.seeded and current_seed or nil,\n      restart,\n      main_menu,",["position"]="at",["payload"]="(not MP.LOBBY.code and G.GAME.seeded) and current_seed or nil,\nnot MP.LOBBY.code and restart or nil,\nnot MP.LOBBY.code and main_menu or nil,\nMP.LOBBY.code and unstuck_button or nil,\nMP.LOBBY.code and return_to_lobby or nil,\nMP.LOBBY.code and leave_lobby or nil,",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"engine/controller.lua"},["pattern"]="function Controller:key_press_update(key, dt)",["position"]="before",["payload"]="function Controller:practice_give_card()\n    if not (MP and MP.is_practice_mode()) then return end\n    if MP.LOBBY.code then return end\n    if not (self.hovering.target and self.hovering.target:is(Card)) then return end\n    if not G.OVERLAY_MENU then return end\n    local _card = self.hovering.target\n    if _card.ability.set == 'Joker' and G.jokers then\n        if MP.SP.unlimited_slots or #G.jokers.cards < G.jokers.config.card_limit then\n            if MP.SP.unlimited_slots and #G.jokers.cards >= G.jokers.config.card_limit then\n                G.jokers.config.card_limit = G.jokers.config.card_limit + 1\n            end\n            add_joker(_card.config.center.key)\n            _card:set_sprites(_card.config.center)\n        end\n    end\n    if _card.ability.consumeable and G.consumeables then\n        if MP.SP.unlimited_slots or #G.consumeables.cards < G.consumeables.config.card_limit then\n            if MP.SP.unlimited_slots and #G.consumeables.cards >= G.consumeables.config.card_limit then\n                G.consumeables.config.card_limit = G.consumeables.config.card_limit + 1\n            end\n            add_joker(_card.config.center.key)\n            _card:set_sprites(_card.config.center)\n        end\n    end\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"engine/controller.lua"},["pattern"]="if not _RELEASE_MODE then",["position"]="before",["payload"]="if MP and MP.is_practice_mode() and not MP.LOBBY.code then\n    if key == \"3\" then\n        self:practice_give_card()\n    end\n    if key == \"q\" and MP.SP.edition_cycling then\n        if self.hovering.target and self.hovering.target:is(Card) then\n            local _card = self.hovering.target\n            if _card.ability.set == 'Joker' or _card.playing_card or _card.area then\n                local _edition = {\n                    foil = not _card.edition,\n                    holo = _card.edition and _card.edition.foil,\n                    polychrome = _card.edition and _card.edition.holo,\n                    negative = _card.edition and _card.edition.polychrome,\n                }\n                _card:set_edition(_edition, true, true)\n            end\n        end\n    end\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"main.lua"},["pattern"]="G.CONTROLLER:queue_L_cursor_press(x, y)",["position"]="before",["payload"]="        if MP and MP.is_practice_mode() then\n            G.CONTROLLER:practice_give_card()\n        end\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="G.consumeables.T.y = 0",["position"]="after",["payload"]="if MP.shared then\n  MP.shared.T.x = G.consumeables.T.x + (G.consumeables.T.w / 2)\n  MP.shared.T.y = G.consumeables.T.y + G.consumeables.T.h + 0.4\n  MP.shared:hard_set_T()\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="pitch = pitch + 0.06\n\nif total_cashout_rows > 7 then",["position"]="before",["payload"]="if G.GAME.modifiers.mp_modified_interest_rate and G.GAME.dollars >= G.GAME.modifiers.mp_modified_interest_rate and not G.GAME.modifiers.TRUE_no_interest then\n\009local interest = G.GAME.modifiers.mp_modified_interest_rate\n\009local cap = G.GAME.interest_cap / (5 / interest)\n\009add_round_eval_row({bonus = true, name='mp_modified_interest', pitch = pitch, dollars = G.GAME.interest_amount*math.min(math.floor(G.GAME.dollars/interest), cap/interest)})\n\009pitch = pitch + 0.06\n\009if (not G.GAME.seeded and not G.GAME.challenge) or SMODS.config.seeded_unlocks then\n\009\009if G.GAME.interest_amount*math.min(math.floor(G.GAME.dollars/interest), cap/interest) == G.GAME.interest_amount*G.GAME.interest_cap/interest then \n\009\009\009G.PROFILES[G.SETTINGS.profile].career_stats.c_round_interest_cap_streak = G.PROFILES[G.SETTINGS.profile].career_stats.c_round_interest_cap_streak + 1\n\009\009else\n\009\009\009G.PROFILES[G.SETTINGS.profile].career_stats.c_round_interest_cap_streak = 0\n\009\009end\n\009end\n\009check_for_unlock({type = 'interest_streak'})\n\009dollars = dollars + G.GAME.interest_amount*math.min(math.floor(G.GAME.dollars/interest), cap/interest)\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif config.name == 'hands' then",["position"]="before",["payload"]="elseif config.name == 'mp_modified_interest' then\n\009table.insert(left_text, {n=G.UIT.T, config={text = num_dollars, scale = 0.8*scale, colour = G.C.MONEY, shadow = true, juice = true}})\n\009table.insert(left_text,{n=G.UIT.O, config={object = DynaText({string = {\" \"..localize{type = 'variable', key = 'interest', vars = {G.GAME.interest_amount, G.GAME.modifiers.mp_modified_interest_rate, G.GAME.interest_amount*G.GAME.interest_cap/5}}}, colours = {G.C.UI.TEXT_LIGHT}, shadow = true, pop_in = 0, scale = 0.4*scale, silent = true})}})\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"game.lua"},["pattern"]="self.TIMERS.TOTAL = self.TIMERS.TOTAL + dt*(self.SPEEDFACTOR)",["position"]="before",["payload"]="if MP.TIMER_FORCE_GAMESPEED and (G.STAGE == G.STAGES.RUN and not G.SETTINGS.paused and not G.screenwipe) then\n    self.SPEEDFACTOR = math.max(self.SPEEDFACTOR, 4 + math.max(0, math.abs(G.ACC) - 2))\nend\n",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{\n        label = localize('b_full_deck'),\n        chosen = true,\n        tab_definition_function = G.UIDEF.view_deck\n      },",["position"]="after",["payload"]="MP.LOBBY.code and {\n              label = G.localization.misc.challenge_names[MP.current_ruleset().challenge_deck],\n              tab_definition_function = G.UIDEF.multiplayer_deck,\n            },",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="not is_row and {n=G.UIT.R, config={align = \"cm\", minh = 0.9}, nodes={",["position"]="at",["payload"]="(not (MP.LOBBY.code and G.STAGE == G.STAGES.RUN)) and (not is_row) and {n=G.UIT.R, config={align = \"cm\", minh = 0.9}, nodes={",["indent"]=true,["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="regex",["t"]={"card.lua"},["pattern"]="\\) then self.cost = 0 end",["position"]="after",["payload"]="if self.edition and self.edition.type == 'mp_phantom' then self.sell_cost = 0 end",["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="regex",["t"]={"card.lua"},["pattern"]="--if there is at least one joker(?<pre>[\\s\\S]+?)for k, v in pairs\\(G.jokers.cards\\) do",["position"]="at",["payload"]="--if there is at least one joker$pre local copyable_jokers = {}\n      for i, v in ipairs(G.jokers.cards) do\n        if not G.jokers.cards[i].edition or G.jokers.cards[i].edition.type ~= \"mp_phantom\" then copyable_jokers[#copyable_jokers + 1] = v end\n      end\n      for k, v in pairs(copyable_jokers) do",["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="regex",["t"]={"functions/UI_definitions.lua"},["pattern"]="function G.UIDEF.run_setup_option(?<pre>[\\s\\S]+?)localize\\('b_play_cap'\\)",["position"]="at",["payload"]="function G.UIDEF.run_setup_option$pre MP.LOBBY.code and localize('b_select') or localize('b_play_cap')",["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="regex",["t"]={"functions/state_events.lua"},["pattern"]="function end_round\\(\\)(?<pre>[\\s\\S]+?)func = function\\(\\)",["position"]="after",["payload"]="if MP.handle_duplicate_end() then\n\009return true\nend\nif MP.LOBBY.code then\n\009MP.GAME.round_ended = true\nend\n",["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="regex",["t"]={"game.lua"},["pattern"]="function Game:update_round_eval\\(dt\\)(?<pre>[\\s\\S]+?)if not G.STATE_COMPLETE then",["position"]="at",["payload"]="function Game:update_round_eval(dt)$pre if not G.STATE_COMPLETE and not MP.GAME.prevent_eval then\n        MP.GAME.prevent_eval = true",["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="regex",["t"]={"functions/UI_definitions.lua"},["pattern"]="contents\\.buttons = \\{(?<pre>[\\s\\S]*?)minh = 1\\.75(?<between>[\\s\\S]*?)minh = 1\\.75",["position"]="at",["payload"]="contents.buttons = {$pre minh = (MP.LOBBY.code or (MP.is_practice_mode and MP.is_practice_mode())) and 1.2 or 1.75$between minh = (MP.LOBBY.code or (MP.is_practice_mode and MP.is_practice_mode())) and 1.2 or 1.75",["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="regex",["t"]={"functions/UI_definitions.lua"},["pattern"]="\\{n=G\\.UIT\\.C, config=\\{align = \"cm\", padding = 0\\.05, minw = 1\\.45, minh = 1,",["position"]="at",["payload"]="MP.LOBBY.code and (not MP.LOBBY.config.disable_live_and_timer_hud) and MP.UI.timer_hud() or {n=G.UIT.C, config={align = \"cm\", padding = 0.05, minw = 1.45, minh = 1,",["times"]=1},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="regex",["t"]={"game.lua"},["pattern"]="self\\.jokers = CardArea",["position"]="before",["payload"]="if MP.LOBBY.code then \n\009MP.shared = CardArea(\n\009\0090, CAI.consumeable_H + 0.3,\n\009\009CAI.consumeable_W / 2,\n\009\009CAI.consumeable_H, \n\009\009{card_limit = 0, type = 'joker', highlight_limit = 1, fixed_limit = true})\n\009\009elseif MP.shared then\n\009\009\009MP.shared:remove()\n\009\009\009MP.shared = nil\n\009\009end\n",["times"]=1},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"main.lua"},["pattern"]="function love.load()",["position"]="before",["payload"]="Jen = {}",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"globals.lua"},["pattern"]="EDITION = {1,1,1,1},",["position"]="before",["payload"]="jen_RGB = {0,0,0,1},\njen_RGB_HUE = 0,\npolterworx = {0,0,1,1},",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if G.GAME.blind:press_play() then",["position"]="before",["payload"]="local goob = (jl.fc('j_jen_goob') or {})\nif (goob.ability or {}).active then\n\009local lh = jl.fc('j_jen_goob_lefthand', 'hand')\n\009if lh then\n\009\009local did_discard = false\n\009\009for i = 1, #G.hand.cards do\n\009\009\009local tar = G.hand.cards[i]\n\009\009\009if tar then\n\009\009\009\009if tar == lh then\n\009\009\009\009\009break\n\009\009\009\009else\n\009\009\009\009\009if not tar.highlighted and tar:xpos() < lh:xpos() then\n\009\009\009\009\009\009if not did_discard then\n\009\009\009\009\009\009\009did_discard = true\n\009\009\009\009\009\009\009goob:speak(goob_blurbs.play, G.C.RED)\n\009\009\009\009\009\009end\n\009\009\009\009\009\009draw_card(G.hand, G.discard, 100, 'down', false, tar)\n\009\009\009\009\009\009Q(function()\n\009\009\009\009\009\009\009play_sound('tarot1')\n\009\009\009\009\009\009\009lh:juice_up(0.5, 0.8)\n\009\009\009\009\009\009return true end)\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009end\nend",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if amt > 0 or amt < 0 then",["position"]="at",["payload"]="if to_big(amt) > to_big(0) or to_big(amt) < to_big(0) then",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="function level_up_hand(card, hand, instant, amount)\n    amount = amount or 1",["position"]="at",["payload"]="function level_up_hand(card, hand, instant, amount)\n    if type(amount) == 'nil' then amount = 1 end",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="G.hand_text_area.hand_level.config.colour = G.C.HAND_LEVELS[math.floor(to_number(math.min(7, vals.level)))]",["position"]="at",["payload"]="G.hand_text_area.hand_level.config.colour = G.C.HAND_LEVELS[number_format(vals.level)] or G.C.UI.TEXT_LIGHT --jen was here",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"main.lua"},["pattern"]="G.hand_text_area.hand_level.config.colour = G.C.HAND_LEVELS[type(vals.level) == \"number\" and math.floor(math.min(vals.level, 7)) or math.floor(to_number(math.min(vals.level, 7)))]",["position"]="at",["payload"]="G.hand_text_area.hand_level.config.colour = G.C.HAND_LEVELS[number_format(vals.level)] or G.C.UI.TEXT_LIGHT --jen was here",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="colours = {(to_big(G.GAME.hands[cfg.hand_type].level)==to_big(1) and G.C.UI.TEXT_DARK or G.C.HAND_LEVELS[math.floor(to_number(math.min(7, G.GAME.hands[cfg.hand_type].level)))])}",["position"]="at",["payload"]="colours = {to_big(G.GAME.hands[cfg.hand_type].level) <= to_big(7200) and G.C.HAND_LEVELS['!' .. number_format(to_big(G.GAME.hands[cfg.hand_type].level))] or G.C.HAND_LEVELS[number_format(to_big(G.GAME.hands[cfg.hand_type].level))] or G.C.UI.TEXT_DARK} --jen was here",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.C, config={align = \"cm\", padding = 0.01, r = 0.1, colour = G.C.HAND_LEVELS[math.floor(to_number(math.min(7, G.GAME.hands[handname].level)))], minw = 1.5, outline = 0.8, outline_colour = G.C.WHITE}, nodes={",["position"]="at",["payload"]="{n=G.UIT.C, config={align = \"cm\", padding = 0.01, r = 0.1, colour = G.C.HAND_LEVELS[number_format(G.GAME.hands[handname].level)] or G.C.WHITE, minw = 1.5, outline = 0.8, outline_colour = G.C.WHITE}, nodes={",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"engine/sprite.lua"},["pattern"]="love.graphics.setColor(overlay or G.BRUTE_OVERLAY or G.C.WHITE)",["position"]="at",["payload"]="love.graphics.setColor(self.drawing_colour or overlay or G.BRUTE_OVERLAY or G.C.WHITE)",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"engine/sprite.lua"},["pattern"]="love.graphics.setShader( G.SHADERS[_shader or 'dissolve'],  G.SHADERS[_shader or 'dissolve'])",["position"]="after",["payload"]="love.graphics.setColor(self.drawing_colour or G.C.WHITE)",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"engine/sprite.lua"},["pattern"]="love.graphics.setColor(G.BRUTE_OVERLAY or G.C.WHITE)",["position"]="at",["payload"]="love.graphics.setColor(G.BRUTE_OVERLAY or self.drawing_colour or G.C.WHITE)",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"engine/text.lua"},["pattern"]="self.string = self.strings[self.focused_string].string",["position"]="at",["payload"]="if self.strings and self.focused_string and self.strings[self.focused_string] and self.strings[self.focused_string].string then self.string = self.strings[self.focused_string].string else return end",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="G.screenwipecard = Card(1, 1, G.CARD_W, G.CARD_H, pseudorandom_element(G.P_CARDS), G.P_CENTERS.c_base)",["position"]="before",["payload"]="Jen.initialising = true",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="scoring_hand = final_scoring_hand",["position"]="after",["payload"]="add_crimbo_cards(scoring_hand)",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for _, v in ipairs(SMODS.get_card_areas('playing_cards')) do",["position"]="at",["payload"]="for _, v in ipairs(SMODS.get_card_areas('playing_cards', 'main_scoring')) do",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="SMODS.calculate_main_scoring({cardarea = v, full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands}, v == G.play and scoring_hand or nil)",["position"]="at",["payload"]="SMODS.calculate_main_scoring({cardarea = v.cardarea or v, full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, all_scoring = v.all_scoring}, is_scoring_area(v.cardarea or v) and scoring_hand or nil)",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="highlight_card(scoring_hand[i],(i-0.999)/5,'up')",["position"]="at",["payload"]="if scoring_hand[i].area == G.play then\n  highlight_card(scoring_hand[i],(i-0.999)/5,'up')\nend",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"=[SMODS _ \"src/utils.lua\"]"},["pattern"]="-- TARGET: add your own CardAreas for playing card evaluation",["position"]="after",["payload"]="if next(SMODS.find_card('j_jen_faceless')) and _context == 'main_scoring' then t[#t+1] = {all_scoring = true, cardarea = G.play} end",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"=[SMODS _ \"src/utils.lua\"]"},["pattern"]="local in_scoring = scoring_hand and SMODS.in_scoring(card, context.scoring_hand)",["position"]="at",["payload"]="local in_scoring = context.all_scoring or scoring_hand and SMODS.in_scoring(card, context.scoring_hand)",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="-- TARGET: main scoring on played cards",["position"]="after",["payload"]="if card.edition and card.edition.jen_wee then\n\009card_eval_status_text(card, 'extra', nil, nil, nil, {message = localize('k_upgrade_ex'), colour = G.C.FILTER})\n\009card.ability.wee_upgrades = (card.ability.wee_upgrades or 0) + 1\n\009card.ability.perma_bonus = (card.ability.perma_bonus or 0) + (((card.ability.name or '') == 'Stone Card' or card.config.center.no_rank) and 25 or card:get_id() == 2 and 60 or (card:get_id() * 3))\n\009card_eval_status_text(card, 'extra', nil, nil, nil, {message = number_format(card.ability.perma_bonus), colour = G.C.CHIPS})\nend\nif (((card.config or {}).center or {}).set or '') == 'Colour' and Jen.hv('colour', 1) then\n\009trigger_colour_end_of_round(card)\nend --jen was here",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"card.lua"},["pattern"]="elseif context.individual then",["position"]="after",["payload"]="if context.cardarea == G.play then\n\009if self.edition and self.edition.jen_wee and context.other_card:get_id() == 2 then\n\009\009if ((self.config or {}).center or {}).wee_incompatible or ((self.config or {}).center or {}).key == 'j_cry_weegaming' then\n\009\009\009card_eval_status_text(self, 'extra', nil, nil, nil, {message = 'Can\\'t upgrade!', nopeus_again = true, colour = G.C.RED})\n\009\009else\n\009\009\009self.edition.twos_scored = (self.edition.twos_scored or 0) + (G.GAME.weeck and 3 or 1)\n\009\009\009card_eval_status_text(self, 'extra', nil, nil, nil, {message = localize('k_upgrade_ex') .. \" : \" .. (tostring(100 + (8*self.edition.twos_scored)) .. '%'), colour = G.C.DARK_EDITION})\n\009\009\009self:remove_from_deck()\n\009\009\009Cryptid.misprintize(self, {min = 1 + (0.08 * self.edition.twos_scored),max = 1 + (0.08 * self.edition.twos_scored)})\n\009\009\009self:add_to_deck()\n\009\009end\n\009end\nend",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"engine/ui.lua"},["pattern"]="if self.config.colour[4] > 0.01 then",["position"]="before",["payload"]="if not self.config.colour then self.config.colour = {1, 1, 1, 1} end",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"game.lua"},["pattern"]="last_tarot_planet = nil,",["position"]="before",["payload"]="\009straddle = 0,\n\009relief = 0,\n\009tension = 0,\n\009life = 100,\n\009max_life = 100,\n\009shield = 0,\n\009max_shield = 0,\n\009straddle_disp = 0,\n\009life_disp = 100,\n\009max_life_disp = 100,\n\009shield_disp = 0,\n\009max_shield_disp = 0,\n\009suits = {\n\009},\n\009ranks = {\n\009},\n\009misc_levels = {\n\009},\n",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"game.lua"},["pattern"]="G.GAME.blind:load(saveTable.BLIND)",["position"]="after",["payload"]="Q(function() update_operator_display() return true end)\nfor k, v in pairs(G.GAME.hands) do\n\009manage_level_colour(v.level)\nend\nfor k, v in pairs(G.GAME.suits) do\n\009manage_level_colour(v.level)\nend\nfor k, v in pairs(G.GAME.ranks) do\n\009manage_level_colour(v.level)\nend\nJen:delete_hardbans()",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"game.lua"},["pattern"]="G.hand_text_area = {",["position"]="after",["payload"]="op = self.HUD:get_UIE_by_ID('chipmult_op'),",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="G.ARGS.score_intensity.flames = math.min(1, (G.STAGE == G.STAGES.RUN and 1 or 0)*(\n    (G.ARGS.chip_flames and (G.ARGS.chip_flames.real_intensity + G.ARGS.chip_flames.change) or 0))/10)",["position"]="at",["payload"]="G.ARGS.score_intensity.flames = math.max(0,math.min(1, (G.STAGE == G.STAGES.RUN and 1 or 0)*(\n    (G.ARGS.chip_flames and (G.ARGS.chip_flames.real_intensity + G.ARGS.chip_flames.change) or 0))/10))",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="G.ARGS.score_intensity.organ = G.video_organ or G.ARGS.score_intensity.required_score > 0 and math.max(math.min(0.4, 0.1*math.log(G.ARGS.score_intensity.earned_score/(G.ARGS.score_intensity.required_score+1), 5)),0.) or 0",["position"]="at",["payload"]="if Big.arrow and G.GAME.blind and to_big(G.GAME.blind.chips or 0) > to_big(0) then\n\009local notzero = to_big(G.ARGS.score_intensity.required_score) > to_big(0)\n\009local e_s = math.max(0, to_big(G.ARGS.score_intensity.earned_score))\n\009local r_s = to_big(G.ARGS.score_intensity.required_score+1)\n\009local googol = to_big(1e100)\n\009local requirement5 = to_big(math.max(math.min(1, 0.1*(math.log(e_s/(r_s:arrow(8, googol)), 5))),0.))\n\009local requirement4 = to_big(math.max(math.min(1, 0.1*(math.log(e_s/(r_s:arrow(3, googol)), 5))),0.))\n\009local requirement3 = to_big(math.max(math.min(1, 0.1*(math.log(e_s/(r_s:arrow(2, googol)), 5))),0.))\n\009local requirement2 = to_big(math.max(math.min(1, 0.1*(math.log(e_s/(r_s^googol), 5))),0.))\n\009local requirement1 = math.max(math.min(1, 0.1*math.log(e_s/(r_s*1e100), 5)),0.)\n\009if not G.ARGS.score_intensity.ambientDramatic then G.ARGS.score_intensity.ambientDramatic = 0 end\n\009if not G.ARGS.score_intensity.ambientSinister then G.ARGS.score_intensity.ambientSinister = 0 end\n\009if not G.ARGS.score_intensity.ambientSurreal3 then G.ARGS.score_intensity.ambientSurreal3 = 0 end\n\009if not G.ARGS.score_intensity.ambientSurreal2 then G.ARGS.score_intensity.ambientSurreal2 = 0 end\n\009if not G.ARGS.score_intensity.ambientSurreal1 then G.ARGS.score_intensity.ambientSurreal1 = 0 end\n\009G.ARGS.score_intensity.ambientDramatic = (not dangerous_tension() and notzero) and requirement5:to_number() or 0\n\009G.ARGS.score_intensity.ambientSinister = (not dangerous_tension() and (G.ARGS.score_intensity.ambientDramatic or 0) <= 0.05 and notzero) and requirement4:to_number() or 0\n\009if Jen and type(Jen) == 'table' then\n\009\009Jen.dramatic = dangerous_tension() or G.ARGS.score_intensity.ambientDramatic > 0\n\009\009Jen.sinister = G.ARGS.score_intensity.ambientSinister > 0 or Jen.dramatic\n\009end\n\009G.ARGS.score_intensity.ambientSurreal3 = (not dangerous_tension() and not Jen.dramatic and not Jen.sinister) and requirement3:to_number() or 0\n\009G.ARGS.score_intensity.ambientSurreal2 = ((not dangerous_tension() and not Jen.dramatic and not Jen.sinister) and (G.ARGS.score_intensity.ambientSurreal3 or 0) <= 0.05 and notzero) and requirement2:to_number() or 0\n\009G.ARGS.score_intensity.ambientSurreal1 = ((not dangerous_tension() and not Jen.dramatic and not Jen.sinister) and (G.ARGS.score_intensity.ambientSurreal3 or 0) <= 0.05 and (G.ARGS.score_intensity.ambientSurreal2 or 0) <= 0.05 and notzero) and requirement1 or 0\n\009G.ARGS.score_intensity.organ = not dangerous_tension() and ((G.video_organ or ((G.ARGS.score_intensity.ambientSurreal3 or 0) <= 0.05 and (G.ARGS.score_intensity.ambientSurreal2 or 0) <= 0.05 and (G.ARGS.score_intensity.ambientSurreal1 or 0) <= 0.05 and notzero)) and math.max(math.min(1, 0.1*math.log(G.ARGS.score_intensity.earned_score/(G.ARGS.score_intensity.required_score+1), 5)),0.) or 0) or 0\n\009notzero = nil\n\009e_s = nil\n\009r_s = nil\n\009googol = nil\n\009requirement5 = nil\n\009requirement4 = nil\n\009requirement3 = nil\n\009requirement2 = nil\n\009requirement1 = nil\nelse\n\009Jen.dramatic = dangerous_tension()\n\009Jen.sinister = dangerous_tension()\n\009G.ARGS.score_intensity.organ = G.video_organ or G.ARGS.score_intensity.required_score > 0 and math.max(math.min(0.4, 0.1*math.log(G.ARGS.score_intensity.earned_score/(G.ARGS.score_intensity.required_score+1), 5)),0.) or 0\nend\n",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="G.ARGS.score_intensity.earned_score = all_numbers and math.min(to_number(SMODS.calculate_round_score(true)), 1e300) or 0",["position"]="at",["payload"]="G.ARGS.score_intensity.earned_score = all_numbers and SMODS.calculate_round_score(true) or 0",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="G.ARGS.score_intensity.earned_score = math.min(to_number(G.ARGS.score_intensity.earned_score), 1e300)",["position"]="at",["payload"]="",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="ambientOrgan1 = {volfunc = function(_prev_volume) return _prev_volume*(1 - dt) + dt*0.6*(G.SETTINGS.SOUND.music_volume + 100)/200*(G.ARGS.score_intensity.organ) end},",["position"]="after",["payload"]="\009jen_ambientSurreal1 = {volfunc = function(_prev_volume) return _prev_volume*(1 - dt) + dt*0.6*(G.SETTINGS.SOUND.music_volume + 100)/200*to_number((G.ARGS.score_intensity.ambientSurreal1 or 0) * 1.8) end},\n\009jen_ambientSurreal2 = {volfunc = function(_prev_volume) return _prev_volume*(1 - dt) + dt*0.6*(G.SETTINGS.SOUND.music_volume + 110)/200*to_number((G.ARGS.score_intensity.ambientSurreal2 or 0) * 2) end},\n\009jen_ambientSurreal3 = {volfunc = function(_prev_volume) return _prev_volume*(1 - dt) + dt*0.6*(G.SETTINGS.SOUND.music_volume + 120)/200*to_number((G.ARGS.score_intensity.ambientSurreal3 or 0) * 2.2) end},\n\009jen_ambientSinister = {volfunc = function(_prev_volume) return _prev_volume*(1 - dt) + dt*0.6*(G.SETTINGS.SOUND.music_volume + 135)/200*to_number((G.ARGS.score_intensity.ambientSinister or 0) * 2.4) end},\n\009jen_ambientDramatic = {volfunc = function(_prev_volume) return _prev_volume*(1 - dt) + dt*0.6*(G.SETTINGS.SOUND.music_volume + 135)/200*to_number((G.ARGS.score_intensity.ambientDramatic or 0) * 2.6) end},\n",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.T, config={text = string.rep(localize(\"$\"), blind_choice.config.dollars)..'+', scale = 0.35, colour = disabled and G.C.UI.TEXT_INACTIVE or G.C.MONEY, shadow = not disabled}}",["position"]="at",["payload"]="    {n=G.UIT.T, config={text = (blind_choice.config.dollars > 8 and (localize(\"$\") .. number_format(blind_choice.config.dollars) .. '+') or (string.rep(localize(\"$\"), blind_choice.config.dollars)..'+')), scale = 0.35, colour = disabled and G.C.UI.TEXT_INACTIVE or G.C.MONEY, shadow = not disabled}}\n",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="G.GAME.current_round.dollars_to_be_earned = self.dollars > 0 and (string.rep(localize('$'), self.dollars)..'') or ('')",["position"]="at",["payload"]="    G.GAME.current_round.dollars_to_be_earned = self.dollars > 8 and (localize('$') .. number_format(self.dollars)) or (self.dollars > 0 and (string.rep(localize('$'), self.dollars)) or '')\n",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="if card.area and card.area.config.type == 'joker' then",["position"]="before",["payload"]="if card.area and (card.area == G.consumeables) and card.gc and (card:gc().set == 'Booster' or card:gc().set == 'Voucher') then\n\009local use, sell\n    use = \n    {n=G.UIT.C, config={align = \"tr\"}, nodes={\n      {n=G.UIT.C, config={ref_table = card, align = \"cr\",maxw = 1.25, padding = 0.1, r=0.08, minw = 1.25, minh = 1, hover = true, shadow = true, colour = G.C.UI.BACKGROUND_INACTIVE, one_press = true, button = card:gc().set == 'Voucher' and 'jen_redeemvoucher' or 'jen_openpack', func = card:gc().set == 'Voucher' and 'jen_canredeemvoucher' or 'jen_canopenpack'}, nodes={\n        {n=G.UIT.B, config = {w=0.1,h=0.6}},\n        {n=G.UIT.T, config={text = card:gc().set == 'Voucher' and localize('b_redeem') or localize('b_open'),colour = G.C.UI.TEXT_LIGHT, scale = 0.55, shadow = true}}\n      }}\n    }}\n\009sell = {n=G.UIT.C, config={align = \"br\"}, nodes={\n\009\009{n=G.UIT.C, config={ref_table = card, align = \"cr\",padding = 0.1, r=0.08, minw = 1.25, hover = true, shadow = true, colour = G.C.UI.BACKGROUND_INACTIVE, one_press = true, button = 'sell_card', func = 'can_sell_card'}, nodes={\n\009\009\009{n=G.UIT.B, config = {w=0.1,h=0.6}},\n\009\009\009{n=G.UIT.C, config={align = \"tm\"}, nodes={\n\009\009\009\009{n=G.UIT.R, config={align = \"cm\", maxw = 1.25}, nodes={\n\009\009\009\009{n=G.UIT.T, config={text = localize('b_sell'),colour = G.C.UI.TEXT_LIGHT, scale = 0.4, shadow = true}}\n\009\009\009\009}},\n\009\009\009\009{n=G.UIT.R, config={align = \"cm\"}, nodes={\n\009\009\009\009\009{n=G.UIT.T, config={text = localize('$'),colour = G.C.WHITE, scale = 0.4, shadow = true}},\n\009\009\009\009\009{n=G.UIT.T, config={ref_table = card, ref_value = 'sell_cost_label',colour = G.C.WHITE, scale = 0.55, shadow = true}}\n\009\009\009\009}}\n\009\009\009}}\n\009\009}},\n\009}}\n    local t = {\n      n=G.UIT.ROOT, config = {padding = 0, colour = G.C.CLEAR}, nodes={\n        {n=G.UIT.C, config={padding = 0.15, align = 'cl'}, nodes={\n          {n=G.UIT.R, config={align = 'cl'}, nodes={\n            use,\n\009\009\009sell\n          }},\n        }},\n    }}\n    return t\nend",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"card.lua"},["pattern"]="nominal_chips = self.base.nominal > 0 and self.base.nominal or nil,",["position"]="after",["payload"]="suitstats = G.GAME.suits[self.base.suit],\nrankstats = G.GAME.ranks[self.base.value],\n",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif _c.set == 'Enhanced' then",["position"]="before",["payload"]="if specific_vars.suitstats and specific_vars.suitstats.level > to_big(1) then\n\009localize{type = 'other', key = 'card_suitstats', nodes = desc_nodes, vars = {specific_vars.suitstats.level, specific_vars.suitstats.chips, specific_vars.suitstats.mult, card and localize(card.base.suit, \"suits_plural\"), colours = {\n\009\009\009lvcol(card and card.base.suit or ''),\n\009\009\009G.C.SUITS[card and card.base.suit],\n\009\009}}}\nend\nif specific_vars.rankstats and specific_vars.rankstats.level > to_big(1) then\n\009localize{type = 'other', key = 'card_rankstats', nodes = desc_nodes, vars = {specific_vars.rankstats.level, specific_vars.rankstats.chips, specific_vars.rankstats.mult, card and card.base.value, colours = {\n\009\009\009lvcol(card and card.base.value or ''),\n\009\009\009G.C.FILTER,\n\009\009}}}\nend\n",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif _c.set == 'Booster' then",["position"]="before",["payload"]="if card and card.ability.effect ~= 'Stone Card' and (not card.config.center.no_suit) and (specific_vars and specific_vars.suitstats and specific_vars.suitstats.level > to_big(1)) then\n\009localize{type = 'other', key = 'card_suitstats', nodes = desc_nodes, vars = {specific_vars.suitstats.level, specific_vars.suitstats.chips, specific_vars.suitstats.mult, card and localize(card.base.suit, \"suits_plural\"), colours = {\n\009\009\009lvcol(card and card.base.suit or ''),\n\009\009\009G.C.SUITS[card and card.base.suit],\n\009\009}}}\nend\nif card and card.ability.effect ~= 'Stone Card' and (not card.config.center.no_rank) and (specific_vars and specific_vars.rankstats and specific_vars.rankstats.level > to_big(1)) then\n\009localize{type = 'other', key = 'card_rankstats', nodes = desc_nodes, vars = {specific_vars.rankstats.level, specific_vars.rankstats.chips, specific_vars.rankstats.mult, card and card.base.value, colours = {\n\009\009\009lvcol(card and card.base.value or ''),\n\009\009\009G.C.FILTER,\n\009\009}}}\nend\n",["indent"]=true},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="tab_definition_function = create_UIBox_current_hands,",["position"]="at",["payload"]="tab_definition_function = create_UIBox_current_hands,\n},{\n\009label = localize('b_suits')..\"/\"..localize('b_ranks'),\n\009tab_definition_function = ui_suits_ranks,\n\n",["indent"]=false},{["mod"]="POLTERWORX",["id"]="jen",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="        local chips = card:get_chip_bonus()\n        if chips > 0 then \n            ret.chips = chips\n        end\n\n        local mult = card:get_chip_mult()\n        if mult > 0 then \n            ret.mult = mult\n        end\n",["position"]="at",["payload"]="        local chips = card:get_chip_bonus()\n        if to_big(chips) > to_big(0) then \n            ret.chips = chips\n        end\n\n        local mult = card:get_chip_mult()\n        if to_big(mult) > to_big(0) then