d.handname = '';return true end)\n    }))\n",["position"]="at",["payload"]="G.E_MANAGER:add_event(Event({\n    trigger = 'immediate',\n    func = (function()\n        if G.GAME.current_round.current_hand.handname ~= localize('cry_None', \"poker_hands\") or not G.GAME.hands[\"cry_None\"].visible then\n            G.GAME.current_round.current_hand.handname = ''\n        end\n        return true end)\n    }))\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="    G.E_MANAGER:add_event(Event({\n      trigger = 'immediate',\n      \009func = (function()\n            if G.GAME.current_round.current_hand.handname ~= localize('cry_None', \"poker_hands\") or not G.GAME.hands[\"cry_None\"].visible then\n                G.GAME.current_round.current_hand.handname = ''\n            end\n            return true end)\n      }))\n      delay(0.3)\n",["position"]="at",["payload"]="    G.E_MANAGER:add_event(Event({\n      trigger = 'immediate',\n      \009func = (function()\n            if text ~= \"cry_None\" or not G.GAME.hands[\"cry_None\"].visible then\n                G.GAME.current_round.current_hand.handname = ''\n            end\n            return true end)\n      }))\n      delay(0.3)\ndelay(0.3)\nif not next(SMODS.find_mod(\"Talisman\")) then\n    evaluate_play_after(text, disp_text, poker_hands, scoring_hand, non_loc_disp_text, percent, percent_delta)\nend\nreturn text, disp_text, poker_hands, scoring_hand, non_loc_disp_text, percent, percent_delta\nend\nfunction evaluate_play_after(text, disp_text, poker_hands, scoring_hand, non_loc_disp_text, percent, percent_delta)\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.GAME.hands[text].played = G.GAME.hands[text].played + 1\n",["position"]="at",["payload"]="local hand = (G.GAME.hands[text])\nif not hand then text = \"cry_None\"; disp_text = localize(\"cry_None\", \"poker_hands\") end\nhand = G.GAME.hands[text]\nif text == \"cry_None\" then G.GAME.hands[\"cry_None\"].visible = true end\nhand.played = hand.played + 1\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="G.GAME.hands[hand].level = math.max(0, G.GAME.hands[hand].level + amount)\nG.GAME.hands[hand].mult = math.max(G.GAME.hands[hand].mult + G.GAME.hands[hand].l_mult*amount, 1)\nG.GAME.hands[hand].chips = math.max(G.GAME.hands[hand].chips + G.GAME.hands[hand].l_chips*amount, 1)\n",["position"]="at",["payload"]="G.GAME.hands[hand].level = math.max(0, G.GAME.hands[hand].level + amount)\nG.GAME.hands[hand].mult = G.GAME.hands[hand].mult + G.GAME.hands[hand].l_mult*amount\nG.GAME.hands[hand].chips = G.GAME.hands[hand].chips + G.GAME.hands[hand].l_chips*amount\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if #G.hand.cards < 1 and #G.deck.cards < 1 and #G.play.cards < 1 then\n    end_round()\nend\n",["position"]="at",["payload"]="if #G.hand.cards < 1 and #G.deck.cards < 1 and #G.play.cards < 1 and not G.PROFILES[G.SETTINGS.profile].cry_none then\n    end_round()\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if #G.hand.cards < 1 and #G.deck.cards < 1 then\n    end_round()\nelse\n    save_run()\n    G.CONTROLLER:recall_cardarea_focus('hand')\nend\n",["position"]="at",["payload"]="if #G.hand.cards < 1 and #G.deck.cards < 1 and not G.PROFILES[G.SETTINGS.profile].cry_none then\n    end_round()\nelse\n    save_run()\n    G.CONTROLLER:recall_cardarea_focus('hand')\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.hand.config.card_limit <= 0 and #G.hand.cards == 0 then\n",["position"]="at",["payload"]="G.hand.config.card_limit <= 0 and #G.hand.cards == 0 and not G.PROFILES[G.SETTINGS.profile].cry_none then\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="local text,disp_text = G.FUNCS.get_poker_hand_info(G.hand.highlighted)\n",["position"]="after",["payload"]="if not text or text == \"NULL\" then \n    G.GAME.hands[\"cry_None\"].visible = true\n    text = \"cry_None\" \nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="            if (not G.hand.cards[1]) and G.deck.cards[1] then \n                G.STATE = G.STATES.DRAW_TO_HAND\n                G.STATE_COMPLETE = false\n            else\n",["position"]="at",["payload"]="            if (not G.hand.cards[1]) and G.deck.cards[1] and G.hand.config.card_limit > 0 then \n                G.STATE = G.STATES.DRAW_TO_HAND\n                G.STATE_COMPLETE = false\n            else\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="forced_card.ability.forced_selection = true\n",["position"]="before",["payload"]="if forced_card then\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"blind.lua"},["pattern"]="G.hand:add_to_highlighted(forced_card)\n",["position"]="after",["payload"]="end\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="ability = self.ability,",["position"]="before",["payload"]="shop_voucher = self.shop_voucher,\nshop_cry_bonusvoucher = self.shop_cry_bonusvoucher,\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self.ability = cardTable.ability",["position"]="before",["payload"]="self.shop_voucher = cardTable.shop_voucher\nself.shop_cry_bonusvoucher = cardTable.shop_cry_bonusvoucher\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"card.lua"},["pattern"]="--G.GAME.current_round.voucher = nil",["position"]="after",["payload"]="if self.shop_cry_bonusvoucher then G.GAME.cry_bonusvouchersused[self.shop_cry_bonusvoucher] = true end\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="used_packs = {},",["position"]="after",["payload"]="cry_bonusvouchers = {},\ncry_voucher_stickers = {eternal = false, perishable = false, rental = false, pinned = false, banana = false},\ncry_voucher_edition = {},\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.GAME.current_round.voucher = SMODS.get_next_vouchers()",["position"]="after",["payload"]="G.GAME.current_round.cry_voucher_stickers = Cryptid.next_voucher_stickers()\nG.GAME.current_round.cry_voucher_edition = cry_get_next_voucher_edition() or {}\nG.GAME.current_round.cry_bonusvouchers = {}\nG.GAME.cry_bonusvouchersused = {}\009-- i'm not sure why i'm putting these in two separate tables but it doesn't matter much\nfor i = 1, G.GAME.cry_bonusvouchercount do\n\009G.GAME.current_round.cry_bonusvouchers[i] = SMODS.get_next_vouchers()\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"game.lua"},["pattern"]="self.GAME.current_round.voucher = forced_voucher and {forced_voucher, spawn = {[forced_voucher] = true }} or SMODS.get_next_vouchers()",["position"]="after",["payload"]="G.GAME.current_round.cry_voucher_stickers = Cryptid.next_voucher_stickers()\nG.GAME.current_round.cry_voucher_edition = cry_get_next_voucher_edition() or {}\nfor i = 1, self.GAME.cry_bonusvouchercount do\n\009self.GAME.current_round.cry_bonusvouchers[i] = get_next_voucher_key()\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="            {type = 'Tarot', val = G.GAME.tarot_rate},\n            {type = 'Planet', val = G.GAME.planet_rate},\n",["position"]="at",["payload"]="{type = 'Tarot', val = G.GAME.tarot_rate*(G.GAME.cry_percrate.tarot/100)},\n{type = 'Planet', val = G.GAME.planet_rate*(G.GAME.cry_percrate.planet/100)},\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="            table.insert(rates, { type = v, val = G.GAME[v:lower()..'_rate'] })\n",["position"]="at",["payload"]="local num = G.GAME.cry_percrate and G.GAME.cry_percrate[v:lower()] or 100\ntable.insert(rates, { type = v, val = G.GAME[v:lower()..'_rate'] * ((num or 100) / 100) })\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="total_rate = total_rate + G.GAME[v:lower()..'_rate']\n",["position"]="at",["payload"]="total_rate = total_rate + ( G.GAME[v:lower()..'_rate'] * (G.GAME.cry_percrate[v:lower()]/100) )\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if v.requires then",["position"]="at",["payload"]="if v.requires and _type ~= 'Tier3' then",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"=[SMODS AntePreview \"main.lua\"]"},["pattern"]="local tag = prediction[choice].tag",["position"]="before",["payload"]="if prediction[choice].blind == \"bl_mp_nemesis\" then\n    blind_amt = \"????\"\nend\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"=[SMODS Cryptid \"items/code.lua\"]"},["pattern"]="if G.GAME.USING_CODE then\n\009\009\009\009return\n\009\009\009end",["position"]="before",["payload"]="if MP.LOBBY.code then\n    return\nend\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="local _, boss = pseudorandom_element(eligible_bosses, pseudoseed('boss'))",["position"]="at",["payload"]="local boss = nil\nif MP.should_use_the_order() then\n\009_, boss = pseudorandom_element(eligible_bosses, pseudoseed('boss'..G.GAME.round_resets.ante))\nelse\n\009_, boss = pseudorandom_element(eligible_bosses, pseudoseed('boss'))\nend",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"game.lua"},["pattern"]="for k, v in pairs(self.GAME.pseudorandom) do if v == 0 then self.GAME.pseudorandom[k] = pseudohash(k..self.GAME.pseudorandom.seed) end end",["position"]="before",["payload"]="if self.GAME.pseudorandom.seed:sub(1, 1) ~= \"*\" and MP.should_use_the_order() then self.GAME.pseudorandom.seed = \"*\" .. self.GAME.pseudorandom.seed end",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"game.lua"},["pattern"]="self.GAME.pseudorandom.seed = hash_seed(self.GAME.pseudorandom.seed)",["position"]="before",["payload"]="if self.GAME.pseudorandom.seed:sub(1, 1) ~= \"*\" and MP.should_use_the_order() then self.GAME.pseudorandom.seed = \"*\" .. self.GAME.pseudorandom.seed end",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"card.lua"},["pattern"]="if SMODS.pseudorandom_probability(self, 'halu'..G.GAME.round_resets.ante, 1, self.ability.extra) then",["position"]="at",["payload"]="if SMODS.pseudorandom_probability(self, 'halu'..MP.ante_based(), 1, self.ability.extra) then",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"=[SMODS _ \"src/overrides.lua\"]"},["pattern"]="local poll = pseudorandom(pseudoseed((_key or 'pack_generic')..G.GAME.round_resets.ante))*cume",["position"]="at",["payload"]="local poll = pseudorandom(pseudoseed((_key or 'pack_generic')..MP.ante_based()))*cume",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.deck:shuffle('nr'..G.GAME.round_resets.ante)",["position"]="at",["payload"]="G.deck:shuffle('nr'..MP.order_round_based(true))",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="G.deck:shuffle('cashout'..G.GAME.round_resets.ante)",["position"]="at",["payload"]="G.deck:shuffle('cashout'..MP.order_round_based(true))",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="local polled_rate = pseudorandom(pseudoseed('cdt'..G.GAME.round_resets.ante))*total_rate",["position"]="at",["payload"]="local polled_rate = pseudorandom(pseudoseed('cdt'..MP.ante_based()))*total_rate",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="center = pseudorandom_element(_pool, pseudoseed(_pool_key..'_resample'..it))",["position"]="at",["payload"]="center = pseudorandom_element(_pool, pseudoseed(_pool_key..(MP.should_use_the_order() and '' or ('_resample'..it)) ))\nif MP.should_use_the_order() and it > 1000 then -- fallback\n\009center = pseudorandom_element(_pool, pseudoseed(_pool_key..'_resample'..it))\nend\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if forced_key and not G.GAME.banned_keys[forced_key] then",["position"]="before",["payload"]="local _order_et, _order_per, _order_rent, _order_ed = nil, nil, nil, nil\nif _type == \"Joker\" and not forced_key and MP.should_use_the_order() then\n\009local _pool, _pool_key = get_current_pool(_type, _rarity, legendary, key_append)\n\009forced_key = \"UNAVAILABLE\"\n\009local it = 0\n\009while forced_key == \"UNAVAILABLE\" do\n\009\009_order_et, _order_per, _order_rent, _order_ed = nil, nil, nil, nil\n\009\009-- select stickers based off of rarity\n\009\009if (area == G.pack_cards) or (area == G.shop_jokers) then\n\009\009\009local eternal_perishable_poll = pseudorandom(\"_etper\".._pool_key)\n\n\009\009\009-- block of nonsense\n\009\009\009if G.GAME.modifiers.enable_eternals_in_shop\n\009\009\009and eternal_perishable_poll > 0.7\n\009\009\009and not SMODS.Stickers[\"eternal\"].should_apply then\n\009\009\009\009_order_et = true\n\009\009\009elseif G.GAME.modifiers.enable_perishables_in_shop\n\009\009\009and ((eternal_perishable_poll > 0.4)\n\009\009\009and (eternal_perishable_poll <= 0.7))\n\009\009\009and not SMODS.Stickers[\"perishable\"].should_apply then\n\009\009\009\009_order_per = true\n\009\009\009end\n\009\009\009if G.GAME.modifiers.enable_rentals_in_shop\n\009\009\009and pseudorandom(\"_rent\".._pool_key) > 0.7\n\009\009\009and not SMODS.Stickers[\"rental\"].should_apply then\n\009\009\009\009_order_rent = true\n\009\009\009end\n\009\009end\n\n\009\009local _s_append = \"\"\n\009\009if _order_et or _order_per or _order_rent then\n\009\009\009_s_append = \"_sticker\"\n\009\009end\n\009\009forced_key = pseudorandom_element(_pool, pseudoseed(_pool_key.._s_append))\n\009\009if it > 1000 then -- fallback\n\009\009\009forced_key = pseudorandom_element(_pool, pseudoseed(_pool_key.._s_append..'_resample'..it))\n\009\009end\n\009\009if forced_key ~= \"UNAVAILABLE\" then\n\009\009\009-- breaking news. this mutates the `_pool` (IT'S NOT LOCAL)\n\009\009\009-- so only do it when you're done (IT'S NOT LOCAL)\n\009\009\009-- we'll need to advance the rng queue silently (THE VARIABLE POINTS TO A GLOBAL)\n\009\009\009_order_ed = poll_edition('edi'.._pool_key.._s_append)\n\009\009else\n\009\009\009-- advance said rng queue silently\n\009\009\009pseudorandom(pseudoseed('edi'.._pool_key.._s_append))\n\009\009end\n\009\009it = it + 1\n\009end\nend\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if (area == G.shop_jokers) or (area == G.pack_cards) then",["position"]="before",["payload"]="if MP.should_use_the_order() then\n\009if _order_et then card:set_eternal(_order_et) end\n\009if _order_per then card:set_perishable(_order_per) end\n\009if _order_rent then card:set_rental(_order_rent) end\n\009card:set_edition(_order_ed)\n\009-- wow what a suspiciously dangerously placed return that prevents any code below it from running!\n\009-- i sure hope this doesn't cause any problems whatsoever\n\009return card\nend\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"card.lua"},["pattern"]="while not self.ability.to_do_poker_hand do",["position"]="before",["payload"]="if MP.should_use_the_order() then\n\009_poker_hands = MP.sorted_hand_list(self.ability.to_do_poker_hand)\nend\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self.ability.to_do_poker_hand = pseudorandom_element(_poker_hands, pseudoseed('to_do'))",["position"]="before",["payload"]="if MP.should_use_the_order() then\n\009_poker_hands = MP.sorted_hand_list(self.ability.to_do_poker_hand)\nend\n",["indent"]=true},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="pattern",["t"]={"=[SMODS _ \"src/utils.lua\"]"},["pattern"]="local seal_poll = pseudorandom(pseudoseed(key or 'stdseal'..G.GAME.round_resets.ante))\nif seal_poll > 1 - (type_weight*mod / total_weight) or guaranteed then -- is a seal generated\n",["position"]="at",["payload"]="local seal_poll = guaranteed and 1 or pseudorandom(pseudoseed(key or 'stdseal'..G.GAME.round_resets.ante))\nif seal_poll > 1 - (type_weight*mod / total_weight) then -- is a seal generated\n",["indent"]=true,["times"]=1},{["mod"]="Noituus",["id"]="noituus",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if (G.STATE == G.STATES.HAND_PLAYED) or (G.STATE == G.STATES.NEW_ROUND) then",["position"]="at",["payload"]="if (G.STATE == G.STATES.HAND_PLAYED) or (G.STATE == G.STATES.NEW_ROUND) or Noituus and Noituus.accelerate then",["indent"]=true},{["mod"]="Noituus",["id"]="noituus",["k"]="pattern",["t"]={"=[SMODS incantation \"Incantation.json\""},["pattern"]="\"priority\": ,",["position"]="at",["payload"]="\"priority\": -9999,",["indent"]=true},{["mod"]="Noituus",["id"]="noituus",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="G.PROFILES[G.SETTINGS.profile].consumeable_usage[card.config.center_key].count = G.PROFILES[G.SETTINGS.profile].consumeable_usage[card.config.center_key].count + 1",["position"]="at",["payload"]="G.PROFILES[G.SETTINGS.profile].consumeable_usage[card.config.center_key].count = G.PROFILES[G.SETTINGS.profile].consumeable_usage[card.config.center_key].count + (card.consumable_usage_override or card:getQty())",["indent"]=true},{["mod"]="Noituus",["id"]="noituus",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="G.PROFILES[G.SETTINGS.profile].consumeable_usage[card.config.center_key] = {count = 1, order = card.config.center.order}",["position"]="at",["payload"]="G.PROFILES[G.SETTINGS.profile].consumeable_usage[card.config.center_key] = {count = (card.consumable_usage_override or card:getQty()), order = card.config.center.order}",["indent"]=true},{["mod"]="Noituus",["id"]="noituus",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="G.GAME.consumeable_usage[card.config.center_key].count = G.GAME.consumeable_usage[card.config.center_key].count + 1",["position"]="at",["payload"]="G.GAME.consumeable_usage[card.config.center_key].count = G.GAME.consumeable_usage[card.config.center_key].count + (card.consumable_usage_override or card:getQty())",["indent"]=true},{["mod"]="Noituus",["id"]="noituus",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="G.GAME.consumeable_usage[card.config.center_key] = {count = 1, order = card.config.center.order, set = card.ability.set}",["position"]="at",["payload"]="G.GAME.consumeable_usage[card.config.center_key] = {count = (card.consumable_usage_override or card:getQty()), order = card.config.center.order, set = card.ability.set}",["indent"]=true},{["mod"]="Noituus",["id"]="noituus",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="G.GAME.consumeable_usage_total.tarot = G.GAME.consumeable_usage_total.tarot + 1  \n        G.GAME.consumeable_usage_total.tarot_planet = G.GAME.consumeable_usage_total.tarot_planet + 1",["position"]="at",["payload"]="G.GAME.consumeable_usage_total.tarot = G.GAME.consumeable_usage_total.tarot + (card.consumable_usage_override or card:getQty())\n        G.GAME.consumeable_usage_total.tarot_planet = G.GAME.consumeable_usage_total.tarot_planet + (card.consumable_usage_override or card:getQty())",["indent"]=true},{["mod"]="Noituus",["id"]="noituus",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="G.GAME.consumeable_usage_total.planet = G.GAME.consumeable_usage_total.planet + 1\n        G.GAME.consumeable_usage_total.tarot_planet = G.GAME.consumeable_usage_total.tarot_planet + 1",["position"]="at",["payload"]="G.GAME.consumeable_usage_total.planet = G.GAME.consumeable_usage_total.planet + (card.consumable_usage_override or card:getQty())\n        G.GAME.consumeable_usage_total.tarot_planet = G.GAME.consumeable_usage_total.tarot_planet + (card.consumable_usage_override or card:getQty())",["indent"]=true},{["mod"]="Noituus",["id"]="noituus",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="elseif card.config.center.set == 'Spectral' then  G.GAME.consumeable_usage_total.spectral = G.GAME.consumeable_usage_total.spectral + 1",["position"]="at",["payload"]="elseif card.config.center.set == 'Spectral' then  G.GAME.consumeable_usage_total.spectral = G.GAME.consumeable_usage_total.spectral + (card.consumable_usage_override or card:getQty())",["indent"]=true},{["mod"]="Noituus",["id"]="noituus",["k"]="pattern",["t"]={"functions/misc_functions.lua"},["pattern"]="G.GAME.consumeable_usage_total.all = G.GAME.consumeable_usage_total.all + 1",["position"]="at",["payload"]="G.GAME.consumeable_usage_total.all = G.GAME.consumeable_usage_total.all + (card.consumable_usage_override or card:getQty())",["indent"]=true},{["mod"]="Noituus",["id"]="noituus",["k"]="pattern",["t"]={"card.lua"},["pattern"]="Xmult_mod = G.P_CENTERS.v_observatory.config.extra",["position"]="at",["payload"]="Xmult_mod = G.P_CENTERS.v_observatory.config.extra ^ self:getQty()",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="regex",["t"]={"functions/common_events.lua"},["pattern"]="not G.TAROT_INTERRUPT then",["position"]="at",["payload"]="not Talisman.no_anims_calculating() and not G.TAROT_INTERRUPT then"},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="regex",["t"]={"game.lua"},["pattern"]="card\\:start_materialize\\(\\)\\n\\s+G\\.shop_vouchers\\:emplace\\(card\\)\\n\\s+end",["position"]="at",["payload"]="\009for k, v in pairs(G.GAME.current_round.cry_voucher_stickers) do\n\009\009card.ability[k] = v\n\009\009card:set_cost()\n\009end\n\009if G.GAME.current_round.cry_voucher_edition then\n\009\009card:set_edition(G.GAME.current_round.cry_voucher_edition, true, true)\n\009end\n\009card:start_materialize()\n\009G.shop_vouchers:emplace(card)\nend\n\nfor i = 1, #G.GAME.current_round.cry_bonusvouchers do\n\009if not G.GAME.cry_bonusvouchersused[i] then\n\009\009local card = Card(G.shop_vouchers.T.x + G.shop_vouchers.T.w/2,\n\009\009\009G.shop_vouchers.T.y, G.CARD_W, G.CARD_H, G.P_CARDS.empty, G.P_CENTERS[G.GAME.current_round.cry_bonusvouchers[i]],{bypass_discovery_center = true, bypass_discovery_ui = true})\n\009\009card.shop_cry_bonusvoucher = i\n\009\009Cryptid.manipulate(card)\n\009\009if G.GAME.events.ev_cry_choco2 then\n\009\009\009card.misprint_cost_fac = (card.misprint_cost_fac or 1) * 2\n\009\009\009card:set_cost()\n\009\009end\n\009\009if G.GAME.modifiers.cry_enable_flipped_in_shop and pseudorandom('cry_flip_vouch'..G.GAME.round_resets.ante) > 0.7 then\n\009\009\009card.cry_flipped = true\n\009\009end\n\009\009create_shop_card_ui(card, 'Voucher', G.shop_vouchers)\n\009\009card:start_materialize()\n\009\009if G.GAME.current_round.cry_voucher_edition then\009-- eh why not\n\009\009\009card:set_edition(G.GAME.current_round.cry_voucher_edition, true, true)\n\009\009end\n\009\009G.shop_vouchers.config.card_limit = G.shop_vouchers.config.card_limit + 1\009-- does this actually matter/even get reset??? i'm confused but whatever\n\009\009G.shop_vouchers:emplace(card)\n\009end\nend\n"},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if delta < 0 then delta = ''..delta; col = G.C.RED",["position"]="at",["payload"]="if delta < 0 then delta = number_format(delta); col = G.C.RED",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif delta > 0 then delta = '+'..delta",["position"]="at",["payload"]="elseif delta > 0 then delta = '+'..number_format(delta)",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="else delta = ''..delta",["position"]="at",["payload"]="else delta = number_format(delta)",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.T, config={text = G.GAME.hands[handname].chips, scale = 0.45, colour = G.C.UI.TEXT_LIGHT}},",["position"]="at",["payload"]="{n=G.UIT.T, config={text = number_format(G.GAME.hands[handname].chips, 1000000), scale = 0.45, colour = G.C.UI.TEXT_LIGHT}},",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.T, config={text = G.GAME.hands[handname].mult, scale = 0.45, colour = G.C.UI.TEXT_LIGHT}}",["position"]="at",["payload"]="{n=G.UIT.T, config={text = number_format(G.GAME.hands[handname].mult, 1000000), scale = 0.45, colour = G.C.UI.TEXT_LIGHT}}",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/UI_definitions.lua"},["pattern"]="{n=G.UIT.T, config={text = localize('k_level_prefix')..G.GAME.hands[handname].level, scale = 0.5, colour = G.C.UI.TEXT_DARK}}",["position"]="at",["payload"]="{n=G.UIT.T, config={text = localize('k_level_prefix')..number_format(G.GAME.hands[handname].level), scale = 0.5, colour = G.C.UI.TEXT_DARK}}",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"game.lua"},["pattern"]="ante = 1,",["position"]="after",["payload"]="ante_disp = number_format(1),",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="ante_UI.config.object:update()",["position"]="at",["payload"]="G.GAME.round_resets.ante_disp = number_format(G.GAME.round_resets.ante, Talisman.ante_switch_point)\n\nlocal ao = ante_UI.config.object\nao.scale = ao.config.scale\nao:update_text(true)\nao:align_letters()\n\nif ao.config.maxw and ao.config.W > ao.config.maxw then\n\009ao.start_pop_in = ao.config.pop_in\n\009ao.scale = ao.scale*(ao.config.maxw/ao.config.W)\n\009ao:update_text(true)\nend\n",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"engine/string_packer.lua"},["pattern"]="--[[\namulet: talisman detection\nelseif v.is and v:is(Object) then\n]]\n",["position"]="at",["payload"]="--[[amulet: talisman detected]]",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"tag.lua"},["pattern"]="tag_sprite.states.collide.can = true",["position"]="after",["payload"]="if self.key == 'tag_cry_cat' then tag_sprite.states.click.can = true; tag_sprite.states.drag.can = true end\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"tag.lua"},["pattern"]="tag_sprite.stop_hover = function(_self) _self.hovering = false; Node.stop_hover(_self); _self.hover_tilt = 0 end",["position"]="after",["payload"]="tag_sprite.click = function(_self)\n\009\009if G.GAME.USING_POINTER then\n\009\009\009local t = G.P_TAGS[self.key]\n\009\009\009if not t.no_doe and not t.hidden and not t.no_pointer then\n\009\009\009\009add_tag(self)\n\009\009\009\009G.FUNCS.exit_overlay_menu_code()\n\009\009\009\009if G.GAME.CODE_DESTROY_CARD then\n\009\009\009\009\009G.GAME.CODE_DESTROY_CARD:start_dissolve()\n\009\009\009\009\009G.GAME.CODE_DESTROY_CARD = nil\n\009\009\009\009end\n\009\009\009end\n\009\009end\n        if self.key == 'tag_cry_cat' and self.HUD_tag then\n\009\009for i = 1, #G.GAME.tags do\n\009\009\009local other_cat = G.GAME.tags[i]\n\009\009\009if other_cat.key == 'tag_cry_cat' then\n\009\009\009\009if not self.ability.level then self.ability.level = 1 end\n\009\009\009\009if not other_cat.ability.level then other_cat.ability.level = 1 end\009-- setting ability just doesn't seem to be working... so you get this\n\009\009\009\009if (self.ability.level == other_cat.ability.level) and (other_cat ~= self) and not cry_too_fast_kitty then\n\009\009\009\009\009cry_too_fast_kitty = true\n\009\009\009\009\009local perc = (other_cat.ability.level + 1)/10\n\009\009\009\009\009if perc > 1 then perc = 1 end\n\n\009\009\009\009\009local edition = G.P_CENTER_POOLS.Edition[1]\n\009\009\009\009\009local j = 1\n\009\009\009\009\009while j < other_cat.ability.level + 1 do\n\009\009\009\009\009\009for i = 2, #G.P_CENTER_POOLS.Edition do\n\009\009\009\009\009\009\009j = j + 1\n\009\009\009\009\009\009\009if j >= other_cat.ability.level + 1 then\n\009\009\009\009\009\009\009\009edition = G.P_CENTER_POOLS.Edition[i]\n\009\009\009\009\009\009\009\009break\n\009\009\009\009\009\009\009end\n\009\009\009\009\009\009end\n\009\009\009\009\009end\n\n\009\009\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009\009\009delay = 0.0,\n\009\009\009\009\009\009trigger = 'immediate',\n\009\009\009\009\009\009func = (function()\n\009\009\009\009\009\009\009attention_text({\n\009\009\009\009\009\009\009\009text = \"\"..other_cat.ability.level,\n\009\009\009\009\009\009\009\009colour = G.C.WHITE,\n\009\009\009\009\009\009\009\009scale = 1,\n\009\009\009\009\009\009\009\009hold = 0.3/G.SETTINGS.GAMESPEED,\n\009\009\009\009\009\009\009\009cover = other_cat.HUD_tag,\n\009\009\009\009\009\009\009\009cover_colour = G.C.DARK_EDITION,\n\009\009\009\009\009\009\009\009align = 'cm',\n\009\009\009\009\009\009\009})\n\009\009\009\009\009\009\009play_sound('generic1', 0.8 + perc/2, 0.6)\n\009\009\009\009\009\009\009play_sound('multhit1', 0.9 + perc/2, 0.4)\n\009\009\009\009\009\009\009return true\n\009\009\009\009\009\009end)\n\009\009\009\009\009}))\n\009\009\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009\009\009delay = 0.0,\n\009\009\009\009\009\009trigger = 'immediate',\n\009\009\009\009\009\009func = (function()\n\009\009\009\009\009\009\009attention_text({\n\009\009\009\009\009\009\009\009text = \"-\",\n\009\009\009\009\009\009\009\009colour = G.C.WHITE,\n\009\009\009\009\009\009\009\009scale = 1,\n\009\009\009\009\009\009\009\009hold = 0.3/G.SETTINGS.GAMESPEED,\n\009\009\009\009\009\009\009\009cover = self.HUD_tag,\n\009\009\009\009\009\009\009\009cover_colour = G.C.RED,\n\009\009\009\009\009\009\009\009align = 'cm',\n\009\009\009\009\009\009\009})\n\009\009\009\009\009\009\009return true\n\009\009\009\009\009\009end)\n\009\009\009\009\009}))\n\009\009\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009\009\009func = (function()\n\009\009\009\009\009\009\009self.HUD_tag.states.visible = false\n\009\009\009\009\009\009\009return true\n\009\009\009\009\009\009end)\n\009\009\009\009\009}))\n\009\009\009\009\009G.E_MANAGER:add_event(Event({\009\009-- i have no idea what this does but i'm not messing with it\n\009\009\009\009\009\009func = func\n\009\009\009\009\009}))\n\n\009\009\009\009\009other_cat.ability.level = other_cat.ability.level + 1\n\009\009\009\009\009\n\009\009\009\009\009if self.ability.shiny then\n\009\009\009\009\009\009if not Cryptid.shinytagdata[self.key] then\n\009\009\009\009\009\009\009Cryptid.shinytagdata[self.key] = true\n\009\009\009\009\009\009\009Cryptid.save()\n\009\009\009\009\009\009end\n\009\009\009\009\009end\n\n\009\009\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009\009\009trigger = 'after',\n\009\009\009\009\009\009delay = 0.7,\n\009\009\009\009\009\009func = (function()\n\009\009\009\009\009\009\009other_cat:juice_up(0.25, 0.1)\n\009\009\009\009\009\009\009other_cat.ability.edshader = edition.shader\n\009\009\009\009\009\009\009play_sound(edition.sound.sound, (edition.sound.per or 1)*1.3, (edition.sound.vol or 0.25)*0.6)\n\009\009\009\009\009\009\009self:remove()\n\009\009\009\009\009\009\009cry_too_fast_kitty = nil\n\009\009\009\009\009\009\009return true\n\009\009\009\009\009\009end)\n\009\009\009\009\009}))\n\009\009\009\009\009break\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009end\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"engine/sprite.lua"},["pattern"]="for k, v in pairs(self.children) do",["position"]="before",["payload"]="if Cryptid and Cryptid.safe_get and Cryptid.safe_get(self, \"config\", \"tag\", \"ability\", \"edshader\") then\n\009local ed = self.config.tag.ability.edshader\n\009self.ARGS.send_to_shader = self.ARGS.send_to_shader or {}\n\009self.ARGS.send_to_shader[1] = math.min(self.VT.r*3, 1) + G.TIMERS.REAL/28 + (self.juice and self.juice.r*10 or 0) + (Cryptid.safe_get(self, \"tilt_var\", \"amt\") or 0)\n\009self.ARGS.send_to_shader[2] = G.TIMERS.REAL*2\n\009\n\009if ed then\n\009\009self:draw_shader(ed, nil, self.ARGS.send_to_shader)\n\009\009if ed == 'negative' or ed == 'cry_oversat' then\n\009\009\009self:draw_shader('negative_shine', nil, self.ARGS.send_to_shader)\n\009\009end\n\009end\nend\n",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"tag.lua"},["pattern"]="play_sound('tarot2', math.random()*0.1 + 0.55, 0.09)",["position"]="before",["payload"]="if self.key == 'tag_cry_cat' and not self.hide_ability then\n\009play_sound('cry_meow'..math.random(4), 1.26, 0.12);\nend",["indent"]=true},{["mod"]="Cryptid",["id"]="Cryptid",["k"]="pattern",["t"]={"tag.lua"},["pattern"]="local tag_sprite = Sprite(0,0,_size*1,_size*1,G.ASSET_ATLAS[(not self.hide_ability) and G.P_TAGS[self.key].atlas or \"tags\"], (self.hide_ability) and G.tag_undiscovered.pos or self.pos)",["position"]="at",["payload"]="local tagatlas = G.ASSET_ATLAS[self and (not self.hide_ability) and G.P_TAGS[self.key] and G.P_TAGS[self.key].atlas or \"tags\"]\nif self.ability.shiny and not self.hide_ability then\n\009if G.P_TAGS[self.key].shiny_atlas then\n\009\009tagatlas = G.ASSET_ATLAS[G.P