e same and\",\n\009\009\009\009\009\"can be reassigned to other key\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Uncheck to use vanilla control\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009insta_cash_out = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Holding a keybind will trigger it\",\n\009\009\009\009\009\"as soon as it will be available\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009insta_booster_skip = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Holding a keybind will trigger it\",\n\009\009\009\009\009\"as soon as it will be available\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009move_highlight = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Select card in area and\",\n\009\009\009\009\009\"then use listed controls\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009move_highlight_gamepad = {\n\009\009\009\009text = {\n\009\009\009\009\009\"{C:mult}Have no effect on gamepad{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [keybind for Multiply], [keybind for Divide], min value, max value\n\009\009\009speed_multiplier = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Game speed can be changed in\",\n\009\009\009\009\009\"range from {C:attention}#4#{} to {C:attention}#5#{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [keybind for Increase], [keybind for Decrease], [Danger zone tab]\n\009\009\009nopeus_interaction = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Required mod {C:attention}Nopeus{} to work\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"{C:mult}Unsafe{} option must be\",\n\009\009\009\009\009\"enabled in {C:attention}#4#{} tab\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [keybind for Increase], [keybind for Decrease], [Danger zone tab], None, Messages, Animations, Everything, Unsafe, [Danger zone tab]\n\009\009\009animation_skip = {\n\009\009\009\009text = {\n\009\009\009\009\009\"5 levels of animation skip are present\",\n\009\009\009\009\009\" 