            lq_5={
                "Looks like we",
                "found out who",
                "the real Joker is!",
            },
            lq_6={
                "Oh no, were you",
                "bluffing too?",
            },
            lq_7={
                "Looks like the",
                "joke's on us!",
            },
            lq_8={
                "If I had hands",
                "I would have",
                "covered my eyes!",
            },
            lq_9={
                "I'm literally",
                "a fool, what's",
                "your excuse?",
            },
            wq_1={
                "You Aced it!",
            },
            wq_2={
                "You dealt with",
                "that pretty well!",
