, None, Messages, Animations, Everything, Unsafe, [Danger zone tab]\n\009\009\009animation_skip = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Existen 5 niveles de salto de animaciÃ³n\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"{C:attention}#4#{} - Comportamiento normal del juego\",\n\009\009\009\009\009\"{C:attention}#5#{} - Remueve textos de cartas como {C:attention}Â¡De nuevo!{} y {C:chips}+Chips{}\",\n\009\009\009\009\009\"{C:attention}#6#{} - PuntuaciÃ³n instantÃ¡nea, remueve movimiento de las cartas\",\n\009\009\009\009\009\"{C:attention}#7#{} - Remueve animaciones innecesarias, toma de cartas y reinicio\",\n\009\009\009\009\009\"{C:mult}#8#{} - El lÃ­mite del juego: Todo es instantÃ¡neo\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"La opciÃ³n {C:mult}#8#{} debe ser activada en la pestaÃ±a de {C:attention}#9#{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009scoring_hold = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Ãštil para barajar comodines o verificar\",\n\009\009\009\009\009\"una puntuaciÃ³n antes del final de la ronda en\",\n\009\009\009\009\009\"alta velocidad de juego o cuando se saltan animaciones\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009not_just_yet_interaction = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Se requiere el mod {C:attention}NotJustYet{} para que funcione\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_buy_or_sell_desktop = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Uso determinado por {C:attention}#2#{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_buy_or_sell_gamepad = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Reemplaza el {C:chips}#3#{} del juego base\",\n\009\009\009\009\009\"pero funciona exactamente igual y\",\n\009\009\009\009\009\"puede asignarse a otro botÃ³n\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Deselecciona para usar el control del juego base\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_buy_n_sell_desktop = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Uso determinado por {C:attention}#2#{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_use_desktop = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Uso determinado por {C:attention}#2#{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009insta_use_gamepad = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Reemplaza el {C:chips}#3#{} del juego base\",\n\009\009\009\009\009\"pero funciona exactamente igual y\",\n\009\009\009\009\009\"puede asignarse a otro botÃ³n\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Deselecciona para usar el control del juego base\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009cryptid_code_use_last_interaction = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Se requiere el mod {C:attention}Cryptid{} para que funcione\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Un atajo para usar una carta de cÃ³digo y seleccionar\",\n\009\009\009\009\009\"la opciÃ³n {C:green}[Usar Entrada previa]{} para:\",\n\009\009\009\009\009\"{C:green}://VARIABLE{}, {C:green}://CLASE{}, {C:green}://EXPLOTAR{}\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Uso determinado por {C:attention}#2#{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: Buy/Sell/Use mode\n\009\009\009cryptid_code_use_last_interaction_gamepad = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Se requiere el mod {C:attention}Cryptid{} para que funcione\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Un atajo para usar una carta de cÃ³digo y seleccionar\",\n\009\009\009\009\009\"{C:green}[Usar Entrada previa]{} opciÃ³n para:\",\n\009\009\009\009\009\"{C:green}://VARIABLE{}, {C:green}://CLASE{}, {C:green}://EXPLOTAR{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009insta_highlight_entire_f_hand = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Selecciona la cantidad mÃ¡xima posible de cartas\",\n\009\009\009\009\009\"en la mano, de izquierda a derecha\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [keybind for Quick buy/sell], [Quick buy/sell], [\"Dangerous\" modifier]\n\009\009\009immediate_buy_and_sell = {\n\009\009\009\009text = {\n\009\009\009\009\009\"MantÃ©n el {C:mult}#3#{}, {C:chips}#4#{},\",\n\009\009\009\009\009\"y arrastra a las cartas para venderlas inmediatamente\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009immediate_buy_and_sell_queue = {\n\009\009\009\009text = {\n\009\009\009\009\009\"En vez de vender inmediatamente, {C:mult}[Vender rÃ¡pido]{}\",\n\009\009\009\009\009\"guarda todas las cartas seleccionadas a una lista y\",\n\009\009\009\009\009\"estas se venderÃ¡n al soltar la combinaciÃ³n\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Permite una selecciÃ³n de cartas mÃ¡s precisa, pero mÃ¡s lenta\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009immediate_buy_and_sell_queue_gamepad = {\n\009\009\009\009text = {\n\009\009\009\009\009\"En vez de vender inmediatamente, {C:mult}[Vender rÃ¡pido]{}\",\n\009\009\009\009\009\"guarda todas las cartas seleccionadas a una lista y\",\n\009\009\009\009\009\"estas se venderÃ¡n al soltar la combinaciÃ³n\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Permite una selecciÃ³n de cartas mÃ¡s precisa, pero mÃ¡s lenta\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"{C:attention}Siempre activo en gamepad{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009speed_multiplier_uncap = {\n\009\009\009\009text = {\n\009\009\009\009\009\"{C:mult}Afecta drÃ¡sticamente el rendimiento{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009nopeus_unsafe = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Se requiere el mod {C:attention}Nopeus{} para que funcione\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Incluso si esto se desactive, la opciÃ³n {C:mult}Unsafe{}\",\n\009\009\009\009\009\"puede ser seleccionada en las configuraciones del juego\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [keybind for Quick buy/sell], [\"Dangerous\" modifier], [\"All copies\" modifier]\n\009\009\009sell_all_same = {\n\009\009\009\009text = {\n\009\009\009\009\009\"MantÃ©n el {C:mult}#3#{}, {C:mult}#4#{},\",\n\009\009\009\009\009\"y presiona una carta para vender todas sus copias\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [\"Dangerous\" modifier], [\"Sell ALL\" modifier]\n\009\009\009sell_all = {\n\009\009\009\009text = {\n\009\009\009\009\009\"MantÃ©n el {C:mult}#2#{}, {C:mult}#3#{},\",\n\009\009\009\009\009\"y presiona una carta para vender {C:attention}TODAS{} las cartas en el Ã¡rea\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [\"Dangerous\" modifier], [\"REMOVE\" modifier], [Quick buy/sell], [\"All copies\" modifier], [\"ALL\" modifier]\n\009\009\009card_remove = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Cuando mantienes, en lugar de vender cartas {C:attention}o etiquetas{} serÃ¡n {C:attention,E:1}REMOVIDAS{}\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"MantÃ©n el {C:mult}#2#{}, {C:mult}#3#{}, {C:chips}#4#{}\",\n\009\009\009\009\009\"y presiona una carta para {C:attention,E:1}REMOVERLAS{} (tambiÃ©n aplica la cola)\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"MantÃ©n el {C:mult}#2#{}, {C:mult}#3#{}, {C:mult}#5#{}\",\n\009\009\009\009\009\"y presiona una carta {C:attention}o etiqueta{} para {C:attention,E:1}REMOVER{} todas las copias\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"MantÃ©n el {C:mult}#2#{}, {C:mult}#3#{}, {C:mult}#6#{},\",\n\009\009\009\009\009\"y presiona una carta {C:attention}o etiqueta{} para {C:attention,E:1}REMOVER{} TODAS\",\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009\009Handy_Preset = {\n\009\009\009[\"default\"] = {\n\009\009\009\009name = \"Por defecto\",\n\009\009\009\009text = {\n\009\009\009\009\009\"Controles por defecto del mod\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009[\"better_mouse_and_gamepad\"] = {\n\009\009\009\009name = \"Better Mouse and Gamepad\",\n\009\009\009\009text = {\n\009\009\009\009\009\"Controles similares al mod Better Mouse and Gamepad\",\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009},\n\009misc = {\n\009\009-- You don't need to translate all of them, only necessary ones\n\009\009handy_keybinds = {\n\009\009\009-- No button assigned\n\009\009\009[\"None\"] = \"Ninguno\",\n\009\009\009-- Button which cannot be recognized\n\009\009\009[\"Unknown\"] = \"Desconocido\",\n\n\009\009\009-- Mouse\n\009\009\009[\"Left Mouse\"] = \"Click Izquierdo\",\n\009\009\009[\"Right Mouse\"] = \"Click Derecho\",\n\009\009\009[\"Middle Mouse\"] = \"Click Medio\",\n\009\009\009[\"Mouse 4\"] = \"BotÃ³n 4 del Mouse\",\n\009\009\009[\"Mouse 5\"] = \"BotÃ³n 5 del Mouse\",\n\009\009\009[\"Wheel Up\"] = \"Rueda para Arriba\",\n\009\009\009[\"Wheel Down\"] = \"Rueda para Abajo\",\n\009\009\009-- Controls\n\009\009\009[\"Escape\"] = nil,\n\009\009\009[\"Shift\"] = nil,\n\009\009\009[\"Ctrl\"] = nil,\n\009\009\009[\"Alt\"] = nil,\n\009\009\009[\"GUI\"] = nil, -- Windows button, or CMD for Mac\n\009\009\009[\"Enter\"] = nil,\n\009\009\009[\"Tab\"] = \"Tabular\",\n\009\009\009[\"Backspace\"] = \"Retroceso\",\n\009\009\009[\"Num Lock\"] = \"Bloq Num\",\n\009\009\009[\"Caps Lock\"] = \"Bloq Mayus\",\n\009\009\009[\"Scroll Lock\"] = \"Block Des\",\n\009\009\009-- Arrow keys\n\009\009\009[\"Left\"] = \"Izquierda\",\n\009\009\009[\"Right\"] = \"Derecha\",\n\009\009\009[\"Up\"] = \"Arriba\",\n\009\009\009[\"Down\"] = \"Abajo\",\n\009\009\009-- Symbols\n\009\009\009[\"Backquote\"] = \"Acento grave\", -- `\n\009\009\009[\"Singlequote\"] = \"Comilla simple\", -- '\n\009\009\009[\"Quote\"] = \"Comillas altas\", -- \"\n\009\009\009[\"Left Bracket\"] = \"Corchete Izquierdo\", -- [\n\009\009\009[\"Right Bracket\"] = \"Corchete Derecho\", -- ]