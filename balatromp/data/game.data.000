",\n\009\009\009\009\009\"and hover cards to sell them immediately\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009immediate_buy_and_sell_queue = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Instead of selling immediately, {C:mult}[Instant sell]{}\",\n\009\009\009\009\009\"will put all hovered cards in a list and\",\n\009\009\009\009\009\"all of them will be sold after keybind release\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Allow more precise cards selection, but slower\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009immediate_buy_and_sell_queue_gamepad = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Instead of selling immediately, {C:mult}[Instant sell]{}\",\n\009\009\009\009\009\"will put all hovered cards in a list and\",\n\009\009\009\009\009\"all of them will be sold after keybind release\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Allow more precise cards selection, but slower\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"{C:attention}Always active on gamepad{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009speed_multiplier_uncap = {\n\009\009\009\009text = {\n\009\009\009\009\009\"{C:mult}Drastically hurts performance{}\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009nopeus_unsafe = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Required mod {C:attention}Nopeus{} to work\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Even if this unchecked, {C:mult}Unsafe{} option\",\n\009\009\009\009\009\"can be set normally via game settings\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [keybind for Quick buy/sell], [\"Dangerous\" modifier], [\"All copies\" modifier]\n\009\009\009sell_all_same = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Hold {C:mult}#3#{}, {C:mult}#4#{},\",\n\009\009\009\009\009\"and click on card to sell all of their copies\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [\"Dangerous\" modifier], [\"Sell ALL\" modifier]\n\009\009\009sell_all = {\n\009\009\009\009text = {\n\009\009\009\009\009\"Hold {C:mult}#2#{}, {C:mult}#3#{},\",\n\009\009\009\009\009\"and click on card to sell {C:attention}ALL{} cards in area\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009-- Vars: [\"Dangerous\" modifier], [\"REMOVE\" modifier], [Quick buy/sell], [\"All copies\" modifier], [\"ALL\" modifier]\n\009\009\009card_remove = {\n\009\009\009\009text = {\n\009\009\009\009\009\"When hold, instead of selling cards {C:attention}or skip tags{} will be {C:attention,E:1}REMOVED{}\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Hold {C:mult}#2#{}, {C:mult}#3#{}, {C:chips}#4#{}\",\n\009\009\009\009\009\"and hover cards to {C:attention,E:1}REMOVE{} them (queue also applied)\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Hold {C:mult}#2#{}, {C:mult}#3#{}, {C:mult}#5#{}\",\n\009\009\009\009\009\"and click on card {C:attention}or skip tag{} to {C:attention,E:1}REMOVE{} all of their copies\",\n\009\009\009\009\009\" \",\n\009\009\009\009\009\"Hold {C:mult}#2#{}, {C:mult}#3#{}, {C:mult}#6#{},\",\n\009\009\009\009\009\"and click on card {C:attention}or skip tag{} to {C:attention,E:1}REMOVE{} {C:attention}ALL{} of them\",\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009\009Handy_Preset = {\n\009\009\009[\"default\"] = {\n\009\009\009\009name = \"Default\",\n\009\009\009\009text = {\n\009\009\009\009\009\"Default mod controls\",\n\009\009\009\009},\n\009\009\009},\n\009\009\009[\"better_mouse_and_gamepad\"] = {\n\009\009\009\009name = \"Better Mouse and Gamepad\",\n\009\009\009\009text = {\n\009\009\009\009\009\"Controls similar to Better Mouse and Gamepad mod\",\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009},\n\009misc = {\n\009\009-- You don't need to translate all of them, only necessary ones\n\009\009handy_keybinds = {\n\009\009\009-- No button assigned\n\009\009\009[\"None\"] = \"None\",\n\009\009\009-- Button which cannot be recognized\n\009\009\009[\"Unknown\"] = \"Unknown\",\n\n\009\009\009-- Mouse\n\009\009\009[\"Left Mouse\"] = nil,\n\009\009\009[\"Right Mouse\"] = nil,\n\009\009\009[\"Middle Mouse\"] = nil,\n\009\009\009[\"Mouse 4\"] = nil,\n\009\009\009[\"Mouse 5\"] = nil,\n\009\009\009[\"Wheel Up\"] = nil,\n\009\009\009[\"Wheel Down\"] = nil,\n\009\009\009-- Controls\n\009\009\009[\"Escape\"] = nil,\n\009\009\009[\"Shift\"] = nil,\n\009\009\009[\"Ctrl\"] = nil,\n\009\009\009[\"Alt\"] = nil,\n\009\009\009[\"GUI\"] = nil, -- Windows button, or CMD for Mac\n\009\009\009[\"Enter\"] = nil,\n\009\009\009[\"Tab\"] = nil,\n\009\009\009[\"Backspace\"] = nil,\n\009\009\009[\"Num Lock\"] = nil,\n\009\009\009[\"Caps Lock\"] = nil,\n\009\009\009[\"Scroll Lock\"] = nil,\n\009\009\009-- Arrow keys\n\009\009\009[\"Left\"] = nil,\n\009\009\009[\"Right\"] = nil,\n\009\009\009[\"Up\"] = nil,\n\009\009\009[\"Down\"] = nil,\n\009\009\009-- Symbols\n\009\009\009[\"Backquote\"] = nil, -- `\n\009\009\009[\"Singlequote\"] = nil, -- '\n\009\009\009[\"Quote\"] = nil, -- \"\n\009\009\009[\"Left Bracket\"] = nil, -- [\n\009\009\009[\"Right Bracket\"] = nil, -- ]\n\009\009\009-- Weird buttons\n\009\009\009[\"Printscreen\"] = nil,\n\009\009\009[\"Delete\"] = nil,\n\009\009\009[\"Home\"] = nil,\n\009\009\009[\"Insert\"] = nil,\n\009\009\009[\"End\"] = nil,\n\009\009\009[\"Pause\"] = nil,\n\009\009\009[\"Help\"] = nil,\n\009\009\009[\"Sysreq\"] = nil,\n\009\009\009[\"Menu\"] = nil,\n\009\009\009[\"Undo\"] = nil,\n\009\009\009[\"Mode\"] = nil,\n\009\009\009[\"Page Up\"] = nil,\n\009\009\009[\"Page Down\"] = nil,\n\009\009\009-- Very weird buttons, did they exist in 21th century?\n\009\009\009[\"Www\"] = nil,\n\009\009\009[\"Mail\"] = nil,\n\009\009\009[\"Calculator\"] = nil,\n\009\009\009[\"Computer\"] = nil,\n\009\009\009[\"Appsearch\"] = nil,\n\009\009\009[\"Apphome\"] = nil,\n\009\009\009[\"Appback\"] = nil,\n\009\009\009[\"Appforward\"] = nil,\n\009\009\009[\"Apprefresh\"] = nil,\n\009\009\009[\"Appbookmarks\"] = nil,\n\009\009\009[\"Currencyunit\"] = nil,\n\009\009\009[\"Application\"] = nil,\n\009\009\009[\"Power\"] = nil, -- What a heck\n\n\009\009\009-- Gamepad: buttons\n\009\009\009[\"(A)\"] = nil,\n\009\009\009[\"(B)\"] = nil,\n\009\009\009[\"(X)\"] = nil,\n\009\009\009[\"(Y)\"] = nil,\n\009\009\009[\"(Back)\"] = nil,\n\009\009\009[\"(Guide)\"] = nil,\n\009\009\009[\"(Start)\"] = nil,\n\009\009\009-- Gamepad: directions\n\009\009\009-- In Balatro, Left Stick movement treated as direction buttons\n\009\009\009[\"(Up)\"] = nil,\n\009\009\009[\"(Down)\"] = nil,\n\009\009\009[\"(Left)\"] = nil,\n\009\009\009[\"(Right)\"] = nil,\n\009\009\009-- Gamepad: sticks, triggers, bumpers and paddles\n\009\009\009[\"Left Stick\"] = nil, -- Click\n\009\009\009[\"Right Stick\"] = nil, -- Click\n\009\009\009[\"Left Bumper\"] = nil, -- LB\n\009\009\009[\"Right Bumper\"] = nil, -- RB\n\009\009\009[\"Left Trigger\"] = nil, -- LT\n\009\009\009[\"Right Trigger\"] = nil, -- RT\n\009\009\009-- Not supported by current LOVE engine version\n\009\009\009[\"First Paddle\"] = nil, -- P1\n\009\009\009[\"Second Paddle\"] = nil, -- P2\n\009\009\009[\"Third Paddle\"] = nil, -- P3\n\009\009\009[\"Fourth Paddle\"] = nil, -- P4\n\009\009\009[\"(Misc. Button)\"] = nil,\n\009\009\009-- Gamepad: touchpad\n\009\009\009[\"Touchpad Press\"] = nil,\n\n\009\009\009-- Not listed here, but can be added if you ever need:\n\009\009\009-- All english letters uppercase, (Q, W, E, R, T, Y...)\n\009\009\009-- All numbers (1, 2, 3...0)\n\009\009\009-- All F keys (F1, F2, F3...)\n\009\009\009-- All NUM keys (NUM 0 ... NUM 9, NUM Enter, NUM +, NUM -, NUM *, NUM /, NUM .)\n\009\009\009-- Other symbols (. ; / \\ - + etc)\n\009\009},\n\009\009handy_keybind_labels = {\n\009\009\009play_hand = \"Play hand\",\n\009\009\009discard = \"Discard\",\n\009\009\009toggle_sort = \"Toggle sort\",\n\009\009\009sort_by_rank = \"Sort by rank\",\n\009\009\009sort_by_suit = \"Sort by suit\",\n\009\009\009deselect_hand = \"Deselect hand\",\n\009\009\009cash_out = \"Cash out\",\n\009\009\009not_just_yet_end_round = \"NotJustYet: 