}return {["build"]="1792628031550022394",["vars"]={},["copies"]={{["mod"]="Steamodded",["id"]="Steamodded",["k"]="copy",["t"]={"main.lua"},["position"]="prepend",["contents"]={"--- STEAMODDED CORE\n--- MODULE STACKTRACE\n-- NOTE: This is a modifed version of https://github.com/ignacio/StackTracePlus/blob/master/src/StackTracePlus.lua\n-- Licensed under the MIT License. See https://github.com/ignacio/StackTracePlus/blob/master/LICENSE\n-- The MIT License\n-- Copyright (c) 2010 Ignacio BurgueÃ±o\n-- Permission is hereby granted, free of charge, to any person obtaining a copy\n-- of this software and associated documentation files (the \"Software\"), to deal\n-- in the Software without restriction, including without limitation the rights\n-- to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n-- copies of the Software, and to permit persons to whom the Software is\n-- furnished to do so, subject to the following conditions:\n-- The above copyright notice and this permission notice shall be included in\n-- all copies or substantial portions of the Software.\n-- THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n-- IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n-- FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n-- AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n-- LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n-- OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN\n-- THE SOFTWARE.\n-- tables\nfunction loadStackTracePlus()\n    local _G = _G\n    local string, io, debug, coroutine = string, io, debug, coroutine\n\n    -- functions\n    local tostring, print, require = tostring, print, require\n    local next, assert = next, assert\n    local pcall, type, pairs, ipairs = pcall, type, pairs, ipairs\n    local error = error\n\n    assert(debug, \"Internal: Debug table must be available at this point\")\n\n    local io_open = io.open\n    local string_gmatch = string.gmatch\n    local string_sub = string.sub\n    local table_concat = table.concat\n\n    local _M = {\n        max_tb_output_len = 140 -- controls the maximum length of the 'stringified' table before cutting with ' (more...)'\n    }\n\n    -- this tables should be weak so the elements in them won't become uncollectable\n    local m_known_tables = {\n        [_G] = \"_G (global table)\"\n    }\n    local function add_known_module(name, desc)\n        local ok, mod = pcall(require, name)\n        if ok then\n            m_known_tables[mod] = desc\n        end\n    end\n\n    add_known_module(\"string\", \"string module\")\n    add_known_module(\"io\", \"io module\")\n    add_known_module(\"os\", \"os module\")\n    add_known_module(\"table\", \"table module\")\n    add_known_module(\"math\", \"math module\")\n    add_known_module(\"package\", \"package module\")\n    add_known_module(\"debug\", \"debug module\")\n    add_known_module(\"coroutine\", \"coroutine module\")\n\n    -- lua5.2\n    add_known_module(\"bit32\", \"bit32 module\")\n    -- luajit\n    add_known_module(\"bit\", \"bit module\")\n    add_known_module(\"jit\", \"jit module\")\n    -- lua5.3\n    if _VERSION >= \"Lua 5.3\" then\n        add_known_module(\"utf8\", \"utf8 module\")\n    end\n\n    local m_user_known_tables = {}\n\n    local m_known_functions = {}\n    for _, name in ipairs { -- Lua 5.2, 5.1\n    \"assert\", \"collectgarbage\", \"dofile\", \"error\", \"getmetatable\", \"ipairs\", \"load\", \"loadfile\", \"next\", \"pairs\",\n    \"pcall\", \"print\", \"rawequal\", \"rawget\", \"rawlen\", \"rawset\", \"require\", \"select\", \"setmetatable\", \"tonumber\",\n    \"tostring\", \"type\", \"xpcall\", -- Lua 5.1\n    \"gcinfo\", \"getfenv\", \"loadstring\", \"module\", \"newproxy\", \"setfenv\", \"unpack\" -- TODO: add table.* etc functions\n    } do\n        if _G[name] then\n            m_known_functions[_G[name]] = name\n        end\n    end\n\n    local m_user_known_functions = {}\n\n    local function safe_tostring(value)\n        local ok, err = pcall(tostring, value)\n        if ok then\n            return err\n        else\n            return (\"<failed to get printable value>: '%s'\"):format(err)\n        end\n    end\n\n    -- Private:\n    -- Parses a line, looking for possible function definitions (in a very naÃ¯ve way)\n    -- Returns '(anonymous)' if no function name was found in the line\n    local function ParseLine(line)\n        assert(type(line) == \"string\", (\"Internal: line \\\"%s\\\" is type \\\"%s\\\", should be a string\"):format(tostring(line), type(line)))\n        -- print(line)\n        local match = line:match(\"^%s*function%s+(%w+)\")\n        if match then\n            -- print(\"+++++++++++++function\", match)\n            return match\n        end\n        match = line:match(\"^%s*local%s+function%s+(%w+)\")\n        if match then\n            -- print(\"++++++++++++local\", match)\n            return match\n        end\n        match = line:match(\"^%s*local%s+(%w+)%s+=%s+function\")\n        if match then\n            -- print(\"++++++++++++local func\", match)\n            return match\n        end\n        match = line:match(\"%s*function%s*%(\") -- this is an anonymous function\n        if match then\n            -- print(\"+++++++++++++function2\", match)\n            return \"(anonymous)\"\n        end\n        return \"(anonymous)\"\n    end\n\n    -- Private:\n    -- Tries to guess a function's name when the debug info structure does not have it.\n    -- It parses either the file or the string where the function is defined.\n    -- Returns '?' if the line where the function is defined is not found\n    local function GuessFunctionName(info)\n        -- print(\"guessing function name\")\n        if type(info.source) == \"string\" and info.source:sub(1, 1) == \"@\" then\n            local file, err = io_open(info.source:sub(2), \"r\")\n            if not file then\n                print(\"file not found: \" .. tostring(err)) -- whoops!\n                return \"?\"\n            end\n            local line\n            for _ = 1, info.linedefined do\n                line = file:read(\"*l\")\n            end\n            if not line then\n                print(\"line not found\") -- whoops!\n                return \"?\"\n            end\n            return ParseLine(line)\n        elseif type(info.source) == \"string\" and info.source:sub(1, 6) == \"=[love\" then\n            return \"(LÃ–VE Function)\"\n        else\n            local line\n            local lineNumber = 0\n            for l in string_gmatch(info.source, \"([^\\n]+)\\n-\") do\n                lineNumber = lineNumber + 1\n                if lineNumber == info.linedefined then\n                    line = l\n                    break\n                end\n            end\n            if not line then\n                print(\"line not found\") -- whoops!\n                return \"?\"\n            end\n            return ParseLine(line)\n        end\n    end\n\n    ---\n    -- Dumper instances are used to analyze stacks and collect its information.\n    --\n    local Dumper = {}\n\n    Dumper.new = function(thread)\n        local t = {\n            lines = {}\n        }\n        for k, v in pairs(Dumper) do\n            t[k] = v\n        end\n\n        t.dumping_same_thread = (thread == coroutine.running())\n\n        -- if a thread was supplied, bind it to debug.info and debug.get\n        -- we also need to skip this additional level we are introducing in the callstack (only if we are running\n        -- in the same thread we're inspecting)\n        if type(thread) == \"thread\" then\n            t.getinfo = function(level, what)\n                if t.dumping_same_thread and type(level) == \"number\" then\n                    level = level + 1\n                end\n                return debug.getinfo(thread, level, what)\n            end\n            t.getlocal = function(level, loc)\n                if t.dumping_same_thread then\n                    level = level + 1\n                end\n                return debug.getlocal(thread, level, loc)\n            end\n        else\n            t.getinfo = debug.getinfo\n            t.getlocal = debug.getlocal\n        end\n\n        return t\n    end\n\n    -- helpers for collecting strings to be used when assembling the final trace\n    function Dumper:add(text)\n        self.lines[#self.lines + 1] = text\n    end\n    function Dumper:add_f(fmt, ...)\n        self:add(fmt:format(...))\n    end\n    function Dumper:concat_lines()\n        return table_concat(self.lines)\n    end\n\n    ---\n    -- Private:\n    -- Iterates over the local variables of a given function.\n    --\n    -- @param level The stack level where the function is.\n    --\n    function Dumper:DumpLocals(level)\n        local prefix = \"\\t \"\n        local i = 1\n\n        if self.dumping_same_thread then\n            level = level + 1\n        end\n\n        local name, value = self.getlocal(level, i)\n        if not name then\n            return\n        end\n        self:add(\"\\tLocal variables:\\r\\n\")\n        while name do\n            if type(value) == \"number\" then\n                self:add_f(\"%s%s = number: %g\\r\\n\", prefix, name, value)\n            elseif type(value) == \"boolean\" then\n                self:add_f(\"%s%s = boolean: %s\\r\\n\", prefix, name, tostring(value))\n            elseif type(value) == \"string\" then\n                self:add_f(\"%s%s = string: %q\\r\\n\", prefix, name, value)\n            elseif type(value) == \"userdata\" then\n                self:add_f(\"%s%s = %s\\r\\n\", prefix, name, safe_tostring(value))\n            elseif type(value) == \"nil\" then\n                self:add_f(\"%s%s = nil\\r\\n\", prefix, name)\n            elseif type(value) == \"table\" then\n                if m_known_tables[value] then\n                    self:add_f(\"%s%s = %s\\r\\n\", prefix, name, m_known_tables[value])\n                elseif m_user_known_tables[value] then\n                    self:add_f(\"%s%s = %s\\r\\n\", prefix, name, m_user_known_tables[value])\n                else\n                    local txt = \"{\"\n                    for k, v in pairs(value) do\n                        txt = txt .. safe_tostring(k) .. \":\" .. safe_tostring(v)\n                        if #txt > _M.max_tb_output_len then\n                            txt = txt .. \" (more...)\"\n                            break\n                        end\n                        if next(value, k) then\n                            txt = txt .. \", \"\n                        end\n                    end\n                    self:add_f(\"%s%s = %s  %s\\r\\n\", prefix, name, safe_tostring(value), txt .. \"}\")\n                end\n            elseif type(value) == \"function\" then\n                local info = self.getinfo(value, \"nS\")\n                local fun_name = info.name or m_known_functions[value] or m_user_known_functions[value]\n                if info.what == \"C\" then\n                    self:add_f(\"%s%s = C %s\\r\\n\", prefix, name,\n                        (fun_name and (\"function: \" .. fun_name) or tostring(value)))\n                else\n                    local source = info.short_src\n                    if source:sub(2, 7) == \"string\" then\n                        source = source:sub(9) -- uno mÃ¡s, por el espacio que viene (string \"Baragent.Main\", por ejemplo)\n                    end\n                    -- for k,v in pairs(info) do print(k,v) end\n                    fun_name = fun_name or GuessFunctionName(info)\n                    self:add_f(\"%s%s = Lua function '%s' (defined at line %d of chunk %s)\\r\\n\", prefix, name, fun_name,\n                        info.linedefined, source)\n                end\n            elseif type(value) == \"thread\" then\n                self:add_f(\"%sthread %q = %s\\r\\n\", prefix, name, tostring(value))\n            end\n            i = i + 1\n            name, value = self.getlocal(level, i)\n        end\n    end\n\n    ---\n    -- Public:\n    -- Collects a detailed stack trace, dumping locals, resolving function names when they're not available, etc.\n    -- This function is suitable to be used as an error handler with pcall or xpcall\n    --\n    -- @param thread An optional thread whose stack is to be inspected (defaul is the current thread)\n    -- @param message An optional error string or object.\n    -- @param level An optional number telling at which level to start the traceback (default is 1)\n    --\n    -- Returns a string with the stack trace and a string with the original error.\n    --\n    function _M.stacktrace(thread, message, level)\n        if type(thread) ~= \"thread\" then\n            -- shift parameters left\n            thread, message, level = nil, thread, message\n        end\n\n        thread = thread or coroutine.running()\n\n        level = level or 1\n\n        local dumper = Dumper.new(thread)\n\n        local original_error\n\n        if type(message) == \"table\" then\n            dumper:add(\"an error object {\\r\\n\")\n            local first = true\n            for k, v in pairs(message) do\n                if first then\n                    dumper:add(\"  \")\n                    first = false\n                else\n                    dumper:add(\",\\r\\n  \")\n                end\n                dumper:add(safe_tostring(k))\n                dumper:add(\": \")\n                dumper:add(safe_tostring(v))\n            end\n            dumper:add(\"\\r\\n}\")\n            original_error = dumper:concat_lines()\n        elseif type(message) == \"string\" then\n            dumper:add(message)\n            original_error = message\n        end\n\n        dumper:add(\"\\r\\n\")\n        dumper:add [[\nStack Traceback\n===============\n]]\n        -- print(error_message)\n\n        local level_to_show = level\n        if dumper.dumping_same_thread then\n            level = level + 1\n        end\n\n        local info = dumper.getinfo(level, \"nSlf\")\n        while info do\n            if info.what == \"main\" then\n                if string_sub(info.source, 1, 1) == \"@\" then\n                    dumper:add_f(\"(%d) main chunk of file '%s' at line %d\\r\\n\", level_to_show,\n                        string_sub(info.source, 2), info.currentline)\n                elseif info.source and info.source:sub(1, 1) == \"=\" then\n                    local str = info.source:sub(3, -2)\n                    local props = {}\n                    -- Split by space\n                    for v in string.gmatch(str, \"[^%s]+\") do\n                        table.insert(props, v)\n                    end\n                    local source = table.remove(props, 1)\n                    if source == \"love\" then\n                        dumper:add_f(\"(%d) main chunk of LÃ–VE file '%s' at line %d\\r\\n\", level_to_show,\n                            table.concat(props, \" \"):sub(2, -2), info.currentline)\n                    elseif source == \"SMODS\" then\n                        local modID = table.remove(props, 1)\n                        local fileName = table.concat(props, \" \")\n                        if modID == '_' then\n                            dumper:add_f(\"(%d) main chunk of Steamodded file '%s' at line %d\\r\\n\", level_to_show,\n                                fileName:sub(2, -2), info.currentline)\n                        else\n                            dumper:add_f(\"(%d) main chunk of file '%s' at line %d (from mod with id %s)\\r\\n\",\n                                level_to_show, fileName:sub(2, -2), info.currentline, modID)\n                        end\n                    elseif source == \"lovely\" then\n                        local module = table.remove(props, 1)\n                        local fileName = table.concat(props, \" \")\n                        dumper:add_f(\"(%d) main chunk of file '%s' at line %d (from lovely module %s)\\r\\n\",\n                            level_to_show, fileName:sub(2, -2), info.currentline, module)\n                    else\n                        dumper:add_f(\"(%d) main chunk of %s at line %d\\r\\n\", level_to_show, info.source,\n                            info.currentline)\n                    end\n                else\n                    dumper:add_f(\"(%d) main chunk of %s at line %d\\r\\n\", level_to_show, info.source, info.currentline)\n                end\n            elseif info.what == \"C\" then\n                -- print(info.namewhat, info.name)\n                -- for k,v in pairs(info) do print(k,v, type(v)) end\n                local function_name = m_user_known_functions[info.func] or m_known_functions[info.func] or info.name or\n                                          tostring(info.func)\n                dumper:add_f(\"(%d) %s C function '%s'\\r\\n\", level_to_show, info.namewhat, function_name)\n                -- dumper:add_f(\"%s%s = C %s\\r\\n\", prefix, name, (m_known_functions[value] and (\"function: \" .. m_known_functions[value]) or tostring(value)))\n            elseif info.what == \"tail\" then\n                -- print(\"tail\")\n                -- for k,v in pairs(info) do print(k,v, type(v)) end--print(info.namewhat, info.name)\n                dumper:add_f(\"(%d) tail call\\r\\n\", level_to_show)\n                dumper:DumpLocals(level)\n            elseif info.what == \"Lua\" then\n                local source = info.short_src\n                local function_name = m_user_known_functions[info.func] or m_known_functions[info.func] or info.name\n                if source:sub(2, 7) == \"string\" then\n                    source = source:sub(9)\n                end\n                local was_guessed = false\n                if not function_name or function_name == \"?\" then\n                    -- for k,v in pairs(info) do print(k,v, type(v)) end\n                    function_name = GuessFunctionName(info)\n                    was_guessed = true\n                end\n                -- test if we have a file name\n                local function_type = (info.namewhat == \"\") and \"function\" or info.namewhat\n                if info.source and info.source:sub(1, 1) == \"@\" then\n                    dumper:add_f(\"(%d) Lua %s '%s' at file '%s:%d'%s\\r\\n\", level_to_show, function_type, function_name,\n                        info.source:sub(2), info.currentline, was_guessed and \" (best guess)\" or \"\")\n                elseif info.source and info.source:sub(1, 1) == '#' then\n                    dumper:add_f(\"(%d) Lua %s '%s' at template '%s:%d'%s\\r\\n\", level_to_show, function_type,\n                        function_name, info.source:sub(2), info.currentline, was_guessed and \" (best guess)\" or \"\")\n                elseif info.source and info.source:sub(1, 1) == \"=\" then\n                    local str = info.source:sub(3, -2)\n                    local props = {}\n                    -- Split by space\n                    for v in string.gmatch(str, \"[^%s]+\") do\n                        table.insert(props, v)\n                    end\n                    local source = table.remove(props, 1)\n                    if source == \"love\" then\n                        dumper:add_f(\"(%d) LÃ–VE %s at file '%s:%d'%s\\r\\n\", level_to_show, function_type,\n                            table.concat(props, \" \"):sub(2, -2), info.currentline, was_guessed and \" (best guess)\" or \"\")\n                    elseif source == \"SMODS\" then\n                        local modID = table.remove(props, 1)\n                        local fileName = table.concat(props, \" \")\n                        if modID == '_' then\n                            dumper:add_f(\"(%d) Lua %s '%s' at Steamodded file '%s:%d' %s\\r\\n\", level_to_show,\n                                function_type, function_name, fileName:sub(2, -2), info.currentline,\n                                was_guessed and \" (best guess)\" or \"\")\n                        else\n                            dumper:add_f(\"(%d) Lua %s '%s' at file '%s:%d' (from mod with id %s)%s\\r\\n\", level_to_show,\n                                function_type, function_name, fileName:sub(2, -2), info.currentline, modID,\n                                was_guessed and \" (best guess)\" or \"\")\n                        end\n                    elseif source == \"lovely\" then\n                        local module = table.remove(props, 1)\n                        local fileName = table.concat(props, \" \")\n                        dumper:add_f(\"(%d) Lua %s '%s' at file '%s:%d' (from lovely module %s)%s\\r\\n\", level_to_show,\n                            function_type, function_name, fileName:sub(2, -2), info.currentline, module,\n                            was_guessed and \" (best guess)\" or \"\")\n                    else\n                        dumper:add_f(\"(%d) Lua %s '%s' at line %d of chunk '%s'\\r\\n\", level_to_show, function_type,\n                            function_name, info.currentline, source)\n                    end\n                else\n                    dumper:add_f(\"(%d) Lua %s '%s' at line %d of chunk '%s'\\r\\n\", level_to_show, function_type,\n                        function_name, info.currentline, source)\n                end\n                dumper:DumpLocals(level)\n            else\n                dumper:add_f(\"(%d) unknown frame %s\\r\\n\", level_to_show, info.what)\n            end\n\n            level = level + 1\n            level_to_show = level_to_show + 1\n            info = dumper.getinfo(level, \"nSlf\")\n        end\n\n        return dumper:concat_lines(), original_error\n    end\n\n    --\n    -- Adds a table to the list of known tables\n    function _M.add_known_table(tab, description)\n        if m_known_tables[tab] then\n            error(\"Cannot override an already known table\")\n        end\n        m_user_known_tables[tab] = description\n    end\n\n    --\n    -- Adds a function to the list of known functions\n    function _M.add_known_function(fun, description)\n        if m_known_functions[fun] then\n            error(\"Cannot override an already known function\")\n        end\n        m_user_known_functions[fun] = description\n    end\n\n    return _M\nend\n\n-- Note: The below code is not from the original StackTracePlus.lua\nlocal stackTraceAlreadyInjected = false\n\nlocal function doRestart()\n    if SMODS and SMODS.restart_game then\n        SMODS.restart_game()\n    else\n        local test, msg = pcall(function()\n            require\"lovely\".reload_patches()\n        end)\n        if not test then sendErrorMessage(\"Failed to reload patches... \" .. tostring(msg), \"StackTrace\") end\n        love.event.quit(\"restart\")\n    end\nend\n\nfunction getDebugInfoForCrash()\n    local version = VERSION\n    if not version or type(version) ~= \"string\" then\n        local versionFile = love.filesystem.read(\"version.jkr\")\n        if versionFile then\n            version = versionFile:match(\"[^\\n]*\") .. \" (best guess)\"\n        else\n            version = \"???\"\n        end\n    end\n    local modded_version = MODDED_VERSION\n    if not modded_version or type(modded_version) ~= \"string\" then\n        local moddedSuccess, reqVersion = pcall(require, \"SMODS.version\")\n        if moddedSuccess and type(reqVersion) == \"string\" then\n            modded_version = reqVersion\n        else\n            modded_version = \"???\"\n        end\n    end\n\n    local info = \"Additional Context:\\nBalatro Version: \" .. version .. \"\\nModded Version: \" ..\n                     (modded_version)\n    local major, minor, revision, codename = love.getVersion()\n    info = info .. string.format(\"\\nLÃ–VE Version: %d.%d.%d\", major, minor, revision)\n    local lovely_success, lovely = pcall(require, \"lovely\")\n    if lovely_success then\n        info = info .. \"\\nLovely Version: \" .. lovely.version\n    end\n\009info = info .. \"\\nPlatform: \" .. (love.system.getOS() or \"???\")\n    if SMODS and SMODS.Mods then\n        local mod_strings = \"\"\n        local lovely_strings = \"\"\n        local i = 1\n        local lovely_i = 1\n        for _, v in pairs(SMODS.Mods) do\n            if (v.can_load and (not v.meta_mod or v.lovely_only)) or (v.lovely and not v.can_load and not v.disabled) then\n                if v.lovely_only or (v.lovely and not v.can_load) then\n                    lovely_strings = lovely_strings .. \"\\n    \" .. lovely_i .. \": \" .. v.name\n                    lovely_i = lovely_i + 1\n                    if not v.can_load then\n                        lovely_strings = lovely_strings .. \"\\n        Has Steamodded mod that failed to load.\"\n                        if #v.load_issues.dependencies > 0 then\n                            lovely_strings = lovely_strings .. \"\\n        Missing Dependencies:\"\n                            for k, v in ipairs(v.load_issues.dependencies) do\n                                lovely_strings = lovely_strings .. \"\\n            \" .. k .. \". \" .. v\n                            end\n                        end\n                        if #v.load_issues.conflicts > 0 then\n                            lovely_strings = lovely_strings .. \"\\n        Conflicts:\"\n                            for k, v in ipairs(v.load_issues.conflicts) do\n                                lovely_strings = lovely_strings .. \"\\n            \" .. k .. \". \" .. v\n                            end\n                        end\n                        if v.load_issues.outdated then\n                            lovely_strings = lovely_strings .. \"\\n        Outdated Mod.\"\n                        end\n                        if v.load_issues.main_file_not_found then\n                            lovely_strings = lovely_strings .. \"\\n        Main file not found. (\" .. v.main_file ..\")\"\n                        end\n                    end\n                else\n                    mod_strings = mod_strings .. \"\\n    \" .. i .. \": \" .. v.name .. \" by \" ..\n                                      table.concat(v.author, \", \") .. \" [ID: \" .. v.id ..\n                                      (v.priority ~= 0 and (\", Priority: \" .. v.priority) or \"\") ..\n                                      (v.version and v.version ~= '0.0.0' and (\", Version: \" .. v.version) or \"\") ..\n                                      (v.lovely and (\", Uses Lovely\") or \"\") .. \"]\"\n                    i = i + 1\n                    local debugInfo = v.debug_info\n                    if debugInfo then\n                        if type(debugInfo) == \"string\" then\n                            if #debugInfo ~= 0 then\n                                mod_strings = mod_strings .. \"\\n        \" .. debugInfo\n                            end\n                        elseif type(debugInfo) == \"table\" then\n                            for kk, vv in pairs(debugInfo) do\n                                if type(vv) ~= 'nil' then\n                                    vv = tostring(vv)\n                                end\n                                if #vv ~= 0 then\n                                    mod_strings = mod_strings .. \"\\n        \" .. kk .. \": \" .. vv\n                                end\n                            end\n                        end\n                    end\n                end\n            end\n        end\n        info = info .. \"\\nSteamodded Mods:\" .. mod_strings .. \"\\nLovely Mods:\" .. lovely_strings\n    end\n    return info\nend\n\nfunction injectStackTrace()\n    if (stackTraceAlreadyInjected) then\n        return\n    end\n    stackTraceAlreadyInjected = true\n    local STP = loadStackTracePlus()\n    local utf8 = require(\"utf8\")\n\n    -- Modifed from https://love2d.org/wiki/love.errorhandler\n    function love.errorhandler(msg)\n        msg = tostring(msg)\n\n        if not sendErrorMessage then\n            function sendErrorMessage(msg)\n                print(msg)\n            end\n        end\n        if not sendInfoMessage then\n            function sendInfoMessage(msg)\n                print(msg)\n            end\n        end\n\n        sendErrorMessage(\"Oops! The game crashed\\n\" .. STP.stacktrace(msg), 'StackTrace')\n\n        if not love.window or not love.graphics or not love.event then\n            return\n        end\n\n        if not love.graphics.isCreated() or not love.window.isOpen() then\n            local success, status = pcall(love.window.setMode, 800, 600)\n            if not success or not status then\n                return\n            end\n        end\n\n        -- Reset state.\n        if love.mouse then\n            love.mouse.setVisible(true)\n            love.mouse.setGrabbed(false)\n            love.mouse.setRelativeMode(false)\n            if love.mouse.isCursorSupported() then\n                love.mouse.setCursor()\n            end\n        end\n        if love.joystick then\n            -- Stop all joystick vibrations.\n            for i, v in ipairs(love.joystick.getJoysticks()) do\n                v:setVibration()\n            end\n        end\n        if love.audio then\n            love.audio.stop()\n        end\n\n        love.graphics.reset()\n        local font = love.graphics.setNewFont(\"resources/fonts/m6x11plus.ttf\", 20)\n\n        local background = {0, 0, 1}\n        if G and G.C and G.C.BLACK then\n            background = G.C.BLACK\n        end\n        love.graphics.clear(background)\n        love.graphics.origin()\n\n        local trace = STP.stacktrace(\"\", 3)\n\n        local sanitizedmsg = {}\n        for char in msg:gmatch(utf8.charpattern) do\n            table.insert(sanitizedmsg, char)\n        end\n        sanitizedmsg = table.concat(sanitizedmsg)\n\n        local err = {}\n\n        if not smods_dupe then table.insert(err, \"Oops! The game crashed:\") end\n        \n        if smods_dupe then\n            table.insert(err, 'Duplicate installation of Steamodded detected! \\n\\nPlease remove the duplicate steamodded/smods folder/zip in your mods folder.\\n\\nPossible location: ' .. smods_dupe)\n        elseif sanitizedmsg:find(\"Syntax error: game.lua:4: '=' expected near 'Game'\") then\n            table.insert(err,\n                'Duplicate installation of Steamodded detected! Please clean your installation: Steam Library > Balatro > Properties > Installed Files > Verify integrity of game files.')\n        elseif sanitizedmsg:find(\"Syntax error: game.lua:%d+: duplicate label 'continue'\") then\n            table.insert(err,\n                'Duplicate installation of Steamodded detected! Please remove the duplicate steamodded/smods folder in your mods folder.')\n        else\n            table.insert(err, sanitizedmsg)\n        end\n        if #sanitizedmsg ~= #msg then\n            table.insert(err, \"Invalid UTF-8 string in error message.\")\n        end\n\n        if V and SMODS and SMODS.save_game and V(SMODS.save_game or '0.0.0') ~= V(SMODS.version or '0.0.0') then\n            table.insert(err, 'This crash may be caused by continuing a run that was started on a previous version of Steamodded. Try creating a new run.')\n        end\n\n        if V and V(MODDED_VERSION or '0.0.0') ~= V(RELEASE_VERSION or '0.0.0') then\n            table.insert(err, '\\n\\nDevelopment version of Steamodded detected! If you are not actively developing a mod, please try using the latest release instead.\\n\\n')\n        end\n\n        if not V and not smods_dupe then\n            table.insert(err, '\\nA mod you have installed has caused a syntax error through patching. Please share this crash with the mod developer.\\n')            \n        end\n\n        local success, msg = pcall(getDebugInfoForCrash)\n        if smods_dupe then\n            trace = ''\n        elseif success and msg then\n            table.insert(err, '\\n' .. msg)\n            sendInfoMessage(msg, 'StackTrace')\n        else\n            table.insert(err, \"\\n\" .. \"Failed to get additional context :/\")\n            sendErrorMessage(\"Failed to get additional context :/\\n\" .. msg, 'StackTrace')\n        end\n\n        for l in trace:gmatch(\"(.-)\\n\") do\n            table.insert(err, l)\n        end\n\n        local p = table.concat(err, \"\\n\")\n\n        p = p:gsub(\"\\t\", \"\")\n        p = p:gsub(\"%[string \\\"(.-)\\\"%]\", \"%1\")\n\n        local scrollOffset = 0\n        local endHeight = 0\n        love.keyboard.setKeyRepeat(true)\n\n        local function scrollDown(amt)\n            if amt == nil then\n                amt = 18\n            end\n            scrollOffset = scrollOffset + amt\n            if scrollOffset > endHeight then\n                scrollOffset = endHeight\n            end\n        end\n\n        local function scrollUp(amt)\n            if amt == nil then\n                amt = 18\n            end\n            scrollOffset = scrollOffset - amt\n            if scrollOffset < 0 then\n                scrollOffset = 0\n            end\n        end\n\n        local pos = 70\n        local arrowSize = 20\n\n        local function calcEndHeight()\n            local font = love.graphics.getFont()\n            local rw, lines = font:getWrap(p, love.graphics.getWidth() - pos * 2)\n            local lineHeight = font:getHeight()\n            local atBottom = scrollOffset == endHeight and scrollOffset ~= 0\n            endHeight = #lines * lineHeight - love.graphics.getHeight() + pos * 2\n            if (endHeight < 0) then\n                endHeight = 0\n            end\n            if scrollOffset > endHeight or atBottom then\n                scrollOffset = endHeight\n            end\n        end\n\n        local function draw()\n            if not love.graphics.isActive() then\n                return\n            end\n            love.graphics.clear(background)\n            calcEndHeight()\n            love.graphics.printf(p, pos, pos - scrollOffset, love.graphics.getWidth() - pos * 2)\n            if scrollOffset ~= endHeight then\n                love.graphics.polygon(\"fill\", love.graphics.getWidth() - (pos / 2),\n                    love.graphics.getHeight() - arrowSize, love.graphics.getWidth() - (pos / 2) + arrowSize,\n                    love.graphics.getHeight() - (arrowSize * 2), love.graphics.getWidth() - (pos / 2) - arrowSize,\n                    love.graphics.getHeight() - (arrowSize * 2))\n            end\n            if scrollOffset ~= 0 then\n                love.graphics.polygon(\"fill\", love.graphics.getWidth() - (pos / 2), arrowSize,\n                    love.graphics.getWidth() - (pos / 2) + arrowSize, arrowSize * 2,\n                    love.graphics.getWidth() - (pos / 2) - arrowSize, arrowSize * 2)\n            end\n            love.graphics.present()\n        end\n\n        local fullErrorText = p\n        local function copyToClipboard()\n            if not love.system then\n                return\n            end\n            love.system.setClipboardText(fullErrorText)\n            p = p .. \"\\nCopied to clipboard!\"\n        end\n\n        p = p .. \"\\n\\nPress ESC to exit\\nPress R to restart the game\"\n        if love.system then\n            p = p .. \"\\nPress Ctrl+C or tap to copy this error\"\n        end\n\n        if G then\n            -- Kill threads (makes restarting possible)\n            if G.SOUND_MANAGER and G.SOUND_MANAGER.channel then\n                G.SOUND_MANAGER.channel:push({\n                    type = 'kill'\n                })\n            end\n            if G.SAVE_MANAGER and G.SAVE_MANAGER.channel then\n                G.SAVE_MANAGER.channel:push({\n                    type = 'kill'\n                })\n            end\n            if G.HTTP_MANAGER and G.HTTP_MANAGER.channel then\n                G.HTTP_MANAGER.channel:push({\n                    type = 'kill'\n                })\n            end\n        end\n\n        return function()\n            love.event.pump()\n\n            for e, a, b, c in love.event.poll() do\n                if e == \"quit\" then\n                    return a or 0\n                elseif e == \"keypressed\" and a == \"escape\" then\n                    return 1\n                elseif e == \"keypressed\" and a == \"c\" and love.keyboard.isDown(\"lctrl\", \"rctrl\") then\n                    copyToClipboard()\n                elseif e == \"keypressed\" and a == \"r\" then\n                    doRestart()\n                elseif e == \"keypressed\" and a == \"down\" then\n                    scrollDown()\n                elseif e == \"keypressed\" and a == \"up\" then\n                    scrollUp()\n                elseif e == \"keypressed\" and a == \"pagedown\" then\n                    scrollDown(love.graphics.getHeight())\n                elseif e == \"keypressed\" and a == \"pageup\" then\n                    scrollUp(love.graphics.getHeight())\n                elseif e == \"keypressed\" and a == \"home\" then\n                    scrollOffset = 0\n                elseif e == \"keypressed\" and a == \"end\" then\n                    scrollOffset = endHeight\n                elseif e == \"wheelmoved\" then\n                    scrollUp(b * 20)\n                elseif e == \"gamepadpressed\" and b == \"dpdown\" then\n                    scrollDown()\n                elseif e == \"gamepadpressed\" and b == \"dpup\" then\n                    scrollUp()\n                elseif e == \"gamepadpressed\" and b == \"a\" then\n                    doRestart()\n                elseif e == \"gamepadpressed\" and b == \"x\" then\n                    copyToClipboard()\n                elseif e == \"gamepadpressed\" and (b == \"b\" or b == \"back\" or b == \"start\") then\n                    return 1\n                elseif e == \"touchpressed\" then\n                    local name = love.window.getTitle()\n                    if #name == 0 or name == \"Untitled\" then\n                        name = \"Game\"\n                    end\n                    local buttons = {\"OK\", \"Cancel\", \"Restart\"}\n                    if love.system then\n                        buttons[4] = \"Copy to clipboard\"\n                    end\n                    local pressed = love.window.showMessageBox(\"Quit \" .. name .. \"?\", \"\", buttons)\n                    if pressed == 1 then\n                        return 1\n                    elseif pressed == 3 then\n                        doRestart()\n                    elseif pressed == 4 then\n                        copyToClipboard()\n                    end\n                end\n            end\n\n            draw()\n\n            if love.timer then\n                love.timer.sleep(0.1)\n            end\n        end\n\n    end\nend\n\ninjectStackTrace()\n\n-- ----------------------------------------------\n-- --------MOD CORE API STACKTRACE END-----------\n"}},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="copy",["t"]={"main.lua"},["position"]="append",["contents"]={"assert(SMODS.path, \"SMODS was not properly setup.\\n\\n!!!!!!!!!!!!!!\\nPlease make sure your lovely is up to date (Minimum lovely v0.9.0)\\n!!!!!!!!!!!!!!\")\nfor _, path in ipairs {\n    \"src/ui.lua\",\n    \"src/index.lua\",\n    \"src/utils.lua\",\n    \"src/overrides.lua\",\n    \"src/game_object.lua\",\n    \"src/compat_0_9_8.lua\",\n    \"src/utils/weights.lua\"\n} do\n    assert(load(SMODS.NFS.read(SMODS.path..path), ('=[SMODS _ \"%s\"]'):format(path)))()\nend\n\nfunction boot_print_stage(stage)\n    if not SMODS.booted then\n        boot_timer(nil, \"STEAMODDED - \" .. stage, 0.95)\n    end\nend\n\nlocal catimg = NFS.getInfo(SMODS.path..\"assets/cat.png\") and love.graphics.newImage(love.filesystem.newFileData(NFS.read(SMODS.path..\"assets/cat.png\")))\nfunction boot_timer(_label, _next, progress)\n    progress = progress or 0\n    G.LOADING = G.LOADING or {\n        font = love.graphics.setNewFont(\"resources/fonts/m6x11plus.ttf\", 20),\n        love.graphics.dis\n    }\n    local realw, realh = love.window.getMode()\n    love.graphics.setCanvas()\n    love.graphics.push()\n    love.graphics.setShader()\n    love.graphics.clear(0, 0, 0, 1)\n    love.graphics.setColor(0.6, 0.8, 0.9, 1)\n    if progress > 0 then love.graphics.rectangle('fill', realw / 2 - 150, realh / 2 - 15, progress * 300, 30, 5) end\n    love.graphics.setColor(1, 1, 1, 1)\n    love.graphics.setLineWidth(3)\n    love.graphics.rectangle('line', realw / 2 - 150, realh / 2 - 15, 300, 30, 5)\n    if catimg then love.graphics.draw(catimg, realw/2 - 264, realh/2 - 27, 0, 1, 1); love.graphics.rectangle('line', realw/2 - 264, realh/2 - 27, 96, 96, 5) end\n    love.graphics.print(\"LOADING: \" .. _next, realw / 2 - 150, realh / 2 + 40)\n    love.graphics.pop()\n    love.graphics.present()\n\n    G.ARGS.bt = G.ARGS.bt or love.timer.getTime()\n    G.ARGS.bt = love.timer.getTime()\nend\nsendInfoMessage(\"Steamodded v\" .. SMODS.version, \"SMODS\")\n\n"}},{["mod"]="HandyBalatro",["id"]="Handy",["k"]="copy",["t"]={"main.lua"},["position"]="append",["contents"]={"to_big = to_big or function(x)\n\009return x\nend\nto_number = to_number or function(x)\n\009return x\nend\nis_big = is_big or function(x)\n\009return false\nend\n\nif not Handy then\n\009Handy = setmetatable({\n\009\009version = \"1.5.1o\",\n\n\009\009last_clicked_area = nil,\n\009\009last_clicked_card = nil,\n\n\009\009last_hovered_area = nil,\n\009\009last_hovered_card = nil,\n\n\009\009modules = {},\n\n\009\009meta = {\n\009\009\009[\"1.4.1b_patched_select_blind_and_skip\"] = true,\n\009\009\009[\"1.5.0_update\"] = true,\n\009\009\009[\"1.5.1a_multiplayer_check\"] = true,\n\009\009},\n\009}, {})\n\n\009function Handy.is_stop_use()\n\009\009return G.CONTROLLER.locked or G.CONTROLLER.locks.frame or (G.GAME and (G.GAME.STOP_USE or 0) > 0)\n\009end\n\n\009function Handy.is_in_multiplayer()\n\009\009return not not (MP and MP.LOBBY and MP.LOBBY.code)\n\009end\n\n\009function Handy.register_module(key, mod_module)\n\009\009Handy.modules[key] = mod_module\n\009end\n\n\009--\n\n\009require(\"handy/utils\")\n\009require(\"handy/config\")\n\009require(\"handy/fake_events\")\n\009require(\"handy/controller\")\n\009require(\"handy/ui\")\n\009require(\"handy/presets\")\n\n\009require(\"handy/controls/presets_switch\")\n\009require(\"handy/controls/insta_cash_out\")\n\009require(\"handy/controls/insta_booster_skip\")\n\009require(\"handy/controls/deselect_hand\")\n\009require(\"handy/controls/show_deck_preview\")\n\009require(\"handy/controls/regular_keybinds\")\n\009require(\"handy/controls/insta_highlight\")\n\009require(\"handy/controls/insta_highlight_entire_f_hand\")\n\009require(\"handy/controls/insta_actions\")\n\009require(\"handy/controls/move_highlight\")\n\009require(\"handy/controls/speed_multiplier\")\n\009require(\"handy/controls/nopeus_interaction\")\n\009require(\"handy/controls/not_just_yet_interaction\")\n\009require(\"handy/controls/animation_skip\")\n\009require(\"handy/controls/scoring_hold\")\n\n\009require(\"handy/controls/dangerous_actions\")\n\n\009require(\"handy/controls/misc\")\n\n\009--\n\n\009local init_localization_ref = init_localization\n\009function init_localization(...)\n\009\009if not G.localization.__handy_injected then\n\009\009\009local en_loc = require(\"handy/localization/en-us\")\n\009\009\009Handy.utils.table_merge(G.localization, en_loc)\n\009\009\009Handy.UI.cache_config_dictionary_search()\n\009\009\009if G.SETTINGS.language ~= \"en-us\" then\n\009\009\009\009local success, current_loc = pcall(function()\n\009\009\009\009\009return require(\"handy/localization/\" .. G.SETTINGS.language)\n\009\009\009\009end)\n\009\009\009\009-- local missing_keys = Handy.utils.deep_missing_keys(en_loc, current_loc)\n\009\009\009\009-- for _, missing_key in ipairs(missing_keys) do\n\009\009\009\009-- \009print(\"Missing key: \" .. missing_key)\n\009\009\009\009-- end\n\009\009\009\009if success and current_loc then\n\009\009\009\009\009Handy.utils.table_merge(G.localization, current_loc)\n\009\009\009\009\009Handy.UI.cache_config_dictionary_search(true)\n\009\009\009\009end\n\009\009\009end\n\009\009\009G.localization.__handy_injected = true\n\009\009end\n\009\009return init_localization_ref(...)\n\009end\n\n\009local card_area_emplace_ref = CardArea.emplace\n\009function CardArea:emplace(...)\n\009\009self.cards = self.cards or {}\n\009\009return card_area_emplace_ref(self, ...)\n\009end\n\n\009local card_area_align_cards_ref = CardArea.align_cards\n\009function CardArea:align_cards(...)\n\009\009self.children = self.children or {}\n\009\009return card_area_align_cards_ref(self, ...)\n\009end\n\n\009local game_start_up_ref = Game.start_up\n\009function Game:start_up(...)\n\009\009local result = game_start_up_ref(self, ...)\n\009\009G.CONTROLLER.saved_axis_cursor_speed = G.CONTROLLER.axis_cursor_speed\n\009\009G.CONTROLLER.axis_cursor_speed = G.CONTROLLER.saved_axis_cursor_speed * Handy.cc.controller_sensivity.mult\n\009\009G.E_MANAGER:add_event(Event({\n\009\009\009no_delete = true,\n\009\009\009blocking = false,\n\009\009\009func = function()\n\009\009\009\009G.E_MANAGER:add_event(Event({\n\009\009\009\009\009no_delete = true,\n\009\009\009\009\009blocking = false,\n\009\009\009\009\009func = function()\n\009\009\009\009\009\009Handy.speed_multiplier.load_default_value()\n\009\009\009\009\009\009Handy.animation_skip.load_default_value()\n\009\009\009\009\009\009return true\n\009\009\009\009\009end,\n\009\009\009\009}))\n\009\009\009\009return true\n\009\009\009end,\n\009\009}))\n\009\009return result\n\009end\n\n\009--\n\n\009function Handy.emplace_steamodded()\n\009\009if Handy.current_mod then\n\009\009\009return\n\009\009end\n\009\009Handy.current_mod = (Handy_Preload and Handy_Preload.current_mod) or SMODS.current_mod\n\009\009Handy.UI.show_options_button = not Handy.cc.hide_options_button.enabled\n\n\009\009-- Config tabs\n\009\009Handy.current_mod.config_tab = function()\n\009\009\009return Handy.UI.get_options_tabs()[1].tab_definition_function\n\009\009end\n\009\009Handy.current_mod.extra_tabs = function()\n\009\009\009local result = Handy.UI.get_options_tabs()\n\009\009\009table.remove(result, 1)\n\009\009\009return result\n\009\009end\n\n\009\009-- NotJustYet\n\009\009G.E_MANAGER:add_event(Event({\n\009\009\009blocking = false,\n\009\009\009func = function()\n\009\009\009\009G.njy_keybind = nil\n\009\009\009\009if MP and G.FUNCS.lobby_info then\n\009\009\009\009\009local lobby_info_ref = G.FUNCS.lobby_info\n\009\009\009\009\009function G.FUNCS.lobby_info(...)\n\009\009\009\009\009\009Handy.regular_keybinds.toggle_swappable_overlay(true)\n\009\009\009\009\009\009return lobby_info_ref(...)\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009\009return true\n\009\009\009end,\n\009\009}))\n\n\009\009-- Animation skip setup\n\009\009local smods_calculate_effect_ref = SMODS.calculate_effect or function() end\n\009\009function SMODS.calculate_effect(effect, ...)\n\009\009\009if Handy.animation_skip.should_skip_animation() then\n\009\009\009\009effect.juice_card = nil\n\009\009\009end\n\009\009\009return smods_calculate_effect_ref(effect, ...)\n\009\009end\n\009\009if (SMODS.Mods and SMODS.Mods[\"Talisman\"] or {}).can_load then\n\009\009\009local nuGC_ref = nuGC\n\009\009\009function nuGC(time_budget, ...)\n\009\009\009\009if G.STATE == G.STATES.HAND_PLAYED then\n\009\009\009\009\009time_budget = 0.0333\n\009\009\009\009end\n\009\009\009\009return nuGC_ref(time_budget, ...)\n\009\009\009end\n\009\009end\n\n\009\009if Handy_Preload then\n\009\009\009Handy_Preload = nil\n\009\009end\n\009end\n\n\009if Handy_Preload then\n\009\009Handy.emplace_steamodded()\n\009end\nend\n"}},{["mod"]="Amulet",["id"]="Amulet",["k"]="copy",["t"]={"main.lua"},["position"]="append",["contents"]={"local ffi = require(\"ffi\")\nffi.cdef[[int PHYSFS_mount(const char* dir, const char* mountPoint, int appendToPath)]]\nlocal tinymount = (pcall(function() return ffi.C.PHYSFS_mount end) and ffi.C or ffi.load(\"love\")).PHYSFS_mount\n\nlocal talisman_path = _mod_dir_amulet\nassert(tinymount(talisman_path .. '/talisman', 'talisman', 0) ~= 0, 'Amulet: Failed to mount talisman from ' .. talisman_path)\nassert(tinymount(talisman_path .. '/big-num', 'big-num', 0) ~= 0, 'Amulet: Failed to mount big-num from ' .. talisman_path)\n\nrequire(\"talisman.configinit\")\nrequire(\"talisman.effects\")\nrequire(\"talisman.globals\")\nrequire(\"talisman.localization\")\nrequire(\"talisman.configtab\")\nrequire(\"talisman.noanims\")\nrequire(\"talisman.gradients\")\nrequire(\"talisman.sanitizer\")\nrequire(\"talisman.debug\")\nif not Talisman.config_file.disable_omega then\n    require(\"talisman.break_inf\")\nend\nif not Talisman.F_NO_COROUTINE then\n    require(\"talisman.coroutine\")\nend\n"}},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="copy",["t"]={"globals.lua"},["position"]="append",["contents"]={"-- Global values that must be present for the rest of this mod to work.\n\nif not FN then FN = {} end\n\nFN.SIM = {\n\009JOKERS = {},\n\n\009running = {\n\009\009--- Table to store workings (ie. running totals):\n\009\009min = { chips = 0, mult = 0, dollars = 0 },\n\009\009exact = { chips = 0, mult = 0, dollars = 0 },\n\009\009max = { chips = 0, mult = 0, dollars = 0 },\n\009\009reps = 0,\n\009},\n\n\009env = {\n\009\009--- Table to store data about the simulated play:\n\009\009jokers = {}, -- Derived from G.jokers.cards\n\009\009played_cards = {}, -- Derived from G.hand.highlighted\n\009\009scoring_cards = {}, -- Derived according to evaluate_play()\n\009\009held_cards = {}, -- Derived from G.hand minus G.hand.highlighted\n\009\009consumables = {}, -- Derived from G.consumeables.cards\n\009\009scoring_name = \"\", -- Derived according to evaluate_play()\n\009},\n\n\009orig = {\n\009\009--- Table to store game data that gets modified during simulation:\n\009\009random_data = {}, -- G.GAME.pseudorandom\n\009\009hand_data = {}, -- G.GAME.hands\n\009},\n\n\009misc = {\n\009\009--- Table to store ancillary status variables:\n\009\009next_stone_id = -1,\n\009},\n}\n","-- Global values that must be present for the rest of this mod to work.\n\nif not FN then FN = {} end\n\nFN.PRE = {\n\009data = {\n\009\009score = { min = 0, exact = 0, max = 0 },\n\009\009dollars = { min = 0, exact = 0, max = 0 },\n        empty = true,\n\009},\n\009text = {\n\009\009score = { l = \"\", r = \"\", m = \"\" },\n\009\009dollars = { top = \"\", bot = \"\" },\n\009},\n\009joker_order = {},\n\009hand_order = {},\n\009show_preview = false,\n\009lock_updates = false,\n\009on_startup = true,\n\009five_second_coroutine = nil,\n    calculate_request = nil,\n}\n\n\nfunction FN.PRE.start_new_coroutine()\n    -- Defaults are vanilla: free preview, slow (5s) delay.\n    -- Layers like pressure_timer set both via ruleset scalars.\n    local timer_delay, timer_cost = 0, 0\n    if MP.LOBBY and MP.LOBBY.code and MP.LOBBY.config.timer and not MP.is_pvp_boss() then\n        timer_delay = 5\n        timer_cost = 0\n\n        local ruleset = MP.current_ruleset()\n        timer_delay = MP.LOBBY.config.preview_calculate_delay or ruleset.preview_calculate_delay or timer_delay\n        timer_cost  = MP.LOBBY.config.preview_calculate_cost or ruleset.preview_calculate_cost or timer_cost\n    end\n\n    if not FN.PRE.calculate_request then\n        FN.PRE.lock_updates = true\n        FN.PRE.show_preview = true\n        local func = function()\n            FN.PRE.calculate_request = nil\n            FN.PRE.lock_updates = false\n            FN.PRE.show_preview = true\n            FN.PRE.data = FN.PRE.simulate()\n\n            -- Subtract cost from timer (only if there's a cost â€” vanilla preview is free).\n            -- Min-clamp prevents an over-zealous calc from killing the player outright.\n            if\n                timer_cost > 0\n                and FN.PRE.data and not FN.PRE.data.empty\n                and MP.LOBBY.code and not MP.is_pvp_boss()\n                and MP.LOBBY.config.timer\n                and not MP.GAME.timer_started\n                and not MP.GAME.nemesis_timer_started\n                and not MP.GAME.timer_consumed\n            then\n                MP.UI.consume_timer(timer_cost, nil, 10)\n            end\n            return true\n        end\n        FN.PRE.calculate_request = Event({\n            trigger = \"after\", delay = timer_delay, timer = \"REAL\",\n            blockable = false, blocking = false,\n            func = func\n        })\n        G.E_MANAGER:add_event(FN.PRE.calculate_request)\n    end\nend\n\nfunction FN.PRE.stop_current_coroutine(no_interrupt)\n    if not MP.INTEGRATIONS.Preview then return end\n    if no_interrupt and FN.PRE.lock_updates then return end\n    if FN.PRE.show_preview then\n        FN.PRE.show_preview = false\n        FN.PRE.data = FN.PRE.cleanup()\n    end\n    if FN.PRE.calculate_request then\n        FN.PRE.calculate_request.func = function() return true end\n        FN.PRE.calculate_request.complete = true\n        FN.PRE.calculate_request = nil\n        FN.PRE.lock_updates = false\n    end\nend\n\n--[[\nfunction FN.PRE.start_new_coroutine()\n\009if FN.PRE.five_second_coroutine and coroutine.status(FN.PRE.five_second_coroutine) ~= \"dead\" then\n\009\009FN.PRE.five_second_coroutine = nil -- Reset the coroutine\n\009end\n\n\009-- Create and start a new coroutine\n\009FN.PRE.five_second_coroutine = coroutine.create(function()\n\009\009-- Show UI updates\n\009\009FN.PRE.lock_updates = true\n\009\009FN.PRE.show_preview = true\n\009\009FN.PRE.add_update_event(\"immediate\") -- Force UI refresh\n\n\009\009local start_time = os.time()\n\009\009if MP.LOBBY.code and not MP.is_pvp_boss() then\n\009\009\009while os.time() - start_time < 5 do\n\009\009\009\009FN.PRE.simulate() -- Force a simulation run\n\009\009\009\009FN.PRE.add_update_event(\"immediate\") -- Ensure UI updates\n\009\009\009\009coroutine.yield() -- Allow game to continue running\n\009\009\009end\n\009\009end\n\009\009-- Delay for 5 seconds\n\009\009FN.PRE.lock_updates = false\n\009\009FN.PRE.show_preview = true\n\009\009FN.PRE.add_update_event(\"immediate\") -- Refresh UI again\n\009end)\n\n\009coroutine.resume(FN.PRE.five_second_coroutine) -- Start it immediately\nend\n]]\n\nFN.PRE._start_up = Game.start_up\nfunction Game:start_up()\n\009FN.PRE._start_up(self)\n\n\009if not MP.INTEGRATIONS.Preview then return end\n\n\009if not G.SETTINGS.FN then G.SETTINGS.FN = {} end\n\009if not G.SETTINGS.FN.PRE then\n\009\009G.SETTINGS.FN.PRE = true\n\n\009\009G.SETTINGS.FN.preview_score = true\n\009\009G.SETTINGS.FN.preview_dollars = true\n\009\009G.SETTINGS.FN.hide_face_down = true\n\009\009G.SETTINGS.FN.show_min_max = true\n\009end\nend\n"}},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="copy",["t"]={"main.lua"},["position"]="append",["contents"]={"-- The functions responsible for running the simulation.\n-- Previously it was doing it after every game state change, which maybe makes sense on SP.\n-- But, since it's Multiplayer-specific version, it shows score only after \"Calculate\" button press and reset after state change.\n\nfunction FN.PRE.cleanup()\n    return { score = { min = 0, exact = 0, max = 0 }, dollars = { min = 0, exact = 0, max = 0 }, empty = true }\nend\n\nfunction FN.PRE.simulate()\n\009-- Guard against simulating in redundant places:\n\009if FN.PRE.five_second_coroutine and coroutine.status(FN.PRE.five_second_coroutine) == \"suspended\" then\n\009\009coroutine.resume(FN.PRE.five_second_coroutine)\n\009end\n\009if\n\009\009not (G.STATE == G.STATES.SELECTING_HAND or G.STATE == G.STATES.DRAW_TO_HAND or G.STATE == G.STATES.PLAY_TAROT)\n\009then\n\009\009return FN.PRE.cleanup()\n\009end\n\n\009if G.SETTINGS.FN.hide_face_down then\n\009\009for _, card in ipairs(G.hand.highlighted) do\n\009\009\009if card.facing == \"back\" then return nil end\n\009\009end\n\009\009if #G.hand.highlighted ~= 0 then\n\009\009\009for _, joker in ipairs(G.jokers.cards) do\n\009\009\009\009if joker.facing == \"back\" then return nil end\n\009\009\009end\n\009\009end\n\009end\n\n\009return FN.SIM.run()\nend\n\n-- SIMULATION UPDATE ADVICE:\n\n-- Update simulation after a consumable (eg. Tarot, Planet) is used:\nlocal orig_use = Card.use_consumeable\nfunction Card:use_consumeable(area, copier)\n\009orig_use(self, area, copier)\n\009FN.PRE.stop_current_coroutine()\nend\n\n-- Update simulation after card selection changed:\nlocal orig_hl = CardArea.parse_highlighted\nfunction CardArea:parse_highlighted()\n\009orig_hl(self)\n\009FN.PRE.stop_current_coroutine(true)\nend\n\n-- Update simulation after card in hand/consumeables/joker slots are removed:\nlocal orig_card_remove = Card.remove_from_area\nfunction Card:remove_from_area()\n\009orig_card_remove(self)\n    if self.area and G.STATE ~= G.STATES.HAND_PLAYED then        \n        if not (self == G.joker or self == G.consumeables or self == G.hand) then return end\n        FN.PRE.stop_current_coroutine()\n    end\nend\n\n-- Update simulation after joker reordering:\nlocal orig_update = CardArea.update\nfunction CardArea:update(dt)\n\009orig_update(self, dt)\n\009FN.PRE.update_on_card_order_change(self)\nend\n\nfunction FN.PRE.update_on_card_order_change(cardarea)\n    if not MP.INTEGRATIONS.Preview then return end\n    if not (cardarea == G.joker or cardarea == G.hand) then return end\n\009if\n        not cardarea.cards\n\009\009or #cardarea.cards == 0\n\009\009or not (\n\009\009\009G.STATE == G.STATES.SELECTING_HAND\n\009\009\009or G.STATE == G.STATES.DRAW_TO_HAND\n\009\009\009or G.STATE == G.STATES.PLAY_TAROT\n\009\009)\n\009then\n\009\009return\n\009end\n\009-- Important not to update on G.STATES.HAND_PLAYED, because it would reset the preview text!\n\009if G.STATE == G.STATES.HAND_PLAYED then return end\n\n\009local prev_order = nil\n\009if cardarea.config.type == \"joker\" and cardarea.cards[1].ability.set == \"Joker\" then\n\009\009if cardarea.cards[1].edition and cardarea.cards[1].edition.mp_phantom then return end\n\009\009-- Note that the consumables cardarea also has type 'joker' so must verify by checking first card.\n\009\009prev_order = FN.PRE.joker_order\n\009elseif cardarea.config.type == \"hand\" then\n\009\009prev_order = FN.PRE.hand_order\n\009else\n\009\009return\n\009end\n\n\009-- Go through stored card IDs and check against current card IDs, in-order.\n\009-- If any mismatch occurs, toggle flag and update name for next time.\n\009local should_update = false\n\009if #cardarea.cards ~= #prev_order then prev_order = {} end\n\009for i, c in ipairs(cardarea.cards) do\n\009\009if c.sort_id ~= prev_order[i] then\n\009\009\009prev_order[i] = c.sort_id\n\009\009\009should_update = true\n\009\009end\n\009end\n\n\009if should_update then\n\009\009if cardarea.config.type == \"joker\" or cardarea.cards[1].ability.set == \"Joker\" then\n\009\009\009FN.PRE.joker_order = prev_order\n\009\009elseif cardarea.config.type == \"hand\" then\n\009\009\009FN.PRE.hand_order = prev_order\n\009\009end\n\009\009FN.PRE.stop_current_coroutine(true)\n\009end\nend\n\n-- SIMULATION RESET ADVICE:\n\nlocal orig_eval = G.FUNCS.evaluate_play\nfunction G.FUNCS.evaluate_play(e)\n\009orig_eval(e)\n\n    G.E_MANAGER:add_event(Event({\n        blocking = false,\n        func = function()\n            FN.PRE.stop_current_coroutine()\n            return true\n        end\n    }))\nend\n\nlocal orig_discard = G.FUNCS.discard_cards_from_highlighted\nfunction G.FUNCS.discard_cards_from_highlighted(e, is_hook_blind)\n\009-- Carbon: capture which hand slots are discarded BEFORE orig_discard consumes\n\009-- them. is_hook_blind means a programmatic discard (blind effect), not a click.\n\009local discarded = (not is_hook_blind) and MP.UTILS.highlighted_hand_indices() or nil\n\009orig_discard(e, is_hook_blind)\n\n\009if not is_hook_blind then\n\009\009if discarded and #discarded > 0 then\n\009\009\009MP.RLOG.record(\"discard\", { discarded }, \"action:discard,cards:\" .. table.concat(discarded, \".\"))\n\009\009end\n\009\009FN.PRE.stop_current_coroutine()\n\009end\nend\n\n-- USER INTERFACE ADVICE:\n\n-- Add animation to preview text:\nfunction G.FUNCS.fn_pre_score_UI_set(e)\n\009local new_preview_text = \"\"\n\009local should_juice = false\n\009if FN.PRE.lock_updates then\n\009\009if e.config.id == \"fn_pre_m\" then\n\009\009\009new_preview_text = \" \" .. MP.UTILS.get_preview_cfg(\"text\") .. \" \"\n\009\009\009should_juice = true\n\009\009end\n\009else\n\009\009if FN.PRE.data then\n\009\009\009if FN.PRE.show_preview and (FN.PRE.data.score.min ~= FN.PRE.data.score.max) then\n\009\009\009\009-- Format as 'X - Y' :\n\009\009\009\009if e.config.id == \"fn_pre_m\" then\n                    new_preview_text = \" - \"\n\009\009\009\009\009if FN.PRE.is_enough_to_win(FN.PRE.data.score.min) then should_juice = true end\n                elseif e.config.id == \"fn_pre_l\" then\n\009\009\009\009\009new_preview_text = FN.PRE.format_number(FN.PRE.data.score.min)\n\009\009\009\009\009if FN.PRE.is_enough_to_win(FN.PRE.data.score.min) then should_juice = true end\n\009\009\009\009elseif e.config.id == \"fn_pre_r\" then\n\009\009\009\009\009new_preview_text = FN.PRE.format_number(FN.PRE.data.score.max)\n\009\009\009\009\009if FN.PRE.is_enough_to_win(FN.PRE.data.score.max) then should_juice = true end\n\009\009\009\009end\n\009\009\009else\n\009\009\009\009-- Format as single number:\n\009\009\009\009if e.config.id == \"fn_pre_l\" then\n\009\009\009\009\009if true then\n\009\009\009\009\009\009-- Spaces around number necessary to distinguish Min/Max text from Exact text,\n\009\009\009\009\009\009-- which is itself necessary to force a HUD update when switching between Min/Max and Exact.\n\009\009\009\009\009\009if FN.PRE.show_preview then\n\009\009\009\009\009\009\009new_preview_text = FN.PRE.format_number(FN.PRE.data.score.min)\n\009\009\009\009\009\009\009if FN.PRE.is_enough_to_win(FN.PRE.data.score.min) then should_juice = true end\n\009\009\009\009\009\009else\n\009\009\009\009\009\009\009if FN.PRE.is_enough_to_win(FN.PRE.data.score.min) then\n\009\009\009\009\009\009\009\009should_juice = true\n\009\009\009\009\009\009\009\009new_preview_text = \"  \"\n\009\009\009\009\009\009\009else\n\009\009\009\009\009\009\009\009if FN.PRE.is_enough_to_win(FN.PRE.data.score.max) then\n\009\009\009\009\009\009\009\009\009new_preview_text = \"  \"\n\009\009\009\009\009\009\009\009\009should_juice = true\n\009\009\009\009\009\009\009\009else\n\009\009\009\009\009\009\009\009\009new_preview_text = \"  \"\n\009\009\009\009\009\009\009\009end\n\009\009\009\009\009\009\009end\n\009\009\009\009\009\009end\n\009\009\009\009\009end\n\009\009\009\009else\n\009\009\009\009\009new_preview_text = \"\"\n\009\009\009\009end\n\009\009\009end\n\009\009else\n\009\009\009-- Spaces around number necessary to distinguish Min/Max text from Exact text, same as above ^\n\009\009\009if e.config.id == \"fn_pre_l\" then\n\009\009\009\009if true then\n\009\009\009\009\009new_preview_text = \" ?????? \"\n\009\009\009\009else\n\009\009\009\009\009new_preview_text = \"??????\"\n\009\009\009\009end\n\009\009\009else\n\009\009\009\009new_preview_text = \"\"\n\009\009\009end\n\009\009end\n\009end\n\n\009if (not FN.PRE.text.score[e.config.id:sub(-1)]) or new_preview_text ~= FN.PRE.text.score[e.config.id:sub(-1)] then\n\009\009FN.PRE.text.score[e.config.id:sub(-1)] = new_preview_text\n        e.config.object.scale = e.config.object.config.scale\n\009\009e.config.object:update_text()\n        if e.config.object.config.maxw then\n            e.config.object.scale = e.config.object.config.scale * math.min(1, e.config.object.config.maxw/e.config.object.config.W)\n            e.config.object:update_text(true)\n        end\n\009\009-- Wobble:\n\009\009if not G.TAROT_INTERRUPT_PULSE then\n\009\009\009if should_juice then\n\009\009\009\009G.FUNCS.text_super_juice(e, 5)\n\009\009\009\009e.config.object.colours = { G.C.MONEY }\n\009\009\009else\n\009\009\009\009G.FUNCS.text_super_juice(e, 0)\n\009\009\009\009e.config.object.colours = { G.C.UI.TEXT_LIGHT }\n\009\009\009end\n\009\009end\n\009end\nend\n\nfunction G.FUNCS.fn_pre_dollars_UI_set(e)\n\009local new_preview_text = \"\"\n\009local new_colour = nil\n\009if FN.PRE.data then\n\009\009if true and (FN.PRE.data.dollars.min ~= FN.PRE.data.dollars.max) then\n\009\009\009if e.config.id == \"fn_pre_dollars_top\" then\n\009\009\009\009new_preview_text = \" \" .. FN.PRE.get_sign_str(FN.PRE.data.dollars.max) .. FN.PRE.data.dollars.max\n\009\009\009\009new_colour = FN.PRE.get_dollar_colour(FN.PRE.data.dollars.max)\n\009\009\009elseif e.config.id == \"fn_pre_dollars_bot\" then\n\009\009\009\009new_preview_text = \" \" .. FN.PRE.get_sign_str(FN.PRE.data.dollars.min) .. FN.PRE.data.dollars.min\n\009\009\009\009new_colour = FN.PRE.get_dollar_colour(FN.PRE.data.dollars.min)\n\009\009\009end\n\009\009else\n\009\009\009if e.config.id == \"fn_pre_dollars_top\" then\n\009\009\009\009local _data = G.SETTINGS.FN.show_min_max and FN.PRE.data.dollars.min or FN.PRE.data.dollars.exact\n\n\009\009\009\009new_preview_text = \" \" .. FN.PRE.get_sign_str(_data) .. _data\n\009\009\009\009new_colour = FN.PRE.get_dollar_colour(_data)\n\009\009\009else\n\009\009\009\009new_preview_text = \"\"\n\009\009\009\009new_colour = FN.PRE.get_dollar_colour(0)\n\009\009\009end\n\009\009end\n\009else\n\009\009new_preview_text = \" +??\"\n\009\009new_colour = FN.PRE.get_dollar_colour(0)\n\009end\n\n\009if not FN.PRE.text.dollars[e.config.id:sub(-3)] or new_preview_text ~= FN.PRE.text.dollars[e.config.id:sub(-3)] then\n\009\009FN.PRE.text.dollars[e.config.id:sub(-3)] = new_preview_text\n\009\009e.config.object.colours = { new_colour }\n        e.config.object.scale = e.config.object.config.scale\n\009\009e.config.object:update_text()\n        if e.config.object.config.maxw then\n            e.config.object.scale = e.config.object.config.scale * math.min(1, e.config.object.config.maxw/e.config.object.config.W)\n            e.config.object:update_text(true)\n        end\n\009\009if not G.TAROT_INTERRUPT_PULSE then e.config.object:pulse(0.25) end\n\009end\nend\n","-- Utilities for checking states and formatting display.\n\nfunction FN.PRE.is_enough_to_win(chips)\n\009if\n\009\009G.GAME.blind\n\009\009and (G.STATE == G.STATES.SELECTING_HAND or G.STATE == G.STATES.DRAW_TO_HAND or G.STATE == G.STATES.PLAY_TAROT)\n\009then\n\009\009return (G.GAME.chips + chips >= G.GAME.blind.chips)\n\009else\n\009\009return false\n\009end\nend\n\nfunction FN.PRE.format_number(num)\n\009if not num or type(num) ~= \"number\" then return num or \"\" end\n\009return number_format(num) -- Default Balatro function.\nend\n\nfunction FN.PRE.get_dollar_colour(n)\n\009if n == 0 then\n\009\009return HEX(\"7e7667\")\n\009elseif n > 0 then\n\009\009return G.C.MONEY\n\009elseif n < 0 then\n\009\009return G.C.RED\n\009end\nend\n\nfunction FN.PRE.get_sign_str(n)\n\009if n >= 0 then\n\009\009return \"+\"\n\009else\n\009\009return \"\" -- Negative numbers already have a sign\n\009end\nend\n\nfunction FN.PRE.enabled()\n\009return G.SETTINGS.FN.preview_score or G.SETTINGS.FN.preview_dollars\nend\n"}},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="copy",["t"]={"functions/common_events.lua"},["position"]="append",["contents"]={"-- The heart of this library: it replicates the game's score evaluation.\n\nif not FN.SIM.run then\n\009function FN.SIM.run()\n\009\009local null_ret = { score = { min = 0, exact = 0, max = 0 }, dollars = { min = 0, exact = 0, max = 0 }, empty = true }\n\009\009if #G.hand.highlighted < 1 then return null_ret end\n\n\009\009FN.SIM.init()\n\n\009\009FN.SIM.manage_state(\"SAVE\")\n\009\009FN.SIM.update_state_variables()\n\n\009\009if not FN.SIM.simulate_blind_debuffs() then\n\009\009\009FN.SIM.simulate_joker_before_effects()\n\009\009\009FN.SIM.add_base_chips_and_mult()\n\009\009\009FN.SIM.simulate_blind_effects()\n\009\009\009FN.SIM.simulate_scoring_cards()\n\009\009\009FN.SIM.simulate_held_cards()\n\009\009\009FN.SIM.simulate_joker_global_effects()\n\009\009\009FN.SIM.simulate_consumable_effects()\n\009\009\009FN.SIM.simulate_deck_effects()\n\009\009else -- Only Matador at this point:\n\009\009\009FN.SIM.simulate_all_jokers(G.jokers, { debuffed_hand = true })\n\009\009end\n\n\009\009FN.SIM.manage_state(\"RESTORE\")\n\n\009\009return FN.SIM.get_results()\n\009end\n\n\009function FN.SIM.init()\n\009\009-- Reset:\n\009\009FN.SIM.running = {\n\009\009\009min = { chips = 0, mult = 0, dollars = 0 },\n\009\009\009exact = { chips = 0, mult = 0, dollars = 0 },\n\009\009\009max = { chips = 0, mult = 0, dollars = 0 },\n\009\009\009reps = 0,\n\009\009}\n\n\009\009-- Fetch metadata about simulated play:\n\009\009local hand_name, _, poker_hands, scoring_hand, _ = G.FUNCS.get_poker_hand_info(G.hand.highlighted)\n\009\009FN.SIM.env.scoring_name = hand_name\n\n\009\009-- Identify played cards and extract necessary data:\n\009\009FN.SIM.env.played_cards = {}\n\009\009FN.SIM.env.scoring_cards = {}\n\009\009local is_splash_joker = next(find_joker(\"Splash\"))\n\009\009table.sort(G.hand.highlighted, function(a, b)\n\009\009\009return a.T.x < b.T.x\n\009\009end) -- Sorts by positional x-value to mirror card order!\n\009\009for _, card in ipairs(G.hand.highlighted) do\n\009\009\009local is_scoring = false\n\009\009\009for _, scoring_card in ipairs(scoring_hand) do\n\009\009\009\009-- Either card is scoring because it's part of the scoring hand,\n\009\009\009\009-- or there is Splash joker, or it's a Stone Card:\n\009\009\009\009if card.sort_id == scoring_card.sort_id or is_splash_joker or card.ability.effect == \"Stone Card\" then\n\009\009\009\009\009is_scoring = true\n\009\009\009\009\009break\n\009\009\009\009end\n\009\009\009end\n\n\009\009\009local card_data = FN.SIM.get_card_data(card)\n\009\009\009table.insert(FN.SIM.env.played_cards, card_data)\n\009\009\009if is_scoring then table.insert(FN.SIM.env.scoring_cards, card_data) end\n\009\009end\n\n\009\009-- Identify held cards and extract necessary data:\n\009\009FN.SIM.env.held_cards = {}\n\009\009for _, card in ipairs(G.hand.cards) do\n\009\009\009-- Highlighted cards are simulated as played cards:\n\009\009\009if not card.highlighted then\n\009\009\009\009local card_data = FN.SIM.get_card_data(card)\n\009\009\009\009table.insert(FN.SIM.env.held_cards, card_data)\n\009\009\009end\n\009\009end\n\n\009\009-- Extract necessary joker data:\n\009\009FN.SIM.env.jokers = {}\n\009\009for _, joker in ipairs(G.jokers.cards) do\n\009\009\009local joker_data = {\n\009\009\009\009-- P_CENTER keys for jokers have the form j_NAME, get rid of j_\n\009\009\009\009id = joker.config.center.key:sub(3, #joker.config.center.key),\n\009\009\009\009ability = copy_table(joker.ability),\n\009\009\009\009edition = copy_table(joker.edition),\n\009\009\009\009rarity = joker.config.center.rarity,\n\009\009\009\009debuff = joker.debuff,\n\009\009\009}\n\009\009\009table.insert(FN.SIM.env.jokers, joker_data)\n\009\009end\n\n\009\009-- Extract necessary consumable data:\n\009\009FN.SIM.env.consumables = {}\n\009\009for _, consumable in ipairs(G.consumeables.cards) do\n\009\009\009local consumable_data = {\n\009\009\009\009-- P_CENTER keys have the form x_NAME, get rid of x_\n\009\009\009\009id = consumable.config.center.key:sub(3, #consumable.config.center.key),\n\009\009\009\009ability = copy_table(consumable.ability),\n\009\009\009}\n\009\009\009table.insert(FN.SIM.env.consumables, consumable_data)\n\009\009end\n\n\009\009-- Set extensible context template:\n\009\009FN.SIM.get_context = function(cardarea, args)\n\009\009\009local context = {\n\009\009\009\009cardarea = cardarea,\n\009\009\009\009full_hand = FN.SIM.env.played_cards,\n\009\009\009\009scoring_name = hand_name,\n\009\009\009\009scoring_hand = FN.SIM.env.scoring_cards,\n\009\009\009\009poker_hands = poker_hands,\n\009\009\009}\n\n\009\009\009for k, v in pairs(args) do\n\009\009\009\009context[k] = v\n\009\009\009end\n\n\009\009\009return context\n\009\009end\n\009end\n\n\009function FN.SIM.get_card_data(card_obj)\n\009\009return {\n\009\009\009rank = card_obj.base.id,\n\009\009\009suit = card_obj.base.suit,\n\009\009\009base_chips = card_obj.base.nominal,\n\009\009\009ability = copy_table(card_obj.ability),\n\009\009\009edition = copy_table(card_obj.edition),\n\009\009\009seal = card_obj.seal,\n\009\009\009debuff = card_obj.debuff,\n\009\009\009lucky_trigger = {},\n\009\009}\n\009end\n\n\009function FN.SIM.get_results()\n\009\009local FNSR = FN.SIM.running\n\n\009\009local min_score = math.floor(FNSR.min.chips * FNSR.min.mult)\n\009\009local exact_score = math.floor(FNSR.exact.chips * FNSR.exact.mult)\n\009\009local max_score = math.floor(FNSR.max.chips * FNSR.max.mult)\n\n\009\009return {\n\009\009\009score = { min = min_score, exact = exact_score, max = max_score },\n\009\009\009dollars = { min = FNSR.min.dollars, exact = FNSR.exact.dollars, max = FNSR.max.dollars },\n\009\009}\n\009end\n\n\009--\n\009-- GAME STATE MANAGEMENT:\n\009--\n\n\009function FN.SIM.manage_state(save_or_restore)\n\009\009local FNSO = FN.SIM.orig\n\n\009\009if save_or_restore == \"SAVE\" then\n\009\009\009FNSO.random_data = copy_table(G.GAME.pseudorandom)\n\009\009\009FNSO.hand_data = copy_table(G.GAME.hands)\n\009\009\009return\n\009\009end\n\n\009\009if save_or_restore == \"RESTORE\" then\n\009\009\009G.GAME.pseudorandom = FNSO.random_data\n\009\009\009G.GAME.hands = FNSO.hand_data\n\009\009\009return\n\009\009end\n\009end\n\n\009function FN.SIM.update_state_variables()\n\009\009-- Increment poker hand played this run/round:\n\009\009local hand_info = G.GAME.hands[FN.SIM.env.scoring_name]\n\009\009hand_info.played = hand_info.played + 1\n\009\009hand_info.played_this_round = hand_info.played_this_round + 1\n\009end\n\n\009--\n\009-- MACRO LEVEL:\n\009--\n\n\009function FN.SIM.simulate_scoring_cards()\n\009\009for _, scoring_card in ipairs(FN.SIM.env.scoring_cards) do\n\009\009\009FN.SIM.simulate_card_in_context(scoring_card, G.play)\n\009\009end\n\009end\n\n\009function FN.SIM.simulate_held_cards()\n\009\009for _, held_card in ipairs(FN.SIM.env.held_cards) do\n\009\009\009FN.SIM.simulate_card_in_context(held_card, G.hand)\n\009\009end\n\009end\n\n\009function FN.SIM.simulate_joker_global_effects()\n\009\009for _, joker in ipairs(FN.SIM.env.jokers) do\n\009\009\009if joker.edition then -- Foil and Holo:\n\009\009\009\009if joker.edition.chips then FN.SIM.add_chips(joker.edition.chips) end\n\009\009\009\009if joker.edition.mult then FN.SIM.add_mult(joker.edition.mult) end\n\009\009\009end\n\n\009\009\009FN.SIM.simulate_joker(joker, FN.SIM.get_context(G.jokers, { global = true }))\n\n\009\009\009-- Joker-on-joker effects (eg. Blueprint):\n\009\009\009FN.SIM.simulate_all_jokers(G.jokers, { other_joker = joker })\n\n\009\009\009if joker.edition then -- Poly:\n\009\009\009\009if joker.edition.x_mult then FN.SIM.x_mult(joker.edition.x_mult) end\n\009\009\009end\n\009\009end\n\009end\n\n\009function FN.SIM.simulate_consumable_effects()\n\009\009for _, consumable in ipairs(FN.SIM.env.consumables) do\n\009\009\009if consumable.ability.set == \"Planet\" and not consumable.debuff then\n\009\009\009\009if\n\009\009\009\009\009G.GAME.used_vouchers.v_observatory\n\009\009\009\009\009and consumable.ability.consumeable.hand_type == FN.SIM.env.scoring_name\n\009\009\009\009then\n\009\009\009\009\009FN.SIM.x_mult(G.P_CENTERS.v_observatory.config.extra)\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\009end\n\n\009function FN.SIM.add_base_chips_and_mult()\n\009\009local played_hand_data = G.GAME.hands[FN.SIM.env.scoring_name]\n\009\009FN.SIM.add_chips(played_hand_data.chips)\n\009\009FN.SIM.add_mult(played_hand_data.mult)\n\009end\n\n\009function FN.SIM.simulate_joker_before_effects()\n\009\009for _, joker in ipairs(FN.SIM.env.jokers) do\n\009\009\009FN.SIM.simulate_joker(joker, FN.SIM.get_context(G.jokers, { before = true }))\n\009\009end\n\009end\n\n\009function FN.SIM.simulate_joker_discard_effects(cards, card)\n\009\009for _, joker in ipairs(FN.SIM.env.jokers) do\n\009\009\009FN.SIM.simulate_joker(\n\009\009\009\009joker,\n\009\009\009\009FN.SIM.get_context(G.hand, { discard = true, cards = cards, other_card = card })\n\009\009\009)\n\009\009end\n\009end\n\n\009function FN.SIM.simulate_blind_effects()\n\009\009if G.GAME.blind.disabled then return end\n\n\009\009if G.GAME.blind.name == \"The Flint\" then\n\009\009\009local function flint(data)\n\009\009\009\009local half_chips = math.floor(data.chips / 2 + 0.5)\n\009\009\009\009local half_mult = math.floor(data.mult / 2 + 0.5)\n\009\009\009\009data.chips = FN.SIM.mod_chips(math.max(half_chips, 0))\n\009\009\009\009data.mult = FN.SIM.mod_mult(math.max(half_mult, 1))\n\009\009\009end\n\n\009\009\009flint(FN.SIM.running.min)\n\009\009\009flint(FN.SIM.running.exact)\n\009\009\009flint(FN.SIM.running.max)\n\009\009else\n\009\009\009-- Other blinds do not impact scoring; refer to Blind:modify_hand(..)\n\009\009end\n\009end\n\n\009function FN.SIM.simulate_deck_effects()\n\009\009if FN.SIM.is_deck(\"b_plasma\") then\n\009\009\009local function plasma(data)\n\009\009\009\009local sum = data.chips + data.mult\n\009\009\009\009local half_sum = math.floor(sum / 2)\n\009\009\009\009data.chips = FN.SIM.mod_chips(half_sum)\n\009\009\009\009data.mult = FN.SIM.mod_mult(half_sum)\n\009\009\009end\n\n\009\009\009plasma(FN.SIM.running.min)\n\009\009\009plasma(FN.SIM.running.exact)\n\009\009\009plasma(FN.SIM.running.max)\n\009\009elseif G.GAME.modifiers.mp_score_instability then\n\009\009\009local function unplasma(data)\n\009\009\009\009local diff = data.chips - data.mult\n\009\009\009\009if diff > 0 then\n\009\009\009\009\009diff = math.min(diff, data.mult - 1)\n\009\009\009\009elseif diff < 0 then\n\009\009\009\009\009diff = math.max(diff, -data.chips)\n\009\009\009\009end\n\009\009\009\009data.chips = FN.SIM.mod_chips(data.chips + diff)\n\009\009\009\009data.mult = FN.SIM.mod_mult(data.mult - diff)\n\009\009\009end\n\n\009\009\009unplasma(FN.SIM.running.min)\n\009\009\009unplasma(FN.SIM.running.exact)\n\009\009\009unplasma(FN.SIM.running.max)\n\009\009elseif FN.SIM.is_deck(\"b_mp_echodeck\") then\n\009\009\009-- Do something?\n\009\009else\n\009\009\009-- Other decks do not impact scoring; refer to Back:trigger_effect(..)\n\009\009end\n\009end\n\n\009function FN.SIM.simulate_blind_debuffs()\n\009\009local blind_obj = G.GAME.blind\n\009\009if blind_obj.disabled then return false end\n\n\009\009-- The following are part of Blind:press_play()\n\n\009\009if blind_obj.name == \"The Hook\" then\n\009\009\009blind_obj.triggered = true\n\n\009\009\009local held = FN.SIM.env.held_cards\n\009\009\009local n = #held\n\009\009\009local combinations = {}\n\n\009\009\009-- Generate all possible discard combinations\n\009\009\009if n == 0 then\n\009\009\009\009table.insert(combinations, {})\n\009\009\009elseif n == 1 then\n\009\009\009\009for a = 1, n do\n\009\009\009\009\009table.insert(combinations, { a })\n\009\009\009\009end\n\009\009\009elseif n >= 2 then\n\009\009\009\009for a = 1, n - 1 do\n\009\009\009\009\009for b = a + 1, n do\n\009\009\009\009\009\009table.insert(combinations, { a, b })\n\009\009\009\009\009end\n\009\009\009\009end\n\009\009\009end\n\n\009\009\009local min_score, max_score = math.huge, -math.huge\n\009\009\009local min_dollars, max_dollars = math.huge, -math.huge\n\n\009\009\009for _, discard_idxs in ipairs(combinations) do\n\009\009\009\009-- Deep copy held cards\n\009\009\009\009local held_copy = {}\n\009\009\009\009local discarded = {}\n\009\009\009\009for i, card in ipairs(held) do\n\009\009\009\009\009held_copy[i] = copy_table(card)\n\009\009\009\009end\n\n\009\009\009\009-- Remove discard cards from held_copy\n\009\009\009\009table.sort(discard_idxs, function(a, b)\n\009\009\009\009\009return a > b\n\009\009\009\009end)\n\009\009\009\009for _, idx in ipairs(discard_idxs) do\n\009\009\009\009\009discarded[#discarded + 1] = table.remove(held_copy, idx)\n\009\009\009\009end\n\n\009\009\009\009-- Backup and replace held cards and jokers temporarily\n\009\009\009\009local backup_held = FN.SIM.env.held_cards\n\009\009\009\009FN.SIM.env.held_cards = held_copy\n\009\009\009\009local backup_jokers = copy_table(FN.SIM.env.jokers)\n\n\009\009\009\009-- Reset sim state\n\009\009\009\009FN.SIM.running.min = { chips = 0, mult = 0, dollars = 0 }\n\009\009\009\009FN.SIM.running.exact = { chips = 0, mult = 0, dollars = 0 }\n\009\009\009\009FN.SIM.running.max = { chips = 0, mult = 0, dollars = 0 }\n\n\009\009\009\009for i = 1, #discarded do\n\009\009\009\009\009FN.SIM.simulate_joker_discard_effects(discarded, discarded[i])\n\009\009\009\009end\n\n\009\009\009\009-- Simulate score\n\009\009\009\009FN.SIM.simulate_joker_before_effects()\n\009\009\009\009FN.SIM.add_base_chips_and_mult()\n\009\009\009\009FN.SIM.simulate_blind_effects()\n\009\009\009\009FN.SIM.simulate_scoring_cards()\n\009\009\009\009FN.SIM.simulate_held_cards()\n\009\009\009\009FN.SIM.simulate_joker_global_effects()\n\009\009\009\009FN.SIM.simulate_consumable_effects()\n\009\009\009\009FN.SIM.simulate_deck_effects()\n\n\009\009\009\009-- Evaluate score\n\009\009\009\009local res = FN.SIM.get_results()\n\009\009\009\009min_score = math.min(min_score, res.score.min)\n\009\009\009\009max_score = math.max(max_score, res.score.max)\n\009\009\009\009min_dollars = math.min(min_dollars, res.dollars.min)\n\009\009\009\009max_dollars = math.max(max_dollars, res.dollars.max)\n\n\009\009\009\009-- Restore original held cards and jokers\n\009\009\009\009FN.SIM.env.held_cards = backup_held\n\009\009\009\009FN.SIM.env.jokers = backup_jokers\n\009\009\009end\n\n\009\009\009-- Overwrite final min/max range based on permutations\n\009\009\009FN.SIM.running.min = { chips = min_score, mult = 1, dollars = min_dollars }\n\009\009\009FN.SIM.running.max = { chips = max_score, mult = 1, dollars = max_dollars }\n\n\009\009\009-- NOTE: FN.SIM.running.exact remains unset here; it's not relevant in this projection context\n\009\009\009return true -- Prevent default simulation since weâ€™ve replaced it entirely\n\009\009end\n\n\009\009if blind_obj.name == \"The Tooth\" then\n\009\009\009blind_obj.triggered = true\n\009\009\009FN.SIM.add_dollars(-1 * #FN.SIM.env.played_cards)\n\009\009end\n\n\009\009-- The following are part of Blind:debuff_hand(..)\n\n\009\009if blind_obj.name == \"The Arm\" then\n\009\009\009blind_obj.triggered = false\n\n\009\009\009local played_hand_name = FN.SIM.env.scoring_name\n\009\009\009if G.GAME.hands[played_hand_name].level > 1 then\n\009\009\009\009blind_obj.triggered = true\n\009\009\009\009-- NOTE: Important to save/restore G.GAME.hands here\n\009\009\009\009-- NOTE: Implementation mirrors level_up_hand(..)\n\009\009\009\009local played_hand_data = G.GAME.hands[played_hand_name]\n\009\009\009\009played_hand_data.level = math.max(1, played_hand_data.level - 1)\n\009\009\009\009played_hand_data.mult =\n\009\009\009\009\009math.max(1, played_hand_data.s_mult + (played_hand_data.level - 1) * played_hand_data.l_mult)\n\009\009\009\009played_hand_data.chips =\n\009\009\009\009\009math.max(0, played_hand_data.s_chips + (played_hand_data.level - 1) * played_hand_data.l_chips)\n\009\009\009end\n\009\009\009return false -- IMPORTANT: Avoid duplicate effects from Blind:debuff_hand() below\n\009\009end\n\n\009\009if blind_obj.name == \"The Ox\" then\n\009\009\009blind_obj.triggered = false\n\n\009\009\009if FN.SIM.env.scoring_name == G.GAME.current_round.most_played_poker_hand then\n\009\009\009\009blind_obj.triggered = true\n\009\009\009\009FN.SIM.add_dollars(-G.GAME.dollars)\n\009\009\009end\n\009\009\009return false -- IMPORTANT: Avoid duplicate effects from Blind:debuff_hand() below\n\009\009end\n\n\009\009return blind_obj:debuff_hand(G.hand.highlighted, FN.SIM.env.poker_hands, FN.SIM.env.scoring_name, true)\n\009end\n\n\009--\n\009-- MICRO LEVEL (CARDS):\n\009--\n\n\009function FN.SIM.simulate_card_in_context(card, cardarea)\n\009\009-- Reset and collect repetitions:\n\009\009FN.SIM.running.reps = 1\n\009\009if card.seal == \"Red\" then FN.SIM.add_reps(1) end\n\009\009if FN.SIM.is_deck(\"b_mp_echodeck\") then FN.SIM.add_reps(1) end -- I guess this works?\n\009\009FN.SIM.simulate_all_jokers(cardarea, { other_card = card, repetition = true })\n\n\009\009-- Apply effects:\n\009\009for _ = 1, FN.SIM.running.reps do\n\009\009\009FN.SIM.simulate_card(card, FN.SIM.get_context(cardarea, {}))\n\009\009\009FN.SIM.simulate_all_jokers(cardarea, { other_card = card, individual = true })\n\009\009end\n\009end\n\n\009function FN.SIM.simulate_card(card_data, context)\n\009\009-- Do nothing if debuffed:\n\009\009if card_data.debuff then return end\n\n\009\009if context.cardarea == G.play then\n\009\009\009-- Chips:\n\009\009\009if card_data.ability.effect == \"Stone Card\" then\n\009\009\009\009FN.SIM.add_chips(card_data.ability.bonus + (card_data.ability.perma_bonus or 0))\n\009\009\009else\n\009\009\009\009FN.SIM.add_chips(card_data.base_chips + card_data.ability.bonus + (card_data.ability.perma_bonus or 0))\n\009\009\009end\n\n\009\009\009-- Mult:\n\009\009\009if card_data.ability.effect == \"Lucky Card\" then\n\009\009\009\009local exact_mult, min_mult, max_mult =\n\009\009\009\009\009FN.SIM.get_probabilistic_extremes(pseudorandom(\"nope\"), 5, card_data.ability.mult, 0)\n\009\009\009\009FN.SIM.add_mult(exact_mult, min_mult, max_mult)\n\009\009\009\009-- Careful not to overwrite `card_data.lucky_trigger` outright:\n\009\009\009\009if exact_mult > 0 then card_data.lucky_trigger.exact = true end\n\009\009\009\009if min_mult > 0 then card_data.lucky_trigger.min = true end\n\009\009\009\009if max_mult > 0 then card_data.lucky_trigger.max = true end\n\009\009\009else\n\009\009\009\009FN.SIM.add_mult(card_data.ability.mult)\n\009\009\009end\n\n\009\009\009-- XMult:\n\009\009\009if card_data.ability.x_mult > 1 then FN.SIM.x_mult(card_data.ability.x_mult) end\n\n\009\009\009-- Dollars:\n\009\009\009if card_data.seal == \"Gold\" then FN.SIM.add_dollars(3) end\n\009\009\009if card_data.ability.p_dollars > 0 then\n\009\009\009\009if card_data.ability.effect == \"Lucky Card\" then\n\009\009\009\009\009local exact_dollars, min_dollars, max_dollars = FN.SIM.get_probabilistic_extremes(\n\009\009\009\009\009\009pseudorandom(\"notthistime\"),\n\009\009\009\009\009\00915,\n\009\009\009\009\009\009card_data.ability.p_dollars,\n\009\009\009\009\009\0090\n\009\009\009\009\009)\n\009\009\009\009\009FN.SIM.add_dollars(exact_dollars, min_dollars, max_dollars)\n\009\009\009\009\009-- Careful not to overwrite `card_data.lucky_trigger` outright:\n\009\009\009\009\009if exact_dollars > 0 then card_data.lucky_trigger.exact = true end\n\009\009\009\009\009if min_dollars > 0 then card_data.lucky_trigger.min = true end\n\009\009\009\009\009if max_dollars > 0 then card_data.lucky_trigger.max = true end\n\009\009\009\009else\n\009\009\009\009\009FN.SIM.add_dollars(card_data.ability.p_dollars)\n\009\009\009\009end\n\009\009\009end\n\n\009\009\009-- Edition:\n\009\009\009if card_data.edition then\n\009\009\009\009if card_data.edition.chips then FN.SIM.add_chips(card_data.edition.chips) end\n\009\009\009\009if card_data.edition.mult then FN.SIM.add_mult(card_data.edition.mult) end\n\009\009\009\009if card_data.edition.x_mult then FN.SIM.x_mult(card_data.edition.x_mult) end\n\009\009\009end\n\009\009elseif context.cardarea == G.hand then\n\009\009\009if card_data.ability.h_mult > 0 then FN.SIM.add_mult(card_data.ability.h_mult) end\n\n\009\009\009if card_data.ability.h_x_mult > 0 then FN.SIM.x_mult(card_data.ability.h_x_mult) end\n\009\009end\n\009end\n\n\009--\n\009-- MICRO LEVEL (JOKERS):\n\009--\n\n\009function FN.SIM.simulate_all_jokers(cardarea, context_args)\n\009\009for _, joker in ipairs(FN.SIM.env.jokers) do\n\009\009\009FN.SIM.simulate_joker(joker, FN.SIM.get_context(cardarea, context_args))\n\009\009end\n\009end\n\n\009function FN.SIM.simulate_joker(joker_obj, context)\n\009\009-- Do nothing if debuffed:\n\009\009if joker_obj.debuff then return end\n\n\009\009local joker_simulation_function = FN.SIM.JOKERS[\"simulate_\" .. joker_obj.id]\n\009\009if joker_simulation_function then joker_simulation_function(joker_obj, context) end\n\009end\nend\n","-- Utilities for writing simulation functions for jokers.\n--\n-- In general, these functions replicate the game's internal calculations and\n-- variables in order to avoid affecting the game's state during simulation.\n-- These functions ensure that the score calculation remains identical to the\n-- game; DO NOT directly modify the `FN.SIM.running` score variables.\n\n--\n-- HIGH-LEVEL:\n--\n\nfunction FN.SIM.JOKERS.add_suit_mult(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if FN.SIM.is_suit(context.other_card, joker_obj.ability.extra.suit) and not context.other_card.debuff then\n\009\009\009FN.SIM.add_mult(joker_obj.ability.extra.s_mult)\n\009\009end\n\009end\nend\n\nfunction FN.SIM.JOKERS.add_type_mult(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global and next(context.poker_hands[joker_obj.ability.type]) then\n\009\009FN.SIM.add_mult(joker_obj.ability.t_mult)\n\009end\nend\n\nfunction FN.SIM.JOKERS.add_type_chips(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global and next(context.poker_hands[joker_obj.ability.type]) then\n\009\009FN.SIM.add_chips(joker_obj.ability.t_chips)\n\009end\nend\n\nfunction FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009if\n\009\009\009joker_obj.ability.x_mult > 1\n\009\009\009and (joker_obj.ability.type == \"\" or next(context.poker_hands[joker_obj.ability.type]))\n\009\009then\n\009\009\009FN.SIM.x_mult(joker_obj.ability.x_mult)\n\009\009end\n\009end\nend\n\nfunction FN.SIM.get_probabilistic_extremes(random_value, odds, reward, default)\n\009-- Exact mirrors the game's probability calculation\n\009local exact = default\n\009if random_value < G.GAME.probabilities.normal / odds then exact = reward end\n\n\009-- Minimum is default unless probability is guaranteed (eg. 2 in 2 chance)\n\009local min = default\n\009if G.GAME.probabilities.normal >= odds then min = reward end\n\n\009-- Maximum is always reward (probability is always > 0); redundant variable is for readability\n\009local max = reward\n\n\009return exact, min, max\nend\n\nfunction FN.SIM.adjust_field_with_range(adj_func, field, mod_func, exact_value, min_value, max_value)\n\009if not exact_value then error(\"Cannot adjust field, exact_value is missing.\") end\n\n\009if not min_value or not max_value then\n\009\009min_value = exact_value\n\009\009max_value = exact_value\n\009end\n\n\009FN.SIM.running.min[field] = mod_func(adj_func(FN.SIM.running.min[field], min_value))\n\009FN.SIM.running.exact[field] = mod_func(adj_func(FN.SIM.running.exact[field], exact_value))\n\009FN.SIM.running.max[field] = mod_func(adj_func(FN.SIM.running.max[field], max_value))\nend\n\nfunction FN.SIM.add_chips(exact, min, max)\n\009FN.SIM.adjust_field_with_range(function(x, y)\n\009\009return x + y\n\009end, \"chips\", FN.SIM.mod_chips, exact, min, max)\nend\n\nfunction FN.SIM.add_mult(exact, min, max)\n\009FN.SIM.adjust_field_with_range(function(x, y)\n\009\009return x + y\n\009end, \"mult\", FN.SIM.mod_mult, exact, min, max)\nend\n\nfunction FN.SIM.x_mult(exact, min, max)\n\009FN.SIM.adjust_field_with_range(function(x, y)\n\009\009return x * y\n\009end, \"mult\", FN.SIM.mod_mult, exact, min, max)\nend\n\nfunction FN.SIM.add_dollars(exact, min, max)\n\009-- NOTE: no mod_func for dollars, so have to declare an identity function\n\009FN.SIM.adjust_field_with_range(\n\009\009function(x, y)\n\009\009\009return x + y\n\009\009end,\n\009\009\"dollars\",\n\009\009function(x)\n\009\009\009return x\n\009\009end,\n\009\009exact,\n\009\009min,\n\009\009max\n\009)\nend\n\nfunction FN.SIM.add_reps(n)\n\009FN.SIM.running.reps = FN.SIM.running.reps + n\nend\n\n--\n-- LOW-LEVEL:\n--\n\nfunction FN.SIM.is_suit(card_data, suit, ignore_scorability)\n\009if card_data.debuff and not ignore_scorability then return end\n\009if card_data.ability.effect == \"Stone Card\" then return false end\n\009if card_data.ability.effect == \"Wild Card\" and not card_data.debuff then return true end\n\009if next(find_joker(\"Smeared Joker\")) then\n\009\009local is_card_suit_light = (card_data.suit == \"Hearts\" or card_data.suit == \"Diamonds\")\n\009\009local is_check_suit_light = (suit == \"Hearts\" or suit == \"Diamonds\")\n\009\009if is_card_suit_light == is_check_suit_light then return true end\n\009end\n\009return card_data.suit == suit\nend\n\nfunction FN.SIM.get_rank(card_data)\n\009if card_data.ability.effect == \"Stone Card\" and not card_data.vampired then\n\009\009FN.SIM.misc.next_stone_id = FN.SIM.misc.next_stone_id - 1\n\009\009return FN.SIM.misc.next_stone_id\n\009end\n\009return card_data.rank\nend\n\nfunction FN.SIM.is_rank(card_data, ranks)\n\009if card_data.ability.effect == \"Stone Card\" then return false end\n\n\009if type(ranks) == \"number\" then ranks = { ranks } end\n\009if FN.SIM.is_deck(\"b_mp_gradient\") then\n\009\009local temp = {}\n\n\009\009for i, v in ipairs(ranks) do\n\009\009\009temp[v - 1] = true\n\009\009\009temp[v] = true\n\009\009\009temp[v + 1] = true\n\009\009end\n\n\009\009ranks = {}\n\009\009for k, v in pairs(temp) do\n\009\009\009if k == 15 then\n\009\009\009\009k = 2\n\009\009\009elseif k == 1 then\n\009\009\009\009k = 14\n\009\009\009end\n\009\009\009table.insert(ranks, k)\n\009\009end\n\009\009table.sort(ranks)\n\009end\n\009for _, r in ipairs(ranks) do\n\009\009if card_data.rank == r then return true end\n\009end\n\009return false\nend\n\nfunction FN.SIM.check_rank_parity(card_data, check_even)\n\009if check_even then\n\009\009return FN.SIM.is_rank(card_data, { 2, 4, 6, 8, 10 })\n\009else\n\009\009return FN.SIM.is_rank(card_data, { 3, 5, 7, 9, 14 })\n\009end\nend\n\nfunction FN.SIM.is_face(card_data)\n\009return (FN.SIM.is_rank(card_data, { 11, 12, 13 }) or next(find_joker(\"Pareidolia\")))\nend\n\nfunction FN.SIM.set_ability(card_data, center)\n\009-- See Card:set_ability()\n\009card_data.ability = {\n\009\009name = center.name,\n\009\009effect = center.effect,\n\009\009set = center.set,\n\009\009mult = center.config.mult or 0,\n\009\009h_mult = center.config.h_mult or 0,\n\009\009h_x_mult = center.config.h_x_mult or 0,\n\009\009h_dollars = center.config.h_dollars or 0,\n\009\009p_dollars = center.config.p_dollars or 0,\n\009\009t_mult = center.config.t_mult or 0,\n\009\009t_chips = center.config.t_chips or 0,\n\009\009x_mult = center.config.Xmult or 1,\n\009\009h_size = center.config.h_size or 0,\n\009\009d_size = center.config.d_size or 0,\n\009\009extra = copy_table(center.config.extra) or nil,\n\009\009extra_value = 0,\n\009\009type = center.config.type or \"\",\n\009\009order = center.order or nil,\n\009\009forced_selection = card_data.ability and card_data.ability.forced_selection or nil,\n\009\009perma_bonus = card_data.ability and card_data.ability.perma_bonus or 0,\n\009\009bonus = center.config.bonus or 0,\n\009}\nend\n\nfunction FN.SIM.set_edition(card_data, edition)\n\009card_data.edition = nil\n\009if not edition then return end\n\n\009if edition.holo then\n\009\009if not card_data.edition then card_data.edition = {} end\n\009\009card_data.edition.mult = G.P_CENTERS.e_holo.config.extra\n\009\009card_data.edition.holo = true\n\009\009card_data.edition.type = \"holo\"\n\009elseif edition.foil then\n\009\009if not card_data.edition then card_data.edition = {} end\n\009\009card_data.edition.chips = G.P_CENTERS.e_foil.config.extra\n\009\009card_data.edition.foil = true\n\009\009card_data.edition.type = \"foil\"\n\009elseif edition.polychrome then\n\009\009if not card_data.edition then card_data.edition = {} end\n\009\009card_data.edition.x_mult = G.P_CENTERS.e_polychrome.config.extra\n\009\009card_data.edition.polychrome = true\n\009\009card_data.edition.type = \"polychrome\"\n\009elseif edition.negative then\n\009\009-- TODO\n\009end\nend\n\nfunction FN.SIM.is_deck(deck)\n\009if G.GAME.selected_back.effect.center.key == deck then\n\009\009return true\n\009elseif G.GAME.selected_back.effect.center.key == \"b_mp_cocktail\" then\n\009\009for i = 1, 3 do\n\009\009\009if G.GAME.modifiers.mp_cocktail[i] == deck then return true end\n\009\009end\n\009end\n\009return false\nend\n\nfunction FN.SIM.mod_chips(_chips)\n\009return _chips\nend\n\nfunction FN.SIM.mod_mult(_mult)\n\009return _mult\nend\n"}},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="copy",["t"]={"card.lua"},["position"]="append",["contents"]={"--- Divvy's Simulation for Balatro - _Vanilla.lua\n--\n-- The simulation functions for all of the vanilla Balatro jokers.\n\nlocal FNSJ = FN.SIM.JOKERS\n\nFNSJ.simulate_joker = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_mult(joker_obj.ability.mult) end\nend\nFNSJ.simulate_greedy_joker = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_suit_mult(joker_obj, context)\nend\nFNSJ.simulate_lusty_joker = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_suit_mult(joker_obj, context)\nend\nFNSJ.simulate_wrathful_joker = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_suit_mult(joker_obj, context)\nend\nFNSJ.simulate_gluttenous_joker = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_suit_mult(joker_obj, context)\nend\nFNSJ.simulate_jolly = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_type_mult(joker_obj, context)\nend\nFNSJ.simulate_zany = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_type_mult(joker_obj, context)\nend\nFNSJ.simulate_mad = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_type_mult(joker_obj, context)\nend\nFNSJ.simulate_crazy = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_type_mult(joker_obj, context)\nend\nFNSJ.simulate_droll = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_type_mult(joker_obj, context)\nend\nFNSJ.simulate_sly = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_type_chips(joker_obj, context)\nend\nFNSJ.simulate_wily = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_type_chips(joker_obj, context)\nend\nFNSJ.simulate_clever = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_type_chips(joker_obj, context)\nend\nFNSJ.simulate_devious = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_type_chips(joker_obj, context)\nend\nFNSJ.simulate_crafty = function(joker_obj, context)\n\009FN.SIM.JOKERS.add_type_chips(joker_obj, context)\nend\nFNSJ.simulate_half = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009if #context.full_hand <= joker_obj.ability.extra.size then FN.SIM.add_mult(joker_obj.ability.extra.mult) end\n\009end\nend\nFNSJ.simulate_stencil = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009local xmult = G.jokers.config.card_limit - #FN.SIM.env.jokers\n\009\009for _, joker in ipairs(FN.SIM.env.jokers) do\n\009\009\009if joker.ability.name == \"Joker Stencil\" then xmult = xmult + 1 end\n\009\009end\n\009\009if joker_obj.ability.x_mult > 1 then FN.SIM.x_mult(joker_obj.ability.x_mult) end\n\009end\nend\nFNSJ.simulate_four_fingers = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_mime = function(joker_obj, context)\n\009if context.cardarea == G.hand and context.repetition then FN.SIM.add_reps(joker_obj.ability.extra) end\nend\nFNSJ.simulate_credit_card = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_ceremonial = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_mult(joker_obj.ability.mult) end\nend\nFNSJ.simulate_banner = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009if G.GAME.current_round.discards_left > 0 then\n\009\009\009local chips = G.GAME.current_round.discards_left * joker_obj.ability.extra\n\009\009\009FN.SIM.add_chips(chips)\n\009\009end\n\009end\nend\nFNSJ.simulate_mystic_summit = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009if G.GAME.current_round.discards_left == joker_obj.ability.extra.d_remaining then\n\009\009\009FN.SIM.add_mult(joker_obj.ability.extra.mult)\n\009\009end\n\009end\nend\nFNSJ.simulate_marble = function(joker_obj, context)\n\009-- Effect not relevant (Blind)\nend\nFNSJ.simulate_loyalty_card = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009local loyalty_diff = G.GAME.hands_played - joker_obj.ability.hands_played_at_create\n\009\009local loyalty_remaining = ((joker_obj.ability.extra.every - 1) - loyalty_diff)\n\009\009\009% (joker_obj.ability.extra.every + 1)\n\009\009if loyalty_remaining == joker_obj.ability.extra.every then FN.SIM.x_mult(joker_obj.ability.extra.Xmult) end\n\009end\nend\nFNSJ.simulate_8_ball = function(joker_obj, context)\n\009-- Effect might be relevant?\nend\nFNSJ.simulate_misprint = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009local exact_mult = pseudorandom(\"nope\", joker_obj.ability.extra.min, joker_obj.ability.extra.max)\n\009\009FN.SIM.add_mult(exact_mult, joker_obj.ability.extra.min, joker_obj.ability.extra.max)\n\009end\nend\nFNSJ.simulate_dusk = function(joker_obj, context)\n\009if context.cardarea == G.play and context.repetition then\n\009\009-- Note: Checking against 1 is needed as hands_left is not decremented as part of simulation\n\009\009if G.GAME.current_round.hands_left == 1 then FN.SIM.add_reps(joker_obj.ability.extra) end\n\009end\nend\nFNSJ.simulate_raised_fist = function(joker_obj, context)\n\009if context.cardarea == G.hand and context.individual then\n\009\009local cur_mult, cur_rank = 15, 15\n\009\009local raised_card = nil\n\009\009for _, card in ipairs(FN.SIM.env.held_cards) do\n\009\009\009if cur_rank >= card.rank and card.ability.effect ~= \"Stone Card\" then\n\009\009\009\009cur_mult = card.base_chips\n\009\009\009\009cur_rank = card.rank\n\009\009\009\009raised_card = card\n\009\009\009end\n\009\009end\n\009\009if raised_card == context.other_card and not context.other_card.debuff then FN.SIM.add_mult(2 * cur_mult) end\n\009end\nend\nFNSJ.simulate_chaos = function(joker_obj, context)\n\009-- Effect not relevant (Free Reroll)\nend\nFNSJ.simulate_fibonacci = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if FN.SIM.is_rank(context.other_card, { 2, 3, 5, 8, 14 }) and not context.other_card.debuff then\n\009\009\009FN.SIM.add_mult(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_steel_joker = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009FN.SIM.x_mult(1 + joker_obj.ability.extra * joker_obj.ability.steel_tally)\n\009end\nend\nFNSJ.simulate_scary_face = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if FN.SIM.is_face(context.other_card) and not context.other_card.debuff then\n\009\009\009FN.SIM.add_chips(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_abstract = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009FN.SIM.add_mult(#FN.SIM.env.jokers * joker_obj.ability.extra)\n\009end\nend\nFNSJ.simulate_delayed_grat = function(joker_obj, context)\n\009-- Effect not relevant (End of Round)\nend\nFNSJ.simulate_hack = function(joker_obj, context)\n\009if context.cardarea == G.play and context.repetition then\n\009\009if not context.other_card.debuff and FN.SIM.is_rank(context.other_card, { 2, 3, 4, 5 }) then\n\009\009\009FN.SIM.add_reps(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_pareidolia = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_gros_michel = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_mult(joker_obj.ability.extra.mult) end\nend\nFNSJ.simulate_even_steven = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if not context.other_card.debuff and FN.SIM.check_rank_parity(context.other_card, true) then\n\009\009\009FN.SIM.add_mult(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_odd_todd = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if not context.other_card.debuff and FN.SIM.check_rank_parity(context.other_card, false) then\n\009\009\009FN.SIM.add_chips(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_scholar = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if FN.SIM.is_rank(context.other_card, 14) and not context.other_card.debuff then\n\009\009\009FN.SIM.add_chips(joker_obj.ability.extra.chips)\n\009\009\009FN.SIM.add_mult(joker_obj.ability.extra.mult)\n\009\009end\n\009end\nend\nFNSJ.simulate_business = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if FN.SIM.is_face(context.other_card) and not context.other_card.debuff then\n\009\009\009local exact_dollars, min_dollars, max_dollars =\n\009\009\009\009FN.SIM.get_probabilistic_extremes(pseudorandom(\"false\"), joker_obj.ability.extra, 2, 0)\n\009\009\009FN.SIM.add_dollars(exact_dollars, min_dollars, max_dollars)\n\009\009end\n\009end\nend\nFNSJ.simulate_supernova = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009FN.SIM.add_mult(G.GAME.hands[context.scoring_name].played)\n\009end\nend\nFNSJ.simulate_ride_the_bus = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.before and not context.blueprint then\n\009\009local faces = false\n\009\009for _, scoring_card in ipairs(context.scoring_hand) do\n\009\009\009if FN.SIM.is_face(scoring_card) then faces = true end\n\009\009end\n\009\009if faces then\n\009\009\009joker_obj.ability.mult = 0\n\009\009else\n\009\009\009joker_obj.ability.mult = joker_obj.ability.mult + joker_obj.ability.extra\n\009\009end\n\009end\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_mult(joker_obj.ability.mult) end\nend\nFNSJ.simulate_space = function(joker_obj, context)\n\009-- TODO: Verify\n\009if context.cardarea == G.jokers and context.before then\n\009\009local hand_data = G.GAME.hands[FN.SIM.env.scoring_name]\n\n\009\009local rand = pseudorandom(\"bad\") -- Must reuse same pseudorandom value:\n\009\009local exact_chips, min_chips, max_chips =\n\009\009\009FN.SIM.get_probabilistic_extremes(rand, joker_obj.ability.extra, hand_data.l_chips, 0)\n\009\009local exact_mult, min_mult, max_mult =\n\009\009\009FN.SIM.get_probabilistic_extremes(rand, joker_obj.ability.extra, hand_data.l_mult, 0)\n\n\009\009FN.SIM.add_chips(exact_chips, min_chips, max_chips)\n\009\009FN.SIM.add_mult(exact_mult, min_mult, max_mult)\n\009end\nend\nFNSJ.simulate_egg = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_burglar = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_blackboard = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009local black_suits, all_cards = 0, 0\n\009\009for _, card in ipairs(FN.SIM.env.held_cards) do\n\009\009\009all_cards = all_cards + 1\n\009\009\009if FN.SIM.is_suit(card, \"Clubs\", true) or FN.SIM.is_suit(card, \"Spades\", true) then\n\009\009\009\009black_suits = black_suits + 1\n\009\009\009end\n\009\009end\n\009\009if black_suits == all_cards then FN.SIM.x_mult(joker_obj.ability.extra) end\n\009end\nend\nFNSJ.simulate_runner = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.before and not context.blueprint then\n\009\009if next(context.poker_hands[\"Straight\"]) then\n\009\009\009joker_obj.ability.extra.chips = joker_obj.ability.extra.chips + joker_obj.ability.extra.chip_mod\n\009\009end\n\009end\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_chips(joker_obj.ability.extra.chips) end\nend\nFNSJ.simulate_ice_cream = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_chips(joker_obj.ability.extra.chips) end\nend\nFNSJ.simulate_dna = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.before then\n\009\009if G.GAME.current_round.hands_played == 0 and #context.full_hand == 1 then\n\009\009\009local new_card = copy_table(context.full_hand[1])\n\009\009\009table.insert(FN.SIM.env.held_cards, new_card)\n\009\009end\n\009end\nend\nFNSJ.simulate_splash = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_blue_joker = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009FN.SIM.add_chips(joker_obj.ability.extra * #G.deck.cards)\n\009end\nend\nFNSJ.simulate_sixth_sense = function(joker_obj, context)\n\009-- Effect might be relevant?\nend\nFNSJ.simulate_constellation = function(joker_obj, context)\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_hiker = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if not context.other_card.debuff then\n\009\009\009context.other_card.ability.perma_bonus = (context.other_card.ability.perma_bonus or 0)\n\009\009\009\009+ joker_obj.ability.extra\n\009\009end\n\009end\nend\nFNSJ.simulate_faceless = function(joker_obj, context)\n\009-- Effect not relevant (Discard)\nend\nFNSJ.simulate_green_joker = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.before and not context.blueprint then\n\009\009joker_obj.ability.mult = joker_obj.ability.mult + joker_obj.ability.extra.hand_add\n\009end\n\009if\n\009\009context.cardarea == G.hand\n\009\009and context.discard\n\009\009and context.other_card == context.cards[1]\n\009\009and not context.blueprint\n\009then\n\009\009joker_obj.ability.mult = math.max(0, joker_obj.ability.mult - joker_obj.ability.extra.discard_sub)\n\009end\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_mult(joker_obj.ability.mult) end\nend\nFNSJ.simulate_superposition = function(joker_obj, context)\n\009-- Effect might be relevant?\nend\nFNSJ.simulate_todo_list = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.before then\n\009\009if context.scoring_name == joker_obj.ability.to_do_poker_hand then\n\009\009\009FN.SIM.add_dollars(joker_obj.ability.extra.dollars)\n\009\009end\n\009end\nend\nFNSJ.simulate_cavendish = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then FN.SIM.x_mult(joker_obj.ability.extra.Xmult) end\nend\nFNSJ.simulate_card_sharp = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009if G.GAME.hands[context.scoring_name] and G.GAME.hands[context.scoring_name].played_this_round > 1 then\n\009\009\009FN.SIM.x_mult(joker_obj.ability.extra.Xmult)\n\009\009end\n\009end\nend\nFNSJ.simulate_red_card = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_mult(joker_obj.ability.mult) end\nend\nFNSJ.simulate_madness = function(joker_obj, context)\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_square = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.before and not context.blueprint then\n\009\009if #context.full_hand == 4 then\n\009\009\009joker_obj.ability.extra.chips = joker_obj.ability.extra.chips + joker_obj.ability.extra.chip_mod\n\009\009end\n\009end\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_chips(joker_obj.ability.extra.chips) end\nend\nFNSJ.simulate_seance = function(joker_obj, context)\n\009-- Effect might be relevant? (Consumable)\nend\nFNSJ.simulate_riff_raff = function(joker_obj, context)\n\009-- Effect not relevant (Blind)\nend\nFNSJ.simulate_vampire = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.before and not context.blueprint then\n\009\009local num_enhanced = 0\n\009\009for _, card in ipairs(context.scoring_hand) do\n\009\009\009if card.ability.name ~= \"Default Base\" and not card.debuff then\n\009\009\009\009num_enhanced = num_enhanced + 1\n\009\009\009\009FN.SIM.set_ability(card, G.P_CENTERS.c_base)\n\009\009\009end\n\009\009end\n\009\009if num_enhanced > 0 then\n\009\009\009joker_obj.ability.x_mult = joker_obj.ability.x_mult + (joker_obj.ability.extra * num_enhanced)\n\009\009end\n\009end\n\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_shortcut = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_hologram = function(joker_obj, context)\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_vagabond = function(joker_obj, context)\n\009-- Effect might be relevant? (Consumable)\nend\nFNSJ.simulate_baron = function(joker_obj, context)\n\009if context.cardarea == G.hand and context.individual then\n\009\009if FN.SIM.is_rank(context.other_card, 13) and not context.other_card.debuff then\n\009\009\009FN.SIM.x_mult(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_cloud_9 = function(joker_obj, context)\n\009-- Effect not relevant (End of Round)\nend\nFNSJ.simulate_rocket = function(joker_obj, context)\n\009-- Effect not relevant (End of Round)\nend\nFNSJ.simulate_obelisk = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.before and not context.blueprint then\n\009\009local reset = true\n\009\009local play_more_than = (G.GAME.hands[context.scoring_name].played or 0)\n\009\009for hand_name, hand in pairs(G.GAME.hands) do\n\009\009\009if hand_name ~= context.scoring_name and hand.played >= play_more_than and hand.visible then\n\009\009\009\009reset = false\n\009\009\009end\n\009\009end\n\009\009if reset then\n\009\009\009joker_obj.ability.x_mult = 1\n\009\009else\n\009\009\009joker_obj.ability.x_mult = joker_obj.ability.x_mult + joker_obj.ability.extra\n\009\009end\n\009end\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_midas_mask = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.before and not context.blueprint then\n\009\009for _, card in ipairs(context.scoring_hand) do\n\009\009\009if FN.SIM.is_face(card) then FN.SIM.set_ability(card, G.P_CENTERS.m_gold) end\n\009\009end\n\009end\nend\nFNSJ.simulate_luchador = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_photograph = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009local first_face = nil\n\009\009for i = 1, #context.scoring_hand do\n\009\009\009if FN.SIM.is_face(context.scoring_hand[i]) then\n\009\009\009\009first_face = context.scoring_hand[i]\n\009\009\009\009break\n\009\009\009end\n\009\009end\n\009\009if context.other_card == first_face and not context.other_card.debuff then\n\009\009\009FN.SIM.x_mult(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_gift = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_turtle_bean = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_erosion = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009local diff = G.GAME.starting_deck_size - #G.playing_cards\n\009\009if diff > 0 then FN.SIM.add_mult(joker_obj.ability.extra * diff) end\n\009end\nend\nFNSJ.simulate_reserved_parking = function(joker_obj, context)\n\009if context.cardarea == G.hand and context.individual then\n\009\009if FN.SIM.is_face(context.other_card) and not context.other_card.debuff then\n\009\009\009local exact_dollars, min_dollars, max_dollars = FN.SIM.get_probabilistic_extremes(\n\009\009\009\009pseudorandom(\"notthistime\"),\n\009\009\009\009joker_obj.ability.extra.odds,\n\009\009\009\009joker_obj.ability.extra.dollars,\n\009\009\009\0090\n\009\009\009)\n\009\009\009FN.SIM.add_dollars(exact_dollars, min_dollars, max_dollars)\n\009\009end\n\009end\nend\nFNSJ.simulate_mail = function(joker_obj, context)\n\009if context.cardarea == G.hand and context.discard then\n\009\009if context.other_card.id == G.GAME.current_round.mail_card.id and not context.other_card.debuff then\n\009\009\009FN.SIM.add_dollars(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_to_the_moon = function(joker_obj, context)\n\009-- Effect not relevant (End of Round)\nend\nFNSJ.simulate_hallucination = function(joker_obj, context)\n\009-- Effect not relevant (Outside of Play)\nend\nFNSJ.simulate_fortune_teller = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009if G.GAME.consumeable_usage_total and G.GAME.consumeable_usage_total.tarot then\n\009\009\009FN.SIM.add_mult(G.GAME.consumeable_usage_total.tarot)\n\009\009end\n\009end\nend\nFNSJ.simulate_juggler = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_drunkard = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_stone = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009FN.SIM.add_chips(joker_obj.ability.extra * joker_obj.ability.stone_tally)\n\009end\nend\nFNSJ.simulate_golden = function(joker_obj, context)\n\009-- Effect not relevant (End of Round)\nend\nFNSJ.simulate_lucky_cat = function(joker_obj, context)\n\009if not joker_obj.ability.x_mult_range then\n\009\009joker_obj.ability.x_mult_range = {\n\009\009\009min = joker_obj.ability.x_mult,\n\009\009\009exact = joker_obj.ability.x_mult,\n\009\009\009max = joker_obj.ability.x_mult,\n\009\009}\n\009end\n\n\009if context.cardarea == G.play and context.individual and not context.blueprint then\n\009\009local function lucky_cat(field)\n\009\009\009if context.other_card.lucky_trigger and context.other_card.lucky_trigger[field] then\n\009\009\009\009joker_obj.ability.x_mult_range[field] = joker_obj.ability.x_mult_range[field] + joker_obj.ability.extra\n\009\009\009\009if joker_obj.ability.x_mult_range[field] < 1 then joker_obj.ability.x_mult_range[field] = 1 end -- Precaution\n\009\009\009end\n\009\009end\n\009\009lucky_cat(\"min\")\n\009\009lucky_cat(\"exact\")\n\009\009lucky_cat(\"max\")\n\009end\n\n\009if context.cardarea == G.jokers and context.global then\n\009\009FN.SIM.x_mult(\n\009\009\009joker_obj.ability.x_mult_range.exact,\n\009\009\009joker_obj.ability.x_mult_range.min,\n\009\009\009joker_obj.ability.x_mult_range.max\n\009\009)\n\009end\nend\nFNSJ.simulate_baseball = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.other_joker then\n\009\009if context.other_joker.rarity == 2 and context.other_joker ~= joker_obj then\n\009\009\009FN.SIM.x_mult(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_bull = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009local function bull(data)\n\009\009\009return joker_obj.ability.extra * math.max(0, G.GAME.dollars + data.dollars)\n\009\009end\n\009\009local min_chips = bull(FN.SIM.running.min)\n\009\009local exact_chips = bull(FN.SIM.running.exact)\n\009\009local max_chips = bull(FN.SIM.running.max)\n\009\009FN.SIM.add_chips(exact_chips, min_chips, max_chips)\n\009end\nend\nFNSJ.simulate_diet_cola = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_trading = function(joker_obj, context)\n\009-- Effect not relevant (Discard)\nend\nFNSJ.simulate_flash = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_mult(joker_obj.ability.mult) end\nend\nFNSJ.simulate_popcorn = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_mult(joker_obj.ability.mult) end\nend\nFNSJ.simulate_trousers = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.before and not context.blueprint then\n\009\009if next(context.poker_hands[\"Two Pair\"]) or next(context.poker_hands[\"Full House\"]) then\n\009\009\009joker_obj.ability.mult = joker_obj.ability.mult + joker_obj.ability.extra\n\009\009end\n\009end\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_mult(joker_obj.ability.mult) end\nend\nFNSJ.simulate_ancient = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if\n\009\009\009FN.SIM.is_suit(context.other_card, G.GAME.current_round.ancient_card.suit)\n\009\009\009and not context.other_card.debuff\n\009\009then\n\009\009\009FN.SIM.x_mult(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_ramen = function(joker_obj, context)\n\009if context.cardarea == G.hand and context.discard then\n\009\009joker_obj.ability.x_mult = math.max(1, joker_obj.ability.x_mult - joker_obj.ability.extra)\n\009end\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_walkie_talkie = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if FN.SIM.is_rank(context.other_card, { 10, 4 }) and not context.other_card.debuff then\n\009\009\009FN.SIM.add_chips(joker_obj.ability.extra.chips)\n\009\009\009FN.SIM.add_mult(joker_obj.ability.extra.mult)\n\009\009end\n\009end\nend\nFNSJ.simulate_selzer = function(joker_obj, context)\n\009if context.cardarea == G.play and context.repetition then FN.SIM.add_reps(1) end\nend\nFNSJ.simulate_castle = function(joker_obj, context)\n\009if context.cardarea == G.hand and context.discard and not context.blueprint then\n\009\009if\n\009\009\009FN.SIM.is_suit(context.other_card, G.GAME.current_round.castle_card.suit) and not context.other_card.debuff\n\009\009then\n\009\009\009joker_obj.ability.extra.chips = joker_obj.ability.extra.chips + joker_obj.ability.extra.chip_mod\n\009\009end\n\009end\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_chips(joker_obj.ability.extra.chips) end\nend\nFNSJ.simulate_smiley = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if FN.SIM.is_face(context.other_card) and not context.other_card.debuff then\n\009\009\009FN.SIM.add_mult(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_campfire = function(joker_obj, context)\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_ticket = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if context.other_card.ability.effect == \"Gold Card\" and not context.other_card.debuff then\n\009\009\009FN.SIM.add_dollars(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_mr_bones = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_acrobat = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009-- Note: Checking against 1 is needed as hands_left is not decremented as part of simulation\n\009\009if G.GAME.current_round.hands_left == 1 then FN.SIM.x_mult(joker_obj.ability.extra) end\n\009end\nend\nFNSJ.simulate_sock_and_buskin = function(joker_obj, context)\n\009if context.cardarea == G.play and context.repetition then\n\009\009if FN.SIM.is_face(context.other_card) and not context.other_card.debuff then\n\009\009\009FN.SIM.add_reps(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_swashbuckler = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_mult(joker_obj.ability.mult) end\nend\nFNSJ.simulate_troubadour = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_certificate = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_smeared = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_throwback = function(joker_obj, context)\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_hanging_chad = function(joker_obj, context)\n\009if joker_obj.ability.extra == 1 then\n\009\009if context.cardarea == G.play and context.repetition then\n\009\009\009if context.other_card == context.scoring_hand[1] and not context.other_card.debuff then\n\009\009\009\009FN.SIM.add_reps(joker_obj.ability.extra)\n\009\009\009end\n\009\009\009if context.other_card == context.scoring_hand[2] and not context.other_card.debuff then\n\009\009\009\009FN.SIM.add_reps(joker_obj.ability.extra)\n\009\009\009end\n\009\009end\n\009else\n\009\009if context.cardarea == G.play and context.repetition then\n\009\009\009if context.other_card == context.scoring_hand[1] and not context.other_card.debuff then\n\009\009\009\009FN.SIM.add_reps(joker_obj.ability.extra)\n\009\009\009end\n\009\009end\n\009end\nend\nFNSJ.simulate_rough_gem = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if FN.SIM.is_suit(context.other_card, \"Diamonds\") and not context.other_card.debuff then\n\009\009\009FN.SIM.add_dollars(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_bloodstone = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if FN.SIM.is_suit(context.other_card, \"Hearts\") and not context.other_card.debuff then\n\009\009\009local exact_xmult, min_xmult, max_xmult = FN.SIM.get_probabilistic_extremes(\n\009\009\009\009pseudorandom(\"nopeagain\"),\n\009\009\009\009joker_obj.ability.extra.odds,\n\009\009\009\009joker_obj.ability.extra.Xmult,\n\009\009\009\0091\n\009\009\009)\n\009\009\009FN.SIM.x_mult(exact_xmult, min_xmult, max_xmult)\n\009\009end\n\009end\nend\nFNSJ.simulate_arrowhead = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if FN.SIM.is_suit(context.other_card, \"Spades\") and not context.other_card.debuff then\n\009\009\009FN.SIM.add_chips(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_onyx_agate = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if FN.SIM.is_suit(context.other_card, \"Clubs\") and not context.other_card.debuff then\n\009\009\009FN.SIM.add_mult(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_glass = function(joker_obj, context)\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_ring_master = function(joker_obj, context)\n\009-- Effect not relevant (Note: this is actually Showman)\nend\nFNSJ.simulate_flower_pot = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009local suit_count = {\n\009\009\009[\"Hearts\"] = 0,\n\009\009\009[\"Diamonds\"] = 0,\n\009\009\009[\"Spades\"] = 0,\n\009\009\009[\"Clubs\"] = 0,\n\009\009}\n\n\009\009function inc_suit(suit)\n\009\009\009suit_count[suit] = suit_count[suit] + 1\n\009\009end\n\n\009\009-- Account for all 'real' suits.\n\009\009-- NOTE: Debuffed (non-wild) cards are still counted for their suits\n\009\009for _, card in ipairs(context.scoring_hand) do\n\009\009\009if card.ability.effect ~= \"Wild Card\" then\n\009\009\009\009if FN.SIM.is_suit(card, \"Hearts\", true) and suit_count[\"Hearts\"] == 0 then\n\009\009\009\009\009inc_suit(\"Hearts\")\n\009\009\009\009elseif FN.SIM.is_suit(card, \"Diamonds\", true) and suit_count[\"Diamonds\"] == 0 then\n\009\009\009\009\009inc_suit(\"Diamonds\")\n\009\009\009\009elseif FN.SIM.is_suit(card, \"Spades\", true) and suit_count[\"Spades\"] == 0 then\n\009\009\009\009\009inc_suit(\"Spades\")\n\009\009\009\009elseif FN.SIM.is_suit(card, \"Clubs\", true) and suit_count[\"Clubs\"] == 0 then\n\009\009\009\009\009inc_suit(\"Clubs\")\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\n\009\009-- Let Wild Cards fill in the gaps.\n\009\009-- NOTE: Debuffed wild cards are completely ignored\n\009\009for _, card in ipairs(context.scoring_hand) do\n\009\009\009if card.ability.effect == \"Wild Card\" then\n\009\009\009\009if FN.SIM.is_suit(card, \"Hearts\") and suit_count[\"Hearts\"] == 0 then\n\009\009\009\009\009inc_suit(\"Hearts\")\n\009\009\009\009elseif FN.SIM.is_suit(card, \"Diamonds\") and suit_count[\"Diamonds\"] == 0 then\n\009\009\009\009\009inc_suit(\"Diamonds\")\n\009\009\009\009elseif FN.SIM.is_suit(card, \"Spades\") and suit_count[\"Spades\"] == 0 then\n\009\009\009\009\009inc_suit(\"Spades\")\n\009\009\009\009elseif FN.SIM.is_suit(card, \"Clubs\") and suit_count[\"Clubs\"] == 0 then\n\009\009\009\009\009inc_suit(\"Clubs\")\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\n\009\009if\n\009\009\009suit_count[\"Hearts\"] > 0\n\009\009\009and suit_count[\"Diamonds\"] > 0\n\009\009\009and suit_count[\"Spades\"] > 0\n\009\009\009and suit_count[\"Clubs\"] > 0\n\009\009then\n\009\009\009FN.SIM.x_mult(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_blueprint = function(joker_obj, context)\n\009local joker_to_mimic = nil\n\009for idx, joker in ipairs(FN.SIM.env.jokers) do\n\009\009if joker == joker_obj then joker_to_mimic = FN.SIM.env.jokers[idx + 1] end\n\009end\n\009if joker_to_mimic then\n\009\009context.blueprint = (context.blueprint and (context.blueprint + 1)) or 1\n\009\009if context.blueprint > #FN.SIM.env.jokers + 1 then return end\n\009\009FN.SIM.simulate_joker(joker_to_mimic, context)\n\009end\nend\nFNSJ.simulate_wee = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual and not context.blueprint then\n\009\009if FN.SIM.is_rank(context.other_card, 2) and not context.other_card.debuff then\n\009\009\009joker_obj.ability.extra.chips = joker_obj.ability.extra.chips + joker_obj.ability.extra.chip_mod\n\009\009end\n\009end\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_chips(joker_obj.ability.extra.chips) end\nend\nFNSJ.simulate_merry_andy = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_oops = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_idol = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if\n\009\009\009FN.SIM.is_rank(context.other_card, G.GAME.current_round.idol_card.id)\n\009\009\009and FN.SIM.is_suit(context.other_card, G.GAME.current_round.idol_card.suit)\n\009\009\009and not context.other_card.debuff\n\009\009then\n\009\009\009FN.SIM.x_mult(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_seeing_double = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009local suit_count = {\n\009\009\009[\"Hearts\"] = 0,\n\009\009\009[\"Diamonds\"] = 0,\n\009\009\009[\"Spades\"] = 0,\n\009\009\009[\"Clubs\"] = 0,\n\009\009}\n\n\009\009function inc_suit(suit)\n\009\009\009suit_count[suit] = suit_count[suit] + 1\n\009\009end\n\n\009\009-- Account for all 'real' suits:\n\009\009for _, card in ipairs(context.scoring_hand) do\n\009\009\009if card.ability.effect ~= \"Wild Card\" then\n\009\009\009\009if FN.SIM.is_suit(card, \"Hearts\") then inc_suit(\"Hearts\") end\n\009\009\009\009if FN.SIM.is_suit(card, \"Diamonds\") then inc_suit(\"Diamonds\") end\n\009\009\009\009if FN.SIM.is_suit(card, \"Spades\") then inc_suit(\"Spades\") end\n\009\009\009\009if FN.SIM.is_suit(card, \"Clubs\") then inc_suit(\"Clubs\") end\n\009\009\009end\n\009\009end\n\n\009\009-- Let Wild Cards fill in the gaps:\n\009\009for _, card in ipairs(context.scoring_hand) do\n\009\009\009if card.ability.effect == \"Wild Card\" then\n\009\009\009\009-- IMPORTANT: Clubs must come first here, because Clubs are required for xmult. This is in line with game's implementation.\n\009\009\009\009if FN.SIM.is_suit(card, \"Clubs\") and suit_count[\"Clubs\"] == 0 then\n\009\009\009\009\009inc_suit(\"Clubs\")\n\009\009\009\009elseif FN.SIM.is_suit(card, \"Hearts\") and suit_count[\"Hearts\"] == 0 then\n\009\009\009\009\009inc_suit(\"Hearts\")\n\009\009\009\009elseif FN.SIM.is_suit(card, \"Diamonds\") and suit_count[\"Diamonds\"] == 0 then\n\009\009\009\009\009inc_suit(\"Diamonds\")\n\009\009\009\009elseif FN.SIM.is_suit(card, \"Spades\") and suit_count[\"Spades\"] == 0 then\n\009\009\009\009\009inc_suit(\"Spades\")\n\009\009\009\009end\n\009\009\009end\n\009\009end\n\n\009\009if\n\009\009\009suit_count[\"Clubs\"] > 0\n\009\009\009and (suit_count[\"Hearts\"] > 0 or suit_count[\"Diamonds\"] > 0 or suit_count[\"Spades\"] > 0)\n\009\009then\n\009\009\009FN.SIM.x_mult(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_matador = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.debuffed_hand then\n\009\009if G.GAME.blind.triggered then FN.SIM.add_dollars(joker_obj.ability.extra) end\n\009end\nend\nFNSJ.simulate_hit_the_road = function(joker_obj, context)\n\009if context.cardarea == G.hand and context.discard and not context.blueprint then\n\009\009if FN.SIM.is_rank(context.other_card, 11) and not context.other_card.debuff then\n\009\009\009joker_obj.ability.x_mult = joker_obj.ability.x_mult + joker_obj.ability.extra\n\009\009end\n\009end\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_duo = function(joker_obj, context)\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_trio = function(joker_obj, context)\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_family = function(joker_obj, context)\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_order = function(joker_obj, context)\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_tribe = function(joker_obj, context)\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_stuntman = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_chips(joker_obj.ability.extra.chip_mod) end\nend\nFNSJ.simulate_invisible = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_brainstorm = function(joker_obj, context)\n\009local joker_to_mimic = FN.SIM.env.jokers[1]\n\009if joker_to_mimic and joker_to_mimic ~= joker_obj then\n\009\009context.blueprint = (context.blueprint and (context.blueprint + 1)) or 1\n\009\009if context.blueprint > #FN.SIM.env.jokers + 1 then return end\n\009\009FN.SIM.simulate_joker(joker_to_mimic, context)\n\009end\nend\nFNSJ.simulate_satellite = function(joker_obj, context)\n\009-- Effect not relevant (End of Round)\nend\nFNSJ.simulate_shoot_the_moon = function(joker_obj, context)\n\009if context.cardarea == G.hand and context.individual then\n\009\009if FN.SIM.is_rank(context.other_card, 12) and not context.other_card.debuff then FN.SIM.add_mult(13) end\n\009end\nend\nFNSJ.simulate_drivers_license = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009if (joker_obj.ability.driver_tally or 0) >= 16 then FN.SIM.x_mult(joker_obj.ability.extra) end\n\009end\nend\nFNSJ.simulate_cartomancer = function(joker_obj, context)\n\009-- Effect not relevant (Blind)\nend\nFNSJ.simulate_astronomer = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_burnt = function(joker_obj, context)\n\009-- Effect not relevant (Discard)\nend\nFNSJ.simulate_bootstraps = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009local function bootstraps(data)\n\009\009\009return joker_obj.ability.extra.mult\n\009\009\009\009* math.floor((G.GAME.dollars + data.dollars) / joker_obj.ability.extra.dollars)\n\009\009end\n\009\009local min_mult = bootstraps(FN.SIM.running.min)\n\009\009local exact_mult = bootstraps(FN.SIM.running.exact)\n\009\009local max_mult = bootstraps(FN.SIM.running.max)\n\009\009FN.SIM.add_mult(exact_mult, min_mult, max_mult)\n\009end\nend\nFNSJ.simulate_caino = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009if joker_obj.ability.caino_xmult > 1 then FN.SIM.x_mult(joker_obj.ability.caino_xmult) end\n\009end\nend\nFNSJ.simulate_triboulet = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if FN.SIM.is_rank(context.other_card, { 12, 13 }) and not context.other_card.debuff then\n\009\009\009FN.SIM.x_mult(joker_obj.ability.extra)\n\009\009end\n\009end\nend\nFNSJ.simulate_yorick = function(joker_obj, context)\n\009if context.cardarea == G.hand and context.discard and not context.blueprint then\n\009\009-- This is only necessary for 'The Hook' blind.\n\009\009if joker_obj.ability.yorick_discards > 1 then\n\009\009\009joker_obj.ability.yorick_discards = joker_obj.ability.yorick_discards - 1\n\009\009else\n\009\009\009joker_obj.ability.yorick_discards = joker_obj.ability.extra.discards\n\009\009\009joker_obj.ability.x_mult = joker_obj.ability.x_mult + joker_obj.ability.extra.xmult\n\009\009end\n\009end\n\n\009FN.SIM.JOKERS.x_mult_if_global(joker_obj, context)\nend\nFNSJ.simulate_chicot = function(joker_obj, context)\n\009-- Effect not relevant (Meta)\nend\nFNSJ.simulate_perkeo = function(joker_obj, context)\n\009-- Effect not relevant (Blind)\nend\n","FNSJ.simulate_mp_defensive_joker = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_chips(joker_obj.ability.t_chips) end\nend\n\nFNSJ.simulate_mp_taxes = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then FN.SIM.add_mult(joker_obj.ability.extra.mult) end\nend\n\nFNSJ.simulate_mp_pacifist = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global and not MP.is_pvp_boss() then\n\009\009FN.SIM.x_mult(joker_obj.ability.extra.x_mult)\n\009end\nend\n\nFNSJ.simulate_mp_conjoined_joker = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global and MP.is_pvp_boss() then\n\009\009FN.SIM.x_mult(joker_obj.ability.extra.x_mult)\n\009end\nend\n\nFNSJ.simulate_mp_hanging_chad = function(joker_obj, context)\n\009if context.cardarea == G.play and context.repetition then\n\009\009if context.other_card == context.scoring_hand[1] and not context.other_card.debuff then\n\009\009\009FN.SIM.add_reps(joker_obj.ability.extra)\n\009\009end\n\009\009if context.other_card == context.scoring_hand[2] and not context.other_card.debuff then\n\009\009\009FN.SIM.add_reps(joker_obj.ability.extra)\n\009\009end\n\009end\nend\n\nFNSJ.simulate_mp_lets_go_gambling = function(joker_obj, context)\n\009if context.cardarea == G.jokers and context.global then\n\009\009local rand = pseudorandom(\"gambling\") -- Must reuse same pseudorandom value:\n\009\009local exact_xmult, min_xmult, max_xmult =\n\009\009\009FN.SIM.get_probabilistic_extremes(rand, joker_obj.ability.extra.odds, joker_obj.ability.extra.xmult, 1)\n\009\009local exact_money, min_money, max_money =\n\009\009\009FN.SIM.get_probabilistic_extremes(rand, joker_obj.ability.extra.odds, joker_obj.ability.extra.dollars, 0)\n\n\009\009FN.SIM.add_dollars(exact_money, min_money, max_money)\n\009\009FN.SIM.x_mult(exact_xmult, min_xmult, max_xmult)\n\009end\nend\n\nFNSJ.simulate_mp_seltzer = function(joker_obj, context)\n\009if context.cardarea == G.play and context.repetition then FN.SIM.add_reps(1) end\nend\n\nFNSJ.simulate_mp_bloodstone = function(joker_obj, context)\n\009if context.cardarea == G.play and context.individual then\n\009\009if FN.SIM.is_suit(context.other_card, \"Hearts\") and not context.other_card.debuff then\n\009\009\009local exact_xmult, min_xmult, max_xmult = FN.SIM.get_probabilistic_extremes(\n\009\009\009\009pseudorandom(\"nopeagain\"),\n\009\009\009\009joker_obj.ability.extra.odds,\n\009\009\009\009joker_obj.ability.extra.Xmult,\n\009\009\009\0091\n\009\009\009)\n\009\009\009FN.SIM.x_mult(exact_xmult, min_xmult, max_xmult)\n\009\009end\n\009end\nend\n"}},{["mod"]="Multiplayer",["id"]="Multiplayer",["k"]="copy",["t"]={"functions/UI_definitions.lua"},["position"]="append",["contents"]={"-- The user interface components that display simulation results.\n\n-- Append node for preview text to the HUD:\nlocal orig_hud = create_UIBox_HUD\nfunction create_UIBox_HUD()\n\009local contents = orig_hud()\n\n\009if not MP.INTEGRATIONS.Preview then return contents end\n\n\009-- Check if preview is disabled in lobby options\n\009if MP.LOBBY.config and MP.LOBBY.config.preview_disabled then return contents end\n\n\009local score_node_wrap =\n\009\009{ n = G.UIT.R, config = { id = \"fn_pre_score_wrap\", align = \"cm\", padding = 0.1 }, nodes = {} }\n\009table.insert(score_node_wrap.nodes, FN.PRE.get_score_node())\n\009local calculate_score_button_wrap =\n\009\009{ n = G.UIT.R, config = { id = \"fn_calculate_score_button_wrap\", align = \"cm\", padding = 0.1 }, nodes = {} }\n\009table.insert(calculate_score_button_wrap.nodes, FN.PRE.get_calculate_score_button())\n\009local score_wrap = {\n\009\009n = G.UIT.R,\n\009\009config = { id = \"fn_real_wrap\", align = \"cm\", padding = 0.0 },\n\009\009nodes = { score_node_wrap, calculate_score_button_wrap },\n\009}\n\n\009table.insert(contents.nodes[1].nodes[1].nodes[4].nodes[1].nodes, score_wrap) -- you can only do one so we have to wrap both of them. do not ask. i have no idea why\n\n\009return contents\nend\n\nfunction G.FUNCS.calculate_score_button()\n\009FN.PRE.start_new_coroutine()\nend\n\nfunction FN.PRE.get_calculate_score_button()\n\009return {\n\009\009n = G.UIT.C,\n\009\009config = {\n\009\009\009id = \"calculate_score_button\",\n\009\009\009button = \"calculate_score_button\",\n\009\009\009align = \"cm\",\n\009\009\009minh = 0.42,\n\009\009\009padding = 0.05,\n\009\009\009minw = 3,\n\009\009\009r = 0.02,\n\009\009\009colour = G.C.RED,\n\009\009\009hover = true,\n\009\009\009shadow = true,\n            maxw = 4.5\n\009\009},\n\009\009nodes = {\n\009\009\009{\n\009\009\009\009n = G.UIT.R,\n\009\009\009\009config = { align = \"cm\" },\n\009\009\009\009nodes = {\n\009\009\009\009\009{\n\009\009\009\009\009\009n = G.UIT.T,\n\009\009\009\009\009\009config = {\n\009\009\009\009\009\009\009text = MP.UTILS.get_preview_cfg(\"button\"),\n\009\009\009\009\009\009\009colour = G.C.UI.TEXT_LIGHT,\n\009\009\009\009\009\009\009shadow = true,\n\009\009\009\009\009\009\009scale = 0.36,\n\009\009\009\009\009\009},\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009}\nend\n\nfunction FN.PRE.get_score_node()\n\009local text_scale = nil\n\009if true then\n\009\009text_scale = 0.5\n\009else\n\009\009text_scale = 0.75\n\009end\n\n\009return {\n\009\009n = G.UIT.C,\n\009\009config = { id = \"fn_pre_score\", align = \"cm\", minh = 0.5 },\n\009\009nodes = {\n\009\009\009{\n\009\009\009\009n = G.UIT.O,\n\009\009\009\009config = {\n\009\009\009\009\009id = \"fn_pre_l\",\n\009\009\009\009\009func = \"fn_pre_score_UI_set\",\n\009\009\009\009\009object = DynaText({\n\009\009\009\009\009\009string = { { ref_table = FN.PRE.text.score, ref_value = \"l\" } },\n\009\009\009\009\009\009colours = { G.C.UI.TEXT_LIGHT },\n\009\009\009\009\009\009shadow = true,\n\009\009\009\009\009\009float = true,\n\009\009\009\009\009\009scale = text_scale,\n                        maxw = 2,\n\009\009\009\009\009}),\n\009\009\009\009},\n\009\009\009},\n\009\009\009{\n\009\009\009\009n = G.UIT.O,\n\009\009\009\009config = {\n\009\009\009\009\009id = \"fn_pre_m\",\n\009\009\009\009\009func = \"fn_pre_score_UI_set\",\n\009\009\009\009\009object = DynaText({\n\009\009\009\009\009\009string = { { ref_table = FN.PRE.text.score, ref_value = \"m\" } },\n\009\009\009\009\009\009colours = { G.C.UI.TEXT_LIGHT },\n\009\009\009\009\009\009shadow = true,\n\009\009\009\009\009\009float = true,\n\009\009\009\009\009\009scale = text_scale,\n                        maxw = 4,\n\009\009\009\009\009}),\n\009\009\009\009},\n\009\009\009},\n\009\009\009{\n\009\009\009\009n = G.UIT.O,\n\009\009\009\009config = {\n\009\009\009\009\009id = \"fn_pre_r\",\n\009\009\009\009\009func = \"fn_pre_score_UI_set\",\n\009\009\009\009\009object = DynaText({\n\009\009\009\009\009\009string = { { ref_table = FN.PRE.text.score, ref_value = \"r\" } },\n\009\009\009\009\009\009colours = { G.C.UI.TEXT_LIGHT },\n\009\009\009\009\009\009shadow = true,\n\009\009\009\009\009\009float = true,\n\009\009\009\009\009\009scale = text_scale,\n                        maxw = 2,\n\009\009\009\009\009}),\n\009\009\009\009},\n\009\009\009},\n\009\009},\n\009}\nend\n\n-- TODO Implement\nfunction FN.get_preview_settings_page()\n\009local function preview_score_toggle_callback(e)\n\009\009if not G.HUD then return end\n\n\009\009if G.SETTINGS.FN.preview_score then\n\009\009\009-- Preview was just enabled, so add preview node:\n\009\009\009G.HUD:add_child(FN.PRE.get_score_node(), G.HUD:get_UIE_by_ID(\"fn_pre_score_wrap\"))\n\009\009\009FN.PRE.data = FN.PRE.simulate()\n\009\009else\n\009\009\009-- Preview was just disabled, so remove preview node:\n\009\009\009G.HUD:get_UIE_by_ID(\"fn_pre_score\").parent:remove()\n\009\009end\n\009\009G.HUD:recalculate()\n\009end\n\n\009local function preview_dollars_toggle_callback(_)\n\009\009if not G.HUD then return end\n\n\009\009if G.SETTINGS.FN.preview_dollars then\n\009\009\009-- Preview was just enabled, so add preview node:\n\009\009\009G.HUD:add_child(FN.PRE.get_dollars_node(), G.HUD:get_UIE_by_ID(\"fn_pre_dollars_wrap\"))\n\009\009\009FN.PRE.data = FN.PRE.simulate()\n\009\009else\n\009\009\009-- Preview was just disabled, so remove preview node:\n\009\009\009G.HUD:get_UIE_by_ID(\"fn_pre_dollars\").parent:remove()\n\009\009end\n\009\009G.HUD:recalculate()\n\009end\n\n\009local function face_down_toggle_callback(_)\n\009\009if not G.HUD then return end\n\n\009\009FN.PRE.data = FN.PRE.simulate()\n\009\009G.HUD:recalculate()\n\009end\n\n\009return {\n\009\009n = G.UIT.ROOT,\n\009\009config = { align = \"cm\", padding = 0.05, colour = G.C.CLEAR },\n\009\009nodes = {\n\009\009\009create_toggle({\n\009\009\009\009id = \"score_toggle\",\n\009\009\009\009label = \"Enable Score Preview\",\n\009\009\009\009ref_table = G.SETTINGS.FN,\n\009\009\009\009ref_value = \"preview_score\",\n\009\009\009\009callback = preview_score_toggle_callback,\n\009\009\009}),\n\009\009\009create_toggle({\n\009\009\009\009id = \"dollars_toggle\",\n\009\009\009\009label = \"Enable Money Preview\",\n\009\009\009\009ref_table = G.SETTINGS.FN,\n\009\009\009\009ref_value = \"preview_dollars\",\n\009\009\009\009callback = preview_dollars_toggle_callback,\n\009\009\009}),\n\009\009\009create_toggle({\n\009\009\009\009label = \"Hide Preview if Any Card is Face-Down\",\n\009\009\009\009ref_table = G.SETTINGS.FN,\n\009\009\009\009ref_value = \"hide_face_down\",\n\009\009\009\009callback = face_down_toggle_callback,\n\009\009\009}),\n\009\009},\n\009}\nend\n"}},{["mod"]="Amulet",["id"]="Amulet",["k"]="copy",["t"]={"main.lua"},["position"]="append",["contents"]={"\nTalisman.patch_ok = true\n"}},{["mod"]="Cartomancer",["id"]="Cartomancer",["k"]="copy",["t"]={"main.lua"},["position"]="append",["contents"]={"require 'cartomancer.init'\n\nCartomancer.path = assert(\n    Cartomancer.find_self('cartomancer.lua'),\n    \"Failed to find mod folder. Make sure that `Cartomancer` folder has `cartomancer.lua` file!\"\n)\n\nCartomancer.load_mod_file('internal/config.lua', 'cartomancer.config')\nCartomancer.load_mod_file('internal/atlas.lua', 'cartomancer.atlas')\nCartomancer.load_mod_file('internal/ui.lua', 'cartomancer.ui')\nCartomancer.load_mod_file('internal/keybinds.lua', 'cartomancer.keybinds')\n\nCartomancer.load_mod_file('core/view-deck.lua', 'cartomancer.view-deck')\nCartomancer.load_mod_file('core/flames.lua', 'cartomancer.flames')\nCartomancer.load_mod_file('core/optimizations.lua', 'cartomancer.optimizations')\nCartomancer.load_mod_file('core/jokers.lua', 'cartomancer.jokers')\nCartomancer.load_mod_file('core/hand.lua', 'cartomancer.hand')\nCartomancer.load_mod_file('core/blinds_info.lua', 'cartomancer.blinds_info')\nif SMODS then\n    Cartomancer.load_mod_file('core/view-deck-steamodded.lua', 'cartomancer.view-deck-steamodded')\nend\n\nCartomancer.load_config()\n\nCartomancer.INTERNAL_jokers_menu = false\n\n-- TODO dedicated keybinds file? keybinds need to load after config\nCartomancer.register_keybind {\n    name = 'hide_joker',\n    func = function (controller)\n        Cartomancer.hide_hovered_joker(controller)\n    end\n}\n\nCartomancer.register_keybind {\n    name = 'toggle_tags',\n    func = function (controller)\n        Cartomancer.SETTINGS.hide_tags = not Cartomancer.SETTINGS.hide_tags\n        Cartomancer.update_tags_visibility()\n    end\n}\n\nCartomancer.register_keybind {\n    name = 'toggle_consumables',\n    func = function (controller)\n        Cartomancer.SETTINGS.hide_consumables = not Cartomancer.SETTINGS.hide_consumables\n    end\n}\n\nCartomancer.register_keybind {\n    name = 'toggle_deck',\n    func = function (controller)\n        Cartomancer.SETTINGS.hide_deck = not Cartomancer.SETTINGS.hide_deck\n    end\n}\n\nCartomancer.register_keybind {\n    name = 'toggle_jokers',\n    func = function (controller)\n        if not (G and G.jokers) then\n            return\n        end\n        G.jokers.cart_hide_all = not G.jokers.cart_hide_all\n\n        if G.jokers.cart_hide_all then\n            Cartomancer.hide_all_jokers()\n        else\n            Cartomancer.show_all_jokers()\n        end\n        Cartomancer.align_G_jokers()\n    end\n}\n\nCartomancer.register_keybind {\n    name = 'toggle_jokers_buttons',\n    func = function (controller)\n        Cartomancer.SETTINGS.jokers_controls_buttons = not Cartomancer.SETTINGS.jokers_controls_buttons\n    end\n}\n"}}},["edits"]={{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"main.lua"},["pattern"]="function love.errhand(msg)",["position"]="at",["payload"]="if false then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="local saveTable = args.savetext or nil\n",["position"]="after",["payload"]="if G.SAVED_GAME then SMODS.save_game = G.SAVED_GAME.GAME.smods_version else SMODS.save_game = nil end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"=[lovely SMODS.preflight.core \"src/preflight/core.lua\"]"},["pattern"]="local lovely_path = false -- This line is patched, don't edit it",["position"]="at",["payload"]="local lovely_path = [[Mods/Steamodded/]]",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"main.lua"},["pattern"]="if (love.system.getOS() == 'OS X' ) and (jit.arch == 'arm64' or jit.arch == 'arm') then jit.off() end",["position"]="before",["payload"]="if SMODS and SMODS.preflight_force_quit then if SMODS.preflight_quit_before then SMODS.preflight_quit_before() end return end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if G.GAME.challenge then return end",["position"]="after",["payload"]="fetch_achievements() -- Refreshes achievements\nfor k, v in pairs(G.ACHIEVEMENTS) do\n    if (not v.earned) and (v.unlock_condition and type(v.unlock_condition) == 'function') and v:unlock_condition(args) then\n        unlock_achievement(k)\n    end\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if G.PROFILES[G.SETTINGS.profile].all_unlocked then return end",["position"]="at",["payload"]="if G.PROFILES[G.SETTINGS.profile].all_unlocked and (G.ACHIEVEMENTS and G.ACHIEVEMENTS[achievement_name] and not G.ACHIEVEMENTS[achievement_name].bypass_all_unlocked and SMODS.config.achievements < 3) or (SMODS.config.achievements < 3 and (G.GAME.seeded or G.GAME.challenge)) then return true end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="local achievement_set = false\nif G.F_NO_ACHIEVEMENTS then return end",["position"]="at",["payload"]="local achievement_set = false\nif not G.ACHIEVEMENTS then fetch_achievements() end\nG.SETTINGS.ACHIEVEMENTS_EARNED[achievement_name] = true\nG:save_progress()\n\nif G.ACHIEVEMENTS[achievement_name] and G.ACHIEVEMENTS[achievement_name].mod then \n    if not G.ACHIEVEMENTS[achievement_name].earned then\n        --|THIS IS THE FIRST TIME THIS ACHIEVEMENT HAS BEEN EARNED\n        achievement_set = true\n        G.FILE_HANDLER.force = true\n    end\n    G.ACHIEVEMENTS[achievement_name].earned = true\nend\n\nif achievement_set then \n    notify_alert(achievement_name)\n    return true\nend\nif G.F_NO_ACHIEVEMENTS and not (G.ACHIEVEMENTS[achievement_name] or {}).mod then return true end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if not G.GAME.seeded and not G.GAME.challenge then",["position"]="at",["payload"]="if (not G.GAME.seeded and not G.GAME.challenge) or SMODS.config.seeded_unlocks then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="G:set_render_settings()",["position"]="at",["payload"]="SMODS.injectObjects(SMODS.Atlas)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"engine/moveable.lua"},["pattern"]="Node.init(self, args)",["position"]="after",["payload"]="self.original_T = copy_table(self.T)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self.T.scale = 0.95",["position"]="after",["payload"]="self.original_T.scale = 0.95",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self:set_ability(center, true)",["position"]="before",["payload"]="self.original_T = copy_table(self.T)",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="local X, Y, W, H = self.T.x, self.T.y, self.T.w, self.T.h\n",["position"]="before",["payload"]="for key, _ in pairs(self.T) do\n    self.T[key] = self.original_T[key]\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"back.lua"},["pattern"]="if not selected_back then selected_back = G.P_CENTERS.b_red end",["position"]="after",["payload"]="self.atlas = selected_back.unlocked and selected_back.atlas or nil",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"back.lua"},["pattern"]="if not new_back then new_back = G.P_CENTERS.b_red end",["position"]="after",["payload"]="self.atlas = new_back.unlocked and new_back.atlas or nil",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="G.PROFILES[G.SETTINGS.profile].MEMORY.deck = args.to_val",["position"]="after",["payload"]="for key, val in pairs(G.sticker_card.area.cards) do\n\009val.children.back = false\n\009val:set_ability(val.config.center, true)\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"back.lua"},["pattern"]="function Back:apply_to_run()",["position"]="after",["payload"]="\009local obj = self.effect.center\n\009if obj.apply and type(obj.apply) == 'function' then\n\009\009obj:apply(self)\n\009end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"back.lua"},["pattern"]="if self.effect.config.randomize_rank_suit then",["position"]="before",["payload"]="G.E_MANAGER:add_event(Event({\n\009func = function()\n\009\009G.E_MANAGER:add_event(Event({\n\009\009\009func = function()\n\009\009\009\009save_run()\n\009\009\009\009return true\n\009\009\009end\n\009\009}))\n\009\009return true\n\009end\n}))\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"back.lua"},["pattern"]="if not args then return end",["position"]="after",["payload"]="\009local obj = self.effect.center\n\009if type(obj.calculate) == 'function' then\n\009\009local o = {obj:calculate(self, args)}\n\009\009if next(o) ~= nil then return unpack(o) end\n\009elseif type(obj.trigger_effect) == 'function' then\n\009\009-- kept for compatibility\n\009\009local o = {obj:trigger_effect(args)}\n\009\009if next(o) ~= nil then\n\009\009\009sendWarnMessage(('Found `trigger_effect` function on SMODS.Back object \"%s\". This field is deprecated; please use `calculate` instead.'):format(obj.key), 'Back')\n\009\009\009return unpack(o)\n\009\009end\n\009end",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"back.lua"},["pattern"]="if not back_config.unlock_condition then",["position"]="at",["payload"]="local localized_by_smods\nlocal key_override\nif back_config.locked_loc_vars and type(back_config.locked_loc_vars) == 'function' then\n\009local res = back_config:locked_loc_vars() or {}\n\009loc_args = res.vars or {}\n\009key_override = res.key\nend\nif G.localization.descriptions.Back[key_override or back_config.key].unlock_parsed then\n\009localize{type = 'unlocks', key = key_override or back_config.key, set = 'Back', nodes = loc_nodes, vars = loc_args}\n\009localized_by_smods = true\nend\nif not back_config.unlock_condition then",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"back.lua"},["pattern"]="localize{type = 'descriptions', key = 'demo_locked', set = \"Other\", nodes = loc_nodes, vars = loc_args}",["position"]="at",["payload"]="if not localized_by_smods then\n\009localize{type = 'descriptions', key = 'demo_locked', set = \"Other\", nodes = loc_nodes, vars = loc_args}\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"back.lua"},["pattern"]="loc_args = {other_name}",["position"]="at",["payload"]="loc_args = loc_args or {other_name}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"back.lua"},["pattern"]="loc_args = {tostring(back_config.unlock_condition.amount)}",["position"]="at",["payload"]="loc_args = loc_args or {tostring(back_config.unlock_condition.amount)}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"back.lua"},["pattern"]="loc_args = {other_name, colours = {get_stake_col(back_config.unlock_condition.stake)}}",["position"]="at",["payload"]="loc_args = loc_args or {other_name, colours = {get_stake_col(back_config.unlock_condition.stake)}}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"back.lua"},["pattern"]="if name_to_check == 'Blue Deck'*",["position"]="at",["payload"]="local key_override\nif back_config.loc_vars and type(back_config.loc_vars) == 'function' then\n\009local res = back_config:loc_vars() or {}\n\009loc_args = res.vars or {}\n\009key_override = res.key\nelseif name_to_check == 'Blue Deck' then loc_args = {effect_config.hands}",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"back.lua"},["pattern"]="if self.effect.config.voucher then\n",["position"]="before",["payload"]="if self.effect.config.jokers then\n        delay(0.4)\n        G.E_MANAGER:add_event(Event({\n            func = function()\n                for k, v in ipairs(self.effect.config.jokers) do\n                    local card = create_card('Joker', G.jokers, nil, nil, nil, nil, v, 'deck')\n                    card:add_to_deck()\n                    G.jokers:emplace(card)\n\009\009\009\009\009card:start_materialize()\n                end\n            return true\n            end\n        }))\n    end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="self.GAME.selected_back = Back(selected_back)",["position"]="after",["payload"]="if saveTable then\n    self.GAME.selected_back:load(saveTable.BACK)\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="function eval_card(card, context)\n    context = context or {}\n    local ret = {}\n",["position"]="at",["payload"]="function eval_card(card, context)\n    context = context or {}\n    if not card:can_calculate(context.ignore_debuff, context.remove_playing_cards or context.joker_type_destroyed) then\n        if card.ability.rental then\n            local ret = {}\n            ret[SMODS.Stickers.rental] = card:calculate_sticker(context, 'rental')\n            return ret, {}\n        end\n        return {}, {}\n    end\n\009local vanilla_debuff_handling\n    for _, key in ipairs(SMODS.custom_debuff_handling) do if card.config.center_key == key then vanilla_debuff_handling = true; break end end\n    if context.other_card and context.other_card.can_calculate and not context.other_card:can_calculate(context.ignore_other_debuff or context.ignore_debuff) and not vanilla_debuff_handling then return {}, {} end\n    local ret = {}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if context.cardarea == G.play then\n    local chips = card:get_chip_bonus()\n    if chips > 0 then\n        ret.chips = chips\n    end\n\n    local mult = card:get_chip_mult()\n    if mult > 0 then\n        ret.mult = mult\n    end\n\n    local x_mult = card:get_chip_x_mult(context)\n    if x_mult > 0 then\n        ret.x_mult = x_mult\n    end\n\n    local p_dollars = card:get_p_dollars()\n    if p_dollars > 0 then\n        ret.p_dollars = p_dollars\n    end\n\n    local jokers = card:calculate_joker(context)\n    if jokers then\n        ret.jokers = jokers\n    end\n\n    local edition = card:get_edition(context)\n    if edition then\n        ret.edition = edition\n    end\nend\n",["position"]="at",["payload"]="if context.cardarea == G.play and context.main_scoring then\n    ret.playing_card = {}\n    local chips = card:get_chip_bonus()\n    if chips ~= 0 then\n        ret.playing_card.chips = chips\n    end\n\n    local mult = card:get_chip_mult()\n    if mult ~= 0 then\n        ret.playing_card.mult = mult\n    end\n\n    local x_mult = card:get_chip_x_mult(context)\n    if x_mult > 0 then\n        ret.playing_card.x_mult = x_mult\n    end\n\n    local p_dollars = card:get_p_dollars()\n    if p_dollars ~= 0 then\n        ret.playing_card.p_dollars = p_dollars\n    end\n\n    local x_chips = card:get_chip_x_bonus()\n    if x_chips > 0 then\n        ret.playing_card.x_chips = x_chips\n    end\n\n    local score = card:get_bonus_score()\n    if score ~= 0 then\n        ret.playing_card.score = score\n    end\n    local x_score = card:get_bonus_x_score()\n    if x_score > 0 then\n        ret.playing_card.x_score = x_score\n    end\n\n\009local blind_size = card:get_bonus_blind_size()\n    if blind_size ~= 0 then\n        ret.playing_card.blind_size = blind_size\n    end\n    local x_blind_size = card:get_bonus_x_blind_size()\n    if x_blind_size > 0 then\n        ret.playing_card.x_blind_size = x_blind_size\n    end\n    \n    -- TARGET: main scoring on played cards\nend\nif context.end_of_round and context.cardarea == G.hand and context.playing_card_end_of_round then\n    local end_of_round = card:get_end_of_round_effect(context)\n    if end_of_round then\n        ret.end_of_round = end_of_round\n    end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if context.cardarea == G.hand then\n    local h_mult = card:get_chip_h_mult()\n    if h_mult > 0 then\n        ret.h_mult = h_mult\n    end\n\n    local h_x_mult = card:get_chip_h_x_mult()\n    if h_x_mult > 0 then\n        ret.x_mult = h_x_mult\n    end\n\n    local jokers = card:calculate_joker(context)\n    if jokers then\n        ret.jokers = jokers\n    end\n",["position"]="at",["payload"]="if context.cardarea == G.hand and context.main_scoring then\n    ret.playing_card = {}\n    local h_mult = card:get_chip_h_mult()\n    if h_mult ~= 0 then\n        ret.playing_card.h_mult = h_mult\n    end\n\n    local h_x_mult = card:get_chip_h_x_mult()\n    if h_x_mult > 0 then\n        ret.playing_card.x_mult = h_x_mult\n    end\n\n    local h_chips = card:get_chip_h_bonus()\n    if h_chips ~= 0 then\n        ret.playing_card.h_chips = h_chips\n    end\n\n    local h_x_chips = card:get_chip_h_x_bonus()\n    if h_x_chips > 0 then\n        ret.playing_card.x_chips = h_x_chips\n    end\n\n    local h_score = card:get_bonus_h_score()\n    if h_score ~= 0 then\n        ret.playing_card.h_score = h_score\n    end\n    local h_x_score = card:get_bonus_h_x_score()\n    if h_x_score > 0 then\n        ret.playing_card.h_x_score = h_x_score\n    end\n\009local h_blind_size = card:get_bonus_h_blind_size()\n    if h_blind_size ~= 0 then\n        ret.playing_card.blind_size = h_blind_size\n    end\n    local h_x_blind_size = card:get_bonus_h_x_blind_size()\n    if h_x_blind_size > 0 then\n        ret.playing_card.x_blind_size = h_x_blind_size\n    end\n\n    -- TARGET: main scoring on held cards\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="local seals = card:calculate_seal(context)\nif seals then\n    ret.seals = seals\nend\n",["position"]="at",["payload"]="if card.ability.set == 'Enhanced' then\n    local enhancement = card:calculate_enhancement(context)\n    if enhancement then\n        ret.enhancement = enhancement\n    end\nend\nif context.extra_enhancement then return ret end\nif card.edition then\n    local edition = card:calculate_edition(context)\n    if edition then\n        ret.edition = edition\n    end\nend\nif card.seal then\n    local seals = card:calculate_seal(context)\n    if seals then\n        ret.seals = seals\n    end\nend\nfor _,k in ipairs(SMODS.Sticker.obj_buffer) do\n    local v = SMODS.Stickers[k]\n    local sticker = card:calculate_sticker(context, k)\n    if sticker then\n        ret[v] = sticker\n    end\nend\n\n-- TARGET: evaluate your own repetition effects\nif card.ability.repetitions and card.ability.repetitions > 0 then\n    ret.seals = ret.seals or { card = card, message = localize('k_again_ex') }\n    ret.seals.repetitions = (ret.seals.repetitions and ret.seals.repetitions + card.ability.repetitions) or card.ability.repetitions\nend\nif card.ability.perma_repetitions and card.ability.perma_repetitions > 0 then\n    ret.seals = ret.seals or { card = card, message = localize('k_again_ex') }\n    ret.seals.repetitions = (ret.seals.repetitions and ret.seals.repetitions + card.ability.perma_repetitions) or card.ability.perma_repetitions\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if context.cardarea == G.jokers or context.card == G.consumeables then",["position"]="before",["payload"]="if card.ability.set == 'Enhanced' then\n    local enhancement = card:calculate_enhancement(context)\n    if enhancement then\n        ret.enhancement = enhancement\n    end\nend\nif context.extra_enhancement then return ret end\nif card.edition then\n    local edition = card:calculate_edition(context)\n    if edition then\n        ret.edition = edition\n    end\nend\nif card.seal then\n    local seals = card:calculate_seal(context)\n    if seals then\n        ret.seals = seals\n    end\nend\nfor _,k in ipairs(SMODS.Sticker.obj_buffer) do\n    local v = SMODS.Stickers[k]\n    local sticker = card:calculate_sticker(context, k)\n    if sticker then\n        ret[v] = sticker\n    end\nend\n\n-- TARGET: evaluate your own general effects\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if context.cardarea == G.jokers or context.card == G.consumeables then\n    local jokers = nil\n    if context.edition then\n        jokers = card:get_edition(context)\n    elseif context.other_joker then\n        jokers = context.other_joker:calculate_joker(context)\n    else\n        jokers = card:calculate_joker(context)\n    end\n    if jokers then\n        ret.jokers = jokers\n    end\nend\n\nreturn ret",["position"]="at",["payload"]="local post_trig = {}\nlocal areas = SMODS.get_card_areas('jokers')\nlocal area_set = {}\nfor _,v in ipairs(areas) do area_set[v] = true end\nif card.area and area_set[card.area] then\n    local jokers, triggered = card:calculate_joker(context)\n    if jokers == true then jokers = { remove = true } end\n    if type(jokers) ~= 'table' then jokers = nil end\n    if jokers or triggered then\n        ret.jokers = jokers\n        if not (context.retrigger_joker_check or context.retrigger_joker) and not (jokers and jokers.no_retrigger) and not SMODS.is_getter_context(context) then\n            local retriggers = SMODS.calculate_retriggers(card, context, ret)\n            if next(retriggers) then\n                ret.retriggers = retriggers\n            end\n        end\n        if not context.post_trigger and not context.retrigger_joker_check and SMODS.optional_features.post_trigger then\n            SMODS.calculate_context({blueprint_card = context.blueprint_card, post_trigger = true, other_card = card, other_context = context, other_ret = ret}, post_trig)\n        end\n    end\nend\n\nreturn ret, post_trig\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif card.area == G.hand then",["position"]="at",["payload"]="elseif card.area == G.hand or card.area == G.deck then\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif card.area == G.hand or card.area == G.deck then",["position"]="before",["payload"]="elseif card == G.deck then\n    y_off = -0.05*G.CARD_H\n    card_aligned = 'tm'\nelseif card.area == G.discard or card.area == G.vouchers then\n    y_off = card.area == G.discard and -0.35*G.CARD_H or -0.65*G.CARD_H\n    card = G.deck.cards[1] or G.deck\n    card_aligned = 'tm'\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++--\n--Joker Effects\n--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++--",["position"]="before",["payload"]="\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="--calculate the joker edition effects\nlocal edition_effects = eval_card(_card, {cardarea = G.jokers, full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, edition = true})\nif edition_effects.jokers then\n    edition_effects.jokers.edition = true\n    if edition_effects.jokers.chip_mod then\n        hand_chips = mod_chips(hand_chips + edition_effects.jokers.chip_mod)\n        update_hand_text({delay = 0}, {chips = hand_chips})\n        card_eval_status_text(_card, 'jokers', nil, percent, nil, {\n            message = localize{type='variable',key='a_chips',vars={edition_effects.jokers.chip_mod}},\n            chip_mod =  edition_effects.jokers.chip_mod,\n            colour =  G.C.EDITION,\n            edition = true})\n    end\n    if edition_effects.jokers.mult_mod then\n        mult = mod_mult(mult + edition_effects.jokers.mult_mod)\n        update_hand_text({delay = 0}, {mult = mult})\n        card_eval_status_text(_card, 'jokers', nil, percent, nil, {\n            message = localize{type='variable',key='a_mult',vars={edition_effects.jokers.mult_mod}},\n            mult_mod =  edition_effects.jokers.mult_mod,\n            colour = G.C.DARK_EDITION,\n            edition = true})\n    end\n    percent = percent+percent_delta\nend",["position"]="at",["payload"]="local effects = {}\n-- remove base game joker edition calc\nlocal eval = eval_card(_card, {cardarea = G.jokers, full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, edition = true, pre_joker = true})\nif eval.edition then effects[#effects+1] = eval end\n\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="    if edition_effects.jokers then\n        if edition_effects.jokers.x_mult_mod then\n            mult = mod_mult(mult*edition_effects.jokers.x_mult_mod)\n            update_hand_text({delay = 0}, {mult = mult})\n            card_eval_status_text(_card, 'jokers', nil, percent, nil, {\n                message = localize{type='variable',key='a_xmult',vars={edition_effects.jokers.x_mult_mod}},\n                x_mult_mod =  edition_effects.jokers.x_mult_mod,\n                colour =  G.C.EDITION,\n                edition = true})\n        end\n        percent = percent+percent_delta\n    end\nend",["position"]="at",["payload"]="            -- calculate edition multipliers\n            local eval = eval_card(_card, {cardarea = G.jokers, full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, edition = true, post_joker = true})\n            if eval.edition then effects[#effects+1] = eval end\n\n            SMODS.trigger_effects(effects, _card)\n        end end\n",["indent"]=false},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for i=1, #G.jokers.cards + #G.consumeables.cards do\n    local _card = G.jokers.cards[i] or G.consumeables.cards[i - #G.jokers.cards]",["position"]="at",["payload"]="for _, area in ipairs(SMODS.get_card_areas('jokers')) do for _, _card in ipairs(area.cards) do",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="            --calculate the joker effects\n            local effects = eval_card(_card, {cardarea = G.jokers, full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, joker_main = true})\n\n            --Any Joker effects\n            if effects.jokers then\n                local extras = {mult = false, hand_chips = false}\n                if effects.jokers.mult_mod then mult = mod_mult(mult + effects.jokers.mult_mod);extras.mult = true end\n                if effects.jokers.chip_mod then hand_chips = mod_chips(hand_chips + effects.jokers.chip_mod);extras.hand_chips = true end\n                if effects.jokers.Xmult_mod then mult = mod_mult(mult*effects.jokers.Xmult_mod);extras.mult = true  end\n                update_hand_text({delay = 0}, {chips = extras.hand_chips and hand_chips, mult = extras.mult and mult})\n                card_eval_status_text(_card, 'jokers', nil, percent, nil, effects.jokers)\n                percent = percent+percent_delta\n            end",["position"]="at",["payload"]="-- Calculate context.joker_main\nlocal joker_eval, post = eval_card(_card, {cardarea = G.jokers, full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, joker_main = true})\nif next(joker_eval) then\n    if joker_eval.edition then joker_eval.edition = {} end\n    table.insert(effects, joker_eval)\n    for _, v in ipairs(post) do effects[#effects+1] = v end\n    if joker_eval.retriggers then\n        for rt = 1, #joker_eval.retriggers do\n            local rt_eval, rt_post = eval_card(_card, {cardarea = G.jokers, full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, joker_main = true, retrigger_joker = true})\n            if next(rt_eval) then\n                table.insert(effects, {retriggers = joker_eval.retriggers[rt]})\n                table.insert(effects, rt_eval)\n                for _, v in ipairs(rt_post) do effects[#effects+1] = v end\n            end\n        end\n    end\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="--Joker on Joker effects\nfor _, v in ipairs(G.jokers.cards) do\n    local effect = v:calculate_joker{full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, other_joker = _card}\n    if effect then\n        local extras = {mult = false, hand_chips = false}\n        if effect.mult_mod then mult = mod_mult(mult + effect.mult_mod);extras.mult = true end\n        if effect.chip_mod then hand_chips = mod_chips(hand_chips + effect.chip_mod);extras.hand_chips = true end\n        if effect.Xmult_mod then mult = mod_mult(mult*effect.Xmult_mod);extras.mult = true  end\n        if extras.mult or extras.hand_chips then update_hand_text({delay = 0}, {chips = extras.hand_chips and hand_chips, mult = extras.mult and mult}) end\n        if extras.mult or extras.hand_chips then card_eval_status_text(v, 'jokers', nil, percent, nil, effect) end\n        percent = percent+percent_delta\n    end\nend",["position"]="at",["payload"]="-- Calculate context.other_joker effects\nfor _, _area in ipairs(SMODS.get_card_areas('jokers')) do\n    for _, _joker in ipairs(_area.cards) do\n        local other_key = 'other_unknown'\n        if _card.ability.set == 'Joker' then other_key = 'other_joker' end\n        if _card.ability.consumeable then other_key = 'other_consumeable' end\n        if _card.ability.set == 'Voucher' then other_key = 'other_voucher' end\n        -- TARGET: add context.other_something identifier to your cards\n        local joker_eval,post = eval_card(_joker, {full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, [other_key] = _card, other_main = _card })\n        if next(joker_eval) then\n            if joker_eval.edition then joker_eval.edition = {} end\n            joker_eval.jokers.juice_card = _joker\n            table.insert(effects, joker_eval)\n            for _, v in ipairs(post) do effects[#effects+1] = v end\n            if joker_eval.retriggers then\n                for rt = 1, #joker_eval.retriggers do\n                    local rt_eval, rt_post = eval_card(_joker, {full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, [other_key] = _card, retrigger_joker = true})\n                    if next(rt_eval) then\n                        table.insert(effects, {retriggers = joker_eval.retriggers[rt]})\n                        table.insert(effects, rt_eval)\n                        for _, v in ipairs(rt_post) do effects[#effects+1] = v end\n                    end\n                end\n            end\n        end\n    end\nend\nfor _, _area in ipairs(SMODS.get_card_areas('individual')) do\n    local other_key = 'other_unknown'\n    if _card.ability.set == 'Joker' then other_key = 'other_joker' end\n    if _card.ability.consumeable then other_key = 'other_consumeable' end\n    if _card.ability.set == 'Voucher' then other_key = 'other_voucher' end\n    -- TARGET: add context.other_something identifier to your cards\n    local _eval,post = SMODS.eval_individual(_area, {full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, [other_key] = _card, other_main = _card })\n    if next(_eval) then\n        _eval.individual.juice_card = _area.scored_card\n        table.insert(effects, _eval)\n        for _, v in ipairs(post) do effects[#effects+1] = v end\n        if _eval.retriggers then\n            for rt = 1, #_eval.retriggers do\n                local rt_eval, rt_post = SMODS.eval_individual(_area, {full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, [other_key] = _card, retrigger_joker = true})\n                if next(rt_eval) then\n                    table.insert(effects, {_eval.retriggers[rt]})\n                    table.insert(effects, rt_eval)\n                    for _, v in ipairs(rt_post) do effects[#effects+1] = v end\n                end\n            end\n        end\n    end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for j = 1, #G.jokers.cards do\n    local eval = nil\n    eval = G.jokers.cards[j]:calculate_joker({discard = true, other_card =  G.hand.highlighted[i], full_hand = G.hand.highlighted})\n    if eval then\n        if eval.remove then removed = true end\n        card_eval_status_text(G.jokers.cards[j], 'jokers', nil, 1, nil, eval)\n    end\nend",["position"]="at",["payload"]="local effects = {}\nSMODS.calculate_context({discard = true, other_card =  G.hand.highlighted[i], full_hand = G.hand.highlighted, ignore_other_debuff = true}, effects)\nSMODS.trigger_effects(effects)\nfor _, eval in pairs(effects) do\n    if type(eval) == 'table' then\n        for key, eval2 in pairs(eval) do\n            if key == 'remove' or (type(eval2) == 'table' and eval2.remove) then removed = true end\n        end\n    end\nend",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for i=1, #G.jokers.cards do\n    --calculate the joker effects\n    local effects = eval_card(G.jokers.cards[i], {cardarea = G.jokers, full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, before = true})\n    if effects.jokers then\n        card_eval_status_text(G.jokers.cards[i], 'jokers', nil, percent, nil, effects.jokers)\n        percent = percent + percent_delta\n        if effects.jokers.level_up then\n            level_up_hand(G.jokers.cards[i], text)\n        end\n    end\nend",["position"]="at",["payload"]="-- context.before calculations\nif SMODS.last_hand then\n    for _, v in ipairs({'scoring_hand', 'full_hand'}) do\n        for _, _c in ipairs(SMODS.last_hand[v]) do\n            _c.ability['SMODS_'..v] = nil\n        end\n    end\nend\nSMODS.last_hand = {scoring_hand = scoring_hand, scoring_name = text, full_hand = G.play.cards}\nSMODS.calculate_context({full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, before = true})\n\n-- TARGET: effects before scoring starts\n\nSMODS.displayed_hand = nil",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="local nu_chip, nu_mult = G.GAME.selected_back:trigger_effect{context = 'final_scoring_step', chips = hand_chips, mult = mult}",["position"]="before",["payload"]="--- context.main_scoring for individual area calculations\nfor _, _area in ipairs(SMODS.get_card_areas('individual')) do\n    local effects = {}\n    -- Calculate context.main_scoring for individual areas\n    local _eval, post = SMODS.eval_individual(_area, { full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, main_scoring = true })\n    if next(_eval) then\n        table.insert(effects, _eval)\n        _eval.individual.juice_card = _area.scored_card\n        for _, v in ipairs(post) do effects[#effects + 1] = v end\n        if _eval.retriggers then\n            for rt = 1, #_eval.retriggers do\n                local rt_eval, rt_post = SMODS.eval_individual(_area, {full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, main_scoring = true, retrigger_joker = true})\n                if next(rt_eval) then\n                    table.insert(effects, {_eval.retriggers[rt]})\n                    table.insert(effects, rt_eval)\n                    for _, v in ipairs(rt_post) do effects[#effects+1] = v end\n                end\n            end\n        end\n    end\n\n    SMODS.trigger_effects(effects, _area.scored_card)\nend\n\n\n-- context.final_scoring_step calculations\nSMODS.calculate_context({full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, final_scoring_step = true})\n\n-- TARGET: effects before deck final_scoring_step\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for j = 1, #G.jokers.cards do\n    destroyed = G.jokers.cards[j]:calculate_joker({destroying_card = scoring_hand[i], full_hand = G.play.cards})\n    if destroyed then break end\nend\n\nif scoring_hand[i].ability.name == 'Glass Card' and not scoring_hand[i].debuff and pseudorandom('glass') < G.GAME.probabilities.normal/scoring_hand[i].ability.extra then\n    destroyed = true\nend",["position"]="at",["payload"]="-- context.destroying_card calculations\nfor j = 1, #G.jokers.cards do\n    local eval, post = eval_card(G.jokers.cards[j], {destroying_card = scoring_hand[i], full_hand = G.play.cards})\n    SMODS.trigger_effects({eval, post}, scoring_hand[i])\n    if eval.jokers then destroyed = true end\n\nend\n\nif SMODS.has_enhancement(scoring_hand[i], 'm_glass') and scoring_hand[i]:can_calculate() and SMODS.pseudorandom_probability(scoring_hand[i], 'glass', 1, scoring_hand[i].ability.name == 'Glass Card' and scoring_hand[i].ability.extra or G.P_CENTERS.m_glass.config.extra) then\n    destroyed = true\nend\n\nlocal eval, post = eval_card(scoring_hand[i], {destroying_card = scoring_hand[i], full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, cardarea = G.play})\nlocal self_destroy = false\nfor key, effect in pairs(eval) do\n    self_destroy = SMODS.calculate_effect(effect, scoring_hand[i])\nend\nSMODS.trigger_effects({post}, scoring_hand[i])\nif self_destroy then destroyed = true end\n\n-- TARGET: card destroyed when played\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="if destroyed_cards[1] then\n    for j=1, #G.jokers.cards do\n        eval_card(G.jokers.cards[j], {cardarea = G.jokers, remove_playing_cards = true, removed = destroyed_cards})\n    end\nend\n",["position"]="at",["payload"]="-- context.remove_playing_cards from discard\nif destroyed_cards[1] then\n    SMODS.calculate_context({remove_playing_cards = true, removed = destroyed_cards})\nend\n\n-- TARGET: effects after cards destroyed in discard",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for i=1, #G.jokers.cards do\n\n    --calculate the joker effects\n    local effects = eval_card(G.jokers.cards[i], {cardarea = G.jokers, full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, debuffed_hand = true})\n\n    --Any Joker effects\n    if effects.jokers then\n        card_eval_status_text(G.jokers.cards[i], 'jokers', nil, percent, nil, effects.jokers)\n        percent = percent+percent_delta\n    end\nend",["position"]="at",["payload"]="-- context.debuffed_hand calculations\nSMODS.calculate_context({full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, debuffed_hand = true})\n\n-- TARGET: effects after hand debuffed by blind",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for i=1, #G.jokers.cards do\n    --calculate the joker after hand played effects\n    local effects = eval_card(G.jokers.cards[i], {cardarea = G.jokers, full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, after = true})\n    if effects.jokers then\n        card_eval_status_text(G.jokers.cards[i], 'jokers', nil, percent, nil, effects.jokers)\n        percent = percent + percent_delta\n    end\nend",["position"]="at",["payload"]="-- context.after calculations\nSMODS.calculate_context({full_hand = G.play.cards, scoring_hand = scoring_hand, scoring_name = text, poker_hands = poker_hands, after = true})\n\n-- set `ability.played_this_ante` on played cards\nfor _,v in ipairs(G.play.cards) do\n    G.E_MANAGER:add_event(Event({\n        func = function()\n            v.ability.played_this_ante = true\n            return true\n        end,\n    }))\nend\n\n-- TARGET: effects after hand evaluation",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for i = 1, #G.jokers.cards do\n    local ret = G.jokers.cards[i]:calculate_dollar_bonus()\n    if ret then\n        add_round_eval_row({dollars = ret, bonus = true, name='joker'..i, pitch = pitch, card = G.jokers.cards[i]})\n        pitch = pitch + 0.06\n        dollars = dollars + ret\n    end\nend\n",["position"]="at",["payload"]="local i = 0\nfor _, area in ipairs(SMODS.get_card_areas('jokers')) do\n    for _, _card in ipairs(area.cards) do\n        local ret, ret_opts = _card:calculate_dollar_bonus()\n        ret_opts = ret_opts or {}\n\n        -- TARGET: calc_dollar_bonus per card\n        if ret then\n            if not ret_opts.no_eval_row then\n                i = i+1\n                add_round_eval_row({dollars = ret, bonus = true, name='joker'..i, pitch = pitch, card = _card, loc_opts = ret_opts})\n                pitch = pitch + 0.06\n            end\n            dollars = dollars + ret\n        end\n    end\nend\ni = 0\nfor _, target in ipairs(SMODS.get_card_areas('individual', 'calc_dollar_bonus')) do\n    if type(target.object.calc_dollar_bonus) == 'function' then\n        local ret, ret_opts = target.object:calc_dollar_bonus()\n        ret_opts = ret_opts or {}\n        local name\n        \n        -- TARGET: calc_dollar_bonus per individual object\n        if ret then\n            if not ret_opts.no_eval_row then\n                if ret_opts.text then\n                    name = text\n                elseif (ret_opts.set or target.set) and (ret_opts.key or target.key) then\n                    if ret_opts.set == \"Challenge\" or (not ret_opts.set and target.set == \"Challenge\") then\n                        name = localize(ret_opts.key or target.key, 'challenge_names')\n                    elseif (ret_opts.set == \"Mod\" or (not ret_opts.set and target.set == \"Mod\")) and not (G.localization.descriptions.Mod or {})[ret_opts.key or target.key] then\n                        name = (SMODS.Mods[ret_opts.key or target.key] or {}).name\n                    else\n                        name = localize{type = 'name_text', set = ret_opts.set or target.set, key = ret_opts.key or target.key}\n                    end\n                end\n                i = i+1\n                add_round_eval_row({dollars = ret, bonus = true, name='custom_individual'..i, pitch = pitch, text_colour = ret_opts.text_colour or G.C.FILTER, text = name or 'ERROR', text_scale = ret_opts.scale or 0.6})\n                pitch = pitch + 0.06\n            end\n            dollars = dollars + ret\n        end\n    end\nend\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="G.GAME.selected_back:trigger_effect({context = 'eval'})\n",["position"]="before",["payload"]="SMODS.calculate_context{round_eval = true}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="elseif string.find(config.name, 'joker') then\n",["position"]="before",["payload"]="elseif string.find(config.name, 'custom') then\n    if config.number then table.insert(left_text, {n=G.UIT.T, config={text = config.number, scale = config.number_scale or 0.8*scale, colour = config.number_colour or G.C.FILTER, shadow = true, juice = true}}) end\n    table.insert(left_text, {n=G.UIT.O, config={object = DynaText({string = {\"\"..config.text}, colours = {config.text_colour or G.C.UI.TEXT_LIGHT}, shadow = true, pop_in = 0, scale = config.text_scale or 0.4*scale, silent = true})}})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="table.insert(left_text, {n=G.UIT.O, config={object = DynaText({string = localize{type = 'name_text', set = config.card.config.center.set, key = config.card.config.center.key}, colours = {G.C.FILTER}, shadow = true, pop_in = 0, scale = 0.6*scale, silent = true})}})\n",["position"]="at",["payload"]="local loc_opts = config.loc_opts or {}\ntable.insert(left_text, {n=G.UIT.O, config={object = DynaText({string = loc_opts.text or localize{type = 'name_text', set = loc_opts.set or config.card.config.center.set, key = loc_opts.key or config.card.config.center.key}, colours = {loc_opts.text_colour or G.C.FILTER}, shadow = true, pop_in = 0, scale = (loc_opts.scale or 0.6)*scale, silent = true})}})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for i = 1, #G.jokers.cards do\n    local eval = nil\n    eval = G.jokers.cards[i]:calculate_joker({end_of_round = true, game_over = game_over})\n    if eval then\n        if eval.saved then\n            game_over = false\n        end\n        card_eval_status_text(G.jokers.cards[i], 'jokers', nil, nil, nil, eval)\n    end\n    G.jokers.cards[i]:calculate_rental()\n    G.jokers.cards[i]:calculate_perishable()\nend\n",["position"]="at",["payload"]="-- context.end_of_round calculations\nSMODS.saved = false\nG.GAME.saved_text = nil\nSMODS.last_hand = SMODS.last_hand or {scoring_hand = {}, full_hand = {}}\nSMODS.calculate_context({end_of_round = true, game_over = game_over, beat_boss = G.GAME.blind.boss, scoring_hand = SMODS.last_hand.scoring_hand, scoring_name = SMODS.last_hand.scoring_name, full_hand = SMODS.last_hand.full_hand })\nif SMODS.saved then game_over = false end\n-- TARGET: main end_of_round evaluation\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/button_callbacks.lua"},["pattern"]="G.GAME.round_resets.blind = e.config.ref_table",["position"]="before",["payload"]="local _tag = e.UIBox:get_UIE_by_ID('tag_container')\nG.GAME.round_resets.blind_tag = _tag and _tag.config and _tag.config.ref_table or nil\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for i = 1, #G.jokers.cards do\n    G.jokers.cards[i]:calculate_joker({setting_blind = true, blind = G.GAME.round_resets.blind})\nend\n",["position"]="at",["payload"]="SMODS.calculate_context({setting_blind = true, blind = G.GAME.round_resets.blind})\n\n-- TARGET: setting_blind effects\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for j = 1, #G.jokers.cards do\n    G.jokers.cards[j]:calculate_joker({pre_discard = true, full_hand = G.hand.highlighted, hook = hook})\nend\n",["position"]="at",["payload"]="SMODS.calculate_context({pre_discard = true, full_hand = G.hand.highlighted, hook = hook})\n\n-- TARGET: pre_discard\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="self:calculate_joker{selling_self = true}\n",["position"]="at",["payload"]="local eval, post = eval_card(self, {selling_self = true})\nlocal effects = {eval}\nfor _,v in ipairs(post) do effects[#effects+1] = v end\nif eval.retriggers then\n    for rt = 1, #eval.retriggers do\n        local rt_eval, rt_post = eval_card(self, { selling_self = true, retrigger_joker = true})\n        if next(rt_eval) then\n            table.insert(effects, {eval.retriggers[rt]})\n            table.insert(effects, rt_eval)\n            for _, v in ipairs(rt_post) do effects[#effects+1] = v end\n        end\n    end\nend\nSMODS.trigger_effects(effects, self)\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="            for i = 1, #G.jokers.cards do\n                G.jokers.cards[i]:calculate_joker({open_booster = true, card = self})\n            end\n",["position"]="at",["payload"]="SMODS.calculate_context({open_booster = true, card = self, booster = booster_obj})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"card.lua"},["pattern"]="        for i = 1, #G.jokers.cards do\n            G.jokers.cards[i]:calculate_joker({buying_card = true, card = self})\n        end\n",["position"]="at",["payload"]="SMODS.calculate_context({buying_card = true, card = self})\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"game.lua"},["pattern"]="if G.GAME.current_round.hands_played == 0 and\n    G.GAME.current_round.discards_used == 0 and G.GAME.facing_blind then\n    for i = 1, #G.jokers.cards do\n        G.jokers.cards[i]:calculate_joker({first_hand_drawn = true})\n    end\nend\n",["position"]="at",["payload"]="-- removed first hand drawn context\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"cardarea.lua"},["pattern"]="self:emplace(card, nil, stay_flipped)\nreturn true\n",["position"]="at",["payload"]="self:emplace(card, nil, stay_flipped)\nreturn card\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if to:draw_card_from(from, stay_flipped, discarded_only) then drawn = true end\n",["position"]="at",["payload"]="card = to:draw_card_from(from, stay_flipped, discarded_only)\nif card then drawn = true end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if sort then\n    to:sort()\nend\n",["position"]="after",["payload"]="SMODS.drawn_cards = SMODS.drawn_cards or {}\nif card and card.playing_card then SMODS.drawn_cards[#SMODS.drawn_cards+1] = card end\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for i=1, hand_space do --draw cards from deckL\n    if G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.SPECTRAL_PACK then\n        draw_card(G.deck,G.hand, i*100/hand_space,'up', true)\n    else\n        draw_card(G.deck,G.hand, i*100/hand_space,'up', true)\n    end\nend\n",["position"]="before",["payload"]="SMODS.cards_to_draw = (SMODS.cards_to_draw or 0) + hand_space\nSMODS.drawn_cards = {}\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="for i=1, hand_space do --draw cards from deckL\n    if G.STATE == G.STATES.TAROT_PACK or G.STATE == G.STATES.SPECTRAL_PACK then\n        draw_card(G.deck,G.hand, i*100/hand_space,'up', true)\n    else\n        draw_card(G.deck,G.hand, i*100/hand_space,'up', true)\n    end\nend\n",["position"]="after",["payload"]="G.E_MANAGER:add_event(Event({\n    trigger = 'immediate',\n    func = function()                \n        SMODS.cards_to_draw = SMODS.cards_to_draw - hand_space\n        return true\n    end\n}))\nG.E_MANAGER:add_event(Event({\n    trigger = 'immediate',\n    func = function()\n        if #SMODS.drawn_cards > 0 then\n            SMODS.calculate_context({first_hand_drawn = not G.GAME.current_round.any_hand_drawn and G.GAME.facing_blind,\n                                    hand_drawn = G.GAME.facing_blind and SMODS.drawn_cards,\n                                    other_drawn = not G.GAME.facing_blind and SMODS.drawn_cards})\n            SMODS.drawn_cards = {}\n            if G.GAME.facing_blind then G.GAME.current_round.any_hand_drawn = true end\n        end\n        return true\n    end\n}))\n",["indent"]=true},{["mod"]="Steamodded",["id"]="Steamodded",["k"]="pattern",["t"]={"functions/state_events.lua"},["pattern"]="draw_card(G.deck,G.hand, i*100/hand_space,'up', true)\n",["position"]="at",["payload"]="if cards_to_draw[i] and cards_to_draw[i].ability and cards_to_draw[i].ability.extra_slots_used then\n    SMODS.cards_to_draw = SMODS.cards_to_draw + cards_to_draw[i].ability.extra_slots_used\n    G.E_MANAGER:add_event(