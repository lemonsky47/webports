ur = G.C.ORANGE,\n\009\009\009\009\009\009\009scale = 0.3,\n\009\009\009\009\009\009\009minw = 4,\n\009\009\009\009\009\009\009maxw = 4,\n\009\009\009\009\009\009\009minh = 0.4,\n\009\009\009\009\009\009\009maxh = 0.4,\n\009\009\009\009\009\009\009ref_table = {\n\009\009\009\009\009\009\009\009key = key,\n\009\009\009\009\009\009\009},\n\009\009\009\009\009\009\009button = \"handy_apply_preset_key\",\n\009\009\009\009\009\009}),\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = { minw = 0.3 },\n\009\009\009\009},\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = { align = \"cm\" },\n\009\009\009\009\009nodes = desc_lines,\n\009\009\009\009},\n\009\009\009},\n\009\009}\n\009end,\n\009create_user_preset = function(index)\n\009\009local preset = Handy.presets.current.user[index]\n\009\009local name_object = {\n\009\009\009name = preset.name,\n\009\009}\n\n\009\009return {\n\009\009\009n = G.UIT.R,\n\009\009\009config = { align = \"cm\" },\n\009\009\009nodes = {\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = {},\n\009\009\009\009\009nodes = {\n\009\009\009\009\009\009create_toggle({\n\009\009\009\009\009\009\009callback = function(b)\n\009\009\009\009\009\009\009\009return G.FUNCS.handy_toggle_preset_enabled(b, index)\n\009\009\009\009\009\009\009end,\n\009\009\009\009\009\009\009label_scale = 0.4,\n\009\009\009\009\009\009\009label = \"\",\n\009\009\009\009\009\009\009ref_table = preset,\n\009\009\009\009\009\009\009ref_value = \"enabled\",\n\009\009\009\009\009\009\009w = 0,\n\009\009\009\009\009\009\009focus_args = { nav = \"wide\" },\n\009\009\009\009\009\009}),\n\009\009\009\009\009},\n\009\009\009\009},\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = { align = \"cm\", minw = 0.15 },\n\009\009\009\009},\n\009\009\009\009{\n\009\009\009\009\009n = G.UIT.C,\n\009\009\009\009\009config = { 