h_handy_notif_insta_remove = \"çž¬é—´ ç§»é™¤\",\n\009\009\009ph_handy_notif_insta_sell = \"çž¬é—´å‡ºå”®\",\n\009\009\009ph_handy_notif_remove_all = \"ç§»é™¤åŒºåŸŸå†… å…¨éƒ¨ å¡ç‰Œ/æ ‡ç­¾\",\n\009\009\009ph_handy_notif_sell_all = \"å‡ºå”®åŒºåŸŸå†… å…¨éƒ¨ å¡ç‰Œ\",\n\009\009\009ph_handy_notif_remove_all_same = \"ç§»é™¤ç‚¹å‡»å¡ç‰Œ/æ ‡ç­¾çš„ æ‰€æœ‰å‰¯æœ¬\",\n\009\009\009ph_handy_notif_sell_all_same = \"å‡ºå”®ç‚¹å‡»å¡ç‰Œçš„ æ‰€æœ‰å‰¯æœ¬\",\n\009\009\009ph_handy_notif_nopeus_unsafe_disabled = \"æ¨¡ç»„è®¾ç½®ä¸­å·²å…³é—­ä¸å®‰å…¨é€‰é¡¹\",\n\009\009\009ph_handy_notif_animation_skip_unsafe_disabled = \"æ¨¡ç»„è®¾ç½®ä¸­å·²å…³é—­ä¸å®‰å…¨é€‰é¡¹\",\n\009\009\009ph_handy_notif_cannot_bind_non_holdable = \"æ­¤å¤„æ— æ³•ç»‘å®šæ»šè½®\",\n\009\009\009ph_handy_notif_cannot_bind_non_safe = \"æ­¤å¤„æ— æ³•ç»‘å®šè¯¥æŒ‰é”®\",\n\n\009\009\009ph_handy_notif_misc_save_run_start = \"å¼€å§‹ä¿å­˜å¯¹å±€â€¦\",\n\009\009\009ph_handy_notif_misc_save_run_saving = \"æ­£åœ¨ä¿å­˜å¯¹å±€â€¦\",\n\009\009\009ph_handy_notif_misc_save_run_saved = \"å¯¹å±€å·²ä¿å­˜\",\n\009\009\009ph_handy_notif_misc_save_run_interrupt = \"å½“å‰æ— æ³•ä¿å­˜å¯¹å±€\",\n\n\009\009\009handy_animation_skip_levels = {\n\009\009\009\009[1] = \"æ— \",\n\009\009\009\009[2] = \"æ¶ˆæ¯\",\n\009\009\009\009[3] = \"åŠ¨ç”»\",\n\009\009\009\009[4] = \"æ‰€æœ‰\",\n\009\009\009\009[5] = \"ä¸å®‰å…¨\",\n\009\009\009},\n\n\009\009\009b_handy_info_popups_level_select = \"ä¿¡æ¯å¼¹çª—çº§åˆ«\",\n\009\009\009handy_info_popups_level_opt = {\n\009\009\009\009[1] = \"æ— \",\n\009\009\009\009[2] = \"ä»…å±é™©\",\n\009\009\009\009[3] = \"åŠŸèƒ½ç›¸å…³\",\n\009\009\009\009[4] = \"å…¨éƒ¨\",\n\009\009\009},\n\n\009\009\009b_handy_keybinds_trigger_mode_select = \"å¿«æ·é”®è§¦å‘æ¨¡å¼\",\n\009\009\009handy_keybinds_trigger_mode_opt = {\n\009\009\009\009[1] = \"æŒ‰ä¸‹è§¦å‘\",\n\009\009\009\009[2] = \"æ¾å¼€è§¦å‘\",\n\009\009\009},\n\n\009\009\009b_handy_buy_sell_use_mode_select = \"ä¹°/å–/ç”¨æ¨¡å¼\",\n\009\009\009handy_buy_sell_use_mode_opt = {\n\009\009\009\009[1] = \"é•¿æŒ‰+ç‚¹å‡»å¡ç‰Œ\",\n\009\009\009\009[2] = \"æ‚¬åœå¡ç‰Œ+æŒ‰é”®\",\n\009\009\009},\n\n\009\009\009b_handy_device_select = \"è¾“å…¥è®¾å¤‡\",\n\009\009\009handy_device_opt = {\n\009\009\009\009[1] = \"è‡ªåŠ¨\",\n\009\009\009\009[2] = \"é¼ æ ‡+é”®ç›˜\",\n\009\009\009\009[3] = \"æ‰‹æŸ„\",\n\009\009\009},\n\009\009},\n\009},\n}\n",["display"]="loc_txt/zh_CN.lua",["before"]="main.lua"},{["mod"]="Cartomancer",["id"]="Cartomancer",["name"]="cartomancer.nfs",["source"]="--[[\nCopyright 2020 megagrump@pm.me\n\nPermission is hereby granted, free of charge, to any person obtaining a copy of\nthis software and associated documentation files (the \"Software\"), to deal in\nthe Software without restriction, including without limitation the rights to\nuse, copy, modify, merge, publish, distribute, sublicense, and/or sell copies\nof the Software, and to permit persons to whom the Software is furnished to do\nso, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n]]--\n\nlocal ffi, bit = require('ffi'), require('bit')\nlocal C = ffi.C\n\nlocal fopen, getcwd, chdir, unlink, mkdir, rmdir\nlocal BUFFERMODE, MODEMAP\nlocal ByteArray = ffi.typeof('unsigned char[?]')\nlocal function _ptr(p) return p ~= nil and p or nil end -- NULL pointer to nil\n\nlocal File = {\n\009getBuffer = function(self) return self._bufferMode, self._bufferSize end,\n\009getFilename = function(self) return self._name end,\n\009getMode = function(self) return self._mode end,\n\009isOpen = function(self) return self._mode ~= 'c' and self._handle ~= nil end,\n}\n\nfunction File:open(mode)\n\009if self._mode ~= 'c' then return false, \"File \" .. self._name .. \" is already open\" end\n\009if not MODEMAP[mode] then return false, \"Invalid open mode for \" .. self._name .. \": \" .. mode end\n\n\009local handle = _ptr(fopen(self._name, MODEMAP[mode]))\n\009if not handle then return false, \"Could not open \" .. self._name .. \" in mode \" .. mode end\n\n\009self._handle, self._mode = ffi.gc(handle, C.fclose), mode\n\009self:setBuffer(self._bufferMode, self._bufferSize)\n\n\009return true\nend\n\nfunction File:close()\n\009if self._mode == 'c' then return false, \"File is not open\" end\n\009C.fclose(ffi.gc(self._handle, nil))\n\009self._handle, self._mode = nil, 'c'\n\009return true\nend\n\nfunction File:setBuffer(mode, size)\n\009local bufferMode = BUFFERMODE[mode]\n\009if not bufferMode then\n\009\009return false, \"Invalid buffer mode \" .. mode .. \" (expected 'none', 'full', or 'line')\"\n\009end\n\n\009if mode == 'none' then\n\009\009size = math.max(0, size or 0)\n\009else\n\009\009size = math.max(2, size or 2) -- Windows requires buffer to be at least 2 bytes\n\009end\n\n\009local success = self._mode == 'c' or C.setvbuf(self._handle, nil, bufferMode, size) == 0\n\009if not success then\n\009\009self._bufferMode, self._bufferSize = 'none', 0\n\009\009return false, \"Could not set buffer mode\"\n\009end\n\n\009self._bufferMode, self._bufferSize = mode, size\n\009return true\nend\n\nfunction File:getSize()\n\009-- NOTE: The correct way to do this would be a stat() call, which requires a\n\009-- lot more (system-specific) code. This is a shortcut that requires the file\n\009-- to be readable.\n\009local mustOpen = not self:isOpen()\n\009if mustOpen and not self:open('r') then return 0 end\n\n\009local pos = mustOpen and 0 or self:tell()\n\009C.fseek(self._handle, 0, 2)\n\009local size = self:tell()\n\009if mustOpen then\n\009\009self:close()\n\009else\n\009\009self:seek(pos)\n\009end\n\009return size\nend\n\nfunction File:read(containerOrBytes, bytes)\n\009if self._mode ~= 'r' then return nil, 0 end\n\n\009local container = bytes ~= nil and containerOrBytes or 'string'\n\009if container ~= 'string' and container ~= 'data' then\n\009\009error(\"Invalid container type: \" .. container)\n\009end\n\n\009bytes = not bytes and containerOrBytes or 'all'\n\009bytes = bytes == 'all' and self:getSize() - self:tell() or math.min(self:getSize() - self:tell(), bytes)\n\n\009if bytes <= 0 then\n\009\009local data = container == 'string' and '' or love.data.newFileData('', self._name)\n\009\009return data, 0\n\009end\n\n\009local data = love.data.newByteData(bytes)\n\009local r = tonumber(C.fread(data:getFFIPointer(), 1, bytes, self._handle))\n\n\009if container == 'data' then\n\009\009-- FileData from ByteData requires LÃ–VE 11.4+\n\009\009local ok, fd = pcall(love.filesystem.newFileData, data, self._name)\n\009\009if ok then return fd, r end\n\009end\n\n\009local str = data:getString()\n\009data:release()\n\009data = container == 'data' and love.filesystem.newFileData(str, self._name) or str\n\009return data, r\nend\n\nlocal function lines(file, autoclose)\n\009local BUFFERSIZE = 4096\n\009local buffer, bufferPos = ByteArray(BUFFERSIZE), 0\n\009local bytesRead = tonumber(C.fread(buffer, 1, BUFFERSIZE, file._handle))\n\n\009local offset = file:tell()\n\009return function()\n\009\009file:seek(offset)\n\n\009\009local line = {}\n\009\009while bytesRead > 0 do\n\009\009\009for i = bufferPos, bytesRead - 1 do\n\009\009\009\009if buffer[i] == 10 then -- end of line\n\009\009\009\009\009bufferPos = i + 1\n\009\009\009\009\009return table.concat(line)\n\009\009\009\009end\n\n\009\009\009\009if buffer[i] ~= 13 then -- ignore CR\n\009\009\009\009\009table.insert(line, string.char(buffer[i]))\n\009\009\009\009end\n\009\009\009end\n\n\009\009\009bytesRead = tonumber(C.fread(buffer, 1, BUFFERSIZE, file._handle))\n\009\009\009offset, bufferPos = offset + bytesRead, 0\n\009\009end\n\n\009\009if not line[1] then\n\009\009\009if autoclose then file:close() end\n\009\009\009return nil\n\009\009end\n\009\009return table.concat(line)\n\009end\nend\n\nfunction File:lines()\n\009if self._mode ~= 'r' then error(\"File is not opened for reading\") end\n\009return lines(self)\nend\n\nfunction File:write(data, size)\n\009if self._mode ~= 'w' and self._mode ~= 'a' then\n\009\009return false, \"File \" .. self._name .. \" not opened for writing\"\n\009end\n\n\009local toWrite, writeSize\n\009if type(data) == 'string' then\n\009\009writeSize = (size == nil or size == 'all') and #data or size\n\009\009toWrite = data\n\009else\n\009\009writeSize = (size == nil or size == 'all') and data:getSize() or size\n\009\009toWrite = data:getFFIPointer()\n\009end\n\n\009if tonumber(C.fwrite(toWrite, 1, writeSize, self._handle)) ~= writeSize then\n\009\009return false, \"Could not write data\"\n\009end\n\009return true\nend\n\nfunction File:seek(pos)\n\009return self._handle and C.fseek(self._handle, pos, 0) == 0\nend\n\nfunction File:tell()\n\009if not self._handle then return nil, \"Invalid position\" end\n\009return tonumber(C.ftell(self._handle))\nend\n\nfunction File:flush()\n\009if self._mode ~= 'w' and self._mode ~= 'a' then\n\009\009return nil, \"File is not opened for writing\"\n\009end\n\009return C.fflush(self._handle) == 0\nend\n\nfunction File:isEOF()\n\009return not self:isOpen() or C.feof(self._handle) ~= 0 or self:tell() == self:getSize()\nend\n\nfunction File:release()\n\009if self._mode ~= 'c' then self:close() end\n\009self._handle = nil\nend\n\nfunction File:type() return 'File' end\n\nfunction File:typeOf(t) return t == 'File' end\n\nFile.__index = File\n\n-----------------------------------------------------------------------------\n\nlocal nativefs = {}\nlocal loveC = ffi.os == 'Windows' and ffi.load('love') or C\n\nfunction nativefs.newFile(name)\n\009if type(name) ~= 'string' then\n\009\009error(\"bad argument #1 to 'newFile' (string expected, got \" .. type(name) .. \")\")\n\009end\n\009return setmetatable({\n\009\009_name = name,\n\009\009_mode = 'c',\n\009\009_handle = nil,\n\009\009_bufferSize = 0,\n\009\009_bufferMode = 'none'\n\009}, File)\nend\n\nfunction nativefs.newFileData(filepath)\n\009local f = nativefs.newFile(filepath)\n\009local ok, err = f:open('r')\n\009if not ok then return nil, err end\n\n\009local data, err = f:read('data', 'all')\n\009f:close()\n\009return data, err\nend\n\nfunction nativefs.mount(archive, mountPoint, appendToPath)\n\009return loveC.PHYSFS_mount(archive, mountPoint, appendToPath and 1 or 0) ~= 0\nend\n\nfunction nativefs.unmount(archive)\n\009return loveC.PHYSFS_unmount(archive) ~= 0\nend\n\nfunction nativefs.fileExists(name)\n\009local file = nativefs.newFile(name)\n\009local ok = file:open('r')\n\009if not ok then return false end\n\n\009file:close()\n\009return true\nend\n\nfunction nativefs.read(containerOrName, nameOrSize, sizeOrNil)\n\009local container, name, size\n\009if sizeOrNil then\n\009\009container, name, size = containerOrName, nameOrSize, sizeOrNil\n\009elseif not nameOrSize then\n\009\009container, name, size = 'string', containerOrName, 'all'\n\009else\n\009\009if type(nameOrSize) == 'number' or nameOrSize == 'all' then\n\009\009\009container, name, size = 'string', containerOrName, nameOrSize\n\009\009else\n\009\009\009container, name, size = containerOrName, nameOrSize, 'all'\n\009\009end\n\009end\n\n\009local file = nativefs.newFile(name)\n\009local ok, err = file:open('r')\n\009if not ok then return nil, err end\n\n\009local data, size = file:read(container, size)\n\009file:close()\n\009return data, size\nend\n\nlocal function writeFile(mode, name, data, size)\n\009local file = nativefs.newFile(name)\n\009local ok, err = file:open(mode)\n\009if not ok then return nil, err end\n\n\009ok, err = file:write(data, size or 'all')\n\009file:close()\n\009return ok, err\nend\n\nfunction nativefs.write(name, data, size)\n\009return writeFile('w', name, data, size)\nend\n\nfunction nativefs.append(name, data, size)\n\009return writeFile('a', name, data, size)\nend\n\nfunction nativefs.lines(name)\n\009local f = nativefs.newFile(name)\n\009local ok, err = f:open('r')\n\009if not ok then return nil, err end\n\009return lines(f, true)\nend\n\nfunction nativefs.load(name)\n\009local chunk, err = nativefs.read(name)\n\009if not chunk then return nil, err end\n\009return loadstring(chunk, name)\nend\n\nfunction nativefs.getWorkingDirectory()\n\009return getcwd()\nend\n\nfunction nativefs.setWorkingDirectory(path)\n\009if not chdir(path) then return false, \"Could not set working directory\" end\n\009return true\nend\n\nfunction nativefs.getDriveList()\n\009if ffi.os ~= 'Windows' then return { '/' } end\n\009local drives, bits = {}, C.GetLogicalDrives()\n\009for i = 0, 25 do\n\009\009if bit.band(bits, 2 ^ i) > 0 then\n\009\009\009table.insert(drives, string.char(65 + i) .. ':/')\n\009\009end\n\009end\n\009return drives\nend\n\nfunction nativefs.createDirectory(path)\n\009local current = path:sub(1, 1) == '/' and '/' or ''\n\009for dir in path:gmatch('[^/\\\\]+') do\n\009\009current = current .. dir .. '/'\n\009\009local info = nativefs.getInfo(current, 'directory')\n\009\009if not info and not mkdir(current) then return false, \"Could not create directory \" .. current end\n\009end\n\009return true\nend\n\nfunction nativefs.remove(name)\n\009local info = nativefs.getInfo(name)\n\009if not info then return false, \"Could not remove \" .. name end\n\009if info.type == 'directory' then\n\009\009if not rmdir(name) then return false, \"Could not remove directory \" .. name end\n\009\009return true\n\009end\n\009if not unlink(name) then return false, \"Could not remove file \" .. name end\n\009return true\nend\n\nlocal function withTempMount(dir, fn, ...)\n\009local mountPoint = _ptr(loveC.PHYSFS_getMountPoint(dir))\n\009if mountPoint then return fn(ffi.string(mountPoint), ...) end\n\009if not nativefs.mount(dir, '__nativefs__temp__') then return false, \"Could not mount \" .. dir end\n\009local a, b = fn('__nativefs__temp__', ...)\n\009nativefs.unmount(dir)\n\009return a, b\nend\n\nfunction nativefs.getDirectoryItems(dir)\n\009local result, err = withTempMount(dir, love.filesystem.getDirectoryItems)\n\009return result or {}\nend\n\nlocal function getDirectoryItemsInfo(path, filtertype)\n\009local items = {}\n\009local files = love.filesystem.getDirectoryItems(path)\n\009for i = 1, #files do\n\009\009local filepath = string.format('%s/%s', path, files[i])\n\009\009local info = love.filesystem.getInfo(filepath, filtertype)\n\009\009if info then\n\009\009\009info.name = files[i]\n\009\009\009table.insert(items, info)\n\009\009end\n\009end\n\009return items\nend\n\nfunction nativefs.getDirectoryItemsInfo(path, filtertype)\n\009local result, err = withTempMount(path, getDirectoryItemsInfo, filtertype)\n\009return result or {}\nend\n\nlocal function getInfo(path, file, filtertype)\n\009local filepath = string.format('%s/%s', path, file)\n\009return love.filesystem.getInfo(filepath, filtertype)\nend\n\nlocal function leaf(p)\n\009p = p:gsub('\\\\', '/')\n\009local last, a = p, 1\n\009while a do\n\009\009a = p:find('/', a + 1)\n\009\009if a then\n\009\009\009last = p:sub(a + 1)\n\009\009end\n\009end\n\009return last\nend\n\nfunction nativefs.getInfo(path, filtertype)\n\009local dir = path:match(\"(.*[\\\\/]).*$\") or './'\n\009local file = leaf(path)\n\009local result, err = withTempMount(dir, getInfo, file, filtertype)\n\009return result or nil\nend\n\n-----------------------------------------------------------------------------\n\nMODEMAP = { r = 'rb', w = 'wb', a = 'ab' }\nlocal MAX_PATH = 4096\n\nffi.cdef([[\n\009int PHYSFS_mount(const char* dir, const char* mountPoint, int appendToPath);\n\009int PHYSFS_unmount(const char* dir);\n\009const char* PHYSFS_getMountPoint(const char* dir);\n\n\009typedef struct FILE FILE;\n\n\009FILE* fopen(const char* path, const char* mode);\n\009size_t fread(void* ptr, size_t size, size_t nmemb, FILE* stream);\n\009size_t fwrite(const void* ptr, size_t size, size_t nmemb, FILE* stream);\n\009int fclose(FILE* stream);\n\009int fflush(FILE* stream);\n\009size_t fseek(FILE* stream, size_t offset, int whence);\n\009size_t ftell(FILE* stream);\n\009int setvbuf(FILE* stream, char* buffer, int mode, size_t size);\n\009int feof(FILE* stream);\n]])\n\nif ffi.os == 'Windows' then\n\009ffi.cdef([[\n\009\009int MultiByteToWideChar(unsigned int cp, uint32_t flags, const char* mb, int cmb, const wchar_t* wc, int cwc);\n\009\009int WideCharToMultiByte(unsigned int cp, uint32_t flags, const wchar_t* wc, int cwc, const char* mb,\n\009\009                        int cmb, const char* def, int* used);\n\009\009int GetLogicalDrives(void);\n\009\009int CreateDirectoryW(const wchar_t* path, void*);\n\009\009int _wchdir(const wchar_t* path);\n\009\009wchar_t* _wgetcwd(wchar_t* buffer, int maxlen);\n\009\009FILE* _wfopen(const wchar_t* path, const wchar_t* mode);\n\009\009int _wunlink(const wchar_t* path);\n\009\009int _wrmdir(const wchar_t* path);\n\009]])\n\n\009BUFFERMODE = { full = 0, line = 64, none = 4 }\n\n\009local function towidestring(str)\n\009\009local size = C.MultiByteToWideChar(65001, 0, str, #str, nil, 0)\n\009\009local buf = ffi.new('wchar_t[?]', size + 1)\n\009\009C.MultiByteToWideChar(65001, 0, str, #str, buf, size)\n\009\009return buf\n\009end\n\n\009local function toutf8string(wstr)\n\009\009local size = C.WideCharToMultiByte(65001, 0, wstr, -1, nil, 0, nil, nil)\n\009\009local buf = ffi.new('char[?]', size + 1)\n\009\009C.WideCharToMultiByte(65001, 0, wstr, -1, buf, size, nil, nil)\n\009\009return ffi.string(buf)\n\009end\n\n\009local nameBuffer = ffi.new('wchar_t[?]', MAX_PATH + 1)\n\n\009fopen = function(path, mode) return C._wfopen(towidestring(path), towidestring(mode)) end\n\009getcwd = function() return toutf8string(C._wgetcwd(nameBuffer, MAX_PATH)) end\n\009chdir = function(path) return C._wchdir(towidestring(path)) == 0 end\n\009unlink = function(path) return C._wunlink(towidestring(path)) == 0 end\n\009mkdir = function(path) return C.CreateDirectoryW(towidestring(path), nil) ~= 0 end\n\009rmdir = function(path) return C._wrmdir(towidestring(path)) == 0 end\nelse\n\009BUFFERMODE = { full = 0, line = 1, none = 2 }\n\n\009ffi.cdef([[\n\009\009char* getcwd(char *buffer, int maxlen);\n\009\009int chdir(const char* path);\n\009\009int unlink(const char* path);\n\009\009int mkdir(const char* path, int mode);\n\009\009int rmdir(const char* path);\n\009]])\n\n\009local nameBuffer = ByteArray(MAX_PATH)\n\n\009fopen = C.fopen\n\009unlink = function(path) return ffi.C.unlink(path) == 0 end\n\009chdir = function(path) return ffi.C.chdir(path) == 0 end\n\009mkdir = function(path) return ffi.C.mkdir(path, 0x1ed) == 0 end\n\009rmdir = function(path) return ffi.C.rmdir(path) == 0 end\n\n\009getcwd = function()\n\009\009local cwd = _ptr(C.getcwd(nameBuffer, MAX_PATH))\n\009\009return cwd and ffi.string(cwd) or nil\n\009end\nend\n\nreturn nativefs",["display"]="libs/nativefs.lua",["before"]="main.lua"},{["mod"]="Cartomancer",["id"]="Cartomancer",["name"]="cartomancer.init",["source"]="Cartomancer = {}\n\nCartomancer.SETTINGS = {}\n\nCartomancer.nfs = require \"cartomancer.nfs\"\nlocal lovely = require \"lovely\"\n\nCartomancer.INTERNAL_debugging = not not love.filesystem.getInfo('cartomancer_debugging')\n\nCartomancer.use_smods = function ()\n    return SMODS and not (MODDED_VERSION == \"0.9.8-STEAMODDED\")\nend\n\n\nCartomancer.find_self = function (target_filename)\n    local mods_path = lovely.mod_dir\n\n\009local mod_folders = Cartomancer.nfs.getDirectoryItems(mods_path)\n    for _, folder in pairs(mod_folders) do\n        local path = string.format('%s/%s', mods_path, folder)\n        local files = Cartomancer.nfs.getDirectoryItems(path)\n\n        for _, filename in pairs(files) do\n            if filename == target_filename then\n                return path\n            end\n        end\n    end\nend\n\nCartomancer.load_mod_file = function (path, name, as_txt)\n    name = name or path\n\n    local file, err = Cartomancer.nfs.read(Cartomancer.path..'/'..path)\n\n    assert(file, string.format([=[[Cartomancer] Failed to load mod file %s (%s).:\n%s\n\nGet latest release here: https://github.com/stupxd/Cartomancer/releases ]=], path, name, tostring(err)))\n\n    return as_txt and file or load(file, string.format(\" Cartomancer - %s \", name))()\nend\n\nCartomancer.log = function (msg)\n    if Cartomancer.INTERNAL_debugging then\n        local msg = type(msg) == \"string\" and msg or Cartomancer.dump(msg)\n\n        print(\"[Cartomancer] \"..msg)\n    end\nend\n\nCartomancer.dump = function (o, level, prefix)\n    level = level or 1\n    prefix = prefix or '  '\n    if type(o) == 'table' and level <= 5 then\n        local s = '{ \\n'\n        for k, v in pairs(o) do\n            local format\n            if type(k) == 'number' then\n                format = '%s[%d] = %s,\\n'\n            else\n                format = '%s[\"%s\"] = %s,\\n'\n            end\n            s = s .. string.format(\n                    format,\n                    prefix,\n                    k,\n                    -- Compact parent & draw_major to avoid recursion and huge dumps.\n                    (k == 'parent' or k == 'draw_major') and string.format(\"'%s'\", tostring(v)) or Cartomancer.dump(v, level + 1, prefix..'  ')\n            )\n        end\n        return s..prefix:sub(3)..'}'\n    else\n        if type(o) == \"string\" then\n            return string.format('\"%s\"', o)\n        end\n\n        if type(o) == \"function\" or type(o) == \"table\" then\n            return string.format(\"'%s'\", tostring(o))\n        end\n\n        return tostring(o)\n    end\nend\n\nCartomancer.table_join_keys = function (tab_, separator)\n    local separator = separator or \"\" \n    local inline\n    for k, _ in pairs(tab_) do\n        inline = (inline and inline..separator or \"\") .. k\n    end\n\n    return inline or \"[empty]\"\nend\n\nCartomancer.empty_table = {}\n\nCartomancer.remove_empty_tables = function (list)\n    local result = {}\n    for _, v in ipairs(list) do\n        if v ~= Cartomancer.empty_table then\n            result[#result+1] = v\n        end\n    end\n\n    return result\nend\n\nCartomancer.do_nothing = function (...) end\n\nCartomancer.align_object = function (o)\n    o:align_to_major()\n    local x = (o.T.x)\n    local y = (o.T.y)\n    local w = (o.T.w)\n    local h = (o.T.h)\n    Moveable.hard_set_T(o,x, y, w, h)\n    o:hard_set_T(x, y, w, h)\nend\n\nfunction Cartomancer.basen(n,b)\n    n = math.floor(n)\n    if not b or b == 10 then return tostring(n) end\n    local digits = \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n    local t = {}\n    local sign = \"\"\n    if n < 0 then\n        sign = \"-\"\n    n = -n\n    end\n    repeat\n        local d = (n % b) + 1\n        n = math.floor(n / b)\n        table.insert(t, 1, digits:sub(d,d))\n    until n == 0\n    return sign .. table.concat(t,\"\")\nend\n\nlocal function is_valid_hex(letter)\n    local byte_val = string.byte(string.upper(letter))\n    -- Between A-F or 0-9\n    return byte_val >= 65 and byte_val <= 70 or byte_val >= 48 and byte_val <= 57\nend\n\nfunction Cartomancer.hex_to_color(hex)\n    -- Make sure string length is always 8\n    while #hex < 8 do\n        hex = hex..\"F\"\n    end\n    hex = string.sub(hex, 1, 8)\n    -- Make sure string only contains \n    for i = 1, #hex do\n        if not is_valid_hex(hex:sub(i,i)) then\n            -- insane way to replace char at given index \n            hex = (\"%sF%s\"):format(hex:sub(1,i-1), hex:sub(i+1))\n        end\n    end\n    local _,_,r,g,b,a = hex:find('(%x%x)(%x%x)(%x%x)(%x%x)')\n    local color = {tonumber(r,16)/255,tonumber(g,16)/255,tonumber(b,16)/255,tonumber(a,16)/255 or 255}\n\n    return color\nend\n\nfunction Cartomancer.color_to_hex(color)\n    local hex = \"\"\n    for i = 1, 3 do\n        local base_16 = Cartomancer.basen(color[i] * 255, 16)\n        -- Numbers below 16 need 0 in front\n        if #base_16 == 1 then\n            base_16 = \"0\"..base_16\n        end\n        -- How would we ever get numbers above 255 :3c\n        base_16 = base_16:sub(#base_16 - 1, #base_16)\n\n        hex = hex .. base_16\n    end\n\n    return hex\nend\n\nreturn Cartomancer",["display"]="internal/init.lua",["before"]="main.lua"}}}
-- Web port of Lovely's patcher. Patches are applied at load time (JIT) so mods can be disabled
-- (Mods/lovely/blacklist.txt entries are mod FOLDER names, exactly like real Lovely;
--  a ".lovelyignore" file inside a mod folder also disables it).
-- Data comes from lovely_patches.lua, generated by build_modded.py.
local M = {
    version = "0.9.0-web", mod_dir = "Mods", patches_by_target = {}, loaded = false,
    blacklist = {}, disabled = {}, verbose = false, use_cache = true,
    skip_modules = { ["SMODS.preflight.core"] = true }, -- the web bootstrap replaces Steamodded's preflight
}

local sfind, ssub, sbyte, sgsub, sformat = string.find, string.sub, string.byte, string.gsub, string.format
local tconcat = table.concat
local lua_vars = {}
local Regex = nil
local data = nil
local by_target = {}
local enabled_vars = {}
local cache_dir = nil

local function log(msg) print("[Lovely Web] " .. msg) end

---------------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------------
local function is_space(b) return b == 32 or (b and b >= 9 and b <= 13) end

local function trim(s)
    local a = sfind(s, "%S")
    if not a then return "" end
    local b = #s
    while is_space(sbyte(s, b)) do b = b - 1 end
    if a == 1 and b == #s then return s end
    return ssub(s, a, b)
end

-- like Rust's split_inclusive('\n')
local function split_inclusive(s)
    local out, n, pos, len = {}, 0, 1, #s
    while pos <= len do
        local nl = sfind(s, "\n", pos, true)
        n = n + 1
        if nl then out[n] = ssub(s, pos, nl); pos = nl + 1
        else out[n] = ssub(s, pos); break end
    end
    return out
end

-- like Rust's str::lines() (no terminators, trailing empty line dropped)
local function rust_lines(s)
    local out, n, pos, len = {}, 0, 1, #s
    while pos <= len do
        local nl = sfind(s, "\n", pos, true)
        n = n + 1
        local line
        if nl then line = ssub(s, pos, nl - 1); pos = nl + 1 else line = ssub(s, pos); pos = len + 1 end
        if ssub(line, -1) == "\r" then line = ssub(line, 1, -2) end
        out[n] = line
    end
    return out
end

local function djb2(s)
    local h = 5381
    for i = 1, #s do h = (h * 33 + sbyte(s, i)) % 4294967296 end
    return sformat("%08x", h)
end

---------------------------------------------------------------------------
-- init: data, blacklist, enabled set, module patches
---------------------------------------------------------------------------
local function read_file(path)
    if love.filesystem.getInfo(path) then return love.filesystem.read(path) end
end

local function load_regex_module()
    if Regex then return Regex end
    local src = read_file("SMODS/lovely_regex.lua")
    if not src then error("SMODS/lovely_regex.lua is missing") end
    local fn, err = loadstring(src, "=lovely_regex")
    if not fn then error(err) end
    Regex = fn()
    return Regex
end

local function compute_cache_dir()
    local names = {}
    for name in pairs(M.disabled) do names[#names + 1] = name end
    table.sort(names)
    local wc = package.loaded["SMODS.web_compare"]
    local sig = tostring(data.build or "?") .. "|" .. tconcat(names, ",") .. "|cmp" .. ((wc and wc.enabled) and "1" or "0") .. "v" .. tostring(wc and wc.version or 0)
    return "lovely_cache/" .. djb2(sig) .. djb2(sig .. "#2")
end

local function remove_tree(path)
    local info = love.filesystem.getInfo(path)
    if not info then return end
    if info.type == "directory" then
        for _, name in ipairs(love.filesystem.getDirectoryItems(path)) do remove_tree(path .. "/" .. name) end
    end
    love.filesystem.remove(path)
end

local function purge_old_caches(keep)
    if not love.filesystem.getInfo("lovely_cache") then return end
    local keep_name = keep:match("[^/]+$")
    for _, name in ipairs(love.filesystem.getDirectoryItems("lovely_cache")) do
        if name ~= keep_name then remove_tree("lovely_cache/" .. name) end
    end
end

function M.init()
    if M.loaded then return end
    M.loaded = true
    M.patches_by_target, by_target, M.blacklist, M.disabled, enabled_vars = {}, {}, {}, {}, {}

    -- blacklist.txt: one mod folder name per line, '#' comments (same rules as real Lovely)
    local bl = read_file("Mods/lovely/blacklist.txt")
    if bl then
        for line in bl:gmatch("[^\r\n]+") do
            if ssub(line, 1, 1) ~= "#" then M.blacklist[line] = true end
        end
    end

    -- Web Mod Selector: Read disabled mods passed via command line arguments
    if arg then
        local found = false
        for _, v in ipairs(arg) do
            if v == "--web-blacklist" then found = true
            elseif found then
                for line in v:gmatch("[^\r\n]+") do
                    if ssub(line, 1, 1) ~= "#" then M.blacklist[line] = true end
                end
                break
            end
        end
    end

    local src = read_file("lovely_patches.lua")
    if not src then log("lovely_patches.lua not found; no patches will be applied"); data = { edits = {}, copies = {}, modules = {}, vars = {} }; return end
    local fn, err = loadstring(src, "=lovely_patches.lua")
    if not fn then error("lovely_patches.lua: " .. tostring(err)) end
    data = fn()

    local memo = {}
    local function enabled(mod)
        local v = memo[mod]
        if v == nil then
            local off = M.blacklist[mod] or love.filesystem.getInfo("Mods/" .. mod .. "/.lovelyignore") ~= nil
            if off then
                M.disabled[mod] = true
                log("mod '" .. mod .. "' is disabled; skipping its patches")
            end
            v = not off
            memo[mod] = v
        end
        return v
    end

    local function add(p, bucket)
        if not enabled(p.mod) then return end
        for _, t in ipairs(p.t) do
            local e = by_target[t]
            if not e then e = { edits = {}, copies = {}, modules = {} }; by_target[t] = e end
            local list = e[bucket]
            list[#list + 1] = p
        end
    end
    for _, p in ipairs(data.copies or {}) do add(p, "copies") end
    for _, p in ipairs(data.edits or {}) do add(p, "edits") end

    for _, v in ipairs(data.vars or {}) do
        if enabled(v.mod) then for k, val in pairs(v.vars) do enabled_vars[k] = val end end
    end

    -- module patches
    for _, p in ipairs(data.modules or {}) do
        if enabled(p.mod) and p.name and not M.skip_modules[p.name] then
            local chunkname = '=[lovely ' .. p.name .. ' "' .. (p.display or "") .. '"]'
            if p.load_now then
                local e = by_target[p.before]
                if not e then e = { edits = {}, copies = {}, modules = {} }; by_target[p.before] = e end
                e.modules[#e.modules + 1] = { p = p, chunkname = chunkname }
            elseif package.preload[p.name] == nil and not package.loaded[p.name] then
                local name = p.name
                if (p.display or ""):find("nativefs%.lua$") then
                    -- Mods bundling their own nativefs (e.g. Cartomancer) get an FFI/PhysFS library that cannot work
                    -- in the browser; hand them the web implementation Steamodded uses instead
                    package.preload[name] = function() return require("nativefs") end
                else
                package.preload[name] = function(...)
                    local code = M.apply_patches(chunkname, p.source or "")
                    local f, e2 = loadstring(code, chunkname)
                    if not f then error(e2, 0) end
                    return f(...)
                end
                end
            end
        end
    end

    if M.use_cache then
        local ok, dir = pcall(compute_cache_dir)
        if ok then
            cache_dir = dir
            pcall(purge_old_caches, dir)
        end
    end
end

---------------------------------------------------------------------------
-- document: lazily converts between string and line array
---------------------------------------------------------------------------
local function doc_str(doc)
    if not doc.s then doc.s = tconcat(doc.lines) end
    return doc.s
end
local function doc_lines(doc)
    if not doc.lines then doc.lines = split_inclusive(doc.s) end
    return doc.lines
end
local function doc_set_str(doc, s) doc.s = s; doc.lines = nil end
local function doc_set_lines(doc, lines) doc.lines = lines; doc.s = nil end

---------------------------------------------------------------------------
-- pattern patches (line based, '*' and '?' wildcards, whitespace-trimmed)
---------------------------------------------------------------------------
local function compile_wild(line)
    if not sfind(line, "[%*%?]") then return { plain = line, chunk = line ~= "" and line or nil } end
    local lp = sgsub(line, "[%^%$%(%)%%%.%[%]%+%-]", "%%%0")
    -- '*' = anything, '?' = one (UTF-8) character. Use a placeholder so the '*' inside the
    -- '?' expansion isn't expanded again.
    lp = sgsub(lp, "%*+", "\1")
    lp = sgsub(lp, "%?", "[^\128-\191][\128-\191]*")
    lp = sgsub(lp, "\1", ".*")
    local best = ""
    for chunk in line:gmatch("[^%*%?]+") do if #chunk > #best then best = chunk end end
    return { lua = "^" .. lp .. "$", chunk = best ~= "" and best or nil }
end

local function wild_match(w, s)
    if w.plain then return s == w.plain end
    return sfind(s, w.lua) ~= nil
end

local function get_pattern(p)
    local c = p._c
    if c then return c end
    c = { lines = {}, best = nil }
    for i, l in ipairs(rust_lines(p.pattern or "")) do
        local t = trim(l)
        c.lines[i] = compile_wild(t)
        local ch = c.lines[i].chunk
        if ch and (not c.best or #ch > #c.best) then c.best = ch end
    end
    p._c = c
    return c
end

local function indented_payload(payload, indent)
    local segs = split_inclusive(payload)
    if #segs == 0 then return { "\n" } end
    for i = 1, #segs do segs[i] = indent .. segs[i] end
    if ssub(payload, -1) ~= "\n" then segs[#segs] = segs[#segs] .. "\n" end
    return segs
end

-- returns: status ("applied" | "nomatch" | "bad"), note
local function apply_pattern(doc, p)
    local c = get_pattern(p)
    local wl = #c.lines
    if wl == 0 then return "bad", "pattern has no lines" end
    if c.best and not sfind(doc_str(doc), c.best, 1, true) then return "nomatch" end

    local lines = doc_lines(doc)
    local nlines = #lines
    local first = c.lines[1]
    local fchunk = first.chunk
    local matches, nm = {}, 0
    local i = 1
    local last_start = nlines - wl + 1
    local times = p.times
    while i <= last_start do
        local line = lines[i]
        local hit = false
        if not fchunk or sfind(line, fchunk, 1, true) then
            if wild_match(first, trim(line)) then
                hit = true
                for j = 2, wl do
                    if not wild_match(c.lines[j], trim(lines[i + j - 1])) then hit = false; break end
                end
            end
        end
        if hit then
            local indent = ""
            if p.indent then indent = line:match("^[ \t]*") or "" end
            nm = nm + 1
            matches[nm] = { i, indent }
            i = i + wl
        else
            i = i + 1
        end
    end
    if nm == 0 then return "nomatch" end
    local note
    if times then
        if nm ~= times then note = sformat("%d matches, wanted %d", nm, times) end
        while nm > times do matches[nm] = nil; nm = nm - 1 end
    end

    local out, n, cur = {}, 0, 1
    local pos = p.position
    for _, m in ipairs(matches) do
        local li, indent = m[1], m[2]
        for k = cur, li - 1 do n = n + 1; out[n] = lines[k] end
        local pl = indented_payload(p.payload or "", indent)
        if pos == "before" then
            for _, seg in ipairs(pl) do n = n + 1; out[n] = seg end
            cur = li
        elseif pos == "after" then
            for k = li, li + wl - 1 do n = n + 1; out[n] = lines[k] end
            if ssub(out[n], -1) ~= "\n" then out[n] = out[n] .. "\n" end
            for _, seg in ipairs(pl) do n = n + 1; out[n] = seg end
            cur = li + wl
        else -- at
            for _, seg in ipairs(pl) do n = n + 1; out[n] = seg end
            cur = li + wl
        end
    end
    for k = cur, nlines do n = n + 1; out[n] = lines[k] end
    doc_set_lines(doc, out)
    return "applied", note
end

---------------------------------------------------------------------------
-- regex patches
---------------------------------------------------------------------------
local function group_text(s, m, idx)
    local g = m[idx]
    if not g then return "" end
    return ssub(s, g[1], g[2] - 1)
end

-- Rust regex-automata style interpolation: $1, $name, ${name}, $$
local function interpolate(tpl, s, m, names)
    if not sfind(tpl, "$", 1, true) then return tpl end
    local out, n, pos, len = {}, 0, 1, #tpl
    while pos <= len do
        local d = sfind(tpl, "$", pos, true)
        if not d then n = n + 1; out[n] = ssub(tpl, pos); break end
        if d > pos then n = n + 1; out[n] = ssub(tpl, pos, d - 1) end
        local nxt = ssub(tpl, d + 1, d + 1)
        local name, after
        if nxt == "$" then
            n = n + 1; out[n] = "$"; pos = d + 2
        else
            if nxt == "{" then
                local close = sfind(tpl, "}", d + 2, true)
                if close then
                    local nm = ssub(tpl, d + 2, close - 1)
                    if nm ~= "" and not sfind(nm, "[^_%w]") then name = nm; after = close + 1 end
                end
            else
                local nm = tpl:match("^[_%w]+", d + 1)
                if nm then name = nm; after = d + 1 + #nm end
            end
            if name then
                local idx
                if not sfind(name, "%D") then idx = tonumber(name) else idx = names[name] end
                if idx then n = n + 1; out[n] = group_text(s, m, idx) end
                pos = after
            else
                n = n + 1; out[n] = "$"; pos = d + 1
            end
        end
    end
    return tconcat(out)
end

local function is_wordbyte(b)
    return b ~= nil and ((b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95)
end

local function apply_regex(doc, p)
    if p._bad then return "bad", p._bad end
    local rx = p._rx
    if not rx then
        local R = load_regex_module()
        local ok, res = pcall(R.compile, p.pattern, { verbose = p.verbose })
        if not ok then p._bad = tostring(res); return "bad", p._bad end
        rx = res; p._rx = rx
    end
    local s = doc_str(doc)
    local times = p.times
    local found = rx:find_all(s, times and (times + 1) or nil)
    if #found == 0 then return "nomatch" end
    local note
    if times then
        if #found ~= times then note = sformat("%d matches, wanted %d", #found, times) end
        while #found > times do found[#found] = nil end
    end

    local root = 0
    if p.root_capture then
        local nm = sgsub(p.root_capture, "%$", "")
        if not sfind(nm, "%D") then root = tonumber(nm) else root = rx.names[nm] end
        if not root or root > rx.ngroups then return "bad", "root_capture group not found" end
    end

    local out, n, cur = {}, 0, 1
    local last_byte = nil
    local function emit(str)
        if str ~= "" then n = n + 1; out[n] = str; last_byte = sbyte(str, #str) end
    end
    local pos = p.position
    local line_prepend_tpl = p.line_prepend or ""
    for _, m in ipairs(found) do
        local tg = m[root]
        if not tg then return "bad", "root_capture group did not participate" end
        local ts, te = tg[1], tg[2]
        local lp = interpolate(line_prepend_tpl, s, m, rx.names)
        local pre = p.payload or ""
        if lp ~= "" then
            local segs = split_inclusive(pre)
            for i = 1, #segs do segs[i] = lp .. segs[i] end
            pre = tconcat(segs)
        end
        local payload = interpolate(pre, s, m, rx.names)

        -- keep identifiers from fusing with neighbours
        local function left_byte(at)
            if at == cur then return last_byte end
            return sbyte(s, at - 1)
        end
        if is_wordbyte(sbyte(payload, 1)) then
            local pre_pt = (pos == "after") and te or ts
            if pre_pt > 1 and is_wordbyte(left_byte(pre_pt)) then payload = " " .. payload end
        end
        if is_wordbyte(sbyte(payload, #payload)) then
            local post_pt = (pos == "before") and ts or te
            if post_pt <= #s and is_wordbyte(sbyte(s, post_pt)) then payload = payload .. " " end
        end

        if pos == "before" then
            emit(ssub(s, cur, ts - 1)); emit(payload); cur = ts
        elseif pos == "after" then
            emit(ssub(s, cur, te - 1)); emit(payload); cur = te
        else
            emit(ssub(s, cur, ts - 1)); emit(payload); cur = te
        end
    end
    emit(ssub(s, cur))
    doc_set_str(doc, tconcat(out))
    return "applied", note
end


---------------------------------------------------------------------------
-- goto lowering: this runtime is plain Lua 5.1 (no goto), but patches such as Steamodded's insert
-- `goto continue` / `::continue::`. Loops whose label is the last statement of the body are
-- rewritten with repeat ... until true (+ flags so nested loops and original `break`s still work).
---------------------------------------------------------------------------
local KEYWORDS = { ["function"] = 1, ["if"] = 1, ["for"] = 1, ["while"] = 1, ["repeat"] = 1, ["do"] = 1,
    ["end"] = 1, ["until"] = 1, ["break"] = 1, ["goto"] = 1 }

local function skip_ws_comments(s, i)
    while true do
        local _, e = sfind(s, "^%s+", i)
        if e then i = e + 1 end
        if ssub(s, i, i + 1) == "--" then
            local eq = s:match("^%-%-%[(=*)%[", i)
            if eq then
                local _, ce = sfind(s, "]" .. eq .. "]", i, true)
                i = (ce or #s) + 1
            else
                local nl = sfind(s, "\n", i, true)
                i = nl and (nl + 1) or (#s + 1)
            end
        else
            return i
        end
    end
end

-- returns new_source, or nil, reason
-- Forward gotos only: the span from the first statement containing a goto up to its label is wrapped
-- in `repeat ... until true`, goto becomes `break`. Flags carry the jump out of nested loops, and
-- `break`s that targeted an enclosing loop are re-routed through a flag.
local function lower_goto(s)
    local n = #s
    local stack, sp = {}, 0
    local gotos, breaks, labels = {}, {}, {}
    local i = 1
    local prev_sig = ""          -- previous significant char, to skip field names like a.end

    local function push(kind, pos)
        sp = sp + 1
        local f = { kind = kind, header = (kind == "for" or kind == "while"), start = pos, idx = sp }
        stack[sp] = f
        return f
    end
    push("chunk", 1)

    while i <= n do
        local a = sfind(s, "[%a_\"'%[%-:]", i)
        if not a then break end
        local c = ssub(s, a, a)
        if c == "-" then
            if ssub(s, a + 1, a + 1) == "-" then
                local eq = s:match("^%-%-%[(=*)%[", a)
                if eq then
                    local _, ce = sfind(s, "]" .. eq .. "]", a, true)
                    i = (ce or n) + 1
                else
                    local nl = sfind(s, "\n", a, true)
                    i = nl and (nl + 1) or (n + 1)
                end
            else
                i = a + 1
            end
            prev_sig = "-"
        elseif c == "\"" or c == "'" then
            local j = a + 1
            while true do
                local b2 = sfind(s, "[\\\n" .. c .. "]", j)
                if not b2 then j = n + 1; break end
                if ssub(s, b2, b2) == "\\" then j = b2 + 2 else j = b2 + 1; break end
            end
            i = j; prev_sig = "\""
        elseif c == "[" then
            local eq = s:match("^%[(=*)%[", a)
            if eq then
                local _, ce = sfind(s, "]" .. eq .. "]", a, true)
                i = (ce or n) + 1
            else
                i = a + 1
            end
            prev_sig = "]"
        elseif c == ":" then
            local nm, e = s:match("^::%s*([%a_][%w_]*)%s*::()", a)
            if nm then
                labels[#labels + 1] = { s = a, e = e, name = nm, frame = stack[sp] }
                i = e
            else
                i = (ssub(s, a + 1, a + 1) == ":") and (a + 2) or (a + 1)
            end
            prev_sig = ":"
        else
            local word = s:match("^[%a_][%w_]*", a)
            local e = a + #word
            if KEYWORDS[word] and prev_sig ~= "." then
                if word == "function" or word == "if" or word == "repeat" then push(word, a)
                elseif word == "for" or word == "while" then push(word, a)
                elseif word == "do" then
                    local top = stack[sp]
                    if top.header then top.header = false else push("do", a) end
                elseif word == "end" then
                    local f = stack[sp]
                    if sp <= 1 or f.kind == "repeat" then return nil, "unbalanced 'end'" end
                    f.end_s, f.end_e = a, e
                    stack[sp] = nil; sp = sp - 1
                elseif word == "until" then
                    local f = stack[sp]
                    if sp <= 1 or f.kind ~= "repeat" then return nil, "unbalanced 'until'" end
                    stack[sp] = nil; sp = sp - 1
                elseif word == "break" then
                    for k = sp, 2, -1 do
                        local f = stack[k]
                        if f.kind == "function" then break end
                        if f.kind == "for" or f.kind == "while" or f.kind == "repeat" then
                            breaks[#breaks + 1] = { s = a, e = e, frame = f }
                            break
                        end
                    end
                elseif word == "goto" then
                    local ns = skip_ws_comments(s, e)
                    local nm = s:match("^[%a_][%w_]*", ns)
                    if nm then
                        local snap = {}
                        for k = 1, sp do snap[k] = stack[k] end
                        gotos[#gotos + 1] = { s = a, e = ns + #nm, name = nm, stack = snap, sp = sp }
                        e = ns + #nm
                    end
                end
            end
            i = e; prev_sig = "w"
        end
    end
    if sp ~= 1 then return nil, "unbalanced blocks" end
    if #gotos == 0 and #labels == 0 then return s, nil end

    -- label lookup by frame
    for _, lb in ipairs(labels) do
        lb.frame.labels = lb.frame.labels or {}
        if lb.frame.labels[lb.name] then return nil, "duplicate label " .. lb.name end
        lb.frame.labels[lb.name] = lb
    end

    local edits, seq = {}, 0
    local function edit(a, b, text) seq = seq + 1; edits[#edits + 1] = { a = a, b = b, text = text, seq = seq } end

    -- resolve gotos -> labels (innermost enclosing block that has the label, never across functions)
    local groups, order = {}, {}
    for _, g in ipairs(gotos) do
        local lb
        for k = g.sp, 1, -1 do
            local f = g.stack[k]
            local cand = f.labels and f.labels[g.name]
            if cand then lb, g.tidx = cand, k; break end
            if f.kind == "function" then break end
        end
        if not lb then return nil, "goto " .. g.name .. " has no visible label" end
        if lb.s < g.s then return nil, "backward goto " .. g.name .. " is not supported" end
        if not groups[lb] then groups[lb] = {}; order[#order + 1] = lb end
        local list = groups[lb]; list[#list + 1] = g
    end

    local counter, post_done = 0, {}
    for _, lb in ipairs(order) do
        counter = counter + 1
        local gflag, bflag = "__lgoto" .. counter, "__lbrk" .. counter
        local list = groups[lb]
        local ws = nil
        for _, g in ipairs(list) do
            local stmt = (g.sp > g.tidx) and g.stack[g.tidx + 1].start or g.s
            if not ws or stmt < ws then ws = stmt end
        end
        local needs_flag = false
        for _, g in ipairs(list) do
            local between = {}
            for k = g.tidx + 1, g.sp do
                local f = g.stack[k]
                if f.kind == "for" or f.kind == "while" or f.kind == "repeat" then between[#between + 1] = f end
            end
            if #between == 0 then
                edit(g.s, g.e, " do break end ")
            else
                needs_flag = true
                edit(g.s, g.e, " do " .. gflag .. " = true break end ")
                for _, m in ipairs(between) do
                    if m.kind == "repeat" then return nil, "goto out of a repeat-until loop" end
                    if not post_done[m] then
                        post_done[m] = true
                        edit(m.end_e, m.end_e, " if " .. gflag .. " then break end ")
                    end
                end
            end
        end
        -- breaks inside the wrapped span that belong to a loop enclosing the span must still leave that loop
        local has_breaks = false
        for _, br in ipairs(breaks) do
            if br.s > ws and br.s < lb.s and br.frame.start < ws then
                has_breaks = true
                edit(br.s, br.e, " do " .. bflag .. " = true break end ")
            end
        end
        local head = ""
        if has_breaks then head = head .. " local " .. bflag .. " = false" end
        if needs_flag then head = head .. " local " .. gflag .. " = false" end
        edit(ws, ws, head .. " repeat ")
        edit(lb.s, lb.e, " until true " .. (has_breaks and (" if " .. bflag .. " then break end ") or ""))
    end

    table.sort(edits, function(x, y) if x.a ~= y.a then return x.a > y.a end return x.seq > y.seq end)
    local parts, pos = {}, n + 1
    for _, ed in ipairs(edits) do
        if ed.b > pos then return nil, "overlapping goto rewrites" end
        parts[#parts + 1] = ssub(s, ed.b, pos - 1)
        parts[#parts + 1] = ed.text
        pos = ed.a
    end
    parts[#parts + 1] = ssub(s, 1, pos - 1)
    local res = {}
    for k = #parts, 1, -1 do res[#res + 1] = parts[k] end
    local out = tconcat(res)
    local fn, err = loadstring(out, "=lowered")
    if not fn then return nil, "lowered code does not compile: " .. tostring(err) end
    return out
end
M.lower_goto = lower_goto

local function lower_if_needed(src, name)
    if sfind(src, "goto", 1, true) or sfind(src, "::", 1, true) then
        local ok, res, reason = pcall(lower_goto, src)
        if not ok then log("goto lowering crashed in " .. tostring(name) .. ": " .. tostring(res)); return src end
        if not res then log("could not lower goto in " .. tostring(name) .. ": " .. tostring(reason)); return src end
        if res ~= src then log("lowered goto/labels in '" .. tostring(name) .. "'") end
        src = res
    end
    -- Amulet/Talisman: plain Lua 5.1 cannot compare number < Big (LuaJIT can), so comparisons are rewritten to helpers
    local wc = package.loaded["SMODS.web_compare"]
    if wc and not wc.skip(name) then
        local ok, res, info = pcall(wc.rewrite, src, name)
        if not ok then log("comparison rewrite crashed in " .. tostring(name) .. ": " .. tostring(res))
        elseif info == "tokenizer failed" then log("comparison rewrite skipped (tokenizer failed) in " .. tostring(name))
        else src = res end
    end
    return src
end
M.lower_if_needed = lower_if_needed

---------------------------------------------------------------------------
-- main entry
---------------------------------------------------------------------------
local function normalize_target(name)
    name = sgsub(name, "\\", "/")
    if ssub(name, 1, 1) == "@" then name = ssub(name, 2) end
    name = sgsub(name, "^%./", "")
    if ssub(name, 1, 1) == "/" then name = ssub(name, 2) end
    if name == "balatro_main.lua" then name = "main.lua" end
    return name
end

local function cache_path(target)
    local safe = sgsub(target, "[^%w%._%-]", "_")
    return cache_dir .. "/" .. safe .. "-" .. djb2(target)
end

function M.apply_patches(target_file, source)
    M.init()
    local target = normalize_target(target_file)
    local entry = by_target[target]
    if not entry then return lower_if_needed(source, target_file) end

    local cache_ok = cache_dir and next(lua_vars) == nil  -- runtime vars can change output; don't cache then
    if cache_ok then
        local path = cache_path(target)
        if love.filesystem.getInfo(path) then
            local cached = love.filesystem.read(path)
            if cached then
                -- load_now modules still need to run even when the text is cached
                for _, mm in ipairs(entry.modules) do
                    local code = M.apply_patches(mm.chunkname, mm.p.source or "")
                    local f, e2 = loadstring(code, mm.chunkname)
                    if not f then error(e2, 0) end
                    local res = f()
                    package.preload[mm.p.name] = function() return res end
                end
                return cached
            end
        end
    end

    -- load_now modules run right before the target is evaluated
    for _, mm in ipairs(entry.modules) do
        local code = M.apply_patches(mm.chunkname, mm.p.source or "")
        local f, e2 = loadstring(code, mm.chunkname)
        if not f then error(e2, 0) end
        local res = f()
        package.preload[mm.p.name] = function() return res end
        package.loaded[mm.p.name] = nil
    end

    local doc = { s = sgsub(sgsub(source, "\r\n", "\n"), "\r", "\n") }
    local applied, nomatch, bad = 0, 0, 0
    local problems = {}
    local function note_problem(p, what)
        if #problems < (M.verbose and 1000 or 4) then
            problems[#problems + 1] = sformat("%s [%s] %s: %s", p.mod, p.k, what, (p.pattern or ""):gsub("\n", "\\n"):sub(1, 70))
        end
    end

    -- copy patches
    for _, p in ipairs(entry.copies) do
        local s = doc_str(doc)
        if p.position == "prepend" then
            for _, c in ipairs(p.contents) do s = c .. "\n" .. s end
        else
            for _, c in ipairs(p.contents) do s = s .. "\n" .. c end
        end
        doc_set_str(doc, s)
        applied = applied + 1
    end

    -- pattern + regex patches (pre-sorted by priority)
    for _, p in ipairs(entry.edits) do
        local status, note
        if p.k == "regex" then status, note = apply_regex(doc, p) else status, note = apply_pattern(doc, p) end
        if status == "applied" then
            applied = applied + 1
            if note then note_problem(p, note) end
        elseif status == "nomatch" then
            nomatch = nomatch + 1; note_problem(p, "no match")
        else
            bad = bad + 1; note_problem(p, "BAD PATCH (" .. tostring(note) .. ")")
        end
    end

    local result = doc_str(doc)
    if sfind(result, "{{lovely:", 1, true) then
        result = sgsub(result, "{{lovely:([_%w]+)}}", function(name)
            local v = lua_vars[name]
            if v == nil then v = enabled_vars[name] end
            return v
        end)
    end

    result = lower_if_needed(result, target)

    local summary = sformat("Applied %d patch(es) to '%s'", applied, target)
    if nomatch > 0 or bad > 0 then summary = summary .. sformat(" (%d matched nothing, %d invalid)", nomatch, bad) end
    log(summary)
    for _, line in ipairs(problems) do log("   " .. line) end

    if cache_ok then
        pcall(function()
            love.filesystem.createDirectory(cache_dir)
            love.filesystem.write(cache_path(target), result)
        end)
    end
    return result
end

function M.reload_patches() M.loaded = false; M.init(); return true end
function M.get_var(k) return lua_vars[k] end
function M.set_var(k, v) lua_vars[k] = v end
function M.remove_var(k) local v = lua_vars[k]; lua_vars[k] = nil; return v end

local _ok, _err = pcall(M.init)
if not _ok then M.loaded = false; log("init failed: " .. tostring(_err)) end
return M
require "SMODS.web_bootstrap"
love.filesystem.load("balatro_main.lua")()
