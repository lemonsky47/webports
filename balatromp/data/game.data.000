]\\][\\s\\S]*",["position"]="at",["payload"]="error([[\n\n[!] !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! [!]\n\n  You have both Amulet and Talisman installed. Remove one of them.\n\n[!] !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! [!]\n\n    (you will be sent to mars if you report this crash message)\n\n]], 0)"},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"engine/ui.lua"},["pattern"]="node.config.lang = node.config.lang or G.LANG",["position"]="after",["payload"]="if type(node.config.text) ~= \"string\" then node.config.text = tostring(node.config.text) end",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"engine/ui.lua"},["pattern"]="if not self.config.no_recalc and self.config.prev_value and string.len(self.config.prev_value) ~= string.len(self.config.text) then self.UIBox:recalculate() end",["position"]="at",["payload"]="if not self.config.no_recalc and (not self.config.prev_text or string.len(self.config.prev_text) ~= string.len(self.config.text)) then self.UIBox:recalculate() end\nself.config.prev_text = self.config.text\n",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if num_dollars > 60 then",["position"]="at",["payload"]="num_dollars = to_number(num_dollars); if math.abs(num_dollars) > 60 then",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if num_dollars > 60 or num_dollars < -60 then",["position"]="at",["payload"]="num_dollars = to_number(num_dollars); if math.abs(num_dollars) > 60 then",["indent"]=true},{["mod"]="Amulet",["id"]="Amulet",["k"]="pattern",["t"]={"functions/common_events.lua"},["pattern"]="if type(vals.level) == 'number' then",["position"]="at",["payload"]="if is_number(vals.level) then",[