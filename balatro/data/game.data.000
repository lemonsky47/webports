local httpencode = function(str)
    str = str..''
    local char_to_hex = function(c)
        return string.format("%%%02X", string.byte(c))
    end
    str = str:gsub("\n", "\r\n"):gsub("([^%w _%%%-%.~])", char_to_hex):gsub(" ", "+")
    return str
end

